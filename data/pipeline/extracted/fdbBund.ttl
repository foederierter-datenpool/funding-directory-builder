    xyz:eligibleApplicant "unternehmen";
    xyz:location "DE8".
cdp:fdb-land-mecklenburg-vorpommern-holzruecken-mit-pferden cdp:fromSource cdp:fdbBundSource;
    xyz:title "Holzrücken mit Pferden";
    xyz:funderLevel "land";
    xyz:legalCitation "Richtlinie des Ministeriums für Landwirtschaft und Umwelt vom 23. Februar 2017, Amtsblatt für Mecklenburg-Vorpommern Nr. 10 vom 13. März 2017, S. 148; geändert durch Bekanntmachung des Ministeriums für Landwirtschaft und Umwelt vom 20. Februar 2020, Amtsblatt für Mecklenburg-Vorpommern Nr. 14 vom 30. März 2020, S. 138.";
    xyz:fundingSubarea "landwirtschaft_laendliche_entwicklung.forstwirtschaft", "umwelt_naturschutz.naturschutz_landschaftspflege";
    xyz:description "Das Land Mecklenburg-Vorpommern unterstützt Sie bei traditionellen und umweltverträglichen Holzernteverfahren mit Rückepferden im Wald. Dabei rücken Sie durch den Einsatz von Pferden Holz an Wegen und maschinenbefahrbaren Rückegassen im Wald. Sie erhalten die Förderung als Zuschuss. Die Höhe des Zuschusses beträgt EUR 4,00 je Erntefestmeter, mindestens jedoch EUR 250,00 je Kalenderjahr. Ihren Antrag richten Sie bitte bis zum 1.10. des jeweiligen Kalenderjahres an den Landesforst Mecklenburg-Vorpommern.";
    xyz:url "https://www.foerderdatenbank.de/FDB/Content/DE/Foerderprogramm/Land/Mecklenburg-Vorpommern/holzruecken-mit-pferden.html";
    xyz:keywordsExtracted "Wald", "Holzrücken", "Pferde", "Rückepferde", "Waldbewirtschaftung";
    xyz:fundingArea "landwirtschaft_und_laendliche_entwicklung", "umwelt_und_naturschutz";
    xyz:fundingType "zuschuss";
    xyz:eligibleApplicant "unternehmen";
    xyz:location "DE8".
cdp:fdb-land-mecklenburg-vorpommern-infrastrukturausbau-ganztagsbetreuung-mv cdp:fromSource cdp:fdbBundSource;
