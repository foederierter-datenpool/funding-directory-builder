    xyz:legalCitation "";
    xyz:fundingSubarea "staedtebau_stadterneuerung.sanierung_entwicklung", "staedtebau_stadterneuerung.soziale_stadt", "staedtebau_stadterneuerung.energetische_sanierung", "gesundheit_soziales.integration", "gesundheit_soziales.kinder_jugendliche_familien", "energieeffizienz_erneuerbare_energien.wohnungsbau_modernisierung", "wohnungsbau_modernisierung.modernisierung_sanierung", "landwirtschaft_laendliche_entwicklung.forstwirtschaft", "umwelt_naturschutz.naturschutz_landschaftspflege", "landwirtschaft_laendliche_entwicklung.besondere_formen_der_landbewirtschaftung", "forschung_innovation_themenspezifisch.information_kommunikation", "forschung_innovation_themenspezifisch.mobilitaet_verkehr", "gesundheit_soziales.buergerschaftliches_engagement", "infrastruktur.information_kommunikation", "aus_weiterbildung.berufsvorbereitung", "gesundheit_soziales.gesundheit", "energieeffizienz_erneuerbare_energien.oeffentliche_infrastruktur", "energieeffizienz_erneuerbare_energien.beratung_schulung", "infrastruktur.energie_umwelt", "umwelt_naturschutz.oeffentliche_infrastruktur", "beratung.energieeffizienz_erneuerbare_energien", "energieeffizienz_erneuerbare_energien.forschung_innovation", "forschung_innovation_themenspezifisch.energieeffizienz_erneuerbare_energien", "forschung_innovation_themenspezifisch.land_forst_fischwirtschaft", "forschung_innovation_themenspezifisch.schifffahrt_meerestechnik", "forschung_innovation_themenspezifisch.umwelt_naturschutz", "landwirtschaft_laendliche_entwicklung.forschung_innovation", "umwelt_naturschutz.forschung_innovation", "infrastruktur.laendliche_entwicklung", "landwirtschaft_laendliche_entwicklung.laendliche_entwicklung", "regionalfoerderung.laendliche_entwicklung", "forschung_innovation_themenspezifisch.bauen_wohnen", "forschung_innovation_themenspezifisch.nachwachsende_rohstoffe", "infrastruktur.forschung_innovation", "gesundheit_soziales.behinderte_menschen", "aus_weiterbildung.weiterbildungsstrukturen_traeger", "frauenfoerderung.arbeit_aus_weiterbildung", "gesundheit_soziales.gleichstellung", "infrastruktur.staedtebau_stadterneuerung", "infrastruktur.verkehr", "aus_weiterbildung.ausbildungsstrukturen_traeger", "aus_weiterbildung.weiterbildung_von_arbeitnehmern", "aus_weiterbildung.weiterbildung_unternehmer_selbststaendige", "aus_weiterbildung.ausbildung_besonderer_zielgruppen", "aus_weiterbildung.betriebliche_ausbildung", "forschung_innovation_themenspezifisch.wirtschafts_sozial_geisteswissenschaften", "aus_weiterbildung.ausserbetriebliche_ausbildung", "aus_weiterbildung.weiterbildung_von_arbeitssuchenden", "gesundheit_soziales.senioren_pflege", "regionalfoerderung.oeffentliche_infrastruktur", "beratung.umwelt_naturschutz", "umwelt_naturschutz.beratung_schulung", "beratung.aus_weiterbildung", "beratung.forschung_innovation";
    xyz:description "Das Bundesministerium für Wirtschaft und Klimaschutz (BMWK) hat die Europäische Klimaschutzinitiative (EUKI) 2017 ins Leben gerufen, um Treibhausgasemissionen zu mindern und die Zusammenarbeit beim Klimaschutz in Europa zu verbessern. Seitdem hat die EUKI--Europäische Klimaschutzinitiative 213 grenzüberschreitende Klimaprojekte gefördert und ein aktives Netzwerk mit 440 Organisationen in 31 europäischen Ländern geschaffen. Die Fördersumme beträgt pro unterstütztem Projekt zwischen 120.000 und 1.000.000 EUR . Hierzu wird jedes Jahr ein europaweiter Ideenwettbewerb ausgeschrieben. Sie können sich für eine Förderung Ihres Vorhabens in den folgenden 6 Bereichen bewerben (Änderungen vorbehalten): Klimaneutrale Mobilität Klimapolitik CO2 -Entnahme und -Senken Energiewende und klimaneutrale Gebäude Sozialgerechter Strukturwandel Nachhaltige Wirtschaft";
    xyz:url "https://www.foerderdatenbank.de/FDB/Content/DE/Foerderprogramm/Bund/BMWi/euki-klimaschutzinitiative-2024-4.html";
