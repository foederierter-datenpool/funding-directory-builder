cdp:dsee-foerderung-der-buergerstiftung-im-landkreis-hersfeld-rotenburg cdp:fromSource cdp:dseeSource;
    xyz:title "Förderung der Bürgerstiftung im Landkreis Hersfeld-Rotenburg";
