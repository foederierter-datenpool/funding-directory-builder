    xyz:fundingArea "bildung", "kinder_und_jugendliche", "migration";
    xyz:location "DE".
cdp:dsee-foerderung-der-stiftung-flughafen-frankfurt-main-fuer-die-region cdp:fromSource cdp:dseeSource;
