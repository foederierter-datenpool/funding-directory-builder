PREFIX xyz: <http://sparql.xyz/facade-x/data/>
PREFIX cdp: <https://civic-data.de/pipeline#>
PREFIX cdf: <https://civic-data.de/federated-directory#>
PREFIX schema: <http://schema.org/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX dct: <http://purl.org/dc/terms/>

INSERT {
    GRAPH <urn:mapped> {
        ?entity a schema:FundingScheme ; cdp:fromSource cdp:fdbBundSource .
        ?entity schema:name ?title .
        ?entity schema:description ?description .
        ?entity schema:url ?url .
        ?entity dct:spatial ?location .
        ?entity cdf:funderLevel ?funderLevel .
        ?entity cdf:fundingArea ?fundingArea .
        ?entity cdf:fundingSubarea ?fundingSubarea .
        ?entity cdf:eligibleApplicant ?eligibleApplicant .
        ?entity cdf:fundingType ?fundingType .
        ?entity schema:keywords ?keywordsExtracted .
        ?entity cdf:legalCitation ?legalCitation .
    }
} WHERE {
    GRAPH <urn:source:fdbBund> {
        ?entity cdp:fromSource cdp:fdbBundSource .
        OPTIONAL { ?entity cdp:targetSchema ?_ts }
        FILTER(!bound(?_ts) || ?_ts = cdp:fundingOpportunitySchema)
        OPTIONAL {
    { ?entity xyz:title ?title . FILTER(isLiteral(?title) && REPLACE(STR(?title), "\\s+", "") != "") }
    UNION
    { ?entity xyz:description ?description . FILTER(isLiteral(?description) && REPLACE(STR(?description), "\\s+", "") != "") }
    UNION
    { ?entity xyz:url ?url . FILTER(isLiteral(?url) && REPLACE(STR(?url), "\\s+", "") != "") }
    UNION
    { ?entity xyz:location ?location . FILTER(isLiteral(?location) && REPLACE(STR(?location), "\\s+", "") != "") }
    UNION
    { ?entity xyz:funderLevel ?funderLevel . FILTER(isLiteral(?funderLevel) && REPLACE(STR(?funderLevel), "\\s+", "") != "") }
    UNION
    { ?entity xyz:fundingArea ?fundingArea . FILTER(isLiteral(?fundingArea) && REPLACE(STR(?fundingArea), "\\s+", "") != "") }
    UNION
    { ?entity xyz:fundingSubarea ?fundingSubarea . FILTER(isLiteral(?fundingSubarea) && REPLACE(STR(?fundingSubarea), "\\s+", "") != "") }
    UNION
    { ?entity xyz:eligibleApplicant ?eligibleApplicant . FILTER(isLiteral(?eligibleApplicant) && REPLACE(STR(?eligibleApplicant), "\\s+", "") != "") }
    UNION
    { ?entity xyz:fundingType ?fundingType . FILTER(isLiteral(?fundingType) && REPLACE(STR(?fundingType), "\\s+", "") != "") }
    UNION
    { ?entity xyz:keywordsExtracted ?keywordsExtracted . FILTER(isLiteral(?keywordsExtracted) && REPLACE(STR(?keywordsExtracted), "\\s+", "") != "") }
    UNION
    { ?entity xyz:legalCitation ?legalCitation . FILTER(isLiteral(?legalCitation) && REPLACE(STR(?legalCitation), "\\s+", "") != "") }
  }
    }
}