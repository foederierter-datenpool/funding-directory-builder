PREFIX xyz: <http://sparql.xyz/facade-x/data/>
PREFIX cdp: <https://civic-data.de/pipeline#>
PREFIX cdf: <https://civic-data.de/federated-directory#>
PREFIX schema: <http://schema.org/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX dct: <http://purl.org/dc/terms/>

INSERT {
    GRAPH <urn:mapped> {
        ?entity a schema:FundingScheme ; cdp:fromSource cdp:euportalSource .
        ?entity schema:name ?title .
        ?entity schema:description ?description .
        ?entity schema:url ?url .
        ?entity cdf:deadlineModel ?deadlineModel .
        ?entity schema:applicationDeadline ?deadline .
        ?entity cdf:status ?status .
    }
} WHERE {
    GRAPH <urn:source:euportal> {
        ?entity cdp:fromSource cdp:euportalSource .
        OPTIONAL { ?entity cdp:targetSchema ?_ts }
        FILTER(!bound(?_ts) || ?_ts = cdp:fundingOpportunitySchema)
        OPTIONAL { ?entity xyz:title ?title . FILTER(isLiteral(?title) && REPLACE(STR(?title), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:description ?description . FILTER(isLiteral(?description) && REPLACE(STR(?description), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:url ?url . FILTER(isLiteral(?url) && REPLACE(STR(?url), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:deadlineModel ?deadlineModel . FILTER(isLiteral(?deadlineModel) && REPLACE(STR(?deadlineModel), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:deadline ?deadline . FILTER(isLiteral(?deadline) && REPLACE(STR(?deadline), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:status ?status . FILTER(isLiteral(?status) && REPLACE(STR(?status), "\\s+", "") != "") }
    }
}