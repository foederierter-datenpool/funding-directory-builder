    cdf:fundingSubarea "forschung_innovation_themenoffen.gruendung_von_technologieunternehmen", "forschung_innovation_themenoffen.kooperationen_netzwerke", "infrastruktur.forschung_innovation", "forschung_innovation_themenoffen.patentierung_verwertung";
    cdf:eligibleApplicant "bildungseinrichtung", "verband_vereinigung", "hochschule", "oeffentliche_einrichtung", "forschungseinrichtungen", "kommunen";
