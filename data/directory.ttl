cdf:funding-c7a62ed7e819 a schema:FundingScheme;
    schema:name "Förderung der Stiftung Sport Region Halle";
    schema:description "Schwerpunkt der Stiftung Sport Region Halle ist die Nachwuchsförderung aber auch die Förderung Derjenigen, die die Sportler in ihrer Leistungsentwicklung begleiten.";
