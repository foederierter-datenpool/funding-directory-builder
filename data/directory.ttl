cdf:funding-156680c64589 a schema:FundingScheme;
    schema:name "Förderung der Sparkassen-Sozialstiftung Stormarn";
    schema:description "Die Sparkassen-Sozialstiftung Stormarn fördert seit ihrer Gründung die unterschiedlichsten sozialen Projekte und Vorhaben. Die Stiftung ist vorrangig errichtet worden, um Projekte und Organisationen im Bereich der Mildtätigkeit zu fördern. Das betrifft Menschen, die infolge ihres körperlichen, geistigen oder seelischen Zustandes auf Unterstützung anderer angewiesen sind. Präventive Aktivitäten und Hilfen für Frauen und ihre Kinder, die in Not geraten sind, stehen im Fokus des Engagements.";
    schema:url "https://foerderdatenbank.d-s-e-e.de/foerderprogramme/foerderung-der-sparkassen-sozialstiftung-stormarn";
    cdf:fundingArea "kinder_und_jugendliche", "soziales", "bevoelkerungs_und_katastrophenschutz";
    dct:spatial "DEF";
    cdf:deadlineModel "rolling".
