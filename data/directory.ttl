    cdf:eligibleApplicant "unternehmen";
    cdf:fundingType "kredit_darlehen";
    schema:keywords "Produktion", "Agrarwirtschaft", "Kleinunternehmer", "Mittelstand", "Anlagen", "Maschinen", "Dauerkultur", "Landwirt", "landwirtschaftlich KMU", "Wirtschaftsgebäude";
    cdf:legalCitation "Merkblatt Landwirtschaft ? Wachstum der Landwirtschaftlichen Rentenbank vom 2.1.2023 und Merkblatt Landwirtschaft ? Wachstum ? Leasing der Landwirtschaftlichen Rentenbank vom 2.1.2023.".
cdf:funding-645af3cb3f47 a schema:FundingScheme;
    schema:name "Förderung der Weberbank-Stiftung";
    schema:description "Zweck der Weberbank-Stiftung ist die Förderung der Kunst und Kultur, der Wissenschaft und Forschung, der Bildung und Erziehung, des Wohlfahrtswesens und des Sports sowie der Jugend- und Altenhilfe. Der Stiftungszweck wird verwirklicht durch die Vergabe von Preisen für besondere Leistungen auf den vorgenannten Gebieten. Des Weiteren vergibt die Stiftung Zuwendungen an andere als gemeinnützig anerkannte Einrichtungen. Die Stiftung darf Mittel für die Verwirklichung der vorgenannten steuerbegünstigten Zwecke einer anderen Körperschaft beschaffen; die Beschaffung von Mitteln für eine unbeschränkt steuerpflichtige Körperschaft setzt voraus, dass diese selbst steuerbegünstigt ist. Besonderes Anliegen der Stiftung ist es, Projekte zu einem frühen Zeitpunkt zu fördern und sie in der oft schwierigen Anfangsphase zu unterstützen.";
    schema:url "https://foerderdatenbank.d-s-e-e.de/foerderprogramme/foerderung-der-weberbank-stiftung";
    cdf:fundingArea "kinder_und_jugendliche", "kultur_medien_und_musik", "soziales", "wissenschaft_und_forschung", "sport_und_bewegung";
    dct:spatial "DE4", "DE3";
    cdf:deadlineModel "rolling".
