    cdf:fundingSubarea "gesundheit_soziales.kinder_jugendliche_familien";
    cdf:eligibleApplicant "privatpersonen";
    cdf:fundingType "zuschuss";
    schema:keywords "Familien", "Zuschüsse", "Erholung", "Alleinerziehende", "Familienferienstätte", "Mütter", "Väter", "Wochenendseminar";
    cdf:legalCitation "Bekanntmachung des Bayerischen Staatsministeriums für Familie, Arbeit und Soziales vom 13. April 2023, Bayerisches Ministerialblatt Nr. 191 vom 26. April 2023; geändert durch Bekanntmachung des Bayerischen Staatsministeriums für Familie, Arbeit und Soziales vom 4. Dezember 2023, Bayerisches Ministerialblatt Nr. 645 vom 20. Dezember 2023.".
cdf:funding-b4e766cff87e a schema:FundingScheme;
    schema:name "Wohnprojekte Gründungsfonds";
    schema:description "Das Land Schleswig-Holstein unterstützt Sie im Rahmen der sozialen Wohnraumförderung bei der Gründung einer Wohnungsgenossenschaft oder einer wohnungsgenossenschaftsähnlichen Trägerschaft. Sie bekommen die Förderung für gutachterliche Tätigkeiten, Voruntersuchungen, Konzepte zur Organisationsstruktur sowie Expertisen zu betriebswirtschaftlichen und rechtlichen Fragestellungen, die im engen Zusammenhang mit dem Gründungsprozess stehen. Sie bekommen die Förderung als Zuschuss. Die Höhe des Zuschusses beträgt bis zu 90 Prozent der förderfähigen Kosten, jedoch höchstens EUR 15.000. Die förderfähigen Kosten Ihres Vorhabens müssen EUR 7.000 übersteigen (Bagatellgrenze). Richten Sie bitte Ihren Antrag vor Beginn der Maßnahmen an die Investitionsbank Schleswig-Holstein (IB.SH).";
    schema:url "https://www.foerderdatenbank.de/FDB/Content/DE/Foerderprogramm/Land/Schleswig-Holstein/wohnprojekte-gruendungsfonds.html";
    cdf:fundingArea "wohnungsbau_und_modernisierung";
    dct:spatial "DEF";
