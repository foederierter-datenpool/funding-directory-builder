    cdf:eligibleApplicant "unternehmen";
    cdf:fundingType "zuschuss";
    schema:keywords "Investitionsförderung", "Umweltschutz", "Terrassenweinberg", "Weinbausteillagen", "Winzer";
    cdf:legalCitation "Verwaltungsvorschrift des Ministeriums für Ernährung, Ländlichen Raum und Verbraucherschutz vom 31. August 2017, Gemeinsames Amtsblatt des Landes Baden-Württemberg Nr. 9 vom 27. September 2017, S. 450.".
