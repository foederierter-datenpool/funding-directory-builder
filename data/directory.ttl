    cdf:funderLevel "land";
    cdf:fundingSubarea "unternehmensfinanzierung.betriebliche_investitionen", "existenzgruendung_festigung.festigungsinvestitionen";
    cdf:eligibleApplicant "unternehmen", "existenzgruenderin";
    cdf:fundingType "buergschaft";
    schema:keywords "Investitionen", "Existenzgründung", "Bürgschaft", "Bürgschaftsbank";
    cdf:legalCitation "Informationen der Bürgschaftsbank Brandenburg, Stand Oktober 2020; Allgemeine Bürgschaftsbestimmungen Kredit (ABB) der Bürgschaftsbank Brandenburg GmbH, Stand 1. Juli 2017.".
