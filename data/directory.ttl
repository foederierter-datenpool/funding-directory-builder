    cdf:fundingType "zuschuss";
    schema:keywords "Gründung", "Wohnungsgenossenschaft", "Bestandsgenossenschaft", "Mietergenossenschaft", "soziale Wohnraumförderung";
    cdf:legalCitation "Richtlinie des Ministeriums für Inneres, Kommunales, Wohnen und Sport vom 21. November 2022, Amtsblatt für Schleswig-Holstein Nr. 52 vom 27. Dezember 2022.".
