    cdf:eligibleApplicant "bildungseinrichtung", "verband_vereinigung", "oeffentliche_einrichtung", "kommunen", "stiftungen", "verbaende", "vereine";
    cdf:fundingType "zuschuss", "anteilsfinanzierung_kapitalbeteiligung";
    schema:keywords "Alphabetisierung", "Asyl", "Asylbewerber", "Geduldete Schreibkompetenz", "Lesekompetenz", "Sprachkurs", "Zuschüsse";
