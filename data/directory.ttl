    schema:keywords "Gastronomie", "Hotel", "Hotellerie", "Tourismus", "Sensorik", "Ressourceneffizienz", "EEW", "Ressourcenverbrauch", "Energiemanagement-Software", "Mess-, Steuer- und Regelungstechnik";
