cdf:funding-b3790c3e25ef a schema:FundingScheme;
    schema:name "Förderung der Bürgerstiftung Kehl";
    schema:description "Die Bürgerstiftung Kehl möchte Kindern und Jugendlichen gute Perspektiven bieten und sozial benachteiligte Gruppen bei ihrer Integration in das städtische Leben unterstützen.";
    schema:url "https://foerderdatenbank.d-s-e-e.de/foerderprogramme/foerderung-der-buergerstiftung-kehl";
