    cdf:fundingSubarea "aus_weiterbildung.ausbildung_besonderer_zielgruppen", "aus_weiterbildung.betriebliche_ausbildung", "frauenfoerderung.arbeit_aus_weiterbildung", "aus_weiterbildung.weiterbildung_von_arbeitnehmern", "arbeit.betriebliche_arbeitsplaetze", "arbeit.eingliederung_besonderer_zielgruppen", "aus_weiterbildung.weiterbildung_von_arbeitssuchenden", "aus_weiterbildung.weiterbildungsstrukturen_traeger", "aus_weiterbildung.weiterbildung_unternehmer_selbststaendige", "aus_weiterbildung.ausbildungsstrukturen_traeger", "aus_weiterbildung.berufsvorbereitung", "arbeit.qualifizierung_von_arbeitssuchenden", "aus_weiterbildung.ausserbetriebliche_ausbildung", "arbeit.ausserbetriebliche_arbeitsgelegenheiten";
