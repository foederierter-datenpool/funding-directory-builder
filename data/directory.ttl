    cdf:status "active".
cdf:funding-1d026d85cbf0 a schema:FundingScheme;
    schema:name "Förderung der Sparkassenstiftung Untereichsfeld";
    schema:description "Die Gemeinwohlorientierung ist Teil der Sparkassenstiftung Untereichsfeld. Daher setzt sich sich für die wirtschaftliche und gesellschaftliche Entwicklung der Region ein. Sie schafft damit Lebensqualität und Werte für alle Menschen im Untereichsfeld, d. h. in der Stadt Duderstadt, der Samtgemeinde Gieboldehausen sowie der Samtgemeinde Radolfshausen.";
    schema:url "https://foerderdatenbank.d-s-e-e.de/foerderprogramme/foerderung-der-sparkassenstiftung-untereichsfeld";
    cdf:fundingArea "bildung", "bildung_fuer_nachhaltige_entwicklung", "kinder_und_jugendliche", "umwelt_naturschutz_klimaschutz_und_tierschutz", "kultur_medien_und_musik", "digitalisierung", "sonstiges", "soziales", "wissenschaft_und_forschung", "engagement_fuer_gesellschaftlichen_zusammenhalt_demokratie", "migration", "entwicklungszusammenarbeit", "sport_und_bewegung", "bevoelkerungs_und_katastrophenschutz", "bauten_und_denkmalschutz";
