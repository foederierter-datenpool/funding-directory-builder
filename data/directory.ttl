cdf:funding-899956192bff a schema:FundingScheme;
    schema:name "Förderungen der Sparkassenstiftung Kaarst-Büttgen";
    schema:description "Sie ist breit aufgestellt, die Sparkassenstiftung Kaarst-Büttgen. Obwohl längst zu der Stadt Kaarst mit über 40.000 Einwohnern verschmolzen, weist der Name der Stiftung immer noch auf die ehemals eigenständigen Gemeinden Kaarst und Büttgen hin.";
