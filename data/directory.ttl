    cdf:fundingSubarea "unternehmensfinanzierung.betriebliche_investitionen", "aussenwirtschaft.exportfinanzierung", "unternehmensfinanzierung.betriebsmittel";
    cdf:eligibleApplicant "unternehmen";
    cdf:fundingType "garantie";
    schema:keywords "Investitionsförderung", "Wettbewerbsförderung", "Auslandsaufträge", "Exportgarantie", "Inlandsavale", "Vorfinanzierungen";
    cdf:legalCitation "Merkblatt der LfA Förderbank Bayern vom 1. Januar 2024; Rundschreiben der LfA Förderbank Bayern Nr. 54 vom 15. Dezember 2023.".
cdf:funding-3e8fbb7e4155 a schema:FundingScheme;
    schema:name "Garantien durch die Bürgschaftsbank Mecklenburg-Vorpommern";
    schema:description "Die Bürgschaftsbank Mecklenburg-Vorpommern übernimmt Garantien für Beteiligungen von privaten Beteiligungsgesellschaften an mittelständischen Unternehmen der gewerblichen Wirtschaft, Freiberuflerinnen und Freiberuflern sowie Betrieben des Gartenbaus in Mecklenburg-Vorpommern. Die Garantien werden bis zu 70 Prozent der Beteiligungssumme als auch bis zu 70 Prozent der vereinbarten Ansprüche der Beteiligungsgesellschaften auf den Ertrag aus der Beteiligung gegeben. Die Laufzeit beträgt bis zu 10 Jahre. Richten Sie Ihren Antrag bitte an die Bürgschaftsbank Mecklenburg-Vorpommern GmbH (BMV).";
    schema:url "https://www.foerderdatenbank.de/FDB/Content/DE/Foerderprogramm/Land/Mecklenburg-Vorpommern/garantien-buergschaftsbank-mecklenburg-vorpommern.html";
