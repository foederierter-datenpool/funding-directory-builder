    schema:applicationDeadline "2026-03-05"^^<http://www.w3.org/2001/XMLSchema#date>.
cdf:funding-14c4bb7580b1 a schema:FundingScheme;
    schema:name "Zuwendungen zur Stärkung der Willkommenskultur";
    schema:description "Das Land Sachsen-Anhalt unterstützt Sie als Kommune dabei, Ihre Willkommenskultur zu stärken und die einheimische Bevölkerung in Bezug auf die Aufnahme und Unterbringung von Asylsuchenden und Flüchtlingen aufzuklären. Sie erhalten die Förderung als Zuschuss. Die Höhe des Zuschusses beträgt bis zu 90 Prozent der zuwendungsfähigen Ausgaben, maximal EUR 20.000 jährlich. Ihren Antrag richten Sie bitte an das Landesverwaltungsamt Sachsen-Anhalt, Referat 505.";
    schema:url "https://www.foerderdatenbank.de/FDB/Content/DE/Foerderprogramm/Land/Sachsen-Anhalt/staerkung-der-willkommenskultur.html";
    cdf:fundingArea "gesundheit_und_soziales";
    dct:spatial "DEE";
