    cdf:fundingSubarea "aus_weiterbildung.ausbildung_besonderer_zielgruppen", "frauenfoerderung.arbeit_aus_weiterbildung", "arbeit.eingliederung_besonderer_zielgruppen", "aus_weiterbildung.berufsvorbereitung", "arbeit.qualifizierung_von_arbeitssuchenden";
    cdf:eligibleApplicant "bildungseinrichtung", "verband_vereinigung", "oeffentliche_einrichtung", "kommunen";
    cdf:fundingType "zuschuss";
    schema:keywords "Qualifizierung", "Arbeitsmarkt", "Berufsqualifizierung", "Deutschkenntnisse", "Deutschkurs", "Sprachkenntnisse";
