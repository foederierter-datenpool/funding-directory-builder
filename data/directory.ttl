cdf:funding-d8d830ec7c4e a schema:FundingScheme;
    schema:name "Pilot Federation ";
    schema:description "Expected Outcome: Europe's first long-term VET provider network for semiconductors; a larger and more diverse pool of qualified technicians; and increased intra- and extra-EU mobility of students and workers to fill skills gaps in semiconductor facilities. Scope: This call supports the establishment of a European-level federation of Vocational Education and Training (VET) providers focused on semiconductor industry roles. Projects should develop industry-aligned micro-credentials and reskilling programmes, with a strong emphasis on workers transitioning from other industrial sectors and on cross-border recognition of qualifications.";
    schema:url "https://ec.europa.eu/info/funding-tenders/opportunities/portal/screen/opportunities/topic-details/DIGITAL-JU-CHIPS-2026-SKILLS-PF-SG";
    cdf:deadlineModel "single_stage";
    cdf:status "ended";
    schema:applicationDeadline "2026-09-24"^^<http://www.w3.org/2001/XMLSchema#date>.
