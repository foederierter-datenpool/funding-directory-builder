    cdf:eligibleApplicant "privatpersonen";
    cdf:fundingType "zuschuss";
    schema:keywords "Kinderwunsch", "In-Vitro-Fertilisation", "Reproduktionsmedizin", "Spermieninjektion";
    cdf:legalCitation "Richtlinie der Senatsverwaltung für Gesundheit, Pflege und Gleichstellung vom 31. Mai 2021, Amtsblatt für Berlin Nr. 24 vom 11. Juni 2021, S. 2058.".
cdf:funding-52ff4ee3c31a a schema:FundingScheme;
    schema:name "European Film sales agent";
    schema:description "Objective: Expected results: Improvement in the trans-national distribution of recent non-national European films. Increase in the investment in the production, acquisition, promotion, theatrical and online distribution of non-national European films. Develop links between the production and distribution sector thus improving the competitive position of non-national European films. Description of the activities: There are two phases for the funded activities: 1. The generation of a potential fund which will be attributed according to the performance of the company on the European market. 2. The implementation of the action - the potential fund thus generated by each company must be reinvested in: -minimum guarantees or advances paid for the international sales rights on eligible non-national European films; -the promotion, marketing and advertising on the market of eligible non-national European films.";
    schema:url "https://ec.europa.eu/info/funding-tenders/opportunities/portal/screen/opportunities/topic-details/CREA-MEDIA-2026-FILMSALES";
