cdf:funding-14fbffd64318 a schema:FundingScheme;
    schema:name "Förderung der Stiftung Sparkasse Büdelsdorf";
    schema:description "Die Stiftung Sparkasse Büdelsdorf wurde am 27. Juni 1995 anlässlich des 75-jährigen Bestehens der früheren Sparkasse Büdelsdorf gegründet. Die Förderstiftung ist mit einem Stiftungskapital von 500.000 Euro ausgestattet.";
