    cdf:eligibleApplicant "kommunen";
    cdf:fundingType "zuschuss";
    schema:keywords "Kinder", "Pflege", "Kinderbetreuung", "Kita", "Kleinkind", "Tagesbetreuung", "Tagesmutter";
    cdf:legalCitation "Richtlinie des Kultusministeriums vom 18. Mai 2017, Niedersächsisches Ministerialblatt Nr. 29 vom 26. Juli 2017, S. 312; zuletzt geändert durch Bekanntmachung des Kultusministeriums vom 8. September 2021, Niedersächsisches Ministerialblatt Nr. 36 vom 8. September 2021, S. 1489.".
cdf:funding-43f0755f6c5f a schema:FundingScheme;
    schema:name "Förderung für vollstationäre Dauerpflegeeinrichtungen mit einer Öffnung in den sozialen Nahraum";
    schema:description "Der Freistaat Bayern fördert den flächendeckenden und bedarfsgerechten Ausbau der pflegerischen Versorgungsstruktur für vollstationäre Dauerpflegeeinrichtungen mit einer Öffnung in den sozialen Nahraum.";
