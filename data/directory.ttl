cdf:funding-cb7dab302574 a schema:FundingScheme;
    schema:name "Demonstration of an Optimized System Platform for Ultra-efficient SMR Aircraft";
    schema:description "Expected Outcome: Development and demonstration of an optimized systems platform enabling the next-generation Ultra-Efficient SMR aircraft. The topic aims to integrate high-performance computing, electrical power and data architectures into a unified, certifiable platform, supporting advanced functions such as active control, hybridisation and predictive maintenance by means of a representative ground demonstration at TRL6 validating performance, safety and cybersecurity, with clear pathways to CRL4 and future maturation towards aircraft integration and EIS 2035. See the topic description document published with this call for full details.";
    schema:url "https://ec.europa.eu/info/funding-tenders/opportunities/portal/screen/opportunities/topic-details/HORIZON-JU-CLEAN-AVIATION-2026-04-SMR-01";
