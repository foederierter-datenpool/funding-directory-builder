cdf:funding-46df4e87e571 a schema:FundingScheme;
    schema:name "Förderung der Bürgerstiftung der Schöfferstadt Gernsheim";
    schema:description "Die Bürgerstiftung der Schöfferstadt Gernsheim ist eine unabhängige, autonom handelnde, gemeinnützige Stiftung von Bürgern für Bürger und setzt sich für das Gemeinwohl der Stadt Gernsheim ein. So konnte im Jahr 2019 der Ortsverband Gernsheim des Deutschen Roten Kreuzes mit einem Defibrillator und der Verein Auszeit e.V. mit einem Duo-Chopper ausgestattet werden. Während der Corona-Pandemie trug die Bürgerstiftung dank einer großzügigen Spende dazu bei, dass die Gernsheimer Arzt- und Zahnarztpraxen, Pflegedienste, das Haus Rheinaue und das Deutsche Rote Kreuz mit ausreichend Schutzausrüstung versorgt werden konnte.";
    schema:url "https://foerderdatenbank.d-s-e-e.de/foerderprogramme/foerderung-der-buergerstiftung-der-schoefferstadt-gernsheim";
    cdf:fundingArea "bildung", "kinder_und_jugendliche", "umwelt_naturschutz_klimaschutz_und_tierschutz", "kultur_medien_und_musik", "sonstiges", "soziales", "sport_und_bewegung";
    dct:spatial "DE7";
    cdf:deadlineModel "rolling".
