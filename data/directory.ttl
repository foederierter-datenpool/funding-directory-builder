    cdf:eligibleApplicant "hochschule", "forschungseinrichtungen";
    cdf:fundingType "zuschuss";
    schema:keywords "Forschungsvorhaben", "Forschungsinfrastruktur", "Forschungstransfer", "Strukturwandel", "Kohleausstieg", "Wissenschaftstransfer";
