cdf:funding-d6cf5eaa2f0d a schema:FundingScheme;
    schema:name "Garantien von Beteiligungen an kleinen und mittleren Unternehmen der gewerblichen Wirtschaft";
    schema:description "Das Land Nordrhein-Westfalen übernimmt Garantien für Beteiligungen von privaten Kapitalbeteiligungsgesellschaften (KBG) an kleinen und mittleren Unternehmen ( KMU ). Die Förderung besteht in Form einer Garantie zur Sicherung einer Beteiligung. Die Garantie wird in Höhe von 70 Prozent der Beteiligungssumme und gegebenenfalls von 70 Prozent der vertraglich vereinbarten Ansprüche auf den Ertrag der stillen Beteiligung gegeben. Die Beteiligung beträgt mindestens EUR 50.000 und soll in der Regel einen Betrag von EUR 1 Million nicht übersteigen. Die Garantie des Landes für eine stille/offene Beteiligung wird für eine Dauer von bis zu 10 Jahren gegeben. Ihren Antrag reichen Sie bei der PricewaterhouseCoopers GmbH Wirtschaftsprüfungsgesellschaft ein.";
    schema:url "https://www.foerderdatenbank.de/FDB/Content/DE/Foerderprogramm/Land/NRW/garantien-von-beteiligungen-an-kmu-der-gewerbliche.html";
    cdf:fundingArea "unternehmensfinanzierung", "existenzgruendung_und_festigung";
    dct:spatial "DEA";
    cdf:funderLevel "land";
    cdf:fundingSubarea "energieeffizienz_erneuerbare_energien.betriebliche_private_investitionen", "infrastruktur.energie_umwelt", "umwelt_naturschutz.betriebliche_private_investitionen", "unternehmensfinanzierung.betriebliche_investitionen", "energieeffizienz_erneuerbare_energien.forschung_innovation", "kultur_medien_sport.sport_sportstaetten", "gesundheit_soziales.senioren_pflege", "gesundheit_soziales.gesundheit", "infrastruktur.gesundheit_soziales", "existenzgruendung_festigung.festigungsinvestitionen", "existenzgruendung_festigung.gruendungsinvestitionen", "forschung_innovation_themenoffen.betriebliche_innovationen", "kultur_medien_sport.film_fernsehen", "forschung_innovation_themenoffen.forschung_entwicklung", "infrastruktur.information_kommunikation", "forschung_innovation_themenoffen.patentierung_verwertung", "landwirtschaft_laendliche_entwicklung.fischwirtschaft", "landwirtschaft_laendliche_entwicklung.einzelbetriebliche_foerderung", "landwirtschaft_laendliche_entwicklung.forstwirtschaft", "infrastruktur.laendliche_entwicklung", "infrastruktur.tourismus", "messen_ausstellungen.inlandsmessen";
