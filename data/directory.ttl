cdf:funding-7f9c8d48c051 a schema:FundingScheme;
    schema:name "Stimulation of Chip Design ";
    schema:description "Expected Outcome: Practical chip design experience integrated into education at multiple levels; at least 1,000 students across Europe completing funded tape-outs over 4 years; stronger reskilling pathways for students from adjacent fields; and a sustainable, continent-wide pipeline of chip design talent to support Europe's semiconductor ambitions. Scope: This call funds a comprehensive Chip Design Skills Programme to lower barriers to entry in chip design and tape-outs. At least 60% of the budget must support hands-on tape-out experiences (via multi-project wafers) for university and secondary school students.";
    schema:url "https://ec.europa.eu/info/funding-tenders/opportunities/portal/screen/opportunities/topic-details/DIGITAL-JU-CHIPS-2026-SKILLS-SCD-CSA";
    cdf:deadlineModel "single_stage";
    cdf:status "ended";
    schema:applicationDeadline "2026-09-24"^^<http://www.w3.org/2001/XMLSchema#date>.
