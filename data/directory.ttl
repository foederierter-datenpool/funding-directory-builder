    cdf:funderLevel "land";
    cdf:fundingSubarea "regionalfoerderung.laendliche_entwicklung", "infrastruktur.laendliche_entwicklung", "landwirtschaft_laendliche_entwicklung.laendliche_entwicklung";
    cdf:eligibleApplicant "privatpersonen", "verband_vereinigung", "oeffentliche_einrichtung", "kommunen", "unternehmen";
