cdf:funding-1df8ede5ba2c a schema:FundingScheme;
    schema:name "Förderung der Stiftung Sonnenschein (Oerlenbach)";
    schema:description "Die Stiftung Sonnenschein (Oerlenbach) ist die fördert Jugend-und Altenhilfe, Kultur, Kunst und Denkmalpflege, öffentlichem Gesundheitswesen, Umwelt- und Naturschutz, Landschaftspflege, Tierschutz, Sport, Heimatpflege und Heimatkunde, Erziehung, Volks-und Berufsbildung, Wissenschaft und Forschung, internationaler Gesinnung zur Toleranz auf allen Gebieten der Kultur und des Völkerverständigungsgedankens in in Oerlenbach.";
    schema:url "https://foerderdatenbank.d-s-e-e.de/foerderprogramme/foerderung-der-stiftung-sonnenschein-oerlenbach";
    cdf:fundingArea "bildung", "umwelt_naturschutz_klimaschutz_und_tierschutz", "kultur_medien_und_musik", "sonstiges", "soziales", "wissenschaft_und_forschung", "sport_und_bewegung", "bauten_und_denkmalschutz";
