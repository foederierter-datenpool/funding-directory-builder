    cdf:fundingType "zuschuss";
    schema:keywords "Fachkräfte", "Selbsthilfe", "Kontaktstellen";
    cdf:legalCitation "Runderlass des Ministeriums für Arbeit, Gesundheit, und Soziales des Landes Nordrhein-Westfalen vom 27. Februar 2024, Ministerialblatt für das Land Nordrhein-Westfalen Nr. 10 vom 2. April 2024, S. 446.".
cdf:funding-f57fbcf794a4 a schema:FundingScheme;
    schema:name "Förderung von Linienomnibussen im ÖPNV";
    schema:description "Die Beschaffung von Linienomnibussen kann bezuschusst werden, soweit diese zum Erhalt und zur Verbesserung von Linienverkehren nach § 42 des Personenbeförderungsgesetzes erforderlich sind.";
