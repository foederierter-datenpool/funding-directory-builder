    cdf:eligibleApplicant "privatpersonen", "unternehmen";
    cdf:fundingType "zuschuss", "kredit_darlehen";
    schema:keywords "sozial", "Neubau", "Erweiterung", "Mietwohnungen", "Änderung", "bezahlbarer Mietwohnraum", "einkommenschwach", "Einkommensgrenzen";
    cdf:legalCitation "Bekanntmachung ?Wohnraumförderungsbestimmungen 2023 (WFB 2023)? des Bayerischen Staatsministeriums für Wohnen, Bau und Verkehr vom 13. April 2023, Bayerisches Ministerialblatt Nr. 206 vom 3. Mai 2023; geändert durch Bekanntmachung des Bayerischen Staatsministeriums für Wohnen, Bau und Verkehr vom 1. Februar 2024, Bayerisches Ministerialblatt Nr. 86 vom 21. Februar 2024.".
