cdf:funding-aa595d3143c8 a schema:FundingScheme;
    schema:name "#BeActive-EU-SPORT-AWARDS-Volunteering";
    schema:description "Scope: This award aims to recognise sport activities implemented by organisations and/or individuals that have made outstanding contributions to sports through volunteer work. It also recognises dedication, leadership, and the positive impact of volunteers in fostering community engagement, inclusivity, and the development of sports at all levels. This category celebrates organisations and individuals that have demonstrated outstanding commitment to supporting and developing sports through volunteer efforts. It highlights the crucial role volunteers play in shaping the future of sports and inspiring positive change in their communities.";
