    cdf:eligibleApplicant "unternehmen";
    cdf:fundingType "kredit_darlehen";
    schema:keywords "KMU-Förderung", "Emissionen", "Nachhaltigkeitsförderung", "Energieverbrauch", "Ökologisch Verbraucherschutz";
