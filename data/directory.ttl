cdf:funding-c81cec808320 a schema:FundingScheme;
    schema:name "Förderungen der Hagnauer Volksbank Stiftung";
    schema:description "Die Hagnauer Volksbank Stiftung unterstützt gemeinnützige Projekte und Organisationen im Geschäftsgebiet der Hagnauer Volksbank insbesondere in Hagnau, Immenstaad und Kippenhausen. Mit einem Stiftungsvermögen von 300.000 Euro leistet die Stiftung im Vergleich zu der Größe der Bank einen beachtlichen Beitrag. Die Stiftung freut sich darauf, heute und in Zukunft das Gemeinwohl in ihrer Heimat zu fördern und damit die Verbundenheit zur Region zu zeigen.";
    schema:url "https://foerderdatenbank.d-s-e-e.de/foerderprogramme/foerderungen-der-hagnauer-volksbank-stiftung";
    cdf:fundingArea "bildung", "bildung_fuer_nachhaltige_entwicklung", "kinder_und_jugendliche", "umwelt_naturschutz_klimaschutz_und_tierschutz", "kultur_medien_und_musik", "digitalisierung", "sonstiges", "soziales", "wissenschaft_und_forschung", "engagement_fuer_gesellschaftlichen_zusammenhalt_demokratie", "migration", "entwicklungszusammenarbeit", "sport_und_bewegung", "bevoelkerungs_und_katastrophenschutz", "bauten_und_denkmalschutz";
