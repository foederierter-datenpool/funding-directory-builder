cdf:funding-bb6d11a344dc a schema:FundingScheme;
    schema:name "Förderung der Kultur- und Sportstiftung der Kreissparkasse Euskirchen";
    schema:description "Die Bürgerstiftung sowie die Kultur- und Sportstiftung der Kreissparkasse Euskirchen fördern jährlich hunderte Projekte und Initiativen in der Region für die Region.";
