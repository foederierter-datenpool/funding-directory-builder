cdf:funding-e8e131c4d260 a schema:FundingScheme;
    schema:name "Förderleistung für Schwangere in Not durch die \"Landesstiftung Hilfe für Mutter und Kind\"";
    schema:description "Die \"Landesstiftung Hilfe für Mutter und Kind\" hilft schwangeren Frauen vor Geburt und bis zu 36 Monate nach Geburt des Kindes, sofern sie sich in einer Notlage befinden.";
