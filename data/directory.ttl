cdf:funding-e9d01384f5e6 a schema:FundingScheme;
    schema:name "Förderung durch die Stiftung der Lebenshilfen Bitburg-Daun-Prüm";
    schema:description "Die gemeinnützigen Lebenshilfen des Eifelkreis Bitburg und des Vulkaneifelkreises Daun haben gemeinsam die Stiftung der Lebenshilfen Bitburg, Daun, Prüm im Jahr 2008 gegründet.";
