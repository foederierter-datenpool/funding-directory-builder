cdf:funding-343466280d6f a schema:FundingScheme;
    schema:name "Ausfallbürgschaften der Bürgschaftsbank Rheinland-Pfalz ? Bürgschaft Classic";
    schema:description "Die Bürgschaftsbank Rheinland-Pfalz entlastet Sie als gewerbliches Unternehmen sowie als Angehörige und Angehörigen der Freien Berufe in Form einer Bürgschaft von Ihrem Kreditrisiko. Sie bekommen die Bürgschaft unter anderem zur Finanzierung folgender Vorhaben: Existenzgründungen, Unternehmensnachfolgen und Betriebsübernahmen, tätige Beteiligungen, Betriebserweiterungen und -verlagerungen, Investitionen, Betriebsmittelfinanzierungen, Anlauf-/Markteinführungskosten, Produktentwicklung sowie Forschung und Entwicklung. Die Höhe der Bürgschaft beträgt bis zu EUR 2 Millionen. Die Bürgschaft deckt bis zu 80 Prozent der Kreditsumme ab. Für Bürgschaften mit einem Volumen über EUR 2 Millionen ist die Investitions- und Strukturbank Rheinland-Pfalz ( ISB ) zuständig. Die Bürgschaft beantragen Sie bitte zusammen mit Ihrer Hausbank oder einem anderen Kreditinstitut Ihrer Wahl. Der Antrag wird von dort an die Bürgschaftsbank Rheinland-Pfalz weitergeleitet.";
    schema:url "https://www.foerderdatenbank.de/FDB/Content/DE/Foerderprogramm/Land/Rheinland-Pfalz/ausfallbuergschaften-buergschaftsbank-rlp-classic.html";
    cdf:fundingArea "unternehmensfinanzierung", "existenzgruendung_und_festigung";
    dct:spatial "DEB";
    cdf:funderLevel "land";
    cdf:fundingSubarea "unternehmensfinanzierung.betriebliche_investitionen", "existenzgruendung_festigung.festigungsinvestitionen", "existenzgruendung_festigung.gruendungsinvestitionen", "existenzgruendung_festigung.betriebsmittel", "unternehmensfinanzierung.betriebsmittel";
    cdf:eligibleApplicant "unternehmen", "existenzgruenderin";
    cdf:fundingType "buergschaft";
