    cdf:fundingSubarea "gesundheit_soziales.kinder_jugendliche_familien", "aus_weiterbildung.weiterbildung_von_arbeitnehmern", "gesundheit_soziales.integration";
    cdf:eligibleApplicant "bildungseinrichtung", "verband_vereinigung";
