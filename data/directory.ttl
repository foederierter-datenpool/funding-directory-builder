cdf:funding-f9d7f99c7586 a schema:FundingScheme;
    schema:name "Fonds für junge Ideen";
    schema:description "Du hast eine kreative Idee, die du mit anderen gemeinsam umsetzen möchtest? Dann hast du jetzt die Chance, dafür Geld zu bekommen! Mit dem „Fonds für junge Ideen“ wollen wir (Anm.: das Hessische Ministerium für Soziales und Integration) dein Engagement und deine Ideen unterstützen. Ziel ist es, dass du und deine Freunde etwas bewegen könnt. Sei es in deinem Stadtteil, in der Schule oder auf ganz neuen Wegen. Zeig uns, wie du deine Umgebung mitgestalten möchtest!";
    schema:url "https://foerderdatenbank.d-s-e-e.de/foerderprogramme/fonds-fuer-junge-ideen";
    cdf:fundingArea "bildung", "kinder_und_jugendliche", "kultur_medien_und_musik";
    dct:spatial "DE7";
    cdf:deadlineModel "rolling".
