    dct:spatial "DE7";
    cdf:deadlineModel "rolling".
cdf:funding-bdb323b9fd8b a schema:FundingScheme;
    schema:name "Förderung der BayWa Stiftung";
    schema:description "Gegründet wurde die BayWa Stiftung 1998 von der BayWa AG. Die Stiftung ist die Antwort des Unternehmens auf drängende Fragen der Grundversorgung und ein Engagement für Menschen. Insofern bietet die Stiftung neben Bildungsangeboten auch direkte Unterstützung an, um Versorgungslücken zu schließen.";
    schema:url "https://foerderdatenbank.d-s-e-e.de/foerderprogramme/foerderung-der-baywa-stiftung";
    cdf:fundingArea "bildung", "bildung_fuer_nachhaltige_entwicklung", "umwelt_naturschutz_klimaschutz_und_tierschutz", "sonstiges", "entwicklungszusammenarbeit";
