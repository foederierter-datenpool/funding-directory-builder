cdf:funding-6ac3c2cc9bfa a schema:FundingScheme;
    schema:name "Förderprogramm der Carls Stiftung";
    schema:description "Die Carls Stiftung hat die Förderung des Gesundheitswesens, der Erziehung und Bildung, der Wissenschaft sowie kultureller Einrichtungen oder Projekte zum Zweck. Die Carls Stiftung wurde vom Ehepaar Ursula und Otto Wilhelm Carls gestiftet. Projekte werden von der Stiftung mit bis zu 5.000 Euro gefördert.";
