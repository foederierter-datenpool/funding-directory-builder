    cdf:status "ended";
    schema:applicationDeadline "2026-05-27"^^<http://www.w3.org/2001/XMLSchema#date>.
cdf:funding-3968edeca231 a schema:FundingScheme;
    schema:name "Förderrichtlinie Öffentliches Wohnen im Land Nordrhein-Westfalen 2024 (FRL öff Wohnen NRW 2024)";
    schema:description "Das Land Nordrhein-Westfalen unterstützt Sie bei der (Neu-)Schaffung, Modernisierung und Erhaltung moderner, barrierefreier, klimaschutzorientierter und vor allem bezahlbarer Wohnstandorte und Wohnangebote mit Mietpreis- und Belegungsbindungen für unterschiedliche Zielgruppen. Sie erhalten die Förderung in folgenden Bereichen: Förderung von Mietwohnraum Förderung von selbstgenutztem Wohneigentum Modernisierungsförderung Förderung von Wohnplätzen für Auszubildende und Studierende Förderung von Gruppenwohnungen Förderung von Wohnraum für Menschen mit Behinderungen in Einrichtungen mit umfassendem Leistungsangebot Bindungsverlängerung für Mietwohnraum Bindungserwerb Sie erhalten die Förderung als Darlehen, im Förderbreich ?Bindungserwerb? als einmaligen Festbetragszuschuss. Die Höhe des Darlehens ist abhängig von Ihrem Vorhaben in dem jeweiligen Förderbereich. Richten Sie Ihren Antrag bitte vor Beginn Ihres Vorhabens an das für Sie zuständige Amt für Wohnungswesen. Weitere Informationen zu den einzelnen Förderbereichen erhalten Sie auch bei der NRW .BANK.";
    schema:url "https://www.foerderdatenbank.de/FDB/Content/DE/Foerderprogramm/Land/NRW/frl-oeffentliches-wohnen-nrw-2024.html";
    cdf:fundingArea "wohnungsbau_und_modernisierung";
    dct:spatial "DEA";
    cdf:funderLevel "land";
    cdf:fundingSubarea "wohnungsbau_modernisierung.modernisierung_sanierung", "wohnungsbau_modernisierung.soziale_wohnraumfoerderung", "wohnungsbau_modernisierung.wohnungsbau_erwerb";
    cdf:eligibleApplicant "privatpersonen", "verband_vereinigung", "unternehmen";
    cdf:fundingType "zuschuss", "kredit_darlehen";
    schema:keywords "Wohnungsbau", "Eigentumswohnung", "energetisch", "Wohnraum", "Mietwohnung", "Wohnquartier";
    cdf:legalCitation "Runderlass des Ministeriums für Heimat, Kommunales, Bau und Digitalisierung des Landes Nordrhein-Westfalen vom 1. März 2024, Ministerialblatt für das Land Nordrhein-Westfalen Nr. 13 vom 25. April 2024, S. 488.".
cdf:funding-396a0f82a66a a schema:FundingScheme;
    schema:name "Ehrenamtliche Sprachbildungsförderung";
    schema:description "Für welche Zwecke gibt es eine Förderung? Lehrmaterial für ehrenamtliche Sprachkurse Art der Förderung: Zuwendung Themenfeld: Integration/Flüchtlinge Regelmäßigkeit der Förderung: fortlaufend Zielgruppen: keine Einschränkung Max. Förderung: max. 2 Anträge à 500 €/ Jahr";
