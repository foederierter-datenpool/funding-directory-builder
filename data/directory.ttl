cdf:funding-57b2027bf8ad a schema:FundingScheme;
    schema:name "Förderung der Stadt Stiftung Bad Lippspringe";
    schema:description "Die Stadt Stiftung Bad Lippspringe ist eine Bürgerstiftung, die es sich zur Aufgabe gemacht hat, nachhaltig das Gemeinschaftsgefühl zu stärken und damit dauerhaft die Lebensqualität in der Region Bad Lippspringe zu fördern.";
    schema:url "https://foerderdatenbank.d-s-e-e.de/foerderprogramme/foerderung-der-stadt-stiftung-bad-lippspringe";
