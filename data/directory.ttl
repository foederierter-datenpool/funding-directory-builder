cdf:funding-299664482d5a a schema:FundingScheme;
    schema:name "Förderung der Heinz-Otto-Stiftung";
    schema:description "Die Heinz-Otto-Stiftung wurde im Dezember 2007 als gemeinnützige Stiftung des bürgerlichen Rechts gegründet. Der Stiftungszweck ist die Förderung von Erziehung, Aus- und Fortbildung, Kultur, traditionellem Brauchtum, Sport und Rettungswesen. Der Schwerpunkt ist die Kinder- und Jugendförderung.";
    schema:url "https://foerderdatenbank.d-s-e-e.de/foerderprogramme/heinz-otto-stiftung";
