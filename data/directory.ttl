    cdf:eligibleApplicant "privatpersonen", "verband_vereinigung", "oeffentliche_einrichtung", "kommunen";
    cdf:fundingType "zuschuss";
    schema:keywords "Familienhilfe", "Krisenhilfe", "Beratungsnetzwerk", "Familienpflegestation", "pflegende Angehörige", "Pflegestützpunkt".
