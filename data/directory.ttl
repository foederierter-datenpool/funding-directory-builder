    cdf:fundingSubarea "unternehmensfinanzierung.betriebliche_investitionen", "kultur_medien_sport.film_fernsehen", "infrastruktur.kultur";
    cdf:eligibleApplicant "bildungseinrichtung", "verband_vereinigung", "unternehmen";
    cdf:fundingType "kredit_darlehen";
    schema:keywords "Medien", "Filmförderung", "Filmproduktion", "Kino", "Festival", "Fernsehproduktion", "Film Fernsehen";
