cdf:funding-f90273385545 a schema:FundingScheme;
    schema:name "Kommunales Energiemanagement (KEM)";
    schema:description "Bringen Sie Ordnung in den Energieverbrauch Ihrer Kommune! Unsere Förderung hilft Kommunen bei der Analyse des Energieverbrauchs. Mit einem Energie- und ggf. kombinierten Qualitätsmanagement sparen Sie beim Betrieb Ihrer Liegenschaften CO2 und bares Geld.";
