    cdf:eligibleApplicant "verband_vereinigung", "kommunen";
    cdf:fundingType "zuschuss";
    schema:keywords "Kultur", "Kulturelle Arbeit", "Kulturinitiative", "Kulturinitiativen", "LAKS", "soziokulturelle Zentren", "soziokulturelles Zentrum";
    cdf:legalCitation "Verwaltungsvorschrift des Ministeriums für Wissenschaft, Forschung und Kunst Baden-Württemberg vom 5. Dezember 2017; Informationen der Landesarbeitsgemeinschaft der Kulturinitiativen und soziokulturellen Zentren in Baden-Württemberg (LAKS) e.V. , Stand Dezember 2025.".
cdf:funding-2688b9b97002 a schema:FundingScheme;
    schema:name "Förderungen der Stiftung der Kreissparkasse Fallingbostel in Walsrode";
    schema:description "Das Engagement der Kreissparkasse Fallingbostel in Walsrode vor Ort gestaltet sich äußerst vielfältig. Bereits im Jahr 1999 wurde die Stiftung der Kreissparkasse Fallingbostel in Walsrode ins Leben gerufen. Die Sparkassenstiftung unterstützt unterschiedliche Projekte im Altkreis Fallingbostel.";
    schema:url "https://foerderdatenbank.d-s-e-e.de/foerderprogramme/foerderungen-der-stiftung-der-kreissparkasse-fallingbostel-in-walsrode";
