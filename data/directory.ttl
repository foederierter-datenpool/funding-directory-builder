    cdf:eligibleApplicant "verband_vereinigung";
    cdf:fundingType "zuschuss";
    schema:keywords "Umweltschutz", "Naturschutz", "Verwaltungskosten";
    cdf:legalCitation "Bekanntmachung des Ministeriums für Energiewende, Landwirtschaft, Umwelt, Natur und Digitalisierung vom 28. November 2020, Amtsblatt für Schleswig-Holstein Nr. 51 vom 14. Dezember 2020, S. 1677.".
