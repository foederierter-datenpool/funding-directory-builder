cdf:funding-779afa6fc226 a schema:FundingScheme;
    schema:name "Förderung der Bürgerstiftung Essingen";
    schema:description "Zweck der Stiftung ist die Förderung und / oder die Würdigung der Bildung und Erziehung, der Wissenschaft und Forschung, der Jugend- und Seniorenhilfe, der Kunst und Kultur, der Heimatpflege und Denkmalpflege, des Sports, des Umwelt- und Naturschutzes und der Landschaftspflege, des öffentlichen Gesundheitswesens, mildtätiger Zwecke";
    schema:url "https://foerderdatenbank.d-s-e-e.de/foerderprogramme/foerderung-der-buergerstiftung-essingen";
