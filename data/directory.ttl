    cdf:fundingSubarea "unternehmensfinanzierung.betriebliche_investitionen", "unternehmensfinanzierung.konsolidierung_stabilisierung", "unternehmensfinanzierung.nachfolge";
    cdf:eligibleApplicant "unternehmen";
    cdf:fundingType "kredit_darlehen", "buergschaft";
    schema:keywords "Unternehmensfinanzierung", "Konsolidierung", "Unternehmenswachstum".
