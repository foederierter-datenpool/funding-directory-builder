    cdf:fundingType "zuschuss";
    schema:keywords "Pflege", "Versorgung", "Senioren", "Gesundheitsvorsorge", "Pflegerin", "Pflegplan";
    cdf:legalCitation "Richtlinie des Ministeriums für Soziales und Integration vom 30. November 2022, Staatsanzeiger für das Land Hessen Nr. 51 vom 19. Dezember 2022, S. 1446.".
