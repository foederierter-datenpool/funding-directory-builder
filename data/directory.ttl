    cdf:fundingSubarea "existenzgruendung_festigung.festigungsinvestitionen", "existenzgruendung_festigung.gruendungsinvestitionen", "existenzgruendung_festigung.beratung_schulung", "existenzgruendung_festigung.gruendungsstrukturen_netzwerke";
    cdf:eligibleApplicant "verband_vereinigung", "hochschule", "forschungseinrichtungen", "unternehmen", "existenzgruenderin";
