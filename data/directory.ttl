    schema:keywords "Dürre", "Eis", "Erdbeben", "Erdrutsche", "Flächenbrand", "Frost", "Hagel", "Lawinen", "Orkane", "Schadensausgleich", "Starkregen", "Sturm", "Überschwemmungen";
