cdf:funding-adb58a6b7331 a schema:FundingScheme;
    schema:name "Förderung der Stiftung Wirtschaftshof Spandau";
    schema:description "Die Vereinigung Wirtschaftshof ist mit ihrer Stiftung eine karitative Einrichtung. Es werden bedürftige Spandauer Kinder, Jugendliche, Rentner und Invaliden unterstützt sowie Spandauer Sportvereine und die Heimatpflege gefördert.";
