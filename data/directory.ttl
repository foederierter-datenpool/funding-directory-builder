    cdf:eligibleApplicant "verband_vereinigung", "oeffentliche_einrichtung", "kommunen", "unternehmen";
    cdf:fundingType "zuschuss";
    schema:keywords "Investition", "Kultur", "Kulturraum", "Strukturmaßnahme";
    cdf:legalCitation "Verwaltungsvorschrift des Sächsischen Staatsministeriums für Wissenschaft, Kultur und Tourismus vom 8. August 2013, Sächsisches Amtsblatt Nr. 36 vom 5. September 2013, S. 894; zuletzt geändert durch Bekanntmachung vom 10. Juni 2023, Sächsisches Amtsblatt Nr. 26 vom 29. Juni 2023, S. 755.".
cdf:funding-101f9bd24aac a schema:FundingScheme;
    schema:name "Förderung der Bürgerstiftung Wardenburg";
    schema:description "Die Bürgerstiftung Wardenburg will Kräfte bürgerschaftlichen Engagements mobilisieren, um damit dem Gemeinwohl zu dienen und das Gemeinwesen der Gemeinde Wardenburg zu stärken. Sie will erreichen, dass die Bürgerinnen und Bürger und Wirtschaftsunternehmen der Gemeinde mehr Mitverantwortung für die Gestaltung ihres Gemeinwesens übernehmen. Dies soll zum einen durch das Einwerben von Zustiftungen und Spenden geschehen, die die Bürgerstiftung in die Lage versetzen, regionale Projekte aus den Bereichen Jugend und Senioren, Bildung und Erziehung und Soziales zu fördern. Zweck der Stiftung ist die Förderung des Gemeinwohls, insbesondere in den Bereichen: Bildung und Erziehung, Jugend und Senioren, Heimatpflege, Kunst, Kultur und Sport Bürgerschaftliches Engagement zugunsten gemeinnütziger und mildtätiger Zwecke die Förderung mildtätiger Zwecke durch Unterstützung von Personen im Sinne von § 53 Abgabenordnung und Unterstützung wirtschaftlich hilfebedürftiger Jugendlicher aus benachteiligten Familien in der Gemeinde Wardenburg";
    schema:url "https://foerderdatenbank.d-s-e-e.de/foerderprogramme/bürgerstiftung-wardenburg";
    cdf:fundingArea "bildung", "kinder_und_jugendliche", "kultur_medien_und_musik", "sonstiges", "soziales", "engagement_fuer_gesellschaftlichen_zusammenhalt_demokratie";
    dct:spatial "DE9";
    cdf:deadlineModel "rolling".
