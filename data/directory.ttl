cdf:funding-6f609dab91ce a schema:FundingScheme;
    schema:name "Förderung der Sparkassen-Stiftung Holstein";
    schema:description "Die Arbeit der Sparkassen-Stiftung Holstein konzentriert sich auf deren angrenzende Kommunen in Hamburg, Norderstedt und Lübeck. Gefördert wurden bisher vor allem Musikveranstaltungen, Kindergärten und Schulen sowie Sportvereine. Die Stiftung ist fördernd und operativ tätig. Die Sparkassen-Stiftung Holstein fördert und realisiert gemeinnützige Projekte in den an die Kreise Stormarn und Ostholstein angrenzenden Gebietskörperschaften, insbesondere Norderstedt, Hamburg und Lübeck. Die Stiftung ist operativ und fördernd tätig.";
    schema:url "https://foerderdatenbank.d-s-e-e.de/foerderprogramme/foerderung-der-sparkassen-stiftung-holstein";
    cdf:fundingArea "bildung", "umwelt_naturschutz_klimaschutz_und_tierschutz", "kultur_medien_und_musik", "soziales", "sport_und_bewegung", "bevoelkerungs_und_katastrophenschutz";
    dct:spatial "DE6", "DEF";
    cdf:deadlineModel "rolling".
