cdf:funding-a6ee4d51a936 a schema:FundingScheme;
    schema:name "Projektförderung der Bürgerstiftung Schleswig-Holsteinische Gedenkstätten";
    schema:description "Die aktive Erinnerung an Verfolgung, Verbrechen und Widerstand in der NSZeit im Rahmen einer gegenwartsbezogenen historisch-politischen Bildung an Gedenkstätten und Erinnerungsorten in Schleswig-Holstein ist der Stiftung besonders wichtig.";
