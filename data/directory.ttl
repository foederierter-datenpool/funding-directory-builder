cdf:funding-9739d1623b0c a schema:FundingScheme;
    schema:name "Masterplan der Duisburger Jugendsportstiftung";
    schema:description "Sportvereine haben die Möglichkeit über den Stadtsportbund Duisburg e.V. Zuschüsse für Investitionsvorhaben zu bekommen. Der sog. Masterplan bietet dabei eine Bezuschussung von 50 % der Investtitionssumme, maximal aber 1.000 €.";
