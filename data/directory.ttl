    cdf:deadlineModel "rolling".
cdf:funding-45deb977a39b a schema:FundingScheme;
    schema:name "Förderung der Stiftung des Hohenlohekreises";
    schema:description "Im November 2008 beschloss der Kreistag des Hohenlohekreises die Gründung der Stiftung des Hohenlohekreises, eine kommunale Stiftung des bürgerlichen Rechts. Zentraler Inhalt der Stiftung ist die Förderung von Projekten, durch erwirtschaftete Erträge, in den Bereichen: Wissenschaft und Forschung Denkmal-, Kunst- und Kulturpflege Natur- und Umweltschutz sowie Heimat- und Landschaftspflege Bildung und Sport Kinder-, Jugend-, Familien-, Behinderten- und Altenpflege sowie ehrenamtliches Engagement";
    schema:url "https://foerderdatenbank.d-s-e-e.de/foerderprogramme/foerderung-der-stiftung-des-hohenlohekreises";
    cdf:fundingArea "bildung", "kinder_und_jugendliche", "umwelt_naturschutz_klimaschutz_und_tierschutz", "kultur_medien_und_musik", "sonstiges", "soziales", "wissenschaft_und_forschung", "sport_und_bewegung", "bauten_und_denkmalschutz";
    dct:spatial "DE1";
