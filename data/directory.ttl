    cdf:funderLevel "land";
    cdf:fundingSubarea "forschung_innovation_themenoffen.forschung_entwicklung", "infrastruktur.forschung_innovation";
    cdf:eligibleApplicant "bildungseinrichtung", "hochschule", "forschungseinrichtungen";
    cdf:fundingType "zuschuss";
