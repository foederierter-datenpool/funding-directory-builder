cdf:funding-ce306a834e82 a schema:FundingScheme;
    schema:name "Bürgschaften der Investitions- und Strukturbank Rheinland-Pfalz";
    schema:description "Die ISB entlastet Sie als gewerbliches Unternehmen oder Angehörige und Angehörigen der Freien Berufe durch eine Bürgschaft von Ihrem Kreditrisiko. Die Bürgschaft bekommen Sie zur Finanzierung folgender Vorhaben: Investitionen und Betriebsmittel (Bar-/Avalkredite). Die ISB übernimmt Ausfallbürgschaften bis zur Höhe von höchstens 80 Prozent bei Investitionskrediten, 70 Prozent bei Avalkrediten und 60 Prozent bei Betriebsmittelkrediten. Die Höhe der Bürgschaft beträgt normalerweise zwischen mindestens EUR 2 Millionen und höchstens EUR 3,5 Millionen. Für Bürgschaften bis EUR 2 Millionen ist die Bürgschaftsbank Rheinland-Pfalz zuständig. Die Bürgschaft beantragen Sie zusammen mit Ihrer Hausbank oder einem anderen Kreditinstitut Ihrer Wahl. Der Antrag wird von dort an die ISB weitergeleitet.";
    schema:url "https://www.foerderdatenbank.de/FDB/Content/DE/Foerderprogramm/Land/Rheinland-Pfalz/buergschaft-investitionsbank-rheinland.html";
    cdf:fundingArea "unternehmensfinanzierung", "existenzgruendung_und_festigung";
    dct:spatial "DEB";
    cdf:funderLevel "land";
    cdf:fundingSubarea "unternehmensfinanzierung.betriebliche_investitionen", "existenzgruendung_festigung.festigungsinvestitionen", "existenzgruendung_festigung.gruendungsinvestitionen", "existenzgruendung_festigung.betriebsmittel", "unternehmensfinanzierung.betriebsmittel";
    cdf:eligibleApplicant "unternehmen", "existenzgruenderin";
    cdf:fundingType "buergschaft";
