    cdf:eligibleApplicant "bildungseinrichtung", "verband_vereinigung", "hochschule", "oeffentliche_einrichtung";
    cdf:fundingType "zuschuss";
    schema:keywords "Bildungsarbeit", "Unterricht", "Zuschuss", "Ausstellungen", "Entwicklungspolitik", "Medienarbeit", "Podiumsdiskussion", "Veranstaltungen", "Workshop".
cdf:funding-f0301b5fad26 a schema:FundingScheme;
    schema:name "Förderung der BürgerStiftung Obersulm";
    schema:description "Die Stiftung fördert die Übernahme von Verantwortung durch die Bürgerinnen und Bürger. Dabei geht es nicht nur um Absichten, sondern um die Entwicklung von Konzepten, die es den Menschen vor Ort ermöglichen, die vorhandenen Herausforderungen anzugehen. Als unabhängige, offene und breit angelegte Form des bürgerschaftlichen Engagements, ermöglichen Bürgerstiftungen Bürgerinnen, Unternehmen und Institutionen, aktiv gesellschaftliche Verantwortung zu übernehmen und die eigene Region aktiv mitzugestalten. Förderschwerpunkte: Soziale Teilhabe ermöglichen: Die Stiftung setzt sich dafür ein, Familien im Alltag zu unterstützen und die gesellschaftliche Teilhabe aller Menschen zu ermöglichen. Bildung & Erziehung: Ein besonderes Augenmerk liegt auf der Unterstützung und Initiierung von Projekten für Kinder und Jugendliche im Bereich Bildung und Erziehung. Gelebte Gemeinschaft: Unter dem Motto \"Hilfe zur Selbsthilfe\" werden Projekte angestoßen, die einer nachhaltigen Entwicklung des Gemeinwesens dienen und bürgerschaftliches Engagement fördern.";
    schema:url "https://foerderdatenbank.d-s-e-e.de/foerderprogramme/foerderung-der-buergerstiftung-obersulm";
    cdf:fundingArea "bildung", "kinder_und_jugendliche", "umwelt_naturschutz_klimaschutz_und_tierschutz", "kultur_medien_und_musik", "wissenschaft_und_forschung", "sport_und_bewegung", "bauten_und_denkmalschutz";
    dct:spatial "DE1";
