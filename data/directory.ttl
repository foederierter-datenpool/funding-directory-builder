cdf:funding-24c5b93ab119 a schema:FundingScheme;
    schema:name "Förderung der VINCI-Stiftung";
    schema:description "Die VINCI-Stiftung fördert Initiativen zur Eingliederung ausgegrenzter Menschen in das Erwerbsleben. Über Aus- und Fortbildung, berufliche Qualifikation und Mobilität sorgt sie für die Voraussetzungen, um einen Arbeitsplatz finden und behalten zu können. Zahlreiche soziale Einrichtungen in Deutschland engagieren sich seit vielen Jahren für mehr Solidarität. Die VINCI-Stiftung tritt an, um dieses Engagement mit Tatkraft und finanziellen Mitteln zu unterstützen und so den sozialen Zusammenhalt in unserem Land zu fördern.";
    schema:url "https://foerderdatenbank.d-s-e-e.de/foerderprogramme/foerderung-der-vinci-stiftung";
    cdf:fundingArea "sonstiges", "soziales", "engagement_fuer_gesellschaftlichen_zusammenhalt_demokratie";
    dct:spatial "DE";
    cdf:deadlineModel "rolling".
