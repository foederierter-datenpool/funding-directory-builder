    dct:spatial "DEE";
    cdf:funderLevel "land";
    cdf:fundingSubarea "forschung_innovation_themenoffen.gruendung_von_technologieunternehmen", "existenzgruendung_festigung.lebensunterhalt_soziale_sicherung", "existenzgruendung_festigung.gruendungsstrukturen_netzwerke";
    cdf:eligibleApplicant "hochschule", "existenzgruenderin";
