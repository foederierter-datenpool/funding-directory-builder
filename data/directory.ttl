    cdf:fundingSubarea "aus_weiterbildung.betriebliche_ausbildung", "aus_weiterbildung.weiterbildung_von_arbeitnehmern", "aus_weiterbildung.weiterbildungsstrukturen_traeger", "aus_weiterbildung.ausbildungsstrukturen_traeger", "infrastruktur.aus_weiterbildung";
    cdf:eligibleApplicant "bildungseinrichtung", "verband_vereinigung", "oeffentliche_einrichtung";
