    cdf:eligibleApplicant "verband_vereinigung", "kommunen";
    cdf:fundingType "zuschuss";
    schema:keywords "Wasserwirtschaft", "Bewässerungsanlagen", "Bewässerungsnetz", "Grundwasser", "Pumpanlage";
