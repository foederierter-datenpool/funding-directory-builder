cdf:funding-ef5dea971fec a schema:FundingScheme;
    schema:name "Bürgschaften der Bürgschaftsbank Schleswig-Holstein ? Massekredit-Bürgschaft";
    schema:description "Die Bürgschaftsbank Schleswig-Holstein entlastet Sie als Unternehmen von dem Ausfallrisiko des von Ihrer Hausbank eingeräumten Massekredits, den Sie zur Aufrechterhaltung Ihres Betriebs im Rahmen des Insolvenzeröffnungs- oder laufenden Insolvenzverfahrens brauchen. Die Höhe der Bürgschaft beträgt normalerweise 50 Prozent des Masseskreditbetrags, jedoch maximal EUR 500.000. Der Antrag wird von Bürgschaftsbank Schleswig-Holstein initiiert und gemeinsam mit der Hausbank und der Insolvenzverwaltung koordiniert.";
    schema:url "https://www.foerderdatenbank.de/FDB/Content/DE/Foerderprogramm/Land/Schleswig-Holstein/buergschaft-sh-massekredit.html";
    cdf:fundingArea "unternehmensfinanzierung";
    dct:spatial "DEF";
