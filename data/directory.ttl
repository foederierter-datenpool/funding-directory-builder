cdf:funding-37d179213676 a schema:FundingScheme;
    schema:name "Förderung der Dagmar + Matthias Krieger Stiftung";
    schema:description "Die Dagmar + Matthias Krieger Stiftung möchte Projekte unterstützen, die Kindern und Jugendlichen zu Gute kommen. Sowohl in Deutschland als auch in anderen Ländern fördert die Stiftung Maßnahmen auf verschiedenen Gebieten. Dabei soll die sichere Entwicklung und sorgenfreie Zukunft von Kindern und Jugendlichen im Fokus stehen. Die folgenden Themenbereiche sind deshalb förderfähig: Kunst und Kultur Wissenschaft und Forschung Erziehung, Volks- und Berufsbildung Sport Kinder- und Jugendhilfe Umwelt- und Naturschutz, Landschaftspflege Denkmalpflege und -schutz Gegründet wurde die Stiftung im Jahr 2011 von den Namensträgern.";
    schema:url "https://foerderdatenbank.d-s-e-e.de/foerderprogramme/dagmar-matthias-krieger-stiftung";
    cdf:fundingArea "bildung", "bildung_fuer_nachhaltige_entwicklung", "kinder_und_jugendliche", "umwelt_naturschutz_klimaschutz_und_tierschutz", "kultur_medien_und_musik", "soziales", "wissenschaft_und_forschung", "entwicklungszusammenarbeit", "sport_und_bewegung", "bauten_und_denkmalschutz";
    dct:spatial "DE";
    cdf:deadlineModel "rolling".
