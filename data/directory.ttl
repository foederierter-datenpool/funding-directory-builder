    cdf:fundingSubarea "gesundheit_soziales.buergerschaftliches_engagement", "kultur_medien_sport.kunst_kultur";
    cdf:eligibleApplicant "verband_vereinigung", "oeffentliche_einrichtung", "kommunen";
    cdf:fundingType "zuschuss";
    schema:keywords "regional", "Heimat", "Begegnung", "Heimatverbundenheit", "Tradition", "Austausch";
