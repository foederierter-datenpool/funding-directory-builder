cdf:funding-32d1a3729ed3 a schema:FundingScheme;
    schema:name "Förderung der Allianz für die Jugend";
    schema:description "Seit Mai 2008 ist der Verein unter dem Namen „Allianz für die Jugend e.V.“ im gesamten südwestdeutschen Raum tätig. Dazu gehören die Bundesländer Hessen, Saarland, Rheinland-Pfalz und Baden-Württemberg.";
    schema:url "https://foerderdatenbank.d-s-e-e.de/foerderprogramme/foerderung-der-allianz-fuer-die-jugend";
