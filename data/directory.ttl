cdf:funding-7ed4764516aa a schema:FundingScheme;
    schema:name "Förderungen der Sozial- und Sportstiftung der Kasseler Sparkasse";
    schema:description "Im Jahr 1992 wurde die Sozial- und Sportstiftung sowie die Kulturstiftung der Kasseler Sparkasse gegründet. Das Stiftungskapital der Kasseler Sparkassenstiftungen - Stadt Kassel - und das der Kasseler Sparkassenstiftung - Landkreis Kassel - beträgt insgesamt 10 Millionen Euro.";
