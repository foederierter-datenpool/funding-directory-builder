cdf:funding-8161d4c32fba a schema:FundingScheme;
    schema:name "Förderung der Hanse Stiftung";
    schema:description "Die gemeinnützige Hanse Stiftung wurde im Jahr 2003 gegründet und kümmert sich um 3 Schwerpunkte in den „klassischen“ Hansestädten Bremen, Hamburg und Lübeck: Bildung Erziehung Jugendhilfe Kinder sind die Zukunft der Gesellschaft, aber nicht alle starten mit den gleichen Chancen ins Leben. Darum hat sich die Hansestiftung zum Ziel gesetzt, unterschiedliche Projekte besonders in sozialen Brennpunkten zu fördern. In der globalisierten Welt spielt dabei die Integration von Ausländern eine zentrale Rolle. Gerade sportliche Betätigung ist ein geeignetes Instrument, um Menschen aus verschiedenen Kulturen zusammenzuführen.";
    schema:url "https://foerderdatenbank.d-s-e-e.de/foerderprogramme/foerderung-der-hanse-stiftung";
    cdf:fundingArea "bildung", "kinder_und_jugendliche", "migration", "sport_und_bewegung";
    dct:spatial "DE5", "DE6", "DEF";
    cdf:deadlineModel "rolling".
