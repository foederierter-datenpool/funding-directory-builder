    cdf:fundingSubarea "forschung_innovation_themenoffen.gruendung_von_technologieunternehmen", "existenzgruendung_festigung.lebensunterhalt_soziale_sicherung", "beratung.existenzgruendung_festigung", "existenzgruendung_festigung.beratung_schulung";
