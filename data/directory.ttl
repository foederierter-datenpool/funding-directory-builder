    cdf:fundingSubarea "beratung.forschung_innovation";
    cdf:eligibleApplicant "verband_vereinigung", "hochschule", "forschungseinrichtungen", "unternehmen";
    cdf:fundingType "zuschuss";
    schema:keywords "Innovation", "Technologieförderung", "Wettbewerbsfähigkeit";
