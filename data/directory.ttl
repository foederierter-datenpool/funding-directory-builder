cdf:funding-0e10800a6090 a schema:FundingScheme;
    schema:name "MINT@School";
    schema:description "Die Vector Stiftung möchte mehr Menschen in technische Berufe bringen. Im schulischen Bereich fördert sie MINT-Projekte an allgemeinbildenden Schulen. Gefördert werden z. B. MINT-AGs, Material- und Expertenkosten für MINT-Projekte, Exkursionen mit MINT-Charakter oder Wettbewerbsteilnahmen. Die Förderung ist jederzeit möglich und an keine Frist gebunden.";
    schema:url "https://foerderdatenbank.d-s-e-e.de/foerderprogramme/mint-school";
