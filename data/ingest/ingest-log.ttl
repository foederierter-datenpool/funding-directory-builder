:fetchFdbBund a :Fetch, p-plan:Step ; :fromSource :fdbBundSource .
:fetchDsee a :Fetch, p-plan:Step ; :fromSource :dseeSource .
:fetchEuportal a :Fetch, p-plan:Step ; :fromSource :euportalSource .
:fetchFoerderfinder a :Fetch, p-plan:Step ; :fromSource :foerderfinderSource .
:liftFdbBund a :Lift, p-plan:Step ; :fromSource :fdbBundSource ; p-plan:isPrecededBy :fetchFdbBund .
:liftDsee a :Lift, p-plan:Step ; :fromSource :dseeSource ; p-plan:isPrecededBy :fetchDsee .
:liftEuportal a :Lift, p-plan:Step ; :fromSource :euportalSource ; p-plan:isPrecededBy :fetchEuportal .
:liftFoerderfinder a :Lift, p-plan:Step ; :fromSource :foerderfinderSource ; p-plan:isPrecededBy :fetchFoerderfinder .

