    rdf:_1 _:n3-283559;
    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"prose text-lg space-y-4\">\n <div>\n  <div class=\"font-bold\">Regionen:</div>\n  <div>\n   <ul>\n    <li>Schleswig-Holstein</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Engagementbereiche:</div>\n  <div>\n   <ul>\n    <li>Bildung</li>\n    <li>Wissenschaft und Forschung</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Förderfähige Kosten:</div>\n  <div>\n   <ul>\n    <li>Honorarkosten</li>\n    <li>Personalkosten</li>\n    <li>Sachkosten</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Eigenmittel benötigt:</div>\n  <div>Ja</div>\n </div>\n <div>\n  <div class=\"font-bold\">Bewerbungsfrist:</div>\n  <div class=\"mb-1\">\n   <ul>\n    <li>1. Oktober 2026</li>\n    <li>1. Februar 2027</li>\n   </ul>\n  </div>\n  <div class=\"prose text-base\">\n   <p>Projektlaufzeit für Einreichung im Frühjahr: ab&nbsp;Bewilligung bis 31.12. des laufenden Jahres</p>\n   <p>Projektlaufzeit für Einreichung im Herbst: ab 1.1. bis 31.12. des darauffolgenden Jahres</p>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Regionen: Schleswig-Holstein Engagementbereiche: Bildung Wissenschaft und Forschung Förderfähige Kosten: Honorarkosten Personalkosten Sachkosten Eigenmittel benötigt: Ja Bewerbungsfrist: 1. Oktober 2026 1. Februar 2027 Projektlaufzeit für Einreichung im Frühjahr: ab Bewilligung bis 31.12. des laufenden Jahres Projektlaufzeit für Einreichung im Herbst: ab 1.1. bis 31.12. des darauffolgenden Jahres".
_:n3-283559 a <http://www.w3.org/1999/xhtml#div>;
