    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/36643-baden-wuerttemberg-stiftung\" class=\"link\">Baden-Württemberg Stiftung</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Kriegsbergstraße 42,\n     <br>\n     70174 Stuttgart</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:nh-bwstiftung@dfi.de\">nh-bwstiftung@dfi.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.bwstiftung.de/de/\" target=\"_blank\">www.bwstiftung.de/de/</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0711 2484760</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/BWS_Logo_Standard_rgb.png\" width=\"799\" height=\"346\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Baden-Württemberg Stiftung Kriegsbergstraße 42, 70174 Stuttgart E-Mail nh-bwstiftung@dfi.de Webseite www.bwstiftung.de/de/ Telefon 0711 2484760".
