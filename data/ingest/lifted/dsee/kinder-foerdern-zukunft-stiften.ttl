    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1291-kinder-foerdern-zukunft-stiften\" class=\"link\">Kinder fördern – Zukunft stiften</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Abelsbergstraße 26 B,\n     <br>\n     70176 Stuttgart</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:kontakt@stiftung-kinder-foerdern.de\">kontakt@stiftung-kinder-foerdern.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.stiftung-kinder-foerdern.de\" target=\"_blank\">www.stiftung-kinder-foerdern.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>+49171 3699910</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Kinder-fördern-Zukunft-stiften.png\" width=\"799\" height=\"296\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Kinder fördern – Zukunft stiften Abelsbergstraße 26 B, 70176 Stuttgart E-Mail kontakt@stiftung-kinder-foerdern.de Webseite www.stiftung-kinder-foerdern.de Telefon +49171 3699910".
