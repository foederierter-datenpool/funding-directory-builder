    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1813-buergerstiftung-koenigswinter-fuer-jugend-sport-und-kultur\" class=\"link\">Bürgerstiftung Königswinter für Jugend, Sport und Kultur</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Drachenfelsstr. 3,\n     <br>\n     53639 Königswinter</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:andrea.goernert@koenigswinter.de\">andrea.goernert@koenigswinter.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.koenigswinter.de\" target=\"_blank\">www.koenigswinter.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>02244 889 366</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Bürgerstiftung Königswinter für Jugend, Sport und Kultur Drachenfelsstr. 3, 53639 Königswinter E-Mail andrea.goernert@koenigswinter.de Webseite www.koenigswinter.de Telefon 02244 889 366".
