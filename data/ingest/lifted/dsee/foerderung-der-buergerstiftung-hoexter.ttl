e of o.addedNodes)if(\"LINK\"===e.tagName&&\"modulepreload\"===e.rel)r(e);else if(e.querySelectorAll)for(const o of e.querySelectorAll(\"link[rel=modulepreload]\"))r(o)})).observe(document,{childList:!0,subtree:!0})}function r(e){if(e.ep)return;e.ep=!0;const r=function(e){const r={};return e.integrity&&(r.integrity=e.integrity),e.referrerpolicy&&(r.referrerPolicy=e.referrerpolicy),\"use-credentials\"===e.crossorigin?r.credentials=\"include\":\"anonymous\"===e.crossorigin?r.credentials=\"omit\":r.credentials=\"same-origin\",r}(e);fetch(e.href,r)}}();</script>\n<script type=\"module\" src=\"https://foerderdatenbank.d-s-e-e.de/dist/assets/app-DB5ScF6h.js\" crossorigin onload=\"e=new CustomEvent('vite-script-loaded', {detail:{path: 'resources/js/main.js'}});document.dispatchEvent(e);\"></script>\n<link href=\"https://foerderdatenbank.d-s-e-e.de/dist/assets/app-ClfkFxNO.css\" rel=\"stylesheet\"> \n<div class=\"container flex flex-row justify-end my-4\">\n <div class=\"flex flex-row flex-wrap items-center -mx-1 select-none cursor-default\">\n  <nav class=\"flex flex-row my-2\">\n   <a class=\"block mr-2 md:mr-6 p-1 opacity-70 hover:opacity-100 focus:opacity-100 transition-opacity\" href=\"https://www.deutsche-stiftung-engagement-und-ehrenamt.de/newsletter/\">Newsletter</a>\n  </nav>\n  <div class=\"flex flex-row divide-x my-2\">\n   <a href=\"https://x.com/d_s_e_e\" title=\"X\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-x.svg\" width=\"24\" height=\"24\" alt=\"Logo X\"> <span class=\"sr-only\">X</span> </a><a href=\"https://www.facebook.com/EngagementStiftung/\" title=\"Facebook\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-facebook.svg\" width=\"24\" height=\"24\" alt=\"Logo Facebook\"> <span class=\"sr-only\">Facebook</span> </a> <a href=\"https://www.instagram.com/engagement_und_ehrenamt/\" title=\"Instagram\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-instagram.svg\" width=\"24\" height=\"24\" alt=\"Logo Instagram\"> <span class=\"sr-only\">Instagram</span> </a> <a href=\"https://www.linkedin.com/company/dsee/\" title=\"LinkedIn\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-linkedin.svg\" width=\"24\" height=\"24\" alt=\"Logo LinkedIn\"> <span class=\"sr-only\">LinkedIn</span> </a>\n  </div>\n </div>\n</div>\n<header class=\"container my-4 flex flex-row flex-wrap justify-between items-end select-none cursor-default\">\n <a href=\"https://foerderdatenbank.d-s-e-e.de/\" class=\"block my-2 w-full max-w-md\"> <span class=\"sr-only\">Zur Startseite</span><img src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/2023_DSEE_Logo_3zlg_RGB_Basis_large.svg\" width=\"300\" height=\"92\" alt=\"Logo Deutsche Stiftung für Engagement und Ehrenamt\" fetchpriority=\"high\"></a>\n <p class=\"my-2 font-medium text-2xl\">Förderdatenbank der DSEE</p>\n</header>\n<main class=\"my-8\">\n <nav class=\"container\">\n  <div class=\"my-8 py-3 border-t-2 border-gray select-none cursor-default\">\n   <a class=\"link\" href=\"https://foerderdatenbank.d-s-e-e.de/\">Förderdatenbank der DSEE</a><span class=\"px-1 text-gray\">&gt;</span><span>Förderung der Bürgerstiftung Höxter</span>\n  </div>\n </nav>\n <article class=\"container\">\n  <div class=\"grid lg:grid-cols-3 gap-16\">\n   <div class=\"col-span-2 space-y-4\">\n    <header class=\"mb-8\">\n     <h1 class=\"col-span-2 font-bold text-2xl\">Förderung der Bürgerstiftung Höxter</h1>\n    </header>\n    <div class=\"prose text-lg mb-8 space-y-6\">\n     <div>\n      <p>Im Jahr 2007 entstand in der Lenkungsgruppe des Bündnisses für Familie und Generationen Höxter die Idee, eine Bürgerstiftung zu gründen. Innerhalb eines Jahres wurden die Vorarbeiten soweit vorangetrieben, dass die Bürgerstiftung ins Leben gerufen werden konnte. Dank des Engagements von Bürgerinnen und Bürgern konnten die erforderlichen Stifter gefunden werden, um die Stiftung erfolgreich zu etablieren.</p>\n      <p>Die Bürgerstiftung strebt an, dass die Einwohnerinnen und Einwohner sowie Wirtschaftsunternehmen der Kreisstadt Höxter verstärkt Mitverantwortung für die Gestaltung ihres Gemeinwesens übernehmen.&nbsp;</p>\n      <p>Dies soll einerseits durch die Einwerbung von Zustiftungen und Spenden geschehen, die es der Bürgerstiftung ermöglichen, lokale Projekte in den Bereichen Familie, Kinder, Jugend, Generationen und Soziales zu fördern. Andererseits sollen die Bürger dazu motiviert werden, sich ehrenamtlich sowohl in der Bürgerstiftung als auch in den von ihr unterstützten Projekten zu engagieren.</p>\n     </div>\n     <div>\n      <h3>Zielgruppen/Bedingungen</h3>\n      <p>Die Stiftung unterstützt im Gebiet der Stadt Höxter und ihrer Ortschaften Projekte aus den Bereichen:</p>\n      <p>• Bildung, Erziehung, Kultur und Integration,\n       <br>\n       • Kinder-, Jugend- und Altenhilfe,\n       <br>\n       • Unterstützung hilfebedürftiger Menschen,\n       <br>\n       • Ehrenamt,\n       <br>\n       • Gesundheitspflege und Sport,\n       <br>\n       • familienfreundliche Maßnahmen</p>\n      <p>Die Stiftung darf dabei keine Aufgaben übernehmen, die zu den Pflichtaufgaben der Kreisstadt Höxter im Sinne der Gemeindeordnung NRW oder zu den Pflichtaufgaben sonstiger öffentlich-rechtlicher Körperschaften gehören.\n       <br></p>\n     </div>\n     <div>\n      <h3>Weitere Informationen</h3>\n      <ul>\n       <li><a href=\"https://www.buergerstiftung-hoexter.com/\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Link zur Stiftung</a></li>\n      </ul>\n     </div>\n    </div>\n   </div>\n   <aside>\n    <div class=\"mb-10 max-w-sm\">\n     <figure class=\"ml-auto max-w-[600px]\">\n      <img src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/28.webp\" width=\"800\" height=\"367\">\n     </figure>\n    </div>\n    <div class=\"prose text-lg space-y-4\">\n     <div>\n      <div class=\"font-bold\">Regionen:</div>\n      <div>\n       <ul>\n        <li>Nordrhein-Westfalen</li>\n       </ul>\n      </div>\n     </div>\n     <div>\n      <div class=\"font-bold\">Engagementbereiche:</div>\n      <div>\n       <ul>\n        <li>Bildung</li>\n        <li>Engagement für gesellschaftlichen Zusammenhalt/ Demokratie</li>\n        <li>Kinder und Jugendliche</li>\n        <li>Soziales</li>\n        <li>Sport und Bewegung</li>\n       </ul>\n      </div>\n     </div>\n     <div>\n      <div class=\"font-bold\">Bewerbungsfrist:</div>\n      <div class=\"mb-1\">Fortlaufende Förderung</div>\n     </div>\n    </div>\n   </aside>\n  </div>\n  <div class=\"px-5 py-3 border-2 rounded-lg mt-16 px-6 py-6 border-gray\">\n   <div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n    <div class=\"grow\">\n     <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/3121-buergerstiftung-hoexter\" class=\"link\">Bürgerstiftung Höxter</a></h2>\n     <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n      <div>\n       <p>Westerbachstraße 45,\n        <br>\n        37671 Höxter</p>\n      </div>\n      <div>\n       <h3 class=\"font-bold\">E-Mail</h3>\n       <p><a href=\"mailto:info@buergerstiftung-hoexter.de\">info@buergerstiftung-hoexter.de</a></p>\n      </div>\n      <div>\n       <h3 class=\"font-bold\">Webseite</h3>\n       <p><a href=\"https://www.buergerstiftung-hoexter.com/\" target=\"_blank\">www.buergerstiftung-hoexter.com/</a></p>\n      </div>\n     </div>\n    </div>\n   </div>\n  </div>\n </article>\n</main>\n<footer class=\"container mt-24\">\n <div class=\"flex flex-row flex-wrap justify-between items-center py-12 border-t-2 border-yellow select-none cursor-default\">\n  <nav class=\"flex flex-row flex-wrap -mx-1\">\n   <p class=\"mr-6 p-1 opacity-70\">©2026</p>\n   <a class=\"block mr-6 p-1 opacity-70 hover:opacity-100 focus:opacity-100 transition-opacity\" href=\"https://foerderdatenbank.d-s-e-e.de/impressum\">Impressum</a><a class=\"block mr-6 p-1 opacity-70 hover:opacity-100 focus:opacity-100 transition-opacity\" href=\"https://www.deutsche-stiftung-engagement-und-ehrenamt.de/datenschutzerklaerung/\">Datenschutzerklärung</a>\n  </nav>\n  <div class=\"max-w-[240px]\">\n   <img src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/2023_DSEE_Logo_3zlg_RGB_Basis_large.svg\" width=\"300\" height=\"92\" alt=\"Logo Deutsche Stiftung für Engagement und Ehrenamt\">\n  </div>\n </div>\n</footer>\n<script>\n  var _paq = window._paq = window._paq || [];\n  /* tracker methods like \"setCustomDimension\" should be called before \"trackPageView\" */\n  _paq.push(['trackPageView']);\n  _paq.push(['enableLinkTracking']);\n  (function() {\n    var u=\"//matomo.deutsche-stiftung-engagement-und-ehrenamt.de/\";\n    _paq.push(['setTrackerUrl', u+'matomo.php']);\n    _paq.push(['setSiteId', '4']);\n    var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];\n    g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);\n  })();\n</script>";
    <https://html.spec.whatwg.org/#innerText> "Förderung der Bürgerstiftung Höxter  –  Förderdatenbank Newsletter X Facebook Instagram LinkedIn Zur Startseite Förderdatenbank der DSEE Förderdatenbank der DSEE>Förderung der Bürgerstiftung Höxter Förderung der Bürgerstiftung Höxter Im Jahr 2007 entstand in der Lenkungsgruppe des Bündnisses für Familie und Generationen Höxter die Idee, eine Bürgerstiftung zu gründen. Innerhalb eines Jahres wurden die Vorarbeiten soweit vorangetrieben, dass die Bürgerstiftung ins Leben gerufen werden konnte. Dank des Engagements von Bürgerinnen und Bürgern konnten die erforderlichen Stifter gefunden werden, um die Stiftung erfolgreich zu etablieren. Die Bürgerstiftung strebt an, dass die Einwohnerinnen und Einwohner sowie Wirtschaftsunternehmen der Kreisstadt Höxter verstärkt Mitverantwortung für die Gestaltung ihres Gemeinwesens übernehmen. Dies soll einerseits durch die Einwerbung von Zustiftungen und Spenden geschehen, die es der Bürgerstiftung ermöglichen, lokale Projekte in den Bereichen Familie, Kinder, Jugend, Generationen und Soziales zu fördern. Andererseits sollen die Bürger dazu motiviert werden, sich ehrenamtlich sowohl in der Bürgerstiftung als auch in den von ihr unterstützten Projekten zu engagieren. Zielgruppen/Bedingungen Die Stiftung unterstützt im Gebiet der Stadt Höxter und ihrer Ortschaften Projekte aus den Bereichen: • Bildung, Erziehung, Kultur und Integration, • Kinder-, Jugend- und Altenhilfe, • Unterstützung hilfebedürftiger Menschen, • Ehrenamt, • Gesundheitspflege und Sport, • familienfreundliche Maßnahmen Die Stiftung darf dabei keine Aufgaben übernehmen, die zu den Pflichtaufgaben der Kreisstadt Höxter im Sinne der Gemeindeordnung NRW oder zu den Pflichtaufgaben sonstiger öffentlich-rechtlicher Körperschaften gehören. Weitere Informationen Link zur Stiftung Regionen: Nordrhein-Westfalen Engagementbereiche: Bildung Engagement für gesellschaftlichen Zusammenhalt/ Demokratie Kinder und Jugendliche Soziales Sport und Bewegung Bewerbungsfrist: Fortlaufende Förderung Bürgerstiftung Höxter Westerbachstraße 45, 37671 Höxter E-Mail info@buergerstiftung-hoexter.de Webseite www.buergerstiftung-hoexter.com/ ©2026 Impressum Datenschutzerklärung".
