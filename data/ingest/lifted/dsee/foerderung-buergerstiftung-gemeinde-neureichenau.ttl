    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1097-buergerstiftung-gemeinde-neureichenau\" class=\"link\">Bürgerstiftung Gemeinde Neureichenau</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Dreisesselstraße 8,\n     <br>\n     94089 Neureichenau</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@neureichenau.de\">info@neureichenau.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.neureichenau.de/buergerservice/die-gemeinde/buergerstiftung\" target=\"_blank\">www.neureichenau.de/buergerservice/die-gemeinde/buergerstiftung</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>08583 96010</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Bürgerstiftung Gemeinde Neureichenau Dreisesselstraße 8, 94089 Neureichenau E-Mail info@neureichenau.de Webseite www.neureichenau.de/buergerservice/die-gemeinde/buergerstiftung Telefon 08583 96010".
