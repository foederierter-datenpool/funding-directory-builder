    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/22681-haus-des-stiftens-fuer-unternehmen-non-profits-ggmbh\" class=\"link\">Haus des Stiftens für Unternehmen &amp; Non-Profits gGmbH</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Landshuter Allee 11,,\n     <br>\n     80637 München</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:foerderprogramme@hausdesstiftens.org\">foerderprogramme@hausdesstiftens.org</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.hausdesstiftens.org/\" target=\"_blank\">www.hausdesstiftens.org/</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>089 744 200 210</p>\n   </div>\n  </div>\n </div>\n</div>";
