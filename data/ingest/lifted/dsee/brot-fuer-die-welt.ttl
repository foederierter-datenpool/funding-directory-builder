f e.querySelectorAll(\"link[rel=modulepreload]\"))r(o)})).observe(document,{childList:!0,subtree:!0})}function r(e){if(e.ep)return;e.ep=!0;const r=function(e){const r={};return e.integrity&&(r.integrity=e.integrity),e.referrerpolicy&&(r.referrerPolicy=e.referrerpolicy),\"use-credentials\"===e.crossorigin?r.credentials=\"include\":\"anonymous\"===e.crossorigin?r.credentials=\"omit\":r.credentials=\"same-origin\",r}(e);fetch(e.href,r)}}();</script>\n<script type=\"module\" src=\"https://foerderdatenbank.d-s-e-e.de/dist/assets/app-DB5ScF6h.js\" crossorigin onload=\"e=new CustomEvent('vite-script-loaded', {detail:{path: 'resources/js/main.js'}});document.dispatchEvent(e);\"></script>\n<link href=\"https://foerderdatenbank.d-s-e-e.de/dist/assets/app-ClfkFxNO.css\" rel=\"stylesheet\"> \n<div class=\"container flex flex-row justify-end my-4\">\n <div class=\"flex flex-row flex-wrap items-center -mx-1 select-none cursor-default\">\n  <nav class=\"flex flex-row my-2\">\n   <a class=\"block mr-2 md:mr-6 p-1 opacity-70 hover:opacity-100 focus:opacity-100 transition-opacity\" href=\"https://www.deutsche-stiftung-engagement-und-ehrenamt.de/newsletter/\">Newsletter</a>\n  </nav>\n  <div class=\"flex flex-row divide-x my-2\">\n   <a href=\"https://x.com/d_s_e_e\" title=\"X\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-x.svg\" width=\"24\" height=\"24\" alt=\"Logo X\"> <span class=\"sr-only\">X</span> </a><a href=\"https://www.facebook.com/EngagementStiftung/\" title=\"Facebook\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-facebook.svg\" width=\"24\" height=\"24\" alt=\"Logo Facebook\"> <span class=\"sr-only\">Facebook</span> </a> <a href=\"https://www.instagram.com/engagement_und_ehrenamt/\" title=\"Instagram\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-instagram.svg\" width=\"24\" height=\"24\" alt=\"Logo Instagram\"> <span class=\"sr-only\">Instagram</span> </a> <a href=\"https://www.linkedin.com/company/dsee/\" title=\"LinkedIn\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-linkedin.svg\" width=\"24\" height=\"24\" alt=\"Logo LinkedIn\"> <span class=\"sr-only\">LinkedIn</span> </a>\n  </div>\n </div>\n</div>\n<header class=\"container my-4 flex flex-row flex-wrap justify-between items-end select-none cursor-default\">\n <a href=\"https://foerderdatenbank.d-s-e-e.de/\" class=\"block my-2 w-full max-w-md\"> <span class=\"sr-only\">Zur Startseite</span><img src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/2023_DSEE_Logo_3zlg_RGB_Basis_large.svg\" width=\"300\" height=\"92\" alt=\"Logo Deutsche Stiftung für Engagement und Ehrenamt\" fetchpriority=\"high\"></a>\n <p class=\"my-2 font-medium text-2xl\">Förderdatenbank der DSEE</p>\n</header>\n<main class=\"my-8\">\n <nav class=\"container\">\n  <div class=\"my-8 py-3 border-t-2 border-gray select-none cursor-default\">\n   <a class=\"link\" href=\"https://foerderdatenbank.d-s-e-e.de/\">Förderdatenbank der DSEE</a><span class=\"px-1 text-gray\">&gt;</span><span>Brot für die Welt</span>\n  </div>\n </nav>\n <article class=\"container\">\n  <div class=\"grid lg:grid-cols-3 gap-16\">\n   <div class=\"col-span-2 space-y-4\">\n    <header class=\"mb-8\">\n     <h1 class=\"col-span-2 font-bold text-2xl\">Brot für die Welt</h1>\n    </header>\n    <div class=\"prose text-lg mb-8 space-y-6\">\n     <div>\n      <p>Brot für die Welt ist Teil des Evangelischen Werks für Diakonie und Entwicklung e. V., kurz EWDE. Als Hilfswerk der evangelischen Landeskirchen und Freikirchen in Deutschland ist die Organisation Mitglied verschiedener nationaler und internationaler Netzwerke und arbeitet eng mit anderen Hilfsorganisationen zusammen. Im Zentrum der Arbeit stehen die Stärkung der Armen, die Friedensförderung und die Bewahrung der Schöpfung.</p>\n      <p>Unterstützt werden die entwicklungspolitische Bildungsarbeit von Kirchengemeinden, Initiativen und Organisationen, damit sich mehr Menschen für globale Gerechtigkeit einsetzen.</p>\n      <p><strong>Kleinanträge bis 1000 Euro</strong></p>\n      <p>Der Antrag muss acht Wochen vor dem geplanten Projektbeginn eingehen und kann auch nur eine einzige Kostenposition enthalten (etwa Referenten-Honorar oder Raummiete). Diese Kosten können zu 100 Prozent gefördert werden, maximal bis 1000 Euro.</p>\n      <p><strong>Entwicklungspolitische Begegnungen</strong></p>\n      <p>Es werden Begegnungsprogramme zwischen Partnerinnen und Partnern aus Nord und Süd (Partnerschaftsgruppen) gefördert, wenn sie in langfristige entwicklungspolitische Bildungsprogramme eingebettet sind. Die dreiwöchigen Begegnungen sollen unter einem entwicklungspolitischen Schwerpunktthema stehen und Raum für Diskussionen geben. Reisegruppen mit maximal acht Personen werden gefördert. Der Antrag muss sechs Monate vor Beginn der Reise eingehen.</p>\n      <p><strong>Förderung von Institutionen und Personal</strong></p>\n      <p>Personalstellen und Infrastruktur bei kirchlichen Verbänden und Bildungsstätten, die entwicklungspolitische Bildung und Informationen anbieten, werden gefördert.</p>\n      <p><strong>Bildungsmaterial</strong></p>\n      <p>Gefördert werden gedruckte oder digitale Zeitschriften und Broschüren von deutschen oder ausländischen Autorinnen und Autoren oder Gruppen, wenn sie der Verbreitung entwicklungspolitischer Inhalte dienen und die Diskussion entwicklungspolitischer Themen unterstützen.</p>\n      <p>Auch Radiobeiträge und Internetseiten, die entwicklungspolitische Inhalte haben oder zur Vernetzung von Gruppen beitragen können gefördert werden. Außerdem können internetbasierte Bildungsmaterialien wie Internetspiele, Apps und Podcasts gefördert werden.</p>\n     </div>\n     <div>\n      <h3>Weitere Informationen</h3>\n      <ul>\n       <li><a href=\"https://www.brot-fuer-die-welt.de/projekte/inlandsfoerderung/material/kleinantraege/\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Link zu den Kleinanträgen</a></li>\n       <li><a href=\"https://www.brot-fuer-die-welt.de/projekte/inlandsfoerderung/material/entwicklungspolitische-begegnungen/\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Link zu den Entwicklungspolitischen Begegnungen</a></li>\n       <li><a href=\"https://www.brot-fuer-die-welt.de/projekte/inlandsfoerderung/institutionen-und-personal/\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Link zur Förderung von Institutionen und Personal</a></li>\n       <li><a href=\"https://www.brot-fuer-die-welt.de/projekte/inlandsfoerderung/material/print-digital/\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Link zu den Bildmaterialien</a></li>\n      </ul>\n     </div>\n    </div>\n   </div>\n   <aside>\n    <div class=\"prose text-lg space-y-4\">\n     <div>\n      <div class=\"font-bold\">Regionen:</div>\n      <div>Bundesweit</div>\n     </div>\n     <div>\n      <div class=\"font-bold\">Engagementbereiche:</div>\n      <div>\n       <ul>\n        <li>Entwicklungszusammenarbeit</li>\n        <li>Sonstiges</li>\n       </ul>\n      </div>\n     </div>\n     <div>\n      <div class=\"font-bold\">Förderfähige Kosten:</div>\n      <div>\n       <ul>\n        <li>Honorarkosten</li>\n        <li>Personalkosten</li>\n        <li>Sachkosten</li>\n       </ul>\n      </div>\n     </div>\n     <div>\n      <div class=\"font-bold\">Eigenmittel benötigt:</div>\n      <div>Ja</div>\n     </div>\n     <div>\n      <div class=\"font-bold\">Bewerbungsfrist:</div>\n      <div class=\"mb-1\">Fortlaufende Förderung</div>\n     </div>\n    </div>\n   </aside>\n  </div>\n  <div class=\"px-5 py-3 border-2 rounded-lg mt-16 px-6 py-6 border-gray\">\n   <div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n    <div class=\"grow\">\n     <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/21092-brot-fuer-die-welt-evangelisches-werk-fuer-diakonie-und-entwicklung-e-v\" class=\"link\">Brot für die Welt Evangelisches Werk für Diakonie und Entwicklung e.V.</a></h2>\n     <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n      <div>\n       <p>Caroline-Michaelis-Str. 1,\n        <br>\n        10115 Berlin</p>\n      </div>\n      <div>\n       <h3 class=\"font-bold\">E-Mail</h3>\n       <p><a href=\"mailto:inlandsfoerderung@brot-fuer-die-welt.de\">inlandsfoerderung@brot-fuer-die-welt.de</a></p>\n      </div>\n      <div>\n       <h3 class=\"font-bold\">Webseite</h3>\n       <p><a href=\"https://www.brot-fuer-die-welt.de/\" target=\"_blank\">www.brot-fuer-die-welt.de/</a></p>\n      </div>\n      <div>\n       <h3 class=\"font-bold\">Telefon</h3>\n       <p>030 65211 0</p>\n      </div>\n     </div>\n    </div>\n    <div class=\"md:w-1/3\">\n     <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Logo_Brot_fuer_die_Welt.png.webp\" width=\"800\" height=\"410\">\n    </div>\n   </div>\n  </div>\n </article>\n</main>\n<footer class=\"container mt-24\">\n <div class=\"flex flex-row flex-wrap justify-between items-center py-12 border-t-2 border-yellow select-none cursor-default\">\n  <nav class=\"flex flex-row flex-wrap -mx-1\">\n   <p class=\"mr-6 p-1 opacity-70\">©2026</p>\n   <a class=\"block mr-6 p-1 opacity-70 hover:opacity-100 focus:opacity-100 transition-opacity\" href=\"https://foerderdatenbank.d-s-e-e.de/impressum\">Impressum</a><a class=\"block mr-6 p-1 opacity-70 hover:opacity-100 focus:opacity-100 transition-opacity\" href=\"https://www.deutsche-stiftung-engagement-und-ehrenamt.de/datenschutzerklaerung/\">Datenschutzerklärung</a>\n  </nav>\n  <div class=\"max-w-[240px]\">\n   <img src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/2023_DSEE_Logo_3zlg_RGB_Basis_large.svg\" width=\"300\" height=\"92\" alt=\"Logo Deutsche Stiftung für Engagement und Ehrenamt\">\n  </div>\n </div>\n</footer>\n<script>\n  var _paq = window._paq = window._paq || [];\n  /* tracker methods like \"setCustomDimension\" should be called before \"trackPageView\" */\n  _paq.push(['trackPageView']);\n  _paq.push(['enableLinkTracking']);\n  (function() {\n    var u=\"//matomo.deutsche-stiftung-engagement-und-ehrenamt.de/\";\n    _paq.push(['setTrackerUrl', u+'matomo.php']);\n    _paq.push(['setSiteId', '4']);\n    var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];\n    g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);\n  })();\n</script>";
    <https://html.spec.whatwg.org/#innerText> "Brot für die Welt  –  Förderdatenbank Newsletter X Facebook Instagram LinkedIn Zur Startseite Förderdatenbank der DSEE Förderdatenbank der DSEE>Brot für die Welt Brot für die Welt Brot für die Welt ist Teil des Evangelischen Werks für Diakonie und Entwicklung e. V., kurz EWDE. Als Hilfswerk der evangelischen Landeskirchen und Freikirchen in Deutschland ist die Organisation Mitglied verschiedener nationaler und internationaler Netzwerke und arbeitet eng mit anderen Hilfsorganisationen zusammen. Im Zentrum der Arbeit stehen die Stärkung der Armen, die Friedensförderung und die Bewahrung der Schöpfung. Unterstützt werden die entwicklungspolitische Bildungsarbeit von Kirchengemeinden, Initiativen und Organisationen, damit sich mehr Menschen für globale Gerechtigkeit einsetzen. Kleinanträge bis 1000 Euro Der Antrag muss acht Wochen vor dem geplanten Projektbeginn eingehen und kann auch nur eine einzige Kostenposition enthalten (etwa Referenten-Honorar oder Raummiete). Diese Kosten können zu 100 Prozent gefördert werden, maximal bis 1000 Euro. Entwicklungspolitische Begegnungen Es werden Begegnungsprogramme zwischen Partnerinnen und Partnern aus Nord und Süd (Partnerschaftsgruppen) gefördert, wenn sie in langfristige entwicklungspolitische Bildungsprogramme eingebettet sind. Die dreiwöchigen Begegnungen sollen unter einem entwicklungspolitischen Schwerpunktthema stehen und Raum für Diskussionen geben. Reisegruppen mit maximal acht Personen werden gefördert. Der Antrag muss sechs Monate vor Beginn der Reise eingehen. Förderung von Institutionen und Personal Personalstellen und Infrastruktur bei kirchlichen Verbänden und Bildungsstätten, die entwicklungspolitische Bildung und Informationen anbieten, werden gefördert. Bildungsmaterial Gefördert werden gedruckte oder digitale Zeitschriften und Broschüren von deutschen oder ausländischen Autorinnen und Autoren oder Gruppen, wenn sie der Verbreitung entwicklungspolitischer Inhalte dienen und die Diskussion entwicklungspolitischer Themen unterstützen. Auch Radiobeiträge und Internetseiten, die entwicklungspolitische Inhalte haben oder zur Vernetzung von Gruppen beitragen können gefördert werden. Außerdem können internetbasierte Bildungsmaterialien wie Internetspiele, Apps und Podcasts gefördert werden. Weitere Informationen Link zu den Kleinanträgen Link zu den Entwicklungspolitischen Begegnungen Link zur Förderung von Institutionen und Personal Link zu den Bildmaterialien Regionen: Bundesweit Engagementbereiche: Entwicklungszusammenarbeit Sonstiges Förderfähige Kosten: Honorarkosten Personalkosten Sachkosten Eigenmittel benötigt: Ja Bewerbungsfrist: Fortlaufende Förderung Brot für die Welt Evangelisches Werk für Diakonie und Entwicklung e.V. Caroline-Michaelis-Str. 1, 10115 Berlin E-Mail inlandsfoerderung@brot-fuer-die-welt.de Webseite www.brot-fuer-die-welt.de/ Telefon 030 65211 0 ©2026 Impressum Datenschutzerklärung".
