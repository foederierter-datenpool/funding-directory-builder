    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/2263-elmer-buergerstiftung\" class=\"link\">Elmer Bürgerstiftung</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Eddelhoff 31,\n     <br>\n     27432 Bremervörde-Elm</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:kontakt@elmerbuergerstiftung.de\">kontakt@elmerbuergerstiftung.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.elmerbuergerstiftung.de\" target=\"_blank\">www.elmerbuergerstiftung.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>04761 73002</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Elmer Bürgerstiftung Eddelhoff 31, 27432 Bremervörde-Elm E-Mail kontakt@elmerbuergerstiftung.de Webseite www.elmerbuergerstiftung.de Telefon 04761 73002".
