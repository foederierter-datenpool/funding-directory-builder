                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                          "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/35847-b-s-u-mbh-beratungs-und-service-gesellschaft-umwelt-mbh\" class=\"link\">B.&amp;S.U. mbH Beratungs-und Service-Gesellschaft Umwelt mbH</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:bene2@bene-berlin.de\">bene2@bene-berlin.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>030 390420</p>\n   </div>\n  </div>\n </div>\n</div>";
                                                  <https://html.spec.whatwg.org/#innerText>
