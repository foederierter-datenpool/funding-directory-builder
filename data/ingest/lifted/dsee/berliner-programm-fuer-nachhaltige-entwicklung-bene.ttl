                                                                                                  rdf:_1    [ rdf:type  <http://www.w3.org/1999/xhtml#li>;
                                                                                                              rdf:_1    "Hauptverwaltung, Bezirksverwaltungen und nachgeordnete Einrichtungen;&nbsp;";
                                                                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                      "Hauptverwaltung, Bezirksverwaltungen und nachgeordnete Einrichtungen;&nbsp;";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "Hauptverwaltung, Bezirksverwaltungen und nachgeordnete Einrichtungen;"
                                                                                                            ];
