                                                                          rdf:_1    [ rdf:type  <http://www.w3.org/1999/xhtml#h1>;
                                                                                      rdf:_1    "„Wir in Olsberg“";
                                                                                      <http://www.w3.org/1999/xhtml#class>
                                                                                              "col-span-2 font-bold text-2xl";
                                                                                      <https://html.spec.whatwg.org/#innerHTML>
                                                                                              "„Wir in Olsberg“";
                                                                                      <https://html.spec.whatwg.org/#innerText>
