                                                                                      rdf:_4    [ rdf:type  <http://www.w3.org/1999/xhtml#ul>;
                                                                                                  rdf:_1    [ rdf:type  <http://www.w3.org/1999/xhtml#li>;
                                                                                                              rdf:_1    "Modell- und Vorbildcharakter haben, verallgemeinerungsfähig sind und Anstöße und Anregungen in die Gesellschaft hinein geben;";
                                                                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                      "Modell- und Vorbildcharakter haben, verallgemeinerungsfähig sind und Anstöße und Anregungen in die Gesellschaft hinein geben;";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "Modell- und Vorbildcharakter haben, verallgemeinerungsfähig sind und Anstöße und Anregungen in die Gesellschaft hinein geben;"
                                                                                                            ];
                                                                                                  rdf:_2    [ rdf:type  <http://www.w3.org/1999/xhtml#li>;
                                                                                                              rdf:_1    "in der Stadt Olsberg betrieben und geführt werden;";
                                                                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                      "in der Stadt Olsberg betrieben und geführt werden;";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "in der Stadt Olsberg betrieben und geführt werden;"
                                                                                                            ];
                                                                                                  rdf:_3    [ rdf:type  <http://www.w3.org/1999/xhtml#li>;
                                                                                                              rdf:_1    "den Menschen helfen, die ernsthafte Bedürfnisse haben;";
                                                                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                      "den Menschen helfen, die ernsthafte Bedürfnisse haben;";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "den Menschen helfen, die ernsthafte Bedürfnisse haben;"
                                                                                                            ];
                                                                                                  rdf:_4    [ rdf:type  <http://www.w3.org/1999/xhtml#li>;
                                                                                                              rdf:_1    "ganz oder überwiegend mit freiwilligen und ehrenamtlichen Mitarbeitern arbeiten oder Betroffene aktiv beteiligen;";
                                                                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                      "ganz oder überwiegend mit freiwilligen und ehrenamtlichen Mitarbeitern arbeiten oder Betroffene aktiv beteiligen;";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "ganz oder überwiegend mit freiwilligen und ehrenamtlichen Mitarbeitern arbeiten oder Betroffene aktiv beteiligen;"
                                                                                                            ];
                                                                                                  rdf:_5    [ rdf:type  <http://www.w3.org/1999/xhtml#li>;
                                                                                                              rdf:_1    "Anstöße und Anregungen (Kräfte der Innovation) in unser Gemeinwesen in unsere Stadt geben;";
                                                                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                      "Anstöße und Anregungen (Kräfte der Innovation) in unser Gemeinwesen in unsere Stadt geben;";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "Anstöße und Anregungen (Kräfte der Innovation) in unser Gemeinwesen in unsere Stadt geben;"
                                                                                                            ];
                                                                                                  rdf:_6    [ rdf:type  <http://www.w3.org/1999/xhtml#li>;
                                                                                                              rdf:_1    "Hilfe zur Selbsthilfe geben oder fördern";
                                                                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                      "Hilfe zur Selbsthilfe geben oder fördern";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "Hilfe zur Selbsthilfe geben oder fördern"
                                                                                                            ];
                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<li>Modell- und Vorbildcharakter haben, verallgemeinerungsfähig sind und Anstöße und Anregungen in die Gesellschaft hinein geben;</li>\n<li>in der Stadt Olsberg betrieben und geführt werden;</li>\n<li>den Menschen helfen, die ernsthafte Bedürfnisse haben;</li>\n<li>ganz oder überwiegend mit freiwilligen und ehrenamtlichen Mitarbeitern arbeiten oder Betroffene aktiv beteiligen;</li>\n<li>Anstöße und Anregungen (Kräfte der Innovation) in unser Gemeinwesen in unsere Stadt geben;</li>\n<li>Hilfe zur Selbsthilfe geben oder fördern</li>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Modell- und Vorbildcharakter haben, verallgemeinerungsfähig sind und Anstöße und Anregungen in die Gesellschaft hinein geben; in der Stadt Olsberg betrieben und geführt werden; den Menschen helfen, die ernsthafte Bedürfnisse haben; ganz oder überwiegend mit freiwilligen und ehrenamtlichen Mitarbeitern arbeiten oder Betroffene aktiv beteiligen; Anstöße und Anregungen (Kräfte der Innovation) in unser Gemeinwesen in unsere Stadt geben; Hilfe zur Selbsthilfe geben oder fördern"
                                                                                                ];
