    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/39066-naturstrom-stiftung\" class=\"link\">Naturstrom-Stiftung</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Parsevalstraße 11,\n     <br>\n     40468 Düsseldorf</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:stiftung@naturstrom.de\">stiftung@naturstrom.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.naturstrom-stiftung.de/\" target=\"_blank\">www.naturstrom-stiftung.de/</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0211 77900149</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Naturstrom-Stiftung Parsevalstraße 11, 40468 Düsseldorf E-Mail stiftung@naturstrom.de Webseite www.naturstrom-stiftung.de/ Telefon 0211 77900149".
