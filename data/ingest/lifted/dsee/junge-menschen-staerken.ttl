    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/38344-aktion-mensch-e-v\" class=\"link\">Aktion Mensch e.V.</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Heinemannstr. 36,\n     <br>\n     53175 Bonn</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@aktion-mensch.de\">info@aktion-mensch.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.aktion-mensch.de\" target=\"_blank\">www.aktion-mensch.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0228 2092300</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/AM_Foerder_Logo_RGB.jpg\" width=\"800\" height=\"470\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Aktion Mensch e.V. Heinemannstr. 36, 53175 Bonn E-Mail info@aktion-mensch.de Webseite www.aktion-mensch.de Telefon 0228 2092300".
