querySelectorAll)for(const o of e.querySelectorAll(\"link[rel=modulepreload]\"))r(o)})).observe(document,{childList:!0,subtree:!0})}function r(e){if(e.ep)return;e.ep=!0;const r=function(e){const r={};return e.integrity&&(r.integrity=e.integrity),e.referrerpolicy&&(r.referrerPolicy=e.referrerpolicy),\"use-credentials\"===e.crossorigin?r.credentials=\"include\":\"anonymous\"===e.crossorigin?r.credentials=\"omit\":r.credentials=\"same-origin\",r}(e);fetch(e.href,r)}}();</script>\n<script type=\"module\" src=\"https://foerderdatenbank.d-s-e-e.de/dist/assets/app-DB5ScF6h.js\" crossorigin onload=\"e=new CustomEvent('vite-script-loaded', {detail:{path: 'resources/js/main.js'}});document.dispatchEvent(e);\"></script>\n<link href=\"https://foerderdatenbank.d-s-e-e.de/dist/assets/app-ClfkFxNO.css\" rel=\"stylesheet\"> \n<div class=\"container flex flex-row justify-end my-4\">\n <div class=\"flex flex-row flex-wrap items-center -mx-1 select-none cursor-default\">\n  <nav class=\"flex flex-row my-2\">\n   <a class=\"block mr-2 md:mr-6 p-1 opacity-70 hover:opacity-100 focus:opacity-100 transition-opacity\" href=\"https://www.deutsche-stiftung-engagement-und-ehrenamt.de/newsletter/\">Newsletter</a>\n  </nav>\n  <div class=\"flex flex-row divide-x my-2\">\n   <a href=\"https://x.com/d_s_e_e\" title=\"X\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-x.svg\" width=\"24\" height=\"24\" alt=\"Logo X\"> <span class=\"sr-only\">X</span> </a><a href=\"https://www.facebook.com/EngagementStiftung/\" title=\"Facebook\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-facebook.svg\" width=\"24\" height=\"24\" alt=\"Logo Facebook\"> <span class=\"sr-only\">Facebook</span> </a> <a href=\"https://www.instagram.com/engagement_und_ehrenamt/\" title=\"Instagram\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-instagram.svg\" width=\"24\" height=\"24\" alt=\"Logo Instagram\"> <span class=\"sr-only\">Instagram</span> </a> <a href=\"https://www.linkedin.com/company/dsee/\" title=\"LinkedIn\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-linkedin.svg\" width=\"24\" height=\"24\" alt=\"Logo LinkedIn\"> <span class=\"sr-only\">LinkedIn</span> </a>\n  </div>\n </div>\n</div>\n<header class=\"container my-4 flex flex-row flex-wrap justify-between items-end select-none cursor-default\">\n <a href=\"https://foerderdatenbank.d-s-e-e.de/\" class=\"block my-2 w-full max-w-md\"> <span class=\"sr-only\">Zur Startseite</span><img src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/2023_DSEE_Logo_3zlg_RGB_Basis_large.svg\" width=\"300\" height=\"92\" alt=\"Logo Deutsche Stiftung für Engagement und Ehrenamt\" fetchpriority=\"high\"></a>\n <p class=\"my-2 font-medium text-2xl\">Förderdatenbank der DSEE</p>\n</header>\n<main class=\"my-8\">\n <nav class=\"container\">\n  <div class=\"my-8 py-3 border-t-2 border-gray select-none cursor-default\">\n   <a class=\"link\" href=\"https://foerderdatenbank.d-s-e-e.de/\">Förderdatenbank der DSEE</a><span class=\"px-1 text-gray\">&gt;</span><span>Junge Menschen stärken</span>\n  </div>\n </nav>\n <article class=\"container\">\n  <div class=\"grid lg:grid-cols-3 gap-16\">\n   <div class=\"col-span-2 space-y-4\">\n    <header class=\"mb-8\">\n     <h1 class=\"col-span-2 font-bold text-2xl\">Junge Menschen stärken</h1>\n     <p class=\"text-lg text-gray-500\">Inklusive Begegnungen machen ein Miteinander ganz selbstverständlich. Ohne Vorurteile. Ohne Ausgrenzung. Wir unterstützen junge Menschen dabei, ihr Leben selbstbestimmt zu gestalten.</p>\n    </header>\n    <div class=\"prose text-lg mb-8 space-y-6\">\n     <div>\n      <p>Wir wollen jungen Menschen zeigen: Sie können etwas bewegen! Indem sie Ideen einbringen. Mitgestalten. Verantwortung übernehmen. Für mehr Selbstwirksamkeit und Selbstvertrauen.&nbsp;</p>\n     </div>\n     <div>\n      <h3>Zielgruppen/Bedingungen</h3>\n      <p>Wir fördern inklusive und partizipative Freizeitprojekte. Das bedeutet: Junge Menschen gestalten die Projekte aktiv mit. Sie bringen ihre Ideen ein. Planen und wirken bei der Umsetzung mit. Und übernehmen Verantwortung. So erfahren sie, dass ihr Handeln etwas bewirken kann. Für sich selbst. Und für andere. Die Themen orientieren sich an ihren Interessen und Bedürfnissen. Gleichzeitig sollen alle teilnehmen können. Deshalb sind eine inklusive Haltung und eine barrierefreie Gestaltung Voraussetzung. So fühlen sich auch junge Menschen mit Behinderung willkommen und können gleichberechtigt mitmachen.</p>\n      <p><strong>Zielgruppe:</strong>&nbsp;\n       <br>\n       Junge Menschen zwischen 12 und 24 Jahren, deren Teilhabe und Beteiligung eingeschränkt sind</p>\n      <p>Folgende Förderziele stehen im Mittelpunkt:</p>\n      <ul>\n       <li data-list-item-id=\"ea2d9247790e2caa61ef51172dca987f0\">Anerkennung von Vielfalt: Junge Menschen erleben Unterschiedlichkeit als Bereicherung. Sie bauen Vorurteile ab und begegnen anderen Menschen offen und respektvoll.</li>\n       <li data-list-item-id=\"e7cfc745313a3851cd6a2824d58dd1a29\">Mitgestaltung und Partizipation: Junge Menschen bringen eigene Anliegen ein. Sie entscheiden mit. Und erleben, dass sie etwas verändern können. Im Kleinen und im Großen.</li>\n       <li data-list-item-id=\"ef836ed28458ec6d7202fcdb02f2ec4c4\">Abbau von Teilhabebarrieren: Junge Menschen erleben, was gleichberechtigte Teilhabe bedeutet. Sie erkennen Barrieren im Alltag. Und helfen dabei, sie abzubauen.</li>\n       <li data-list-item-id=\"e8ef336ff6c47a5f9bd7841c10a097430\">Zugehörigkeit: Junge Menschen fühlen sich angenommen. Sie erleben Wertschätzung, Zusammenhalt und Gemeinschaft. Dazugehören macht stark.</li>\n       <li data-list-item-id=\"e3da51b06273f071c05c96915a384b77e\">Selbstwirksamkeit: Junge Menschen erleben: Ich kann selbst etwas tun. Das stärkt das Vertrauen in die eigenen Fähigkeiten und den Mut sich einzubringen.</li>\n       <li data-list-item-id=\"e5664e9d7599b0860d31b5f532e2fceb5\">Persönlichkeitskompetenzen: Junge Menschen entdecken ihre Stärken. Durch neue Erfahrungen gewinnen sie an Selbstbewusstsein und handeln selbstverantwortlich.</li>\n       <li data-list-item-id=\"eb8f6b666342a49aa884b22ed7212078c\">Soziale Kompetenzen: Junge Menschen lernen, Konflikte fair zu lösen. Sie übernehmen Verantwortung für sich und andere. Und erleben ein respektvolles Miteinander.</li>\n       <li data-list-item-id=\"ed05617b2406552d8686bb7faf03b6bfb\">Kommunikations- und Urteilsfähigkeit: Junge Menschen vertreten ihre Meinung. Sie hören anderen zu und bleiben im Gespräch. Sie bewegen sich sicher und kompetent online und im Alltag.</li>\n      </ul>\n      <p>&nbsp;</p>\n      <ul>\n       <li data-list-item-id=\"ee315f7fe43dda5d0aefac4d9625c3e0d\">Förderfähig sind <strong>anerkannte Träger der freien Kinder- und Jugendhilfe</strong> nach Paragraph 75 SGB VIII. Wichtig: Eine automatische Anerkennung über die Mitgliedschaft bei einem Wohlfahrtsverband ist <strong>nicht</strong> mehr gewährleistet.</li>\n       <li data-list-item-id=\"ec7f1f181ea297b54ee7c9a78d2ae3acb\">Ab Gesamtkosten von 100.000 Euro benötigst du eine Stellungnahme der zuständigen Jugendfachbehörde (in der Regel vom Jugendamt).</li>\n       <li data-list-item-id=\"e7804dfc6ececd6740d24a5adea104dc6\">Bei Antragstellung muss das Vorliegen eines Kinderschutzkonzepts bestätigt werden.&nbsp;</li>\n       <li data-list-item-id=\"e2b29f2a6efd0fe12e389067e4670d370\">Die Gesamtkosten deines Vorhabens müssen mindestens 50.000 Euro betragen.</li>\n       <li data-list-item-id=\"e630c2fc73b00037095bd6bd890cd2840\">Pro Förderangebot kann jeweils maximal ein Antrag pro Antragszyklus und Projekt-Partner (Rechtsträger) gestellt werden.</li>\n      </ul>\n      <p>Fördermittel und Laufzeit</p>\n      <ul>\n       <li data-list-item-id=\"e0b38aad44a6c5fe1c5cefca610135bed\">Bis zu 90 Prozent der förderfähigen Kosten, maximal 300.000 Euro</li>\n       <li data-list-item-id=\"e41f191e01941eaaabdfe72c066486e51\">Laufzeit bis zu 48 Monate</li>\n       <li data-list-item-id=\"ea27bac9bdfdfa54746a3de1dde2d2a83\">Eigenmittel von mindestens 10 Prozent der förderfähigen Kosten:\n        <ul>\n         <li data-list-item-id=\"e9852bcda12c472e18f20a28e80326fff\">Bare Mittel</li>\n         <li data-list-item-id=\"e4aa44bc054b3d583db0fad0c14fee50c\">Eintrittsgelder, Tagungsgebühren und Verkaufserlöse</li>\n         <li data-list-item-id=\"ef004fda050c7caa6d43394828b768ddb\">Spenden</li>\n         <li data-list-item-id=\"eb710eb96df32b87c739e13dddf12491e\">Individuelle Zuschüsse für Personalkosten</li>\n         <li data-list-item-id=\"eab405b49bed9faf2b6a26f428413ce03\">Öffentliche Mittel</li>\n        </ul></li>\n      </ul>\n     </div>\n     <div>\n      <h3>Hinweise zur Antragstellung/Bewerbung</h3>\n      <p>Die Antragstellung ist während der Antragszyklen im Förderportal möglich.</p>\n      <p>Jeder Zyklus beginnt mit einer Antragsphase. Während dieser kannst du deinen Antrag bei uns einreichen. Dafür hast du sechs Wochen Zeit. Die erste Antragsphase beginnt am <strong>01. September 2026</strong>. Die nächsten beiden folgen ab <strong>01. Januar 2027 </strong>und ab <strong>01. Mai 2027</strong>.&nbsp;</p>\n     </div>\n     <div>\n      <h3>Weitere Informationen</h3>\n      <ul>\n       <li><a href=\"https://www.aktion-mensch.de/foerderung/foerderangebote/junge-menschen\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Link zur Förderung</a></li>\n       <li><a href=\"https://www.aktion-mensch.de/foerderung/foerder-check\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Fördercheck</a></li>\n      </ul>\n     </div>\n    </div>\n   </div>\n   <aside>\n    <div class=\"prose text-lg space-y-4\">\n     <div>\n      <div class=\"font-bold\">Regionen:</div>\n      <div>Bundesweit</div>\n     </div>\n     <div>\n      <div class=\"font-bold\">Engagementbereiche:</div>\n      <div>\n       <ul>\n        <li>Kinder und Jugendliche</li>\n        <li>Soziales</li>\n       </ul>\n      </div>\n     </div>\n     <div>\n      <div class=\"font-bold\">Förderfähige Kosten:</div>\n      <div>\n       <ul>\n        <li>Bau- und Investkosten</li>\n        <li>Honorarkosten</li>\n        <li>Personalkosten</li>\n        <li>Sachkosten</li>\n       </ul>\n      </div>\n     </div>\n     <div>\n      <div class=\"font-bold\">Eigenmittel benötigt:</div>\n      <div>Ja</div>\n     </div>\n     <div>\n      <div class=\"font-bold\">Bewerbungsfrist:</div>\n      <div class=\"mb-1\">\n       <ul>\n        <li>15. Oktober 2026</li>\n        <li>15. Februar 2027</li>\n        <li>15. Juni 2027</li>\n       </ul>\n      </div>\n     </div>\n    </div>\n   </aside>\n  </div>\n  <div class=\"px-5 py-3 border-2 rounded-lg mt-16 px-6 py-6 border-gray\">\n   <div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n    <div class=\"grow\">\n     <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/38344-aktion-mensch-e-v\" class=\"link\">Aktion Mensch e.V.</a></h2>\n     <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n      <div>\n       <p>Heinemannstr. 36,\n        <br>\n        53175 Bonn</p>\n      </div>\n      <div>\n       <h3 class=\"font-bold\">E-Mail</h3>\n       <p><a href=\"mailto:info@aktion-mensch.de\">info@aktion-mensch.de</a></p>\n      </div>\n      <div>\n       <h3 class=\"font-bold\">Webseite</h3>\n       <p><a href=\"https://www.aktion-mensch.de\" target=\"_blank\">www.aktion-mensch.de</a></p>\n      </div>\n      <div>\n       <h3 class=\"font-bold\">Telefon</h3>\n       <p>0228 2092300</p>\n      </div>\n     </div>\n    </div>\n    <div class=\"md:w-1/3\">\n     <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/AM_Foerder_Logo_RGB.jpg\" width=\"800\" height=\"470\">\n    </div>\n   </div>\n  </div>\n </article>\n</main>\n<footer class=\"container mt-24\">\n <div class=\"flex flex-row flex-wrap justify-between items-center py-12 border-t-2 border-yellow select-none cursor-default\">\n  <nav class=\"flex flex-row flex-wrap -mx-1\">\n   <p class=\"mr-6 p-1 opacity-70\">©2026</p>\n   <a class=\"block mr-6 p-1 opacity-70 hover:opacity-100 focus:opacity-100 transition-opacity\" href=\"https://foerderdatenbank.d-s-e-e.de/impressum\">Impressum</a><a class=\"block mr-6 p-1 opacity-70 hover:opacity-100 focus:opacity-100 transition-opacity\" href=\"https://www.deutsche-stiftung-engagement-und-ehrenamt.de/datenschutzerklaerung/\">Datenschutzerklärung</a>\n  </nav>\n  <div class=\"max-w-[240px]\">\n   <img src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/2023_DSEE_Logo_3zlg_RGB_Basis_large.svg\" width=\"300\" height=\"92\" alt=\"Logo Deutsche Stiftung für Engagement und Ehrenamt\">\n  </div>\n </div>\n</footer>\n<script>\n  var _paq = window._paq = window._paq || [];\n  /* tracker methods like \"setCustomDimension\" should be called before \"trackPageView\" */\n  _paq.push(['trackPageView']);\n  _paq.push(['enableLinkTracking']);\n  (function() {\n    var u=\"//matomo.deutsche-stiftung-engagement-und-ehrenamt.de/\";\n    _paq.push(['setTrackerUrl', u+'matomo.php']);\n    _paq.push(['setSiteId', '4']);\n    var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];\n    g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);\n  })();\n</script>";
    <https://html.spec.whatwg.org/#innerText> "Junge Menschen stärken  –  Förderdatenbank Newsletter X Facebook Instagram LinkedIn Zur Startseite Förderdatenbank der DSEE Förderdatenbank der DSEE>Junge Menschen stärken Junge Menschen stärken Inklusive Begegnungen machen ein Miteinander ganz selbstverständlich. Ohne Vorurteile. Ohne Ausgrenzung. Wir unterstützen junge Menschen dabei, ihr Leben selbstbestimmt zu gestalten. Wir wollen jungen Menschen zeigen: Sie können etwas bewegen! Indem sie Ideen einbringen. Mitgestalten. Verantwortung übernehmen. Für mehr Selbstwirksamkeit und Selbstvertrauen. Zielgruppen/Bedingungen Wir fördern inklusive und partizipative Freizeitprojekte. Das bedeutet: Junge Menschen gestalten die Projekte aktiv mit. Sie bringen ihre Ideen ein. Planen und wirken bei der Umsetzung mit. Und übernehmen Verantwortung. So erfahren sie, dass ihr Handeln etwas bewirken kann. Für sich selbst. Und für andere. Die Themen orientieren sich an ihren Interessen und Bedürfnissen. Gleichzeitig sollen alle teilnehmen können. Deshalb sind eine inklusive Haltung und eine barrierefreie Gestaltung Voraussetzung. So fühlen sich auch junge Menschen mit Behinderung willkommen und können gleichberechtigt mitmachen. Zielgruppe: Junge Menschen zwischen 12 und 24 Jahren, deren Teilhabe und Beteiligung eingeschränkt sind Folgende Förderziele stehen im Mittelpunkt: Anerkennung von Vielfalt: Junge Menschen erleben Unterschiedlichkeit als Bereicherung. Sie bauen Vorurteile ab und begegnen anderen Menschen offen und respektvoll. Mitgestaltung und Partizipation: Junge Menschen bringen eigene Anliegen ein. Sie entscheiden mit. Und erleben, dass sie etwas verändern können. Im Kleinen und im Großen. Abbau von Teilhabebarrieren: Junge Menschen erleben, was gleichberechtigte Teilhabe bedeutet. Sie erkennen Barrieren im Alltag. Und helfen dabei, sie abzubauen. Zugehörigkeit: Junge Menschen fühlen sich angenommen. Sie erleben Wertschätzung, Zusammenhalt und Gemeinschaft. Dazugehören macht stark. Selbstwirksamkeit: Junge Menschen erleben: Ich kann selbst etwas tun. Das stärkt das Vertrauen in die eigenen Fähigkeiten und den Mut sich einzubringen. Persönlichkeitskompetenzen: Junge Menschen entdecken ihre Stärken. Durch neue Erfahrungen gewinnen sie an Selbstbewusstsein und handeln selbstverantwortlich. Soziale Kompetenzen: Junge Menschen lernen, Konflikte fair zu lösen. Sie übernehmen Verantwortung für sich und andere. Und erleben ein respektvolles Miteinander. Kommunikations- und Urteilsfähigkeit: Junge Menschen vertreten ihre Meinung. Sie hören anderen zu und bleiben im Gespräch. Sie bewegen sich sicher und kompetent online und im Alltag. Förderfähig sind anerkannte Träger der freien Kinder- und Jugendhilfe nach Paragraph 75 SGB VIII. Wichtig: Eine automatische Anerkennung über die Mitgliedschaft bei einem Wohlfahrtsverband ist nicht mehr gewährleistet. Ab Gesamtkosten von 100.000 Euro benötigst du eine Stellungnahme der zuständigen Jugendfachbehörde (in der Regel vom Jugendamt). Bei Antragstellung muss das Vorliegen eines Kinderschutzkonzepts bestätigt werden. Die Gesamtkosten deines Vorhabens müssen mindestens 50.000 Euro betragen. Pro Förderangebot kann jeweils maximal ein Antrag pro Antragszyklus und Projekt-Partner (Rechtsträger) gestellt werden. Fördermittel und Laufzeit Bis zu 90 Prozent der förderfähigen Kosten, maximal 300.000 Euro Laufzeit bis zu 48 Monate Eigenmittel von mindestens 10 Prozent der förderfähigen Kosten: Bare Mittel Eintrittsgelder, Tagungsgebühren und Verkaufserlöse Spenden Individuelle Zuschüsse für Personalkosten Öffentliche Mittel Hinweise zur Antragstellung/Bewerbung Die Antragstellung ist während der Antragszyklen im Förderportal möglich. Jeder Zyklus beginnt mit einer Antragsphase. Während dieser kannst du deinen Antrag bei uns einreichen. Dafür hast du sechs Wochen Zeit. Die erste Antragsphase beginnt am 01. September 2026. Die nächsten beiden folgen ab 01. Januar 2027 und ab 01. Mai 2027. Weitere Informationen Link zur Förderung Fördercheck Regionen: Bundesweit Engagementbereiche: Kinder und Jugendliche Soziales Förderfähige Kosten: Bau- und Investkosten Honorarkosten Personalkosten Sachkosten Eigenmittel benötigt: Ja Bewerbungsfrist: 15. Oktober 2026 15. Februar 2027 15. Juni 2027 Aktion Mensch e.V. Heinemannstr. 36, 53175 Bonn E-Mail info@aktion-mensch.de Webseite www.aktion-mensch.de Telefon 0228 2092300 ©2026 Impressum Datenschutzerklärung".
