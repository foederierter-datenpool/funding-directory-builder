    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/22852-e-on-stiftung\" class=\"link\">E.ON Stiftung</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Brüsseler Platz 1,\n     <br>\n     45131 Essen</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:kontakt-stiftung@eon.com\">kontakt-stiftung@eon.com</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.eon-stiftung.com/de/kontakt.html\" target=\"_blank\">www.eon-stiftung.com/de/kontakt.html</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>+49 (0) 152 521 377 14</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "E.ON Stiftung Brüsseler Platz 1, 45131 Essen E-Mail kontakt-stiftung@eon.com Webseite www.eon-stiftung.com/de/kontakt.html Telefon +49 (0) 152 521 377 14".
