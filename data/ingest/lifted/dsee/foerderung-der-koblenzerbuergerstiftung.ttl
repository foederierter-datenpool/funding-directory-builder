    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/2105-koblenzerbuergerstiftung\" class=\"link\">KoblenzerBürgerStiftung</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Thielenstraße 13,\n     <br>\n     56073 Koblenz</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@koblenzerbuergerstiftung.de\">info@koblenzerbuergerstiftung.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.koblenzerbuergerstiftung.de\" target=\"_blank\">www.koblenzerbuergerstiftung.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0261 2017878</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/images_160303_115707.jpeg\" width=\"800\" height=\"800\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "KoblenzerBürgerStiftung Thielenstraße 13, 56073 Koblenz E-Mail info@koblenzerbuergerstiftung.de Webseite www.koblenzerbuergerstiftung.de Telefon 0261 2017878".
