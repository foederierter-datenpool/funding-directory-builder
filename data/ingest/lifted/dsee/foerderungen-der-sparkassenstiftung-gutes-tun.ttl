    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1362-sparkassenstiftung-gutes-tun-stifternetzwerk-der-sparkasse-karlsruhe\" class=\"link\">Sparkassenstiftung Gutes tun – Stifternetzwerk der Sparkasse Karlsruhe</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Kaiserstraße 223,\n     <br>\n     76133 Karlsruhe</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:gutestun@stiftung-gutes-tun.de\">gutestun@stiftung-gutes-tun.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.stiftung-gutes-tun.de\" target=\"_blank\">www.stiftung-gutes-tun.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0721 1461597</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Sparkassenstiftung-Gutes-tun-–-Stifternetzwerk-der-Sparkasse-Karlsruhe.jpg\" width=\"800\" height=\"564\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Sparkassenstiftung Gutes tun – Stifternetzwerk der Sparkasse Karlsruhe Kaiserstraße 223, 76133 Karlsruhe E-Mail gutestun@stiftung-gutes-tun.de Webseite www.stiftung-gutes-tun.de Telefon 0721 1461597".
