of document.querySelectorAll('link[rel=\"modulepreload\"]'))r(e);new MutationObserver((e=>{for(const o of e)if(\"childList\"===o.type)for(const e of o.addedNodes)if(\"LINK\"===e.tagName&&\"modulepreload\"===e.rel)r(e);else if(e.querySelectorAll)for(const o of e.querySelectorAll(\"link[rel=modulepreload]\"))r(o)})).observe(document,{childList:!0,subtree:!0})}function r(e){if(e.ep)return;e.ep=!0;const r=function(e){const r={};return e.integrity&&(r.integrity=e.integrity),e.referrerpolicy&&(r.referrerPolicy=e.referrerpolicy),\"use-credentials\"===e.crossorigin?r.credentials=\"include\":\"anonymous\"===e.crossorigin?r.credentials=\"omit\":r.credentials=\"same-origin\",r}(e);fetch(e.href,r)}}();</script>\n<script type=\"module\" src=\"https://foerderdatenbank.d-s-e-e.de/dist/assets/app-DB5ScF6h.js\" crossorigin onload=\"e=new CustomEvent('vite-script-loaded', {detail:{path: 'resources/js/main.js'}});document.dispatchEvent(e);\"></script>\n<link href=\"https://foerderdatenbank.d-s-e-e.de/dist/assets/app-ClfkFxNO.css\" rel=\"stylesheet\"> \n<div class=\"container flex flex-row justify-end my-4\">\n <div class=\"flex flex-row flex-wrap items-center -mx-1 select-none cursor-default\">\n  <nav class=\"flex flex-row my-2\">\n   <a class=\"block mr-2 md:mr-6 p-1 opacity-70 hover:opacity-100 focus:opacity-100 transition-opacity\" href=\"https://www.deutsche-stiftung-engagement-und-ehrenamt.de/newsletter/\">Newsletter</a>\n  </nav>\n  <div class=\"flex flex-row divide-x my-2\">\n   <a href=\"https://x.com/d_s_e_e\" title=\"X\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-x.svg\" width=\"24\" height=\"24\" alt=\"Logo X\"> <span class=\"sr-only\">X</span> </a><a href=\"https://www.facebook.com/EngagementStiftung/\" title=\"Facebook\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-facebook.svg\" width=\"24\" height=\"24\" alt=\"Logo Facebook\"> <span class=\"sr-only\">Facebook</span> </a> <a href=\"https://www.instagram.com/engagement_und_ehrenamt/\" title=\"Instagram\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-instagram.svg\" width=\"24\" height=\"24\" alt=\"Logo Instagram\"> <span class=\"sr-only\">Instagram</span> </a> <a href=\"https://www.linkedin.com/company/dsee/\" title=\"LinkedIn\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-linkedin.svg\" width=\"24\" height=\"24\" alt=\"Logo LinkedIn\"> <span class=\"sr-only\">LinkedIn</span> </a>\n  </div>\n </div>\n</div>\n<header class=\"container my-4 flex flex-row flex-wrap justify-between items-end select-none cursor-default\">\n <a href=\"https://foerderdatenbank.d-s-e-e.de/\" class=\"block my-2 w-full max-w-md\"> <span class=\"sr-only\">Zur Startseite</span><img src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/2023_DSEE_Logo_3zlg_RGB_Basis_large.svg\" width=\"300\" height=\"92\" alt=\"Logo Deutsche Stiftung für Engagement und Ehrenamt\" fetchpriority=\"high\"></a>\n <p class=\"my-2 font-medium text-2xl\">Förderdatenbank der DSEE</p>\n</header>\n<main class=\"my-8\">\n <nav class=\"container\">\n  <div class=\"my-8 py-3 border-t-2 border-gray select-none cursor-default\">\n   <a class=\"link\" href=\"https://foerderdatenbank.d-s-e-e.de/\">Förderdatenbank der DSEE</a><span class=\"px-1 text-gray\">&gt;</span><span>Förderung durch die Stiftung der Stadtsparkasse Wetter (Ruhr)</span>\n  </div>\n </nav>\n <article class=\"container\">\n  <div class=\"grid lg:grid-cols-3 gap-16\">\n   <div class=\"col-span-2 space-y-4\">\n    <header class=\"mb-8\">\n     <h1 class=\"col-span-2 font-bold text-2xl\">Förderung durch die Stiftung der Stadtsparkasse Wetter (Ruhr)</h1>\n    </header>\n    <div class=\"prose text-lg mb-8 space-y-6\">\n     <div>\n      <p>Im Jahr 2002 hat die Stadtsparkasse Wetter (Ruhr) anlässlich ihres 150-jährigen Jubiläums die Stiftung der Stadtsparkasse Wetter (Ruhr) gegründet.&nbsp;Die Sparkassenstiftung unterstützt die Förderung von Bildung, Kunst, Kultur, Denkmal-, Natur- und Heimatpflege.\n       <br></p>\n      <p>Die Sparkasse hat ihr langjähriges Bestehen den Bürgern, Unternehmen und der sie tragenden Kommune der Stadt Wetter (Ruhr) zu verdanken. Als Ausdruck des Dankes für die Partnerschaft soll die Stiftung der Stadtsparkasse Wetter (Ruhr) Nutzen stiften für die Wetteraner Bürger.\n       <br></p>\n     </div>\n     <div>\n      <h3>Zielgruppen/Bedingungen</h3>\n      <p>In Zeiten allgemeiner Finanznot fällt es Kommunen und anderen Organisationen zunehmend schwerer, freiwillige Leistungen, zum Beispiel im Bereich der Kultur, zu finanzieren. Hier einen Beitrag zu leisten, hat sich die Stiftung der Stadtsparkasse Wetter (Ruhr) zum Ziel gesetzt und unterstützt die Förderung von Bildung, Kunst, Kultur, Denkmal-, Natur- und Heimatpflege.</p>\n      <p>So werden verschiedene Projekte, über die das sechsköpfige Kuratorium jeweils jährlich entscheidet, durchgeführt.</p>\n     </div>\n     <div>\n      <h3>Weitere Informationen</h3>\n      <ul>\n       <li><a href=\"https://www.sparkasse-en.de/de/home/ihre-sparkasse/sparkassenstiftungen/stiftung-ssk-wetter.html#:~:text=Die%20Sparkassenstiftung%20unterst%C3%BCtzt%20die%20F%C3%B6rderung,%2D%2C%20Natur%2D%20und%20Heimatpflege.&amp;text=Im%20Jahr%202002%20hat%20die,Stadtsparkasse%20Wetter%20(Ruhr)%20gegr%C3%BCndet.\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Link zur Stiftung</a></li>\n      </ul>\n     </div>\n    </div>\n   </div>\n   <aside>\n    <div class=\"prose text-lg space-y-4\">\n     <div>\n      <div class=\"font-bold\">Regionen:</div>\n      <div>\n       <ul>\n        <li>Nordrhein-Westfalen</li>\n       </ul>\n      </div>\n     </div>\n     <div>\n      <div class=\"font-bold\">Engagementbereiche:</div>\n      <div>\n       <ul>\n        <li>Bauten und Denkmalschutz</li>\n        <li>Bildung</li>\n        <li>Kultur, Medien und Musik</li>\n        <li>Umwelt-/Naturschutz, Klimaschutz und Tierschutz</li>\n       </ul>\n      </div>\n     </div>\n     <div>\n      <div class=\"font-bold\">Bewerbungsfrist:</div>\n      <div class=\"mb-1\">Fortlaufende Förderung</div>\n     </div>\n    </div>\n   </aside>\n  </div>\n  <div class=\"px-5 py-3 border-2 rounded-lg mt-16 px-6 py-6 border-gray\">\n   <div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n    <div class=\"grow\">\n     <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/2478-stiftung-der-stadtsparkasse-wetter-ruhr\" class=\"link\">Stiftung der Stadtsparkasse Wetter (Ruhr)</a></h2>\n     <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n      <div>\n       <p>Mittelstr. 2-4,\n        <br>\n        58285 Gevelsberg</p>\n      </div>\n      <div>\n       <h3 class=\"font-bold\">E-Mail</h3>\n       <p><a href=\"mailto:stiftung@sparkasse-en.de\">stiftung@sparkasse-en.de</a></p>\n      </div>\n      <div>\n       <h3 class=\"font-bold\">Webseite</h3>\n       <p><a href=\"https://www.sparkasse-en.de/de/home/ihre-sparkasse/sparkassenstiftungen/stiftung-ssk-wetter.html#:~:text=Die%20Sparkassenstiftung%20unterst%C3%BCtzt%20die%20F%C3%B6rderung,%2D%2C%20Natur%2D%20und%20Heimatpflege.&amp;text=Im%20Jahr%202002%20hat%20die,Stadtsparkasse%20Wetter%20(Ruhr)%20gegr%C3%BCndet.\" target=\"_blank\">www.sparkasse-en.de/de/home/ihre-sparkasse/sparkassenstiftungen/stiftung-ssk-wetter.html#:~:text=Die%20Sparkassenstiftung%20unterst%C3%BCtzt%20die%20F%C3%B6rderung,%2D%2C%20Natur%2D%20und%20Heimatpflege.&amp;text=Im%20Jahr%202002%20hat%20die,Stadtsparkasse%20Wetter%20(Ruhr)%20gegr%C3%BCndet.</a></p>\n      </div>\n      <div>\n       <h3 class=\"font-bold\">Telefon</h3>\n       <p>02332 7021201</p>\n      </div>\n     </div>\n    </div>\n   </div>\n  </div>\n </article>\n</main>\n<footer class=\"container mt-24\">\n <div class=\"flex flex-row flex-wrap justify-between items-center py-12 border-t-2 border-yellow select-none cursor-default\">\n  <nav class=\"flex flex-row flex-wrap -mx-1\">\n   <p class=\"mr-6 p-1 opacity-70\">©2026</p>\n   <a class=\"block mr-6 p-1 opacity-70 hover:opacity-100 focus:opacity-100 transition-opacity\" href=\"https://foerderdatenbank.d-s-e-e.de/impressum\">Impressum</a><a class=\"block mr-6 p-1 opacity-70 hover:opacity-100 focus:opacity-100 transition-opacity\" href=\"https://www.deutsche-stiftung-engagement-und-ehrenamt.de/datenschutzerklaerung/\">Datenschutzerklärung</a>\n  </nav>\n  <div class=\"max-w-[240px]\">\n   <img src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/2023_DSEE_Logo_3zlg_RGB_Basis_large.svg\" width=\"300\" height=\"92\" alt=\"Logo Deutsche Stiftung für Engagement und Ehrenamt\">\n  </div>\n </div>\n</footer>\n<script>\n  var _paq = window._paq = window._paq || [];\n  /* tracker methods like \"setCustomDimension\" should be called before \"trackPageView\" */\n  _paq.push(['trackPageView']);\n  _paq.push(['enableLinkTracking']);\n  (function() {\n    var u=\"//matomo.deutsche-stiftung-engagement-und-ehrenamt.de/\";\n    _paq.push(['setTrackerUrl', u+'matomo.php']);\n    _paq.push(['setSiteId', '4']);\n    var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];\n    g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);\n  })();\n</script>";
    <https://html.spec.whatwg.org/#innerText> "Förderung durch die Stiftung der Stadtsparkasse Wetter (Ruhr)  –  Förderdatenbank Newsletter X Facebook Instagram LinkedIn Zur Startseite Förderdatenbank der DSEE Förderdatenbank der DSEE>Förderung durch die Stiftung der Stadtsparkasse Wetter (Ruhr) Förderung durch die Stiftung der Stadtsparkasse Wetter (Ruhr) Im Jahr 2002 hat die Stadtsparkasse Wetter (Ruhr) anlässlich ihres 150-jährigen Jubiläums die Stiftung der Stadtsparkasse Wetter (Ruhr) gegründet. Die Sparkassenstiftung unterstützt die Förderung von Bildung, Kunst, Kultur, Denkmal-, Natur- und Heimatpflege. Die Sparkasse hat ihr langjähriges Bestehen den Bürgern, Unternehmen und der sie tragenden Kommune der Stadt Wetter (Ruhr) zu verdanken. Als Ausdruck des Dankes für die Partnerschaft soll die Stiftung der Stadtsparkasse Wetter (Ruhr) Nutzen stiften für die Wetteraner Bürger. Zielgruppen/Bedingungen In Zeiten allgemeiner Finanznot fällt es Kommunen und anderen Organisationen zunehmend schwerer, freiwillige Leistungen, zum Beispiel im Bereich der Kultur, zu finanzieren. Hier einen Beitrag zu leisten, hat sich die Stiftung der Stadtsparkasse Wetter (Ruhr) zum Ziel gesetzt und unterstützt die Förderung von Bildung, Kunst, Kultur, Denkmal-, Natur- und Heimatpflege. So werden verschiedene Projekte, über die das sechsköpfige Kuratorium jeweils jährlich entscheidet, durchgeführt. Weitere Informationen Link zur Stiftung Regionen: Nordrhein-Westfalen Engagementbereiche: Bauten und Denkmalschutz Bildung Kultur, Medien und Musik Umwelt-/Naturschutz, Klimaschutz und Tierschutz Bewerbungsfrist: Fortlaufende Förderung Stiftung der Stadtsparkasse Wetter (Ruhr) Mittelstr. 2-4, 58285 Gevelsberg E-Mail stiftung@sparkasse-en.de Webseite www.sparkasse-en.de/de/home/ihre-sparkasse/sparkassenstiftungen/stiftung-ssk-wetter.html#:~:text=Die%20Sparkassenstiftung%20unterst%C3%BCtzt%20die%20F%C3%B6rderung,%2D%2C%20Natur%2D%20und%20Heimatpflege.&text=Im%20Jahr%202002%20hat%20die,Stadtsparkasse%20Wetter%20(Ruhr)%20gegr%C3%BCndet. Telefon 02332 7021201 ©2026 Impressum Datenschutzerklärung".
