    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/35493-bundesvereinigung-kulturelle-kinder-und-jugendbildung-bkj\" class=\"link\">Bundesvereinigung Kulturelle Kinder- und Jugendbildung (BKJ)</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@bkj.de\">info@bkj.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.bkj.de/\" target=\"_blank\">www.bkj.de/</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>030 4848600</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Bundesvereinigung Kulturelle Kinder- und Jugendbildung (BKJ) E-Mail info@bkj.de Webseite www.bkj.de/ Telefon 030 4848600".
