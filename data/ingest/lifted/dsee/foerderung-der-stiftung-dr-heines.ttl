    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/797-stiftung-dr-heines\" class=\"link\">Stiftung Dr. Heines</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Contrescarpe 20,\n     <br>\n     28203 Bremen</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@stiftung-dr-heines.de\">info@stiftung-dr-heines.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.stiftung-dr-heines.de\" target=\"_blank\">www.stiftung-dr-heines.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0421 420019</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Stiftung-Dr.-Heines_1.gif\" width=\"800\" height=\"437\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Stiftung Dr. Heines Contrescarpe 20, 28203 Bremen E-Mail info@stiftung-dr-heines.de Webseite www.stiftung-dr-heines.de Telefon 0421 420019".
