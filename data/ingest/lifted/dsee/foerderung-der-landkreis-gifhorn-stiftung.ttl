    rdf:_1 _:n3-182563;
    <http://www.w3.org/1999/xhtml#class> "mb-8";
    <https://html.spec.whatwg.org/#innerHTML> "<h1 class=\"col-span-2 font-bold text-2xl\">Förderung der Landkreis Gifhorn Stiftung</h1>";
