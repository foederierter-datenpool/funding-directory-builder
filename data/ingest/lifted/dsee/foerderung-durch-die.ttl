    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/124-stiftung-der-kreissparkasse-verden\" class=\"link\">Stiftung der Kreissparkasse Verden</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Ostertorstraße 16,\n     <br>\n     27283 Verden (Aller)</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:stiftung@ksk-verden.de\">stiftung@ksk-verden.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.stiftung-ksk-verden.de\" target=\"_blank\">www.stiftung-ksk-verden.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>04231 160</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Logo-stiftung-4c.jpg\" width=\"800\" height=\"363\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Stiftung der Kreissparkasse Verden Ostertorstraße 16, 27283 Verden (Aller) E-Mail stiftung@ksk-verden.de Webseite www.stiftung-ksk-verden.de Telefon 04231 160".
