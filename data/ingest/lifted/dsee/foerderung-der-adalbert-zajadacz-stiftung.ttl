    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/2195-adalbert-zajadacz-stiftung\" class=\"link\">Adalbert Zajadacz Stiftung</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Lessingstraße 46,\n     <br>\n     21629 Neu Wulmstorf</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@zajadacz-stiftung.de\">info@zajadacz-stiftung.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.zajadacz-stiftung.de\" target=\"_blank\">www.zajadacz-stiftung.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>040 228 9832000</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Unknown_160319_112906.png\" width=\"800\" height=\"523\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Adalbert Zajadacz Stiftung Lessingstraße 46, 21629 Neu Wulmstorf E-Mail info@zajadacz-stiftung.de Webseite www.zajadacz-stiftung.de Telefon 040 228 9832000".
