_:n3-252673 a <http://www.w3.org/1999/xhtml#h1>;
    rdf:_1 "Gutes tun in MV";
    <http://www.w3.org/1999/xhtml#class> "col-span-2 font-bold text-2xl";
    <https://html.spec.whatwg.org/#innerHTML> "Gutes tun in MV";
