    rdf:_1 _:n3-252695;
    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"prose text-lg space-y-4\">\n <div>\n  <div class=\"font-bold\">Regionen:</div>\n  <div>\n   <ul>\n    <li>Mecklenburg-Vorpommern</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Engagementbereiche:</div>\n  <div>\n   <ul>\n    <li>Bevölkerungs- und Katastrophenschutz</li>\n    <li>Bildung</li>\n    <li>Digitalisierung</li>\n    <li>Engagement für gesellschaftlichen Zusammenhalt/ Demokratie</li>\n    <li>Kinder und Jugendliche</li>\n    <li>Kultur, Medien und Musik</li>\n    <li>Migration</li>\n    <li>Soziales</li>\n    <li>Sport und Bewegung</li>\n    <li>Umwelt-/Naturschutz, Klimaschutz und Tierschutz</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Förderfähige Kosten:</div>\n  <div>\n   <ul>\n    <li>Honorarkosten</li>\n    <li>Sachkosten</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Max. Fördersumme:</div>\n  <div>1.000€</div>\n </div>\n <div>\n  <div class=\"font-bold\">Bewerbungsfrist:</div>\n  <div class=\"mb-1\">Fortlaufende Förderung</div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Regionen: Mecklenburg-Vorpommern Engagementbereiche: Bevölkerungs- und Katastrophenschutz Bildung Digitalisierung Engagement für gesellschaftlichen Zusammenhalt/ Demokratie Kinder und Jugendliche Kultur, Medien und Musik Migration Soziales Sport und Bewegung Umwelt-/Naturschutz, Klimaschutz und Tierschutz Förderfähige Kosten: Honorarkosten Sachkosten Max. Fördersumme: 1.000€ Bewerbungsfrist: Fortlaufende Förderung".
_:n3-252695 a <http://www.w3.org/1999/xhtml#div>;
