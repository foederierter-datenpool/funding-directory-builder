    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1129-buergerstiftung-heidelberg\" class=\"link\">Bürgerstiftung Heidelberg</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Willy-Brandt-Platz 5,\n     <br>\n     69115 Heidelberg</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:mail@buergerstiftung-heidelberg.de\">mail@buergerstiftung-heidelberg.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.buergerstiftung-heidelberg.de\" target=\"_blank\">www.buergerstiftung-heidelberg.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>06221 6522758</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Bürgerstiftug-Heidelberg.png\" width=\"800\" height=\"583\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Bürgerstiftung Heidelberg Willy-Brandt-Platz 5, 69115 Heidelberg E-Mail mail@buergerstiftung-heidelberg.de Webseite www.buergerstiftung-heidelberg.de Telefon 06221 6522758".
