_:n3-286834 a <http://www.w3.org/1999/xhtml#aside>;
    rdf:_1 _:n3-286835;
    rdf:_2 _:n3-286838;
    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"mb-10 max-w-sm\">\n <figure class=\"ml-auto max-w-[600px]\">\n  <img src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/ESK_Engagiere-dich-vor-Ort-002.png\" width=\"800\" height=\"419\">\n </figure>\n</div>\n<div class=\"prose text-lg space-y-4\">\n <div>\n  <div class=\"font-bold\">Regionen:</div>\n  <div>Bundesweit</div>\n </div>\n <div>\n  <div class=\"font-bold\">Engagementbereiche:</div>\n  <div>\n   <ul>\n    <li>Kinder und Jugendliche</li>\n    <li>Kultur, Medien und Musik</li>\n    <li>Migration</li>\n    <li>Soziales</li>\n    <li>Sport und Bewegung</li>\n    <li>Umwelt-/Naturschutz, Klimaschutz und Tierschutz</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Förderfähige Kosten:</div>\n  <div>\n   <ul>\n    <li>Honorarkosten</li>\n    <li>Sachkosten</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Max. Fördersumme:</div>\n  <div>Grundförderung 630 € pro Projektmonat (Fördersatz 2024)</div>\n </div>\n <div>\n  <div class=\"font-bold\">Eigenmittel benötigt:</div>\n  <div>Nein</div>\n </div>\n <div>\n  <div class=\"font-bold\">Bewerbungsfrist:</div>\n  <div class=\"mb-1\">Fortlaufende Förderung</div>\n  <div class=\"prose text-base\">\n   <p>Zwei bis drei Antragsfristen jährlich, i.d.R. Februar, Mai, Oktober</p>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Vorzeitiger Maßnahmebeginn:</div>\n  <div>Nein</div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Regionen: Bundesweit Engagementbereiche: Kinder und Jugendliche Kultur, Medien und Musik Migration Soziales Sport und Bewegung Umwelt-/Naturschutz, Klimaschutz und Tierschutz Förderfähige Kosten: Honorarkosten Sachkosten Max. Fördersumme: Grundförderung 630 € pro Projektmonat (Fördersatz 2024) Eigenmittel benötigt: Nein Bewerbungsfrist: Fortlaufende Förderung Zwei bis drei Antragsfristen jährlich, i.d.R. Februar, Mai, Oktober Vorzeitiger Maßnahmebeginn: Nein".
_:n3-286835 a <http://www.w3.org/1999/xhtml#div>;
