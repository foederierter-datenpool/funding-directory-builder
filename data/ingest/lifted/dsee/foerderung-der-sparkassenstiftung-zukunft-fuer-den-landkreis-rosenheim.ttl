    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1462-sparkassenstiftung-zukunft-fuer-den-landkreis-rosenheim\" class=\"link\">Sparkassenstiftung Zukunft für den Landkreis Rosenheim</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Rathausstraße 15,\n     <br>\n     83022 Rosenheim</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@sparkassenstiftung-zukunft.de\">info@sparkassenstiftung-zukunft.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.sparkassenstiftung-zukunft.de\" target=\"_blank\">www.sparkassenstiftung-zukunft.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>08031 18284510</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Sparkassenstiftung-Zukunft-für-den-Landkreis-Rosenheim.jpg\" width=\"800\" height=\"385\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Sparkassenstiftung Zukunft für den Landkreis Rosenheim Rathausstraße 15, 83022 Rosenheim E-Mail info@sparkassenstiftung-zukunft.de Webseite www.sparkassenstiftung-zukunft.de Telefon 08031 18284510".
