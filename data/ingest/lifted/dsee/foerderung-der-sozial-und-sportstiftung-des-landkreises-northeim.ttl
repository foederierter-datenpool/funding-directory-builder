_:n3-219200 a <http://www.w3.org/1999/xhtml#aside>;
    rdf:_1 _:n3-219201;
    rdf:_2 _:n3-219204;
    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"mb-10 max-w-sm\">\n <figure class=\"ml-auto max-w-[600px]\">\n  <img src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Logo_SSt-Kopie.jpeg\" width=\"800\" height=\"667\">\n </figure>\n</div>\n<div class=\"prose text-lg space-y-4\">\n <div>\n  <div class=\"font-bold\">Regionen:</div>\n  <div>\n   <ul>\n    <li>Niedersachsen</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Engagementbereiche:</div>\n  <div>\n   <ul>\n    <li>Migration</li>\n    <li>Soziales</li>\n    <li>Sport und Bewegung</li>\n    <li>Sonstiges</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Bewerbungsfrist:</div>\n  <div class=\"mb-1\">Fortlaufende Förderung</div>\n  <div class=\"prose text-base\">\n   <p>Der Vorstand berät gewöhnlich viermal im Jahr über die Vergabe der Fördermittel.</p>\n   <p>Förderanträge müssen grundsätzlich vor Beginn der Maßnahme gestellt werden. Eine rückwirkende Bezuschussung von Maßnahmen ist nur in begründeten Ausnahmefällen möglich.</p>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Regionen: Niedersachsen Engagementbereiche: Migration Soziales Sport und Bewegung Sonstiges Bewerbungsfrist: Fortlaufende Förderung Der Vorstand berät gewöhnlich viermal im Jahr über die Vergabe der Fördermittel. Förderanträge müssen grundsätzlich vor Beginn der Maßnahme gestellt werden. Eine rückwirkende Bezuschussung von Maßnahmen ist nur in begründeten Ausnahmefällen möglich.".
_:n3-219201 a <http://www.w3.org/1999/xhtml#div>;
    rdf:_1 _:n3-219202;
    <http://www.w3.org/1999/xhtml#class> "mb-10 max-w-sm";
    <https://html.spec.whatwg.org/#innerHTML> "<figure class=\"ml-auto max-w-[600px]\">\n <img src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Logo_SSt-Kopie.jpeg\" width=\"800\" height=\"667\">\n</figure>".
_:n3-219202 a <http://www.w3.org/1999/xhtml#figure>;
