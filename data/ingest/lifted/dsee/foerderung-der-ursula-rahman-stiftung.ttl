e of o.addedNodes)if(\"LINK\"===e.tagName&&\"modulepreload\"===e.rel)r(e);else if(e.querySelectorAll)for(const o of e.querySelectorAll(\"link[rel=modulepreload]\"))r(o)})).observe(document,{childList:!0,subtree:!0})}function r(e){if(e.ep)return;e.ep=!0;const r=function(e){const r={};return e.integrity&&(r.integrity=e.integrity),e.referrerpolicy&&(r.referrerPolicy=e.referrerpolicy),\"use-credentials\"===e.crossorigin?r.credentials=\"include\":\"anonymous\"===e.crossorigin?r.credentials=\"omit\":r.credentials=\"same-origin\",r}(e);fetch(e.href,r)}}();</script>\n<script type=\"module\" src=\"https://foerderdatenbank.d-s-e-e.de/dist/assets/app-DB5ScF6h.js\" crossorigin onload=\"e=new CustomEvent('vite-script-loaded', {detail:{path: 'resources/js/main.js'}});document.dispatchEvent(e);\"></script>\n<link href=\"https://foerderdatenbank.d-s-e-e.de/dist/assets/app-ClfkFxNO.css\" rel=\"stylesheet\"> \n<div class=\"container flex flex-row justify-end my-4\">\n <div class=\"flex flex-row flex-wrap items-center -mx-1 select-none cursor-default\">\n  <nav class=\"flex flex-row my-2\">\n   <a class=\"block mr-2 md:mr-6 p-1 opacity-70 hover:opacity-100 focus:opacity-100 transition-opacity\" href=\"https://www.deutsche-stiftung-engagement-und-ehrenamt.de/newsletter/\">Newsletter</a>\n  </nav>\n  <div class=\"flex flex-row divide-x my-2\">\n   <a href=\"https://x.com/d_s_e_e\" title=\"X\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-x.svg\" width=\"24\" height=\"24\" alt=\"Logo X\"> <span class=\"sr-only\">X</span> </a><a href=\"https://www.facebook.com/EngagementStiftung/\" title=\"Facebook\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-facebook.svg\" width=\"24\" height=\"24\" alt=\"Logo Facebook\"> <span class=\"sr-only\">Facebook</span> </a> <a href=\"https://www.instagram.com/engagement_und_ehrenamt/\" title=\"Instagram\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-instagram.svg\" width=\"24\" height=\"24\" alt=\"Logo Instagram\"> <span class=\"sr-only\">Instagram</span> </a> <a href=\"https://www.linkedin.com/company/dsee/\" title=\"LinkedIn\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-linkedin.svg\" width=\"24\" height=\"24\" alt=\"Logo LinkedIn\"> <span class=\"sr-only\">LinkedIn</span> </a>\n  </div>\n </div>\n</div>\n<header class=\"container my-4 flex flex-row flex-wrap justify-between items-end select-none cursor-default\">\n <a href=\"https://foerderdatenbank.d-s-e-e.de/\" class=\"block my-2 w-full max-w-md\"> <span class=\"sr-only\">Zur Startseite</span><img src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/2023_DSEE_Logo_3zlg_RGB_Basis_large.svg\" width=\"300\" height=\"92\" alt=\"Logo Deutsche Stiftung für Engagement und Ehrenamt\" fetchpriority=\"high\"></a>\n <p class=\"my-2 font-medium text-2xl\">Förderdatenbank der DSEE</p>\n</header>\n<main class=\"my-8\">\n <nav class=\"container\">\n  <div class=\"my-8 py-3 border-t-2 border-gray select-none cursor-default\">\n   <a class=\"link\" href=\"https://foerderdatenbank.d-s-e-e.de/\">Förderdatenbank der DSEE</a><span class=\"px-1 text-gray\">&gt;</span><span>Förderung der Ursula Rahman Stiftung</span>\n  </div>\n </nav>\n <article class=\"container\">\n  <div class=\"grid lg:grid-cols-3 gap-16\">\n   <div class=\"col-span-2 space-y-4\">\n    <header class=\"mb-8\">\n     <h1 class=\"col-span-2 font-bold text-2xl\">Förderung der Ursula Rahman Stiftung</h1>\n    </header>\n    <div class=\"prose text-lg mb-8 space-y-6\">\n     <div>\n      <p>Die Ursula Rahman Stiftung fördert Bildungsprojekte auf der ganzen Welt.</p>\n     </div>\n     <div>\n      <h3>Zielgruppen/Bedingungen</h3>\n      <p>Die Stiftung unterstützt</p>\n      <ul>\n       <li>Projekte, Initiativen und Organisationen die</li>\n       <li>Kindern, Jugendlichen und jungen Erwachsenen</li>\n      </ul>\n      <p>rund um das Thema</p>\n      <ul>\n       <li>Schule, Ausbildung und Studium</li>\n       <li>regional, national und international</li>\n      </ul>\n      <p>weiter helfen.</p>\n      <p>Eine Förderung gibt es für Projekte, die den Einzelfall direkt im Blick haben durch</p>\n      <ul>\n       <li>psychosoziale Betreuung\n        <br></li>\n       <li>Lernmaterial\n        <br></li>\n       <li>Nachhilfe\n        <br></li>\n       <li>Stipendien</li>\n      </ul>\n      <p>Gefördert werden Projekte zur Unterstützung von benachteiligten Familien, die aus den verschiedensten Gründen ihre Kinder nicht selbst fördern können (z.B. aufgrund von Armut, einer körperlichen Erkrankung, einer Suchtproblematik). Gefördert werden gemeinnützige Organisationen und eingetragene Vereine, die im Sinne dieser Stiftung tätig sind.</p>\n      <p>Dem Stifter ist es wichtig, aussagekräftige Unterlagen und Informationen als Nachweis über die zweckgebundene Verwendung der Mittel zu erhalten. Bei langfristig angelegten Projekten wird ein jährlicher Zwischenbericht erwartet.</p>\n      <p>Mit der Förderzusage verpflichtet sich der Empfänger in seinen Veröffentlichungen in angemessener Weise auf die Förderung durch die Ursula Rahman Stiftung hinzuweisen.</p>\n      <p>Die Empfänger sind verpflichtet, die Mittel zweckgebunden einzusetzen. Die Stiftung behält sich vor, Förderzusagen zu widerrufen oder Mittel zurückzufordern, sollten sie nicht antragsgerecht verwendet werden.</p>\n     </div>\n     <div>\n      <h3>Hinweise zur Antragstellung/Bewerbung</h3>\n      <p>Die Ursula Rahman Stiftung möchte Ihr Projekt möglichst gut kennen lernen. Dazu ist es hilfreich, wenn Ihr Antrag folgende Punkte enthält:\n       <br></p>\n      <ul>\n       <li>Name der Organisation</li>\n       <li>Ansprechperson mit allen Kontaktdaten</li>\n       <li>Eine kurze Beschreibung der Organisation:\n        <br>\n        Anzahl der Mitarbeitenden, Gründungsjahr, Aufgabenschwerpunkte</li>\n       <li>Eine Beschreibung dessen, WARUM es ihre Organisation gibt</li>\n       <li>Eine Beschreibung des Projektes:\n        <br>\n        Zielgruppe(n), Anzahl der Teilnehmenden, Zeitliche Planung (handelt es sich um ein Dauerprojekt oder gibt es einen Anfang und ein Ende), Projektziele.</li>\n       <li>Was macht Sie sicher, dass Sie Ihre Ziele auch erreichen werden?</li>\n       <li>Warum sollte die Ursula Rahman Stiftung Ihr Projekt fördern?</li>\n       <li>Kostenplan</li>\n       <li>Finanzierungsplan: Wenn Ihr Projekt auf Dauer angelegt ist, beschreiben Sie hier bitte auch, wie Sie die Finanzierung sicher stellen wollen.</li>\n      </ul>\n     </div>\n     <div>\n      <h3>Weitere Informationen</h3>\n      <ul>\n       <li><a href=\"https://www.ursula-rahman-stiftung.de/foerderbedingungen.html\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Link zur Förderung</a></li>\n      </ul>\n     </div>\n    </div>\n   </div>\n   <aside>\n    <div class=\"prose text-lg space-y-4\">\n     <div>\n      <div class=\"font-bold\">Regionen:</div>\n      <div>Bundesweit</div>\n     </div>\n     <div>\n      <div class=\"font-bold\">Engagementbereiche:</div>\n      <div>\n       <ul>\n        <li>Bildung</li>\n        <li>Kinder und Jugendliche</li>\n       </ul>\n      </div>\n     </div>\n     <div>\n      <div class=\"font-bold\">Bewerbungsfrist:</div>\n      <div class=\"mb-1\">Fortlaufende Förderung</div>\n     </div>\n    </div>\n   </aside>\n  </div>\n  <div class=\"px-5 py-3 border-2 rounded-lg mt-16 px-6 py-6 border-gray\">\n   <div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n    <div class=\"grow\">\n     <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/38009-ursula-rahman-stiftung\" class=\"link\">Ursula Rahman Stiftung</a></h2>\n     <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n      <div>\n       <p>Geibelstrasse 55,\n        <br>\n        40235 Düsseldorf</p>\n      </div>\n      <div>\n       <h3 class=\"font-bold\">E-Mail</h3>\n       <p><a href=\"mailto:info@ursula-rahman-stiftung.de\">info@ursula-rahman-stiftung.de</a></p>\n      </div>\n      <div>\n       <h3 class=\"font-bold\">Webseite</h3>\n       <p><a href=\"https://www.ursula-rahman-stiftung.de/index.html\" target=\"_blank\">www.ursula-rahman-stiftung.de/index.html</a></p>\n      </div>\n      <div>\n       <h3 class=\"font-bold\">Telefon</h3>\n       <p>0211 663630</p>\n      </div>\n     </div>\n    </div>\n   </div>\n  </div>\n </article>\n</main>\n<footer class=\"container mt-24\">\n <div class=\"flex flex-row flex-wrap justify-between items-center py-12 border-t-2 border-yellow select-none cursor-default\">\n  <nav class=\"flex flex-row flex-wrap -mx-1\">\n   <p class=\"mr-6 p-1 opacity-70\">©2026</p>\n   <a class=\"block mr-6 p-1 opacity-70 hover:opacity-100 focus:opacity-100 transition-opacity\" href=\"https://foerderdatenbank.d-s-e-e.de/impressum\">Impressum</a><a class=\"block mr-6 p-1 opacity-70 hover:opacity-100 focus:opacity-100 transition-opacity\" href=\"https://www.deutsche-stiftung-engagement-und-ehrenamt.de/datenschutzerklaerung/\">Datenschutzerklärung</a>\n  </nav>\n  <div class=\"max-w-[240px]\">\n   <img src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/2023_DSEE_Logo_3zlg_RGB_Basis_large.svg\" width=\"300\" height=\"92\" alt=\"Logo Deutsche Stiftung für Engagement und Ehrenamt\">\n  </div>\n </div>\n</footer>\n<script>\n  var _paq = window._paq = window._paq || [];\n  /* tracker methods like \"setCustomDimension\" should be called before \"trackPageView\" */\n  _paq.push(['trackPageView']);\n  _paq.push(['enableLinkTracking']);\n  (function() {\n    var u=\"//matomo.deutsche-stiftung-engagement-und-ehrenamt.de/\";\n    _paq.push(['setTrackerUrl', u+'matomo.php']);\n    _paq.push(['setSiteId', '4']);\n    var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];\n    g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);\n  })();\n</script>";
    <https://html.spec.whatwg.org/#innerText> "Förderung der Ursula Rahman Stiftung  –  Förderdatenbank Newsletter X Facebook Instagram LinkedIn Zur Startseite Förderdatenbank der DSEE Förderdatenbank der DSEE>Förderung der Ursula Rahman Stiftung Förderung der Ursula Rahman Stiftung Die Ursula Rahman Stiftung fördert Bildungsprojekte auf der ganzen Welt. Zielgruppen/Bedingungen Die Stiftung unterstützt Projekte, Initiativen und Organisationen die Kindern, Jugendlichen und jungen Erwachsenen rund um das Thema Schule, Ausbildung und Studium regional, national und international weiter helfen. Eine Förderung gibt es für Projekte, die den Einzelfall direkt im Blick haben durch psychosoziale Betreuung Lernmaterial Nachhilfe Stipendien Gefördert werden Projekte zur Unterstützung von benachteiligten Familien, die aus den verschiedensten Gründen ihre Kinder nicht selbst fördern können (z.B. aufgrund von Armut, einer körperlichen Erkrankung, einer Suchtproblematik). Gefördert werden gemeinnützige Organisationen und eingetragene Vereine, die im Sinne dieser Stiftung tätig sind. Dem Stifter ist es wichtig, aussagekräftige Unterlagen und Informationen als Nachweis über die zweckgebundene Verwendung der Mittel zu erhalten. Bei langfristig angelegten Projekten wird ein jährlicher Zwischenbericht erwartet. Mit der Förderzusage verpflichtet sich der Empfänger in seinen Veröffentlichungen in angemessener Weise auf die Förderung durch die Ursula Rahman Stiftung hinzuweisen. Die Empfänger sind verpflichtet, die Mittel zweckgebunden einzusetzen. Die Stiftung behält sich vor, Förderzusagen zu widerrufen oder Mittel zurückzufordern, sollten sie nicht antragsgerecht verwendet werden. Hinweise zur Antragstellung/Bewerbung Die Ursula Rahman Stiftung möchte Ihr Projekt möglichst gut kennen lernen. Dazu ist es hilfreich, wenn Ihr Antrag folgende Punkte enthält: Name der Organisation Ansprechperson mit allen Kontaktdaten Eine kurze Beschreibung der Organisation: Anzahl der Mitarbeitenden, Gründungsjahr, Aufgabenschwerpunkte Eine Beschreibung dessen, WARUM es ihre Organisation gibt Eine Beschreibung des Projektes: Zielgruppe(n), Anzahl der Teilnehmenden, Zeitliche Planung (handelt es sich um ein Dauerprojekt oder gibt es einen Anfang und ein Ende), Projektziele. Was macht Sie sicher, dass Sie Ihre Ziele auch erreichen werden? Warum sollte die Ursula Rahman Stiftung Ihr Projekt fördern? Kostenplan Finanzierungsplan: Wenn Ihr Projekt auf Dauer angelegt ist, beschreiben Sie hier bitte auch, wie Sie die Finanzierung sicher stellen wollen. Weitere Informationen Link zur Förderung Regionen: Bundesweit Engagementbereiche: Bildung Kinder und Jugendliche Bewerbungsfrist: Fortlaufende Förderung Ursula Rahman Stiftung Geibelstrasse 55, 40235 Düsseldorf E-Mail info@ursula-rahman-stiftung.de Webseite www.ursula-rahman-stiftung.de/index.html Telefon 0211 663630 ©2026 Impressum Datenschutzerklärung".
