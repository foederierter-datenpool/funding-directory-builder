    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1568-buergerstiftung-altenburger-land\" class=\"link\">Bürgerstiftung Altenburger Land</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Leipziger Straße 4,\n     <br>\n     04600 Altenburg</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@buergerstiftung-altenburgerland.de\">info@buergerstiftung-altenburgerland.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.buergerstiftung-altenburgerland.de\" target=\"_blank\">www.buergerstiftung-altenburgerland.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>03447 596 138</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Bürgerstiftung Altenburger Land Leipziger Straße 4, 04600 Altenburg E-Mail info@buergerstiftung-altenburgerland.de Webseite www.buergerstiftung-altenburgerland.de Telefon 03447 596 138".
