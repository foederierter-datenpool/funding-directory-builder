    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/3025-stiftung-der-volksbank-buehl-eg\" class=\"link\">Stiftung der Volksbank Bühl eG</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Friedrichstraße 4,\n     <br>\n     77815 Bühl</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@volksbank-buehl.de\">info@volksbank-buehl.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.volksbank-buehl.de/stiftung.html\" target=\"_blank\">www.volksbank-buehl.de/stiftung.html</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>07223 9850</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Stiftung der Volksbank Bühl eG Friedrichstraße 4, 77815 Bühl E-Mail info@volksbank-buehl.de Webseite www.volksbank-buehl.de/stiftung.html Telefon 07223 9850".
