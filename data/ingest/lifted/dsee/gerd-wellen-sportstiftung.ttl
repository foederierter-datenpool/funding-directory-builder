    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/703-gerd-wellen-sportstiftung\" class=\"link\">Gerd Wellen Sportstiftung</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Magdeburger Straße 65,\n     <br>\n     47800 Krefeld</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:kontakt@gerd-wellen-sportstiftung.de\">kontakt@gerd-wellen-sportstiftung.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.gerd-wellen-sportstiftung.de\" target=\"_blank\">www.gerd-wellen-sportstiftung.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>02151 4412-0</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Gerd Wellen Sportstiftung Magdeburger Straße 65, 47800 Krefeld E-Mail kontakt@gerd-wellen-sportstiftung.de Webseite www.gerd-wellen-sportstiftung.de Telefon 02151 4412-0".
