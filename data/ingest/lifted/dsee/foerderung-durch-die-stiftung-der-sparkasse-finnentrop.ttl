    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1897-stiftung-der-sparkasse-finnentrop\" class=\"link\">Stiftung der Sparkasse Finnentrop</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Bamenohler Straße 252,\n     <br>\n     57413 Finnentrop</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@sparkasse-finnentrop.de\">info@sparkasse-finnentrop.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.sparkasse-finnentrop.de\" target=\"_blank\">www.sparkasse-finnentrop.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>02721 9700</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Stiftung der Sparkasse Finnentrop Bamenohler Straße 252, 57413 Finnentrop E-Mail info@sparkasse-finnentrop.de Webseite www.sparkasse-finnentrop.de Telefon 02721 9700".
