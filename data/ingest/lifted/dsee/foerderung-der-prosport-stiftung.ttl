    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/444-prosport-stiftung\" class=\"link\">PROSPORT Stiftung</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Roßbichlstraße 6,\n     <br>\n     87561 Oberstdorf</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@prosport.org\">info@prosport.org</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.prosport.org\" target=\"_blank\">www.prosport.org</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>08322 7005305</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Logo-PS-mit-Schriftzug.jpg\" width=\"800\" height=\"142\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "PROSPORT Stiftung Roßbichlstraße 6, 87561 Oberstdorf E-Mail info@prosport.org Webseite www.prosport.org Telefon 08322 7005305".
