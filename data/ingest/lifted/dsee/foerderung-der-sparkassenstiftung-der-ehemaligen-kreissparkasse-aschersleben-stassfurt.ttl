    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1594-sparkassenstiftung-der-ehemaligen-kreissparkasse-aschersleben-stassfurt\" class=\"link\">Sparkassenstiftung der ehemaligen Kreissparkasse Aschersleben-Staßfurt</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Lehrter Straße 15,\n     <br>\n     39418 Staßfurt</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@sparkassenstiftung-aschersleben-stassfurt.de\">info@sparkassenstiftung-aschersleben-stassfurt.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.salzlandsparkasse.de/de/home/ihre-sparkasse/stiftungen/aschersleben-stassfurt.html?n=true&amp;stref=imagebox\" target=\"_blank\">www.salzlandsparkasse.de/de/home/ihre-sparkasse/stiftungen/aschersleben-stassfurt.html?n=true&amp;stref=imagebox</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>03925 9942001</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Sparkassenstiftung-der-ehemaligen-Kreissparkasse-Aschersleben-Staßfurt.jpg\" width=\"800\" height=\"320\">\n </div>\n</div>";
