    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/482-stiftung-gruenstadt\" class=\"link\">Stiftung Grünstadt</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Kreuzerweg 2,\n     <br>\n     67269 Grünstadt</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:stiftung@gruenstadt.de\">stiftung@gruenstadt.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.gruenstadt.de\" target=\"_blank\">www.gruenstadt.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>06359 8050</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Stiftung-Grünstadt-Logo-farbig-klein.jpg\" width=\"800\" height=\"294\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Stiftung Grünstadt Kreuzerweg 2, 67269 Grünstadt E-Mail stiftung@gruenstadt.de Webseite www.gruenstadt.de Telefon 06359 8050".
