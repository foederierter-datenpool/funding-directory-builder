                          rdf:_2    [ rdf:type  <http://www.w3.org/1999/xhtml#article>;
                                      rdf:_1    [ rdf:type  <http://www.w3.org/1999/xhtml#div>;
                                                  rdf:_1    [ rdf:type  <http://www.w3.org/1999/xhtml#div>;
                                                              rdf:_1    [ rdf:type  <http://www.w3.org/1999/xhtml#header>;
                                                                          rdf:_1    [ rdf:type  <http://www.w3.org/1999/xhtml#h1>;
                                                                                      rdf:_1    "Allgemeine Projektförderung der Kulturstiftung des Bundes";
