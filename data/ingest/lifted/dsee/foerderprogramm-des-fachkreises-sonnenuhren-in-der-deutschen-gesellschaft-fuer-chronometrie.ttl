    rdf:_1 _:n3-145484;
    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"prose text-lg space-y-4\">\n <div>\n  <div class=\"font-bold\">Regionen:</div>\n  <div>Bundesweit</div>\n </div>\n <div>\n  <div class=\"font-bold\">Engagementbereiche:</div>\n  <div>\n   <ul>\n    <li>Bauten und Denkmalschutz</li>\n    <li>Kultur, Medien und Musik</li>\n    <li>Wissenschaft und Forschung</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Förderfähige Kosten:</div>\n  <div>\n   <ul>\n    <li>Bau- und Investkosten</li>\n    <li>Honorarkosten</li>\n    <li>Personalkosten</li>\n    <li>Sachkosten</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Max. Fördersumme:</div>\n  <div>maximale Förderanteile: 75 % bei Kosten bis 1000 €, 50 % bei Kosten bis 4999 €, 25 % bei Kosten ab 5000 €</div>\n </div>\n <div>\n  <div class=\"font-bold\">Eigenmittel benötigt:</div>\n  <div>Ja</div>\n </div>\n <div>\n  <div class=\"font-bold\">Bewerbungsfrist:</div>\n  <div class=\"mb-1\">Fortlaufende Förderung</div>\n </div>\n <div>\n  <div class=\"font-bold\">Vorzeitiger Maßnahmebeginn:</div>\n  <div>Ja</div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Regionen: Bundesweit Engagementbereiche: Bauten und Denkmalschutz Kultur, Medien und Musik Wissenschaft und Forschung Förderfähige Kosten: Bau- und Investkosten Honorarkosten Personalkosten Sachkosten Max. Fördersumme: maximale Förderanteile: 75 % bei Kosten bis 1000 €, 50 % bei Kosten bis 4999 €, 25 % bei Kosten ab 5000 € Eigenmittel benötigt: Ja Bewerbungsfrist: Fortlaufende Förderung Vorzeitiger Maßnahmebeginn: Ja".
_:n3-145484 a <http://www.w3.org/1999/xhtml#div>;
