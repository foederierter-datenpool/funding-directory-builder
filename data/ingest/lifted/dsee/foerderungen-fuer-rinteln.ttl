    rdf:_2 _:n3-250830;
    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"mb-10 max-w-sm\">\n <figure class=\"ml-auto max-w-[600px]\">\n  <img src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Logo-Stiftung-fuer-Rinteln.jpeg\" width=\"800\" height=\"687\">\n </figure>\n</div>\n<div class=\"prose text-lg space-y-4\">\n <div>\n  <div class=\"font-bold\">Regionen:</div>\n  <div>\n   <ul>\n    <li>Niedersachsen</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Engagementbereiche:</div>\n  <div>\n   <ul>\n    <li>Bauten und Denkmalschutz</li>\n    <li>Bevölkerungs- und Katastrophenschutz</li>\n    <li>Bildung</li>\n    <li>Engagement für gesellschaftlichen Zusammenhalt/ Demokratie</li>\n    <li>Entwicklungszusammenarbeit</li>\n    <li>Kinder und Jugendliche</li>\n    <li>Kultur, Medien und Musik</li>\n    <li>Migration</li>\n    <li>Soziales</li>\n    <li>Sport und Bewegung</li>\n    <li>Umwelt-/Naturschutz, Klimaschutz und Tierschutz</li>\n    <li>Wissenschaft und Forschung</li>\n    <li>Sonstiges</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Bewerbungsfrist:</div>\n  <div class=\"mb-1\">Fortlaufende Förderung</div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Regionen: Niedersachsen Engagementbereiche: Bauten und Denkmalschutz Bevölkerungs- und Katastrophenschutz Bildung Engagement für gesellschaftlichen Zusammenhalt/ Demokratie Entwicklungszusammenarbeit Kinder und Jugendliche Kultur, Medien und Musik Migration Soziales Sport und Bewegung Umwelt-/Naturschutz, Klimaschutz und Tierschutz Wissenschaft und Forschung Sonstiges Bewerbungsfrist: Fortlaufende Förderung".
_:n3-250827 a <http://www.w3.org/1999/xhtml#div>;
