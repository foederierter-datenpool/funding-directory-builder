    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1416-zukunftsstiftung-der-stadtsparkasse-nuernberg-fuer-die-stadt-nuernberg\" class=\"link\">Zukunftsstiftung der Stadtsparkasse Nürnberg für die Stadt Nürnberg</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Lorenzer Platz 12,\n     <br>\n     90402 Nürnberg</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:kontakt@zukunftsstiftung-nuernberg.de\">kontakt@zukunftsstiftung-nuernberg.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.zukunftsstiftung-nuernberg.de\" target=\"_blank\">www.zukunftsstiftung-nuernberg.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0911 2304284</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Zukunftsstiftung-der-Sparkasse-Nürnberg.jpg\" width=\"800\" height=\"193\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Zukunftsstiftung der Stadtsparkasse Nürnberg für die Stadt Nürnberg Lorenzer Platz 12, 90402 Nürnberg E-Mail kontakt@zukunftsstiftung-nuernberg.de Webseite www.zukunftsstiftung-nuernberg.de Telefon 0911 2304284".
