    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1943-buergerstiftung-wir-fuer-meerbusch\" class=\"link\">Bürgerstiftung Wir für Meerbusch</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Bommershöfer Weg 2–8,\n     <br>\n     40670 Meerbusch-Osterath</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@wir-fuer-meerbusch.de\">info@wir-fuer-meerbusch.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.wir-fuer-meerbusch.de\" target=\"_blank\">www.wir-fuer-meerbusch.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>02150 916271</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Meerbusch-2.jpg\" width=\"798\" height=\"166\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Bürgerstiftung Wir für Meerbusch Bommershöfer Weg 2–8, 40670 Meerbusch-Osterath E-Mail info@wir-fuer-meerbusch.de Webseite www.wir-fuer-meerbusch.de Telefon 02150 916271".
