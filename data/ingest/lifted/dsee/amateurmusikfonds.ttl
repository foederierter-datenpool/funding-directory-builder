                                                                      "<div class=\"grow\">\n <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/22567-bundesmusikverband-chor-orchester-e-v\" class=\"link\">Bundesmusikverband Chor &amp; Orchester e.V.</a></h2>\n <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n  <div>\n   <p>Hugo-Herrmann-Str. 24,\n    <br>\n    78647 Trossingen</p>\n  </div>\n  <div>\n   <h3 class=\"font-bold\">E-Mail</h3>\n   <p><a href=\"mailto:info@bundesmusikverband.de\">info@bundesmusikverband.de</a></p>\n  </div>\n  <div>\n   <h3 class=\"font-bold\">Webseite</h3>\n   <p><a href=\"https://bundesmusikverband.de/\" target=\"_blank\">bundesmusikverband.de/</a></p>\n  </div>\n  <div>\n   <h3 class=\"font-bold\">Telefon</h3>\n   <p>07425 3288060</p>\n  </div>\n </div>\n</div>";
