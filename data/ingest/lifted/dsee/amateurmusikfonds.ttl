                                                                                                            ];
                                                                                                  rdf:_10   "&nbsp;";
                                                                                                  rdf:_2    " können eine Förderung von mindestens 2.500 € bis maximal 7.000 € erhalten. ";
                                                                                                  rdf:_3    [ rdf:type  <http://www.w3.org/1999/xhtml#strong>;
                                                                                                              rdf:_1    "Überregionale Projekte";
                                                                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                      "Überregionale Projekte";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "Überregionale Projekte"
                                                                                                            ];
                                                                                                  rdf:_4    " mit besonderen Antragsvoraussetzungen können grundsätzlich eine Förderung von 10.000 € bis 40.000 € erhalten (Bitte Antragsberechtigung beachten.) Anträge für ein ";
                                                                                                  rdf:_5    [ rdf:type  <http://www.w3.org/1999/xhtml#strong>;
                                                                                                              rdf:_1    "Coaching ";
                                                                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                      "Coaching";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "Coaching"
                                                                                                            ];
                                                                                                  rdf:_6    "oder eine ";
                                                                                                  rdf:_7    [ rdf:type  <http://www.w3.org/1999/xhtml#strong>;
                                                                                                              rdf:_1    "Zukunftswerkstatt";
                                                                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                      "Zukunftswerkstatt";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "Zukunftswerkstatt"
                                                                                                            ];
                                                                                                  rdf:_8    " werden mit bis zu 3.000 € gefördert.";
                                                                                                  rdf:_9    [ rdf:type  <http://www.w3.org/1999/xhtml#br> ];
                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<strong>Ensembleprojekte</strong> können eine Förderung von mindestens 2.500 € bis maximal 7.000 € erhalten. <strong>Überregionale Projekte</strong> mit besonderen Antragsvoraussetzungen können grundsätzlich eine Förderung von 10.000 € bis 40.000 € erhalten (Bitte Antragsberechtigung beachten.) Anträge für ein <strong>Coaching </strong>oder eine <strong>Zukunftswerkstatt</strong> werden mit bis zu 3.000 € gefördert.\n<br>\n&nbsp;";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Ensembleprojekte können eine Förderung von mindestens 2.500 € bis maximal 7.000 € erhalten. Überregionale Projekte mit besonderen Antragsvoraussetzungen können grundsätzlich eine Förderung von 10.000 € bis 40.000 € erhalten (Bitte Antragsberechtigung beachten.) Anträge für ein Coaching oder eine Zukunftswerkstatt werden mit bis zu 3.000 € gefördert."
                                                                                                ];
                                                                                      rdf:_11   [ rdf:type  <http://www.w3.org/1999/xhtml#p>;
                                                                                                  rdf:_1    [ rdf:type  <http://www.w3.org/1999/xhtml#strong>;
                                                                                                              rdf:_1    "WER?";
                                                                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                      "WER?";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "WER?"
                                                                                                            ];
                                                                                                  rdf:_10   [ rdf:type  <http://www.w3.org/1999/xhtml#br> ];
                                                                                                  rdf:_11   "&nbsp;Körperschaften öffentlichen Rechts, sofern sie keine Gebietskörperschaften, Stiftungen des öffentlichen Rechts oder Anstalten des öffentlichen Rechts sind";
                                                                                                  rdf:_12   [ rdf:type  <http://www.w3.org/1999/xhtml#br> ];
                                                                                                  rdf:_13   "&nbsp;";
                                                                                                  rdf:_14   [ rdf:type  <http://www.w3.org/1999/xhtml#br> ];
                                                                                                  rdf:_15   [ rdf:type  <http://www.w3.org/1999/xhtml#strong>;
                                                                                                              rdf:_1    "Nicht antragsberechtigt sind:";
                                                                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                      "Nicht antragsberechtigt sind:";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "Nicht antragsberechtigt sind:"
                                                                                                            ];
                                                                                                  rdf:_16   [ rdf:type  <http://www.w3.org/1999/xhtml#br> ];
                                                                                                  rdf:_17   "&nbsp;nicht eingetragene Vereine";
                                                                                                  rdf:_18   [ rdf:type  <http://www.w3.org/1999/xhtml#br> ];
                                                                                                  rdf:_19   "&nbsp;GbRs oder Musikgruppen ohne Rechtsform";
                                                                                                  rdf:_2    [ rdf:type  <http://www.w3.org/1999/xhtml#br> ];
                                                                                                  rdf:_20   [ rdf:type  <http://www.w3.org/1999/xhtml#br> ];
                                                                                                  rdf:_21   "&nbsp;juristische Personen des öffentlichen Rechts";
                                                                                                  rdf:_22   [ rdf:type  <http://www.w3.org/1999/xhtml#br> ];
                                                                                                  rdf:_23   "&nbsp;";
                                                                                                  rdf:_24   [ rdf:type  <http://www.w3.org/1999/xhtml#br> ];
                                                                                                  rdf:_25   "Erfüllt ein Ensemble oder eine Band die o. g. Antragsvoraussetzung nicht, weil sie kein e. V. oder „nur“ eine GbR sind, kann ein*e Kooperationspartner*in den Antrag stellen. Wichtig dabei ist, dass der*die Kooperationspartner*in eine gemeinnützige juristische Person und sich bewusst ist, dass er*sie Vertragspartner*in des BMCO wird. Das bedeutet auch, dass alle Zahlungen und die administrative Abwicklung über den*die Kooperationspartner*in laufen.";
                                                                                                  rdf:_26   [ rdf:type  <http://www.w3.org/1999/xhtml#br> ];
                                                                                                  rdf:_27   "&nbsp;";
                                                                                                  rdf:_28   [ rdf:type  <http://www.w3.org/1999/xhtml#br> ];
                                                                                                  rdf:_29   "Für kirchliche Ensembles (Kirchen-Chor, Kantorei, Singkreis, Posaunenchor, Bläserkreis, Cäcilienverein, etc.) sind Kirchengemeinden bzw. Pfarrgemeinden antragsberechtigt. Kirchenkreise, Dekanate oder Landeskirchen sowie Pfarrei-Verbände, Bistümer und Diözesen sind Kreis-/Landesverbänden gleichgestellt und können somit Anträge für überregionale Projekte stellen.";
                                                                                                  rdf:_3    [ rdf:type  <http://www.w3.org/1999/xhtml#strong>;
                                                                                                              rdf:_1    "Nicht antragsberechtigt für den AMF4 sind Organisationen, Verbände und Vereine, die bereits im AMF3 eine Förderung erhalten (haben).";
                                                                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                      "Nicht antragsberechtigt für den AMF4 sind Organisationen, Verbände und Vereine, die bereits im AMF3 eine Förderung erhalten (haben).";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "Nicht antragsberechtigt für den AMF4 sind Organisationen, Verbände und Vereine, die bereits im AMF3 eine Förderung erhalten (haben)."
                                                                                                            ];
                                                                                                  rdf:_4    [ rdf:type  <http://www.w3.org/1999/xhtml#br> ];
                                                                                                  rdf:_5    "&nbsp;";
                                                                                                  rdf:_6    [ rdf:type  <http://www.w3.org/1999/xhtml#br> ];
                                                                                                  rdf:_7    [ rdf:type  <http://www.w3.org/1999/xhtml#strong>;
                                                                                                              rdf:_1    "Antragsberechtigt sind:";
                                                                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                      "Antragsberechtigt sind:";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "Antragsberechtigt sind:"
                                                                                                            ];
                                                                                                  rdf:_8    [ rdf:type  <http://www.w3.org/1999/xhtml#br> ];
                                                                                                  rdf:_9    "&nbsp;gemeinnützige juristische Personen des privaten Rechts";
                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<strong>WER?</strong>\n<br>\n<strong>Nicht antragsberechtigt für den AMF4 sind Organisationen, Verbände und Vereine, die bereits im AMF3 eine Förderung erhalten (haben).</strong>\n<br>\n&nbsp;\n<br>\n<strong>Antragsberechtigt sind:</strong>\n<br>\n&nbsp;gemeinnützige juristische Personen des privaten Rechts\n<br>\n&nbsp;Körperschaften öffentlichen Rechts, sofern sie keine Gebietskörperschaften, Stiftungen des öffentlichen Rechts oder Anstalten des öffentlichen Rechts sind\n<br>\n&nbsp;\n<br>\n<strong>Nicht antragsberechtigt sind:</strong>\n<br>\n&nbsp;nicht eingetragene Vereine\n<br>\n&nbsp;GbRs oder Musikgruppen ohne Rechtsform\n<br>\n&nbsp;juristische Personen des öffentlichen Rechts\n<br>\n&nbsp;\n<br>\nErfüllt ein Ensemble oder eine Band die o. g. Antragsvoraussetzung nicht, weil sie kein e. V. oder „nur“ eine GbR sind, kann ein*e Kooperationspartner*in den Antrag stellen. Wichtig dabei ist, dass der*die Kooperationspartner*in eine gemeinnützige juristische Person und sich bewusst ist, dass er*sie Vertragspartner*in des BMCO wird. Das bedeutet auch, dass alle Zahlungen und die administrative Abwicklung über den*die Kooperationspartner*in laufen.\n<br>\n&nbsp;\n<br>\nFür kirchliche Ensembles (Kirchen-Chor, Kantorei, Singkreis, Posaunenchor, Bläserkreis, Cäcilienverein, etc.) sind Kirchengemeinden bzw. Pfarrgemeinden antragsberechtigt. Kirchenkreise, Dekanate oder Landeskirchen sowie Pfarrei-Verbände, Bistümer und Diözesen sind Kreis-/Landesverbänden gleichgestellt und können somit Anträge für überregionale Projekte stellen.";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "WER? Nicht antragsberechtigt für den AMF4 sind Organisationen, Verbände und Vereine, die bereits im AMF3 eine Förderung erhalten (haben). Antragsberechtigt sind: gemeinnützige juristische Personen des privaten Rechts Körperschaften öffentlichen Rechts, sofern sie keine Gebietskörperschaften, Stiftungen des öffentlichen Rechts oder Anstalten des öffentlichen Rechts sind Nicht antragsberechtigt sind: nicht eingetragene Vereine GbRs oder Musikgruppen ohne Rechtsform juristische Personen des öffentlichen Rechts Erfüllt ein Ensemble oder eine Band die o. g. Antragsvoraussetzung nicht, weil sie kein e. V. oder „nur“ eine GbR sind, kann ein*e Kooperationspartner*in den Antrag stellen. Wichtig dabei ist, dass der*die Kooperationspartner*in eine gemeinnützige juristische Person und sich bewusst ist, dass er*sie Vertragspartner*in des BMCO wird. Das bedeutet auch, dass alle Zahlungen und die administrative Abwicklung über den*die Kooperationspartner*in laufen. Für kirchliche Ensembles (Kirchen-Chor, Kantorei, Singkreis, Posaunenchor, Bläserkreis, Cäcilienverein, etc.) sind Kirchengemeinden bzw. Pfarrgemeinden antragsberechtigt. Kirchenkreise, Dekanate oder Landeskirchen sowie Pfarrei-Verbände, Bistümer und Diözesen sind Kreis-/Landesverbänden gleichgestellt und können somit Anträge für überregionale Projekte stellen."
                                                                                                ];
                                                                                      rdf:_2    [ rdf:type  <http://www.w3.org/1999/xhtml#p>;
                                                                                                  rdf:_1    "Gefördert werden Projekte, durch die ein Verein oder Verband neue Wege geht, sich neu aufstellt, sich für die Zukunft wappnet oder besondere künstlerische Projekte auf die Bühne bringt (mehr dazu siehe unten). Die Projekte sollen dabei einen Modellcharakter für die gesamte Amateurmusikszene haben und weitreichend sichtbar sein.";
                                                                                                  rdf:_2    [ rdf:type  <http://www.w3.org/1999/xhtml#br> ];
                                                                                                  rdf:_3    "&nbsp;";
                                                                                                  rdf:_4    [ rdf:type  <http://www.w3.org/1999/xhtml#br> ];
                                                                                                  rdf:_5    "&nbsp;Die Projekte müssen sich mindestens einem der folgenden Schwerpunkte widmen:&nbsp;";
                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "Gefördert werden Projekte, durch die ein Verein oder Verband neue Wege geht, sich neu aufstellt, sich für die Zukunft wappnet oder besondere künstlerische Projekte auf die Bühne bringt (mehr dazu siehe unten). Die Projekte sollen dabei einen Modellcharakter für die gesamte Amateurmusikszene haben und weitreichend sichtbar sein.\n<br>\n&nbsp;\n<br>\n&nbsp;Die Projekte müssen sich mindestens einem der folgenden Schwerpunkte widmen:&nbsp;";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Gefördert werden Projekte, durch die ein Verein oder Verband neue Wege geht, sich neu aufstellt, sich für die Zukunft wappnet oder besondere künstlerische Projekte auf die Bühne bringt (mehr dazu siehe unten). Die Projekte sollen dabei einen Modellcharakter für die gesamte Amateurmusikszene haben und weitreichend sichtbar sein. Die Projekte müssen sich mindestens einem der folgenden Schwerpunkte widmen:"
                                                                                                ];
