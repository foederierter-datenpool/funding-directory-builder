                                                                                                          "<li><a href=\"https://bundesmusikverband.de/amateurmusikfonds/\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Link zum Programm</a></li>\n<li><a href=\"https://www.cognitoforms.com/BMCO2/AmateurmusikfondsAMF4\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Antragsportal</a></li>";
