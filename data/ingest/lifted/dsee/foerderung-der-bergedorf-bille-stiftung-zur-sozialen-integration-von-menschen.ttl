    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/2533-bergedorf-bille-stiftung-zur-sozialen-integration-von-menschen\" class=\"link\">Bergedorf-Bille-Stiftung zur sozialen Integration von Menschen</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Bergedorfer Straße 100,\n     <br>\n     21029 Hamburg</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:stiftung@bergedorf-bille.de\">stiftung@bergedorf-bille.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.bergedorf-bille-stiftung.de\" target=\"_blank\">www.bergedorf-bille-stiftung.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>040 72 56 00489</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Bergedorf-Bille-Stiftung zur sozialen Integration von Menschen Bergedorfer Straße 100, 21029 Hamburg E-Mail stiftung@bergedorf-bille.de Webseite www.bergedorf-bille-stiftung.de Telefon 040 72 56 00489".
