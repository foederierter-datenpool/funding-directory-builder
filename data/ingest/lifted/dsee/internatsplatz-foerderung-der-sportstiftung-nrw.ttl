    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1910-sportstiftung-nrw-nordrhein-westfaelische-stiftung-zur-nachwuchsfoerderung-im-leistungssport\" class=\"link\">Sportstiftung NRW – Nordrhein-westfälische Stiftung zur Nachwuchsförderung im Leistungssport</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Am Sportpark Müngersdorf 6, IG II,\n     <br>\n     50933 Köln</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@sportstiftung-nrw.de\">info@sportstiftung-nrw.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.sportstiftung-nrw.de\" target=\"_blank\">www.sportstiftung-nrw.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0221 49826025</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/SpSt-Logo-2farb-HKS-38.jpg\" width=\"800\" height=\"379\">\n </div>\n</div>";
