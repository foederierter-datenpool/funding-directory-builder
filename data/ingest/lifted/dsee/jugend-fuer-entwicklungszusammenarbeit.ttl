    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/21384-stiftung-nord-sued-bruecken\" class=\"link\">Stiftung Nord-Süd-Brücken</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Greifswalder Straße 33a,\n     <br>\n     10405 Berlin</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@nord-sued-bruecken.de\">info@nord-sued-bruecken.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.nord-sued-bruecken.de/\" target=\"_blank\">www.nord-sued-bruecken.de/</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>030 - 42 85 13 85</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Stiftung Nord-Süd-Brücken Greifswalder Straße 33a, 10405 Berlin E-Mail info@nord-sued-bruecken.de Webseite www.nord-sued-bruecken.de/ Telefon 030 - 42 85 13 85".
