    <https://html.spec.whatwg.org/#innerHTML> "<h1 class=\"col-span-2 font-bold text-2xl\">Investitionsförderung</h1>";
    <https://html.spec.whatwg.org/#innerText> "Investitionsförderung".
_:n3-255590 a <http://www.w3.org/1999/xhtml#h1>;
    rdf:_1 "Investitionsförderung";
    <http://www.w3.org/1999/xhtml#class> "col-span-2 font-bold text-2xl";
