sizes=\"16x16\" href=\"/favicon-16x16.png\">\n<script type=\"module\">!function(){const e=document.createElement(\"link\").relList;if(!(e&&e.supports&&e.supports(\"modulepreload\"))){for(const e of document.querySelectorAll('link[rel=\"modulepreload\"]'))r(e);new MutationObserver((e=>{for(const o of e)if(\"childList\"===o.type)for(const e of o.addedNodes)if(\"LINK\"===e.tagName&&\"modulepreload\"===e.rel)r(e);else if(e.querySelectorAll)for(const o of e.querySelectorAll(\"link[rel=modulepreload]\"))r(o)})).observe(document,{childList:!0,subtree:!0})}function r(e){if(e.ep)return;e.ep=!0;const r=function(e){const r={};return e.integrity&&(r.integrity=e.integrity),e.referrerpolicy&&(r.referrerPolicy=e.referrerpolicy),\"use-credentials\"===e.crossorigin?r.credentials=\"include\":\"anonymous\"===e.crossorigin?r.credentials=\"omit\":r.credentials=\"same-origin\",r}(e);fetch(e.href,r)}}();</script>\n<script type=\"module\" src=\"https://foerderdatenbank.d-s-e-e.de/dist/assets/app-DB5ScF6h.js\" crossorigin onload=\"e=new CustomEvent('vite-script-loaded', {detail:{path: 'resources/js/main.js'}});document.dispatchEvent(e);\"></script>\n<link href=\"https://foerderdatenbank.d-s-e-e.de/dist/assets/app-ClfkFxNO.css\" rel=\"stylesheet\"> \n<div class=\"container flex flex-row justify-end my-4\">\n <div class=\"flex flex-row flex-wrap items-center -mx-1 select-none cursor-default\">\n  <nav class=\"flex flex-row my-2\">\n   <a class=\"block mr-2 md:mr-6 p-1 opacity-70 hover:opacity-100 focus:opacity-100 transition-opacity\" href=\"https://www.deutsche-stiftung-engagement-und-ehrenamt.de/newsletter/\">Newsletter</a>\n  </nav>\n  <div class=\"flex flex-row divide-x my-2\">\n   <a href=\"https://x.com/d_s_e_e\" title=\"X\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-x.svg\" width=\"24\" height=\"24\" alt=\"Logo X\"> <span class=\"sr-only\">X</span> </a><a href=\"https://www.facebook.com/EngagementStiftung/\" title=\"Facebook\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-facebook.svg\" width=\"24\" height=\"24\" alt=\"Logo Facebook\"> <span class=\"sr-only\">Facebook</span> </a> <a href=\"https://www.instagram.com/engagement_und_ehrenamt/\" title=\"Instagram\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-instagram.svg\" width=\"24\" height=\"24\" alt=\"Logo Instagram\"> <span class=\"sr-only\">Instagram</span> </a> <a href=\"https://www.linkedin.com/company/dsee/\" title=\"LinkedIn\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-linkedin.svg\" width=\"24\" height=\"24\" alt=\"Logo LinkedIn\"> <span class=\"sr-only\">LinkedIn</span> </a>\n  </div>\n </div>\n</div>\n<header class=\"container my-4 flex flex-row flex-wrap justify-between items-end select-none cursor-default\">\n <a href=\"https://foerderdatenbank.d-s-e-e.de/\" class=\"block my-2 w-full max-w-md\"> <span class=\"sr-only\">Zur Startseite</span><img src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/2023_DSEE_Logo_3zlg_RGB_Basis_large.svg\" width=\"300\" height=\"92\" alt=\"Logo Deutsche Stiftung für Engagement und Ehrenamt\" fetchpriority=\"high\"></a>\n <p class=\"my-2 font-medium text-2xl\">Förderdatenbank der DSEE</p>\n</header>\n<main class=\"my-8\">\n <nav class=\"container\">\n  <div class=\"my-8 py-3 border-t-2 border-gray select-none cursor-default\">\n   <a class=\"link\" href=\"https://foerderdatenbank.d-s-e-e.de/\">Förderdatenbank der DSEE</a><span class=\"px-1 text-gray\">&gt;</span><span>Förderung der Stiftung der Sparkasse Mecklenburg-Schwerin für die Region Ludwigslust/Hagenow</span>\n  </div>\n </nav>\n <article class=\"container\">\n  <div class=\"grid lg:grid-cols-3 gap-16\">\n   <div class=\"col-span-2 space-y-4\">\n    <header class=\"mb-8\">\n     <h1 class=\"col-span-2 font-bold text-2xl\">Förderung der Stiftung der Sparkasse Mecklenburg-Schwerin für die Region Ludwigslust/Hagenow</h1>\n    </header>\n    <div class=\"prose text-lg mb-8 space-y-6\">\n     <div>\n      <p>Die Stiftung der Sparkasse Mecklenburg-Schwerin für die Region Ludwigslust/&nbsp;Hagenow ist Ausdruck des öffentlichen Engagements&nbsp;der Sparkasse Mecklenburg-Schwerin und ihrer&nbsp;Verantwortung für das Gemeinwohl der Region.&nbsp;</p>\n      <p>Sie fördert entsprechend ihrem&nbsp;satzungsmäßigen Auftrag Vorhaben, die ausschließlich und unmittelbar gemeinnützigen&nbsp;Zwecken dienen. Die Gemeinnützigkeit des Projektträgers muss nachgewiesen werden.\n       <br></p>\n     </div>\n     <div>\n      <h3>Zielgruppen/Bedingungen</h3>\n      <p>Gefördert werden:&nbsp;\n       <br></p>\n      <p>Projekte in der Region Ludwigslust/Hagenow in den Bereichen:</p>\n      <ul>\n       <li>Jugendhilfe</li>\n       <li>Kunst und Kultur</li>\n       <li>Denkmalschutz und Denkmalpflege</li>\n       <li>Naturschutz und Landschaftspflege</li>\n       <li>Sport</li>\n       <li>Heimatpflege und Heimatkunde</li>\n      </ul>\n      <p>Förderfähig sind&nbsp;alle Institutionen und Vereine,&nbsp;die eine Zuwendungsbestätigung ausstellen dürfen\n       <br></p>\n      <p>Projekte können dann unterstützt werden, wenn sie den Förderleitlinien und der Förderkonzeption der Stiftung entsprechen.&nbsp;An die geförderten Projekte wird generell der Anspruch hoher Qualität und herausragender Bedeutung gestellt. Sie sollen einen Bezug zum Fördergebiet haben oder kennzeichnend für eine dieser Kommunen sein.</p>\n      <p>Von der Förderung ausgeschlossen sind:&nbsp;\n       <br></p>\n      <p>• Kommerzielle Einrichtungen und Veranstaltungen</p>\n      <p>• grundsätzlich bereits begonnene/abgeschlossene Projekte</p>\n      <p>• Allgemeine, laufende Kosten</p>\n      <p>• lfd. Personalkosten\n       <br></p>\n      <p>Antragsberechtigt sind juristische Personen, die vom zuständigen Finanzamt als gemeinnützig anerkannt sind.\n       <br></p>\n     </div>\n     <div>\n      <h3>Hinweise zur Antragstellung/Bewerbung</h3>\n      <p>Die Antragstellung erfolgt grundsätzlich über denk angegebenen Link&nbsp;zum Förderantrag.</p>\n      <p>Die Antragsinhalte sollen der Stiftung ein klares Bild des Vorhabens vermitteln und die für die Entscheidung notwendigen Angaben enthalten (Konzept, Kosten- und Finanzierungsplan sowie einen gültigen Freistellungsbescheid vom Finanzamt).</p>\n      <p>Förderanträge werden erst behandelt, wenn die vollständigen Unterlagen vorliegen.</p>\n     </div>\n     <div>\n      <h3>Weitere Informationen</h3>\n      <ul>\n       <li><a href=\"https://www.sparkasse-mecklenburg-schwerin.de/de/home/ihre-sparkasse/foerderengagement/unsere-stiftungen.html\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Link zur Stiftung</a></li>\n       <li><a href=\"https://spk-m-sn.mpro-sparkasse.de/p/engagement\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Link zum Förderantrag</a></li>\n      </ul>\n     </div>\n    </div>\n   </div>\n   <aside>\n    <div class=\"prose text-lg space-y-4\">\n     <div>\n      <div class=\"font-bold\">Regionen:</div>\n      <div>\n       <ul>\n        <li>Mecklenburg-Vorpommern</li>\n       </ul>\n      </div>\n     </div>\n     <div>\n      <div class=\"font-bold\">Engagementbereiche:</div>\n      <div>\n       <ul>\n        <li>Bauten und Denkmalschutz</li>\n        <li>Kinder und Jugendliche</li>\n        <li>Kultur, Medien und Musik</li>\n        <li>Sport und Bewegung</li>\n       </ul>\n      </div>\n     </div>\n     <div>\n      <div class=\"font-bold\">Eigenmittel benötigt:</div>\n      <div>Ja</div>\n     </div>\n     <div>\n      <div class=\"font-bold\">Bewerbungsfrist:</div>\n      <div class=\"mb-1\">\n       <ul>\n        <li>28. Februar 2027</li>\n        <li>31. August 2027</li>\n       </ul>\n      </div>\n      <div class=\"prose text-base\">\n       <ul>\n        <li>Anträge bis zum 28. Februar&nbsp;für Vorhaben im II. Halbjahr des laufenden Jahres und</li>\n        <li>Anträge bis zum 31. August&nbsp;für Vorhaben im I. Halbjahr des Folgejahres\n         <br></li>\n       </ul>\n       <p>\n        <br>\n       </p>\n      </div>\n     </div>\n     <div>\n      <div class=\"font-bold\">Vorzeitiger Maßnahmebeginn:</div>\n      <div>Nein</div>\n     </div>\n    </div>\n   </aside>\n  </div>\n  <div class=\"px-5 py-3 border-2 rounded-lg mt-16 px-6 py-6 border-gray\">\n   <div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n    <div class=\"grow\">\n     <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/890-stiftung-der-sparkasse-mecklenburg-schwerin-fuer-die-region-ludwigslust-hagenow\" class=\"link\">Stiftung der Sparkasse Mecklenburg-Schwerin für die Region Ludwigslust/Hagenow</a></h2>\n     <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n      <div>\n       <p>Marienplatz 9,\n        <br>\n        19053 Schwerin</p>\n      </div>\n      <div>\n       <h3 class=\"font-bold\">E-Mail</h3>\n       <p><a href=\"mailto:info@spk-m-sn.de\">info@spk-m-sn.de</a></p>\n      </div>\n      <div>\n       <h3 class=\"font-bold\">Webseite</h3>\n       <p><a href=\"https://www.sparkasse-mecklenburg-schwerin.de/de/home/ihre-sparkasse/foerderengagement/unsere-stiftungen.html\" target=\"_blank\">www.sparkasse-mecklenburg-schwerin.de/de/home/ihre-sparkasse/foerderengagement/unsere-stiftungen.html</a></p>\n      </div>\n      <div>\n       <h3 class=\"font-bold\">Telefon</h3>\n       <p>0385 5512222</p>\n      </div>\n     </div>\n    </div>\n    <div class=\"md:w-1/3\">\n     <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Stiftung-Mecklenburg-Schwerin_2.gif\" width=\"800\" height=\"327\">\n    </div>\n   </div>\n  </div>\n </article>\n</main>\n<footer class=\"container mt-24\">\n <div class=\"flex flex-row flex-wrap justify-between items-center py-12 border-t-2 border-yellow select-none cursor-default\">\n  <nav class=\"flex flex-row flex-wrap -mx-1\">\n   <p class=\"mr-6 p-1 opacity-70\">©2026</p>\n   <a class=\"block mr-6 p-1 opacity-70 hover:opacity-100 focus:opacity-100 transition-opacity\" href=\"https://foerderdatenbank.d-s-e-e.de/impressum\">Impressum</a><a class=\"block mr-6 p-1 opacity-70 hover:opacity-100 focus:opacity-100 transition-opacity\" href=\"https://www.deutsche-stiftung-engagement-und-ehrenamt.de/datenschutzerklaerung/\">Datenschutzerklärung</a>\n  </nav>\n  <div class=\"max-w-[240px]\">\n   <img src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/2023_DSEE_Logo_3zlg_RGB_Basis_large.svg\" width=\"300\" height=\"92\" alt=\"Logo Deutsche Stiftung für Engagement und Ehrenamt\">\n  </div>\n </div>\n</footer>\n<script>\n  var _paq = window._paq = window._paq || [];\n  /* tracker methods like \"setCustomDimension\" should be called before \"trackPageView\" */\n  _paq.push(['trackPageView']);\n  _paq.push(['enableLinkTracking']);\n  (function() {\n    var u=\"//matomo.deutsche-stiftung-engagement-und-ehrenamt.de/\";\n    _paq.push(['setTrackerUrl', u+'matomo.php']);\n    _paq.push(['setSiteId', '4']);\n    var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];\n    g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);\n  })();\n</script>";
    <https://html.spec.whatwg.org/#innerText> "Förderung der Stiftung der Sparkasse Mecklenburg-Schwerin für die Region Ludwigslust/Hagenow  –  Förderdatenbank Newsletter X Facebook Instagram LinkedIn Zur Startseite Förderdatenbank der DSEE Förderdatenbank der DSEE>Förderung der Stiftung der Sparkasse Mecklenburg-Schwerin für die Region Ludwigslust/Hagenow Förderung der Stiftung der Sparkasse Mecklenburg-Schwerin für die Region Ludwigslust/Hagenow Die Stiftung der Sparkasse Mecklenburg-Schwerin für die Region Ludwigslust/ Hagenow ist Ausdruck des öffentlichen Engagements der Sparkasse Mecklenburg-Schwerin und ihrer Verantwortung für das Gemeinwohl der Region. Sie fördert entsprechend ihrem satzungsmäßigen Auftrag Vorhaben, die ausschließlich und unmittelbar gemeinnützigen Zwecken dienen. Die Gemeinnützigkeit des Projektträgers muss nachgewiesen werden. Zielgruppen/Bedingungen Gefördert werden: Projekte in der Region Ludwigslust/Hagenow in den Bereichen: Jugendhilfe Kunst und Kultur Denkmalschutz und Denkmalpflege Naturschutz und Landschaftspflege Sport Heimatpflege und Heimatkunde Förderfähig sind alle Institutionen und Vereine, die eine Zuwendungsbestätigung ausstellen dürfen Projekte können dann unterstützt werden, wenn sie den Förderleitlinien und der Förderkonzeption der Stiftung entsprechen. An die geförderten Projekte wird generell der Anspruch hoher Qualität und herausragender Bedeutung gestellt. Sie sollen einen Bezug zum Fördergebiet haben oder kennzeichnend für eine dieser Kommunen sein. Von der Förderung ausgeschlossen sind: • Kommerzielle Einrichtungen und Veranstaltungen • grundsätzlich bereits begonnene/abgeschlossene Projekte • Allgemeine, laufende Kosten • lfd. Personalkosten Antragsberechtigt sind juristische Personen, die vom zuständigen Finanzamt als gemeinnützig anerkannt sind. Hinweise zur Antragstellung/Bewerbung Die Antragstellung erfolgt grundsätzlich über denk angegebenen Link zum Förderantrag. Die Antragsinhalte sollen der Stiftung ein klares Bild des Vorhabens vermitteln und die für die Entscheidung notwendigen Angaben enthalten (Konzept, Kosten- und Finanzierungsplan sowie einen gültigen Freistellungsbescheid vom Finanzamt). Förderanträge werden erst behandelt, wenn die vollständigen Unterlagen vorliegen. Weitere Informationen Link zur Stiftung Link zum Förderantrag Regionen: Mecklenburg-Vorpommern Engagementbereiche: Bauten und Denkmalschutz Kinder und Jugendliche Kultur, Medien und Musik Sport und Bewegung Eigenmittel benötigt: Ja Bewerbungsfrist: 28. Februar 2027 31. August 2027 Anträge bis zum 28. Februar für Vorhaben im II. Halbjahr des laufenden Jahres und Anträge bis zum 31. August für Vorhaben im I. Halbjahr des Folgejahres Vorzeitiger Maßnahmebeginn: Nein Stiftung der Sparkasse Mecklenburg-Schwerin für die Region Ludwigslust/Hagenow Marienplatz 9, 19053 Schwerin E-Mail info@spk-m-sn.de Webseite www.sparkasse-mecklenburg-schwerin.de/de/home/ihre-sparkasse/foerderengagement/unsere-stiftungen.html Telefon 0385 5512222 ©2026 Impressum Datenschutzerklärung".
