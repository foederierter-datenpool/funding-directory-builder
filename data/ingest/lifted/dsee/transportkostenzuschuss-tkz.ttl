    <https://html.spec.whatwg.org/#innerHTML> "<h1 class=\"col-span-2 font-bold text-2xl\">Transportkostenzuschuss (TKZ)</h1>\n<p class=\"text-lg text-gray-500\">Ein Förderprogramm von \"Engagement global\"</p>";
    <https://html.spec.whatwg.org/#innerText> "Transportkostenzuschuss (TKZ) Ein Förderprogramm von \"Engagement global\"".
_:n3-273640 a <http://www.w3.org/1999/xhtml#h1>;
