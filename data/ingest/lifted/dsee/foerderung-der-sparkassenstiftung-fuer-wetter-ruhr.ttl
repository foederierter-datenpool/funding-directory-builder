    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1934-sparkassenstiftung-fuer-wetter-ruhr\" class=\"link\">Sparkassenstiftung für Wetter (Ruhr)</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Kaiserstraße 78,\n     <br>\n     58300 Wetter (Ruhr)</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:stiftung@sparkasse-en.de\">stiftung@sparkasse-en.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.sparkasse-wetter.de\" target=\"_blank\">www.sparkasse-wetter.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>02332 7021201</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Sparkassenstiftung-für-Wetter-Ruhr.jpg\" width=\"800\" height=\"333\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Sparkassenstiftung für Wetter (Ruhr) Kaiserstraße 78, 58300 Wetter (Ruhr) E-Mail stiftung@sparkasse-en.de Webseite www.sparkasse-wetter.de Telefon 02332 7021201".
