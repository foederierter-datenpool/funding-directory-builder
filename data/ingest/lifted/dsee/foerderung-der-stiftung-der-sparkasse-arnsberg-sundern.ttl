    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/2492-stiftung-der-sparkasse-arnsberg-sundern\" class=\"link\">Stiftung der Sparkasse Arnsberg-Sundern</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Hauptstraße 10–12,\n     <br>\n     59755 Arnsberg</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:stiftung@sparkasse-arnsberg-sundern.de\">stiftung@sparkasse-arnsberg-sundern.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://stiftung-spk-arnsberg-sundern.de/\" target=\"_blank\">stiftung-spk-arnsberg-sundern.de/</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>02932 9109523</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Stiftung der Sparkasse Arnsberg-Sundern Hauptstraße 10–12, 59755 Arnsberg E-Mail stiftung@sparkasse-arnsberg-sundern.de Webseite stiftung-spk-arnsberg-sundern.de/ Telefon 02932 9109523".
