    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/2897-buergerstiftung-muelheim-an-der-ruhr\" class=\"link\">Bürgerstiftung Mülheim an der Ruhr</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Am Schloß Broich 1 - 3 (RWW-Gebäude),\n     <br>\n     45479 Mülheim an der Ruhr</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@buergerstiftung-muelheim.de\">info@buergerstiftung-muelheim.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.buergerstiftung-muelheim.de\" target=\"_blank\">www.buergerstiftung-muelheim.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0208 4433262</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Bürgerstiftung Mülheim an der Ruhr Am Schloß Broich 1 - 3 (RWW-Gebäude), 45479 Mülheim an der Ruhr E-Mail info@buergerstiftung-muelheim.de Webseite www.buergerstiftung-muelheim.de Telefon 0208 4433262".
