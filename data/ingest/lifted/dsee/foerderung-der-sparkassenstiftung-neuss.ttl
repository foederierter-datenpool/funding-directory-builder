    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1925-sparkassenstiftung-neuss\" class=\"link\">Sparkassenstiftung Neuss</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Oberstraße 110–124,\n     <br>\n     41460 Neuss</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:kommunikation@sparkasse-neuss.de\">kommunikation@sparkasse-neuss.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.sparkasse-neuss.de\" target=\"_blank\">www.sparkasse-neuss.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>02131 971090</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Sparkassenstiftung-Neuss.png\" width=\"800\" height=\"800\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Sparkassenstiftung Neuss Oberstraße 110–124, 41460 Neuss E-Mail kommunikation@sparkasse-neuss.de Webseite www.sparkasse-neuss.de Telefon 02131 971090".
_:n3-198646 a <http://www.w3.org/1999/xhtml#div>;
