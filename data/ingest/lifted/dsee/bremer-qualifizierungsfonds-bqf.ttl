                                                                          <https://html.spec.whatwg.org/#innerHTML>
                                                                                  "<h1 class=\"col-span-2 font-bold text-2xl\">Bremer Qualifizierungsfonds (BQF)</h1>\n<p class=\"text-lg text-gray-500\">Fördermittel für Weiterbildungsmaßnahmen von Ehrenamtlichen sowie Hauptamtlichen in gemeinnützigen Organisationen</p>";
