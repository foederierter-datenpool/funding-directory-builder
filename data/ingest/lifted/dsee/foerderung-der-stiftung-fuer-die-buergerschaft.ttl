    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/2369-stiftung-fuer-die-buergerschaft\" class=\"link\">Stiftung für die Bürgerschaft (Freiburg im Breisgau)</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Kaiser-Joseph-Str. 186-190,\n     <br>\n     79098 Freiburg im Breisgau</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:ge@sparkasse-freiburg.de\">ge@sparkasse-freiburg.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.stiftung-fuer-die-buergerschaft.de\" target=\"_blank\">www.stiftung-fuer-die-buergerschaft.de</a></p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Stiftung für die Bürgerschaft (Freiburg im Breisgau) Kaiser-Joseph-Str. 186-190, 79098 Freiburg im Breisgau E-Mail ge@sparkasse-freiburg.de Webseite www.stiftung-fuer-die-buergerschaft.de".
