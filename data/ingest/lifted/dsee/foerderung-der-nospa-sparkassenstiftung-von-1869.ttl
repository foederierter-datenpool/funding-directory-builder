_:n3-211568 a <http://www.w3.org/1999/xhtml#h1>;
    rdf:_1 "Förderung der Nospa Sparkassenstiftung von 1869";
    <http://www.w3.org/1999/xhtml#class> "col-span-2 font-bold text-2xl";
    <https://html.spec.whatwg.org/#innerHTML> "Förderung der Nospa Sparkassenstiftung von 1869";
