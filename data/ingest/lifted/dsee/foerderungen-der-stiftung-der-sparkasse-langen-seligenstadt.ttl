_:n3-248986 a <http://www.w3.org/1999/xhtml#h1>;
    rdf:_1 "Förderungen der Stiftung der Sparkasse Langen-Seligenstadt";
    <http://www.w3.org/1999/xhtml#class> "col-span-2 font-bold text-2xl";
    <https://html.spec.whatwg.org/#innerHTML> "Förderungen der Stiftung der Sparkasse Langen-Seligenstadt";
