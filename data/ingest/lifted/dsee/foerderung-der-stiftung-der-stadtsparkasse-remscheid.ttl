    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1880-stiftung-der-stadtsparkasse-remscheid\" class=\"link\">Stiftung der Stadtsparkasse Remscheid</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Alleestraße 76–88,\n     <br>\n     42853 Remscheid</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:spenden@stadtsparkasse-remscheid.de\">spenden@stadtsparkasse-remscheid.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.stadtsparkasse-remscheid.de/de/home/ihre-sparkasse/stiftung-und-spenden.html\" target=\"_blank\">www.stadtsparkasse-remscheid.de/de/home/ihre-sparkasse/stiftung-und-spenden.html</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>02191 1660</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Stiftung-der-Stadtsparkasse-Remscheid.jpg\" width=\"800\" height=\"82\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Stiftung der Stadtsparkasse Remscheid Alleestraße 76–88, 42853 Remscheid E-Mail spenden@stadtsparkasse-remscheid.de Webseite www.stadtsparkasse-remscheid.de/de/home/ihre-sparkasse/stiftung-und-spenden.html Telefon 02191 1660".
