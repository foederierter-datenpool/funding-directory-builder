                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<li><a href=\"https://landwirtschaft.hessen.de/heimat/brauchtumsfoerderung\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Link zum Programm</a></li>\n<li><a href=\"https://landwirtschaft.hessen.de/sites/landwirtschaft.hessen.de/files/2026-06/brauchtumsrichtlinie.pdf\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Förderrichtlinie (Download)</a></li>";
