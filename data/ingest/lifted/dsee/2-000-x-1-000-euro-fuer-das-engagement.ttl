    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/21038-landesservicestelle-fuer-buergerschaftliches-engagement\" class=\"link\">Landesservicestelle für bürgerschaftliches Engagement</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:LandesservicestelleBE@stk.nrw.de\">LandesservicestelleBE@stk.nrw.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.engagiert-in-nrw.de/\" target=\"_blank\">www.engagiert-in-nrw.de/</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0211 837-1677</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Landesservicestelle für bürgerschaftliches Engagement E-Mail LandesservicestelleBE@stk.nrw.de Webseite www.engagiert-in-nrw.de/ Telefon 0211 837-1677".
