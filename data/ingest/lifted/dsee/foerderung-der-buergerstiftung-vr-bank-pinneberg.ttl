    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/914-buergerstiftung-vr-bank-pinneberg\" class=\"link\">Bürgerstiftung VR Bank Pinneberg</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Bismarckstraße 11–13,\n     <br>\n     25421 Pinneberg</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:buergerstiftung@vrbank-ih.de\">buergerstiftung@vrbank-ih.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.stiftung-vrbank-in-holstein.de/homepage.html\" target=\"_blank\">www.stiftung-vrbank-in-holstein.de/homepage.html</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>04101 501 1189</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Bürgestiftung-VR-Bank-Pinneberg.jpg\" width=\"798\" height=\"199\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Bürgerstiftung VR Bank Pinneberg Bismarckstraße 11–13, 25421 Pinneberg E-Mail buergerstiftung@vrbank-ih.de Webseite www.stiftung-vrbank-in-holstein.de/homepage.html Telefon 04101 501 1189".
