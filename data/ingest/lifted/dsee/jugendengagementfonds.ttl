    <https://html.spec.whatwg.org/#innerHTML> "eigenen Projektidee in Ostdeutschland";
    <https://html.spec.whatwg.org/#innerText> "eigenen Projektidee in Ostdeutschland".
_:n3-252384 a <http://www.w3.org/1999/xhtml#strong>;
