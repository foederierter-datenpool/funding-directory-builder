    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1750-buergerstiftung-coesfeld\" class=\"link\">Bürgerstiftung Coesfeld</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Münsterstraße 5,\n     <br>\n     48653 Coesfeld</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@buergerstiftung-coesfeld.de\">info@buergerstiftung-coesfeld.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.buergerstiftung-coesfeld.de\" target=\"_blank\">www.buergerstiftung-coesfeld.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>+492541 9322187</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Bürgerstiftung-Coesfeld.png\" width=\"800\" height=\"356\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Bürgerstiftung Coesfeld Münsterstraße 5, 48653 Coesfeld E-Mail info@buergerstiftung-coesfeld.de Webseite www.buergerstiftung-coesfeld.de Telefon +492541 9322187".
