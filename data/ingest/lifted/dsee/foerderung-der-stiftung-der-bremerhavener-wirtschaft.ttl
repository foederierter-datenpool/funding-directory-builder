    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/795-stiftung-der-bremerhavener-wirtschaft\" class=\"link\">Stiftung der Bremerhavener Wirtschaft</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Friedrich-Ebert-Straße 6,\n     <br>\n     27505 Bremerhaven</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@stiftung-wirtschaft-bremerhaven.de\">info@stiftung-wirtschaft-bremerhaven.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://stiftung-wirtschaft-bremerhaven.de/\" target=\"_blank\">stiftung-wirtschaft-bremerhaven.de/</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0471 92460366</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Stiftung-der-Bremerhavener-Wirtschaft.jpg\" width=\"800\" height=\"290\">\n </div>\n</div>";
