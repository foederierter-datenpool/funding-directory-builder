    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1685-bonner-universitaetsstiftung\" class=\"link\">Bonner Universitätsstiftung</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Dechenstraße 3-11,\n     <br>\n     53115 Bonn</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:stiftung@uni-bonn.de\">stiftung@uni-bonn.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.stiftung.uni-bonn.de\" target=\"_blank\">www.stiftung.uni-bonn.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0228 731837</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Bonner-Universitätsstiftung.png\" width=\"800\" height=\"1361\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Bonner Universitätsstiftung Dechenstraße 3-11, 53115 Bonn E-Mail stiftung@uni-bonn.de Webseite www.stiftung.uni-bonn.de Telefon 0228 731837".
