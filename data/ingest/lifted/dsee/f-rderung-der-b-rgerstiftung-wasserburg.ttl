    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1275-buergerstiftung-wasserburg\" class=\"link\">Bürgerstiftung Wasserburg</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Hattnau 34,\n     <br>\n     88142 Wasserburg (Bodensee)</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@buergerstiftung-wasserburg.de\">info@buergerstiftung-wasserburg.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.buergerstiftung-wasserburg.de\" target=\"_blank\">www.buergerstiftung-wasserburg.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>08382 888410</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Bürgerstiftung-Wasserburg.png\" width=\"800\" height=\"343\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Bürgerstiftung Wasserburg Hattnau 34, 88142 Wasserburg (Bodensee) E-Mail info@buergerstiftung-wasserburg.de Webseite www.buergerstiftung-wasserburg.de Telefon 08382 888410".
