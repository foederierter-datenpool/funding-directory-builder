_:n3-192804 a <http://www.w3.org/1999/xhtml#h1>;
    rdf:_1 "Förderung der Elisabeth Spitalfonds";
    <http://www.w3.org/1999/xhtml#class> "col-span-2 font-bold text-2xl";
    <https://html.spec.whatwg.org/#innerHTML> "Förderung der Elisabeth Spitalfonds";
