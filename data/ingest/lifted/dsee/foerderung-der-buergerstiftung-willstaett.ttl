    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1236-buergerstiftung-willstaett\" class=\"link\">Bürgerstiftung Willstätt</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Am Mühlplatz 1,\n     <br>\n     77731 Willstätt</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:gemeinde@willstaett.de\">gemeinde@willstaett.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.buergerstiftung-willstaett.de\" target=\"_blank\">www.buergerstiftung-willstaett.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>07852 430</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Bürgerstiftung-Willstätt.jpg\" width=\"800\" height=\"570\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Bürgerstiftung Willstätt Am Mühlplatz 1, 77731 Willstätt E-Mail gemeinde@willstaett.de Webseite www.buergerstiftung-willstaett.de Telefon 07852 430".
