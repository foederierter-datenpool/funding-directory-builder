e-e.de/volumes/public/icon-facebook.svg\" width=\"24\" height=\"24\" alt=\"Logo Facebook\"> <span class=\"sr-only\">Facebook</span> </a> <a href=\"https://www.instagram.com/engagement_und_ehrenamt/\" title=\"Instagram\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-instagram.svg\" width=\"24\" height=\"24\" alt=\"Logo Instagram\"> <span class=\"sr-only\">Instagram</span> </a> <a href=\"https://www.linkedin.com/company/dsee/\" title=\"LinkedIn\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-linkedin.svg\" width=\"24\" height=\"24\" alt=\"Logo LinkedIn\"> <span class=\"sr-only\">LinkedIn</span> </a>\n  </div>\n </div>\n</div>\n<header class=\"container my-4 flex flex-row flex-wrap justify-between items-end select-none cursor-default\">\n <a href=\"https://foerderdatenbank.d-s-e-e.de/\" class=\"block my-2 w-full max-w-md\"> <span class=\"sr-only\">Zur Startseite</span><img src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/2023_DSEE_Logo_3zlg_RGB_Basis_large.svg\" width=\"300\" height=\"92\" alt=\"Logo Deutsche Stiftung für Engagement und Ehrenamt\" fetchpriority=\"high\"></a>\n <p class=\"my-2 font-medium text-2xl\">Förderdatenbank der DSEE</p>\n</header>\n<main class=\"my-8\">\n <nav class=\"container\">\n  <div class=\"my-8 py-3 border-t-2 border-gray select-none cursor-default\">\n   <a class=\"link\" href=\"https://foerderdatenbank.d-s-e-e.de/\">Förderdatenbank der DSEE</a><span class=\"px-1 text-gray\">&gt;</span><span>Förderung der Stiftung der Erzgebirgssparkasse</span>\n  </div>\n </nav>\n <article class=\"container\">\n  <div class=\"grid lg:grid-cols-3 gap-16\">\n   <div class=\"col-span-2 space-y-4\">\n    <header class=\"mb-8\">\n     <h1 class=\"col-span-2 font-bold text-2xl\">Förderung der Stiftung der Erzgebirgssparkasse</h1>\n    </header>\n    <div class=\"prose text-lg mb-8 space-y-6\">\n     <div>\n      <p>Die insgesamt sechs Stiftungen der Erzgebirgssparkasse fördern Sport, Kunst, Kultur und Soziales im gesamten Landkreis und gestalten damit maßgeblich Lebensqualität in der Region mit.</p>\n      <p></p>\n     </div>\n     <div>\n      <h3>Zielgruppen/Bedingungen</h3>\n      <ul>\n       <li>Projekt- und Fördermaßnahmen müssen durch deutlich herausragende Qualität bestimmt sein.</li>\n       <li>Die Stiftungstätigkeit bezieht sich auf den Altlandkreis.</li>\n       <li>Die Stiftung ist unter anderem projektbezogen tätig, dabei kann es sich auch um Projekte handeln, die Veranstaltungen an mehreren Orten innerhalb des Altlandkreises umfassen.</li>\n       <li>Die Stiftung ist offen für eine Kooperation mit geeigneten in- und ausländischen Partnern.</li>\n       <li>Antragsberechtigt an die Stiftung sind natürliche und juristische Personen mit Wohnsitz oder Geschäftssitz im jeweiligen Altlandkreis.</li>\n      </ul>\n      <p>\n       <br>\n      </p>\n     </div>\n     <div>\n      <h3>Hinweise zur Antragstellung/Bewerbung</h3>\n      <ul>\n       <li>Für Förderanträge ist grundsätzlich das Antragsformular der Stiftung zu verwenden.</li>\n       <li>Für zusätzliche Angaben sind dem Antragsformular die dort erbetenen Anlagen beizufügen.</li>\n       <li>Voraussetzung für die Bearbeitung von Förderanträgen ist die Vorlage eines genauen Kosten-, Finanzierungs- und Zeitplans zum jeweiligen Einzelprojekt.</li>\n       <li>Förderanträge an die Stiftung sind direkt an die Stiftung zu richten.</li>\n       <li>Der weitere Schriftwechsel mit dem Antragsteller erfolgt durch die Stiftung, vertreten durch den Stiftungsvorstand.</li>\n      </ul>\n      <p>Vorhaben, die vor Antragstellung begonnen wurden, sind von einer Förderung ausgeschlossen. Eine nachträgliche Förderung bereits abgeschlossener Vorhaben erfolgt nicht.</p>\n     </div>\n     <div>\n      <h3>Weitere Informationen</h3>\n      <ul>\n       <li><a href=\"https://www.erzgebirgssparkasse.de/de/home/ihre-sparkasse/stiftungen.html\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Link zur Stiftung</a></li>\n       <li><a href=\"https://www.erzgebirgssparkasse.de/content/dam/myif/erzgebirgsspk/work/dokumente/pdf/stiftungen/foerderrichtlinien.pdf?stref=iconbox\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Link zu den Förderrichtlinien</a></li>\n      </ul>\n     </div>\n    </div>\n   </div>\n   <aside>\n    <div class=\"prose text-lg space-y-4\">\n     <div>\n      <div class=\"font-bold\">Regionen:</div>\n      <div>\n       <ul>\n        <li>Sachsen</li>\n       </ul>\n      </div>\n     </div>\n     <div>\n      <div class=\"font-bold\">Engagementbereiche:</div>\n      <div>\n       <ul>\n        <li>Kultur, Medien und Musik</li>\n        <li>Soziales</li>\n        <li>Sport und Bewegung</li>\n       </ul>\n      </div>\n     </div>\n     <div>\n      <div class=\"font-bold\">Bewerbungsfrist:</div>\n      <div class=\"mb-1\">\n       <ul>\n        <li>31. März 2027</li>\n       </ul>\n      </div>\n     </div>\n     <div>\n      <div class=\"font-bold\">Vorzeitiger Maßnahmebeginn:</div>\n      <div>Nein</div>\n     </div>\n    </div>\n   </aside>\n  </div>\n  <div class=\"px-5 py-3 border-2 rounded-lg mt-16 px-6 py-6 border-gray\">\n   <div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n    <div class=\"grow\">\n     <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1555-stiftung-der-erzgebirgssparkasse-fuer-den-ehemaligen-landkreis-mittleres-erzgebirge\" class=\"link\">Stiftung der Erzgebirgssparkasse für den ehemaligen Landkreis Mittleres Erzgebirge</a></h2>\n     <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n      <div>\n       <p>Große Kirchgasse 18,\n        <br>\n        09456 Annaberg-Buchholz</p>\n      </div>\n      <div>\n       <h3 class=\"font-bold\">E-Mail</h3>\n       <p><a href=\"mailto:info@erzgebirgssparkasse.de\">info@erzgebirgssparkasse.de</a></p>\n      </div>\n      <div>\n       <h3 class=\"font-bold\">Webseite</h3>\n       <p><a href=\"https://www.erzgebirgssparkasse.de/de/home/ihre-sparkasse/stiftungen.html\" target=\"_blank\">www.erzgebirgssparkasse.de/de/home/ihre-sparkasse/stiftungen.html</a></p>\n      </div>\n      <div>\n       <h3 class=\"font-bold\">Telefon</h3>\n       <p>03733 1390</p>\n      </div>\n     </div>\n    </div>\n   </div>\n  </div>\n </article>\n</main>\n<footer class=\"container mt-24\">\n <div class=\"flex flex-row flex-wrap justify-between items-center py-12 border-t-2 border-yellow select-none cursor-default\">\n  <nav class=\"flex flex-row flex-wrap -mx-1\">\n   <p class=\"mr-6 p-1 opacity-70\">©2026</p>\n   <a class=\"block mr-6 p-1 opacity-70 hover:opacity-100 focus:opacity-100 transition-opacity\" href=\"https://foerderdatenbank.d-s-e-e.de/impressum\">Impressum</a><a class=\"block mr-6 p-1 opacity-70 hover:opacity-100 focus:opacity-100 transition-opacity\" href=\"https://www.deutsche-stiftung-engagement-und-ehrenamt.de/datenschutzerklaerung/\">Datenschutzerklärung</a>\n  </nav>\n  <div class=\"max-w-[240px]\">\n   <img src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/2023_DSEE_Logo_3zlg_RGB_Basis_large.svg\" width=\"300\" height=\"92\" alt=\"Logo Deutsche Stiftung für Engagement und Ehrenamt\">\n  </div>\n </div>\n</footer>\n<script>\n  var _paq = window._paq = window._paq || [];\n  /* tracker methods like \"setCustomDimension\" should be called before \"trackPageView\" */\n  _paq.push(['trackPageView']);\n  _paq.push(['enableLinkTracking']);\n  (function() {\n    var u=\"//matomo.deutsche-stiftung-engagement-und-ehrenamt.de/\";\n    _paq.push(['setTrackerUrl', u+'matomo.php']);\n    _paq.push(['setSiteId', '4']);\n    var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];\n    g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);\n  })();\n</script>";
    <https://html.spec.whatwg.org/#innerText> "Förderung der Stiftung der Erzgebirgssparkasse  –  Förderdatenbank Newsletter X Facebook Instagram LinkedIn Zur Startseite Förderdatenbank der DSEE Förderdatenbank der DSEE>Förderung der Stiftung der Erzgebirgssparkasse Förderung der Stiftung der Erzgebirgssparkasse Die insgesamt sechs Stiftungen der Erzgebirgssparkasse fördern Sport, Kunst, Kultur und Soziales im gesamten Landkreis und gestalten damit maßgeblich Lebensqualität in der Region mit. Zielgruppen/Bedingungen Projekt- und Fördermaßnahmen müssen durch deutlich herausragende Qualität bestimmt sein. Die Stiftungstätigkeit bezieht sich auf den Altlandkreis. Die Stiftung ist unter anderem projektbezogen tätig, dabei kann es sich auch um Projekte handeln, die Veranstaltungen an mehreren Orten innerhalb des Altlandkreises umfassen. Die Stiftung ist offen für eine Kooperation mit geeigneten in- und ausländischen Partnern. Antragsberechtigt an die Stiftung sind natürliche und juristische Personen mit Wohnsitz oder Geschäftssitz im jeweiligen Altlandkreis. Hinweise zur Antragstellung/Bewerbung Für Förderanträge ist grundsätzlich das Antragsformular der Stiftung zu verwenden. Für zusätzliche Angaben sind dem Antragsformular die dort erbetenen Anlagen beizufügen. Voraussetzung für die Bearbeitung von Förderanträgen ist die Vorlage eines genauen Kosten-, Finanzierungs- und Zeitplans zum jeweiligen Einzelprojekt. Förderanträge an die Stiftung sind direkt an die Stiftung zu richten. Der weitere Schriftwechsel mit dem Antragsteller erfolgt durch die Stiftung, vertreten durch den Stiftungsvorstand. Vorhaben, die vor Antragstellung begonnen wurden, sind von einer Förderung ausgeschlossen. Eine nachträgliche Förderung bereits abgeschlossener Vorhaben erfolgt nicht. Weitere Informationen Link zur Stiftung Link zu den Förderrichtlinien Regionen: Sachsen Engagementbereiche: Kultur, Medien und Musik Soziales Sport und Bewegung Bewerbungsfrist: 31. März 2027 Vorzeitiger Maßnahmebeginn: Nein Stiftung der Erzgebirgssparkasse für den ehemaligen Landkreis Mittleres Erzgebirge Große Kirchgasse 18, 09456 Annaberg-Buchholz E-Mail info@erzgebirgssparkasse.de Webseite www.erzgebirgssparkasse.de/de/home/ihre-sparkasse/stiftungen.html Telefon 03733 1390 ©2026 Impressum Datenschutzerklärung".
