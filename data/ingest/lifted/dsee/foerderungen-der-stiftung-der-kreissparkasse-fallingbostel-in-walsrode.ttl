    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/134-stiftung-der-kreissparkasse-fallingbostel-in-walsrode\" class=\"link\">Stiftung der Kreissparkasse Fallingbostel in Walsrode</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Moorstraße 1,\n     <br>\n     29664 Walsrode</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@ksk-walsrode.de\">info@ksk-walsrode.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.ksk-walsrode.de\" target=\"_blank\">www.ksk-walsrode.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>05161 6010</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/stiftung-der-kreissparkasse-fallingbostel-in-walsrode-logo.jpg\" width=\"798\" height=\"251\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Stiftung der Kreissparkasse Fallingbostel in Walsrode Moorstraße 1, 29664 Walsrode E-Mail info@ksk-walsrode.de Webseite www.ksk-walsrode.de Telefon 05161 6010".
