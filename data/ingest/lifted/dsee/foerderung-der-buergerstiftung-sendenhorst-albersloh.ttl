    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1851-buergerstiftung-sendenhorst-albersloh\" class=\"link\">Bürgerstiftung Sendenhorst Albersloh</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Hermann-Löns-Straße 35,\n     <br>\n     48324 Sendenhorst</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@buergerstiftung-sendenhorst-albersloh.de\">info@buergerstiftung-sendenhorst-albersloh.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.buergerstiftung-sendenhorst-albersloh.de\" target=\"_blank\">www.buergerstiftung-sendenhorst-albersloh.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>02526 950522</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Bürgerstiftung-Sendenhorst.jpg\" width=\"800\" height=\"301\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Bürgerstiftung Sendenhorst Albersloh Hermann-Löns-Straße 35, 48324 Sendenhorst E-Mail info@buergerstiftung-sendenhorst-albersloh.de Webseite www.buergerstiftung-sendenhorst-albersloh.de Telefon 02526 950522".
