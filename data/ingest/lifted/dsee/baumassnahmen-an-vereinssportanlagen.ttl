                                                                                                  rdf:_3    [ rdf:type  <http://www.w3.org/1999/xhtml#li>;
                                                                                                              rdf:_1    "Grundstück im Eigentum der Vereine, bzw. Erbbaurecht, Nießbrauch oder&nbsp;Pachtverträge mit Kommune/Gemeinde; Laufzeit mind. 25 Jahre (ab Folgejahr&nbsp;Förderung); bei Zuwendung &lt; 10 T€ - Laufzeit mind. 10 Jahre";
                                                                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                      "Grundstück im Eigentum der Vereine, bzw. Erbbaurecht, Nießbrauch oder&nbsp;Pachtverträge mit Kommune/Gemeinde; Laufzeit mind. 25 Jahre (ab Folgejahr&nbsp;Förderung); bei Zuwendung &lt; 10 T€ - Laufzeit mind. 10 Jahre";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "Grundstück im Eigentum der Vereine, bzw. Erbbaurecht, Nießbrauch oder Pachtverträge mit Kommune/Gemeinde; Laufzeit mind. 25 Jahre (ab Folgejahr Förderung); bei Zuwendung < 10 T€ - Laufzeit mind. 10 Jahre"
                                                                                                            ];
                                                                                                  rdf:_4    [ rdf:type  <http://www.w3.org/1999/xhtml#li>;
                                                                                                              rdf:_1    "gesicherte Gesamtfinanzierung";
                                                                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                      "gesicherte Gesamtfinanzierung";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "gesicherte Gesamtfinanzierung"
                                                                                                            ];
                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<li>ordentliches Mitglied im Landessportbund</li>\n<li>Nachweis sportfachlicher Bedarf</li>\n<li>Grundstück im Eigentum der Vereine, bzw. Erbbaurecht, Nießbrauch oder&nbsp;Pachtverträge mit Kommune/Gemeinde; Laufzeit mind. 25 Jahre (ab Folgejahr&nbsp;Förderung); bei Zuwendung &lt; 10 T€ - Laufzeit mind. 10 Jahre</li>\n<li>gesicherte Gesamtfinanzierung</li>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "ordentliches Mitglied im Landessportbund Nachweis sportfachlicher Bedarf Grundstück im Eigentum der Vereine, bzw. Erbbaurecht, Nießbrauch oder Pachtverträge mit Kommune/Gemeinde; Laufzeit mind. 25 Jahre (ab Folgejahr Förderung); bei Zuwendung < 10 T€ - Laufzeit mind. 10 Jahre gesicherte Gesamtfinanzierung"
                                                                                                ];
                                                                                      rdf:_5    [ rdf:type  <http://www.w3.org/1999/xhtml#p>;
                                                                                                  rdf:_1    "Weitere Fördermöglichkeiten für den Sport in M-V, wie z.B. die Förderung von Ausgaben für Großsportgeräte, Baumaßnahmen, Großveranstaltungen, Breitensportprojekte, Leistungssport, Trainingslager etc. finden Sie unter&nbsp;";
