    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/3153-juergen-brixner-stiftung\" class=\"link\">Jürgen Brixner Stiftung</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Lessingstraße 9,\n     <br>\n     72663 Großbettlingen</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:J.Brixner@suedpark.com\">J.Brixner@suedpark.com</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.juergenbrixnerstiftung.de\" target=\"_blank\">www.juergenbrixnerstiftung.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>+49 7022 41091</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Jürgen Brixner Stiftung Lessingstraße 9, 72663 Großbettlingen E-Mail J.Brixner@suedpark.com Webseite www.juergenbrixnerstiftung.de Telefon +49 7022 41091".
