    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/37147-ministerium-fuer-landwirtschaft-laendliche-raeume-europa-und-verbraucherschutz-schleswig-holstein\" class=\"link\">Ministerium für Landwirtschaft, ländliche Räume, Europa und Verbraucherschutz Schleswig-Holstein</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Fleethörn 29-31,\n     <br>\n     24103 Kiel</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:poststelle@mllev.landsh.de\">poststelle@mllev.landsh.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.schleswig-holstein.de/DE/landesregierung/ministerien-behoerden/IX\" target=\"_blank\">www.schleswig-holstein.de/DE/landesregierung/ministerien-behoerden/IX</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0431 988-0</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Ministerium für Landwirtschaft, ländliche Räume, Europa und Verbraucherschutz Schleswig-Holstein Fleethörn 29-31, 24103 Kiel E-Mail poststelle@mllev.landsh.de Webseite www.schleswig-holstein.de/DE/landesregierung/ministerien-behoerden/IX Telefon 0431 988-0".
