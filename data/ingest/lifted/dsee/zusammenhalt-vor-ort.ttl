    <http://www.w3.org/1999/xhtml#class> "mb-8";
    <https://html.spec.whatwg.org/#innerHTML> "<h1 class=\"col-span-2 font-bold text-2xl\">Zusammenhalt vor Ort</h1>\n<p class=\"text-lg text-gray-500\">Mitmachen. Mitreden. Mitgestalten.</p>";
    <https://html.spec.whatwg.org/#innerText> "Zusammenhalt vor Ort Mitmachen. Mitreden. Mitgestalten.".
