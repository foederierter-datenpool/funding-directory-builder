    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1725-stiftung-sport-der-sparkasse-neuss-und-des-rhein-kreises-neuss\" class=\"link\">Stiftung Sport der Sparkasse Neuss und des Rhein-Kreises Neuss</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Lindenstraße 16,\n     <br>\n     41515 Grevenbroich</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:Gisela.Hug@Rhein-Kreis-Neuss.de\">Gisela.Hug@Rhein-Kreis-Neuss.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.rhein-kreis-neuss-macht-sport.de\" target=\"_blank\">www.rhein-kreis-neuss-macht-sport.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>02181 6015203</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Sparkassenstiftung-Sport-im-Kreis-Rhein-Neuss.jpg\" width=\"800\" height=\"311\">\n </div>\n</div>";
