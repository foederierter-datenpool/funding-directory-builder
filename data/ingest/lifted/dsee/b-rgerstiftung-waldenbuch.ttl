    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1229-buergerstiftung-waldenbuch\" class=\"link\">BürgerStiftung Waldenbuch</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Postfach 1111,\n     <br>\n     71107 Waldenbuch</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@buergerstiftung-waldenbuch.de\">info@buergerstiftung-waldenbuch.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.buergerstiftung-waldenbuch.de\" target=\"_blank\">www.buergerstiftung-waldenbuch.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>07157 4144</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Bürgerstiftung-Waldenbuch.jpg\" width=\"799\" height=\"160\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "BürgerStiftung Waldenbuch Postfach 1111, 71107 Waldenbuch E-Mail info@buergerstiftung-waldenbuch.de Webseite www.buergerstiftung-waldenbuch.de Telefon 07157 4144".
