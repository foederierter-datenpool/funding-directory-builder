    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/3508-buergerstiftung-fellbach\" class=\"link\">Bürgerstiftung Fellbach</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Marktplatz 1,\n     <br>\n     70734 Fellbach</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:buergerstiftung@fellbach.de\">buergerstiftung@fellbach.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://buergerstiftung.fellbach.de\" target=\"_blank\">buergerstiftung.fellbach.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0711 5851-332</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Logo_mitZusatz.jpg\" width=\"800\" height=\"492\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Bürgerstiftung Fellbach Marktplatz 1, 70734 Fellbach E-Mail buergerstiftung@fellbach.de Webseite buergerstiftung.fellbach.de Telefon 0711 5851-332".
