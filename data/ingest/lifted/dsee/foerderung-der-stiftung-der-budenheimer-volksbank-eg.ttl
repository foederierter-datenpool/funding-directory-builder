    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/3289-stiftung-der-budenheimer-volksbank-eg\" class=\"link\">Stiftung der Budenheimer Volksbank eG</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Luisenstraße 7,\n     <br>\n     55257 Budenheim</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@budenheimervb.de\">info@budenheimervb.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.budenheimervb.de/stiftung.html\" target=\"_blank\">www.budenheimervb.de/stiftung.html</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>06139 2908</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Stiftung der Budenheimer Volksbank eG Luisenstraße 7, 55257 Budenheim E-Mail info@budenheimervb.de Webseite www.budenheimervb.de/stiftung.html Telefon 06139 2908".
