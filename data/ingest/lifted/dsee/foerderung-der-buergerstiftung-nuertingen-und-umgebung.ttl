    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1184-buergerstiftung-nuertingen-und-umgebung\" class=\"link\">Bürgerstiftung Nürtingen und Umgebung</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Marktstraße 7,\n     <br>\n     72622 Nürtingen</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@buergerstiftung-nuertingen.de\">info@buergerstiftung-nuertingen.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.buergerstiftung-nuertingen.de\" target=\"_blank\">www.buergerstiftung-nuertingen.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>07022 75310</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Buergerstiftung-Nürtingen-und-Umgebung.jpg\" width=\"800\" height=\"365\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Bürgerstiftung Nürtingen und Umgebung Marktstraße 7, 72622 Nürtingen E-Mail info@buergerstiftung-nuertingen.de Webseite www.buergerstiftung-nuertingen.de Telefon 07022 75310".
