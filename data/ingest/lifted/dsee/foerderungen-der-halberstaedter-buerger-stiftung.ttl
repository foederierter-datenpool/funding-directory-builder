    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/3420-halberstaedter-buerger-stiftung\" class=\"link\">Halberstädter Bürger Stiftung</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Holzmarkt 1,\n     <br>\n     38820 Halberstadt</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:halberstadt@halberstadt.de\">halberstadt@halberstadt.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.halberstadt.de/de/buergerstiftung.html\" target=\"_blank\">www.halberstadt.de/de/buergerstiftung.html</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>03941 550</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Halberstädter Bürger Stiftung Holzmarkt 1, 38820 Halberstadt E-Mail halberstadt@halberstadt.de Webseite www.halberstadt.de/de/buergerstiftung.html Telefon 03941 550".
