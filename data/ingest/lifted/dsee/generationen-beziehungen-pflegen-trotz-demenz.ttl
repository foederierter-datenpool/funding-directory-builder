                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<a href=\"mailto:info@demenzstiftung.de\"><strong>info@demenzstiftung.de</strong></a>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
