                                                                                                ];
                                                                                      rdf:_2    [ rdf:type  <http://www.w3.org/1999/xhtml#p>;
                                                                                                  rdf:_1    "Für 2027 reichen wir Fördermittel aus, die ein innovatives Projekt planen, das dazu beiträgt, Angehörige zu entlasten. Schicken Sie Ihren ";
                                                                                                  rdf:_2    [ rdf:type  <http://www.w3.org/1999/xhtml#strong>;
                                                                                                              rdf:_1    "Antrag bis 30. November 2026";
                                                                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                      "Antrag bis 30. November 2026";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "Antrag bis 30. November 2026"
                                                                                                            ];
                                                                                                  rdf:_3    " als pdf-Datei (Antrag unter Downloads) an:";
                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "Für 2027 reichen wir Fördermittel aus, die ein innovatives Projekt planen, das dazu beiträgt, Angehörige zu entlasten. Schicken Sie Ihren <strong>Antrag bis 30. November 2026</strong> als pdf-Datei (Antrag unter Downloads) an:";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Für 2027 reichen wir Fördermittel aus, die ein innovatives Projekt planen, das dazu beiträgt, Angehörige zu entlasten. Schicken Sie Ihren Antrag bis 30. November 2026 als pdf-Datei (Antrag unter Downloads) an:"
                                                                                                ];
                                                                                      rdf:_3    [ rdf:type  <http://www.w3.org/1999/xhtml#p>;
                                                                                                  rdf:_1    [ rdf:type  <http://www.w3.org/1999/xhtml#a>;
                                                                                                              rdf:_1    [ rdf:type  <http://www.w3.org/1999/xhtml#strong>;
