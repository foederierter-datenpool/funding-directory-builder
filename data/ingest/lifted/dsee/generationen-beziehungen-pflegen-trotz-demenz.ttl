                                                                          <http://www.w3.org/1999/xhtml#class>
                                                                                  "mb-8";
                                                                          <https://html.spec.whatwg.org/#innerHTML>
                                                                                  "<h1 class=\"col-span-2 font-bold text-2xl\">“Angehörige von Menschen mit Demenz entlasten”</h1>";
                                                                          <https://html.spec.whatwg.org/#innerText>
                                                                                  "“Angehörige von Menschen mit Demenz entlasten”"
                                                                        ];
                                                              rdf:_2    [ rdf:type  <http://www.w3.org/1999/xhtml#div>;
                                                                          rdf:_1    [ rdf:type  <http://www.w3.org/1999/xhtml#div>;
                                                                                      rdf:_1    [ rdf:type  <http://www.w3.org/1999/xhtml#p>;
                                                                                                  rdf:_1    "Fast 70 Prozent der Menschen mit Demenz leben in ihrer häuslichen Umgebung und werden von Ihren Angehörigen betreut. 24 Stunden – 7 Tage in der Woche – 365 Tage im Jahr. Mit Geduld und Liebe erleichtern sie tagtäglich den Alltag von Menschen mit Demenz.";
                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "Fast 70 Prozent der Menschen mit Demenz leben in ihrer häuslichen Umgebung und werden von Ihren Angehörigen betreut. 24 Stunden – 7 Tage in der Woche – 365 Tage im Jahr. Mit Geduld und Liebe erleichtern sie tagtäglich den Alltag von Menschen mit Demenz.";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Fast 70 Prozent der Menschen mit Demenz leben in ihrer häuslichen Umgebung und werden von Ihren Angehörigen betreut. 24 Stunden – 7 Tage in der Woche – 365 Tage im Jahr. Mit Geduld und Liebe erleichtern sie tagtäglich den Alltag von Menschen mit Demenz."
                                                                                                ];
                                                                                      rdf:_2    [ rdf:type  <http://www.w3.org/1999/xhtml#p>;
                                                                                                  rdf:_1    "Diese aufopfernde Hingabe führt in nicht wenigen Fällen zu körperlichen und seelischen Belastungen und zu einer unfreiwilligen Isolation.";
                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "Diese aufopfernde Hingabe führt in nicht wenigen Fällen zu körperlichen und seelischen Belastungen und zu einer unfreiwilligen Isolation.";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Diese aufopfernde Hingabe führt in nicht wenigen Fällen zu körperlichen und seelischen Belastungen und zu einer unfreiwilligen Isolation."
                                                                                                ];
                                                                                      <https://html.spec.whatwg.org/#innerHTML>
                                                                                              "<p>Fast 70 Prozent der Menschen mit Demenz leben in ihrer häuslichen Umgebung und werden von Ihren Angehörigen betreut. 24 Stunden – 7 Tage in der Woche – 365 Tage im Jahr. Mit Geduld und Liebe erleichtern sie tagtäglich den Alltag von Menschen mit Demenz.</p>\n<p>Diese aufopfernde Hingabe führt in nicht wenigen Fällen zu körperlichen und seelischen Belastungen und zu einer unfreiwilligen Isolation.</p>";
                                                                                      <https://html.spec.whatwg.org/#innerText>
                                                                                              "Fast 70 Prozent der Menschen mit Demenz leben in ihrer häuslichen Umgebung und werden von Ihren Angehörigen betreut. 24 Stunden – 7 Tage in der Woche – 365 Tage im Jahr. Mit Geduld und Liebe erleichtern sie tagtäglich den Alltag von Menschen mit Demenz. Diese aufopfernde Hingabe führt in nicht wenigen Fällen zu körperlichen und seelischen Belastungen und zu einer unfreiwilligen Isolation."
                                                                                    ];
