    rdf:_1 _:n3-166646;
    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"prose text-lg space-y-4\">\n <div>\n  <div class=\"font-bold\">Regionen:</div>\n  <div>\n   <ul>\n    <li>Hessen</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Engagementbereiche:</div>\n  <div>\n   <ul>\n    <li>Bevölkerungs- und Katastrophenschutz</li>\n    <li>Engagement für gesellschaftlichen Zusammenhalt/ Demokratie</li>\n    <li>Kinder und Jugendliche</li>\n    <li>Sport und Bewegung</li>\n    <li>Umwelt-/Naturschutz, Klimaschutz und Tierschutz</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Max. Fördersumme:</div>\n  <div>30.000€</div>\n </div>\n <div>\n  <div class=\"font-bold\">Eigenmittel benötigt:</div>\n  <div>Ja</div>\n </div>\n <div>\n  <div class=\"font-bold\">Bewerbungsfrist:</div>\n  <div class=\"mb-1\">\n   <ul>\n    <li>15. November 2026</li>\n   </ul>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Regionen: Hessen Engagementbereiche: Bevölkerungs- und Katastrophenschutz Engagement für gesellschaftlichen Zusammenhalt/ Demokratie Kinder und Jugendliche Sport und Bewegung Umwelt-/Naturschutz, Klimaschutz und Tierschutz Max. Fördersumme: 30.000€ Eigenmittel benötigt: Ja Bewerbungsfrist: 15. November 2026".
