    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"grow\">\n <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1892-stiftung-der-sparkasse-herford\" class=\"link\">Stiftung der Sparkasse Herford</a></h2>\n <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n  <div>\n   <p>Engerstraße 5,\n    <br>\n    32052 Herford</p>\n  </div>\n  <div>\n   <h3 class=\"font-bold\">E-Mail</h3>\n   <p><a href=\"mailto:SKogelheide@sparkasse-herford.de\">SKogelheide@sparkasse-herford.de</a></p>\n  </div>\n  <div>\n   <h3 class=\"font-bold\">Webseite</h3>\n   <p><a href=\"https://www.sparkasse-herford.de/de/home/ihre-sparkasse/Stiftungen.html?n=true&amp;stref=search&amp;q=stiftung&amp;mdidianlass=&amp;mdidiansprache=\" target=\"_blank\">www.sparkasse-herford.de/de/home/ihre-sparkasse/Stiftungen.html?n=true&amp;stref=search&amp;q=stiftung&amp;mdidianlass=&amp;mdidiansprache=</a></p>\n  </div>\n  <div>\n   <h3 class=\"font-bold\">Telefon</h3>\n   <p>05221 14012104</p>\n  </div>\n </div>\n</div>\n<div class=\"md:w-1/3\">\n <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Stiftung-der-Sparkasse-Herford.jpg\" width=\"800\" height=\"234\">\n</div>";
