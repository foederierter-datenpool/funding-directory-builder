    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/2384-bremer-schuloffensive-gemeinnuetzige-stiftung\" class=\"link\">Bremer Schuloffensive gemeinnützige Stiftung</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Bürgermeister-Smidt-Straße 78,\n     <br>\n     28195 Bremen</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@bremer-schuloffensive.de\">info@bremer-schuloffensive.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.bremer-schuloffensive.de\" target=\"_blank\">www.bremer-schuloffensive.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0421 165 35 50</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Bremer Schuloffensive gemeinnützige Stiftung Bürgermeister-Smidt-Straße 78, 28195 Bremen E-Mail info@bremer-schuloffensive.de Webseite www.bremer-schuloffensive.de Telefon 0421 165 35 50".
