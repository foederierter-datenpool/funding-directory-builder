    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/25930-thueringer-ehrenamtsstiftung\" class=\"link\">Thüringer Ehrenamtsstiftung</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Löberwallgraben 8,\n     <br>\n     99096 Erfurt</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@thueringer-ehrenamtsstiftung.de\">info@thueringer-ehrenamtsstiftung.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.thueringer-ehrenamtsstiftung.de/\" target=\"_blank\">www.thueringer-ehrenamtsstiftung.de/</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0361 6573661</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/TES-Wortbildmarke-Webfarbe.jpg\" width=\"800\" height=\"146\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Thüringer Ehrenamtsstiftung Löberwallgraben 8, 99096 Erfurt E-Mail info@thueringer-ehrenamtsstiftung.de Webseite www.thueringer-ehrenamtsstiftung.de/ Telefon 0361 6573661".
