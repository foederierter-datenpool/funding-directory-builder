xt-lg md:flex flex-row gap-12\">\n  <div class=\"grow\">\n   <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1451-stiftung-der-kreissparkasse-hoechstadt-a-d-aisch\" class=\"link\">Stiftung der Kreissparkasse Höchstadt a. d. Aisch</a></h2>\n   <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n    <div>\n     <p>Hugenottenplatz 5,\n      <br>\n      91054 Erlangen</p>\n    </div>\n    <div>\n     <h3 class=\"font-bold\">E-Mail</h3>\n     <p><a href=\"mailto:stiftung-kskhoechstadt@sparkasse-erlangen.de\">stiftung-kskhoechstadt@sparkasse-erlangen.de</a></p>\n    </div>\n    <div>\n     <h3 class=\"font-bold\">Webseite</h3>\n     <p><a href=\"https://www.sparkasse-erlangen.de/de/home/ihre-sparkasse/sparkasseneigene-stiftungen/stiftung-der-kreissparkasse-hoechstadt.html\" target=\"_blank\">www.sparkasse-erlangen.de/de/home/ihre-sparkasse/sparkasseneigene-stiftungen/stiftung-der-kreissparkasse-hoechstadt.html</a></p>\n    </div>\n    <div>\n     <h3 class=\"font-bold\">Telefon</h3>\n     <p>09193 30155</p>\n    </div>\n   </div>\n  </div>\n  <div class=\"md:w-1/3\">\n   <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Stiftung-der-Kreissparkasse-Höchstadt-a.d.Aisch.png\" width=\"799\" height=\"183\">\n  </div>\n </div>\n</div>";
