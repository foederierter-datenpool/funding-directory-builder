    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/2684-sparkassenstiftung-der-sparkasse-niederbayern-mitte\" class=\"link\">Sparkassenstiftung der Sparkasse Niederbayern-Mitte</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Theresienplatz 12/24,\n     <br>\n     94315 Straubing</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@sparkasse-niederbayern-mitte.de\">info@sparkasse-niederbayern-mitte.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.sparkasse-niederbayern-mitte.de/de/home/ihre-sparkasse/nachhaltigkeit-ueberblick/initiativen.html\" target=\"_blank\">www.sparkasse-niederbayern-mitte.de/de/home/ihre-sparkasse/nachhaltigkeit-ueberblick/initiativen.html</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>09421 8631234</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Sparkassenstiftung der Sparkasse Niederbayern-Mitte Theresienplatz 12/24, 94315 Straubing E-Mail info@sparkasse-niederbayern-mitte.de Webseite www.sparkasse-niederbayern-mitte.de/de/home/ihre-sparkasse/nachhaltigkeit-ueberblick/initiativen.html Telefon 09421 8631234".
