                                                                                                                      "Bürgerstiftungen"
                                                                                                            ];
                                                                                                  rdf:_3    " aus ganz Deutschland, die ein Gütesiegel vom Bundesverband Deutscher Stiftungen tragen oder als gütesiegeltauglich eingestuft wurden ";
                                                                                                  rdf:_4    [ rdf:type  <http://www.w3.org/1999/xhtml#a>;
                                                                                                              rdf:_1    "(s. 10 Merkmale einer Bürgerstiftung)";
                                                                                                              <http://www.w3.org/1999/xhtml#href>
