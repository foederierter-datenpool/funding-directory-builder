    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1554-stiftung-der-kreissparkasse-bitterfeld\" class=\"link\">Stiftung der Kreissparkasse Bitterfeld</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Lindenstraße 27,\n     <br>\n     06749 Bitterfeld-Wolfen</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@ksk-anhalt-bitterfeld.de\">info@ksk-anhalt-bitterfeld.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.ksk-anhalt-bitterfeld.de\" target=\"_blank\">www.ksk-anhalt-bitterfeld.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>03493 390</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Stiftung der Kreissparkasse Bitterfeld Lindenstraße 27, 06749 Bitterfeld-Wolfen E-Mail info@ksk-anhalt-bitterfeld.de Webseite www.ksk-anhalt-bitterfeld.de Telefon 03493 390".
