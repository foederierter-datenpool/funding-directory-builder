    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1670-zukunft-im-wittekindskreis\" class=\"link\">Zukunft im Wittekindskreis</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Amtshausstraße 3,\n     <br>\n     32051 Herford</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@zukunft-im-wittekindskreis.de\">info@zukunft-im-wittekindskreis.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.kreis-herford.de/Entwicklung/Stiftung-Zukunft-im-Wittekindskreis\" target=\"_blank\">www.kreis-herford.de/Entwicklung/Stiftung-Zukunft-im-Wittekindskreis</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>05221 13-0</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Zukunft-im-Wittekindskreis.jpg\" width=\"800\" height=\"440\">\n </div>\n</div>";
