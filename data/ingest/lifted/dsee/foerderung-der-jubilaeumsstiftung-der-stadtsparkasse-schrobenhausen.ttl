    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1424-jubilaeumsstiftung-der-stadtsparkasse-schrobenhausen\" class=\"link\">Jubiläumsstiftung der Stadtsparkasse Schrobenhausen</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Lenbachplatz 1,\n     <br>\n     86529 Schrobenhausen</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:Gabriela.Gastl@spk-aic-sob.de\">Gabriela.Gastl@spk-aic-sob.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.sparkassenstiftungen.de/stiftungen/jubilaeumsstiftung-der-stadtsparkasse-schrobenhausen/stiftungs-startseite/\" target=\"_blank\">www.sparkassenstiftungen.de/stiftungen/jubilaeumsstiftung-der-stadtsparkasse-schrobenhausen/stiftungs-startseite/</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>08251 940</p>\n   </div>\n  </div>\n </div>\n</div>";
