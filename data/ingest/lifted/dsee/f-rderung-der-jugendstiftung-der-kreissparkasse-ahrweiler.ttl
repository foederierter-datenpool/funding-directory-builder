    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/2474-jugendstiftung-der-kreissparkasse-ahrweiler\" class=\"link\">Jugendstiftung der Kreissparkasse Ahrweiler</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Wilhelmstraße 1,\n     <br>\n     53474 Bad Neuenahr-Ahrweiler</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:stiftungen@ksk-ahrweiler.de\">stiftungen@ksk-ahrweiler.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.sparkassenstiftungen.de/index.php?id=9174\" target=\"_blank\">www.sparkassenstiftungen.de/index.php?id=9174</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>02641 3805113</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Jugendstiftung der Kreissparkasse Ahrweiler Wilhelmstraße 1, 53474 Bad Neuenahr-Ahrweiler E-Mail stiftungen@ksk-ahrweiler.de Webseite www.sparkassenstiftungen.de/index.php?id=9174 Telefon 02641 3805113".
_:n3-177975 a <http://www.w3.org/1999/xhtml#div>;
