    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/21478-lagfa\" class=\"link\">LAGFA Sachsen-Anhalt e.V.</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Rathausstraße 13,\n     <br>\n     06108 Halle (Saale)</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:netzwerkstelle@lagfa-lsa.de\">netzwerkstelle@lagfa-lsa.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.nachbarsein.de/\" target=\"_blank\">www.nachbarsein.de/</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0345 22604440</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "LAGFA Sachsen-Anhalt e.V. Rathausstraße 13, 06108 Halle (Saale) E-Mail netzwerkstelle@lagfa-lsa.de Webseite www.nachbarsein.de/ Telefon 0345 22604440".
