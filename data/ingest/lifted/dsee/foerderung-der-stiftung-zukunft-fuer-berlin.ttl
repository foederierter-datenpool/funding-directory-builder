    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/2996-stiftung-zukunft-berlin\" class=\"link\">Stiftung Zukunft Berlin</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Klingelhöferstraße 7,\n     <br>\n     10875 Berlin</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:mail@stiftungzukunftberlin.eu\">mail@stiftungzukunftberlin.eu</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.stiftungzukunftberlin.eu\" target=\"_blank\">www.stiftungzukunftberlin.eu</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>030 263 92 290</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Stiftung Zukunft Berlin Klingelhöferstraße 7, 10875 Berlin E-Mail mail@stiftungzukunftberlin.eu Webseite www.stiftungzukunftberlin.eu Telefon 030 263 92 290".
