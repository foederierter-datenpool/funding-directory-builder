    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/37574-hamburger-sportbund-e-v\" class=\"link\">Hamburger Sportbund e.V.</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Haus des Sports Schäferkampsallee 1,\n     <br>\n     20357 Hamburg</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:hsb@hamburger-sportbund.de\">hsb@hamburger-sportbund.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.hamburger-sportbund.de/\" target=\"_blank\">www.hamburger-sportbund.de/</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>040 419080</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Hamburger Sportbund e.V. Haus des Sports Schäferkampsallee 1, 20357 Hamburg E-Mail hsb@hamburger-sportbund.de Webseite www.hamburger-sportbund.de/ Telefon 040 419080".
