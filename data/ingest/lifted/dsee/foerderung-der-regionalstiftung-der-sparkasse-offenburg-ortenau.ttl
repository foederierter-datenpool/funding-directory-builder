    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1338-regionalstiftung-der-sparkasse-offenburg-ortenau\" class=\"link\">Regionalstiftung der Sparkasse Offenburg/Ortenau</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Bertha-von-Suttner-Straße 8,\n     <br>\n     77654 Offenburg</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:regionalstiftung@sparkasse-offenburg.de\">regionalstiftung@sparkasse-offenburg.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.sparkasse-offenburg.de/regionalstiftung\" target=\"_blank\">www.sparkasse-offenburg.de/regionalstiftung</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0781 2001070</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Regionalstiftung-der-Sparkasse-Offenburg-Ortenau.jpg\" width=\"800\" height=\"204\">\n </div>\n</div>";
