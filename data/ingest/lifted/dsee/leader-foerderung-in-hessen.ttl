    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/36207-hessisches-ministerium-fuer-landwirtschaft-und-umwelt-weinbau-forsten-jagd-und-heimat\" class=\"link\">Hessisches Ministerium für Landwirtschaft und Umwelt, Weinbau, Forsten, Jagd und Heimat</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Mainzer Straße 80,\n     <br>\n     65189 Wiesbaden</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:poststelle@landwirtschaft.hessen.de\">poststelle@landwirtschaft.hessen.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://landwirtschaft.hessen.de/\" target=\"_blank\">landwirtschaft.hessen.de/</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0611 8150</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Hessisches Ministerium für Landwirtschaft und Umwelt, Weinbau, Forsten, Jagd und Heimat Mainzer Straße 80, 65189 Wiesbaden E-Mail poststelle@landwirtschaft.hessen.de Webseite landwirtschaft.hessen.de/ Telefon 0611 8150".
