    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/151-stiftung-sport-und-kultur-fuer-braunschweig\" class=\"link\">Die Braunschweigische Stiftung</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Haus der Braunschweigischen Stiftungen, Löwenwall 16,\n     <br>\n     38100 Braunschweig</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@die-braunschweigische.de\">info@die-braunschweigische.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.die-braunschweigische.de/stiftung/\" target=\"_blank\">www.die-braunschweigische.de/stiftung/</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0531 273590</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/stiftung-sport-und-kultur-für-braunschweig-logo.jpg\" width=\"799\" height=\"232\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Die Braunschweigische Stiftung Haus der Braunschweigischen Stiftungen, Löwenwall 16, 38100 Braunschweig E-Mail info@die-braunschweigische.de Webseite www.die-braunschweigische.de/stiftung/ Telefon 0531 273590".
