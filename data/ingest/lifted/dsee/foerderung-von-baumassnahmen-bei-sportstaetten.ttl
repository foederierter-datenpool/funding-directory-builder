    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/35885-saechsische-aufbaubank\" class=\"link\">Sächsische Aufbaubank (SAB)</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:servicecenter@sab.sachsen.de\">servicecenter@sab.sachsen.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.sab.sachsen.de/\" target=\"_blank\">www.sab.sachsen.de/</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0341 702920</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/logo-t.svg\" width=\"800\" height=\"373\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Sächsische Aufbaubank (SAB) E-Mail servicecenter@sab.sachsen.de Webseite www.sab.sachsen.de/ Telefon 0341 702920".
