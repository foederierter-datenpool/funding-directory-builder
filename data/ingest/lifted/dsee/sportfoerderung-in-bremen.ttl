    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/37571-landessportbund-bremen-e-v\" class=\"link\">Landessportbund Bremen e.V.</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Hutfilterstraße 16-18,\n     <br>\n     28195 Bremen</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@lsb-bremen.de\">info@lsb-bremen.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.lsb-bremen.de/\" target=\"_blank\">www.lsb-bremen.de/</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0421 792870</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Web-Artikel-LSB-Logo2.jpg\" width=\"800\" height=\"566\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Landessportbund Bremen e.V. Hutfilterstraße 16-18, 28195 Bremen E-Mail info@lsb-bremen.de Webseite www.lsb-bremen.de/ Telefon 0421 792870".
