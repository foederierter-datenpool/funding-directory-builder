_:n3-136611 a <http://www.w3.org/1999/xhtml#h1>;
    rdf:_1 "Förderung der Bürgerstiftung Ehingen";
    <http://www.w3.org/1999/xhtml#class> "col-span-2 font-bold text-2xl";
