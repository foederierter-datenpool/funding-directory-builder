    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/22847-deutsche-bundesstiftung-umwelt\" class=\"link\">Deutsche Bundesstiftung Umwelt</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>An der Bornau 2,\n     <br>\n     49090 Osnabrück</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@dbu.de\">info@dbu.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.dbu.de/\" target=\"_blank\">www.dbu.de/</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0541 96330</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/dbu.png\" width=\"800\" height=\"800\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Deutsche Bundesstiftung Umwelt An der Bornau 2, 49090 Osnabrück E-Mail info@dbu.de Webseite www.dbu.de/ Telefon 0541 96330".
