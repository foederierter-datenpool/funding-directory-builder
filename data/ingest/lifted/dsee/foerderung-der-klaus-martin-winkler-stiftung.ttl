    rdf:_1 _:n3-283982;
    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"prose text-lg space-y-4\">\n <div>\n  <div class=\"font-bold\">Regionen:</div>\n  <div>\n   <ul>\n    <li>Sachsen</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Engagementbereiche:</div>\n  <div>\n   <ul>\n    <li>Bildung</li>\n    <li>Engagement für gesellschaftlichen Zusammenhalt/ Demokratie</li>\n    <li>Kinder und Jugendliche</li>\n    <li>Soziales</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Bewerbungsfrist:</div>\n  <div class=\"mb-1\">\n   <ul>\n    <li>1. April 2027</li>\n    <li>1. September 2027</li>\n   </ul>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Regionen: Sachsen Engagementbereiche: Bildung Engagement für gesellschaftlichen Zusammenhalt/ Demokratie Kinder und Jugendliche Soziales Bewerbungsfrist: 1. April 2027 1. September 2027".
