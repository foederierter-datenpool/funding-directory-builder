    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1894-stiftung-der-sparkasse-hagen\" class=\"link\">Stiftung der Sparkasse Hagen</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Sparkassen-Karree 1,\n     <br>\n     58095 Hagen</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:stiftung@sparkasse-hagen.de\">stiftung@sparkasse-hagen.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.sparkasse-hagen.de\" target=\"_blank\">www.sparkasse-hagen.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>02331 2063250</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Stiftung-der-Sparkasse-Hagen.jpg\" width=\"799\" height=\"239\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Stiftung der Sparkasse Hagen Sparkassen-Karree 1, 58095 Hagen E-Mail stiftung@sparkasse-hagen.de Webseite www.sparkasse-hagen.de Telefon 02331 2063250".
