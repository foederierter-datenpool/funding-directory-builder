    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/37635-hessisches-ministerium-fuer-familie-senioren-sport-gesundheit-und-pflege\" class=\"link\">Hessisches Ministerium für Familie, Senioren, Sport, Gesundheit und Pflege</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Sonnenberger Str. 2/2a,\n     <br>\n     65193 Wiesbaden</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:poststelle@hmfg.hessen.de\">poststelle@hmfg.hessen.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://familie.hessen.de/\" target=\"_blank\">familie.hessen.de/</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0611 32190</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Hessisches Ministerium für Familie, Senioren, Sport, Gesundheit und Pflege Sonnenberger Str. 2/2a, 65193 Wiesbaden E-Mail poststelle@hmfg.hessen.de Webseite familie.hessen.de/ Telefon 0611 32190".
