    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/38940-stiftung-west-oestliche-begegnungen\" class=\"link\">Stiftung West-Östliche Begegnungen</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Brüderstraße 13,\n     <br>\n     10178 Berlin</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@stiftung-woeb.de\">info@stiftung-woeb.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.stiftung-woeb.de/\" target=\"_blank\">www.stiftung-woeb.de/</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0049 30 2044840</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Logo-Stiftung-West-Oestliche-Begengungen.png\" width=\"799\" height=\"240\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Stiftung West-Östliche Begegnungen Brüderstraße 13, 10178 Berlin E-Mail info@stiftung-woeb.de Webseite www.stiftung-woeb.de/ Telefon 0049 30 2044840".
