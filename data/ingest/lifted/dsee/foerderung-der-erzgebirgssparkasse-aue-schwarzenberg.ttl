    rdf:_2 _:n3-194518;
    <http://www.w3.org/1999/xhtml#class> "my-8";
    <https://html.spec.whatwg.org/#innerHTML> "<nav class=\"container\">\n <div class=\"my-8 py-3 border-t-2 border-gray select-none cursor-default\">\n  <a class=\"link\" href=\"https://foerderdatenbank.d-s-e-e.de/\">Förderdatenbank der DSEE</a><span class=\"px-1 text-gray\">&gt;</span><span>Förderung der Erzgebirgssparkasse Aue Schwarzenberg</span>\n </div>\n</nav>\n<article class=\"container\">\n <div class=\"grid lg:grid-cols-3 gap-16\">\n  <div class=\"col-span-2 space-y-4\">\n   <header class=\"mb-8\">\n    <h1 class=\"col-span-2 font-bold text-2xl\">Förderung der Erzgebirgssparkasse Aue Schwarzenberg</h1>\n   </header>\n   <div class=\"prose text-lg mb-8 space-y-6\">\n    <div>\n     <p>Die insgesamt sechs Stiftungen der Erzgebirgssparkasse fördern Sport, Kunst, Kultur und Soziales im gesamten Landkreis und gestalten damit maßgeblich Lebensqualität in der Region mit.</p>\n     <p></p>\n    </div>\n    <div>\n     <h3>Zielgruppen/Bedingungen</h3>\n     <p>Antragsberechtigt an die Stiftung sind natürliche und juristische Personen mit Wohnsitz oder Geschäftssitz im jeweiligen Altlandkreis.</p>\n    </div>\n    <div>\n     <h3>Hinweise zur Antragstellung/Bewerbung</h3>\n     <p>Das Antragsformular steht auf der Website zum Download bereit.&nbsp;Für Förderanträge ist grundsätzlich das Antragsformular der Stiftung zu verwenden.&nbsp;Für zusätzliche Angaben sind dem Antragsformular die dort erbetenen Anlagen beizufügen.</p>\n     <p>Vorhaben, die vor Antragstellung begonnen wurden, sind von einer Förderung ausgeschlossen. Eine nachträgliche Förderung bereits abgeschlossener Vorhaben erfolgt nicht.</p>\n    </div>\n    <div>\n     <h3>Weitere Informationen</h3>\n     <ul>\n      <li><a href=\"https://www.erzgebirgssparkasse.de/de/home/ihre-sparkasse/stiftungen.html?n=true&amp;stref=search&amp;q=stiftung&amp;mdidianlass=&amp;mdidiansprache=\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Link zur Stiftung</a></li>\n      <li><a href=\"https://www.erzgebirgssparkasse.de/content/dam/myif/erzgebirgsspk/work/dokumente/pdf/stiftungen/antrag_aue.pdf?stref=iconbox\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Link zum Antrag</a></li>\n     </ul>\n    </div>\n   </div>\n  </div>\n  <aside>\n   <div class=\"prose text-lg space-y-4\">\n    <div>\n     <div class=\"font-bold\">Regionen:</div>\n     <div>\n      <ul>\n       <li>Sachsen</li>\n      </ul>\n     </div>\n    </div>\n    <div>\n     <div class=\"font-bold\">Engagementbereiche:</div>\n     <div>\n      <ul>\n       <li>Kultur, Medien und Musik</li>\n       <li>Soziales</li>\n       <li>Sport und Bewegung</li>\n      </ul>\n     </div>\n    </div>\n    <div>\n     <div class=\"font-bold\">Max. Fördersumme:</div>\n     <div>Förderbeträge bis zur Höhe von 5.000 Euro werden zu 100 Prozent ausgezahlt. Bei Förderbeträgen ab 5.001 Euro überweist die Stiftung in der Regel 80 Prozent des bewilligten Gesamtbudgets</div>\n    </div>\n    <div>\n     <div class=\"font-bold\">Bewerbungsfrist:</div>\n     <div class=\"mb-1\">\n      <ul>\n       <li>31. März 2027</li>\n      </ul>\n     </div>\n    </div>\n    <div>\n     <div class=\"font-bold\">Vorzeitiger Maßnahmebeginn:</div>\n     <div>Nein</div>\n    </div>\n   </div>\n  </aside>\n </div>\n <div class=\"px-5 py-3 border-2 rounded-lg mt-16 px-6 py-6 border-gray\">\n  <div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n   <div class=\"grow\">\n    <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/2845-sparkassenstiftung-fuer-jugend-und-sport-der-kreissparkasse-aue-schwarzenberg\" class=\"link\">Erzgebirgssparkasse Aue Schwarzenberg</a></h2>\n    <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n     <div>\n      <p>Große Kirchgasse 18,\n       <br>\n       09456 Annaberg-Buchholz</p>\n     </div>\n     <div>\n      <h3 class=\"font-bold\">E-Mail</h3>\n      <p><a href=\"mailto:info@erzgebirgssparkasse.de\">info@erzgebirgssparkasse.de</a></p>\n     </div>\n     <div>\n      <h3 class=\"font-bold\">Webseite</h3>\n      <p><a href=\"https://www.erzgebirgssparkasse.de/de/home/ihre-sparkasse/stiftungen.html?n=true&amp;stref=search&amp;q=stiftung&amp;mdidianlass=&amp;mdidiansprache=\" target=\"_blank\">www.erzgebirgssparkasse.de/de/home/ihre-sparkasse/stiftungen.html?n=true&amp;stref=search&amp;q=stiftung&amp;mdidianlass=&amp;mdidiansprache=</a></p>\n     </div>\n     <div>\n      <h3 class=\"font-bold\">Telefon</h3>\n      <p>03733 1390</p>\n     </div>\n    </div>\n   </div>\n  </div>\n </div>\n</article>";
    <https://html.spec.whatwg.org/#innerText> "Förderdatenbank der DSEE>Förderung der Erzgebirgssparkasse Aue Schwarzenberg Förderung der Erzgebirgssparkasse Aue Schwarzenberg Die insgesamt sechs Stiftungen der Erzgebirgssparkasse fördern Sport, Kunst, Kultur und Soziales im gesamten Landkreis und gestalten damit maßgeblich Lebensqualität in der Region mit. Zielgruppen/Bedingungen Antragsberechtigt an die Stiftung sind natürliche und juristische Personen mit Wohnsitz oder Geschäftssitz im jeweiligen Altlandkreis. Hinweise zur Antragstellung/Bewerbung Das Antragsformular steht auf der Website zum Download bereit. Für Förderanträge ist grundsätzlich das Antragsformular der Stiftung zu verwenden. Für zusätzliche Angaben sind dem Antragsformular die dort erbetenen Anlagen beizufügen. Vorhaben, die vor Antragstellung begonnen wurden, sind von einer Förderung ausgeschlossen. Eine nachträgliche Förderung bereits abgeschlossener Vorhaben erfolgt nicht. Weitere Informationen Link zur Stiftung Link zum Antrag Regionen: Sachsen Engagementbereiche: Kultur, Medien und Musik Soziales Sport und Bewegung Max. Fördersumme: Förderbeträge bis zur Höhe von 5.000 Euro werden zu 100 Prozent ausgezahlt. Bei Förderbeträgen ab 5.001 Euro überweist die Stiftung in der Regel 80 Prozent des bewilligten Gesamtbudgets Bewerbungsfrist: 31. März 2027 Vorzeitiger Maßnahmebeginn: Nein Erzgebirgssparkasse Aue Schwarzenberg Große Kirchgasse 18, 09456 Annaberg-Buchholz E-Mail info@erzgebirgssparkasse.de Webseite www.erzgebirgssparkasse.de/de/home/ihre-sparkasse/stiftungen.html?n=true&stref=search&q=stiftung&mdidianlass=&mdidiansprache= Telefon 03733 1390".
