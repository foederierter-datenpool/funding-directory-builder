    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/37043-cordes-graefe-stiftung\" class=\"link\">CORDES &amp; GRAEFE Stiftung</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Altenwall 6,\n     <br>\n     28195 Bremen</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@cordesundgraefe-stiftung.de\">info@cordesundgraefe-stiftung.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.cordesundgraefe-stiftung.de/\" target=\"_blank\">www.cordesundgraefe-stiftung.de/</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0421 2029314</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "CORDES & GRAEFE Stiftung Altenwall 6, 28195 Bremen E-Mail info@cordesundgraefe-stiftung.de Webseite www.cordesundgraefe-stiftung.de/ Telefon 0421 2029314".
