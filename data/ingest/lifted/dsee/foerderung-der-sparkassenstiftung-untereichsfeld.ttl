    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/143-sparkassenstiftung-untereichsfeld\" class=\"link\">Sparkassenstiftung Untereichsfeld</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Bahnhofstraße 41,\n     <br>\n     37115 Duderstadt</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@sparkasse-duderstadt.de\">info@sparkasse-duderstadt.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.sparkasse-duderstadt.de/de/home/ihre-sparkasse/soziales-engagement.html?n=true&amp;stref=search&amp;q=stiftung&amp;mdidianlass=&amp;mdidiansprache=\" target=\"_blank\">www.sparkasse-duderstadt.de/de/home/ihre-sparkasse/soziales-engagement.html?n=true&amp;stref=search&amp;q=stiftung&amp;mdidianlass=&amp;mdidiansprache=</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>05527 830</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/sparkassenstifung-untereichsfeld-logo.jpg\" width=\"800\" height=\"263\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Sparkassenstiftung Untereichsfeld Bahnhofstraße 41, 37115 Duderstadt E-Mail info@sparkasse-duderstadt.de Webseite www.sparkasse-duderstadt.de/de/home/ihre-sparkasse/soziales-engagement.html?n=true&stref=search&q=stiftung&mdidianlass=&mdidiansprache= Telefon 05527 830".
