_:n3-288933 a <http://www.w3.org/1999/xhtml#aside>;
    rdf:_1 _:n3-288934;
    rdf:_2 _:n3-288937;
    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"mb-10 max-w-sm\">\n <figure class=\"ml-auto max-w-[600px]\">\n  <img src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/beleben-logo-anniversary.svg\" width=\"800\" height=\"1168\">\n </figure>\n</div>\n<div class=\"prose text-lg space-y-4\">\n <div>\n  <div class=\"font-bold\">Regionen:</div>\n  <div>\n   <ul>\n    <li>Berlin</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Engagementbereiche:</div>\n  <div>\n   <ul>\n    <li>Kinder und Jugendliche</li>\n    <li>Kultur, Medien und Musik</li>\n    <li>Soziales</li>\n    <li>Sport und Bewegung</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Max. Fördersumme:</div>\n  <div>bis zu 1.000 Euro</div>\n </div>\n <div>\n  <div class=\"font-bold\">Bewerbungsfrist:</div>\n  <div class=\"mb-1\">Fortlaufende Förderung</div>\n  <div class=\"prose text-base\">\n   <p>Förderanträge für Projekte ab 10.000 Euro können jedes Jahr von März bis Mai für das Folgejahr ausschließlich online über ein dann hier freigeschaltetes Portal gestellt werden.</p>\n   <p>Kooperationsprojekte im Rahmen des Programms Stadtraum!Plus, die mit bis zu 1.000 Euro gefördert werden, können zwei Mal jährlich im April und Oktober für das jeweils folgende Halbjahr per E-Mail beantragt werden.</p>\n   <p></p>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Regionen: Berlin Engagementbereiche: Kinder und Jugendliche Kultur, Medien und Musik Soziales Sport und Bewegung Max. Fördersumme: bis zu 1.000 Euro Bewerbungsfrist: Fortlaufende Förderung Förderanträge für Projekte ab 10.000 Euro können jedes Jahr von März bis Mai für das Folgejahr ausschließlich online über ein dann hier freigeschaltetes Portal gestellt werden. Kooperationsprojekte im Rahmen des Programms Stadtraum!Plus, die mit bis zu 1.000 Euro gefördert werden, können zwei Mal jährlich im April und Oktober für das jeweils folgende Halbjahr per E-Mail beantragt werden.".
_:n3-288934 a <http://www.w3.org/1999/xhtml#div>;
