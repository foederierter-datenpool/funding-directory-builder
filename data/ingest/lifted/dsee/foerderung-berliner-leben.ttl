    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/833-berliner-leben\" class=\"link\">Berliner Leben</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Alt-Moabit 101a,\n     <br>\n     10559 Berlin</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@stiftung-berliner-leben.de\">info@stiftung-berliner-leben.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.stiftung-berliner-leben.de\" target=\"_blank\">www.stiftung-berliner-leben.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>030 4708 2411</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/stiftung-berliner-leben_1.jpg\" width=\"800\" height=\"496\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Berliner Leben Alt-Moabit 101a, 10559 Berlin E-Mail info@stiftung-berliner-leben.de Webseite www.stiftung-berliner-leben.de Telefon 030 4708 2411".
