    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1495-stiftung-sport-region-halle\" class=\"link\">Stiftung Sport Region Halle</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Nietlebener Straße 14,\n     <br>\n     06126 Halle (Saale)</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:kontakt@stiftung-sport.de\">kontakt@stiftung-sport.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.stiftung-sport.de\" target=\"_blank\">www.stiftung-sport.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>017646049943</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Stiftung-Sport-Region-Halle.jpg\" width=\"800\" height=\"444\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Stiftung Sport Region Halle Nietlebener Straße 14, 06126 Halle (Saale) E-Mail kontakt@stiftung-sport.de Webseite www.stiftung-sport.de Telefon 017646049943".
