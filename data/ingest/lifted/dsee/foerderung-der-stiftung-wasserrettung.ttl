    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1640-stiftung-wasserrettung\" class=\"link\">Stiftung Wasserrettung</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Mühlhäuser Straße 305,\n     <br>\n     70378 Stuttgart</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@stiftung-wasserrettung.de\">info@stiftung-wasserrettung.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.stiftung-wasserrettung.de\" target=\"_blank\">www.stiftung-wasserrettung.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0711 95395015</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/logo_stiftung_wasserrettung.png\" width=\"799\" height=\"405\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Stiftung Wasserrettung Mühlhäuser Straße 305, 70378 Stuttgart E-Mail info@stiftung-wasserrettung.de Webseite www.stiftung-wasserrettung.de Telefon 0711 95395015".
