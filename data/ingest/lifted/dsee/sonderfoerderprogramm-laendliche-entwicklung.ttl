    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/22918-ministerium-fuer-umwelt-klima-mobilitaet-agrar-und-verbraucherschutz\" class=\"link\">Ministerium für Umwelt, Klima, Mobilität, Agrar und Verbraucherschutz</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Keplerstraße 18,\n     <br>\n     66117 Saarbrücken</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:poststelle@umwelt.saarland.de\">poststelle@umwelt.saarland.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.saarland.de/\" target=\"_blank\">www.saarland.de/</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0681 5014500</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Ministerium für Umwelt, Klima, Mobilität, Agrar und Verbraucherschutz Keplerstraße 18, 66117 Saarbrücken E-Mail poststelle@umwelt.saarland.de Webseite www.saarland.de/ Telefon 0681 5014500".
