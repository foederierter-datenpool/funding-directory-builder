    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1825-buergerstiftung-leverkusen\" class=\"link\">Bürgerstiftung Leverkusen</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Friedrich-Ebert-Straße 39,\n     <br>\n     51373 Leverkusen</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:mail@buergerstiftung-lev.de\">mail@buergerstiftung-lev.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.buergerstiftung-leverkusen.de\" target=\"_blank\">www.buergerstiftung-leverkusen.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0214 355 1111</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Logo_BS_gross.jpg\" width=\"800\" height=\"300\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Bürgerstiftung Leverkusen Friedrich-Ebert-Straße 39, 51373 Leverkusen E-Mail mail@buergerstiftung-lev.de Webseite www.buergerstiftung-leverkusen.de Telefon 0214 355 1111".
