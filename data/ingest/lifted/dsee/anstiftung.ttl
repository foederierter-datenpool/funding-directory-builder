                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<li><a href=\"https://anstiftung.de/foerderung\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Link zum Programm</a></li>\n<li><a href=\"https://anstiftung.de/images/jdownloads/sonstige/foerderrichtlinien_gaerten.pdf\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Förderrichtlinien für Gemeinschaftsgartenprojekte</a></li>\n<li><a href=\"https://anstiftung.de/images/jdownloads/sonstige/foerderrichtlinien_offene-werkstaetten.pdf\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Förderrichtlinien für Offene Werkstätten</a></li>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Link zum Programm Förderrichtlinien für Gemeinschaftsgartenprojekte Förderrichtlinien für Offene Werkstätten"
                                                                                                ];
                                                                                      <https://html.spec.whatwg.org/#innerHTML>
                                                                                              "<h3>Weitere Informationen</h3>\n<ul>\n <li><a href=\"https://anstiftung.de/foerderung\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Link zum Programm</a></li>\n <li><a href=\"https://anstiftung.de/images/jdownloads/sonstige/foerderrichtlinien_gaerten.pdf\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Förderrichtlinien für Gemeinschaftsgartenprojekte</a></li>\n <li><a href=\"https://anstiftung.de/images/jdownloads/sonstige/foerderrichtlinien_offene-werkstaetten.pdf\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Förderrichtlinien für Offene Werkstätten</a></li>\n</ul>";
                                                                                      <https://html.spec.whatwg.org/#innerText>
                                                                                              "Weitere Informationen Link zum Programm Förderrichtlinien für Gemeinschaftsgartenprojekte Förderrichtlinien für Offene Werkstätten"
