    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1050-brigitte-merk-erbe-stiftung-zur-foerderung-der-bayreuther-vereine\" class=\"link\">Brigitte Merk-Erbe Stiftung zur Förderung der Bayreuther Vereine</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Robert-Koch-Straße 20,\n     <br>\n     95447 Bayreuth</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@brigitte-merk-erbe-stiftung.de\">info@brigitte-merk-erbe-stiftung.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.brigitte-merk-erbe-stiftung.de\" target=\"_blank\">www.brigitte-merk-erbe-stiftung.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0921 7577890</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Brigitte-Merk-Erbe-Stiftung.jpg\" width=\"800\" height=\"206\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Brigitte Merk-Erbe Stiftung zur Förderung der Bayreuther Vereine Robert-Koch-Straße 20, 95447 Bayreuth E-Mail info@brigitte-merk-erbe-stiftung.de Webseite www.brigitte-merk-erbe-stiftung.de Telefon 0921 7577890".
