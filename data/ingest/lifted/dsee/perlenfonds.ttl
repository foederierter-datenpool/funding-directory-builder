    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/37920-joachim-herz-stiftung\" class=\"link\">Joachim Herz Stiftung</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Langenhorner Chaussee 384,\n     <br>\n     22419 Hamburg</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@joachim-herz-stiftung.de\">info@joachim-herz-stiftung.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.joachim-herz-stiftung.de/\" target=\"_blank\">www.joachim-herz-stiftung.de/</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>040 5332950</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Joachim Herz Stiftung Langenhorner Chaussee 384, 22419 Hamburg E-Mail info@joachim-herz-stiftung.de Webseite www.joachim-herz-stiftung.de/ Telefon 040 5332950".
