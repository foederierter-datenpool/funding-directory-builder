    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"grow\">\n <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/36424-brandenburgische-landeszentrale-fuer-politische-bildung\" class=\"link\">Brandenburgische Landeszentrale für politische Bildung</a></h2>\n <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n  <div>\n   <h3 class=\"font-bold\">E-Mail</h3>\n   <p><a href=\"mailto:Poststelle@LDA.Brandenburg.de\">Poststelle@LDA.Brandenburg.de</a></p>\n  </div>\n  <div>\n   <h3 class=\"font-bold\">Webseite</h3>\n   <p><a href=\"https://www.politische-bildung-brandenburg.de/\" target=\"_blank\">www.politische-bildung-brandenburg.de/</a></p>\n  </div>\n  <div>\n   <h3 class=\"font-bold\">Telefon</h3>\n   <p>033203 3560</p>\n  </div>\n </div>\n</div>";
