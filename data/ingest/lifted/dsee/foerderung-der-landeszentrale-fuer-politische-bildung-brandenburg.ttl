_:n3-182459 a <http://www.w3.org/1999/xhtml#p>;
    rdf:_1 _:n3-182460;
    rdf:_2 "Die Projekte dürfen noch nicht begonnen haben.";
    <https://html.spec.whatwg.org/#innerHTML> "<strong>Wichtig ist: </strong>Die Projekte dürfen noch nicht begonnen haben.";
    <https://html.spec.whatwg.org/#innerText> "Wichtig ist: Die Projekte dürfen noch nicht begonnen haben.".
_:n3-182460 a <http://www.w3.org/1999/xhtml#strong>;
