                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<li><a href=\"https://www.mhkbd.nrw/foerderprogramme/denkmalfoerderprogramm\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Link zum Programm</a></li>\n<li><a href=\"https://www.mhkbd.nrw/system/files/media/document/file/leitfaden_zur_denkmalfoerderung_nrw_2026.pdf\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Leitfaden zur Denkmalförderung</a></li>";
