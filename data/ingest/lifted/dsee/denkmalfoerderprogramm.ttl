                                                                                      rdf:_7    [ rdf:type  <http://www.w3.org/1999/xhtml#ul>;
                                                                                                  rdf:_1    [ rdf:type  <http://www.w3.org/1999/xhtml#li>;
                                                                                                              rdf:_1    "natürliche Personen (private Denkmaleigentümerinnen oder -eigentümer)&nbsp;";
                                                                                                              <http://www.w3.org/1999/xhtml#data-list-item-id>
                                                                                                                      "eeb5bca6fc6148d8b68378bea78ee43e2";
                                                                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                      "natürliche Personen (private Denkmaleigentümerinnen oder -eigentümer)&nbsp;";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "natürliche Personen (private Denkmaleigentümerinnen oder -eigentümer)"
                                                                                                            ];
                                                                                                  rdf:_2    [ rdf:type  <http://www.w3.org/1999/xhtml#li>;
                                                                                                              rdf:_1    "juristische Personen des privaten Rechts&nbsp;";
                                                                                                              <http://www.w3.org/1999/xhtml#data-list-item-id>
                                                                                                                      "e802405b199b2bf00019b888248a7158d";
                                                                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                      "juristische Personen des privaten Rechts&nbsp;";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "juristische Personen des privaten Rechts"
                                                                                                            ];
                                                                                                  rdf:_3    [ rdf:type  <http://www.w3.org/1999/xhtml#li>;
                                                                                                              rdf:_1    "Kirchen und Religionsgemeinschaften&nbsp;";
                                                                                                              <http://www.w3.org/1999/xhtml#data-list-item-id>
                                                                                                                      "e05189abe10a33f89f08254ff18dd81bf";
                                                                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                      "Kirchen und Religionsgemeinschaften&nbsp;";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "Kirchen und Religionsgemeinschaften"
                                                                                                            ];
                                                                                                  rdf:_4    [ rdf:type  <http://www.w3.org/1999/xhtml#li>;
                                                                                                              rdf:_1    "Gemeinden.&nbsp;";
                                                                                                              <http://www.w3.org/1999/xhtml#data-list-item-id>
                                                                                                                      "e07b19cc053362398766c40ea2c9fb5a6";
