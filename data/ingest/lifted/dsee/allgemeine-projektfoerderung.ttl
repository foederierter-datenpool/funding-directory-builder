    rdf:_2 _:n3-152822;
    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"mb-10 max-w-sm\">\n <figure class=\"ml-auto max-w-[600px]\">\n  <img src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/fs-sw.jpg\" width=\"800\" height=\"229\">\n </figure>\n</div>\n<div class=\"prose text-lg space-y-4\">\n <div>\n  <div class=\"font-bold\">Regionen:</div>\n  <div>Bundesweit</div>\n </div>\n <div>\n  <div class=\"font-bold\">Engagementbereiche:</div>\n  <div>\n   <ul>\n    <li>Kultur, Medien und Musik</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Förderfähige Kosten:</div>\n  <div>\n   <ul>\n    <li>Honorarkosten</li>\n    <li>Personalkosten</li>\n    <li>Sachkosten</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Max. Fördersumme:</div>\n  <div>Mindestens 3.000 € - maximal 30.000 €</div>\n </div>\n <div>\n  <div class=\"font-bold\">Eigenmittel benötigt:</div>\n  <div>Ja</div>\n </div>\n <div>\n  <div class=\"font-bold\">Bewerbungsfrist:</div>\n  <div class=\"mb-1\">\n   <ul>\n    <li>1. November 2026</li>\n    <li>1. Mai 2027</li>\n   </ul>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Regionen: Bundesweit Engagementbereiche: Kultur, Medien und Musik Förderfähige Kosten: Honorarkosten Personalkosten Sachkosten Max. Fördersumme: Mindestens 3.000 € - maximal 30.000 € Eigenmittel benötigt: Ja Bewerbungsfrist: 1. November 2026 1. Mai 2027".
