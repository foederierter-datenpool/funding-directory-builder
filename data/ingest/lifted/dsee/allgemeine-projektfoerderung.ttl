                                                                                                  rdf:_1    "Davon ausgenommen sind konzeptionelle Vorarbeiten wie die Suche nach Fördermöglichkeiten oder Kooperationspartner*innen.";
                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "Davon ausgenommen sind konzeptionelle Vorarbeiten wie die Suche nach Fördermöglichkeiten oder Kooperationspartner*innen.";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Davon ausgenommen sind konzeptionelle Vorarbeiten wie die Suche nach Fördermöglichkeiten oder Kooperationspartner*innen."
                                                                                                ];
