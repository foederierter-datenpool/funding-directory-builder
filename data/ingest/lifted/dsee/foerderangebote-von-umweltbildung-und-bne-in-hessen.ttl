_:n3-165305 a <http://www.w3.org/1999/xhtml#aside>;
    rdf:_1 _:n3-165306;
    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"prose text-lg space-y-4\">\n <div>\n  <div class=\"font-bold\">Regionen:</div>\n  <div>\n   <ul>\n    <li>Hessen</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Engagementbereiche:</div>\n  <div>\n   <ul>\n    <li>Umwelt-/Naturschutz, Klimaschutz und Tierschutz</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Bewerbungsfrist:</div>\n  <div class=\"mb-1\">\n   <ul>\n    <li>31. März 2027</li>\n    <li>31. August 2027</li>\n   </ul>\n  </div>\n  <div class=\"prose text-base\">\n   <p>Bis zum 31.08. eines Jahres für das 1. Halbjahr des Folgejahres.</p>\n   <p>bis zum 31.3. für das 2. Halbjahr des Kalenderjahres.</p>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Regionen: Hessen Engagementbereiche: Umwelt-/Naturschutz, Klimaschutz und Tierschutz Bewerbungsfrist: 31. März 2027 31. August 2027 Bis zum 31.08. eines Jahres für das 1. Halbjahr des Folgejahres. bis zum 31.3. für das 2. Halbjahr des Kalenderjahres.".
