    rdf:_1 _:n3-245983;
    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"prose text-lg space-y-4\">\n <div>\n  <div class=\"font-bold\">Regionen:</div>\n  <div>\n   <ul>\n    <li>Nordrhein-Westfalen</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Engagementbereiche:</div>\n  <div>\n   <ul>\n    <li>Bildung für nachhaltige Entwicklung</li>\n    <li>Umwelt-/Naturschutz, Klimaschutz und Tierschutz</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Förderfähige Kosten:</div>\n  <div>\n   <ul>\n    <li>Bau- und Investkosten</li>\n    <li>Honorarkosten</li>\n    <li>Personalkosten</li>\n    <li>Sachkosten</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Max. Fördersumme:</div>\n  <div>200.000 €</div>\n </div>\n <div>\n  <div class=\"font-bold\">Eigenmittel benötigt:</div>\n  <div>Ja</div>\n </div>\n <div>\n  <div class=\"font-bold\">Bewerbungsfrist:</div>\n  <div class=\"mb-1\">Fortlaufende Förderung</div>\n  <div class=\"prose text-base\">\n   <p>Anträge bis 10.000€ können jederzeit eingereicht werden. Für Anträge über 10.000€&nbsp;gelten je nach Höhe der Fördersumme&nbsp;verschiedene Fristen (siehe Webseite).&nbsp;</p>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Regionen: Nordrhein-Westfalen Engagementbereiche: Bildung für nachhaltige Entwicklung Umwelt-/Naturschutz, Klimaschutz und Tierschutz Förderfähige Kosten: Bau- und Investkosten Honorarkosten Personalkosten Sachkosten Max. Fördersumme: 200.000 € Eigenmittel benötigt: Ja Bewerbungsfrist: Fortlaufende Förderung Anträge bis 10.000€ können jederzeit eingereicht werden. Für Anträge über 10.000€ gelten je nach Höhe der Fördersumme verschiedene Fristen (siehe Webseite).".
_:n3-245983 a <http://www.w3.org/1999/xhtml#div>;
