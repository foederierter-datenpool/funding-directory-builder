                                                                                                              rdf:_6    [ rdf:type  <http://www.w3.org/1999/xhtml#br> ];
                                                                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                      "Gefördert werden in sich geschlossene, noch nicht begonnene Projekte einmalig mit bis zu 1.500 Euro. \n<br>\n<br>\nMehr Informationen und Ideen gibt es auf der Projektwebseite unter: <a href=\"https://www.aktiv-pro-klima.de/\" target=\"_blank\" rel=\"noreferrer noopener\">aktiv-pro-klima.de</a>\n<br>";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "Gefördert werden in sich geschlossene, noch nicht begonnene Projekte einmalig mit bis zu 1.500 Euro.  Mehr Informationen und Ideen gibt es auf der Projektwebseite unter: aktiv-pro-klima.de"
                                                                                                            ];
