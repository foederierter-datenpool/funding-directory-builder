                                                                                      <https://html.spec.whatwg.org/#innerHTML>
                                                                                              "<h3>Weitere Informationen</h3>\n<ul>\n <li><a href=\"https://www.buergerfonds.eu/schwerpunkt-demokratie-2025-2026\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Link zum Programm</a></li>\n</ul>";
                                                                                      <https://html.spec.whatwg.org/#innerText>
