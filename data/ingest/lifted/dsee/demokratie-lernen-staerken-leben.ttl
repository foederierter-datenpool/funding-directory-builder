                                                                                      rdf:_5    [ rdf:type  <http://www.w3.org/1999/xhtml#p>;
                                                                                                  rdf:_1    "Der Bürgerfonds fördert Projekte, die demokratische Prinzipien durch Aktionen mit möglichst viel Sichtbarkeit und Impact ins Zentrum rücken&nbsp;und eine demokratische Haltung in der Öffentlichkeit vertreten.";
                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "Der Bürgerfonds fördert Projekte, die demokratische Prinzipien durch Aktionen mit möglichst viel Sichtbarkeit und Impact ins Zentrum rücken&nbsp;und eine demokratische Haltung in der Öffentlichkeit vertreten.";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Der Bürgerfonds fördert Projekte, die demokratische Prinzipien durch Aktionen mit möglichst viel Sichtbarkeit und Impact ins Zentrum rücken und eine demokratische Haltung in der Öffentlichkeit vertreten."
                                                                                                ];
                                                                                      rdf:_6    [ rdf:type  <http://www.w3.org/1999/xhtml#h3>;
                                                                                                  rdf:_1    "III – Demokratie leben";
                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "III – Demokratie leben";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "III – Demokratie leben"
                                                                                                ];
                                                                                      rdf:_7    [ rdf:type  <http://www.w3.org/1999/xhtml#p>;
                                                                                                  rdf:_1    "Der Bürgerfonds fördert Projekte, die selbst Methoden für mehr Teilhabe anwenden und Teilnehmenden somit ermöglichen, Demokratie aktiv zu er-leben sowie Selbstwirksamkeit zu spüren.";
                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "Der Bürgerfonds fördert Projekte, die selbst Methoden für mehr Teilhabe anwenden und Teilnehmenden somit ermöglichen, Demokratie aktiv zu er-leben sowie Selbstwirksamkeit zu spüren.";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Der Bürgerfonds fördert Projekte, die selbst Methoden für mehr Teilhabe anwenden und Teilnehmenden somit ermöglichen, Demokratie aktiv zu er-leben sowie Selbstwirksamkeit zu spüren."
                                                                                                ];
                                                                                      <https://html.spec.whatwg.org/#innerHTML>
                                                                                              "<h3>Zielgruppen/Bedingungen</h3>\n<h3>I – Demokratie lernen</h3>\n<p>Der Bürgerfonds fördert Projekte, die vermitteln, wie Demokratie funktioniert.</p>\n<h3>II – Demokratie stärken</h3>\n<p>Der Bürgerfonds fördert Projekte, die demokratische Prinzipien durch Aktionen mit möglichst viel Sichtbarkeit und Impact ins Zentrum rücken&nbsp;und eine demokratische Haltung in der Öffentlichkeit vertreten.</p>\n<h3>III – Demokratie leben</h3>\n<p>Der Bürgerfonds fördert Projekte, die selbst Methoden für mehr Teilhabe anwenden und Teilnehmenden somit ermöglichen, Demokratie aktiv zu er-leben sowie Selbstwirksamkeit zu spüren.</p>";
                                                                                      <https://html.spec.whatwg.org/#innerText>
                                                                                              "Zielgruppen/Bedingungen I – Demokratie lernen Der Bürgerfonds fördert Projekte, die vermitteln, wie Demokratie funktioniert. II – Demokratie stärken Der Bürgerfonds fördert Projekte, die demokratische Prinzipien durch Aktionen mit möglichst viel Sichtbarkeit und Impact ins Zentrum rücken und eine demokratische Haltung in der Öffentlichkeit vertreten. III – Demokratie leben Der Bürgerfonds fördert Projekte, die selbst Methoden für mehr Teilhabe anwenden und Teilnehmenden somit ermöglichen, Demokratie aktiv zu er-leben sowie Selbstwirksamkeit zu spüren."
                                                                                    ];
