                                                                      "<div class=\"grow\">\n <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/21107-deutsch-franzoesischer-buergerfonds\" class=\"link\">Deutsch-Französischer Bürgerfonds</a></h2>\n <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n  <div>\n   <p>Sophienstraße 28/29,\n    <br>\n    10178 Berlin</p>\n  </div>\n  <div>\n   <h3 class=\"font-bold\">E-Mail</h3>\n   <p><a href=\"mailto:info@buergerfonds.eu\">info@buergerfonds.eu</a></p>\n  </div>\n  <div>\n   <h3 class=\"font-bold\">Webseite</h3>\n   <p><a href=\"https://www.buergerfonds.eu/\" target=\"_blank\">www.buergerfonds.eu/</a></p>\n  </div>\n  <div>\n   <h3 class=\"font-bold\">Telefon</h3>\n   <p>030 800931231</p>\n  </div>\n </div>\n</div>\n<div class=\"md:w-1/3\">\n <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/logo_dfbfonds_rgb_transparent.png\" width=\"800\" height=\"593\">\n</div>";
