                                                                                      rdf:_1    [ rdf:type  <http://www.w3.org/1999/xhtml#p>;
                                                                                                  rdf:_1    "Im Zuge zahlreicher Herausforderungen und Transformationen für unsere Gesellschaften geraten ";
                                                                                                  rdf:_2    [ rdf:type  <http://www.w3.org/1999/xhtml#strong>;
                                                                                                              rdf:_1    "demokratische Institutionen, Akteure und Werte unter Druck";
