    rdf:_1 _:n3-282145;
    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"prose text-lg space-y-4\">\n <div>\n  <div class=\"font-bold\">Regionen:</div>\n  <div>Bundesweit</div>\n </div>\n <div>\n  <div class=\"font-bold\">Engagementbereiche:</div>\n  <div>\n   <ul>\n    <li>Kinder und Jugendliche</li>\n    <li>Sonstiges</li>\n   </ul>\n  </div>\n </div>\n <div>\n  <div class=\"font-bold\">Max. Fördersumme:</div>\n  <div>Bis zu 100,00 % (max. 400.000,00 €), Je Begleitperson für Teilnehmende mit Behinderung pro Tag 80 Euro Je Begleitperson und für Teilnehmende ohne Behinderung pro Tag 50 Euro</div>\n </div>\n <div>\n  <div class=\"font-bold\">Eigenmittel benötigt:</div>\n  <div>Nein</div>\n </div>\n <div>\n  <div class=\"font-bold\">Bewerbungsfrist:</div>\n  <div class=\"mb-1\">Fortlaufende Förderung</div>\n </div>\n <div>\n  <div class=\"font-bold\">Vorzeitiger Maßnahmebeginn:</div>\n  <div>Ja</div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Regionen: Bundesweit Engagementbereiche: Kinder und Jugendliche Sonstiges Max. Fördersumme: Bis zu 100,00 % (max. 400.000,00 €), Je Begleitperson für Teilnehmende mit Behinderung pro Tag 80 Euro Je Begleitperson und für Teilnehmende ohne Behinderung pro Tag 50 Euro Eigenmittel benötigt: Nein Bewerbungsfrist: Fortlaufende Förderung Vorzeitiger Maßnahmebeginn: Ja".
