    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/222-heiner-rust-stiftung\" class=\"link\">Heiner Rust Stiftung</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Ferdinand-Wilhelm-Fricke-Weg 10,\n     <br>\n     30169 Hannover</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@heiner-rust-stiftung.de\">info@heiner-rust-stiftung.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.heiner-rust-stiftung.de\" target=\"_blank\">www.heiner-rust-stiftung.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0511 12685100</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/heiner-rust-stiftung-logo-mit-claim_kl.jpg\" width=\"799\" height=\"398\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Heiner Rust Stiftung Ferdinand-Wilhelm-Fricke-Weg 10, 30169 Hannover E-Mail info@heiner-rust-stiftung.de Webseite www.heiner-rust-stiftung.de Telefon 0511 12685100".
