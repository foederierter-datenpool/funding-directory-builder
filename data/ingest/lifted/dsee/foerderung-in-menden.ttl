or(const o of e.querySelectorAll(\"link[rel=modulepreload]\"))r(o)})).observe(document,{childList:!0,subtree:!0})}function r(e){if(e.ep)return;e.ep=!0;const r=function(e){const r={};return e.integrity&&(r.integrity=e.integrity),e.referrerpolicy&&(r.referrerPolicy=e.referrerpolicy),\"use-credentials\"===e.crossorigin?r.credentials=\"include\":\"anonymous\"===e.crossorigin?r.credentials=\"omit\":r.credentials=\"same-origin\",r}(e);fetch(e.href,r)}}();</script>\n<script type=\"module\" src=\"https://foerderdatenbank.d-s-e-e.de/dist/assets/app-DB5ScF6h.js\" crossorigin onload=\"e=new CustomEvent('vite-script-loaded', {detail:{path: 'resources/js/main.js'}});document.dispatchEvent(e);\"></script>\n<link href=\"https://foerderdatenbank.d-s-e-e.de/dist/assets/app-ClfkFxNO.css\" rel=\"stylesheet\"> \n<div class=\"container flex flex-row justify-end my-4\">\n <div class=\"flex flex-row flex-wrap items-center -mx-1 select-none cursor-default\">\n  <nav class=\"flex flex-row my-2\">\n   <a class=\"block mr-2 md:mr-6 p-1 opacity-70 hover:opacity-100 focus:opacity-100 transition-opacity\" href=\"https://www.deutsche-stiftung-engagement-und-ehrenamt.de/newsletter/\">Newsletter</a>\n  </nav>\n  <div class=\"flex flex-row divide-x my-2\">\n   <a href=\"https://x.com/d_s_e_e\" title=\"X\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-x.svg\" width=\"24\" height=\"24\" alt=\"Logo X\"> <span class=\"sr-only\">X</span> </a><a href=\"https://www.facebook.com/EngagementStiftung/\" title=\"Facebook\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-facebook.svg\" width=\"24\" height=\"24\" alt=\"Logo Facebook\"> <span class=\"sr-only\">Facebook</span> </a> <a href=\"https://www.instagram.com/engagement_und_ehrenamt/\" title=\"Instagram\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-instagram.svg\" width=\"24\" height=\"24\" alt=\"Logo Instagram\"> <span class=\"sr-only\">Instagram</span> </a> <a href=\"https://www.linkedin.com/company/dsee/\" title=\"LinkedIn\" target=\"_blank\" class=\"group block p-1\"> <img class=\"w-6 opacity-50 group-focus:opacity-100 group-hover:opacity-100 transition-opacity\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/icon-linkedin.svg\" width=\"24\" height=\"24\" alt=\"Logo LinkedIn\"> <span class=\"sr-only\">LinkedIn</span> </a>\n  </div>\n </div>\n</div>\n<header class=\"container my-4 flex flex-row flex-wrap justify-between items-end select-none cursor-default\">\n <a href=\"https://foerderdatenbank.d-s-e-e.de/\" class=\"block my-2 w-full max-w-md\"> <span class=\"sr-only\">Zur Startseite</span><img src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/2023_DSEE_Logo_3zlg_RGB_Basis_large.svg\" width=\"300\" height=\"92\" alt=\"Logo Deutsche Stiftung für Engagement und Ehrenamt\" fetchpriority=\"high\"></a>\n <p class=\"my-2 font-medium text-2xl\">Förderdatenbank der DSEE</p>\n</header>\n<main class=\"my-8\">\n <nav class=\"container\">\n  <div class=\"my-8 py-3 border-t-2 border-gray select-none cursor-default\">\n   <a class=\"link\" href=\"https://foerderdatenbank.d-s-e-e.de/\">Förderdatenbank der DSEE</a><span class=\"px-1 text-gray\">&gt;</span><span>Förderung in Menden</span>\n  </div>\n </nav>\n <article class=\"container\">\n  <div class=\"grid lg:grid-cols-3 gap-16\">\n   <div class=\"col-span-2 space-y-4\">\n    <header class=\"mb-8\">\n     <h1 class=\"col-span-2 font-bold text-2xl\">Förderung in Menden</h1>\n    </header>\n    <div class=\"prose text-lg mb-8 space-y-6\">\n     <div>\n      <p>Für die Bürger der Stadt Hemer - Zweck der Stiftung der Sparkasse Märkisches Sauerland Hemer-Menden ist die Förderung von Kunst und Kultur, der Denkmal- und Heimatpflege, der Förderung der Jugend- und Altenhilfe, der Erziehung, Volks- und Berufsbildung, der Studentenhilfe und des Sports.</p>\n     </div>\n     <div>\n      <h3>Zielgruppen/Bedingungen</h3>\n      <p>Folgendes wird von der Stiftung gefördert:&nbsp;</p>\n      <ul>\n       <li>Errichtung und Unterhaltung von Kindergärten, Kinder- und Jugendheimen, Jugendherbergen, Altenwohn- und Pflegeheimen, Behindertenheimen und Sozialstationen</li>\n       <li>Errichtung und Unterhaltung von Sportstätten und Sportanlagen, Beschaffung von Sportgeräten und Sportbekleidung</li>\n       <li>Förderung junger Künstler (z. B. durch Vergabe von Stipendien an förderungswürdige Künstler, Veranstaltung von Ausstellungen und Konzerten)</li>\n       <li>Erwerb von Skulpturen, Plastiken und Gemälden</li>\n       <li>Restaurierung von Kunstwerken und Denkmälern</li>\n       <li>Stiftung von Kunst- und Kulturpreisen</li>\n       <li>Durchführung kultureller Veranstaltungen (z. B. Musik- und Theateraufführungen)</li>\n       <li>Vergabe wissenschaftlicher Forschungsaufträge und Durchführung wissenschaftlicher Veranstaltungen</li>\n       <li>Maßnahmen zur Erhaltung oder Wiederherstellung der natürlichen Lebensgrundlagen von Menschen, Tieren und Pflanzen</li>\n      </ul>\n     </div>\n     <div>\n      <h3>Weitere Informationen</h3>\n      <ul>\n       <li><a href=\"https://www.sms-hm.de/de/home/ihre-sparkasse/ihre-sparkasse-vor-ort/stiftung-in-hemer1.html?q=stiftung&amp;mdidianlass=&amp;mdidiansprache=&amp;n=true&amp;stref=search\" class=\"link\" target=\"_blank\" rel=\"noindex nofollow\">Link zur Stiftung</a></li>\n      </ul>\n     </div>\n    </div>\n   </div>\n   <aside>\n    <div class=\"prose text-lg space-y-4\">\n     <div>\n      <div class=\"font-bold\">Regionen:</div>\n      <div>\n       <ul>\n        <li>Nordrhein-Westfalen</li>\n       </ul>\n      </div>\n     </div>\n     <div>\n      <div class=\"font-bold\">Engagementbereiche:</div>\n      <div>\n       <ul>\n        <li>Bauten und Denkmalschutz</li>\n        <li>Bildung</li>\n        <li>Kinder und Jugendliche</li>\n        <li>Kultur, Medien und Musik</li>\n        <li>Soziales</li>\n        <li>Sport und Bewegung</li>\n        <li>Sonstiges</li>\n       </ul>\n      </div>\n     </div>\n     <div>\n      <div class=\"font-bold\">Bewerbungsfrist:</div>\n      <div class=\"mb-1\">Fortlaufende Förderung</div>\n     </div>\n    </div>\n   </aside>\n  </div>\n  <div class=\"px-5 py-3 border-2 rounded-lg mt-16 px-6 py-6 border-gray\">\n   <div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n    <div class=\"grow\">\n     <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1888-stiftung-der-sparkasse-maerkisches-sauerland-hemer-menden-fuer-die-stadt-menden\" class=\"link\">Stiftung der Sparkasse Märkisches Sauerland Hemer-Menden für die Stadt Menden</a></h2>\n     <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n      <div>\n       <p>Papenhausenstr. 15,\n        <br>\n        58706 Menden</p>\n      </div>\n      <div>\n       <h3 class=\"font-bold\">E-Mail</h3>\n       <p><a href=\"mailto:stiftung-menden@sms-hm.de\">stiftung-menden@sms-hm.de</a></p>\n      </div>\n      <div>\n       <h3 class=\"font-bold\">Webseite</h3>\n       <p><a href=\"https://www.sms-hm.de/de/home/ihre-sparkasse/ihre-sparkasse-vor-ort/stiftung-in-hemer1.html?n=true&amp;stref=search&amp;q=stiftung&amp;mdidianlass=&amp;mdidiansprache=\" target=\"_blank\">www.sms-hm.de/de/home/ihre-sparkasse/ihre-sparkasse-vor-ort/stiftung-in-hemer1.html?n=true&amp;stref=search&amp;q=stiftung&amp;mdidianlass=&amp;mdidiansprache=</a></p>\n      </div>\n      <div>\n       <h3 class=\"font-bold\">Telefon</h3>\n       <p>02373 1623201</p>\n      </div>\n     </div>\n    </div>\n    <div class=\"md:w-1/3\">\n     <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Stiftung-der-Sparkasse-Märkisches-Sauerland-Hemer-Menden-für-die-Stadt-Menden.jpg\" width=\"800\" height=\"313\">\n    </div>\n   </div>\n  </div>\n </article>\n</main>\n<footer class=\"container mt-24\">\n <div class=\"flex flex-row flex-wrap justify-between items-center py-12 border-t-2 border-yellow select-none cursor-default\">\n  <nav class=\"flex flex-row flex-wrap -mx-1\">\n   <p class=\"mr-6 p-1 opacity-70\">©2026</p>\n   <a class=\"block mr-6 p-1 opacity-70 hover:opacity-100 focus:opacity-100 transition-opacity\" href=\"https://foerderdatenbank.d-s-e-e.de/impressum\">Impressum</a><a class=\"block mr-6 p-1 opacity-70 hover:opacity-100 focus:opacity-100 transition-opacity\" href=\"https://www.deutsche-stiftung-engagement-und-ehrenamt.de/datenschutzerklaerung/\">Datenschutzerklärung</a>\n  </nav>\n  <div class=\"max-w-[240px]\">\n   <img src=\"https://foerderdatenbank.d-s-e-e.de/volumes/public/2023_DSEE_Logo_3zlg_RGB_Basis_large.svg\" width=\"300\" height=\"92\" alt=\"Logo Deutsche Stiftung für Engagement und Ehrenamt\">\n  </div>\n </div>\n</footer>\n<script>\n  var _paq = window._paq = window._paq || [];\n  /* tracker methods like \"setCustomDimension\" should be called before \"trackPageView\" */\n  _paq.push(['trackPageView']);\n  _paq.push(['enableLinkTracking']);\n  (function() {\n    var u=\"//matomo.deutsche-stiftung-engagement-und-ehrenamt.de/\";\n    _paq.push(['setTrackerUrl', u+'matomo.php']);\n    _paq.push(['setSiteId', '4']);\n    var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];\n    g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);\n  })();\n</script>";
    <https://html.spec.whatwg.org/#innerText> "Förderung in Menden  –  Förderdatenbank Newsletter X Facebook Instagram LinkedIn Zur Startseite Förderdatenbank der DSEE Förderdatenbank der DSEE>Förderung in Menden Förderung in Menden Für die Bürger der Stadt Hemer - Zweck der Stiftung der Sparkasse Märkisches Sauerland Hemer-Menden ist die Förderung von Kunst und Kultur, der Denkmal- und Heimatpflege, der Förderung der Jugend- und Altenhilfe, der Erziehung, Volks- und Berufsbildung, der Studentenhilfe und des Sports. Zielgruppen/Bedingungen Folgendes wird von der Stiftung gefördert: Errichtung und Unterhaltung von Kindergärten, Kinder- und Jugendheimen, Jugendherbergen, Altenwohn- und Pflegeheimen, Behindertenheimen und Sozialstationen Errichtung und Unterhaltung von Sportstätten und Sportanlagen, Beschaffung von Sportgeräten und Sportbekleidung Förderung junger Künstler (z. B. durch Vergabe von Stipendien an förderungswürdige Künstler, Veranstaltung von Ausstellungen und Konzerten) Erwerb von Skulpturen, Plastiken und Gemälden Restaurierung von Kunstwerken und Denkmälern Stiftung von Kunst- und Kulturpreisen Durchführung kultureller Veranstaltungen (z. B. Musik- und Theateraufführungen) Vergabe wissenschaftlicher Forschungsaufträge und Durchführung wissenschaftlicher Veranstaltungen Maßnahmen zur Erhaltung oder Wiederherstellung der natürlichen Lebensgrundlagen von Menschen, Tieren und Pflanzen Weitere Informationen Link zur Stiftung Regionen: Nordrhein-Westfalen Engagementbereiche: Bauten und Denkmalschutz Bildung Kinder und Jugendliche Kultur, Medien und Musik Soziales Sport und Bewegung Sonstiges Bewerbungsfrist: Fortlaufende Förderung Stiftung der Sparkasse Märkisches Sauerland Hemer-Menden für die Stadt Menden Papenhausenstr. 15, 58706 Menden E-Mail stiftung-menden@sms-hm.de Webseite www.sms-hm.de/de/home/ihre-sparkasse/ihre-sparkasse-vor-ort/stiftung-in-hemer1.html?n=true&stref=search&q=stiftung&mdidianlass=&mdidiansprache= Telefon 02373 1623201 ©2026 Impressum Datenschutzerklärung".
