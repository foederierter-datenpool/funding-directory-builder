    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/3167-buergerstiftung-oberasbach\" class=\"link\">Bürgerstiftung Oberasbach</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Farnstraße 4,\n     <br>\n     90522 Oberasbach</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:buergerstiftung@oberasbach.de\">buergerstiftung@oberasbach.de</a></p>\n   </div>\n  </div>\n </div>\n</div>";
