    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/3103-die-chancenstiftung-bildungspaten-fuer-deutschland\" class=\"link\">Die Chancenstiftung Bildungspaten für Deutschland</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Oranienstraße 185,\n     <br>\n     10999 Berlin</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:cb@chrboersch.de\">cb@chrboersch.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.chancenstiftung.de\" target=\"_blank\">www.chancenstiftung.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0172 28 30 047</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Die Chancenstiftung Bildungspaten für Deutschland Oranienstraße 185, 10999 Berlin E-Mail cb@chrboersch.de Webseite www.chancenstiftung.de Telefon 0172 28 30 047".
