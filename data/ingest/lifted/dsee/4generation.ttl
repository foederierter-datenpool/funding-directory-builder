                                                                                                ];
                                                                                      rdf:_2    [ rdf:type  <http://www.w3.org/1999/xhtml#p>;
                                                                                                  rdf:_1    "LAUFZEIT";
                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "LAUFZEIT";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "LAUFZEIT"
                                                                                                ];
                                                                                      rdf:_3    [ rdf:type  <http://www.w3.org/1999/xhtml#p>;
                                                                                                  rdf:_1    "Die Laufzeit beträgt für die Vorbereitungs-, Durchführungs- und Nachbereitungsphase mindestens 3 und höchstens 24 Monate.";
                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "Die Laufzeit beträgt für die Vorbereitungs-, Durchführungs- und Nachbereitungsphase mindestens 3 und höchstens 24 Monate.";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Die Laufzeit beträgt für die Vorbereitungs-, Durchführungs- und Nachbereitungsphase mindestens 3 und höchstens 24 Monate."
                                                                                                ];
                                                                                      rdf:_4    [ rdf:type  <http://www.w3.org/1999/xhtml#p>;
                                                                                                  rdf:_1    "FÖRDERSUMME";
                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "FÖRDERSUMME";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "FÖRDERSUMME"
                                                                                                ];
                                                                                      rdf:_5    [ rdf:type  <http://www.w3.org/1999/xhtml#p>;
                                                                                                  rdf:_1    "Innerhalb dieser Zeitspanne steht dem Projekt eine Fördersumme von 1.500€ bis maximal 10.000€ pro Laufzeitjahr zur Verfügung.&nbsp;";
                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "Innerhalb dieser Zeitspanne steht dem Projekt eine Fördersumme von 1.500€ bis maximal 10.000€ pro Laufzeitjahr zur Verfügung.&nbsp;";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Innerhalb dieser Zeitspanne steht dem Projekt eine Fördersumme von 1.500€ bis maximal 10.000€ pro Laufzeitjahr zur Verfügung."
                                                                                                ];
                                                                                      <https://html.spec.whatwg.org/#innerHTML>
                                                                                              "<h3>Zielgruppen/Bedingungen</h3>\n<p>LAUFZEIT</p>\n<p>Die Laufzeit beträgt für die Vorbereitungs-, Durchführungs- und Nachbereitungsphase mindestens 3 und höchstens 24 Monate.</p>\n<p>FÖRDERSUMME</p>\n<p>Innerhalb dieser Zeitspanne steht dem Projekt eine Fördersumme von 1.500€ bis maximal 10.000€ pro Laufzeitjahr zur Verfügung.&nbsp;</p>";
                                                                                      <https://html.spec.whatwg.org/#innerText>
                                                                                              "Zielgruppen/Bedingungen LAUFZEIT Die Laufzeit beträgt für die Vorbereitungs-, Durchführungs- und Nachbereitungsphase mindestens 3 und höchstens 24 Monate. FÖRDERSUMME Innerhalb dieser Zeitspanne steht dem Projekt eine Fördersumme von 1.500€ bis maximal 10.000€ pro Laufzeitjahr zur Verfügung."
                                                                                    ];
                                                                          rdf:_3    [ rdf:type  <http://www.w3.org/1999/xhtml#div>;
                                                                                      rdf:_1    [ rdf:type  <http://www.w3.org/1999/xhtml#h3>;
