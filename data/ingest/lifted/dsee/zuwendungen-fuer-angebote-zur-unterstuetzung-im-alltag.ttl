    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/36331-ministerium-fuer-arbeit-soziales-transformation-und-digitalisierung-des-landes-rheinland-pfalz\" class=\"link\">Ministerium für Arbeit, Soziales, Transformation und Digitalisierung des Landes Rheinland-Pfalz</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Bauhofstr. 9,\n     <br>\n     55116 Mainz</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:poststelle@mastd.rlp.de\">poststelle@mastd.rlp.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://mastd.rlp.de/\" target=\"_blank\">mastd.rlp.de/</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>06131 162027</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Ministerium für Arbeit, Soziales, Transformation und Digitalisierung des Landes Rheinland-Pfalz Bauhofstr. 9, 55116 Mainz E-Mail poststelle@mastd.rlp.de Webseite mastd.rlp.de/ Telefon 06131 162027".
