    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/895-buerger-stiftung-stormarn\" class=\"link\">Bürger-Stiftung Stormarn</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Hagenstraße 19,\n     <br>\n     23843 Bad Oldesloe</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@buerger-stiftung-stormarn.de\">info@buerger-stiftung-stormarn.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.buerger-stiftung-stormarn.de\" target=\"_blank\">www.buerger-stiftung-stormarn.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>04537 7070013</p>\n   </div>\n  </div>\n </div>\n <div class=\"md:w-1/3\">\n  <img class=\"w-full max-w-[360px] mx-auto\" src=\"https://foerderdatenbank.d-s-e-e.de/volumes/profiles/_article_m/Bürgerstiftun-Stormarn.png\" width=\"800\" height=\"544\">\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Bürger-Stiftung Stormarn Hagenstraße 19, 23843 Bad Oldesloe E-Mail info@buerger-stiftung-stormarn.de Webseite www.buerger-stiftung-stormarn.de Telefon 04537 7070013".
