    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/32295-lotto-toto-gmbh-sachsen-anhalt\" class=\"link\">Lotto-Toto GmbH Sachsen-Anhalt</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:projektfoerderung@sachsen-anhalt-lotto.de\">projektfoerderung@sachsen-anhalt-lotto.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"https://www.lottosachsenanhalt.de/home?gbn=11\" target=\"_blank\">www.lottosachsenanhalt.de/home?gbn=11</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0391 5963150</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Lotto-Toto GmbH Sachsen-Anhalt E-Mail projektfoerderung@sachsen-anhalt-lotto.de Webseite www.lottosachsenanhalt.de/home?gbn=11 Telefon 0391 5963150".
