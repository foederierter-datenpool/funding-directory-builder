    <https://html.spec.whatwg.org/#innerHTML> "<div class=\"space-y-4 text-lg md:flex flex-row gap-12\">\n <div class=\"grow\">\n  <h2 class=\"mb-8 font-bold text-2xl\"><a href=\"https://foerderdatenbank.d-s-e-e.de/institutionen/1096-buergerstiftung-donaueschingen\" class=\"link\">Bürgerstiftung Donaueschingen</a></h2>\n  <div class=\"grid lg:grid-cols-2 grid-flow-row gap-x-8 gap-y-6\">\n   <div>\n    <p>Pfaffenhoffenstraße 4,\n     <br>\n     78166 Donaueschingen</p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">E-Mail</h3>\n    <p><a href=\"mailto:info@buergerstiftung-donaueschingen.de\">info@buergerstiftung-donaueschingen.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Webseite</h3>\n    <p><a href=\"http://www.buergerstiftung-donaueschingen.de\" target=\"_blank\">www.buergerstiftung-donaueschingen.de</a></p>\n   </div>\n   <div>\n    <h3 class=\"font-bold\">Telefon</h3>\n    <p>0771 2576</p>\n   </div>\n  </div>\n </div>\n</div>";
    <https://html.spec.whatwg.org/#innerText> "Bürgerstiftung Donaueschingen Pfaffenhoffenstraße 4, 78166 Donaueschingen E-Mail info@buergerstiftung-donaueschingen.de Webseite www.buergerstiftung-donaueschingen.de Telefon 0771 2576".
