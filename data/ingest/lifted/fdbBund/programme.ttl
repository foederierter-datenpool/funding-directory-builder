              xyz:id_hash                   "0170b053e96d6431432c6c3435c10d00";
              xyz:id_url                    "land-nrw-beteiligungskapital-fuer-kmu";
              xyz:keywords                  "Kapital Unternehmen Beteiligung Investition Finanzierung beteiligen";
              xyz:keywords_extracted        [ rdf:_1  "Kapital";
                                              rdf:_2  "Unternehmen";
