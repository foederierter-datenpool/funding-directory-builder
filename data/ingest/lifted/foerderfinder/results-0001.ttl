                                                                                                                                           xyz:erforderlicheUnterlagen  [ xyz:dokument  [ rdf:_1  [ xyz:bezeichnung   "Finanzierungsplan für den beantragten Förderzeitraum";
                                                                                                                                                                                                    xyz:erlaeuterung  "Bei Erstantragstellung empfiehlt es sich an den zuständigen Spitzenverband oder Landesverband oder an den örtlich zuständigen Bezirk zu wenden (siehe Links unter der Rubrik weiterführende Informationen)."
                                                                                                                                                                                                  ];
