                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>e51126eb-97a8-4015-b96b-c4e39b302630</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-06-18T10:49:46</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>e51126eb-97a8-4015-b96b-c4e39b302630</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>e51126eb-97a8-4015-b96b-c4e39b302630</xflb:schluessel>\n         <xflb:versionFLB>3</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-06-18T10:49:46</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>e51126eb-97a8-4015-b96b-c4e39b302630</xflb:foerderschluessel>\n                  <xflb:flbVersion>3</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400030017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Förderung von Baumaßnahmen an öffentlichen Schulen und Schulsportanlagen</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Im Rahmen des kommunalen Finanzausgleichs unterstützt der Freistaat Bayern seine Kommunen bei Baumaßnahmen an öffentlichen Schulen und schulisch bedarfsnotwendigen Sportanlagen mit Zuweisungen nach Art. 10 des Bayerischen Finanzausgleichsgesetzes (BayFAG).&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat gewährt auf Antrag Zuweisungen zu kommunalen Baumaßnahmen an Schulgebäuden öffentlicher Schulen und Schulsportanlagen, wenn sie schulaufsichtlich genehmigt sind.</xflb:teaser>\n                  <xflb:schluesselwoerter>\"Förderung von Baumaßnahmen\", \"Art. 10 BayFAG\", \"öffentliche Schulen\", \"Schulgebäude\", \"Schulsportanlagen\"</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderung kommunaler Hochbauten - Information des Bayerischen Staatsministeriums der Finanzen und für Heimat</xflb:bezeichnung>\n                     <xflb:link>https://www.stmfh.bayern.de/kommunaler_finanzausgleich/hochbauten</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Ihre zuständige Bezirksregierung</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>92aaf5cb-b93f-428d-9e14-3bfd04a2c2d2</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Gewährung einer Zuwendung (Muster 1a zu Art. 10 BayFAG)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-128/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>cce92fa1-b6bd-4040-8833-17181b0b3253</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Bewilligung weiterer Zuwendungsraten (Muster 1b zu Art. 10 BayFAG)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-129/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>d47a2ed5-0807-46b6-a597-3d8630f304a2</xflb:id>\n                     <xflb:bezeichnung>Angaben zu den finanziellen Verhältnissen (Muster 2a zu Art. 10 BayFAG - Kameralistik)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-130/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>5e12c75a-09c9-4efc-8b90-aadf233db041</xflb:id>\n                     <xflb:bezeichnung>Angaben zu den finanziellen Verhältnissen (Muster 2b zu Art. 10 BayFAG - Doppik)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-131/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>667151c7-10f5-4e90-be9f-cc758bc30877</xflb:id>\n                     <xflb:bezeichnung>Auszahlungsantrag (Muster 3 zu Art. 10 BayFAG)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-132/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>863e522d-6a30-4afa-aad7-8efb69ab469c</xflb:id>\n                     <xflb:bezeichnung>Verwendungsnachweis (Muster 4 zu Art. 10 BayFAG)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-133/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>eb7e0f5a-58ea-46f5-97ce-156efb323046</xflb:id>\n                     <xflb:bezeichnung>Verwendungsbestätigung (Muster 1 zu Art. 44 BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-027/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>e8944a96-8be4-4e3e-98cb-a110b5ae81c7</xflb:id>\n                     <xflb:bezeichnung>Ausgaben für Hochbaumaßnahmen (Muster 2 zu Art. 44 BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-020/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>67b09dab-ddf4-4432-81b1-cfcaa33ae354</xflb:id>\n                     <xflb:bezeichnung>Erläuterungsbericht zum Antrag auf Gewährung einer Zuwendung für eine Hochbaumaßnahme (Muster 3 zu Art. 44 BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-021/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>dd44d215-a368-40e2-911f-726cb8e620dc</xflb:id>\n                     <xflb:bezeichnung>Flächenzusammenstellung zum Erläuterungsbericht (Muster 3a zu Art. 44 BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-022/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>cf51d563-a630-45ab-b8f5-40355519372b</xflb:id>\n                     <xflb:bezeichnung>Maßnahmeerhebungsbogen</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-001/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>b9b7dded-d930-476f-854d-606d54478d00</xflb:id>\n                     <xflb:bezeichnung>Mitteilung gem. Nr. 1.1 NBest-Bau - Zuwendungen/Zuweisungen nach BayFAG und BayGVFG</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-009/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>2c3f6b9b-04e0-4e98-acf6-0134e9c5832d</xflb:id>\n                     <xflb:bezeichnung>Kommunale Hochbauförderung nach Art. 10 BayFAG - Checkliste Antragsunterlagen</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-012/index</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>008</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Empfänger staatlicher Zuweisungen nach Art. 10 BayFAG sind aus-schließlich Gemeinden, Landkreise, Bezirke, Verwaltungsgemeinschaften, Schulverbände und kommunale Zweckverbände, nicht aber selbstständige Kommunalunternehmen des öffentlichen Rechts oder kommunale Unter-nehmen in den Rechtsformen des Privatrechts.\nSofern ein Vorhaben von einem anderen Maßnahmeträger durchgeführt wird und sich die Kommune daran mit einem Zuschuss zu den Bau- oder Erwerbskosten beteiligt, werden der Kommune hierzu Zuweisungen nach Art. 10 BayFAG gewährt.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Zuweisungen werden als Projektförderung im Wege der Anteilsfinanzierung mit einem bestimmten Prozentsatz an den zuweisungsfähigen Ausgaben gewährt.&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Der Förderrahmen beträgt grundsätzlich 0 bis 80 %.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bei der Bemessung der Höhe der Zuweisung werden insbesondere die finanzielle Lage der Kommune unter Berücksichtigung der demografischen Entwicklung, die Bedeutung der Baumaßnahme, ein über das Hoheitsgebiet der Kommune hinausgehendes Einzugsgebiet, das Staatsinteresse und die Höhe der verfügbaren Mittel berücksichtigt.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Für Kommunen, deren finanzielle Lage dem Landesdurchschnitt vergleichbarer Kommunen entspricht, kann von einem Fördersatz-Orientierungswert von 50 % ausgegangen werden.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Kommunale Bauinvestitionen zum erstmaligen Ausbau schulaufsichtlich genehmigter Ganztagsangebote erhalten einen Aufschlag von 15 Prozentpunkten auf den regulären Fördersatz (\"FAGplus15\").&lt;/li&gt;&lt;/ul&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Grundlage für die staatliche Förderung sind nicht die Gesamtkosten, sondern die zuweisungsfähigen Ausgaben. Die Ermittlung der zuweisungsfähigen Ausgaben erfolgt nach Maßgabe der Nr. 5.2 der Zuweisungsrichtlinie (FAZR).&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium der Finanzen und für Heimat</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 10 Bayerisches Gesetz über den Finanzausgleich zwischen Staat, Gemeinden und Gemeindeverbänden (Bayerisches Finanzausgleichsgesetz - BayFAG)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayFAG-10</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinie über die Zuweisungen des Freistaates Bayern zu kommunalen Baumaßnahmen im kommunalen Finanzausgleich (Zuweisungsrichtlinie - FAZR) Bekanntmachung des Bayerischen Staatsministeriums der Finanzen, für Landesentwicklung und Heimat, Az. 62 - FV 6700 - 1/2/9, FMBl. S. 59</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_605_F_15611</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Festsetzung von Kostenrichtwerten - aktuelle Kostenrichtwerte</xflb:bezeichnung>\n                     <xflb:link>https://www.stmfh.bayern.de/kommunaler_finanzausgleich/hochbauten/Kostenrichtwerte2026.pdf</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Verwaltungsvorschriften zu Art. 44 BayHO</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN44</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Allgemeine Nebenbestimmungen für Zuwendungen zur Projektförderung  (ANBest-P)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN121</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Baufachliche Nebenbestimmungen (NBest-Bau)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN122</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Unterlagen für die Beantragung einer Zuwendung zu Baumaßnahmen</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN123</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat 62</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Förderung kommunaler Hochbaumaßnahmen nach Art. 10 BayFAG</xflb:programmtitel>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2026-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2030-12-31</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:verlaengerungsoption>Die Förderung erfolgt im Rahmen der verfügbaren Haushaltsmittel grundsätzlich zeitlich unbefristet</xflb:verlaengerungsoption>\n               </xflb:programmlaufzeit>\n               <xflb:kummulierbareFoerderungen>\n                  <xflb:voraussetzungen>&lt;p&gt;Kommt für eine Baumaßnahme neben einer Zuweisung nach Art. 10 BayFAG eine weitere Zuwendung eines anderen Zuwendungsgebers in Betracht, gilt Folgendes zu beachten:&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Eine Kumulierung ist im Bereich der Förderung nach Art. 10 BayFAG grundsätzlich möglich, sofern der Zuweisungsempfänger noch keinen Bewilligungsbescheid für Zuweisungen nach Art. 10 BayFAG erhalten hat und angibt, dass er eine zusätzliche Zuwendung aus einem anderen Förderprogramm erhält oder beantragt.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Wird die zusätzliche Zuwendung zu denselben Ausgaben gewährt, ist darauf zu achten, dass der Kommune mindestens ein Eigenanteil von 10 % der zuweisungsfähigen Ausgaben verbleibt.&lt;/li&gt;&lt;/ul&gt;</xflb:voraussetzungen>\n               </xflb:kummulierbareFoerderungen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Förderfähige Einrichtungen sind:&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Grund- und Mittelschulen&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Realschulen und Gymnasien&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Schulen des Zweiten Bildungswegs (Art. 10 BayEUG)&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Förderschulen und Schulen für Kranke&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;schulisch bedarfsnotwendige Sportanlagen (Sporthallen, Freisportanlagen, Hallenbäder)&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Förderfähige Maßnahmen:&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Neu-, Um- und Erweiterungsbauten&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;General- und Teilsanierungen&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Erwerb einschließlich Umbau eines Gebäudes&lt;/li&gt;&lt;/ul&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Der Förderung wird der schulaufsichtlich festgestellte Raum- bzw. Flächenbedarf zu Grunde gelegt. Dieser wird bei Neu-, Um- und Erweiterungsbauten sowie beim Erwerb von Gebäuden in der bei der Regierung zu beantragenden schulaufsichtlichen Genehmigung festgestellt.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Gesamtfinanzierung muss gesichert sein. Die Kommune muss in der Lage sein, die notwendigen Eigenmittel aufzubringen und auch die zu erwartenden Folgekosten in der Zukunft zu finanzieren.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Zuweisungen nach Art. 10 BayFAG dürfen nur für Maßnahmen gewährt werden, die noch nicht begonnen worden sind.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Maßnahmen können nur gefördert werden, wenn deren zuweisungsfähige Ausgaben die Bagatellgrenze von 100.000 € überschreiten.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Durch Elementarschadensereignisse verursachte Schäden sowie Maßnahmen zur Umsetzung von Barrierefreiheit sind förderfähig, wenn deren zuweisungsfähige Ausgaben mindestens 25.000 € betragen.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Für Baumaßnahmen zum Ausbau schulischer Ganztagsangebote (\"FAGplus15\") gilt eine Bagatellgrenze von 50.000 €.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Das geförderte Objekt muss grundsätzlich mindestens&amp;nbsp;25 Jahre entsprechend dem Zuweisungszweck verwendet werden. Abweichend&amp;nbsp;hiervon ist die Errichtung temporärer Bauten förderfähig, wenn deren Nutzung für mindestens zehn Jahre gesichert und der Bedarf hierfür festgestellt ist.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bei kürzerer Nutzungszeit ist ein zeitanteiliger Betrag zurückzuerstatten, es sei denn, das Projekt wird für andere förderfähige kommunale Zwecke oder zur Erfüllung anderer kommunaler Aufgaben des Zuweisungsempfängers verwendet und es werden hieraus keine Einnahmen erzielt.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Werden für ein Vorhaben neben der Förderung nach Art. 10 BayFAG auch andere Zuweisungen zu denselben zuweisungsfähigen Ausgaben gewährt, ist bei der Festsetzung des Fördersatzes zu berücksichtigen, dass dem Zuweisungsempfänger ein Eigenanteil von mindestens 10 % der zuweisungsfähigen Ausgaben verbleibt.&lt;/li&gt;&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Nicht nach Art. 10 BayFAG förderfähig sind:&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Maßnahmen der laufenden Instandhaltung (Erhaltungsaufwand) und Kosten des laufenden Betriebs.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Kleine Baumaßnahmen mit zuweisungsfähigen Ausgaben von unter 100.000 €.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bereits begonnene oder abgeschlossene Baumaßnahmen.&lt;/li&gt;&lt;/ul&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-128/index</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Anträge auf Zuweisungen sind bei der für die Kommune zuständigen Bezirksregierung einzureichen. Hierzu sind die von der Bewilligungsbehörde bereitgestellten Muster zu verwenden.&lt;/p&gt;&lt;p&gt;Weiteres Verfahren:&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Regierung prüft und verbescheidet den Antrag.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Zuweisungen werden von der Regierung jeweils für ein Haushaltsjahr bewilligt.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Nach Fertigstellung der Maßnahme ist ein Nachweis über die zweckentsprechende Verwendung der Zuweisung vorzulegen.&lt;/li&gt;&lt;/ul&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>&lt;p&gt;Mit der Baumaßnahme darf erst nach Erteilung eines entsprechenden Bewilligungsbescheids oder nach vorheriger Zustimmung zum vorzeitigen Vorhabenbeginn begonnen werden.&lt;/p&gt;</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Zuweisungsantrag</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Pläne, die Art und Umfang des Bauvorhabens prüfbar nachweisen</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Unterlagen für Baumaßnahmen gemäß VV Nr. 4 der Anlage 4 zu Art. 44 BayHO</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Angaben über finanziellen Verhältnisse</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Sind mehrere Kommunen an der Finanzierung oder Nutzung beteiligt: Für jede Kommune eine Übersicht über die finanziellen Verhältnisse sowie eine Übersicht, aus der sich die Verteilung der Belastungen auf die beteiligten Kommunen ergibt</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Anträge auf und Zusagen von Zuweisungen Dritter</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Gegen den Zuweisungsbescheid können Sie innerhalb eines Monats Widerspruch einlegen. Die Stelle, bei der Sie den Widerspruch einreichen können, wird Ihnen im Bescheid mitgeteilt.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_45   [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmwk/blfd/kulturfonds_kunst/index?caller=bpmvsdiobwgiytgytcmvtgindbgzqlaxkqvlgmhv2vtozyv4ar6vuoygjpsweeywtirp774me4sq34jqtm6o33h47iwknvj4kfyd7a5lzntit5enbekzpsmuch6yv2tq3w34fbcsmvglpjgisztwxvu4jq6x42yhw7vh6dz5rj5gie2zi4jdrhjy2vaqpckkb2e2j75g6eew4sh3abmbnvcwuvjixojuqalbj33xi8";
                                xyz:begriffeImKontext    [ rdf:_1  "Konzerte";
                                                           rdf:_2  "zeitgenössische Musik";
                                                           rdf:_3  "Musik-Wettbewerbe";
                                                           rdf:_4  "musikalische Begabtenförderung";
                                                           rdf:_5  "Klassik";
                                                           rdf:_6  "Jazz";
                                                           rdf:_7  "Rock- und Popmusik";
                                                           rdf:_8  "Alte Musik";
                                                           rdf:_9  "Neue Musik"
                                                         ];
                                xyz:beschreibung         "<p>Förderung besonderer musikalischer Projekte nichtstaatlicher und nichtkommerzieller Träger aus allen Musikgenres. Das Fördergebiet umfasst ganz Bayern, ausgeschlossen sind Vorhaben in München und Nürnberg. Die kulturellen Vorhaben müssen überregionale, zumindest aber überörtliche Bedeutung haben. Zuständig für die Antragsbearbeitung ist die jeweilige Bezirksregierung, in deren Region das Vorhaben durchgeführt werden soll. Sofern das Vorhaben in mehreren Regierungsbezirken umgesetzt werden soll, ist die Bezirksregierung zuständig, in deren Region der Antragsteller seinen Sitz hat. Für Vorhaben aus dem Bereich Bildung (Projekte bei denen nicht die Präsentation/Vorführung von Kultur und kulturelle Darbietungen vor Publikum im Vordergrund stehen, wie z.B. bei Theaterstücken, Konzerten, Lesungen, Ausstellungen), sondern die gemeinsame Erarbeitung unterschiedlicher kultureller Themen, wäre der Kulturfonds \"Kulturelle Bildung\" (angesiedelt beim Bayerischen Staatsministerium für Unterricht und Kultus) einschlägig.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Kultur, Medien und Sport" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Privatpersonen";
                                                           rdf:_2  "Kommunen";
                                                           rdf:_3  "Vereine";
                                                           rdf:_4  "Verbände";
                                                           rdf:_5  "Stiftungen"
                                                         ];
                                xyz:foerderprogramm      "Kulturfonds Bayern - Kunst";
                                xyz:foerderzeitraum.bis  "2028-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2025-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "0f5e29a2-e852-4ec4-878c-eaec01cc56f2";
                                xyz:teaser               "Der Freistaat Bayern fördert Sonderkonzerte mit professionellen Musikerinnen und Musikern bzw. Ensembles, neue Konzertreihen oder Festivals, zeitgenössische Musik, Musik-Wettbewerbe, Maßnahmen der musikalischen Begabtenförderung";
                                xyz:titel                "D2-Förderung von Veranstaltungen und sonstigen Projekten (insb. im Bereich der zeitgenössischen Musik), Maßnahmen zur musikalischen Begabtenförderung";
                                xyz:titel.tokens         [ rdf:_1  "D2-Förderung von Veranstaltungen und sonstigen Projekten (insb. im Bereich der zeitgenössischen Musik)";
                                                           rdf:_2  "Maßnahmen zur musikalischen Begabtenförderung"
                                                         ];
                                xyz:voraussetzung        "<p>Aus dem Kulturfonds, **Bereich Kunst** , können musikalische Projekte aller Genres von nichtstaatlichen Trägern gefördert werden, aber keine laufenden Betriebskosten (institutionelle Förderung). Für regelmäßig wiederkehrende Veranstaltungen ist lediglich eine Anschubfinanzierung möglich. Die Vorhaben sollen grundsätzlich von überregionaler, zumindest aber von überörtlicher Bedeutung sein; Maßnahmen mit zuwendungsfähigen Gesamtkosten von weniger als 10.000 € können daher nicht gefördert werden. Das Fördergebiet umfasst ganz Bayern; grundsätzlich ausgeschlossen sind allerdings Vorhaben in München und Nürnberg. Eine gleichzeitige Förderung aus anderen staatlichen Förderansätzen (Mehrfachförderung) sowie aus Mitteln der Bayerischen Landesstiftung ist grundsätzlich ausgeschlossen. Die Förderung erfolgt nach Maßgabe der zur Verfügung stehenden Haushaltsmittel und ist grundsätzlich auf maximal 30 v. H. der zuwendungsfähigen Kosten begrenzt. Zuwendungen dürfen nur bewilligt werden, wenn mit dem Projekt noch nicht begonnen wurde.</p>"
                              ];
              xyz:id          "0f5e29a2-e852-4ec4-878c-eaec01cc56f2";
              xyz:payload     [ xyz:json  [ xyz:anfrage            [ xyz:anfragenummer  "0f5e29a2-e852-4ec4-878c-eaec01cc56f2";
                                                                     xyz:flb            [ xyz:konkreteFLB  [ xyz:allgemeineAngaben       [ xyz:allgemeineFragen   [ xyz:email                 "kulturfonds@stmwk.bayerrn.de";
                                                                                                                                                                    xyz:name                  "Referat K.6";
                                                                                                                                                                    xyz:organisationseinheit  [ xyz:code           "002";
                                                                                                                                                                                                xyz:listURI        "urn:xoev-de:stmd:codeliste:organisationseinheit";
                                                                                                                                                                                                xyz:listVersionID  "1";
                                                                                                                                                                                                xyz:name           "Zuständige Stelle"
                                                                                                                                                                                              ];
                                                                                                                                                                    xyz:verweis               [ xyz:bezeichnung  "Kulturfonds Bayern, Bereich Kunst";
                                                                                                                                                                                                xyz:link         "https://www.stmwk.bayern.de/kunst-und-kultur/foerderung/kulturfonds-bayern.html"
                                                                                                                                                                                              ]
                                                                                                                                                                  ];
                                                                                                                                           xyz:beschreibung       [ xyz:schluesselwoerter  "Konzerte, zeitgenössische Musik, Musik-Wettbewerbe, musikalische Begabtenförderung, Klassik, Jazz, Rock- und Popmusik, Alte Musik, Neue Musik";
                                                                                                                                                                    xyz:teaser             "Der Freistaat Bayern fördert Sonderkonzerte mit professionellen Musikerinnen und Musikern bzw. Ensembles, neue Konzertreihen oder Festivals, zeitgenössische Musik, Musik-Wettbewerbe, Maßnahmen der musikalischen Begabtenförderung";
                                                                                                                                                                    xyz:zuwendungszweck    "<p>Förderung besonderer musikalischer Projekte nichtstaatlicher und nichtkommerzieller Träger aus allen Musikgenres. Das Fördergebiet umfasst ganz Bayern, ausgeschlossen sind Vorhaben in München und Nürnberg. Die kulturellen Vorhaben müssen überregionale, zumindest aber überörtliche Bedeutung haben. Zuständig für die Antragsbearbeitung ist die jeweilige Bezirksregierung, in deren Region das Vorhaben durchgeführt werden soll. Sofern das Vorhaben in mehreren Regierungsbezirken umgesetzt werden soll, ist die Bezirksregierung zuständig, in deren Region der Antragsteller seinen Sitz hat. Für Vorhaben aus dem Bereich Bildung (Projekte bei denen nicht die Präsentation/Vorführung von Kultur und kulturelle Darbietungen vor Publikum im Vordergrund stehen, wie z.B. bei Theaterstücken, Konzerten, Lesungen, Ausstellungen), sondern die gemeinsame Erarbeitung unterschiedlicher kultureller Themen, wäre der Kulturfonds \"Kulturelle Bildung\" (angesiedelt beim Bayerischen Staatsministerium für Unterricht und Kultus) einschlägig.</p>"
                                                                                                                                                                  ];
