                                          ];
                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>52636efe-1494-451d-a023-a2cd7cb2c5de</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-06-18T10:48:05</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>52636efe-1494-451d-a023-a2cd7cb2c5de</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>52636efe-1494-451d-a023-a2cd7cb2c5de</xflb:schluessel>\n         <xflb:versionFLB>3</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-06-18T10:48:05</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>52636efe-1494-451d-a023-a2cd7cb2c5de</xflb:foerderschluessel>\n                  <xflb:flbVersion>3</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>09999000000010</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Förderung von Baumaßnahmen an Schülerheimen</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Im Rahmen des kommunalen Finanzausgleichs unterstützt der Freistaat Bayern seine Kommunen bei Baumaßnahmen an Schülerheimen mit Zuweisungen nach Art. 10 des Bayerischen Finanzausgleichsgesetzes (BayFAG).&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat gewährt auf Antrag Zuweisungen zu kommunalen Hochbaumaßnahmen</xflb:teaser>\n                  <xflb:schluesselwoerter>\"Förderung von Baumaßnahmen\", \"Art. 10 BayFAG\", \"Schülerheime\"</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderung kommunaler Hochbauten - Information des Bayerischen Staatsministeriums der Finanzen und für Heimat</xflb:bezeichnung>\n                     <xflb:link>https://www.stmfh.bayern.de/kommunaler_finanzausgleich/hochbauten</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Ihre zuständige Bezirksregierung</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>4bbe040c-b633-4d4d-a8ec-e942452616dd</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Gewährung einer Zuwendung (Muster 1a zu Art. 10 BayFAG)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-128/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>4bd50296-4905-44d7-ba6c-282a56ca2f77</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Bewilligung weiterer Zuwendungsraten (Muster 1b zu Art. 10 BayFAG)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-129/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>1d2fb0fb-2c99-4e86-a69f-e37908165364</xflb:id>\n                     <xflb:bezeichnung>Angaben zu den finanziellen Verhältnissen (Muster 2a zu Art. 10 BayFAG - Kameralistik)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-130/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>8321070b-9258-4176-af18-628168c1762a</xflb:id>\n                     <xflb:bezeichnung>Angaben zu den finanziellen Verhältnissen (Muster 2b zu Art. 10 BayFAG - Doppik)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-131/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>fbb4df34-ad49-4ca7-8154-61f1afea5e2c</xflb:id>\n                     <xflb:bezeichnung>Auszahlungsantrag (Muster 3 zu Art. 10 BayFAG)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-132/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>dbdc57a9-eebf-4a1d-93da-dbab0eb26ebe</xflb:id>\n                     <xflb:bezeichnung>Verwendungsnachweis (Muster 4 zu Art. 10 BayFAG)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-133/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>6d7102a5-4be5-4461-8e06-e9c5a0cde703</xflb:id>\n                     <xflb:bezeichnung>Verwendungsbestätigung (Muster 1 zu Art. 44 BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-027/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>157a1e3d-025a-4b3b-a764-06df9e865297</xflb:id>\n                     <xflb:bezeichnung>Ausgaben für Hochbaumaßnahmen (Muster 2 zu Art. 44 BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-020/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>cb0daaa2-61c3-458d-b044-28309e2376a9</xflb:id>\n                     <xflb:bezeichnung>Erläuterungsbericht zum Antrag auf Gewährung einer Zuwendung für eine Hochbaumaßnahme (Muster 3 zu Art. 44 BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-021/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>9ecf44c5-90c7-45e0-9e52-74340dd01d0c</xflb:id>\n                     <xflb:bezeichnung>Flächenzusammenstellung zum Erläuterungsbericht (Muster 3a zu Art. 44 BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-022/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>cb16921f-68a0-4538-b7f7-c300a6415dd6</xflb:id>\n                     <xflb:bezeichnung>Maßnahmenerhebungsbogen</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-001/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>25394f05-5123-45bb-a903-608bdbbad3d2</xflb:id>\n                     <xflb:bezeichnung>Mitteilung gem. Nr. 1.1 NBest-Bau - Zuwendungen/Zuweisungen nach BayFAG und BayGVFG</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-009/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>3ae7f4a3-783e-4861-95df-5fe497480585</xflb:id>\n                     <xflb:bezeichnung>Kommunale Hochbauförderung nach Art. 10 FAG - Checkliste Antragsunterlagen</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-012/index</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>008</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Empfänger staatlicher Zuweisungen nach Art. 10 BayFAG sind aus-schließlich Gemeinden, Landkreise, Bezirke, Verwaltungsgemeinschaften, Schulverbände und kommunale Zweckverbände, nicht aber selbstständige Kommunalunternehmen des öffentlichen Rechts oder kommunale Unter-nehmen in den Rechtsformen des Privatrechts.\nSofern ein Vorhaben von einem anderen Maßnahmeträger durchgeführt wird und sich die Kommune daran mit einem Zuschuss zu den Bau- oder Erwerbskosten beteiligt, werden der Kommune hierzu Zuweisungen nach Art. 10 BayFAG gewährt.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Zuweisungen werden als Projektförderung im Wege der Anteilsfinanzierung mit einem bestimmten Prozentsatz an den zuweisungsfähigen Ausgaben gewährt.&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Der Förderrahmen beträgt grundsätzlich 0 bis 80 %.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bei der Bemessung der Höhe der Zuweisung werden insbesondere die finanzielle Lage der Kommune unter Berücksichtigung der demografischen Entwicklung, die Bedeutung der Baumaßnahme, ein über das Hoheitsgebiet der Kommune hinausgehendes Einzugsgebiet, das Staatsinteresse und die Höhe der verfügbaren Mittel berücksichtigt.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Für Kommunen, deren finanzielle Lage dem Landesdurchschnitt vergleichbarer Kommunen entspricht, kann von einem Fördersatz-Orientierungswert von 50 % ausgegangen werden.&lt;/li&gt;&lt;/ul&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Grundlage für die staatliche Förderung sind nicht die Gesamtkosten, sondern die zuweisungsfähigen Ausgaben. Die Ermittlung der zuweisungsfähigen Ausgaben erfolgt nach Maßgabe der Nr. 5.2 der Zuweisungsrichtlinie (FAZR).&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium der Finanzen und für Heimat</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 10 Bayerisches Gesetz über den Finanzausgleich zwischen Staat, Gemeinden und Gemeindeverbänden (Bayerisches Finanzausgleichsgesetz - BayFAG)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayFAG-10</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinie über die Zuweisungen des Freistaates Bayern zu kommunalen Baumaßnahmen im kommunalen Finanzausgleich (Zuweisungsrichtlinie - FAZR) Bekanntmachung des Bayerischen Staatsministeriums der Finanzen, für Landesentwicklung und Heimat, Az. 62 - FV 6700 - 1/2/9, FMBl. S. 59</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_605_F_15611</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Festsetzung von Kostenrichtwerten - aktuelle Kostenrichtwerte</xflb:bezeichnung>\n                     <xflb:link>https://www.stmfh.bayern.de/kommunaler_finanzausgleich/hochbauten/Kostenrichtwerte2026.pdf</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Verwaltungsvorschriften zu Art. 44 BayHO</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN44</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Allgemeine Nebenbestimmungen für Zuwendungen zur Projektförderung  (ANBest-P)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN121</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Baufachliche Nebenbestimmungen (NBest-Bau)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN122</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Unterlagen für die Beantragung einer Zuwendung zu Baumaßnahmen</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN123</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat 62</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Förderung kommunaler Hochbaumaßnahmen nach Art. 10 BayFAG</xflb:programmtitel>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2026-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2030-12-31</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:verlaengerungsoption>Die Förderung erfolgt im Rahmen der verfügbaren Haushaltsmittel grundsätzlich zeitlich unbefristet</xflb:verlaengerungsoption>\n               </xflb:programmlaufzeit>\n               <xflb:kummulierbareFoerderungen>\n                  <xflb:voraussetzungen>&lt;p&gt;Kommt für eine Baumaßnahme neben einer Zuweisung nach Art. 10 BayFAG eine weitere Zuwendung eines anderen Zuwendungsgebers in Betracht, gilt Folgendes zu beachten:&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Eine Kumulierung ist im Bereich der Förderung nach Art. 10 BayFAG grundsätzlich möglich, sofern der Zuweisungsempfänger noch keinen Bewilligungsbescheid für Zuweisungen nach Art. 10 BayFAG erhalten hat und angibt, dass er eine zusätzliche Zuwendung aus einem anderen Förderprogramm erhält oder beantragt.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Wird die zusätzliche Zuwendung zu denselben Ausgaben gewährt, ist darauf zu achten, dass der Kommune mindestens ein Eigenanteil von 10 % der zuweisungsfähigen Ausgaben verbleibt.&lt;/li&gt;&lt;/ul&gt;</xflb:voraussetzungen>\n               </xflb:kummulierbareFoerderungen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Förderfähige Einrichtungen sind:&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Schülerheime an kommunalen Heimschulen nach Art. 106 Satz 2 BayEUG&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Kommunale Schülerheime nach Art. 106 Satz 4 BayEUG, die überwiegend Schülerinnen und Schüler beruflicher Schulen aufnehmen&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Förderfähige Maßnahmen im Rahmen des Art. 10 BayFAG sind:&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Neu-, Um- und Erweiterungsbauten&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;General- und Teilsanierungen&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Erwerb einschließlich Umbau oder Instandsetzung eines Gebäudes&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Das Vorhaben muss schulaufsichtlich genehmigt sein.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Gesamtfinanzierung muss gesichert sein. Die Kommune muss in der Lage sein, die notwendigen Eigenmittel aufzubringen und auch die zu erwartenden Folgekosten in der Zukunft zu finanzieren.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Zuweisungen nach Art. 10 BayFAG dürfen nur für Maßnahmen gewährt werden, die noch nicht begonnen worden sind.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Maßnahmen können nur gefördert werden, wenn deren zuweisungsfähige Ausgaben die Bagatellgrenze von 100.000 € überschreiten.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Durch Elementarschadensereignisse verursachte Schäden sowie Maßnahmen zur Umsetzung von Barrierefreiheit sind förderfähig, wenn deren zuweisungsfähige Ausgaben mindestens 25.000 € betragen.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Das geförderte Objekt muss grundsätzlich mindestens&amp;nbsp;25 Jahre entsprechend dem Zuweisungszweck verwendet werden. Abweichend&amp;nbsp;hiervon ist die Errichtung temporärer Bauten förderfähig, wenn deren Nutzung für mindestens zehn Jahre gesichert und der Bedarf hierfür festgestellt ist.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bei kürzerer Nutzungszeit ist ein zeitanteiliger Betrag zurückzuerstatten, es sei denn, das Projekt wird für andere förderfähige kommunale Zwecke oder zur Erfüllung anderer kommunaler Aufgaben des Zuweisungsempfängers verwendet und es werden hieraus keine Einnahmen erzielt.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Werden für ein Vorhaben neben der Förderung nach Art. 10 BayFAG auch andere Zuweisungen zu denselben zuweisungsfähigen Ausgaben gewährt, ist bei der Festsetzung des Fördersatzes zu berücksichtigen, dass dem Zuweisungsempfänger ein Eigenanteil von mindestens 10 % der zuweisungsfähigen Ausgaben verbleibt.&lt;/li&gt;&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Nicht nach Art. 10 BayFAG förderfähig sind:&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Maßnahmen der laufenden Instandhaltung (Erhaltungsaufwand) und Kosten des laufenden Betriebs.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Kleine Baumaßnahmen mit zuweisungsfähigen Ausgaben von unter 100.000 €.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bereits begonnene oder abgeschlossene Baumaßnahmen.&lt;/li&gt;&lt;/ul&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-128/index</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Anträge auf Zuweisungen sind bei der für die Kommune zuständigen Bezirksregierung einzureichen. Hierzu sind die von der Bewilligungsbehörde bereitgestellten Muster zu verwenden.&lt;/p&gt;&lt;p&gt;Weiteres Verfahren:&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Regierung prüft und verbescheidet den Antrag.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Zuweisungen werden von der Regierung jeweils für ein Haushaltsjahr bewilligt.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Nach Fertigstellung der Maßnahme ist ein Nachweis über die zweckentsprechende Verwendung der Zuweisung vorzulegen.&lt;/li&gt;&lt;/ul&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>&lt;p&gt;Mit der Baumaßnahme darf erst nach Erteilung eines entsprechenden Bewilligungsbescheids oder nach vorheriger Zustimmung zum vorzeitigen Vorhabenbeginn begonnen werden.&lt;/p&gt;</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Zuweisungsantrag</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Pläne, die Art und Umfang des Bauvorhabens prüfbar nachweisen</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Unterlagen für Baumaßnahmen gemäß VV Nr. 4 der Anlage 4 zu Art. 44 BayHO</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Angaben über finanziellen Verhältnisse</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Sind mehrere Kommunen an der Finanzierung oder Nutzung beteiligt: Für jede Kommune eine Übersicht über die jeweiligen finanziellen Verhältnisse sowie eine Übersicht, aus der sich die Verteilung der Belastungen auf die beteiligten Kommunen ergibt.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Anträge auf und Zusagen von Zuweisungen Dritter</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Gegen den Zuweisungsbescheid können Sie innerhalb eines Monats Widerspruch einlegen. Die Stelle, bei der Sie den Widerspruch einreichen können, wird Ihnen im Bescheid mitgeteilt.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_15   [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/rmf-zz/13/rmf_13-087/index";
                                xyz:begriffeImKontext    [ rdf:_1  "§ 13 SGB VIII";
                                                           rdf:_2  "JaS";
                                                           rdf:_3  "Jugendsozialarbeit";
                                                           rdf:_4  "Schule"
                                                         ];
                                xyz:beschreibung         "<p>Der Freistaat Bayern unterstützt mit diesem Förderprogramm Landkreise und kreisfreie Städte bei der Jugendsozialarbeit (JaS), um sozial benachteiligten oder individuell beeinträchtigten jungen Menschen eine sozialpädagogische Hilfe im Schulalltag zu bieten. Ziel ist die Förderung der Persönlichkeitsentwicklung, die soziale Integration und eine chancengerechte Teilhabe an Bildung.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Beratung" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Kommunen" ];
                                xyz:foerderzeitraum.bis  "2027-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2025-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "c7fa6469-9103-4155-8f38-ccb3d9e36c46";
                                xyz:teaser               "Jugendsozialarbeit an Schulen (JaS) ist eine Maßnahme der Jugendhilfe. Durch den Einsatz von JaS-Fachkräften an der Schule erfolgt eine intensive Kooperation von Jugendhilfe und Schule.";
                                xyz:titel                "Jugendsozialarbeit an Schulen; Beantragung einer Förderung";
                                xyz:titel.tokens         [ rdf:_1  "Jugendsozialarbeit an Schulen";
                                                           rdf:_2  "Beantragung einer Förderung"
                                                         ];
                                xyz:voraussetzung        "<p>Der Bedarf für den Umfang der Jugendsozialarbeit am jeweiligen Einsatzort muss im Rahmen der Jugendhilfeplanung vom örtlichen Jugendamt festgestellt und vom Jugendhilfeausschuss bestätigt werden. Näheres regelt die Förderrichtlinie.</p><p>Antragsberechtigt sind die örtlichen Träger der öffentlichen Jugendhilfe (Landkreise und kreisfreie Städte) und anerkannte Träger der freien Jugendhilfe, die die JaS im Auftrag des Jugendamtes durchführen und nicht gleichzeitig Schulträger sind.</p>"
                              ];
              xyz:id          "c7fa6469-9103-4155-8f38-ccb3d9e36c46";
