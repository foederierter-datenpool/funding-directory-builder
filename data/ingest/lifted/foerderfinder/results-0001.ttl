                                                                                                                       xyz:handlungsgrundlagen        [ xyz:verweis  [ xyz:bezeichnung  "Richtlinie zur \"Förderung des kommunalen Klimaschutzes\" im Bayerischen Klimaschutzprogramm (Förderrichtlinie Kommunaler Klimaschutz - KommKlimaFöR 2026)";
                                                                                                                                                                       xyz:link         "https://www.verkuendung-bayern.de/baymbl/2026-303/"
                                                                                                                                                                     ]
                                                                                                                                                      ];
                                                                                                                       xyz:kummulierbareFoerderungen  [ xyz:voraussetzungen
                                                                                                                                         "<p>Kombination mit anderen Förderungen - kurz erklärt</p><ul><li class=\"unordered-list-item--dash\">Förderung nur, wenn kein anderes Bayern-Programm passt Unser Zuschuss greift, wenn Ihr Vorhaben nicht bereits durch ein anderes Landesprogramm gefördert werden kann.</li><li class=\"unordered-list-item--dash\">Bund- oder EU-Gelder möglich Sie dürfen diesen Zuschuss mit Programmen des Bundes oder der EU verbinden, sofern</li><li class=\"unordered-list-item--dash\"><ul><li class=\"unordered-list-item--dash\">es sich um dasselbe Vorhaben mit identischem Kostenplan handelt und</li><li class=\"unordered-list-item--dash\">die Regelungen der anderen Programme sowie das EU-Beihilferecht die Kombination erlauben. Wenn diese Bedingungen nicht erfüllt sind, bleibt es bei der Regel, dass wir erst fördern, wenn kein anderes Bayern-Programm passt.</li></ul></li><li value=\"3\">Doppelt beantragt? Bitte melden! Sobald Sie auch bei einer anderen Stelle Fördermittel beantragen, informieren Sie Ihre Bewilligungsbehörde sofort und schicken nach Erhalt eine Kopie des dortigen Bescheids.</li><li value=\"4\">Förderdeckel Bei mehreren Geldgebern zusammen darf die Gesamthilfe 90 % der förderfähigen Kosten nicht überschreiten. Ihre Kommune muss daher mindestens 10 % der Kosten selbst tragen.</li></ul>" ];
                                                                                                                       xyz:programmlaufzeit           [ xyz:beginnLaufzeitFoerderprogramm
                                                                                                                                                                "2026-08-01";
                                                                                                                                                        xyz:endeLaufzeitFoerderprogramm
                                                                                                                                                                "2029-12-31"
                                                                                                                                                      ];
                                                                                                                       xyz:programmtitel              "Förderrichtlinien Kommunaler Klimaschutz - KommKlimaFöR 2026";
                                                                                                                       xyz:verantwortlichesFachreferat
                                                                                                                               "Referat 26";
                                                                                                                       xyz:verantwortlichesMinisterium
                                                                                                                               "Bayerisches Staatsministerium für Umwelt und Verbraucherschutz"
                                                                                                                     ];
                                                                                                             xyz:foerdervoraussetzungen  [ xyz:ausschlusskriterien  "<ul><li class=\"unordered-list-item--dash\">Vorhaben, zu denen Ihre Kommune oder Dritte ohnehin gesetzlich verpflichtet sind, können nicht gefördert werden.</li><li class=\"unordered-list-item--dash\">Eine Zuwendung für die in Energieförderprogrammen des Freistaates Bayern erfassten Fördermaßnahmen (zum Beispiel Energieforschung, Energienutzungspläne, Energiecoaching, kommunaler Energiewirt) ist ausgeschlossen.</li><li class=\"unordered-list-item--dash\">Leistungen, die der Erfüllung gesetzlicher Verpflichtungen nach dem Wärmeplanungsgesetz (WPG) dienen, sind nicht förderfähig.</li></ul>";
                                                                                                                                           xyz:buergerfreundlicheBeschreibung
                                                                                                                                                   "<h4>Allgemeine Fördervoraussetzungen - kurz erklärt</h4><ol><li class=\"ordered-list-item--numbered\"><strong>Projektstart erst nach Bewilligung</strong><br>Beginnen Sie erst mit dem Projekt, wenn der Förderbescheid vorliegt. Vorarbeiten auf eigenes Risiko sind ausgeschlossen.</li><li class=\"ordered-list-item--numbered\"><strong>Keine Pflichtaufgaben</strong><br>Vorhaben, zu denen Ihre Kommune oder Dritte ohnehin gesetzlich verpflichtet sind, können nicht gefördert werden.</li><li class=\"ordered-list-item--numbered\"><strong>Finanzierung steht</strong><br>- Die Gesamtfinanzierung muss gesichert sein (z. B. Eigenanteil, weitere Zuschüsse).<br>- Laufende Betriebs- und Unterhaltskosten trägt die Kommune selbst.</li><li class=\"ordered-list-item--numbered\"><strong>Mindestgröße</strong><br>Die förderfähigen Ausgaben müssen mindestens <strong>10 000 €</strong> betragen.</li><li class=\"ordered-list-item--numbered\"><strong>Anschaffungen</strong><br>Gefördert werden Anschaffungen nur, wenn sie in das Eigentum der Kommune übergehen und nicht gewerblich betrieben werden.</li><li class=\"ordered-list-item--numbered\"><strong>Genehmigungen</strong><br>Holen Sie alle erforderlichen behördlichen Genehmigungen oder Zustimmungen (etwa von Grundstückseigentümer*innen) ein, bevor Sie mit der Umsetzung beginnen.</li><li class=\"ordered-list-item--numbered\"><strong>Zweckbindung</strong><br>Die geförderten Mittel und angeschafften Anlagen sind ausschließlich für das bewilligte Vorhaben zu nutzen. In der Regel gilt eine Zweckbindungsfrist von <strong>fünf Jahren</strong> ab Inbetriebnahme; eine kürzere Frist ist nur in gut begründeten Ausnahmefällen möglich.</li></ol>"
                                                                                                                                         ];
