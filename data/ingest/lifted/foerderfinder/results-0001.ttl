                                                                                                                                                                      rdf:_2  [ xyz:bezeichnung  "Richtlinien für die Gewährung von Zuwendungen für nichtstaatliche Museen in Bayern Bekanntmachung des Bayerischen Staatsministeriums für Wissenschaft und Kunst vom 7. August 2026, Az. K.3-K4900/3/66";
                                                                                                                                                                                xyz:link         "https://www.gesetze-bayern.de/Content/Document/BayVV_2245_WK_15788/true"
                                                                                                                                                                              ]
                                                                                                                                                                    ]
