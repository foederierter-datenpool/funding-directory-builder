                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>c59aeb62-f194-4fe3-be7a-eab943741959</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-01-15T13:14:07</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>c59aeb62-f194-4fe3-be7a-eab943741959</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>c59aeb62-f194-4fe3-be7a-eab943741959</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-01-15T13:14:07</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>c59aeb62-f194-4fe3-be7a-eab943741959</xflb:foerderschluessel>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400114017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>B1-Förderung von Investitionen bei nichtstaatlichen Museen</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Förderung von Investitionen bei nichtstaatlicher Museen. Das Fördergebiet umfasst ganz Bayern, ausgeschlossen sind Vorhaben in München und Nürnberg (Ausnahme: Einbruchschutz). Das nichtstaatliche Museum muss überregionale Bedeutung haben. Zuständig für die Antragsbearbeitung ist die jeweilige Bezirksregierung, in deren Region das Vorhaben durchgeführt werden soll.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern fördert Investitionen bei nichtstaatlichen Museen</xflb:teaser>\n                  <xflb:schluesselwoerter>nichtstaatliche Museen Investition Sicherheitsmaßnahmen Einbruchschutz</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Was ist der Kulturfonds? Faltblatt mit Informationen, Antragsformulare</xflb:bezeichnung>\n                     <xflb:link>http://www.stmwk.bayern.de/kunst-und-kultur/foerderung/kulturfonds-bayern.html</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Referat K.6</xflb:name>\n                  <xflb:email>kulturfonds@stmwk.bayerrn.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Kulturfonds Bayern, Bereich Kunst</xflb:bezeichnung>\n                     <xflb:link>https://www.stmwk.bayern.de/kunst-und-kultur/foerderung/kulturfonds-bayern.html</xflb:link>\n                  </xflb:verweis>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Örtlich zuständige Bezirksregierung</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:onlinedienste>\n                  <xflb:onlinedienst>\n                     <xflb:id>2f7081d4-6345-45c9-aa76-43b9aecd3473</xflb:id>\n                     <xflb:bezeichnung>Kulturfonds Bayern Bereich Kunst</xflb:bezeichnung>\n                     <xflb:link>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmwk/blfd/kulturfonds_kunst/index?caller=bpmvsdiobwgiytgytcmvtgindbgzqlaxkqvlgmhv2vtozyv4ar6vuoygjpsweeywtirp774me4sq34jqtm6o33h47iwknvj4kfyd7a5lzntit5enbekzpsmuch6yv2tq3w34fbcsmvglpjgisztwxvu4jq6x42yhw7vh6dz5rj5gie2zi4jdrhjy2vaqpckkb2e2j75g6eew4sh3abmbnvcwuvjixojuqalbj33xi8</xflb:link>\n                     <xflb:beschreibung>Bayernportal</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n               </xflb:onlinedienste>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Antragsteller ist der Träger des nichtstaatlichen Museums.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Fördersatz bis zu 30 % der zuwendungsfähigen Kosten (Zuschuss oder Darlehen möglich).&lt;/p&gt;&lt;p&gt;Höchstförderbetrag 1,0 Mio. €.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;abgegrenzte Projektkosten&lt;/p&gt;&lt;p&gt;Maßnahmen mit zuwendungsfähigen Gesamtkosten von weniger als 10.000 Euro werden nicht gefördert.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Wissenschaft und Kunst</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 44 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO-44</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 23 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO-23</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat K.6</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Kulturfonds Bayern - Kunst</xflb:programmtitel>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2025-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2028-12-31</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:verlaengerungsoption>jährlich</xflb:verlaengerungsoption>\n               </xflb:programmlaufzeit>\n               <xflb:kummulierbareFoerderungen>\n                  <xflb:verweise>\n                     <xflb:verweis>\n                        <xflb:bezeichnung>Kulturfonds Bayern, Kunst</xflb:bezeichnung>\n                        <xflb:link>https://www.stmwk.bayern.de/ministerium/kulturfonds/kunst-und-kultur.html</xflb:link>\n                     </xflb:verweis>\n                  </xflb:verweise>\n                  <xflb:voraussetzungen>Kombination mit Bundesförderung oder kommunalen Förderungen ist möglich.</xflb:voraussetzungen>\n               </xflb:kummulierbareFoerderungen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Kulturfonds Bayern - Bereich Kunst: * Museumsbereich ** Förderung von Investitionen bei nichtstaatlichen Museen; investive Maßnahmen zum Einbruchschutz&lt;/p&gt;&lt;p&gt;Bau, Aus- oder Umbau nichtstaatlicher Museen mit überregionaler Bedeutung; Bau Aus- oder Umbau von Museumsdepots;&amp;nbsp;investive Maßnahmen zum Einbruchschutz bei nichstaatlichen Museen&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>013</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Aus dem Kulturfonds, **Bereich Kunst** , können Investitionsmaßnahmen nichtstaatlicher Museen gefördert werden, aber keine laufenden Betriebskosten (institutionelle Förderung). Die Vorhaben sollen grundsätzlich von überregionaler Bedeutung sein; Maßnahmen mit zuwendungsfähigen Gesamtkosten von weniger als 10.000 € können nicht gefördert werden. Das Fördergebiet umfasst ganz Bayern; grundsätzlich ausgeschlossen sind allerdings Vorhaben in München und Nürnberg (Ausnahme: Einbruchschutz bei nichtstaatlichen Museen). Eine gleichzeitige Förderung aus anderen staatlichen Förderansätzen (Mehrfachförderung) sowie aus Mitteln der Bayerischen Landesstiftung ist grundsätzlich ausgeschlossen. Die Förderung erfolgt nach Maßgabe der zur Verfügung stehenden Haushaltsmittel und ist grundsätzlich auf maximal 30 v. H. der zuwendungsfähigen Kosten begrenzt. Zuwendungen dürfen nur bewilligt werden, wenn mit dem Projekt noch nicht begonnen wurde.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Ausstellungshäuser und sonstige Einrichtungen, die die ICOM-Definition nicht erfüllen.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Vorhaben, mit denen bereits begonnen worden ist. Vorhaben mit (zuwendungsfähigen) Gesamtkosten unter 10.000 €.&lt;br&gt; Vorhaben, die bereits aus anderen Mitteln des Freistaats Bayern gefördert werden (Verbot der Doppelförderung).&lt;br&gt; Museumsausstattung, Gestaltung einer Dauerausstellung (Förderprogramm der Landesstelle für die nichtstaatlichen Museen).&lt;br&gt; Laufende Betriebskosten können aus diesem Programm nicht gefördert werden.&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmwk/blfd/kulturfonds_kunst/index?caller=bpmvsdiobwgiytgytcmvtgindbgzqlaxkqvlgmhv2vtozyv4ar6vuoygjpsweeywtirp774me4sq34jqtm6o33h47iwknvj4kfyd7a5lzntit5enbekzpsmuch6yv2tq3w34fbcsmvglpjgisztwxvu4jq6x42yhw7vh6dz5rj5gie2zi4jdrhjy2vaqpckkb2e2j75g6eew4sh3abmbnvcwuvjixojuqalbj33xi8</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Anträge sind online über das Antragsportal bis zum 1. Oktober (für das darauf folgende Jahr) bei der zuständigen Bezirksregierung einzureichen.&lt;/p&gt;&lt;p&gt;Die Bezirksregierungen prüfen die Anträge vor und legen sie zur Entscheidung dem Bayerischen Staatsministerium für Wissenschaft und Kunst vor.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>&lt;p&gt;Mit dem Vorhaben darf noch nicht (förderschädlich) begonnen worden sein, d.h. es dürfen keine Verträge geschlossen oder Aufträge vergeben worden sein usw.&lt;/p&gt;</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristJaehrlich>01.10.</xflb:fristJaehrlich>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Der Antrag für den Förderzeitraum 2027 muss spätestens am 1. Oktober 2026 eingereicht werden (usw.).\nAbweichend von dieser Antragsfrist können nur für unvorhergesehene und besondere Maßnahmen Förderanträge eingereicht werden (Begründung obligatorisch).</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Aussagekräftige Vorhabensbeschreibung</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Bezeichnung der geplanten Maßnahme, Zeitraum des Vorhabens\nBaubeschreibung mit Raumkonzept, ggf. Planunterlagen</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Kostenplan</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Aufschlüsselung aller, mit dem Vorhaben zusammenhängenden Ausgaben nach Kostengruppen (DIN 276), je nach Vorsteuerabzugsberechtigung brutto oder netto.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Finanzierungsplan</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Der Finanzierungsplan muss neben der Antragssumme auch die Zuwendungen Dritter (z.B. Kommune), sonstige Finanzierungsbeteiligungen (Spenden, Sponsoren) sowie die vom Antragsteller zu erbringende Eigenbeteiligung ausweisen.</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Klage&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_16   [ xyz:attributes  [ xyz:antragsstellung      "https://www.km.bayern.de/administration";
                                xyz:begriffeImKontext    [ rdf:_1  "Systembetreuung";
                                                           rdf:_2  "Wartung und Pflege";
                                                           rdf:_3  "BayARn"
                                                         ];
                                xyz:beschreibung         "Das Förderprogramm umfasst zwei Säulen: Förderung aus Bundesmitteln\n(DigitalPakt-Förderung) und Förderung aus Landesmitteln (Landesförderung).\n\nZweck der DigitalPakt-Förderung ist der trägerneutrale Auf- und Ausbau\nlernförderlicher und belastbarer, interoperabler digitaler technischer\nInfrastrukturen sowie Lehr-Lern-Infrastrukturen und die Optimierung\nvorhandener Strukturen.\n\nZweck der Landesförderung ist die Sicherstellung der Funktionstüchtigkeit der\nan den Schulen insgesamt vorhandenen IT-Infrastrukturen, damit diese von den\nSchulen zuverlässig für das digital gestützte Lehren und Lernen eingesetzt\nwerden können. Die Landesförderung erfolgt ergänzend zu den\neinzelmaßnahmenbezogenen Zuwendungen aus der DigitalPakt-Förderung.";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Aus und Weiterbildung";
                                                           rdf:_2  "Digitalisierung"
                                                         ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Kommunen" ];
                                xyz:foerderprogramm      "Richtlinien zur Bayerischen IT-Administrationsförderung (BayARn)";
                                xyz:foerderzeitraum.bis  "2024-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2020-06-03T00:00:00.000+00:00";
                                xyz:schluessel           "b4f43919-91ec-4fb2-af9c-08d6940865d6";
                                xyz:teaser               "Schulaufwandsträger können für den Auf- und Ausbau von IT-Infrastrukturen an Schulen und für deren technische Administration eine Förderung aus Mitteln der Bundesrepublik Deutschland (DigitalPakt- bzw. Bundesförderung) und aus Landesmitteln (Landesförderung) beantragen.";
                                xyz:titel                "Zuweisungen für die bei der technischen Administration, Wartung und Pflege der Schul-IT anfallenden Personalkosten";
                                xyz:titel.tokens         [ rdf:_1  "Zuweisungen für die bei der technischen Administration";
                                                           rdf:_2  "Wartung und Pflege der Schul-IT anfallenden Personalkosten"
                                                         ];
                                xyz:voraussetzung        "* Um Fördermittel zu erhalten, ist für jede in den Antrag einbezogene Schule ein schuleigenes Medienkonzept (v. a. Ausstattungs- und Fortbildungsplan) zu entwickeln und in eine zentrale Datenbank hochzuladen.\n  * Außerdem müssen die Schulen im Rahmen der aktuellen Umfrage der Akademie für Lehrerfortbildung und Personalführung Dillingen (ALP) den Ist-Stand ihrer IT-Ausstattung dokumentieren.\n  * Für die DigitalPakt-Förderung sind außerdem begonnene Maßnahmen aus den anderen Förderprogrammen des DigitalPakts Schule (Sonderbudget Schülerleihgeräte - SoLe, Sonderbudget Lehrerdienstgeräte - SoLD, digitale Bildungsinfrastruktur an bayerischen Schulen - dBIR) zur Herstellung der Verbundenheit mit dem DigitalPakt Schule Voraussetzung."
                              ];
              xyz:id          "b4f43919-91ec-4fb2-af9c-08d6940865d6";
              xyz:payload     [ xyz:json  [ xyz:anfrage            [ xyz:anfragenummer  "b4f43919-91ec-4fb2-af9c-08d6940865d6";
                                                                     xyz:flb            [ xyz:konkreteFLB  [ xyz:allgemeineAngaben       [ xyz:beschreibung       [ xyz:schluesselwoerter  "Systembetreuung, Wartung und Pflege, BayARn";
                                                                                                                                                                    xyz:teaser             "Schulaufwandsträger können für den Auf- und Ausbau von IT-Infrastrukturen an Schulen und für deren technische Administration eine Förderung aus Mitteln der Bundesrepublik Deutschland (DigitalPakt- bzw. Bundesförderung) und aus Landesmitteln (Landesförderung) beantragen.";
                                                                                                                                                                    xyz:zuwendungszweck    "Das Förderprogramm umfasst zwei Säulen: Förderung aus Bundesmitteln\n(DigitalPakt-Förderung) und Förderung aus Landesmitteln (Landesförderung).\n\nZweck der DigitalPakt-Förderung ist der trägerneutrale Auf- und Ausbau\nlernförderlicher und belastbarer, interoperabler digitaler technischer\nInfrastrukturen sowie Lehr-Lern-Infrastrukturen und die Optimierung\nvorhandener Strukturen.\n\nZweck der Landesförderung ist die Sicherstellung der Funktionstüchtigkeit der\nan den Schulen insgesamt vorhandenen IT-Infrastrukturen, damit diese von den\nSchulen zuverlässig für das digital gestützte Lehren und Lernen eingesetzt\nwerden können. Die Landesförderung erfolgt ergänzend zu den\neinzelmaßnahmenbezogenen Zuwendungen aus der DigitalPakt-Förderung."
                                                                                                                                                                  ];
