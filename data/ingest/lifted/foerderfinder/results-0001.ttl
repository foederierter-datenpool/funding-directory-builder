                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Beschaffung von neuen, zertifizierten digitalen&nbsp;</p><ul><li class=\"unordered-list-item--dash\">BOS-Fahrzeugfunkgeräten</li><li class=\"unordered-list-item--dash\">BOS Funkgeräten zur Nutzung in Rettungs- und Intensivtransporthubschraubern&nbsp;</li><li class=\"unordered-list-item--dash\">BOS-Handfunkgeräten</li><li class=\"unordered-list-item--dash\">BOS-Festfunkstellen</li><li class=\"unordered-list-item--dash\">BOS-TETRA-Pagern (APRT)</li><li class=\"unordered-list-item--dash\">Komponenten zur Ertüchtigung von Sirenenanlagen für die TETRA-Alarmierung ausschließlich mit den jeweils weiter spezifizierten Bestandteilen, sowie ggf. Funktionen und Zubehör.</li></ul>"
                                                                                                                                         ];
