                                                                                                                                           xyz:rechtsbehelf             "<p>Verwaltungsrechtliche Klage</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<ul><li class=\"unordered-list-item--dash\">Vor Antragstellung ist grundsätzlich eine Projektbesprechung mit dem Technologie- und Förderzentrum im Kompetenzzentrum für Nachwachsende Rohstoffe (TFZ) erforderlich.</li><li class=\"unordered-list-item--dash\">Die Antragsunterlagen können im Internet heruntergeladen werden (siehe \"Weiterführende Links\").</li><li class=\"unordered-list-item--dash\">Die Anträge sind beim TFZ einzureichen, das auch zuständig für die Bewilligung ist.</li><li class=\"unordered-list-item--dash\">Mit dem Vorhaben darf vor Bewilligung nicht begonnen werden. Als Vorhabenbeginn gilt bereits der Abschluss eines der Ausführung zuzurechnenden Lieferungs- oder Leistungsvertrages. Planungsleistungen dürfen vor Antragstellung erbracht werden.</li></ul><p><br></p>";
                                                                                                                                                                          xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "002";
                                                                                                                                                                                                            xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
                                                                                                                                                                                                            xyz:listVersionID  "1"
                                                                                                                                                                                                          ]
                                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:euBeihilferelevanz        "Die Förderung erfolgt auf der Grundlage der Verordnung (EU) Nr. 651/2014 (Allgemeine Gruppenfreistellungsverordnung - AGVO) sowie der Verordnung (EU) Nr. 2023/2831 (De-minimis-Verordnung).";
                                                                                                                                           xyz:finanzierungsartUndHoehe  "<p>Förderung Biogasaufbereitungsanlage: Die Zuwendung beträgt zwischen 30 und 40 Prozent der zuwendungsfähigen Investitionskosten. Die Zuwendung erfolgt als Zuschuss in Form einer Anteilsfinanzierung.&nbsp;</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">Für die Errichtung einer neuen, umweltfreundlichen Biogasaufbereitungsanlage mit einer Rohgasaufbereitungskapazität ab 350 Nm³ pro Stunde beträgt die Förderobergrenze 500.000 €.</li>\n  <li class=\"unordered-list-item--dash\">Für die Errichtung einer neuen, umweltfreundlichen Biogasaufbereitungsanlage mit einer Rohgasaufbereitungskapazität ab 700 Nm³ pro Stunde beträgt die Förderobergrenze 800.000 €.</li>\n  <li class=\"unordered-list-item--dash\">Für die Umrüstung einer bestehenden Biogasanlage zu einer neuen, umweltfreundlichen Biogasaufbereitungsanlage beträgt die Förderobergrenze 700.000 €.</li>\n</ul>\n<p>Förderung Biogas- bzw. Biomethanleitung: Die Zuwendung erfolgt als Festbetragsförderung in Höhe von 100 €/m Trassenlänge und 50.000 €/Gasübergabestation.</p>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "001";
                                                                                                                                                                                                    xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
                                                                                                                                                                                                    xyz:listVersionID  "1";
                                                                                                                                                                                                    xyz:name           ""
                                                                                                                                                                                                  ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Zuwendungsfähige Kosten für die Errichtung einer Biogasaufbereitungsanlage: Zuwendungsfähig sind die Investitionskosten für die Biogasaufbereitungsanlage und für die Umbauten der bestehenden Biogasanlage. Diese können im Einzelnen die Kosten für folgende Maßnahmen sein:</p><ul><li class=\"unordered-list-item--dash\">Biogasspezifische Anlagenteile (Aufbereitungsanlage, Übergabestation)</li><li class=\"unordered-list-item--dash\">Bauliche Anlagen und Erschließung</li><li class=\"unordered-list-item--dash\">Planungskosten (bis zu 10% der zuwendungsfähigen Investitionskosten)</li></ul><p>Zuwendungsfähige Kosten für die Errichtung von Biogas- bzw. Biomethanleitungen: Zuwendungsfähig ist der Anteil der Investitionskosten und Kosten gemäß § 33 Abs. 1 GasNZV für Biogas- bzw. Biomethanleitungen und Gasübergabestationen, die nicht vom Netzbetreiber getragen werden müssen.</p><p><br></p>"
                                                                                                                                         ];
