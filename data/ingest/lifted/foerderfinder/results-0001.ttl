                                xyz:titel                "Bauliche Sanierung (Erneuerung und Renovierung, nicht Reparatur) bestehender Trinkwasserleitungen und Abwasserkanäle (Misch-, Schmutz- und Niederschlagswasserkanäle)";
                                xyz:titel.tokens         [ rdf:_1  "Bauliche Sanierung (Erneuerung und Renovierung";
                                                           rdf:_2  "nicht Reparatur) bestehender Trinkwasserleitungen und Abwasserkanäle (Misch-";
                                                           rdf:_3  "Schmutz- und Niederschlagswasserkanäle)"
                                                         ];
                                xyz:voraussetzung        "<p>Für Vorhaben nach Nrn. 2.2.1 wird die Förderung gewährt, wenn die nach Anlage 2 RZWas 2025 ermittelte Pro-Kopf-Belastung eine der Härtefallschwellen nach Anhang Teil B Nr. 4.3 RZWas 2025 überschreitet. Es können nur Vorhaben gefördert werden, die noch nicht begonnen worden sind. Weitere Details erfahren Sie bei Ihrem örtlich zuständigen Wasserwirtschaftsamt.</p>"
                              ];
