                                xyz:xml   "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           produkt=\"Förderfinder\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produktversion=\"\"\n                                           standard=\"XFLB\"\n                                           test=\"\"\n                                           version=\"2.0.0\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0 xflb.xsd\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>74a90c1a-0af2-4f19-917b-8a4626ba1ee1</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2025-01-23T15:57:57</xflb:erstellungszeitpunkt>\n      <xflb:sender>Förderfinder Suche (Bayern)</xflb:sender>\n      <xflb:empfaenger>XFLB-Connect (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>74a90c1a-0af2-4f19-917b-8a4626ba1ee1</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>74a90c1a-0af2-4f19-917b-8a4626ba1ee1</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>74a90c1a-0af2-4f19-917b-8a4626ba1ee1</xflb:foerderschluessel>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400269017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"1\">\n                        <code>4</code>\n                        <name>Regelungskompetenz auf Landesebene</name>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Private Grund- und Mittelschulen; Beantragung eines Zuschusses für den Schulaufwand</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:teaser>Schulaufsichtlich genehmigte private Grundschulen und Mittelschulen werden auf\nAntrag des Schulträgers staatlich gefördert. Für den notwendigen Schulaufwand\nwerden pauschalierte Zuschüsse gewährt.</xflb:teaser>\n                  <xflb:zuwendungszweck>Durch die staatlichen Zuschüsse sollen private Träger bei der Finanzierung des\nSchulaufwands unterstützt werden.</xflb:zuwendungszweck>\n               </xflb:beschreibung>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Staatsministerium für Unterricht und Kultus</xflb:name>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n                  <xflb:adresse>\n                     <xflb:strasse>Salvatorstraße</xflb:strasse>\n                     <xflb:hausnummerPostfach>2</xflb:hausnummerPostfach>\n                     <xflb:postleitzahl>80327</xflb:postleitzahl>\n                     <xflb:ort>München</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:verweis>\n                     <xflb:link>https://www.bayernportal.de/dokumente/leistung/036075275773?localize=false</xflb:link>\n                     <xflb:bezeichnung>Private Grund- und Mittelschulen; Beantragung eines Zuschusses für den Schulaufwand</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Bayerisches Staatsministerium für Unterricht und Kultus</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Private Grund- und Mittelschulen, die von einer juristischen Person des öffentlichen oder privaten Rechts betrieben werden und auf gemeinnütziger Grundlage wirken, erhalten gemäß Art. 32 Bayerisches Schulfinanzierungsgesetz (BaySchFG) für den notwendigen Schulaufwand im Rahmen der schulaufsichtlichen Genehmigung einen pauschalierten Zuschussbetrag je Schülerin oder Schüler und Schuljahr. Leistungen werden erst gewährt, wenn die Schule mindestens zwei Schuljahre (Karenzzeit) ohne wesentliche schulaufsichtliche Beanstandungen bestanden hat. Eine Schule mit weniger als 14 Schülerinnen und Schülern ist von der Leistungsgewährung ausgeschlossen.&lt;/p&gt;\n&lt;p&gt;Weitere Voraussetzung für die Förderung sind:&lt;/p&gt;\n&lt;ul&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Vorliegen einer schulaufsichtlichen Genehmigung der Schule nach Art. 92 ff BayEUG&lt;/li&gt;\n&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:rechtlicheBeschreibung>&lt;p&gt;Private Grund- und Mittelschulen, die von einer juristischen Person des öffentlichen oder privaten Rechts betrieben werden und auf gemeinnütziger Grundlage wirken, erhalten gemäß Art. 32 Bayerisches Schulfinanzierungsgesetz (BaySchFG) für den notwendigen Schulaufwand im Rahmen der schulaufsichtlichen Genehmigung einen pauschalierten Zuschussbetrag je Schülerin oder Schüler und Schuljahr.&lt;/p&gt;</xflb:rechtlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Wird im Einzelfall durch das Bayerische Landesamt für Schule geprüft.&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name>Bayern</name>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Unterricht und Kultus</xflb:verantwortlichesMinisterium>\n               <xflb:verantwortlichesFachreferat>IV.4</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Private Grund- und Mittelschulen; Private Grund- und Mittelschulen; Beantragung eines Zuschusses für den Schulaufwand gem. Art. 32 BaySchFG</xflb:programmtitel>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BaySchFG-32</xflb:link>\n                     <xflb:bezeichnung>Art. 32 Abs. 1 Satz 1 bis 4, Abs. 2 Bayerisches Schulfinanzierungsgesetz (BaySchFG)</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BaySchFG-29</xflb:link>\n                     <xflb:bezeichnung>Art. 29 Bayerisches Schulfinanzierungsgesetz (BaySchFG)</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:programmlaufzeit>\n                  <xflb:endeLaufzeitFoerderprogramm>2030-01-30</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:beginnLaufzeitFoerderprogramm>2025-01-30</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:verlaengerungsoption>ja</xflb:verlaengerungsoption>\n               </xflb:programmlaufzeit>\n               <xflb:kummulierbareFoerderungen>\n                  <xflb:voraussetzungen>&lt;p&gt;Kumulierung möglich, wird jedoch im Einzelfall durch das Bayerische Landesamt für Schule geprüft.&lt;/p&gt;\n&lt;p&gt;Private Grund- und Mittelschulen, die von einer juristischen Person des öffentlichen oder privaten Rechts betrieben werden und auf gemeinnütziger Grundlage wirken, erhalten gemäß Art. 32 Bayerisches Schulfinanzierungsgesetz (BaySchFG) für den notwendigen Schulaufwand im Rahmen der schulaufsichtlichen Genehmigung einen pauschalierten Zuschussbetrag je Schülerin oder Schüler und Schuljahr. Leistungen werden erst gewährt, wenn die Schule mindestens zwei Schuljahre (Karenzzeit) ohne wesentliche schulaufsichtliche Beanstandungen bestanden hat. Eine Schule mit weniger als 14 Schülerinnen und Schülern ist von der Leistungsgewährung ausgeschlossen.&lt;/p&gt;\n&lt;p&gt;Weitere Voraussetzung für die Förderung sind:&lt;/p&gt;\n&lt;ul&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Vorliegen einer schulaufsichtlichen Genehmigung der Schule nach Art. 92 ff. BayEUG&lt;/li&gt;\n&lt;/ul&gt;</xflb:voraussetzungen>\n                  <xflb:verweise>\n                     <xflb:verweis>\n                        <xflb:link>https://www.bayernportal.de/dokumente/leistung/036075275773?localize=false</xflb:link>\n                        <xflb:bezeichnung>Bayernportal</xflb:bezeichnung>\n                     </xflb:verweis>\n                  </xflb:verweise>\n               </xflb:kummulierbareFoerderungen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.bayernportal.de/dokumente/leistung/036075275773?localize=false</xflb:linkZurAntragsstellung>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Es sind Unterlagen beizubringen. Die notwendigen Antragsformulare erhalten Sie beim Bayerischen Landesamt für Schule.</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Die betreffenden Unterlagen sind im Folgenden aufgelistet.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Nachweis der Gemeinnützigkeit (wird vom zuständigen Finanzamt bescheinigt)</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Genehmigungsbescheid der örtlich zuständigen Regierung</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>ggf. weitere Unterlagen nach Anforderung des Bayerischen Landesamts für Schule</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>Die Abwicklung der pauschalierten Leistungen für den notwendigen Schulaufwand\nerfolgt zentral durch das Bayerische Landesamt für Schule.</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristSpanne>\n                        <xflb:min>\n                           <xflb:monate>1</xflb:monate>\n                        </xflb:min>\n                        <xflb:max>\n                           <xflb:monate>6</xflb:monate>\n                        </xflb:max>\n                     </xflb:fristSpanne>\n                  </xflb:zeitlicheEingrenzung>\n               </xflb:antragsfrist>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:monate>1</xflb:monate>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>6</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n            </xflb:antragsinformationen>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Private Grund- und Mittelschulen, die von einer juristischen Person des öffentlichen oder privaten Rechts betrieben werden und auf gemeinnütziger Grundlage wirken, erhalten gemäß Art. 32 Bayerisches Schulfinanzierungsgesetz (BaySchFG) für den notwendigen Schulaufwand im Rahmen der schulaufsichtlichen Genehmigung einen pauschalierten Zuschussbetrag je Schülerin oder Schüler und Schuljahr. Leistungen werden erst gewährt, wenn die Schule mindestens zwei Schuljahre (Karenzzeit) ohne wesentliche schulaufsichtliche Beanstandungen bestanden hat. Eine Schule mit weniger als 14 Schülerinnen und Schülern ist von der Leistungsgewährung ausgeschlossen.&lt;/p&gt;\n&lt;p&gt;Private Grund- und Mittelschulen, die von einer juristischen Person des öffentlichen oder privaten Rechts betrieben werden und auf gemeinnütziger Grundlage wirken, erhalten gemäß Art. 32 Bayerisches Schulfinanzierungsgesetz (BaySchFG) für den notwendigen Schulaufwand im Rahmen der schulaufsichtlichen Genehmigung einen pauschalierten Zuschussbetrag je Schülerin oder Schüler und Schuljahr. Leistungen werden erst gewährt, wenn die Schule mindestens zwei Schuljahre (Karenzzeit) ohne wesentliche schulaufsichtliche Beanstandungen bestanden hat. Eine Schule mit weniger als 14 Schülerinnen und Schülern ist von der Leistungsgewährung ausgeschlossen.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name>Kommunen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name>Vereine</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name>Verbände</name>\n               </xflb:foerdernehmende>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Private Grund- und Mittelschulen, die von einer juristischen Person des öffentlichen oder privaten Rechts betrieben werden und auf gemeinnütziger Grundlage wirken, erhalten gemäß Art. 32 Bayerisches Schulfinanzierungsgesetz (BaySchFG) für den notwendigen Schulaufwand im Rahmen der schulaufsichtlichen Genehmigung einen pauschalierten Zuschussbetrag je Schülerin oder Schüler und Schuljahr.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Ausführliche Beschreibung des Fördergegenstands&lt;/p&gt;\n&lt;p&gt;Private Grund- und Mittelschulen, die von einer juristischen Person des öffentlichen oder privaten Rechts betrieben werden und auf gemeinnütziger Grundlage wirken, erhalten gemäß Art. 32 Bayerisches Schulfinanzierungsgesetz (BaySchFG) für den notwendigen Schulaufwand im Rahmen der schulaufsichtlichen Genehmigung einen pauschalierten Zuschussbetrag je Schülerin oder Schüler und Schuljahr. Leistungen werden erst gewährt, wenn die Schule mindestens zwei Schuljahre (Karenzzeit) ohne wesentliche schulaufsichtliche Beanstandungen bestanden hat. Eine Schule mit weniger als 14 Schülerinnen und Schülern ist von der Leistungsgewährung ausgeschlossen.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:zuwendungsart>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2025-01-23T15:57:57</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>002</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>022</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>\n"
                              ]
            ];
  rdf:_130  [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver.bayern.de/intelliform/forms/rzsued/zbfs/zbfs/leistungen_an_inklusionsbetriebe/index";
                                xyz:begriffeImKontext    [ rdf:_1  "Inklusionsbetrieb";
                                                           rdf:_2  "Inklusionsunternehmen";
                                                           rdf:_3  "Integrationsabteilung";
                                                           rdf:_4  "Integrationsbetrieb";
                                                           rdf:_5  "Inklusionsprojekt";
                                                           rdf:_6  "Inklusionsabteilung";
                                                           rdf:_7  "Integrationsprojekt"
                                                         ];
                                xyz:beschreibung         "<p>Die Förderung unterstützt Inklusionsbetriebe beim Aufbau, Erweiterung, Modernisierung sowie Ausstattung, einschließlich einer betriebswirtschaftlichen Beratung und besonderer Aufwände nach § 217 SGB IX.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Gesundheit und Soziales" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Einzelunternehmen";
                                                           rdf:_2  "Kleine und mittlere Unternehmen"
                                                         ];
                                xyz:foerderzeitraum.bis  "2029-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2023-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "f8530627-ef82-4c53-887a-3c61a01d0e7b";
                                xyz:teaser               "Der Freistaat Bayern unterstützt Inklusionsbetriebe mit finanziellen Mitteln, damit diese dauerhaft Arbeitsplätze für Menschen mit Schwerbehinderung oder Gleichstellung schaffen oder erhalten können.";
                                xyz:titel                "Förderung für Inklusionsbetriebe";
                                xyz:titel.tokens         [ rdf:_1  "Förderung für Inklusionsbetriebe" ];
                                xyz:voraussetzung        "<p>Die Förderung kann für Inklusionsbetriebe beantragt werden. Der Betrieb, für den die Leistung beantragt wird, muss&nbsp;</p><ul><li class=\"unordered-list-item--dash\">ein rechtlich und wirtschaftlich selbstständiges Unternehmen, unternehmensinterner Betrieb oder Abteilung auf dem allgemeinen Arbeitsmarkt sein, und&nbsp;</li><li class=\"unordered-list-item--dash\">mindestens 30 Prozent schwerbehinderte Menschen beschäftigen, deren Teilhabe an einer sonstigen Beschäftigung auf dem allgemeinen Arbeitsmarkt auf Grund von Art oder Schwere der Behinderung oder wegen sonstiger Umstände voraussichtlich trotz Ausschöpfens aller Fördermöglichkeiten und des Einsatzes von Integrationsfachdiensten auf besondere Schwierigkeiten stößt (sog. Zielgruppenmitarbeiter).&nbsp;</li></ul><p>Der Anteil der schwerbehinderten Menschen soll in der Regel 50 Prozent nicht übersteigen.</p>"
                              ];
              xyz:id          "f8530627-ef82-4c53-887a-3c61a01d0e7b";
