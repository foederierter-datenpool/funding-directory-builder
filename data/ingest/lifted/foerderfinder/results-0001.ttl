                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Zuwendungsfähig sind Sachausgaben für die Durchführung der Fortbildungsmaßnahmen einschließlich der Raummiete, der Referentenkosten, der Fahrtkosten und des Materials.</p><p>Der Zuwendungsempfänger hat sich mit einem angemessenen Eigenanteil in Höhe von 10% der zuwendungsfähigen Ausgaben an der Finanzierung zu beteiligen.&nbsp;</p>"
                                                                                                                                         ];
