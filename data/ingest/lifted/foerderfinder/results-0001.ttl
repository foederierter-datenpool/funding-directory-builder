                                                                                                                       xyz:programmtitel             "Fit for Work - Chance Teilzeitausbildung (Aktion 4.2)";
                                                                                                                       xyz:verantwortlichesFachreferat
                                                                                                                               "Referat I 4";
                                                                                                                       xyz:verantwortlichesMinisterium
