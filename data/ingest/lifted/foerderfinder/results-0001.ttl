                                                                                                                       xyz:handlungsgrundlagen        [ xyz:verweis  [ rdf:_1  [ xyz:bezeichnung  "Art. 21ff des Gesetzes über den öffentlichen Personennahverkehr in Bayern (BayÖPNVG)";
                                                                                                                                                                                 xyz:link         "https://www.gesetze-bayern.de/Content/Document/BayOePNVG-21"
                                                                                                                                                                               ];
                                                                                                                                                                       rdf:_2  [ xyz:bezeichnung  "Art. 13c des Gesetzes über den Finanzausgleich zwischen Staat, Gemeinden und Gemeindeverbänden (Bayerisches Finanzausgleichsgesetz - BayFAG)";
                                                                                                                                                                                 xyz:link         "https://www.gesetze-bayern.de/Content/Document/BayFAG-13c"
                                                                                                                                                                               ];
                                                                                                                                                                       rdf:_3  [ xyz:bezeichnung  "Richtlinien für die Gewährung von Zuwendungen des Freistaates Bayern für den öffentlichen Personennahverkehr (ÖPNV-Zuwendungsrichtlinien - RZÖPNV)";
                                                                                                                                                                                 xyz:link         "https://www.gesetze-bayern.de/Content/Document/BayVV_97_B_14197/true"
                                                                                                                                                                               ];
                                                                                                                                                                       rdf:_4  [ xyz:bezeichnung  "Gesetz über Zuwendungen des Freistaates Bayern zur Verbesserung der Verkehrsverhältnisse der Gemeinden (Bayerisches Gemeindeverkehrsfinanzierungsgesetz - BayGVFG)";
                                                                                                                                                                                 xyz:link         "https://www.gesetze-bayern.de/Content/Document/BayGVFG"
                                                                                                                                                                               ];
                                                                                                                                                                       rdf:_5  [ xyz:bezeichnung  "Gesetz über Finanzhilfen des Bundes zur Verbesserung der Verkehrsverhältnisse der Gemeinden (Gemeindeverkehrsfinanzierungsgesetz - GVFG)";
                                                                                                                                                                                 xyz:link         "https://www.gesetze-im-internet.de/gvfg/"
                                                                                                                                                                               ];
                                                                                                                                                                       rdf:_6  [ xyz:bezeichnung  "Art. 44 Bayerische Haushaltsordnung (BayHO) und VV zu Art. 44 BayHO";
                                                                                                                                                                                 xyz:link         "https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN44"
                                                                                                                                                                               ]
                                                                                                                                                                     ]
                                                                                                                                                      ];
                                                                                                                       xyz:kummulierbareFoerderungen  [ xyz:beschreibungAusschluss  "<ul>\n  <li class=\"unordered-list-item--dash\">Baumaßnahme steht nicht im Zusammenhang mit einer Verkehrsanlage des allgemeinen ÖPNV oder der S-Bahn.</li>\n  <li class=\"unordered-list-item--dash\">Geplante Baumaßnahme ist nicht nach BayGVFG oder GVFG förderfähig.</li>\n  <li class=\"unordered-list-item--dash\">Mit der Baumaßnahme wurde noch vor Erlass des Förderbescheides und ohne vorherige Zustimmung zum vorzeitigen Maßnahmebeginn begonnen.</li>\n</ul>";
                                                                                                                                                        xyz:verweise                [ xyz:verweis  [ xyz:bezeichnung  "ÖPNV-Infrastrukturförderung nach BayGVFG";
                                                                                                                                                                                                     xyz:link         "https://foerderfinder.digital/bayern/suche/detail/b99f62ae-5cf3-467b-96dd-f90ecd4d337a"
                                                                                                                                                                                                   ]
                                                                                                                                                                                    ];
                                                                                                                                                        xyz:voraussetzungen         "<p>Die Förderung des Baus- oder Ausbaus von Verkehrswegen und -anlagen des ÖPNV nach Art. 13c Abs. 2 BayFAG erfolgt nur, sofern diese ÖPNV-Infrastrukturmaßnahme auch nach BayGVFG oder Bundes-GVFG gefördert wird.&nbsp;</p>\n<p>Eine Förderung entfällt jedoch, wenn für den gleichen Zuwendungszweck andere Mittel des Freistaates Bayern - vorbehaltlich der Förderung aus Sonderprogrammen und nach dem Dritten Buch Sozialgesetzbuch - Arbeitsförderung - in Anspruch genommen werden.</p>\n<p>Soweit die Inanspruchnahme zusätzlicher Fördermittel für den gleichen Zuwendungszweck zulässig ist, werden diese Mittel nicht auf die gemäß RZÖPNV bewilligten Zuwendungen angerechnen. Bei der Bemessung der Höhe der Gesamtzuwendung muss ein angemessener Eigenanteil des Zuwendungsempfängers (VV Nr. 2.4.2 zu Art. 44 BayHO) verbleibt. Dieser beträgt bei Projektförderungen wie der Förderung nach Art. 13c Abs. 2 BayFAG mindestens 10% der förderfähigen (= zuwendungsfähigen) Ausgaben (VV Nr. 2.4.2 Satz 3 zu Art. 44 BayHO).</p>"
                                                                                                                                                      ];
                                                                                                                       xyz:programmlaufzeit           [ xyz:beginnLaufzeitFoerderprogramm
                                                                                                                                                                "2024-01-01";
                                                                                                                                                        xyz:endeLaufzeitFoerderprogramm
                                                                                                                                                                "2027-12-31"
                                                                                                                                                      ];
                                                                                                                       xyz:programmtitel              "Öffentlicher Personennahverkehr - Komplementäre Förderung des Baus oder Ausbaus von Verkehrswegen und -anlagen des allgemeinen ÖPNV und von S-Bahnen nach Art. 13c Abs. 2 BayFAG";
                                                                                                                       xyz:verantwortlichesFachreferat
                                                                                                                               "Referat 62";
                                                                                                                       xyz:verantwortlichesMinisterium
                                                                                                                               "Staatsministerium der Finanzen und für Heimat zusammen mit dem Staatsministerium für Wohnen, Bau und Verkehr"
                                                                                                                     ];
                                                                                                             xyz:foerdervoraussetzungen  [ xyz:ausschlusskriterien     "<ul><li class=\"unordered-list-item--dash\">Baumaßnahme steht nicht im Zusammenhang mit einer Verkehrsanlage des allgemeinen ÖPNV oder der S-Bahn.</li><li class=\"unordered-list-item--dash\">Geplante Baumaßnahme ist nicht nach BayGVFG oder GVFG förderfähig.</li><li class=\"unordered-list-item--dash\">Mit der Baumaßnahme wurde noch vor Erlass des Förderbescheides und ohne vorherige Zustimmung zum vorzeitigen Maßnahmebeginn begonnen.</li></ul>";
                                                                                                                                           xyz:buergerfreundlicheBeschreibung
                                                                                                                                                   "<p>Die Zuwendungen nach Art. 13c Abs. 2 BayFAG können nur gewährt werden, wenn die Voraussetzungen des Art. 3 BayGVFG erfüllt sind. Danach muss das Vorhaben</p><ul><li class=\"unordered-list-item--dash\">nach Art und Umfang zur Verbesserung der Verkehrsverhältnisse dringend erforderlich sein,&nbsp;</li><li class=\"unordered-list-item--dash\">die Ziele der Raumordnung und Landesplanung berücksichtigen sowie die sonstigen rechtlichen Voraussetzungen erfüllen,&nbsp;</li><li class=\"unordered-list-item--dash\">in einem Generalverkehrsplan oder gleichwertigen Plan vorgesehen sein,&nbsp;</li><li class=\"unordered-list-item--dash\">bau- und verkehrstechnisch einwandfrei und unter Berücksichtigung des Grundsatzes der Wirtschaftlichkeit und Sparsamkeit geplant sein,&nbsp;</li><li class=\"unordered-list-item--dash\">mit städtebaulichen Maßnahmen, die gegebenenfalls betroffen sind, abgestimmt sein,&nbsp;</li><li class=\"unordered-list-item--dash\">die Belange von Menschen mit Behinderungen oder mit Mobilitätseinschränkungen berücksichtigen und den Anforderungen der Barrierefreiheit möglichst weitreichend entsprechen.</li><li class=\"unordered-list-item--dash\">Die Finanzierung des Vorhabens oder eines Bauabschnittes des Vorhabens mit eigener Verkehrsbedeutung muss gewährleistet sein.</li></ul>";
                                                                                                                                           xyz:rechtlicheBeschreibung  "<p>Nähere Ausführungen zu den Fördervoraussetzungen können Nr. 5 der RZÖPNV entnommen werden.</p>"
                                                                                                                                         ];
