                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>2c00720d-3881-4ac9-9731-d625a495458b</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2025-02-20T11:13:14</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>2c00720d-3881-4ac9-9731-d625a495458b</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>2c00720d-3881-4ac9-9731-d625a495458b</xflb:schluessel>\n         <xflb:versionFLB>3</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-09-21T08:27:53</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>2c00720d-3881-4ac9-9731-d625a495458b</xflb:foerderschluessel>\n                  <xflb:flbVersion>3</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400070017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Güterverkehrszentrum; Beantragung einer Förderung</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Aufgrund der regionalen und überregionalen Bedeutung von GVZ soll durch die Förderung der Aufwendungen für Planung und Konzeption die Errichtung von GVZ gefördert werden.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Gemeinden und Gemeindeverbände können Förderungen für Planung, Konzeptionierung und infrastrukturelle Investitionen in Güterverkehrszentren beantragen.</xflb:teaser>\n                  <xflb:schluesselwoerter>Kombinierter Verkehr, Logistik, Umschlaganlagen, Logistikzentrum</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Bayerisches Staatsministerium für Wohnen, Bau und Verkehr</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>b113d05d-8816-4695-947c-bdc71e0503a8</xflb:id>\n                     <xflb:bezeichnung>Formloser Antrag (mit Unterschrift)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/formloseSchreibenmitUnterschrift/index</xflb:link>\n                     <xflb:beschreibung>&lt;p&gt;Dieser Assistent unterstützt Sie bei der Erstellung eines formlosen Schreibens, wenn die zuständige Stelle kein Antragsformular zur Verfügung stellt.&lt;/p&gt;</xflb:beschreibung>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Zuwendungsempfänger sind Gemeinden und Gemeindeverbände.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Der regelmäßige Fördersatz beträgt 50% in Form einer Anteilsfinanzierung.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Gefördert werden kann beispielsweise das Erstellen einer Machbarkeitsstudie oder auch die Kosten für externe Planungsleistungen. Es können aber auch infrastrukturelle Investitionen der Gemeinden und Gemeindeverbände für die Errichtung des GVZ gefördert werden.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Wohnen, Bau und Verkehr</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 23 und 44 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO/true</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:programmtitel>Güterverkehrszentrum</xflb:programmtitel>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>1972-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2030-06-30</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Zur Realisierung einer umweltverträglicheren und rationelleren Güterbeförderung haben sich Bund und Länder auf die Schaffung eines Netzes an Güterverkehrszentren (GVZ) verständigt. Neben den Erschließungsaufwendungen müssen die Kommunen auch die Kosten für Planung und Konzeption der GVZ sowie für die GVZ-Entwicklungsgesellschaften (GVZ-E) tragen. Die gesamten Aufwendungen für ein GVZ übersteigen die Finanzkraft der Kommunen.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Voraussetzung für die Errichtung von GVZ ist das kommunale Engagement. Die Förderung gilt nur für Gemeinden und Gemeindeverbände. Es darf kein vorzeitiger Maßnahmenbeginn vorliegen, d. h. es dürfen noch keine Verträge hinsichtlich der Maßnahmen geschlossen worden sein. Vor der Antragstellung sollte Kontakt mit dem Bayerischen Staatsministerium für Wohnen, Bau und Verkehr aufgenommen werden, um die spezifischen Anforderungen zu klären.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/formloseSchreibenmitUnterschrift/index</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Der schriftliche Antrag muss beim Bayerischen Staatsministerium für Wohnen, Bau und Verkehr eingereicht werden. Der weitere Vollzug der Förderung erfolgt regelmäßig bei der zuständigen Bezirksregierung.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>001</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Formloser Antrag (mit Unterschrift)</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Klage gegen beschränkende Nebenbestimmungen des Bewilligungsbescheides&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_102  [ xyz:attributes  [ xyz:antragsstellung      "https://www.lfp.bayern.de/wp-content/uploads/2024/04/Antrag_Erklaerungen_HebNp_ab1.1.24.pdf";
                                xyz:begriffeImKontext    [ rdf:_1   "Niederlassungsprämie";
                                                           rdf:_10  "Bayern";
                                                           rdf:_2   "Niederlassung";
                                                           rdf:_3   "freiberufliche Hebammen";
                                                           rdf:_4   "Gründung";
                                                           rdf:_5   "Niederlassungsförderung";
                                                           rdf:_6   "Prämie";
                                                           rdf:_7   "Zuschuss";
                                                           rdf:_8   "Hebamme";
                                                           rdf:_9   "Hebammen in Bayern"
                                                         ];
                                xyz:beschreibung         "<p>Die Niederlassungsprämie in Höhe von einmalig bis zu 5.000 EUR soll der Anerken nung und Unterstützung von Hebammen dienen, die sich freiberuflich niederlassen wollen. Zusätzlich soll sie einen Anreiz schaffen, um freiberufliche Hebammen für eine Tätigkeit in der Hebammenhilfe zu gewinnen und die Attraktivität des Hebammenberufs zu stärken. Ziel der Zuwendung ist die Sicherung einer flächendeckenden, wohnortna hen Betreuung und Versorgung von werdenden Müttern und ihren Neugeborenen.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Anteilsfinanzierung/Kapitalbeteiligung" ];
                                xyz:foerderbereich       [ rdf:_1  "Arbeit";
                                                           rdf:_2  "Existenzgründung und -festigung";
                                                           rdf:_3  "Gesundheit und Soziales";
                                                           rdf:_4  "Regionalförderung"
                                                         ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Freiberufler";
                                                           rdf:_2  "Privatpersonen"
                                                         ];
                                xyz:foerderprogramm      "Hebammenniederlassungsprämie";
                                xyz:foerderzeitraum.bis  "2026-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2019-09-01T00:00:00.000+00:00";
                                xyz:schluessel           "86433b44-7e53-4c58-9d02-119f0533b97b";
                                xyz:teaser               "Wenn Sie sich als freiberufliche Hebammen in Bayern niederlassen wollen, können Sie u.U. die Hebammenniederlassungsprämie erhalten.";
                                xyz:titel                "Hebammenniederlassungsprämie für freiberufliche Hebammen";
                                xyz:titel.tokens         [ rdf:_1  "Hebammenniederlassungsprämie für freiberufliche Hebammen" ];
                                xyz:voraussetzung        "<p>Sie müssen:</p><p>- im Besitz einer Erlaubnis zur Führung der Berufsbezeichnung nach § 5 des Hebammengesetzes sein,</p><p>- Ihre Niederlassung in Bayern nach dem 31.12.2023 begründen,</p><p>- die Gründung der Niederlassung beim zuständigen Gesundheitsamt angezeigt haben.</p><p>- sich mit Antragstellung bereiterklären, mindestens drei Jahre freiberuflich als Hebamme in Bayern tätig zu sein.</p><p>Im Fall der Wiederaufnahme der freiberuflichen Tätigkeit muss der Zeitraum zwischen der Beendigung und der Wiederanmeldung der Tätigkeit nach Art. 10 Abs. 3 des Gesundheitsdienstgesetzes (GDG) mindestens ein Jahr betragen.</p>"
                              ];
