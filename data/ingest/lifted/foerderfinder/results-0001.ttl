                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>a907ae22-df93-43a2-8770-0908d13c0e88</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-12-17T16:03:04</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>a907ae22-df93-43a2-8770-0908d13c0e88</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>a907ae22-df93-43a2-8770-0908d13c0e88</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-12-17T16:03:04</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>a907ae22-df93-43a2-8770-0908d13c0e88</xflb:foerderschluessel>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Betreuung suchtkranker und suchtgefährdeter Gefangener und Verwahrter in den bayerischen Justizvollzugsanstalten (JVA) durch externe Fachkräfte</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Ziel ist die Unterstützung suchtkranker und -gefährdeter Menschen in Haft durch Beratung, durch Förderung der Veränderungsbereitschaft bei Gefangenen und Verwahrten mit Abhängigkeitserkrankungen, durch Vermittlung in geeignete Hilfeangebote nach Haftende sowie die psychosoziale Betreuung von Substituierten.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Betreuung suchtkranker und suchtgefährdeter Gefangener und Verwahrter in den bayerischen Justizvollzugsanstalten durch externe Fachkräfte</xflb:teaser>\n                  <xflb:schluesselwoerter>Suchtprävention, Suchtbekämpfung, JVA, Justizvollzugsanstalt</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Grundsätze für die suchtpräventive Arbeit in Bayern</xflb:bezeichnung>\n                     <xflb:link>fimportal.de/search?sdg_relevant=undefined&amp;sprache=undefined&amp;vollzugsbehoerde=undefined&amp;leistung_geaendert_seit=&amp;term=99090009027000&amp;leistung_suche_in=undefined&amp;order_by=relevance&amp;resource=leistung-steckbriefe&amp;page_size=20</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Staatsministerium für Gesundheit, Pflege und Prävention</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>1</xflb:hausnummerPostfach>\n                     <xflb:strasse>Haidenauplatz</xflb:strasse>\n                     <xflb:postleitzahl>81667</xflb:postleitzahl>\n                     <xflb:ort>München</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>poststelle@stmgp.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Bayerisches Staatsministerium für Gesundheit, Pflege und Prävention</xflb:bezeichnung>\n                     <xflb:link>https://www.stmgp.bayern.de/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>089 95414 0</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>für den Maßnahmenstandort zuständige Regierung</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>374110ba-a9a8-42c9-8f85-dd282a20c06a</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Gewährung einer staatlichen Zuwendung - Förderprogramm: Suchtbekämpfung</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/13/rmf_13-037/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>fdded724-b5cf-44c1-afd9-ac504b662134</xflb:id>\n                     <xflb:bezeichnung>Verwendungsnachweis über staatliche Zuwendungen - Förderprogramm: Suchtbekämpfung</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/13/rmf_13-034/index</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Förderberechtigt sind hier vor allem die Spitzenverbände der freien Wohlfahrtspflege und deren Mitgliedsorganisationen sowie kommunale Gebietskörperschaften in Bayern.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Zuwendung wird als Zuschuss im Rahmen einer Projektförderung in Form der Festbetragsfinanzierung (Förderpauschale) gewährt.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Förderung der Personalausgaben bemisst sich nach den Personalausgabenhöchstsätzen bei Zuwendungen des Freistaates Bayern des Staatsministeriums der Finanzen und für Heimat in der jeweils geltenden Fassung.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Für Fahrtausgaben, die durch notwendige Dienstfahrten entstehen, wird pro Vollzeitstelle ein Fahrtkostenhöchstbetrag gewährt. Dieser beträgt für&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Kategorie I (Entfernung JVA - Beratungsstelle bis 20 km): bis zu 500 Euro, Kategorie II (Entfernung JVA - Beratungsstelle von 21 bis 60 km): bis zu 1 500 Euro, Kategorie III (Entfernung JVA - Beratungsstelle von 61 bis 100 km): bis zu 2 500 Euro, Kategorie IV (Entfernung JVA - Beratungsstelle von mehr als 100 km): bis zu 3 000 Euro.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Für Sachausgaben, die zuwendungsfähig sind, wird, ausgenommen der Fahrtkosten, ein Höchstbetrag von bis zu 2 000 Euro pro Vollzeitstelle gewährt.&lt;/li&gt;&lt;/ul&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Die Zuwendung darf die dem Träger für die in der geförderten Maßnahme tatsächlich jeweils entstehenden förderfähigen Personal- und Sachausgaben nicht übersteigen.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerFest>\n                        <xflb:jahre>1</xflb:jahre>\n                     </xflb:dauerFest>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n               <xflb:euBeihilferelevanz>Bei Zuwendungen im Rahmen dieser Förderrichtlinie handelt es sich grundsätzlich um eine sog. DAWI-De-minimis-Beihilfe nach der DAWI-De-minimis-Verordnung: Verordnung Nr. 2023/2832 der Kommission vom 13. Dezember 2023 über die Anwendung der Artikel 107 und 108  des Vertrags über die Arbeitsweise der Europäischen Union auf De-minimis-Beihilfen an Unternehmen, die Dienstleistungen von allgemeinem wirtschaftlichem Interesse erbringen (Amtsblatt der Europäischen Union L, 2023/2832, 15. Dezember 2023).</xflb:euBeihilferelevanz>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Gesundheit, Pflege und Prävention</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinie zur Förderung von Präventions- und Beratungsangeboten im  Suchtbereich (PBS-Förderrichtlinie PBS-FöR) ,BayMBl. 2021 Nr. 805</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2126_1_G_12555</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 44 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO-44</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 23 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO-23</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat 54</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Förderung von Präventions- und Beratungsangeboten im Suchtbereich</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2027-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2025-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2027-12-31</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:verlaengerungsoption>jährlich</xflb:verlaengerungsoption>\n               </xflb:programmlaufzeit>\n               <xflb:kummulierbareFoerderungen>\n                  <xflb:beschreibungAusschluss>&lt;p&gt;Eine Förderung nach dieser Richtlinie entfällt, wenn für den gleichen Zuwendungszweck andere Mittel des Freistaates Bayern in Anspruch genommen werden.&lt;/p&gt;</xflb:beschreibungAusschluss>\n                  <xflb:verweise>\n                     <xflb:verweis>\n                        <xflb:bezeichnung>Bayerisches Staatsministerium für Gesundheit, Pflege und Prävention</xflb:bezeichnung>\n                        <xflb:link>https://www.stmgp.bayern.de/service/foerderprogramme/#PBS</xflb:link>\n                     </xflb:verweis>\n                  </xflb:verweise>\n                  <xflb:voraussetzungen>&lt;p&gt;Eine Komplementärförderung mit Mitteln der Kommunen, des Bundes oder der Europäischen Union ist möglich.&amp;nbsp;&lt;/p&gt;</xflb:voraussetzungen>\n               </xflb:kummulierbareFoerderungen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert werden Personalausgaben für Fachkräfte der externen Suchtberatung sowie Sachausgaben, die für die Durchführung der Beratung entstehen.&amp;nbsp;&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Fachkräfte verfügen über einen Abschluss mit Bachelor oder Diplom in den Studiengängen soziale Arbeit oder Sozialpädagogik.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Ausländische Studienabschlüsse können berücksichtigt werden, sofern sie in Deutschland als gleichwertig anerkannt sind.&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;In begründeten Einzelfällen kann der Einsatz von Fachkräften mit vergleichbarer Qualifikation genehmigt werden. Voraussetzung hierfür ist, dass die Bewerberin oder der Bewerber entweder eine suchtspezifische &amp;nbsp;Zusatzqualifikation oder Weiterbildung nachweisen kann, sich zu Beginn der Tätigkeitsaufnahme dazu verpflichtet, diese schnellstmöglich zu erwerben oder über eine mehrjährige Berufserfahrung im Hilfesystem verfügt. Die Genehmigung ist vor einer geplanten Anstellung bei der Bewilligungsbehörde zu beantragen.&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Fachkräfte sind verpflichtet, sich regelmäßig weiterzubilden und sich supervidieren zu lassen.&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:rechtlicheBeschreibung>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Entscheidung der Bewilligungsbehörde über die Zuwendung erfolgt stets unter Berücksichtigung des aktuellen, vom Bayerischen Staatsministerium für Gesundheit, Pflege und Prävention (StMGP) in Abstimmung mit dem Staatsministerium der Justiz (StMJ) festgesetzten Bedarfsplans.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Besetzung der bewilligten Stellen ist durch den jeweils beauftragten Träger sicherzustellen.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Der Träger legt als Dienstort der Fachkraft die JVA fest, in der sie überwiegend tätig ist.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Fachkräfte, welche nicht von Gesetzes wegen den Verpflichtungen gemäß Art. 201 Abs. 1 in Verbindung mit Abs. 3 Bayerisches Strafvollzugsgesetz (BayStVollzG), Art. 36 Bayerisches Untersuchungshaftvollzugsgesetz in Verbindung mit Art. 201 Abs. 1 in Verbindung mit Abs. 3 BayStVollzG, Art. 96 Bayerisches Sicherungsverwahrungsvollzugsgesetz in Verbindung mit Art. 201 Abs. 1 in Verbindung mit Abs. 3 BayStVollzG unterliegen, sind zur Einhaltung der vorgenannten Normen zu verpflichten.&lt;/li&gt;&lt;/ul&gt;</xflb:rechtlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Eine Förderung nach dieser Richtlinie entfällt, wenn für den gleichen Zuwendungszweck andere Mittel des Freistaates Bayern in Anspruch genommen werden.&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/13/rmf_13-037/index</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Projekte und Maßnahmen sind in enger fachlicher Abstimmung mit der Bewilligungsbehörde &amp;nbsp;und dem StMGP zu planen und durchzuführen.&amp;nbsp;&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>&lt;p&gt;Ist es für eine erfolgreiche Durchführung des Vorhabens zwingend notwendig, bereits vor Erhalt des Förderbescheids einen Arbeits- oder Leistungsvertrag abzuschließen, ist eine Zustimmung zu einem vorzeitigen Maßnahmebeginn möglich.&lt;/p&gt;</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:wochen>2</xflb:wochen>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:wochen>4</xflb:wochen>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristFest>\n                        <xflb:jahre>1</xflb:jahre>\n                     </xflb:fristFest>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Förderanträge zur Fortführung bereits bestehender Maßnahmen und Projekte (Folgeanträge) sind bei der Bewilligungsbehörde jeweils bis zum 1. Dezember des dem beantragten Förderzeitraum vorausgehenden Jahres vorzulegen. Bewilligungszeitraum ist das Kalenderjahr.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Qualifikationsnachweis</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Abschlusszeugnis mit Bachelor oder Diplom in den Studiengängen soziale Arbeit oder Sozialpädagogik; \nIn begründeten Einzelfällen ggf. Nachweis einer suchtspezifischen Zusatzqualifikation oder Weiterbildung</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Gegen den Bescheid kann innerhalb eines Monats nach seiner Bekanntgabe Klage beim örtlich zuständigen Verwaltungsgericht eingereicht werden.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_192  [ xyz:attributes  [ xyz:antragsstellung      "https://www.lfp.bayern.de/bayerischerdemenzfonds/#foerderungvonangeboten";
