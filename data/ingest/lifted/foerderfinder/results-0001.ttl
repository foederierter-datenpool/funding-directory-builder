                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>4ce46213-2943-4b43-8940-8896130048fc</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-11-27T15:46:46</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>4ce46213-2943-4b43-8940-8896130048fc</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>4ce46213-2943-4b43-8940-8896130048fc</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-11-27T15:46:46</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>4ce46213-2943-4b43-8940-8896130048fc</xflb:foerderschluessel>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400183017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Private Förderschulen und Klinikschulen; Beantragung einer Förderung zum Ausgleich besonderer Härten</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Der Betrieb privater Förderschulen und Klinikschulen soll durch eine auskömmliche Finanzierung sichergestellt werden.&lt;/p&gt;&lt;p&gt;Zuwendungsempfänger sind die jeweiligen privaten Träger der Schulen.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern gewährt Zuschüsse an Träger privater Förderschulen und privater Klinikschulen zum Ausgleich besonderer Härten, soweit sonstige Leistungen nach dem Bayerisches Schulfinanzierungsgesetz die tatsächlichen und notwendigen Aufwendungen nicht decken..</xflb:teaser>\n                  <xflb:schluesselwoerter>Privatschulen, Förderschulen, Klinikschulen, Förderung, Ausgleich besonderer Härten, Schulfinanzierungsgesetz</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Baukostenersatz für private Schulträger Förderschulen - Informationsblatt</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/rob-zz/44/rob_44-002/index</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerische Regierungen, SG 44</xflb:name>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Bayerische Regierungen, Sachgebiete 44</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>cae003eb-b0bb-4c0b-afd1-af9e302a08f4</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Kostenersatz für nichtstaatliches Personal an privaten Förderschulen und privaten schulvorbereitenden Einrichtungen (SVE)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rvs/b4/44/rvs_44-001/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>120ce931-c178-4a29-aedb-11c9e87d348d</xflb:id>\n                     <xflb:bezeichnung>Antrag zur Herstellung von Glasfaseranschlüssen an eine vorhandene Glasfaserinfrastruktur nach Art. 34 und 34a BaySchFG</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rvs/b4/44/rvs_44-060/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>96087cf5-aac7-4d70-b507-9a151d3132a0</xflb:id>\n                     <xflb:bezeichnung>Kostenersatz Übernahme Eigenanteil bei der BayARn 2021 - Antrag</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rvs/b4/44/rvs_44-150/index</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n               <xflb:onlinedienste>\n                  <xflb:onlinedienst>\n                     <xflb:id>6f07a586-f920-4684-ac57-ca9c6965f151</xflb:id>\n                     <xflb:bezeichnung>Private Förderschulen und Klinikschulen; Beantragung einer Förderung zum Ausgleich besonderer Härten</xflb:bezeichnung>\n                     <xflb:link>https://www.regierung.oberbayern.bayern.de/aufgaben/37202/40455/leistung/leistung_79099/index.html</xflb:link>\n                     <xflb:beschreibung>Der Freistaat Bayern gewährt Zuschüsse an Träger privater Förderschulen und privater Klinikschulen zum Ausgleich besonderer Härten, soweit sonstige Leistungen nach dem Bayerisches Schulfinanzierungsgesetz die tatsächlichen und notwendigen Aufwendungen nicht decken.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n               </xflb:onlinedienste>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>003</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Der Freistaat Bayern gewährt Zuschüsse an Träger privater Förderschulen und privater Klinikschulen zum Ausgleich besonderer Härten, soweit sonstige Leistungen nach dem Bayerisches Schulfinanzierungsgesetz die tatsächlichen und notwendigen Aufwendungen nicht decken</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>002</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Es handelt sich um einen Zuschuss. Dieser beträgt im Bereich des Schulaufwands einschließlich Schulbauten regelmäßig 100 %, bei bestimmten Förderschwerpunkten (Lernen, emotionale und soziale Entwicklung) und bei Sonderpädagogischen Förderzentren ausnahmsweise 80 %. Der notwendige Personalaufwand wird ebenfalls in der Regel zu 100 % ersetzt. Im Rahmen der verbesserten Förderung nach Art. 34a BaySchFG wird auch der Schulaufwand zu 100% ersetzt. Bei privaten Schulen für Kranke ist das Gebäude nicht von der Förderung umfasst, da sich die Schule in Räumen der Klinik befindet.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;notwendiger Schulaufwand (einmaliger und laufender Schulaufwand); Bei privaten Förderschulen: Kosten von Schulbauten (einschließlich Schulsportbau); notwendiger Personalaufwand; Härteausgleich&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Unterricht und Kultus</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 33 bis 34a Bayerisches Schulfinanzierungsgesetz (BaySchFG)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BaySchFG-G3_3</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>§§ 15 bis 17 Verordnung zur Ausführung des Bayerischen Schulfinanzierungsgesetzes (Ausführungsverordnung Schulfinanzierungsgesetz - AVBaySchFG)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayAVSchFG/true</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderung privater Volksschulen, Schulen für Behinderte und schulvorbereitender Einrichtungen nach Art. 45 VoSchG und Art. 11 Abs. 1 SoSchG</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2230_7_UK_356</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Bekanntmachung \"Durchführung der Härteregelung nach Art. 34a Abs. 2 BaySchFG\"</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2230_7_1_K_10450/true</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Ref. IV.7</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Private Förderschulen und Klinikschulen; Beantragung einer Förderung zum Ausgleich besonderer Härten</xflb:programmtitel>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2024-11-30</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2030-11-30</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:verlaengerungsoption>bisher noch kein Enddatum festgesetzt</xflb:verlaengerungsoption>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Schulfinanzierung. Förderung des Personal- und des Schulaufwandes privater Förderschulen und Klinikschulen, die schulaufsichtlich genehmigt sind.&lt;/p&gt;&lt;p&gt;Die Gründung einer privaten Fördeschule oder einer privaten Klinikschule bedarf der schulaufsichtlichen Genehmigung. Der Freistaat gewährt den privaten Förderschulen und den privaten Klinikschulen Leistungen für den Personlaufwand und für den Schulaufwand, wenn sie in Gliederung und Ausbau entsprechenden öffentlichen Schulen entsprechen (Art. 35 BaySchFG).&lt;/p&gt;&lt;p&gt;Die Leistungen für den Personalaufwand sind in Art. 34 BaySchFG geregelt. Für den nowendigen Personalaufwand erhält der Schulträger eine Vergütung nach Art. 33 Abs. 1 oder staatliches Personal nach Art. 34 Satz 2 BaySchFG zugewiesen.&lt;/p&gt;&lt;p&gt;Der Schulaufwand der Schule (hierunter fallen bspw. notwendige Baukosten und Ausstattung der Schulräume) wird nach Art. 34 BaySchFG gefördert. Für private Schulen für Kranke wird keine Baukostenförderung gewährt.&lt;/p&gt;&lt;p&gt;Darüber hinaus kann der private Träger eine verbesserte Förderung nach Art. 34a BaySchFG erhalten, sofern er die dort genannten Voraussetzungen erfüllt. Die verbesserte Förderung umfasst auch eine Härtefallregelung.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>002</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Voraussetzungen für Zuschüsse für den Schulaufwand:&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Gemeinnützigkeit (Art. 29 Bayerisches Schulfinanzierungsgesetz - BaySchFG)&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;staatliche Genehmigung der Schule nach Art. 92 ff. Bayerisches Gesetz über das Erziehungs- und Unterrichtswesen (BayEUG)&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;grundsätzlich in Jahrgangsklassen gegliederte Schule; Mindestschülerzahl pro Klasse (Art. 35 BaySchFG)&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;weitere Voraussetzungen gemäß §§ 15 ff. Verordnung zur Ausführung des Bayerischen Schulfinanzierungsgesetzes (AVBaySchFG) i.V.m. der Förderbekanntmachung vom 14.12.1982&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;bei Schülerbeförderung: Beachtung der §§ 2 f. Schülerbeförderungsverordnung (SchBefV) Voraussetzungen für verbesserte Förderung nach Art. 34a Abs. 1 Satz 1 Nr. 2 BaySchFG:&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Mitwirkung des Schulträgers an Verfahren zur schulbezogenen Budgetierung der Abrechnung des Schulaufwands&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Ermöglichung des unentgeltlichen Schulbesuchs für alle Schüler mit sonderpädagogischem Förderbedarf&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Anwendung der für entsprechende öffentliche Schulen geltenden Vorschriften zu Aufnahme und Entlassung von Schülern&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Verzicht auf Zustimmungsvorbehalt nach Art. 43 Abs. 4 Satz 2 Halbsatz 2 BayEUG&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Vorzeitige Entlassung eines Schülers nur im Einvernehmen mit der Schulaufsichtsbehörde&lt;/li&gt;&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.regierung.oberbayern.bayern.de/aufgaben/37202/40455/leistung/leistung_79099/index.html</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Es muss nach schulaufsichtlicher Genehmigung ein schriftlicher Antrag bei der Regierung, in dem die private Förderschule oder Schule für Kranke ihren Standort hat, gestellt werden. Zuständig ist jeweils das dortige Sachgebiet 44.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:wochen>1</xflb:wochen>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:jahre>1</xflb:jahre>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristSpanne>\n                        <xflb:min>\n                           <xflb:tage>1</xflb:tage>\n                        </xflb:min>\n                        <xflb:max>\n                           <xflb:jahre>1</xflb:jahre>\n                        </xflb:max>\n                     </xflb:fristSpanne>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Zugehörige Bekanntmachung: https://www.gesetze-bayern.de/Content/Document/BayVV_2230_7_1_K_10450/true</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Antrag</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Die jeweilige Regierung teilt Auskunft über die sonstigen erforderlichen Unterlagen</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Widerspruch, verwaltungsgerichtliche Klage&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_56   [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index";
