                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>e5075cba-73b5-4883-9a16-7b3b22463508</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-11-20T09:08:24</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>e5075cba-73b5-4883-9a16-7b3b22463508</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>e5075cba-73b5-4883-9a16-7b3b22463508</xflb:schluessel>\n         <xflb:versionFLB>4</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-11-20T09:08:24</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>e5075cba-73b5-4883-9a16-7b3b22463508</xflb:foerderschluessel>\n                  <xflb:flbVersion>4</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99148146017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Förderung von Wohnraum für Studierende</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Zweck der Zuwendung ist die Schaffung und die Erhaltung von Wohnraum für Studierende an staatlichen und staatlich anerkannten Hochschulen.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Staat fördert die Schaffung und Erhaltung von Wohnraum für Studierende mit Mitteln aus öffentlichen Haushalten.</xflb:teaser>\n                  <xflb:schluesselwoerter>Studentenwohnheime, Studentenbude, Studentenwohnraumförderung, Wohnheime für Studierende, Studierende, Wohnraumförderung, Studenten</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderung von Wohnraum für Studierende</xflb:bezeichnung>\n                     <xflb:link>http://www.bauen.bayern.de/wohnen/foerderung/studierende/index.php</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Referat 31</xflb:name>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>StMB, Referat 31</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>77931195-c63b-4c68-9be9-a69f765d18e7</xflb:id>\n                     <xflb:bezeichnung>Antrag \"Wohnraum für Studierende\" (Stud)</xflb:bezeichnung>\n                     <xflb:link>https://www.stmb.bayern.de/assets/stmi/wohnen/foerderung/formblatt-stud.xlsx</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>002</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>003</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>004</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>005</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>006</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>008</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>007</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Zuwendungsempfänger ist der Grundstückseigentümer, der Erbbauberechtigte  oder der Erwerber. Zuwendungsempfänger können juristische Personen des  öffentlichen Rechts, des privaten Rechts sowie natürliche Personen sein.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>002</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Förderung erfolgt mit einem leistungsfreien Baudarlehen.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Es beträgt derzeit bis zu 45.000 Euro je Wohnplatz bei einer Belegungsbindung von 25 Jahrenund bis zu 75.000 Euro je Wohnplatz bei einer Belegungsbindung von 40 Jahren.Für Eltern-Kind-Apartments oder rollstuhlgerechte Zimmer kann der Förderbetrag um jeweils bis zu 20.000 Euro erhöht werden. Für jedes volle Kalenderjahr der bestimmungsgemäßen Verwendung des Wohnraums wird ein Kapitalnachlass gewährt.&lt;/p&gt;&lt;p&gt;Bei Festsetzung der Zuwendung wird ein Abzug in dem Verhältnis vorgenommen, in dem die Baukosten der Maßnahme vergleichbare Neubaukosten unterschreiten.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Ein Rechtsanspruch auf die beantragte Förderung besteht nicht.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Förderfähig sind die Gesamtkosten (inkl. der Kosten für die Erstmöblierung).&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:euBeihilferelevanz>Beschluss 2012/21/EU</xflb:euBeihilferelevanz>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Wohnen, Bau und Verkehr</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Gesetz über die Wohnraumförderung in Bayern (Bayerisches Wohnraumförderungsgesetz - BayWoFG)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayWoFG</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinien für die Förderung von Wohnraum für Studierende (StudR 2023) - Bekanntmachung des Bayerischen Staatsministeriums für Wohnen, Bau und Verkehr</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2330_B_13972/true</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat 31</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Förderung von Wohnraum für Studierende (StudR 2023)</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2026-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2023-08-04</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2026-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gegenstände der Förderung - einschließlich der Erstmöblierung - sind:&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;der Bau, die Erweiterung sowie der Ersterwerb von Wohnraum für Studierende,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;der Umbau von studentischem Wohnraum sowie Maßnahmen der umfassenden energetischen Modernisierung,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;der Erwerb und die Änderung von Gebäuden, die bisher nicht zu Wohnzwecken genutzt wurden, zu Wohnraum für Studierende.&lt;/li&gt;&lt;/ul&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>021</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Voraussetzung für eine Förderung ist ein dringender, nicht nur vorübergehender Bedarf an staatlich gefördertem Wohnraum für Studierende am jeweiligen Hochschulort. Wohnraum für Studierende wird nur auf Grundstücken gefördert, die verkehrsgünstig zu Hochschule liegen.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Belegungsbindung&lt;/p&gt;&lt;p&gt;Die geförderten Wohnheimplätze dürfen während der Dauer der Belegungsbindung von 25 oder 40 Jahren nur mit bedürftigen Studierenden belegt werden. Ausländische Studierende müssen angemessen berücksichtigt werden. Bis zu 20 Prozent der Wohnplätze dürfen mit Auszubildnenden belegt werden.&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:rechtlicheBeschreibung>&lt;p&gt;Der Zuwendungsempfänger muss zuverlässig und leistungsfähig sein.&lt;/p&gt;</xflb:rechtlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Zuwendungen zur Projektförderung dürfen nur für solche Vorhaben bewilligt werden, die noch nicht begonnen worden sind.&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.stmb.bayern.de/assets/stmi/wohnen/foerderung/formblatt-stud.xlsx</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Der Antrag auf Förderung ist bei der für das Bauvorhaben örtlich zuständigen Kreisverwaltungsbehörde einzureichen. Diese prüft die Vollständigkeit der Unterlagen sowie die Einhaltung der baurechtlichen Vorschriften und leitet den Antrag (einfach) an die Bewilligungsstelle, das Bayerische Staatsministerium für Wohnen, Bau und Verkehr weiter. Die Auszahlung der Fördermittel erfolgt ratenweise nach Baufortschritt und ist bei der Kreisverwaltungsbehörde zu beantragen.&lt;/p&gt;&lt;p&gt;Die Auszahlung erfolgt grundsätzlich in vier Raten:&lt;/p&gt;&lt;p&gt;- 30 v.H. im zweiten Kalenderjahr nach Erlass des Bewilligungsbescheids und nach der Fertigstellung der Kellerdecke oder bei nicht unterkellerten Gebäuden nach der Fertigstellung der Bodenplatte oder bei einer Gebäudeänderung oder -erweiterung nach der Einrichtung der Baustelle und dem Beginn der Arbeiten (1. Rate),&lt;/p&gt;&lt;p&gt;- 25 v.H. im dritten Kalenderjahr nach Erlass des Bewilligungsbescheids nach der Fertigstellung des Rohbaus einschl. Dacheindeckung oder bei einer Gebäudeänderung oder -erweiterung nach der Fertigstellung der sanitären Installation und des Innenputzes (2. Rate),&lt;/p&gt;&lt;p&gt;- 25 v.H. im vierten Kalenderjahr nach Erlass des Bewilligungsbescheids und nach Erreichen der Bezugsfertigkeit (3. Rate) und&lt;/p&gt;&lt;p&gt;- 20 v.H. im fünften Kalenderjahr nach Erlass des Bewilligungsbescheids&lt;/p&gt;&lt;p&gt;und nach restloser Fertigstellung und bestimmungsgemäßer Wohnungsbelegung.&lt;/p&gt;&lt;p&gt;Der Abruf und die Auszahlung der Raten können frühestens zum 1. April im jeweiligen Kalenderjahr beantragt werden.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>&lt;p&gt;Vorzeitiger Maßnahmenbeginn: Ab Einplanung der Fördermaßnahme beim Bayer. Staatsministerium für Wohnen, Bau und Verkehr sowie Vorliegen der weiteren Voraussetzungen, insbesondere vorbesprochene Planung, Aussage über baurechtliche Zulässigkeit, abgestimmter Antragsentwurf möglich.&amp;nbsp;&lt;/p&gt;</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Nachweis zum Grundstück oder Erbbaurecht</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Nachweis über Fremdmittel und Eigenmittel</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Bautechnische Unterlagen</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Kostenberechnung nach DIN 276</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Wohnflächenberechnung nach WoFIV</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;verwaltungsgerichtliche Klage&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_94   [ xyz:attributes  [ xyz:antragsstellung      "https://www.stmb.bayern.de/assets/stmi/wohnen/31_stabau_id_-september_2022.pdf";
                                xyz:begriffeImKontext    [ rdf:_1  "Wohnungsbauförderung";
