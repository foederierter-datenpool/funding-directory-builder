                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>37c9a90d-94da-471b-86bd-620ca8949fad</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2026-03-10T11:03:45</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>37c9a90d-94da-471b-86bd-620ca8949fad</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>37c9a90d-94da-471b-86bd-620ca8949fad</xflb:schluessel>\n         <xflb:versionFLB>1</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-03-10T11:03:45</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>37c9a90d-94da-471b-86bd-620ca8949fad</xflb:foerderschluessel>\n                  <xflb:flbVersion>1</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400171017000</xflb:leikaSchluessel>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Kurse zur Vorbereitung auf das Nachholen des Mittelschulabschlusses</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Der Kurs hat das Ziel, dass Jugendliche befähigt werden, den erfolgreichen Abschlusses der Mittelschule bzw. des Qualifizierenden Abschlusses der Mittelschule anzustreben.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Anerkannte Träger können eine Förderung für Kurse für Jugendliche, die den erfolgreichen Abschluss bzw. den qualifizierenden Abschluss der Mittelschule nachholen möchten, beantragen.</xflb:teaser>\n                  <xflb:schluesselwoerter>Bildung, Ausbildung, Schule, Mittelschulabschluss, Nachholen, Mittelschule, Abschluss</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Erwachsenenbildung</xflb:bezeichnung>\n                     <xflb:link>https://www.km.bayern.de/lernen/ubertritt-und-bildungswege/erwachsenenbildung</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Regierung von Niederbayern</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>540</xflb:hausnummerPostfach>\n                           <xflb:strasse>Regierungsplatz</xflb:strasse>\n                           <xflb:postleitzahl>84028</xflb:postleitzahl>\n                           <xflb:ort>Landshut</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>nachholung-msa@reg-nb.bayern.de</xflb:email>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Webseite Regierung Niederbayern</xflb:bezeichnung>\n                           <xflb:link>http://www.regierung.niederbayern.bayern.de/</xflb:link>\n                        </xflb:verweis>\n                        <xflb:telefonnummer>+49 871 808-1665</xflb:telefonnummer>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>a56ed1b0-2ad8-48eb-8099-4753740eefea</xflb:id>\n                     <xflb:bezeichnung>Kostenplan-Vorlage</xflb:bezeichnung>\n                     <xflb:link>https://regierung.niederbayern.bayern.de/mam/aufgaben/msa-kosten-finanzierungsplan.xlsx</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>5de71071-7636-4b4c-ac87-078eed929487</xflb:id>\n                     <xflb:bezeichnung>Berechnung der zuwendungsfähigen Ausgaben</xflb:bezeichnung>\n                     <xflb:link>https://regierung.niederbayern.bayern.de/mam/aufgaben/msa-zf-ausgaben-bb.xlsx</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n               <xflb:onlinedienste>\n                  <xflb:onlinedienst>\n                     <xflb:id>ea44184c-73fd-4a1c-9092-4ecaa1fec4d6</xflb:id>\n                     <xflb:bezeichnung>Beantragung einer Zuwendung für \"Kurse zur Vorbereitung auf das Nachholen des Mittelschulabschlusses\"</xflb:bezeichnung>\n                     <xflb:link>https://foerderung.bayern.de/landingpage/301b4649-9390-429d-b004-acb3f748266e</xflb:link>\n                     <xflb:beschreibung>Sie können die Förderung über die Fördermanagementplattform Bayern (FMP) digital beantragen.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n               </xflb:onlinedienste>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Gefördert werden Träger der Erwachsenenbildung, staatlich geförderter Landesorganisationen und Träger der Erwachsenenbildung auf Landesebene in Bayern sowie ihre Mitgliedseinrichtungen.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Zuwendung wird als Projektförderung in der Form einer Festbetragsfinanzierung gewährt. Ein Eigenmittelanteil von mindestens 10% wird gefordert.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Zuwendungsfähig sind grundsätzlich nur Ausgaben, die unmittelbar für die Durchführung der geförderten Maßnahme erforderlich sind und innerhalb des Bewilligungszeitraums entstehen. Dazu zählen in der Regel projektbezogene Personal- und Sachausgaben sowie Kosten für Leistungen Dritter und anteilige Betriebskosten, sofern sie dem Förderzweck dienen und wirtschaftlich sowie sparsam eingesetzt werden. Nicht zuwendungsfähig sind hingegen insbesondere Grundausstattung an Mobiliar, bereits begonnene Maßnahmen oder Ausgaben ohne direkten Bezug zum Fördergegenstand. Grundlage hierfür sind die Art. 23 und 44 der Bayerischen Haushaltsordnung (BayHO) sowie die dazugehörigen Verwaltungsvorschriften.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Unterricht und Kultus</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 23 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO-23</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 44 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO-44</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:programmtitel>Kurse zur Vorbereitung auf das erfolgreiche Nachholen des Mittelschulabschlusses und des Mittleren Schulabschlusses</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2026-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2026-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2027-01-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Förderung von Kursen für Jugendliche, die den erfolgreichen Abschluss bzw. den qualifizierenden Abschluss der Mittelschule nachholen möchten. Anerkannte Träger bieten Unterricht und Betreuung, die als Projektförderung mit Eigenmittelanteil bezuschusst werden.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>002</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;ul&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Die Kurse müssen teilnehmeroffen sein; d. h. es können sowohl Jugendliche mit Schulabschluss als auch Jugendliche ohne Schulabschluss teilnehmen.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;An einem Kurs müssen mindestens 10 Jugendliche teilnehmen.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Um die Jugendlichen sinnvoll auf den Abschluss der Mittelschule vorzubereiten, sind mindestens 900 Unterrichtseinheiten erforderlich.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Der Projektträger ist verpflichtet, qualifiziertes Personal für den Unterricht einzusetzen und es ist auch eine qualifizierte sozialpädagogische Betreuung sicherzustellen.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Der Maßnahmenzeitraum muss mindestens 7 Monate betragen.&lt;/li&gt;\n&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Förderanträge können ausschließlich von den durch das Staatsministerium für Unterricht und Kultus als antragsberechtigt bestimmten Trägern gestellt werden.&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://foerderung.bayern.de/landingpage/301b4649-9390-429d-b004-acb3f748266e</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Förderanträge können ausschließlich von den durch das Staatsministerium für Unterricht und Kultus als antragsberechtigt bestimmten Trägern gestellt werden.&lt;/p&gt;\n&lt;p&gt;Die Abwicklung dieser Fördermaßnahme (Antragsverfahren, Bewilligungsverfahren, Verwendungsnachweisprüfung, Auszahlung der Fördermittel) wird von der Regierung von Niederbayern durchgeführt.&lt;/p&gt;</xflb:bewilligung>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:wochen>1</xflb:wochen>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:wochen>4</xflb:wochen>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:sonstige>ja</xflb:sonstige>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Der Antrag auf Zuwendung ist spätestens vier Wochen vor dem geplanten Kursbeginn zu stellen.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Konzept (formlos)</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Nachweise der Qualifikationen für das Lehrpersonal und die sozialpädagogische Betreuung</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Kostenplan-Vorlage</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Berechnung der zuwendungsfähigen Ausgaben</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;verwaltungsgerichtliche Klage&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_41   [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index";
                                xyz:beschreibung         "<p>Zweck der Förderung ist die Verbesserung der Naherholungsmöglichkeiten in Siedlungsräumen und die Verbesserung der städteökologischen und -klimatischen Verhältnisse zur Unterstützung einer integrierten, nachhaltigen Stadt-Umland-Entwicklung durch Schaffung einer urbanen Grün- und Erholungsanlage aus Anlass von Bayerischen Landesgartenschauen.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Anteilsfinanzierung/Kapitalbeteiligung" ];
                                xyz:foerderbereich       [ rdf:_1  "Kultur, Medien und Sport";
                                                           rdf:_2  "Messen und Ausstellungen"
                                                         ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Kommunen" ];
                                xyz:foerderprogramm      "Förderung von Bayerischen Landesgartenschauen";
                                xyz:foerderzeitraum.bis  "2028-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2025-02-01T00:00:00.000+00:00";
                                xyz:schluessel           "104d59cc-ec8e-4688-b7bc-860da8d743eb";
                                xyz:teaser               "Der Freistaat Bayern fördert die investiven Ausgaben von Städten, Märkten oder Gemeinden für dauerhafte Grün- und Erholungsanlagen aus Anlass von Bayerischen Landesgartenschauen.";
                                xyz:titel                "Grün- und Erholungsanlagen aus Anlass von Gartenschauen";
                                xyz:titel.tokens         [ rdf:_1  "Grün- und Erholungsanlagen aus Anlass von Gartenschauen" ];
                                xyz:voraussetzung        "<p>Voraussetzung ist eine erfolgreiche Bewerbung bei der Bayerischen Landesgartenschau GmbH und die damit verbundene Zuschlagserteilung durch das Bayerische Staatsministerium für Umwelt und Verbraucherschutz (StMUV) im Benehmen mit dem Bayerischen Staatsministerium für Ernährung, Landwirtschaft und Forsten (StMELF).</p>"
                              ];
