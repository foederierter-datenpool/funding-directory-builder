                                                                                                                                           xyz:rechtsbehelf             "<p>Widerspruch, verwaltungsgerichtliche Klage</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<p>Es muss nach schulaufsichtlicher Genehmigung ein schriftlicher Antrag bei der Regierung, in dem die private Förderschule oder Schule für Kranke ihren Standort hat, gestellt werden. Zuständig ist jeweils das dortige Sachgebiet 44.</p>";
                                                                                                                                                                          xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "002";
                                                                                                                                                                                                            xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
