                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Die Förderpauschalen der Härtefallförderung erfolgt bei Vorhaben nach Nrn. 2.2.3 anhand von Einwohnerzahlen: 250 EUR je angeschlossener Einwohner einmalig im 4-Jahres-Zeitraum gemäß Nr. 9, maximal 70 % der Ausgaben nach Ausführung und maximal 3 Mio. Euro Die zuwendungsfähigen Kosten werden durch die im Bauausgabebuch nach Ausführung der Maßnahme vorgetragenen Ausgaben abzüglich der nicht zuwendungsfähigen Ausgaben nach Nr. 5.3 RZWas 2025 ermittelt.</p>"
                                                                                                                                         ];
                                                                                                             xyz:foerderbereich          [ xyz:foerderbereich  [ xyz:code           "019";
                                                                                                                                                                 xyz:listURI        "urn:xoev-de:stmd:codeliste:foerderbereich";
                                                                                                                                                                 xyz:listVersionID  "1";
                                                                                                                                                                 xyz:name           ""
                                                                                                                                                               ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergebiet           [ xyz:laender  [ xyz:land  [ xyz:code           "BY";
                                                                                                                                                                      xyz:listURI        "urn:xoev-de:pks:codeliste:bundesland";
                                                                                                                                                                      xyz:listVersionID  "1";
                                                                                                                                                                      xyz:name           ""
                                                                                                                                                                    ]
                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergegenstand       [ xyz:beschreibung
                                                                                                                               "<p>Gefördert wird in Härtefällen Nr. 2.2.3 - die bauliche Sanierung bestehender Trinkwassergewinnungs- und aufbereitungsanlagen, Trinkwasserspeicher, Kläranlagen, Pumpwerke und Regenbecken</p><p>Ziel der baulichen Sanierung soll die Wiedererlangung einer Regel-Lebensdauer von 25 - 50 Jahren für die Anlage sein, insbesondere durch Neubau. Zur baulichen Sanierung zählen auch die wegen erhöhter Anforderungen (z.B. Phosphor, Uran, Regelwerk, LfU-Merkblatt 4.4./22) notwendig werdende Erweiterung/Nachrüstung bestehender Anlagen sowie Nachrüstung/Neubau von Aufbereitungsanlagen, Regenüberläufen und Regenbecken.</p>" ];
                                                                                                             xyz:foerdernehmende         [ xyz:beschreibung     "Gebietskörperschaften (einschließlich deren Eigenbetriebe), öffentlich-rechtliche Zusammenschlüsse von Gebietskörperschaften, Kommunalunternehmen nach Art. 89 der Gemeindeordnung und Gemeinsame Kommunalunternehmen nach Art. 49 des Gesetzes über die kommunale Zusammenarbeit.\nWasser- und Bodenverbände, soweit sie zu 100% an der Gebietskörperschaft beteiligt sind.\nAusgenommen sind Gebietskörperschaften mit mehr als 20.000 Einwohnern und große Wasserversorgungsunternehmen (die Auflistung finden Sie in der RZWas2025, Seite 12).";
                                                                                                                                           xyz:foerdernehmende  [ rdf:_1  [ xyz:code           "009";
