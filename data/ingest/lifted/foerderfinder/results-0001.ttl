                                                                                                                                                                      xyz:name           ""
                                                                                                                                                                    ]
                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergegenstand       [ xyz:beschreibung
                                                                                                                               "Fachberatungsstellen, die von häuslicher und/oder sexualisierter Gewalt\nbetroffene Frauen und ihre Kinder sowie von sexualisierter Gewalt betroffene\nKinder und Jugendliche beraten, können eine Zuwendung zur Wahrnehmung der in\nNr. 2.4.1 der Richtlinie beschriebenen Aufgaben erhalten." ];
                                                                                                             xyz:foerdernehmende         [ xyz:beschreibung     "Zuwendungsempfänger sind die Spitzenverbände der Freien Wohlfahrtspflege Bayern oder Träger von Frauenhäusern, die Mitglied eines Spitzenverbandes der Freien Wohlfahrtspflege Bayern sind.";
                                                                                                                                           xyz:foerdernehmende  [ xyz:code           "010";
                                                                                                                                                                  xyz:listURI        "urn:xoev-de:stmd:codeliste:foerdernehmende";
