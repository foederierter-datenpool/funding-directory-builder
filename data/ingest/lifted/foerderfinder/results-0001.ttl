                                                                                                                                           xyz:erforderlicheUnterlagen  [ xyz:dokument  [ rdf:_1  [ xyz:bezeichnung   "Identitätsnachweis";
                                                                                                                                                                                                    xyz:erlaeuterung  "Vorderseite- und Rückseite Ihres Personalausweises oder der Datenseite und Folgeseite 1 Ihres Reisepasses,\nHinweis: Der Personalausweis bzw. Reisepass darf nicht abgelaufen sein. Statt eines gültigen Ausweisdokuments kann eine aktuelle (einfache oder erweiterte) Meldebescheinigung (Kopie) eingereicht werden. Die Meldebescheinigung darf, vom Datum der Antragstellung gerechnet, nicht älter als sechs Monate sein."
                                                                                                                                                                                                  ];
                                                                                                                                                                                          rdf:_2  [ xyz:bezeichnung   "Nachweis über die Erlaubnis nach § 5 Hebammengesetzes";
                                                                                                                                                                                                    xyz:erlaeuterung  "In Kopie (Urkunde)"
                                                                                                                                                                                                  ];
                                                                                                                                                                                          rdf:_3  [ xyz:bezeichnung   "Nachweis über eine freiberufliche Tätigkeit in Bayern";
                                                                                                                                                                                                    xyz:erlaeuterung  "durch Nachweis der Anmeldung einer Niederlassung in eigener Praxis beim zuständigen Gesundheitsamt nach Art. 10 Abs. 3 Gesundheitsdienst- und Verbraucherschutzgesetz (GDG) in Kopie."
                                                                                                                                                                                                  ];
                                                                                                                                                                                          rdf:_4  [ xyz:bezeichnung   "De-minimis-Erklärung";
                                                                                                                                                                                                    xyz:erlaeuterung  "ausgefüllt und unterschriebene De-minimis-Erklärung im Original."
                                                                                                                                                                                                  ];
                                                                                                                                                                                          rdf:_5  [ xyz:bezeichnung   "Erklärung über subventionserhebliche Tatsachen im Rahmen der Gewährung der Niederlassungsprämie";
                                                                                                                                                                                                    xyz:erlaeuterung  "im Original."
                                                                                                                                                                                                  ];
                                                                                                                                                                                          rdf:_6  [ xyz:bezeichnung   "Nachweis über die Abmeldung der vorangegangenen freiberuflichen Tätigkeit beim zuständigen Gesundheitsamt nach Art. 10 Abs. 3 GDG mit Datum des Endes der vorangegangenen Tätigkeit.";
                                                                                                                                                                                                    xyz:erlaeuterung  "Im Falle einer Wiederanmeldung."
                                                                                                                                                                                                  ]
                                                                                                                                                                                        ]
                                                                                                                                                                        ];
                                                                                                                                           xyz:linkZurAntragsstellung   "https://www.lfp.bayern.de/wp-content/uploads/2024/04/Antrag_Erklaerungen_HebNp_ab1.1.24.pdf";
                                                                                                                                           xyz:rechtsbehelf             "<p>Gegen den Zuwendungsbescheid können Sie innerhalb von 1 Monat Klage erheben. Das zuständige Gericht, bei dem Sie Klage einreichen können, wird Ihnen im Bescheid mitgeteilt.</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<p>Der Antrag ist beim Landesamt für Pflege einzureichen. Nach der Prüfung erfolgt die Verbescheidung.</p>";
                                                                                                                                                                          xyz:erlaeuterungVorzeitigerMassnahmebeginn
                                                                                                                                                                                  "<p>Das Vorhaben darf vor Antragstellung begonnen werden.</p>";
                                                                                                                                                                          xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "005";
                                                                                                                                                                                                            xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
                                                                                                                                                                                                            xyz:listVersionID  "1"
                                                                                                                                                                                                          ]
                                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:finanzierungsartUndHoehe  "<p>Die Zuwendung wird im Wege der Festbetragsfinanzierung als Projektförderung in Höhe von bis zu einmalig 5 000 Euro gewährt.</p>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "003";
                                                                                                                                                                                                    xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
                                                                                                                                                                                                    xyz:listVersionID  "1";
                                                                                                                                                                                                    xyz:name           ""
                                                                                                                                                                                                  ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Zuwendungsfähig sind die im Zusammenhang mit der Niederlassung im Freistaat stehenden Ausgaben. Anstelle der im Einzelfall tatsächlich anfallenden Ausgaben werden hierfür folgende Kostenpauschalen angesetzt:</p><ul><li class=\"unordered-list-item--dash\">Mehrbedarf für Vorauszahlung der Berufshaftpflichtprämie</li><li class=\"unordered-list-item--dash\">Bei Niederlassung erstmalig zu entrichtende Versicherungsbeiträge</li><li class=\"unordered-list-item--dash\">Mehrbedarf für Büromanagement</li><li class=\"unordered-list-item--dash\">Mehrbedarf für Erstausstattung</li><li class=\"unordered-list-item--dash\">Mehrbedarf für Räumlichkeiten</li><li class=\"unordered-list-item--dash\">Mehrbedarf für Marketing</li><li class=\"unordered-list-item--dash\">Mehrbedarf für Beratungsleistungen, Steuerberatungs- und Rechtsanwaltskosten</li><li class=\"unordered-list-item--dash\">Mehrbedarf für Mobilität</li><li class=\"unordered-list-item--dash\">Mehrbedarf für Fortbildungsleistungen vor Wiedereinstieg.</li></ul><p>Der Gesamtbetrag der pauschalierten zuwendungsfähigen Ausgaben beträgt insgesamt 5 600 Euro.</p>"
                                                                                                                                         ];
