                                xyz:xml   "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           produkt=\"Förderfinder\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produktversion=\"\"\n                                           standard=\"XFLB\"\n                                           test=\"\"\n                                           version=\"2.0.0\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0 xflb.xsd\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>c94f84b7-f39b-4de1-9378-a59fde9f536a</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2023-12-21T16:04:21</xflb:erstellungszeitpunkt>\n      <xflb:sender>Förderfinder Suche (Bayern)</xflb:sender>\n      <xflb:empfaenger>XFLB-Connect (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>c94f84b7-f39b-4de1-9378-a59fde9f536a</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>c94f84b7-f39b-4de1-9378-a59fde9f536a</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:zuordnungen>\n               <xflb:leika>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"1\">\n                        <code>4</code>\n                        <name>Regelungskompetenz auf Landesebene</name>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n               <xflb:interneKennung>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n                  <xflb:foerderschluessel>c94f84b7-f39b-4de1-9378-a59fde9f536a</xflb:foerderschluessel>\n               </xflb:interneKennung>\n            </xflb:zuordnungen>\n            <xflb:finanzierung>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Förderung von Wasserleitungen und Abwasserkanälen erfolgt längenabhängig. Der Festbetrag (netto) beträgt: 200 Euro Zuwendung pro erstmalig gebautem Meter Wasserleitung und 200 Euro Zuwendung pro erstmalig gebautem Meter Abwasserkanal; maximal 70 % der Ausgaben nach Ausführung und jeweils maximal 3 Mio. Euro (netto). Die Längen werden in ganzen Metern ermittelt; Schächte werden übermessen. Beim Bau von Verbundleitungen und -kanälen sind nur die Leitungs- und Kanallängen ansetzbar, die im notwendigen und sparsamen Umfang erforderlich sind.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Die Härtefallförderung erfolgt für Vorhaben nach Nrn. 2.2.1 und 2.2.2 RZWas 2025 längenabhängig mit festen Förderpauschalen. Die zuwendungsfähigen Kosten werden durch die im Bauausgabebuch nach Ausführung der Maßnahme vorgetragenen Ausgaben abzüglich der nichtzuwendungsfähigen Ausgaben nach Nr. 5.3 RZWas 2025 ermittelt.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:zuwendungsart>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerSpanne>\n                        <xflb:maxDauer>\n                           <xflb:jahre>4</xflb:jahre>\n                        </xflb:maxDauer>\n                        <xflb:minDauer>\n                           <xflb:jahre>1</xflb:jahre>\n                        </xflb:minDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name>Bayern</name>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name>Kommunen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name>Verbände</name>\n               </xflb:foerdernehmende>\n            </xflb:foerdernehmende>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Erstmaliger Bau von Verbundleitungen für Wasserversorgungsanlagen und erstmaliger Bau von Verbundkanälen bei Auflassung von Kläranlagen (nach Nr. 2.2.2 der RZWas 2025)</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:teaser>Der Freistaat Bayern unterstützt die bayerischen Städte und Gemeinden bei der\nSanierung von öffentlichen Trinkwasser- und Abwasseranlagen in Härtefällen mit Zuwendungen.</xflb:teaser>\n                  <xflb:zuwendungszweck>In Härtefällen wird der erstmalige Bau von Verbundleitungen für Wasserversorgungsanlagen oder von Verbundkanälen beim Auflassen von Kläranlagen gefördert, wenn dies zu unzumutbaren Belastungen von Gebietskörperschaften sowie Bürgerinnen und Bürgern führen würde.</xflb:zuwendungszweck>\n                  <xflb:schluesselwoerter>Wasserversorgungsanlagen, Zuwendungen zu Abwasserentsorgungsanlagen, Förderung von Abwasseranlagen, Zuwendungen zu Abwasserbeseitigung, Abwasserbeseitigung Förderung, Zuwendungen zur öffentlichen Trinkwasserversorgung, Härtefallförderung, Verbundleitung</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:allgemeineFragen>\n                  <xflb:name>regional zuständiges Wasserwirtschaftsamt</xflb:name>\n                  <xflb:verweis>\n                     <xflb:link>https://www.stmuv.bayern.de/themen/wasserwirtschaft/wasserwirtschaft_in_bayern/wasseraemter.htm</xflb:link>\n                     <xflb:bezeichnung>zuständiges Wasserwirtschaftsamt</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Ihr zuständiges Wasserwirtschaftsamt</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:link>http://www.stmuv.bayern.de/themen/wasserwirtschaft/foerderung/index.htm</xflb:link>\n                     <xflb:bezeichnung>Förderung wasserwirtschaftlicher Vorhaben</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>Der erstmalige Bau von Verbundleitungen für Wasserversorgungsanlagen sowie der erstmalige Bau von Verbundkanälen bei Auflassung von Kläranlagen</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2023-12-21T16:04:21</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index</xflb:linkZurAntragsstellung>\n               <xflb:antragsfrist>\n                  <xflb:bemerkung>Es zählt der Posteinlaufstempel des Wasserwirtschaftsamtes.</xflb:bemerkung>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristdatum>2028-09-30</xflb:fristdatum>\n                  </xflb:zeitlicheEingrenzung>\n               </xflb:antragsfrist>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>- Der Zuwendungsantrag ist beim örtlich zuständigen Wasserwirtschaftsamt zu stellen.\n- Nach erfolgreicher Prüfung erfolgt die Aufnahme in das Härtefallprogramm. Das Wasserwirtschaftsamt erlässt den Zuwendungsbescheid.\n- Zuwendungen können maximal einmal jährlich nach Vorlage einer Verwendungsbestätigung beim Wasserwirtschaftsamt abgerufen werden.\n- Zu den Details berät das örtlich zuständige Wasserwirtschaftsamt.</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Formblatt Muster 1a zu Art 44 BayHO (digital verfügbar)</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Entwurf nach REWas (Stand 2022)</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Richtlinie für den Entwurf von wasserwirtschaftlichen Vorhaben (REWas)</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Erläuterung</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Kurzfassung</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Lageplan, in dem die zu fördernden Teile rot gekennzeichnet sind</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Beschluss des Gemeinderates</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Genehmigung des Vorhabens und der Finanzierung durch Gemeinderat</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Erklärung zur Weiterleitung</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Erklärung des Vorhabensträgers, ob er Zuwendungen an eine Dritten weiterleitet.</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:wochen>2</xflb:wochen>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>6</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n            </xflb:antragsinformationen>\n            <xflb:foerdervoraussetzungen>\n               <xflb:ausschlusskriterien>Gebietskörperschaften, deren Eigenbetriebe sowie deren Unternehmen in Privatrechtsform, mit mehr als 20 000 Einwohnern werden nicht gefördert. Unternehmen in Privatrechtsform sowie Wasser- und Bodenverbände an denen Gebietskörperschaften zu weniger als 100 Prozent beteiligt sind. \nAusgenommen von der Förderung sind folgende Fernwasserversorgungsunternehmen:\n- Wasserversorgung Bayerischer Wald,\n- Wasserversorgung Steinwaldgruppe,\n- Fernwasserversorgung Oberfranken,\n- Fernwasserversorgung Franken,\n- Fernwasserversorgung Mittelmain,\n- Fernwasserversorgung Oberes Allgäu.</xflb:ausschlusskriterien>\n               <xflb:rechtlicheBeschreibung>&lt;p&gt;RZWas 2025 4.1 Die Wirtschaftlichkeit und Sparsamkeit eines Vorhabens sind nachzuweisen nach Nr. 6.2 VV zu Art. 44 BayHO in Verbindung mit Nr. 4.1 BayZBau). Wenn mehrere Lösungen möglich sind, kann nur die wirtschaftlichste und sparsamste Lösung gefördert werden. 4.2 Es können nur Vorhaben gefördert werden, die noch nicht begonnen worden sind (Nr. 1.3 VV zu Art. 44 BayHO). Als Vorhabenbeginn ist grundsätzlich die Abgabe einer verbindlichen Willenserklärung zum Abschluss eines der Ausführung zuzurechnenden Lieferungs- oder Leistungsvertrags zu werten. Bei Baumaßnahmen gelten Planungsaufträge bis einschließlich Leistungsphase sieben der HOAI, Baugrunduntersuchungen, Grunderwerb und Herrichten des Grundstücks (zum Beispiel Gebäudeabbruch, Planieren), naturschutzfachliche Erhebungen sowie naturschutzfachliche Ausgleichs- und Ersatzmaßnahmen, die vor dem Beginn der Hauptmaßnahme ausgeführt werden müssen, nicht als Beginn des Vorhabens. Das Wasserwirtschaftsamt (WWA) kann im Ausnahmefall dem vorzeitigen Vorhabenbeginn schriftlich zustimmen. Teil B RZWas 2025 zu Nr. 4.1 Vorhaben nach den Nrn. 2.2.2 können nur gefördert werden, wenn die Planung vor Auftragsvergabe vom Wasserwirtschaftsamt baufachlich auf Wirtschaftlichkeit und Sparsamkeit geprüft wurde.&lt;/p&gt;</xflb:rechtlicheBeschreibung>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Es werden Verbundleitungen und -kanäle nach Nr. 2.2.2 RZWas 2025, sowie Sanierungs- und Strukturkonzepte nach Nr. 2.2.5 RZWas 2025 unabhängig vom Erreichen einer Härtefallschwelle gefördert. Es können nur Vorhaben gefördert werden, die noch nicht begonnen worden sind. Weitere Details erfahren Sie bei Ihrem örtlich zuständigen Wasserwirtschaftsamt.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:programmtitel>Richtlinien für Zuwendungen zu wasserwirtschaftlichen Vorhaben (RZWas 2025)</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2028-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:verantwortlichesFachreferat>Referat 58 - Schutz oberirdischer Gewässer, Abwasserentsorgung</xflb:verantwortlichesFachreferat>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Umwelt und Verbraucherschutz</xflb:verantwortlichesMinisterium>\n               <xflb:programmlaufzeit>\n                  <xflb:verlaengerungsoption>Eine Verlängerung des Förderprogramms wird angestrebt.</xflb:verlaengerungsoption>\n                  <xflb:endeLaufzeitFoerderprogramm>2028-12-31</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:beginnLaufzeitFoerderprogramm>2024-04-01</xflb:beginnLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_7538_U_15039?hl=true</xflb:link>\n                     <xflb:bezeichnung>Richtlinien für Zuwendungen zu wasserwirtschaftlichen Vorhaben (RZWas 2025)</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>019</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>\n"
                              ]
            ];
  rdf:_115  [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index";
