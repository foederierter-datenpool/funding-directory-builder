                                xyz:xml   "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           produkt=\"Förderfinder\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produktversion=\"\"\n                                           standard=\"XFLB\"\n                                           test=\"\"\n                                           version=\"2.0.0\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0 xflb.xsd\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>f1718220-919e-4f0f-810b-5619ac0bd54f</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-07-24T13:12:41</xflb:erstellungszeitpunkt>\n      <xflb:sender>Förderfinder Suche (Bayern)</xflb:sender>\n      <xflb:empfaenger>XFLB-Connect (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>f1718220-919e-4f0f-810b-5619ac0bd54f</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>f1718220-919e-4f0f-810b-5619ac0bd54f</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>f1718220-919e-4f0f-810b-5619ac0bd54f</xflb:foerderschluessel>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400241017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"1\">\n                        <code>4</code>\n                        <name>Regelungskompetenz auf Landesebene</name>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Förderstätten für Menschen mit Behinderung und Tagesstruktureinrichtungen für erwachsene Menschen mit Behinderung nach dem Erwerbsleben</xflb:titel>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:link>http://www.stmas.bayern.de/arbeitswelt/foerderstaettenkonzeption/index.php</xflb:link>\n                     <xflb:bezeichnung>Eckpunkte zur Förderstättenkonzeption</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:beschreibung>\n                  <xflb:teaser>Der Freistaat Bayern unterstützt sogenannte Förderstätten für Menschen mit Behinderung und Tagesstruktureinrichtungen für erwachsene Menschen mit Behinderung nach dem Erwerbsleben (T-ENE) indem er Einrichtungsträgern Zuwendungen für bauliche Investitionen gewährt.</xflb:teaser>\n                  <xflb:schluesselwoerter>FöSt, Tagesstruktureinrichtung für Menschen mit Behinderung nach dem Erwerbsleben, T-ENE, Förderstätte</xflb:schluesselwoerter>\n                  <xflb:zuwendungszweck>&lt;p&gt;Die Förderung unterstützt Menschen mit Behinderung außerhalb ihrer Wohnung oder Wohngruppe in Förderstätten und Tagesstrukturierende Einrichtungen für Erwachsene nach Ende des Erwerbslebens (T-ENE-Einrichtungen).&amp;nbsp;&lt;/p&gt;\n&lt;p&gt;Förderstätten sind Einrichtungen der Eingliederungshilfe, die Menschen mit Behinderung auf den Berufsbildungsbereich der Werkstatt vorbereiten, Folgen der Behinderung mildern, Teilhabe fördern und Familien entlasten.&lt;/p&gt;\n&lt;p&gt;T-ENE-Einrichtungen bieten älteren Menschen mit Behinderung bedarfsgerechte Unterstützungsangebote, damit sie diesen Lebensabschnitt möglichst selbstbestimmt gestalten können.&lt;/p&gt;\n&lt;p&gt;Förderstätten richten sich an Personen, die (noch) nicht in einer Werkstatt arbeiten können, T-ENE-Einrichtungen an ältere Menschen nach WfbM oder Förderstättenaufenthalt. Beide Einrichtungen sind dauerhaft angelegt, eigenständig und arbeiten mit anerkannten Werkstätten zusammen. Sie fördern Teilhabe, Selbstbestimmung, Aktivierung und eine individuelle Lebensgestaltung gemäß UN-Behindertenrechtskonvention.&lt;/p&gt;</xflb:zuwendungszweck>\n               </xflb:beschreibung>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Staatsministerium für Familie, Arbeit und Soziales</xflb:name>\n                  <xflb:email>poststelle@stmas.bayern.de</xflb:email>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n                  <xflb:adresse>\n                     <xflb:strasse>Winzererstraße</xflb:strasse>\n                     <xflb:hausnummerPostfach>9</xflb:hausnummerPostfach>\n                     <xflb:postleitzahl>80797</xflb:postleitzahl>\n                     <xflb:ort>München</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:verweis>\n                     <xflb:link>https://www.stmas.bayern.de/</xflb:link>\n                     <xflb:bezeichnung>Website des StMAS</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Zuständig für die Durchführung des Förderverfahrens sind die Regierungen und die Bewilligungsstellen der Wohnraumförderung der Landeshauptstadt München und der Städte Augsburg und Nürnberg.</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Antragsfähig sind rechtsfähige gemeinnützige Träger.&lt;/p&gt;\n&lt;p&gt;Gefördert werden die oben genannten Maßnahmen unter Maßgabe der Bayerischen Haushaltsordnung, wenn unter anderem folgende Voraussetzungen erfüllt sind:&amp;nbsp;&lt;/p&gt;\n&lt;ul&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Bedarfsanerkennung und Billigung des Standorts durch den überörtlichen Träger der Sozialhilfe;&amp;nbsp;&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Vorlage einer den behindertenfachlichen Anforderungen auch unter dem Aspekt der Inklusion genügenden Konzeption sowie eines vom eines vom überörtlichen Träger der Eingliederungshilfe und der für eine staatliche Förderung zuständigen Vollzugsbehörde insbesondere unter besonderer Beachtung des Grundsatzes der Wirtschaftlichkeit und Sparsamkeit genehmigten Raum- und Funktionsprogramms. Im Raum- und Funktionsprogramm ist grundsätzlich auf eine Mehrfachnutzung von Räumen und Verkehrsflächen mit einer anderen Einrichtung gesondert einzugehen;&amp;nbsp;&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Einhaltung der für behindertengerechtes Bauen jeweils gültigen DIN in dem Maße, wie sie für den Personenkreis erforderlich ist;&amp;nbsp;&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Gewährleistung, dass der Träger eine Förderstätte bzw. T-ENE-Einrichtung ordnungsgemäß betreiben und unterhalten kann;&amp;nbsp;&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Nachweis zur Sicherung der Gesamtfinanzierung und einer mindestens 10%igen Beteiligung der örtlich zuständigen Bezirke.&lt;/li&gt;\n&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Nicht gefördert werden:&lt;br&gt;\n- &amp;nbsp;Maßnahmen, deren zuwendungsfähige Ausgaben einen Betrag von 100 000 € nicht überschreiten&lt;br&gt;\n- Private (gewinnorientierte) Träger und Investoren&lt;br&gt;\n-&amp;nbsp;Reine Sanierungs- und Instandhaltungsmaßnahmen&lt;/p&gt;</xflb:ausschlusskriterien>\n               <xflb:rechtlicheBeschreibung>&lt;p&gt;Die Förderung erfolgt als Projektförderung im Wege der Anteilfinanzierung (VV Nr. 2.2.2 zu Art. 44 BayHO). Die Zuwendung wird bei der Bewilligung auf einen Höchstbetrag begrenzt. Eine Nachfinanzierung ist ausgeschlossen.&lt;/p&gt;\n&lt;p&gt;Die Förderquote beträgt bis zu 60 % der zuwendungsfähigen Ausgaben. Der Eigenanteil des Trägers beträgt mindestens 30 %. Als Eigenmittel gelten auch Zuschüsse der Aktion Mensch und ähnliche zur Unterstützung des Eigenanteils gewährte Mittel, wie zum Beispiel Spenden.&lt;/p&gt;</xflb:rechtlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name>Bayern</name>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Familie, Arbeit und Soziales</xflb:verantwortlichesMinisterium>\n               <xflb:ablaufdatumRichtlinie>2025-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:verantwortlichesFachreferat>Referat II 1</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Investitionskostenzuschuss für Förderstätten und Tagesstruktureinrichtungen für erwachsene Menschen mit Behinderung nach dem Erwerbsleben beantragen</xflb:programmtitel>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_8113_0_A_12684/true</xflb:link>\n                     <xflb:bezeichnung>Richtlinie für die Förderung von Investitionen für Förderstätten für Menschen mit Behinderung entsprechend § 219 Abs. 3 SGB IX für Menschen mit Behinderung und für Tagesstruktureinrichtungen für erwachsene Menschen mit Behinderung nach dem Erwerbsleben (T-TENE)</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.bayernportal.de/dokumente/leistung/874741671778?localize=false</xflb:linkZurAntragsstellung>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Bau- und Raumprogramm</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Lageplan des Bauvorhabens und seiner Umgebung mit eingezeichneter Planung und Grenzen sowie Darstellung der Erschließung (Maßstab 1: 1.000, ein Übersichtsplan ist nicht notwendig)</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Pläne, die Art und Umfang des Vorhabens prüfbar nachweisen (Maßstab 1: 100, ggf. mit eingezeichneter Möblierung)</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Bauaufsichtliche oder sonstige Genehmigungen (bspw. Stellungnahme der Fachstelle für Pflege- und Behinderteneinrichtungen - Qualitätsentwicklung und Aufsicht (FQA); Vorbescheid oder Ähnliches genügen)</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Grundstücksbogen</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>ggf. Erläuterungsbericht nach Muster 6 zu Art. 44 BayHO (insbesondere mit allgemeiner Bau- und Funktionsbeschreibung und Angaben über Lage und Beschaffenheit des Baugeländes sowie Bau- und Ausführungsart)</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Flächenzusammenstellung</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Berechnungen für den Bau nach DIN 276 (Ausgabe 1993), DIN 277 (Ausgabe 1986) und DIN 283</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Prüfbare Kostenschätzung für die Ausstattung für Kosten der allgemeinen Inneneinrichtung, Küche und Gemeinschaftsräume (ohne 2) für Kosten der Arbeitsplatzausstattung</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Nachweise über die im Finanzierungsplan vorgesehenen Eigenmittel und die bewilligten, zugesagten und in Aussicht gestellten Fremdmittel</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Übersicht über Vermögen und Schulden sowie voraussichtliche künftige Verpflichtungen, Bilanz und Gewinn- und Verlustrechnung des letzten Jahres, Haushaltsvoranschlag für das laufende Jahr, Wirtschaftlichkeitsberechnung, derzeitiger Tageskostensatz</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Vereinssatzung mit Liste der Vorstandsmitglieder oder entsprechende Unterlagen, Nachweise über die Anerkennung der \"Gemeinnützigkeit\" des Trägers der Einrichtung, Registerauszug</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Grundbuchauszug nach dem neuesten Stand (gegebenenfalls Kauf-, Pacht- oder Nutzungsvertrag)</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Ergänzungen</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;&lt;strong&gt;Antrags- und Bewilligungsverfahren&lt;/strong&gt;&lt;/p&gt;\n&lt;ul&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;&lt;strong&gt;Bedarfsprüfung und Projektanzeige&lt;br&gt;\n&lt;/strong&gt;Kontakt mit zuständiger Bezirksverwaltung zur Prüfung von Bedarf und Standort&lt;br&gt;\nFeststellung des Bedarfs durch Beschluss&lt;br&gt;\nAnzeige des geplanten Projekts bei der zuständigen Förderstelle&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;&lt;strong&gt;Grundstück und Planung&lt;br&gt;\n&lt;/strong&gt;Prüfung der Grundstückseignung bei Erwerb (Nutzung, Bauvorgaben, städtebauliche Einfügung, Gestaltung, Erschließung)&lt;br&gt;\nFrühzeitige Abstimmung mit der Bauleitplanung empfohlen&lt;br&gt;\nErstellung eines Konzepts mit Raum- und Funktionsprogramm durch Antragsteller&lt;br&gt;\nFachliche Beratung und Prüfung durch Förderstelle und Bezirk&lt;br&gt;\nFeststellung des Programms als Voraussetzung, noch keine Förderzusage&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;&lt;strong&gt;Vorplanung und Kostenschätzung&lt;br&gt;\n&lt;/strong&gt;Kosten-Flächenermittlung und Kostenschätzung nach DIN 276&lt;br&gt;\nBeratung zu technischem und wirtschaftlichem Konzept&lt;br&gt;\nKoordination der Gesamtfinanzierung durch die Bewilligungsstelle&lt;br&gt;\nMeldung des Vorhabens an StMAS oder ggf. Staatsministerium für Wohnen, Bau und Verkehr&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;&lt;strong&gt;Priorisierung und Entscheidung&lt;br&gt;\n&lt;/strong&gt;Erstellung einer Prioritätenliste bis 15.03. des Jahres&lt;br&gt;\nEntscheidung über Aufnahme ins Jahresförderprogramm (JFP) durch StMAS&lt;br&gt;\nProjekte ohne Mittelzuweisung können im Folgejahr erneut angemeldet werden&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;&lt;strong&gt;Bewilligung und Auszahlung&lt;br&gt;\n&lt;/strong&gt;Bewilligungsbescheid nach Vorlage aller Unterlagen, einschließlich Entwurfsplanung mit Kostenberechnung&lt;br&gt;\nEigener Bescheid für Bezirk (in der Regel 10 % der Kosten)&lt;br&gt;\nMittelverfügbarkeit: verbindliche Bewilligung, Auszahlung nach Baufortschritt und verfügbaren Haushaltsmitteln&lt;br&gt;\nBei Wohnraumförderung: Zustellung und Auszahlung über Bayerische Landesbodenkreditanstalt, inkl. dinglicher Sicherung&lt;/li&gt;\n&lt;/ul&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:antragsfrist>\n                  <xflb:bemerkung>Anträge können nur bei den zuständigen Bewilligungsstellen mit Vorlage einer Bedarfsanerkennung des örtlich zuständigen Bezirk gestellt werden.</xflb:bemerkung>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristdatum>2025-03-15</xflb:fristdatum>\n                  </xflb:zeitlicheEingrenzung>\n               </xflb:antragsfrist>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:jahre>1</xflb:jahre>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:jahre>5</xflb:jahre>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n            </xflb:antragsinformationen>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert werden die (Neu-)Errichtung von Förderstätten und T-ENE-Einrichtungen, die eigenständige Einrichtungen der Eingliederungshilfe sind. Förderstätten arbeiten mit anerkannten Werkstätten für behinderte Menschen (WfbM) zusammen und unterstützen Menschen mit Behinderung bei der Hinführung zum Berufsbildungsbereich, zur Milderung der Folgen der Behinderung, zur Teilhabe am Leben in der Gemeinschaft und zur Entlastung der Familie. T-ENE-Einrichtungen ermöglichen Menschen im Alter, entsprechend ihrer persönlichen Bedürfnisse zwischen verschiedenen Angeboten zu wählen und diesen Lebensabschnitt möglichst selbstbestimmt zu gestalten.&lt;/p&gt;\n&lt;p&gt;Staatliche Zuwendungen werden gewährt für Förderstätten in räumlicher Anbindung an anerkannte WfbM oder an stationäre Wohnplätze. In Ausnahmefällen kann auch eine räumlich abgegrenzte Förderstätte gefördert werden, sofern eine Kooperation mit einer anerkannten Werkstatt besteht.&lt;/p&gt;\n&lt;p&gt;Gefördert werden Neubau, Umbau, Erweiterung, grundlegende Modernisierung (nicht Sanierung) sowie die Ausstattung von Förderstätten und T-ENE-Einrichtungen. Ebenfalls förderfähig ist der Erwerb eines Gebäudes einschließlich Umbau oder Instandsetzung. Maßnahmen, deren zuwendungsfähige Ausgaben 100.000 Euro nicht überschreiten, sind nicht förderfähig.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:finanzierung>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Zuwendung wird als Zuschuss gewährt. Die Förderquote beträgt bis zu 60 % der zuwendungsfähigen Ausgaben. Dieser Einsatz erfolgt im Rahmen einer Finanzierung, die von einer 30%igen Eigenbeteiligung des Trägers ausgeht. Als Eigenleistung gelten auch Mittel der Aktion Mensch und ähnliche zur Unterstützung der Eigenleistung gewährte Mittel. Die Förderung erfolgt als Projektförderung im Wege der Anteilfinanzierung VV Nr. 2.2.2 zu Art. 44 Bayerische Haushaltsordnung (BayHO). Die Zuwendung wird bei der Bewilligung auf einen Höchstbetrag begrenzt.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Die zuwendungsfähigen Ausgaben richten sich analog zur jeweils gültigen Anlage der Förderrichtlinie Werkstätten für behinderte Menschen. In Ausnahmefällen können Ausgaben für Erwerb, Erschließung und Herrichten von Grundstücken (DIN 276, Kostengruppen 100, 200) gefördert werden, wenn sonst der Betrieb der Förderstätte oder T-ENE-Einrichtung gefährdet wäre. Für reine Baumaßnahmen (Kostengruppen 300, 400) gelten die Beträge der Wohnraumförderung zuzüglich bis zu 25 % je Quadratmeter Wohn- oder Geschäftsfläche. Die Ausgaben sind differenziert nach Behinderungsarten, Konzept und anerkannten Raum- und Funktionsprogrammen zu berücksichtigen. Die Obergrenze für bewegliche Inneneinrichtungen einschließlich Gemeinschaftsräumen beträgt je Platz bis zu 5.000 €.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:euBeihilferelevanz>Nein</xflb:euBeihilferelevanz>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:zuwendungsart>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:jahre>2</xflb:jahre>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:jahre>5</xflb:jahre>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-07-24T13:12:41</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name>Verbände</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name>Stiftungen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name>Vereine</name>\n               </xflb:foerdernehmende>\n            </xflb:foerdernehmende>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>\n"
                              ]
            ];
