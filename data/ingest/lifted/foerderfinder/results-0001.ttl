                                                                                                                       xyz:kummulierbareFoerderungen  [ xyz:voraussetzungen
                                                                                                                                         "<p>Kombination mit Bundesförderung oder kommunalen Förderungen ist möglich.</p><p>Das konkrete Vorhaben darf nicht zusätzlich aus anderen bayerischen Landesprogrammen gefördert werden.</p>" ];
                                                                                                                       xyz:programmlaufzeit           [ xyz:beginnLaufzeitFoerderprogramm
                                                                                                                                                                "2025-01-01";
                                                                                                                                                        xyz:endeLaufzeitFoerderprogramm
