                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Gefördert werden Grundstücks-, Bau- und Baunebenkosten gemäß §§ 5 bis 8 der Verordnung über wohnungswirtschaftliche Berechnungen nach dem Zweiten Wohnungsbaugesetz (Zweite Berechnungsverordnung - II. BV) (= Gesamtkosten).</p>"
                                                                                                                                         ];
