                                                                                                                                                                             xyz:link         "https://www.stmwi.bayern.de/fileadmin/user_upload/stmwi/Foerderungen/Regionalfoerderung/GRW/2026-01-15-Koordinierungsrahmen-ab-1.1.2026-Version-Homepage.pdf"
                                                                                                                                                                           ];
                                                                                                                                                                   rdf:_3  [ xyz:bezeichnung  "Allgemeine Verwaltungsvorschriften für die Gewährung von Zuwendungen an die gewerbliche Wirtschaft (AVG)";
