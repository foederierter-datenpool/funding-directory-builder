                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>fbcdde84-d1fd-4a52-8e1e-4db788484541</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2023-12-29T15:30:07</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>fbcdde84-d1fd-4a52-8e1e-4db788484541</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>fbcdde84-d1fd-4a52-8e1e-4db788484541</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2023-12-29T15:30:07</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>fbcdde84-d1fd-4a52-8e1e-4db788484541</xflb:foerderschluessel>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Sanierung von Bauwerken bestehender Trinkwassergewinnungs- und -aufbereitungsanlagen, Trinkwasserspeicher, Kläranlagen, Pumpwerke und Regenbecken</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>In Härtefällen werden Vorhaben zur Sanierung bestehender Anlagen der öffentlichen Wasserversorgung und Abwasserentsorgung gefördert, wenn diese zu unzumutbaren Belastungen von Gebietskörperschaften sowie Bürgerinnen und\nBürgern führen.</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern unterstützt die bayerischen Städte und Gemeinden bei der Sanierung von öffentlichen Trinkwasser- und Abwasseranlagen in Härtefällen mit Zuwendungen.</xflb:teaser>\n                  <xflb:schluesselwoerter>Wasserversorgungsanlagen, Zuwendungen zu Abwasserentsorgungsanlagen, Förderung von Abwasseranlagen, Zuwendungen zu Abwasserbeseitigung, Abwasserbeseitigung Förderung, Zuwendungen zur öffentlichen Trinkwasserversorgung, Härtefallförderung</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderung wasserwirtschaftlicher Vorhaben</xflb:bezeichnung>\n                     <xflb:link>http://www.stmuv.bayern.de/themen/wasserwirtschaft/foerderung/index.htm</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>regional zuständiges Wasserwirtschaftsamt</xflb:name>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>zuständiges Wasserwirtschaftsamt</xflb:bezeichnung>\n                     <xflb:link>https://www.stmuv.bayern.de/themen/wasserwirtschaft/wasserwirtschaft_in_bayern/wasseraemter.htm</xflb:link>\n                  </xflb:verweis>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Ihr zuständiges Wasserwirtschaftsamt</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>7073fa4a-ef39-4fb2-812e-dda56d32efe8</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Gewährung einer Zuwendung nach Muster 1a zu Art. 44 BayHO für kommunale Gebietskörperschaften</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>3f787f3b-ddc2-446b-8b9e-7d19ea4e1de0</xflb:id>\n                     <xflb:bezeichnung>Ermittlung der Pro-Kopf-Belastung (Anlage 2 RZWas 2025)</xflb:bezeichnung>\n                     <xflb:link>https://www.stmuv.bayern.de/themen/wasserwirtschaft/foerderung/doc/anlage_2_ermittlung_pkb.pdf</xflb:link>\n                     <xflb:beschreibung>&lt;p&gt;Eine eine Förderung nach Nr. 2.2.3 RZWas 2025 zu erhalten, muss die Härtefallschwelle erreicht werden. Hierzu ist Anlage 2: Ermittlung der Pro-Kopf-Belastung &amp;nbsp;als Bestandteil des Förderantrages abzugeben.&lt;/p&gt;</xflb:beschreibung>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Gebietskörperschaften (einschließlich deren Eigenbetriebe), öffentlich-rechtliche Zusammenschlüsse von Gebietskörperschaften, Kommunalunternehmen nach Art. 89 der Gemeindeordnung und Gemeinsame Kommunalunternehmen nach Art. 49 des Gesetzes über die kommunale Zusammenarbeit.\nWasser- und Bodenverbände, soweit sie zu 100% an der Gebietskörperschaft beteiligt sind.\nAusgenommen sind Gebietskörperschaften mit mehr als 20.000 Einwohnern und große Wasserversorgungsunternehmen (die Auflistung finden Sie in der RZWas2025, Seite 12).</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>Festbetragsfinanzierung</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Die Förderpauschalen der Härtefallförderung erfolgt bei Vorhaben nach Nrn. 2.2.3 anhand von Einwohnerzahlen: 250 EUR je angeschlossener Einwohner einmalig im 4-Jahres-Zeitraum gemäß Nr. 9, maximal 70 % der Ausgaben nach Ausführung und maximal 3 Mio. Euro Die zuwendungsfähigen Kosten werden durch die im Bauausgabebuch nach Ausführung der Maßnahme vorgetragenen Ausgaben abzüglich der nicht zuwendungsfähigen Ausgaben nach Nr. 5.3 RZWas 2025 ermittelt.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:jahre>1</xflb:jahre>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:jahre>4</xflb:jahre>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Umwelt und Verbraucherschutz</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinien für Zuwendungen zu wasserwirtschaftlichen Vorhaben (RZWas 2025)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_7538_U_15039?hl=true</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat 58 - Schutz oberirdischer Gewässer, Abwasserentsorgung</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Richtlinien für Zuwendungen zu wasserwirtschaftlichen Vorhaben (RZWas 2025)</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2028-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2024-04-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2028-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert wird in Härtefällen Nr. 2.2.3 - die bauliche Sanierung bestehender Trinkwassergewinnungs- und aufbereitungsanlagen, Trinkwasserspeicher, Kläranlagen, Pumpwerke und Regenbecken&lt;/p&gt;&lt;p&gt;Ziel der baulichen Sanierung soll die Wiedererlangung einer Regel-Lebensdauer von 25 - 50 Jahren für die Anlage sein, insbesondere durch Neubau. Zur baulichen Sanierung zählen auch die wegen erhöhter Anforderungen (z.B. Phosphor, Uran, Regelwerk, LfU-Merkblatt 4.4./22) notwendig werdende Erweiterung/Nachrüstung bestehender Anlagen sowie Nachrüstung/Neubau von Aufbereitungsanlagen, Regenüberläufen und Regenbecken.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>019</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Für Vorhaben nach Nrn. 2.2.3 wird die Förderung gewährt, wenn die nach Anlage 2 mit Stichtag im aktuellen Kalenderjahr ermittelte Pro-Kopf-Belastung eine der Härtefallschwellen nach Nr. 4.3 RZWas 2025 überschreitet. Es können nur Vorhaben gefördert werden, die noch nicht begonnen worden sind. Weitere Details erfahren Sie bei Ihrem örtlich zuständigen Wasserwirtschaftsamt.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:rechtlicheBeschreibung>&lt;p&gt;RZWas 2025 4.1 Die Wirtschaftlichkeit und Sparsamkeit eines Vorhabens sind nachzuweisen nach Nr. 6.2 VV zu Art. 44 BayHO in Verbindung mit Nr. 4.1 BayZBau). Wenn mehrere Lösungen möglich sind, kann nur die wirtschaftlichste und sparsamste Lösung gefördert werden. 4.2 Es können nur Vorhaben gefördert werden, die noch nicht begonnen worden sind. Die Zustimmung zum Beginn des Vorhabens erfolgt ausschließlich mit dem Zuwendungsbescheid (siehe zu Nr. 4.2, Teil B der RZWas 2025) RZWas 2025 - Teil B , Zu Nr. 4 Erst mit überschreiten einer der Härtefallschwellen nach Nr. 4.3.1 oder 4.3.2 Teil B der RZWas 2025 kann Förderleistung nach Nr. 2.2.3 beantragt werden. Ermittlung der maßgeblichen Pro-Kopf-Belastung gemäß Anlage 2 der RZWas 2025.&lt;/p&gt;</xflb:rechtlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Gebietskörperschaften, deren Eigenbetriebe sowie deren Unternehmen in Privatrechtsform, mit mehr als 20 000 Einwohnern werden nicht gefördert. Unternehmen in Privatrechtsform sowie Wasser- und Bodenverbände an denen Gebietskörperschaften zu weniger als 100 Prozent beteiligt sind. Ausgenommen von der Förderung sind folgende Fernwasserversorgungsunternehmen: Bay. Rieswasserversorgung, Fernwasserversorgung Franken, Fernwasserversorgung Oberfranken, WV Bay. wald, ZV Fernwasserversorgung Mittelmain, &amp;nbsp;ZV Fernwasserversorgung Spessartgruppe, ZV WV Fränk. Wirtschaftsraum, ZV Fernwasserversorgung Oberes Allgäu, ZV WV Reckenberg Gruppe, ZV WV Rhön-Maintal-Gruppe, ZV WV Steinwaldgruppe&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>- Der Zuwendungsantrag ist beim örtlich zuständigen Wasserwirtschaftsamt zu stellen.\n- Nach erfolgreicher Prüfung erfolgt die Aufnahme in das Härtefallprogramm. Das Wasserwirtschaftsamt erlässt den Zuwendungsbescheid.\n- Zuwendungen können maximal einmal jährlich nach Vorlage einer Verwendungsbestätigung beim Wasserwirtschaftsamt abgerufen werden.\n- Zu den Details berät das örtlich zuständige Wasserwirtschaftsamt.</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>001</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:wochen>2</xflb:wochen>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>6</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristdatum>2028-09-30</xflb:fristdatum>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Es zählt der Posteinlaufstempel des Wasserwirtschaftsamtes.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Bauentwurf</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Aufgestellt nach den Richtlinie für den Entwurf wasserwirtschaftlicher Vorhaben (REWas, Stand: 05/2022)</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Erläuterung</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Kurzfassung</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Gemeinderatsbeschluß</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Mit dem Tenor, das Vorhaben durchzuführen und Genehmigung der Finanzierung</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Erklärung  Weiterleitung</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Erklärung des Vorhabensträgers, ob er die Zuwendungen an einen Dritten weiterleitet.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Antragsformular</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Musters 1 a zu Art. 44 BayHO (digital verfügbar)</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Anlage 2 der RZWas 2025</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Eingabe Stichtag des aktuellen Kalenderjahrs zur Ermittlung der Pro-Kopf-Belastung</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Lageplan, in dem die zu fördernden Teile rot gekennzeichnet sind</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>verwaltungsgerichtliche Klage</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_135  [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index";
                                xyz:begriffeImKontext    [ rdf:_1  "Öffentliche Trinkbrunnen";
                                                           rdf:_2  "Wasserversorgung";
                                                           rdf:_3  "Wasser als Lebensmittel";
                                                           rdf:_4  "Trinkwasser"
                                                         ];
                                xyz:beschreibung         "Das Berücksichtigen der Verhaltensregeln des allgemeinen Grundwasserschutzes, der Wasserschutzgebiete sowie der Trinkwasserverordnung kann nur erfolgreich sein, wenn deren Notwendigkeit in der Bevölkerung verstanden, akzeptiert und gelebt wird. Trinkbrunnen dienen dem Zweck, das Leitungswasser der öffentlichen Wasserversorgung als Lebensmittel in Wert zu setzen. Es ist Ziel die Einsicht zu vermitteln, dass dieses Trinkwasser den notwendigen Schutz verdient und erfordert, weil es so wertvoll und deshalb schützenswert ist. Das gilt gerade auch dann, wenn der Schutz persönliche Einschränkungen und gegebenenfalls auch Änderungen in den persönlichen Verhaltensweisen mit sich bringt. Öffentliche Trinkbrunnen an gut frequentierten Plätzen oder Wegen bieten die gute Möglichkeit, auf den Wert des Lebensmittels Leitungswasser sowie auf die Notwendigkeit des Trinkwasserschutzes mit geeigneten Medien hinzuweisen. Gerade Personen, die ihren Durst mit frischem Wasser stillen können, haben ein besonders offenes Ohr für diese Botschaft.\n\nTrinkbrunnen dienen der öffentlichen Klimavorsorge. Der Klimawandel führt zu immer länger werdenden Hitzeperioden, was das Leben gerade in den innerstädtischen Bereichen zunehmend belastend macht. Im Sinne der allgemeinen Gesundheitsvorsorge wirkt das Bereitstellen von kühlem, frischem Trinkwasser belebend.\n\nÖffentliche Trinkbrunnen sind ein Beitrag zur Verminderung von klimaschädlichem CO2 durch das Einsparen von Emissionen aus der Getränkelogistik und zur Vermeidung von Plastikabfällen aus (Einweg-)Flaschen für Mineral- oder Tafelwasser. Die Wertschätzung von Leitungswasser als Lebensmittel soll gefördert werden.";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Umwelt- und Naturschutz" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Kommunen";
                                                           rdf:_2  "Verbände"
                                                         ];
                                xyz:foerderprogramm      "Sonderprogramm \"Kommunale Trinkbrunnen\" nach Nr. 2.4 RZWas 2025";
                                xyz:foerderzeitraum.bis  "2028-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2024-04-01T00:00:00.000+00:00";
                                xyz:schluessel           "b2cbedf0-086f-41e4-bd24-15c005a2b7be";
                                xyz:teaser               "Wenn Sie für Ihre Bürger einen öffentlich zugänglichen Trinkbrunnen anbieten möchten, können Sie sich den Bau von maximal zwei Trinkbrunnen fördern lassen.";
                                xyz:titel                "Förderung eines Trinkbrunnen im öffentlichen Raum";
                                xyz:titel.tokens         [ rdf:_1  "Förderung eines Trinkbrunnen im öffentlichen Raum" ];
                                xyz:voraussetzung        "<p>Sie sind nur antragsberechtigt, wenn Sie ein kommunales Wasserversorgungsunternehmen sind. (siehe Nr. 3 RZWas 2025)</p>"
                              ];
              xyz:id          "b2cbedf0-086f-41e4-bd24-15c005a2b7be";
              xyz:payload     [ xyz:json  [ xyz:anfrage            [ xyz:anfragenummer  "b2cbedf0-086f-41e4-bd24-15c005a2b7be";
