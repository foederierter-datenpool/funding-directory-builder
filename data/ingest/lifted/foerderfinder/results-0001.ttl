                                                                                                                                           xyz:rechtsbehelf             "<p>gesetzlich</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<p>Der Sonderzuschuss für die Beförderung von Schülerinnen und Schüler mit schwerwiegenden Beeinträchtigungen kann formlos bei der zuständigen Regierung beantragt werden. Maßgeblich für die örtliche Zuständigkeit ist der jeweilige Sitz der Schule. Der Antrag ist mit sämtlichen benötigten Unterlagen schriftlich bei der entsprechend dem Sitz der privaten Grund- oder Mittelschule örtlich zuständigen Regierung einzureichen. Nach Prüfung entscheidet die Regierung über die Bewilligung des Zuschusses.</p><p><br></p>";
                                                                                                                                                                          xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "001";
                                                                                                                                                                                                            xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
                                                                                                                                                                                                            xyz:listVersionID  "1"
                                                                                                                                                                                                          ]
                                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:finanzierungsartUndHoehe  "<p>Die Förderung erfolgt in Form eines direkten <strong>Zuschusses</strong> des Freistaats Bayern an die Schulträger.&nbsp;</p><p><strong>Finanzierungshöhe:</strong></p><p>Schulträger können bei einer <strong>nachgewiesenen Schwerbehinderung</strong> (Merkzeichen \"G\", \"aG\", \"H\", \"Bl\") und einem speziellen Beförderungsbedarf Zuschüsse für die Schülerbeförderung beantragen, sofern diese Kosten niedriger ausfallen als alternative Beförderungsoptionen.</p>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "001";
                                                                                                                                                                                                    xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
                                                                                                                                                                                                    xyz:listVersionID  "1";
                                                                                                                                                                                                    xyz:name           ""
                                                                                                                                                                                                  ]
                                                                                                                                                                         ];
