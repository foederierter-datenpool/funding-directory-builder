                                          ];
                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>ef65e416-a081-48c9-881f-1ca6702ddf16</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2026-04-15T16:25:57</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>ef65e416-a081-48c9-881f-1ca6702ddf16</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>ef65e416-a081-48c9-881f-1ca6702ddf16</xflb:schluessel>\n         <xflb:versionFLB>1</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-04-15T16:25:57</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>ef65e416-a081-48c9-881f-1ca6702ddf16</xflb:foerderschluessel>\n                  <xflb:flbVersion>1</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>09999000000030</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Umsetzung zur Klimaanpassung</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Zweck der Zuwendung ist die Umsetzung ganz konkreter Klimaanpassungsmaßnahmen vor Ort. Gefördert werden Projekte, mit denen sich Kommunen besser gegen die Folgen des Klimawandels wappnen - insbesondere gegen zunehmende Hitzebelastungen im Siedlungsbereich. Dazu gehören zum Beispiel Maßnahmen zum Regenwasserrückhalt und zur Regenwassernutzung &lt;strong&gt;(etwa durch Zisternen oder einfache Regenwassernutzungsanlagen)&lt;/strong&gt; sowie die Pflanzung &lt;strong&gt;schattenspendender, hitzetoleranter Bäume&lt;/strong&gt;, insbesondere in stark genutzten Aufenthaltsbereichen. So werden Menschen, Gebäude und Infrastrukturen besser geschützt und die Lebensqualität in der Kommune langfristig gesichert.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Machen Sie Ihre Kommune fit für heiße Sommer!\nMit unserer Förderung investieren Städte, Gemeinden und Landkreise  in Klimaanpassung - z.B. Zisternen, Regenwassernutzung oder hitzetolerante Bäume. So sinken Hitzebelastung und Klimarisiken, die Aufenthaltsqualität steigt.</xflb:teaser>\n                  <xflb:schluesselwoerter>Förderung, Zuschuss, Kommune, Kommunen, Stadt, Gemeinde, Landkreis, Bezirk, Zweckverband, Zusammenschluss, kommunales Unternehmen, Stadtwerke, Klimaschutz, Klimaneutralität, CO2-Einsparung, Treibhausgasminderung, Klimaanpassung, Klimaschutzkonzept, Entwicklungskonzept Klimaneutrale Kommune, Kommunales Energiemanagement, KEM, LED-Sanierung, Klimaschutzlotse, Koordinierungsstelle, Begleitmaßnahmen, Öffentlichkeitsarbeit, Investive Maßnahmen, Strategische Maßnahmen, Fördersatz, Förderobergrenze, Mindestbetrag 10 000 €, Projektstart nach Bewilligung, Gesicherte Finanzierung, Eigenanteil, Marktübliche Preise, De-minimis-Regeln, DAWI-Regeln, EU-Beihilfe, Genehmigungen, Zustimmungen, Zweckbindung, Eigentumsübergang, Nicht gewerbliche Nutzung, Keine gesetzlichen Pflichtaufgaben, Laufende Betriebskosten, Energieeffizienz, Energiesparen, Software, Energiecontrolling, KI, Klimawälder, Dachbegrünung, Beschattung, Zisternen</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Die zuständige Bewilligungsbehörde ist Ihre Bezirksregierung: Für Kommunen in Oberbayern und der Oberpfalz die Regierung von Oberbayern (E-Mailadresse: kommklimafoer@reg-ob.bayern.de, Frau Metz und Herr Kögl), in Schwaben und Niederbayern die Regierung von Schwaben (E-Mailadresse: kommklimafoer@reg-schw.bayern.de, Frau Löw-Beer und Frau Danzer) sowie in Unter-, Ober- und Mittelfranken die Regierung von Unterfranken (E-Mailadresse: kommklimafoer@reg-ufr.bayern.de, Frau Sprenger-Zier und Frau Grgic).</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:onlinedienste>\n                  <xflb:onlinedienst>\n                     <xflb:id>e5f83cde-7a6c-4a74-88ab-f9a7e658b1d3</xflb:id>\n                     <xflb:bezeichnung>KommKlimaFöR 2026 - Umsetzung zur Klimaanpassung</xflb:bezeichnung>\n                     <xflb:link>https://foerderung.bayern.de/landingpage/d8c4e525-9350-49f6-8e34-37da71043804</xflb:link>\n                     <xflb:beschreibung>Sie können die Förderung über die Fördermanagementplattform Bayern (FMP) digital beantragen.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n               </xflb:onlinedienste>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Gefördert werden bayerische Städte und Gemeinden, Landkreise und Bezirke, deren Zweckverbände und andere Zusammenschlüsse sowie kommunale Unternehmen.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Sie erhalten einen prozentualen Anteil Ihrer förderfähigen Ausgaben als Zuschuss - wie hoch dieser Anteil und der maximale Betrag sind, richtet sich nach dem jeweiligen Fördergegenstand.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Welche Kosten gefördert werden, hängt vom jeweiligen Fördergegenstand ab.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n               <xflb:euBeihilferelevanz>Aufträge, die Sie mit Fördermitteln vergeben, müssen zu marktüblichen Preisen erfolgen.\nHandelt es sich bei der Förderung um eine EU-Beihilfe, gelten die De-minimis-/DAWI-Vorschriften (VO (EU) 2023/2831, VO (EU) 2023/2832, Beschluss 2025/2630/EU).</xflb:euBeihilferelevanz>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Bayerisches Staatsministerium für Umwelt und Verbraucherschutz</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinie zur \"Förderung des kommunalen Klimaschutzes\" im Bayerischen Klimaschutzprogramm (Förderrichtlinie Kommunaler Klimaschutz - KommKlimaFöR 2026)</xflb:bezeichnung>\n                     <xflb:link>https://www.verkuendung-bayern.de/baymbl/2026-303/</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat 26</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Förderrichtlinien Kommunaler Klimaschutz - KommKlimaFöR 2026</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2029-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2026-08-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2029-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n               <xflb:kummulierbareFoerderungen>\n                  <xflb:voraussetzungen>&lt;p&gt;Kombination mit anderen Förderungen - kurz erklärt&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Förderung nur, wenn kein anderes Bayern-Programm passt Unser Zuschuss greift, wenn Ihr Vorhaben nicht bereits durch ein anderes Landesprogramm gefördert werden kann.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bund- oder EU-Gelder möglich Sie dürfen diesen Zuschuss mit Programmen des Bundes oder der EU verbinden, sofern&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;es sich um dasselbe Vorhaben mit identischem Kostenplan handelt und&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;die Regelungen der anderen Programme sowie das EU-Beihilferecht die Kombination erlauben. Wenn diese Bedingungen nicht erfüllt sind, bleibt es bei der Regel, dass wir erst fördern, wenn kein anderes Bayern-Programm passt.&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li value=\"3\"&gt;Doppelt beantragt? Bitte melden! Sobald Sie auch bei einer anderen Stelle Fördermittel beantragen, informieren Sie Ihre Bewilligungsbehörde sofort und schicken nach Erhalt eine Kopie des dortigen Bescheids.&lt;/li&gt;&lt;li value=\"4\"&gt;Förderdeckel Bei mehreren Geldgebern zusammen darf die Gesamthilfe 90 % der förderfähigen Kosten nicht überschreiten. Ihre Kommune muss daher mindestens 10 % der Kosten selbst tragen.&lt;/li&gt;&lt;/ul&gt;</xflb:voraussetzungen>\n               </xflb:kummulierbareFoerderungen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;h4&gt;Vorhaben zur Klimaanpassung&lt;/h4&gt;&lt;p&gt;Umsetzungsvorhaben zur Verringerung von Hitzeauswirkungen,&lt;/p&gt;&lt;p&gt;beispielsweise&lt;br&gt;- naturbasierte Beschattungen für öffentliche Plätze (auch Kindergärten, Schulen, Spielplätze),&lt;br&gt;- Klimawälder, Klimaparks, Dachbegrünungen&lt;br&gt;- klimafreundliche Wasseranlagen (z. B. \"Kühlbrunnen\")&lt;br&gt;- einfache Systeme zur Regenwassernutzung wie Zisternen&lt;/p&gt;&lt;p&gt;Förderhöhe: &lt;strong&gt;bis zu 50 %&lt;/strong&gt;&lt;br&gt;maximal: &lt;strong&gt;200.000 €&lt;/strong&gt;&lt;/p&gt;&lt;h4&gt;Kommunen unter 2.000 Einwohnern bzw. interkommunale Zusammenschlüsse unter 5.000 Einwohnern erhalten &lt;strong&gt;10 Prozentpunkte, f&lt;/strong&gt;inanzschwache Kommunen bekommen &lt;strong&gt;20 Prozentpunkte mehr.&lt;/strong&gt;&lt;br&gt;(Achtung: Eine Kombination beider Aufschläge ist nicht möglich.)&lt;/h4&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>019</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;h4&gt;Allgemeine Fördervoraussetzungen - kurz erklärt&lt;/h4&gt;&lt;ol&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;&lt;strong&gt;Projektstart erst nach Bewilligung&lt;/strong&gt;&lt;br&gt;Beginnen Sie erst mit dem Projekt, wenn der Förderbescheid vorliegt. Vorarbeiten auf eigenes Risiko sind ausgeschlossen.&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;&lt;strong&gt;Keine Pflichtaufgaben&lt;/strong&gt;&lt;br&gt;Vorhaben, zu denen Ihre Kommune oder Dritte ohnehin gesetzlich verpflichtet sind, können nicht gefördert werden.&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;&lt;strong&gt;Finanzierung steht&lt;/strong&gt;&lt;br&gt;- Die Gesamtfinanzierung muss gesichert sein (z. B. Eigenanteil, weitere Zuschüsse).&lt;br&gt;- Laufende Betriebs- und Unterhaltskosten trägt die Kommune selbst.&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;&lt;strong&gt;Mindestgröße&lt;/strong&gt;&lt;br&gt;Die förderfähigen Ausgaben müssen mindestens &lt;strong&gt;10 000 €&lt;/strong&gt; betragen.&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;&lt;strong&gt;Anschaffungen&lt;/strong&gt;&lt;br&gt;Gefördert werden Anschaffungen nur, wenn sie in das Eigentum der Kommune übergehen und nicht gewerblich betrieben werden.&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;&lt;strong&gt;Genehmigungen&lt;/strong&gt;&lt;br&gt;Holen Sie alle erforderlichen behördlichen Genehmigungen oder Zustimmungen (etwa von Grundstückseigentümer*innen) ein, bevor Sie mit der Umsetzung beginnen.&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;&lt;strong&gt;Zweckbindung&lt;/strong&gt;&lt;br&gt;Die geförderten Mittel und angeschafften Anlagen sind ausschließlich für das bewilligte Vorhaben zu nutzen. In der Regel gilt eine Zweckbindungsfrist von &lt;strong&gt;fünf Jahren&lt;/strong&gt; ab Inbetriebnahme; eine kürzere Frist ist nur in gut begründeten Ausnahmefällen möglich.&lt;/li&gt;&lt;/ol&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Vorhaben, zu denen Ihre Kommune oder Dritte ohnehin gesetzlich verpflichtet sind, können nicht gefördert werden.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Eine Zuwendung für die in Energieförderprogrammen des Freistaates Bayern erfassten Fördermaßnahmen (zum Beispiel Energieforschung, Energienutzungspläne, Energiecoaching, kommunaler Energiewirt) ist ausgeschlossen.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Leistungen, die der Erfüllung gesetzlicher Verpflichtungen nach dem Wärmeplanungsgesetz (WPG) dienen, sind nicht förderfähig.&lt;/li&gt;&lt;/ul&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://foerderung.bayern.de/landingpage/d8c4e525-9350-49f6-8e34-37da71043804</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;So läuft Ihr Antrag ab - Schritt für Schritt&lt;/p&gt;&lt;ol&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;Antrag online stellen&lt;br&gt;Füllen Sie den Antrag auf der Fördermanagementplattform Bayern aus und senden Sie ihn ab.&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;Weiterleitung an die richtige Stelle&lt;br&gt;Die Plattform schickt Ihren Antrag automatisch an die zuständige Bezirksregierung. Bei Rückfragen meldet sich die Behörde direkt bei Ihnen.&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;Zuwendungsbescheid erhalten&lt;br&gt;Nach erfolgreicher Prüfung bekommen Sie Ihren Zuwendungsbescheid.&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;Geld auszahlen lassen&lt;br&gt;- Projekte über 100 000 €: Sie reichen nach Abschluss einen Verwendungsnachweis ein, der geprüft wird.&lt;br&gt;- Projekte bis 100 000 €: Eine kurze Mitteilung, dass Ihr Vorhaben abgeschlossen ist, genügt (vereinfachtes Verfahren).&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;Änderungen mitteilen&lt;br&gt;Ändern sich nach Bewilligung die tatsächlichen Kosten, informieren Sie bitte sofort die Bewilligungsstelle - nur so kann der Zuschuss korrekt angepasst werden.&lt;/li&gt;&lt;/ol&gt;</xflb:bewilligung>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>&lt;p&gt;Sie möchten mit Ihrem Projekt loslegen, bevor der Förderbescheid vorliegt? Dann brauchen Sie eine ausdrückliche Zustimmung zum \"vorzeitigen Vorhabenbeginn\" (Nr. 1.5.4 VV zu Art. 44 BayHO). So gehen Sie vor:&lt;/p&gt;&lt;ol&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;Rechtzeitig beantragen:&lt;br&gt;- Stellen Sie den Antrag vor dem ersten rechtsverbindlichen Schritt (z. B. Auftrag unterschreiben, Bestellung auslösen).&lt;br&gt;- Schreiben Sie dazu eine formlose E-Mail an Ihre zuständige Bewilligungsbehörde.&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;Dringlichkeit begründen:&lt;br&gt;- Erläutern Sie, warum Sie nicht bis zum Förderbescheid warten können (z. B. enge Bau-/Ausschreibungsfristen, saisonale Arbeiten, Preisbindungen).&lt;br&gt;- Beschreiben Sie kurz, welche Folgen es hätte, wenn sich das Vorhaben verzögert.&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;Risiko kennen:&lt;br&gt;- Die Zustimmung ermöglicht nur den Start - sie ist keine Förderzusage.&lt;br&gt;- Beginnen Sie trotzdem auf eigenes Risiko: Wird der Antrag später abgelehnt oder gekürzt, tragen Sie die Kosten selbst.&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;Schriftliche Zustimmung abwarten:&lt;br&gt;- Legen Sie erst los, wenn Ihnen die behördliche Bestätigung schriftlich vorliegt.&lt;br&gt;- Ausgaben, die vor diesem Datum entstehen, sind nicht förderfähig.&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;Umfang beachten:&lt;br&gt;- Die Zustimmung gilt nur für das beantragte Vorhaben in der angegebenen Höhe. Änderungen (z. B. neue Gewerke, höhere Kosten) müssen erneut genehmigt werden.&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;Unterlagen beifügen:&lt;br&gt;- Aktueller Kosten- und Zeitplan&lt;br&gt;- Gemeinderats-/Kreistagsbeschluss zum Projekt&lt;br&gt;- Finanzierungskonzept (Eigenanteil gesichert)&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;Befolgen Sie diese Schritte, bleibt Ihr Vorhaben trotz frühem Start förderfähig - und Sie vermeiden unangenehme Überraschungen bei der späteren Prüfung.&lt;/p&gt;</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:monate>9</xflb:monate>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>18</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristFest>\n                        <xflb:jahre>4</xflb:jahre>\n                     </xflb:fristFest>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Anträge können zwischen 01.08.2026 und 31.12.2029  (Laufzeit der Förderrichtlinie) gestellt werden.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Projektbeschreibung</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Kurz schildern, was Sie vorhaben und welches Ziel Sie damit verfolgen.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Ausgabengliederung und Finanzierungsplan</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Übersicht der geplanten Ausgaben und Finanzierungsplan (Eigenanteil, andere Zuschüsse )</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Erklärung, dass mit dem Vorhaben noch nicht begonnen wurde</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Schriftlich bestätigen, dass Sie mit dem Projekt noch nicht begonnen haben.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Erklärung zum Vorsteuerabzug nach § 15 UStG</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Angeben, ob Ihre Kommune zum Vorsteuerabzug (§ 15 UStG) berechtigt ist.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>ggf. Nachweis der Finanzschwäche</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Eine Bestätigung der Finanzschwäche durch die Kommunalaufsicht vorlegen.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Gremienbeschluss</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Beschluss des zuständigen kommunalen Gremiums, dass das Vorhaben durchgeführt werden soll.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Erklärung zur Doppelförderung</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Erklärung, dass Sie für dasselbe Projekt keine weiteren Landesmittel beantragen.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>ggf. aktuelle Einwohnerbestätigung bzw. Meldebestandsauskunft</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Eine aktuelle Bestätigung für \"kleine Kommune bzw. interkommunaler Zusammenschluss\" hochladen.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Anzahl der geschützten Personen</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Es ist anzugeben, wie viele Bürgerinnen und Bürger durch das Vorhaben geschützt werden.</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Die Kommunen können Klage innerhalb eines Monats nach Bekanntgabe des Bescheides beim Bayerischen Verwaltungsgericht einlegen.&amp;nbsp;&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_175  [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/rmf_15-053-zz/index?caller=bpgezdqmrvmnsgkobsmeytmmrrheqsygebrxwzfppj2xd6qrnobhp6hfft4bxbndpkdilr4bgnrahilcvmnf2robrejxcq5e7xbvyiaivxj5w7256pzmdjueh7a7u7kirmxd35pq3veb7zalirx2hhwcq27ddsq6dckmcf45jw3fnt77kidfntf4nj7eljtispaykngytenrkzk888";
                                xyz:begriffeImKontext    [ rdf:_1  "Zuwanderer";
                                                           rdf:_2  "Aussiedlerberatung";
                                                           rdf:_3  "Flüchtlingsberatung";
                                                           rdf:_4  "Spätaussiedlerberatung";
                                                           rdf:_5  "Flüchtling";
                                                           rdf:_6  "Ausländerberatung";
                                                           rdf:_7  "Asylberatung";
                                                           rdf:_8  "Migrationsberatung";
                                                           rdf:_9  "Integrationsberatung"
                                                         ];
                                xyz:beschreibung         "<p>Zweck der Förderung ist es,</p><ul><li class=\"unordered-list-item--dash\">den Integrationsprozess von Menschen mit Migrationsgeschichte mit dauerhaftem Bleiberecht nach dem Grundsatz \"Fördern und Fordern\" zu stärken, um einerseits die Teilhabechancen in unserem Land und andererseits das gelebte Miteinander der Menschen mit und ohne Migrationsgeschichte vor Ort zu unterstützen sowie</li><li class=\"unordered-list-item--dash\">Leistungsberechtigte nach § 1 AsylbLG zu unterstützen.</li></ul>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Integration" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Kommunen";
                                                           rdf:_2  "Vereine";
                                                           rdf:_3  "Verbände"
                                                         ];
                                xyz:foerderprogramm      "Richtlinie für die Förderung der sozialen Beratung, Betreuung und Integration von Menschen mit Migrationsgeschichte (Beratungs- und Integrationsrichtlinie - BIR)";
                                xyz:foerderzeitraum.bis  "2026-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2024-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "e0fc396d-50b3-4035-970e-86864c4ed45d";
                                xyz:teaser               "Der Freistaat Bayern gewährt Zuwendungen zur Unterstützung und Beratung von Asylbewerberinnen\nund Asylbewerber sowie dauerhaft bleibeberechtigten Menschen mit Migrationshintergrund.";
                                xyz:titel                "Förderung von Flüchtlings- und Integrationsberatung";
                                xyz:titel.tokens         [ rdf:_1  "Förderung von Flüchtlings- und Integrationsberatung" ];
                                xyz:voraussetzung        "<p>Die Beratungskräfte müssen fachlich qualifiziert sein. Die Qualifikationsanforderungen sind im Einzelnen der Beratungs- und Integrationsrichtlinie zu entnehmen. Grundsätzlich ist bei der Planung und Ergänzung der Beratungsstruktur darauf zu achten, dass bayernweit eine bedarfsorientierte Angebots- und Beratungsstruktur erreicht wird.</p><p>Der Antragsteller muss einen angemessenen Eigenanteil in Höhe von mindestens 10% der zuwendungsfähigen Gesamtausgaben erbringen, der auch über Drittmittel erbracht werden kann.</p><p>Voraussetzung für die Förderung der Landesverbände ist, dass diese oder die ihnen untergeordneten Verbände und Träger Zuwendungen für die Flüchtlings- und Integrationsberatung im Sinne der Beratungs- und Integrationsrichtlinie erhalten und der Landesverband hierfür koordinierende und verwaltende Aufgaben, insbesondere die bayernweite bedarfsgerechte Sicherstellung der Beratung, wahrnimmt.</p>"
                              ];
