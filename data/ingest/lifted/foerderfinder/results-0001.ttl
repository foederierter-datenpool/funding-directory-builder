                                                                                                             xyz:antragsinformationen    [ xyz:beantragungskosten       [ xyz:kostenlos
                                                                                                                                                             "ja" ];
                                                                                                                                           xyz:erforderlicheUnterlagen  [ xyz:dokument  [ rdf:_1  [ xyz:bezeichnung  "Kosten- und Finanzierungsplan" ];
                                                                                                                                                                                          rdf:_2  [ xyz:bezeichnung  "Erklärung über die Vorsteuerabzugsberechtigung" ];
