                                                                                                                                           xyz:erforderlicheUnterlagen  [ xyz:dokument  [ rdf:_1  [ xyz:bezeichnung   "Vorhabenbeschreibung";
                                                                                                                                                                                                    xyz:erlaeuterung  "Ort, Zeitraum der Veranstaltung\nbeteiligte Künstler (Vita)/zu präsentierende Objekte/ggf. Ausstellungskonzept"
                                                                                                                                                                                                  ];
                                                                                                                                                                                          rdf:_2  [ xyz:bezeichnung   "Kostenplan";
                                                                                                                                                                                                    xyz:erlaeuterung  "Aufschlüsselung aller, mit dem Vorhaben zusammenhängenden Ausgaben nach Kostengruppen, je nach Vorsteuerabzugsberechtigung brutto oder netto."
                                                                                                                                                                                                  ];
                                                                                                                                                                                          rdf:_3  [ xyz:bezeichnung   "Finanzierungsplan";
                                                                                                                                                                                                    xyz:erlaeuterung  "Der Finanzierungsplan muss neben der Antragssumme auch Projekteinnahmen, die Zuwendungen Dritter (z.B. Kommune), sonstige Finanzierungsbeteiligungen (Spenden, Sponsoren) sowie die vom Antragsteller zu erbringende Eigenbeteiligung ausweisen."
                                                                                                                                                                                                  ]
