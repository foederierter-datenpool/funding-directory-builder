                                xyz:beschreibung         "<p>Die Zuwendungen dienen dazu, ein optimales Stützpunktsystem für den Nachwuchsleistungssport der Verbände zur Verfügung zu stellen.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Kultur, Medien und Sport" ];
