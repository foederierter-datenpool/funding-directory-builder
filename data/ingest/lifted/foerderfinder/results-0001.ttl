                                                                                                             xyz:foerdergegenstand       [ xyz:beschreibung
                                                                                                                               "<p>Gefördert werden Maßnahmen bayerischer Kommunen zum Erhalt oder zur Verbesserung der <strong>ambulanten medizinischen Versorgung vor Ort.</strong> Förderfähig sind:</p><ol><li class=\"ordered-list-item--numbered\"><strong>Aufbau von Einrichtungen der vernetzten Versorgung</strong>, z. B. Gesundheitszentren, Primärversorgungszentren, Teampraxen oder intersektorale Gesundheitszentren. Jede Einrichtung muss mind. ein zur vertragsärztlichen Versorgung zugelassenes oder ermächtigtes &nbsp;<strong>haus- oder kinderärztliches Versorgungsangebot</strong> umfassen.</li><li class=\"ordered-list-item--numbered\"><strong>Gründung kommunaler Eigeneinrichtungen</strong> nach § 105 Abs. 5 SGB V oder <strong>kommunaler medizinischer Versorgungszentren (MVZ)</strong> nach § 95 Abs. 1a SGB V.</li><li class=\"ordered-list-item--numbered\"><strong>Service- und Beratungsangebote </strong>zur Gewinnung von Ärztinnen und Ärzten, z. B. &nbsp;Beratung zu Förderungen und Ansiedlung, Unterstützung bei der Suche nach Standort, &nbsp;Praxisräumen, Wohnraum, Baugrundstücken oder Kindergartenplätzen.</li><li class=\"ordered-list-item--numbered\"><strong>Etablierung von Mobilitätsangeboten</strong> für Ärztinnen, Ärzte oder Patientinnen und Patienten, z. B. Patientenfahrdienste.</li><li class=\"ordered-list-item--numbered\"><strong>Imagekampagnen und Marketingaktivitäten</strong> zur Gewinnung von Ärztinnen und Ärzten.</li></ol>" ];
                                                                                                             xyz:foerdernehmende         [ xyz:beschreibung     "Gemeinden im ländlichen Raum bis 20.000 Einwohner sowie deren öffentlich-rechtliche Zusammenschlüsse, kommunale Unternehmen und gemeindliche Einrichtungen mit Sitz in Bayern.\n\nGemeinden im ländlichen Raum mit mehr als 20.000 bis 30.000 Einwohnern, sofern sie zu den \"Räumen mit besonderem Handlungsbedarf\" nach dem Landesentwicklungsprogramm Bayern (LEP) gehören. Damit sind Teilräume gemeint mit wirtschaftsstrukturellen oder sozioökonomischen Nachteilen sowie Teilräume, in denen eine nachteilige Entwicklung zu befürchten sind, wenn diese nicht gefördert werden.\n\nBei den größeren Gemeinden sind auch deren öffentlich-rechtliche Zusammenschlüsse, kommunale Unternehmen und gemeindliche Einrichtungen mit Sitz in Bayern antragsberechtigt.";
                                                                                                                                           xyz:foerdernehmende  [ xyz:code           "009";
                                                                                                                                                                  xyz:listURI        "urn:xoev-de:stmd:codeliste:foerdernehmende";
                                                                                                                                                                  xyz:listVersionID  "1";
                                                                                                                                                                  xyz:name           ""
                                                                                                                                                                ]
                                                                                                                                         ];
