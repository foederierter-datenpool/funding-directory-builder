                                            xyz:nachrichtenkopf    [ xyz:empfaenger            "Förderfinder Suche (Bayern)";
                                                                     xyz:erstellungszeitpunkt  "2024-09-06T13:38:47";
                                                                     xyz:nachrichtennummer     "3d165a7f-8d3b-43d4-bed7-c0a1f444fdf6";
                                                                     xyz:sender                "XFLB-Connect (Bayern)"
                                                                   ];
                                            xyz:produkt            "Förderfinder";
                                            xyz:produkthersteller  "StMD Bayern";
                                            xyz:schemaLocation     "http://xoev.de/schemata/xflb/2_0_0";
                                            xyz:standard           "XFLB";
