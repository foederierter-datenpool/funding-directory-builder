                                                                                                                     [ xyz:ablaufdatumRichtlinie      "2027-12-31";
                                                                                                                       xyz:geldgebendeInstitutionen   [ xyz:geldgebendeInstitution  [ xyz:code           "003";
                                                                                                                                                                                      xyz:listURI        "urn:xoev-de:stmd:codeliste:geldgebende-institution";
                                                                                                                                                                                      xyz:listVersionID  "1";
                                                                                                                                                                                      xyz:name           ""
                                                                                                                                                                                    ]
                                                                                                                                                      ];
                                                                                                                       xyz:handlungsgrundlagen        [ xyz:verweis  [ rdf:_1  [ xyz:bezeichnung  "Richtlinien für Zuwendungen des Freistaats Bayern zur Förderung des kommunalen Feuerwehrwesens (Feuerwehr-Zuwendungsrichtlinien - FwZR) (Stand 23.12.2024)";
                                                                                                                                                                                 xyz:link         "https://www.gesetze-bayern.de/Content/Document/BayVV_2153_I_14931"
                                                                                                                                                                               ];
                                                                                                                                                                       rdf:_2  [ xyz:bezeichnung  "Anlage 1 der Richtlinien für Zuwendungen des Freistaats Bayern zur Förderung des kommunalen Feuerwehrwesens (Feuerwehr-Zuwendungsrichtlinien - FwZR) (Stand 23.12.2024))";
                                                                                                                                                                                 xyz:link         "https://www.gesetze-bayern.de/Content/Resource?path=resources%2fBayVV_2153_I_14931_BayVV2153-I-14931-Anhang-001.PDF"
                                                                                                                                                                               ];
                                                                                                                                                                       rdf:_3  [ xyz:bezeichnung  "Anlage 2 der Richtlinien für Zuwendungen des Freistaats Bayern zur Förderung des kommunalen Feuerwehrwesens (Feuerwehr-Zuwendungsrichtlinien - FwZR) (Stand 23.12.2024))";
                                                                                                                                                                                 xyz:link         "https://www.gesetze-bayern.de/Content/Resource?path=resources%2fBayVV_2153_I_14931_BayVV2153-I-14931-Anhang-002.PDF"
                                                                                                                                                                               ]
                                                                                                                                                                     ]
                                                                                                                                                      ];
                                                                                                                       xyz:kummulierbareFoerderungen  [ xyz:beschreibungAusschluss  "grundsätzlicher Ausschluss der Förderung, wenn für eine Maßnahme neben Mitteln nach den FwZR auch andere Mittel des Freistaates Bayern in Anspruch genommen werden (siehe Nr. 4.7 der Fördergrundsätze der Staatsregierung).";
                                                                                                                                                        xyz:voraussetzungen         "Werden für ein Vorhaben neben der Förderung aus Feuerschutzsteuermitteln nach den FwZR ausnahmsweise auch Fördermittel in Anspruch genommen, die zu einem anderen als dem unmittelbar mit den FwZR verfolgten Förderzweck bereitgestellt sind, die Kommunen bei der Sicherstellung von abwehrendem Brandschutz und technischem Hilfsdienst zu unterstützen, ist das grundsätzlich zugelassen.  Beispiele dafür sind: Förderungen im Bereich Energieeffizienz und erneuerbare Energien, Förderung der Elektromobilität oder zum Klimaschutz, auch aus Programmen der im Auftrag der Staatsregierung tätigen Förderbanken und des Förderinstituts BayernLabo."
                                                                                                                                                      ];
                                                                                                                       xyz:programmlaufzeit           [ xyz:beginnLaufzeitFoerderprogramm
                                                                                                                                                                "2025-01-01";
                                                                                                                                                        xyz:endeLaufzeitFoerderprogramm
                                                                                                                                                                "2027-12-31"
                                                                                                                                                      ];
                                                                                                                       xyz:programmtitel              "Richtlinien für Zuwendungen des Freistaates Bayern zur Förderung des kommunalen Feuerwehrwesens, Feuerwehr-Zuwendungsrichtlinien, FwZR";
                                                                                                                       xyz:verantwortlichesFachreferat
                                                                                                                               "Sachgebiet D1";
                                                                                                                       xyz:verantwortlichesMinisterium
                                                                                                                               "Staatsministerium des Innern, für Sport und Integration"
                                                                                                                     ];
                                                                                                             xyz:foerdervoraussetzungen  [ xyz:ausschlusskriterien  "Förderfähig sind ausschließlich kommunale Maßnahmen im Feuerwehrwesen";
                                                                                                                                           xyz:buergerfreundlicheBeschreibung
                                                                                                                                                   "Die Fördervoraussetzungen sind in den einschlägigen Zuwendungsrichtlinien und\nden allgemeinen haushaltsrechtlichen Bestimmungen enthalten.\n\nGefördert werden Maßnahmen insbesondere nur dann, wenn sie für die Erfüllung der kommunalen Pflichtaufgaben im abwehrenden Brandschutz und im technischen Hilfsdienst geeignet sind, die Leistungsfähigkeit der Feuerwehr aufrechtzuerhalten oder zu verbessern. Die zur Förderung beantragten Maßnahmen müssen ferner notwendig und wirtschaftlich sein"
                                                                                                                                         ];
