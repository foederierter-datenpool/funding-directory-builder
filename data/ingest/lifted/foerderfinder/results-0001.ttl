                                                                                                                                                                              ];
                                                                                                                                                                      rdf:_3  [ xyz:bezeichnung  "Bayerisches Zinsverbilligungsprogramm zur Förderung von Eigenwohnraum";
                                                                                                                                                                                xyz:link         "https://www.gesetze-bayern.de/Content/Document/BayVwV97112"
                                                                                                                                                                              ]
