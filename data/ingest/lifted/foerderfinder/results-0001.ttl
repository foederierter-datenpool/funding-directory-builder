                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>9918100e-cbfc-4e54-9a2d-dfe41f1da687</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-08-01T17:25:58</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>9918100e-cbfc-4e54-9a2d-dfe41f1da687</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>9918100e-cbfc-4e54-9a2d-dfe41f1da687</xflb:schluessel>\n         <xflb:versionFLB>4</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-11-20T09:29:34</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>9918100e-cbfc-4e54-9a2d-dfe41f1da687</xflb:foerderschluessel>\n                  <xflb:flbVersion>4</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400084017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Stationäre Wohnplätze für Menschen mit Behinderung</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Es sollen individuelle, gemeindeintegrierte Wohnformen geschaffen werden, die es Menschen mit Behinderungen ermöglichen, soweit wie möglich eigenständig und selbständig leben zu können.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Staat fördert den Neu- und Umbau von stationären Wohnplätzen für Menschen mit Behinderung.</xflb:teaser>\n                  <xflb:schluesselwoerter>Behindertenheime, Eingliederungsheime, Wohnungsbauförderung, Wohnraumförderung, Wohnbauförderung, Fachpflegeheime, Heime für behinderte Menschen, Förderung Behindertenheime, Wohnheim, Wohnpflegeheime</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderung von Wohnraum für Menschen mit Behinderung</xflb:bezeichnung>\n                     <xflb:link>http://www.bauen.bayern.de/wohnen/foerderung/menschenmitbehinderung/index.php</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>örtlich zuständige Bezirksregierung; Städte München, Augsburg und Nürnberg</xflb:name>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderung von Wohnraum für Menschen mit Behinderung</xflb:bezeichnung>\n                     <xflb:link>https://www.stmb.bayern.de/wohnen/foerderung/menschenmitbehinderung/index.php</xflb:link>\n                  </xflb:verweis>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>örtlich zuständige Bezirksregierung; Städte München, Augsburg und Nürnberg</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>6c2c7f9f-3508-4b72-8426-a87abb825ba6</xflb:id>\n                     <xflb:bezeichnung>Staatliche Förderung von Einrichtungen für Menschen mit Behinderung - Formblatz BehPlan I</xflb:bezeichnung>\n                     <xflb:link>https://www.stmb.bayern.de/assets/stmi/wohnen/foerderung/antrag_stand_oktober_2019_behplan_i.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>2acc0386-53b8-4361-a231-9923a67adfc0</xflb:id>\n                     <xflb:bezeichnung>Nachweis \"Einnahmen- und Ausgabenübersicht für geförderte Wohngebäude\" - Stabau IV</xflb:bezeichnung>\n                     <xflb:link>http://www.bauen.bayern.de/assets/stmi/wohnen/iic1_foerderung_nachweis_einnahmen_ausgaben_20130313.doc</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Antragsberechtigt sind Einrichtungsträger von stationären Wohnplätzen für Menschen mit Behinderung.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die staatliche Einrichtung beträgt je nach Art der Einrichtung bis zu 70 Prozent der jeweils zuwendungsfähigen Kosten.&amp;nbsp;&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Gefördert werden Grundstücks-, Bau- und Baunebenkosten gemäß §§ 5 bis 8 der Verordnung über wohnungswirtschaftliche Berechnungen nach dem Zweiten Wohnungsbaugesetz (Zweite Berechnungsverordnung - II. BV) (= Gesamtkosten).&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Wohnen, Bau und Verkehr</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Wohnraumförderungsbestimmungen 2023 (WFB 2023)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2330_B_13734/true</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Verordnung zur Durchführung des Wohnungsrechts und des Besonderen Städtebaurechts (Durchführungsverordnung Wohnungsrecht - DVWoR)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayDVWoR/true</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat 31</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Förderung von Wohnraum für Menschen mit Behinderung</xflb:programmtitel>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2007-05-08</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2028-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Der Staat fördert den Neu- und Umbau von stationären Wohnplätzen für Menschen mit Behinderung.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>021</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Voraussetzung für eine Förderung ist, dass ein langfristiger Bedarf an Wohnplätzen nachgewiesen werden kann und eine fachliche Konzeption vorliegt, die den Zielen der Inklusion Rechnung trägt. Vor der Bewilligung der Fördermittel darf mit dem Bauvorhaben nicht begonnen oder ein Kaufvertrag abgeschlossen werden.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.stmb.bayern.de/assets/stmi/wohnen/foerderung/antrag_stand_oktober_2019_behplan_i.pdf</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Die Projekte sind in der Regel bis zum 15. März eines jeden Jahres von der Bewilligungsstelle an die Staatsministerien für Familie, Arbeit und Soziales sowie für Wohnen, Bau und Verkehr zur Aufnahme in das Jahresförderprogramm anzumelden. Die Unterlagen müssen daher rechtzeitig vorher bei den Bewilligungsstellen eingereicht werden.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Nach Aufstellung des Jahresförderprogramms durch das Bayerische Staatsministerium für Familie, Arbeit und Soziales und das Bayerische Staatsministerium für Wohnen, Bau und Verkehr werden die Träger der eingeplanten Projekte von den Bewilligungsstellen zur Antragstellung aufgefordert.&amp;nbsp;Darlehenszusage und Bewilligungsbescheid werden anschließend von der für die Darlehensverwaltung zuständigen Bayerischen Landesbodenkreditanstalt dem Projektträger zugesandt.&amp;nbsp;Die Auszahlung erfolgt nach Baufortschritt und ist bei der Bewilligungsstelle zu beantragen.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Die Fördermittel sind bei den Regierungen, der Landeshauptstadt München sowie den Städten Augsburg und Nürnberg zu beantragen. Diese Stellen informieren auch über den weiteren Verfahrensablauf.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Nachweise zum Grundstück</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Nachweise über Fremd- und Eigenmittel</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Bautechnische Unterlagen zum Bauvorhaben</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;verwaltungsgerichtliche Klage&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
