                                                                                                                                                             "ja" ];
                                                                                                                                           xyz:bearbeitungsdauer        [ xyz:bewilligung  [ xyz:dauerSpanne  [ xyz:maxDauer  [ xyz:wochen  "4" ];
                                                                                                                                                                                                                xyz:minDauer  [ xyz:wochen  "2" ]
                                                                                                                                                                                                              ]
