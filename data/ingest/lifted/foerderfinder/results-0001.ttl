                                                                                                                                           xyz:erforderlicheUnterlagen  [ xyz:dokument  [ rdf:_1  [ xyz:bezeichnung   "Berufsausbildungsvertrag";
                                                                                                                                                                                                    xyz:erlaeuterung  "Berufsausbildungsvertrag (Teilzeit) mit Eintragungsvermerk der zuständigen Kammer."
                                                                                                                                                                                                  ];
                                                                                                                                                                                          rdf:_2  [ xyz:bezeichnung   "Erklärung der oder des Auszubildenden";
