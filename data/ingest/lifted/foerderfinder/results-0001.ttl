                                xyz:xml   "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           produkt=\"Förderfinder\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produktversion=\"\"\n                                           standard=\"XFLB\"\n                                           test=\"\"\n                                           version=\"2.0.0\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0 xflb.xsd\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>c942d7d4-9b35-4476-ba45-fd1cee546ab6</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-09-24T06:58:14</xflb:erstellungszeitpunkt>\n      <xflb:sender>Förderfinder Suche (Bayern)</xflb:sender>\n      <xflb:empfaenger>XFLB-Connect (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>c942d7d4-9b35-4476-ba45-fd1cee546ab6</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>c942d7d4-9b35-4476-ba45-fd1cee546ab6</xflb:schluessel>\n         <xflb:versionFLB>3</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>c942d7d4-9b35-4476-ba45-fd1cee546ab6</xflb:foerderschluessel>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n                  <xflb:flbVersion>3</xflb:flbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99148178017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"1\">\n                        <code>4</code>\n                        <name>Regelungskompetenz auf Landesebene</name>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Familienpflege; Beantragung einer Förderung</xflb:titel>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.stmgp.bayern.de/service/foerderprogramme/foerderprogramm-bayerisches-netzwerk-pflege-und-richtlinie-netzwerk-pflege-familienpflegefachstellen-pflegende-angehoerige/</xflb:link>\n                     <xflb:bezeichnung>\"Bayerisches Netzwerk Pflege\" - Förderung der Familienpflege, Angehörigenarbeit / Fachstellen für pflegende Angehörige und Pflegestützpunkte</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>https://www.lfp.bayern.de/familienpflege/</xflb:link>\n                     <xflb:bezeichnung>Familienpflege</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>https://www.familienland.bayern.de/</xflb:link>\n                     <xflb:bezeichnung>Familienland Bayern</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:beschreibung>\n                  <xflb:teaser>Die Familienpflege trägt dazu bei, Familien in besonderen Not- und\nKrisensituationen zu stützen und die Fremdunterbringung von Kindern zu\nvermeiden. Die Träger von Familienpflegestationen können eine Zuwendung im\nRahmen einer Projektförderung erhalten.</xflb:teaser>\n                  <xflb:zuwendungszweck>Zweck der Förderung ist es, die Weiterführung der Familienpflegestationen zu\nerleichtern und ein flächendeckendes Angebot an qualifizierten Fachkräften\nauch durch verbindliche Formen der Zusammenarbeit sicherzustellen.</xflb:zuwendungszweck>\n               </xflb:beschreibung>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Landesamt für Pflege</xflb:name>\n                  <xflb:telefonnummer>+49 9621 9669-0</xflb:telefonnummer>\n                  <xflb:email>poststelle@lfp.bayern.de</xflb:email>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n                  <xflb:adresse>\n                     <xflb:strasse>Mildred-Scheel-Straße</xflb:strasse>\n                     <xflb:hausnummerPostfach>4</xflb:hausnummerPostfach>\n                     <xflb:postleitzahl>92224</xflb:postleitzahl>\n                     <xflb:ort>Amberg</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:verweis>\n                     <xflb:link>www.lfp.bayern.de</xflb:link>\n                     <xflb:bezeichnung>Bayerisches Landesamt für Pflege</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Bayerisches Landesamt für Pflege</xflb:name>\n                        <xflb:telefonnummer>+49 9621 9669-0</xflb:telefonnummer>\n                        <xflb:email>poststelle@lfp.bayern.de</xflb:email>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                        <xflb:adresse>\n                           <xflb:strasse>Mildred-Scheel-Straße</xflb:strasse>\n                           <xflb:hausnummerPostfach>4</xflb:hausnummerPostfach>\n                           <xflb:postleitzahl>92224</xflb:postleitzahl>\n                           <xflb:ort>Amberg</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:verweis>\n                           <xflb:link>www.lfp.bayern.de</xflb:link>\n                           <xflb:bezeichnung>Bayerisches Landesamt für Pflege</xflb:bezeichnung>\n                        </xflb:verweis>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>Die einzelnen Voraussetzungen für die Förderung einer Familienpflegestation\nsind in Abschnitt I. 1. der Richtlinie für die Förderung im \"Bayerischen\nNetzwerk Pflege\" geregelt.  \nInsbesondere muss die Fachkraft eine Ausbildung als staatlich anerkannte\nFamilienpflegerin bzw. als staatlich anerkannter Familienpfleger oder als\nstaatlich anerkannte Dorfhelferin bzw. staatlich anerkannter Dorfhelfer, als\nSozialpädagogin beziehungsweise Sozialpädagoge, als Pflegefachfrau\nbeziehungsweise Pflegefachmann nach dem Pflegeberufegesetz, die Weiterbildung\nzur Fachkraft für familienunterstützende Haushaltsführung oder eine\nvergleichbare Qualifikation abgeschlossen haben.</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name>Bayern</name>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Gesundheit, Pflege und Prävention</xflb:verantwortlichesMinisterium>\n               <xflb:ablaufdatumRichtlinie>2025-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:verantwortlichesFachreferat>Referat 42</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Familienpflege; Beantragung einer Förderung</xflb:programmtitel>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVwV294809</xflb:link>\n                     <xflb:bezeichnung>Richtlinie für die Förderung im \"Bayerischen Netzwerk Pflege\"</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.lfp.bayern.de/familienpflege/</xflb:linkZurAntragsstellung>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Erklärung zum Antrag auf Gewährung einer Förderung als  DAWI-De-minimis-Beihilfe</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Subventionserhebliche Tatsachen im Rahmen des Zuwendungsverfahrens</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>Der Antrag ist schriftlich oder elektronisch beim Bayerischen Landesamt für Pflege zu stellen.</xflb:bewilligung>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>Die Zustimmung zum vorzeitigen Maßnahmebeginn gilt mit der Antragstellung allgemein als erteilt.</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n            </xflb:antragsinformationen>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>Gegenstand der Förderung sind die Ausgaben der Familienpflegestationen für die\nFamilienpflege. Die qualifizierte Fachkraft übernimmt die Betreuung und die\nErziehung der Kinder sowie die Versorgung des Haushalts.</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:finanzierung>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die staatliche Zuwendung wird als Festbetragsfinanzierung im Rahmen einer Projektförderung gewährt. Die mögliche Förderpauschale orientiert sich an der in der Familienpflegestation beschäftigten, berücksichtigungsfähigen Fachkraft. Für eine bedarfsgerechte, vollzeitbeschäftigte Fachkraft beträgt die Pauschale jährlich bis zu 9.000,00 Euro.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>Personal- und Sachausgaben der Familienpflegestation.</xflb:zuwendungsfaehigeKosten>\n               <xflb:euBeihilferelevanz>Die Prüfung der Freistellung der Fördermaßnahme von der Anmeldepflicht bei der EU-Kommission erfolgt im Rahmen der Antragsbearbeitung durch die Bewilligungsbehörde.</xflb:euBeihilferelevanz>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:zuwendungsart>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerFest>\n                        <xflb:jahre>1</xflb:jahre>\n                     </xflb:dauerFest>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name>Stiftungen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name>Verbände</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name>Vereine</name>\n               </xflb:foerdernehmende>\n            </xflb:foerdernehmende>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-09-24T06:58:14</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>\n"
                              ]
            ];
  rdf:_38   [ xyz:attributes  [ xyz:antragsstellung      "http://www.zbfs.bayern.de/foerderung/behinderte-menschen/behindertensport/index.php";
                                xyz:begriffeImKontext    [ rdf:_1  "Behindertensport";
                                                           rdf:_2  "Sport für Menschen mit Behinderung";
                                                           rdf:_3  "Sportmaßnahmen für Behindertengruppen"
                                                         ];
                                xyz:beschreibung         "<p>Der Sport ist für die Teilhabe von Menschen mit Behinderung wegen seines Gesundheitswertes, seiner sozialen Funktion und als Teil der Freizeitgestaltung von besonderer Bedeutung. Die Förderung soll die Durchführung von Übungsveranstaltungen im Breitensport für Menschen mit Behinderung ermöglichen und die aktive Teilnahme von Menschen mit Schwerbehinderung an überregionalen Sportveranstaltungen für Menschen mit Behinderung unterstützen.</p>\n<p>Die Förderung erfolgt ohne Rechtsanspruch im Rahmen der verfügbaren Haushaltsmittel.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Gesundheit und Soziales" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Verbände" ];
                                xyz:foerderprogramm      "Sport für Menschen mit Behinderung; Beantragung einer Förderung für Maßnahmen";
                                xyz:foerderzeitraum.bis  "2029-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2026-01-01T00:00:00.000+00:00";
