                                                                                                                                           xyz:beschreibung       [ xyz:schluesselwoerter  "Tierheime";
                                                                                                                                                                    xyz:teaser             "Der Freistaat Bayern fördert Bau- und Sanierungsvorhaben in und an Tierheimen, Ausgaben im Zusammenhang mit der Vermittlung von Heimtieren an Privathaushalte durch Tierheime und Vorhaben zur Eindämmung der Anzahl herrenloser Hauskatzen.";
                                                                                                                                                                    xyz:zuwendungszweck    "<p>Zweck der Zuwendungen ist die Förderung von</p><ul><li class=\"unordered-list-item--dash\">Investitionen für Bau- und Sanierungsvorhaben in und an Tierheimen,</li><li class=\"unordered-list-item--dash\">Ausgaben für Ausrüstung und Ausstattung von Tierheimen mit Geräten und Materialien, die für den ordnungsgemäßen Betrieb erforderlich sind,</li><li class=\"unordered-list-item--dash\">Ausgaben im Zusammenhang mit der Vermittlung von Heimtieren an Privathaushalte durch Tierheime und</li><li class=\"unordered-list-item--dash\">Vorhaben zur Eindämmung der Anzahl herrenloser Hauskatzen.</li></ul>"
                                                                                                                                                                  ];
                                                                                                                                           xyz:formulare          [ xyz:formular  [ rdf:_1  [ xyz:beschreibung  "<p>Für Investitionen für Bau- und Sanierungsvorhaben in und an Tierheimen (Nr. 2.1 FöR-TH)</p>";
                                                                                                                                                                                              xyz:bezeichnung   "Antrag auf Gewährung einer Zuwendung nach der Förderrichtlinie Tierheime - FöR-TH nach Nr. 2.1 - Förderantrag A für Bauvorhaben";
