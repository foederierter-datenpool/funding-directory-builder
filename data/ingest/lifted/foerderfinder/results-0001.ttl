                                                                                                                                           xyz:linkZurAntragsstellung   "https://www.lfp.bayern.de/wp-content/uploads/2026/02/Antragsformular_Phase_1.pdf";
                                                                                                                                           xyz:rechtsbehelf             "<p>verwaltungsgerichtliche Klage</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<p>Der Förderantrag ist unterzeichnet und digital (einschließlich sämtlicher Anlagen zur Phase 1) beim Bayerischen Landesamt für Pflege einzureichen. Lediglich Pläne sind im Original vorzulegen. Über alle innerhalb der Frist eingegangenen Anträge wird nach pflichtgemäßem Ermessen und im Rahmen der zu Verfügung stehenden Haushaltsmittel entschieden. Bei Dauerpflegeeinrichtungen wird ein zweistufiges Auswahlverfahren durchgeführt. Sollten Sie mit Ihrem Vorhaben in die engere Wahl für eine Zuwendung kommen, sind im zweiten Schritt des Verfahrens weitere Unterlagen vorzulegen. Hierfür erhalten Sie eine gesonderte Aufforderung.</p>";
                                                                                                                                                                          xyz:erlaeuterungVorzeitigerMassnahmebeginn
                                                                                                                                                                                  "<p>Einen ggf. notwendigen vorzeitigen Maßnahmebeginn beantragen Sie bitte mit entsprechender Begründung beim Landesamt für Pflege.</p>";
                                                                                                                                                                          xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "002";
                                                                                                                                                                                                            xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
                                                                                                                                                                                                            xyz:listVersionID  "1"
                                                                                                                                                                                                          ]
                                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:finanzierungsartUndHoehe  "<p>Die Höhe der Zuwendung beträgt bis zu 40.000 Euro pro neu geschaffenem Pflegeplatz in einer vollstationären Dauerpflegeeinrichtung (ohne Öffnung in den sozialen Nahraum).</p><p>Bei neu geschaffenen Pflegeplätzen handelt es sich um eine Festbetragsfinanzierung.</p><p>Umbau- und Modernisierungsmaßnahmen werden durch eine Anteilsfinanzierung mit bis zu 40 Prozent der zuwendungsfähigen Ausgaben gefördert, höchstens 40.000 Euro pro Dauerpflegeplatz. Bei Umbau- und Modernisierungsmaßnahmen von Dauerpflegeplätzen in Einrichtungen, die sich in den sozialen Nahraum öffnen, beträgt die Zuwendung im Rahmen einer Anteilsfinanzierung bis zu 60 Prozent der zuwendungsfähigen Ausgaben, höchstens 60.000 Euro pro Dauerpflegeplatz. Umbau- und Modernisierungsmaßnahmen können nur gefördert werden, wenn nachgewiesen wird, dass ansonsten der Pflegeplatz ersatzlos wegfallen würde.</p><p>Insgesamt können maximal bis zu 90 Prozent der zuwendungsfähigen Ausgaben aus Zuwendungen oder sonstigen</p><p>Drittmitteln finanziert werden. Der Zuwendungsempfänger muss einen Eigenanteil von mindestens 10 Prozent der zuwendungsfähigen Gesamtausgaben erbringen.</p>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "001";
                                                                                                                                                                                                    xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
                                                                                                                                                                                                    xyz:listVersionID  "1";
                                                                                                                                                                                                    xyz:name           ""
                                                                                                                                                                                                  ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:laufzeitFinanzierung      [ xyz:laufzeitFinanzierung  [ xyz:code           "001";
                                                                                                                                                                                                       xyz:listURI        "urn:xoev-de:stmd:codeliste:laufzeit-finanzierung";
                                                                                                                                                                                                       xyz:listVersionID  "1";
                                                                                                                                                                                                       xyz:name           "Gesamte Projektlaufzeit"
                                                                                                                                                                                                     ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Gefördert werden die Schaffung, der Ersatzneubau, der Umbau und die Modernisierung von Pflegeplätzen. </p><p>Zuwendungsfähig sind betriebsnotwendige Ausgaben der DIN 276 entsprechenden Kostengruppen 300 Bauwerk - Baukonstruktionen und 400 Bauerwerk - Technische Anlagen. Dabei dienen die jeweils aktuellsten Kostenkennwerte des Baukosteninformationszentrums Deutscher Architektenkammern GmbH als Orientierungswerte zur Beurteilung der Wirtschaftlichkeit der beantragten Baukosten. Beim Kauf von Bestandsgebäuden sind der Kaufpreis für die betriebsnotwendigen Gebäudeteile im Pflegebereich abzüglich des Grundstückspreises plus weiter anfallende Baukosten der genannten Kostengruppen 300 und 400 zuwendungsfähig, sofern diese einem angemessenen Ausstattungsstandard entsprechen.</p>"
                                                                                                                                         ];
