                                                                                                                                                                                      "Landesamt für Pflege" ]
                                                                                                                                                                  ]
                                                                                                                                         ];
                                                                                                             xyz:antragsinformationen    [ xyz:antragsfrist             [ xyz:bemerkung             "Der Antrag ist bis spätestens 30. Juni eines Jahres für das laufende Kalenderjahr zu stellen. Mit dem Auszahlungsantrag ist die Verwendungsbestätigung für die Zuwendung des vergangenen Kalenderjahres einzureichen. Beim Hebammenbonus handelt es sich um eine Zuwendung des Freistaats Bayern und wird im Rahmen der verfügbaren Haushaltsmittel gewährt. Grundsätzlich wurden genügend Mittel vom Landtag bereitgestellt, um allen fristgerecht eingereichten Anträgen entsprechen zu können. Es ist jedoch nicht gänzlich auszuschließen, dass die eingehenden Anträge die bereitgestellten Mittel übersteigen. In solchen Fällen ist für die Gewährung des Bonus der Zeitpunkt des Eingangs des vollständigen Antrags maßgeblich. Wir empfehlen daher eine zeitnahe Beantragung des Bonus.";
                                                                                                                                                                          xyz:zeitlicheEingrenzung  [ xyz:fristdatum
                                                                                                                                                                                            "2027-06-30" ]
                                                                                                                                                                        ];
                                                                                                                                           xyz:beantragungskosten       [ xyz:kostenlos
                                                                                                                                                             "ja" ];
                                                                                                                                           xyz:erforderlicheUnterlagen  [ xyz:dokument  [ rdf:_1  [ xyz:bezeichnung   "Identitätsnachweis";
                                                                                                                                                                                                    xyz:erlaeuterung  "Bei einem Folgeantrag kann auf diesen Nachweis verzichtet werden."
                                                                                                                                                                                                  ];
                                                                                                                                                                                          rdf:_2  [ xyz:bezeichnung   "Nachweis über die Erlaubnis nach § 5 des Hebammengesetzes";
                                                                                                                                                                                                    xyz:erlaeuterung  "Erlaubnis zum Führen der Berufsbezeichnung \"Hebamme\". Bei einem Folgeantrag kann auf diesen Nachweis verzichtet werden."
                                                                                                                                                                                                  ];
                                                                                                                                                                                          rdf:_3  [ xyz:bezeichnung   "Nachweis über eine freiberufliche geburtshilfliche Tätigkeit in Bayern";
                                                                                                                                                                                                    xyz:erlaeuterung  "durch  a) Nachweis des persönlichen Institutionskennzeichens (IK) nach § 293 des Fünften Buches Sozialgesetzbuch (SGB V) oder b) Nachweis der Anmeldung beim zuständigen Gesundheitsamt nach Art. 10 des Gesundheitsdienstgesetzes (GDG)"
                                                                                                                                                                                                  ];
                                                                                                                                                                                          rdf:_4  [ xyz:bezeichnung   "ein Nachweis über die Betreuung von mindestens vier Geburten in Bayern in dem der Antragstellung vorangehenden Kalenderjahr oder mindestens eine Geburt pro Quartal";
                                                                                                                                                                                                    xyz:erlaeuterung  "durch a) Nachweis über die Gewährung des Sicherstellungszuschlags nach dem Vertrag gemäß § 134a SGB V oder\nb) Nachweis über abgerechnete geburtshilfliche Leistungen jeweils durch schriftlichen Behandlungsvertrag\nc) anonymisierte Abrechnungen mit der Gesetzlichen Krankenversicherung"
                                                                                                                                                                                                  ];
                                                                                                                                                                                          rdf:_5  [ xyz:bezeichnung   "De-minimis-Erklärung";
                                                                                                                                                                                                    xyz:erlaeuterung  "Der Hebammenbonus fällt unter die sog. De-minimis-Beihilfen im Sinne der Verordnung EU Nr. 2023 2831 der Kommission vom 13.12.2023. Unter De minimis Beihilfen sind Zuwendungen bis zu einem Beihilfebetrag bzw. Subventionswert von 300.000 EUR innerhalb von drei Jahren zu verstehen, die bei der Europäischen Kommission nicht zur Genehmigung angemeldet werden müssen.\nSofern Sie weitere staatliche Förderungen erhalten haben oder Ihnen im Zuge Ihrer freiberuflichen Tätigkeit in der Geburtshilfe bereits Förderungen bewilligt wurden und noch ausgezahlt werden, bitten wir Sie, diese in der De-minimis-Erklärung anzugeben z. B. Zuwendung aus dem Geburtshilfeförderprogramm, Niederlassungsprämie."
                                                                                                                                                                                                  ];
                                                                                                                                                                                          rdf:_6  [ xyz:bezeichnung   "Erklärung zu subventionserheblichen Tatsachen";
                                                                                                                                                                                                    xyz:erlaeuterung  "Subventionen im Sinne des § 264 Abs. 8 StGB sind Leistungen aus öffentlichen Mitteln nach Bundes-oder Landesrecht an Betriebe bzw. Unternehmen, die wenigstens zum Teil ohne marktmäßige Gegenleistungen gewährt werden und der Förderung der Wirtschaft dienen sollen oder Leistungen aus öffentlichen Mitteln nach dem Recht der Europäischen Union, die wenigstens zum Teil ohne marktmäßige Gegenleistung gewährt werden. Als subventionserheblich gelten gemäß § 264 StGB Tatsachen, die für die Gewährung bzw. Rückforderung der Hebammenniederlassungsprämie von Bedeutung sind. Hierunter fallen insbesondere die Angaben:\n- über den/die AntragsstellerIn,\n- zur Tätigkeit in der Hebammenhilfe und den weiteren Voraussetzungen für die Gewährung der Niederlassungsprämie für Hebammen,\n- im Antrag und den beizufügenden Unterlagen wie bspw. Identitätsnachweis, Erlaubnis nach dem Hebammengesetz, Anmeldung Gesundheitsamt, De-minimis-Erklärung sowie Subventionserklärung\n\nVorsätzlich oder leichtfertig gemachte unrichtige oder unvollständige Angaben sowie das vorsätzliche oder leichtfertige Unterlassen einer Mitteilung über Änderungen der in Stand 12 2023 diesen Angaben enthaltenen Tatsachen begründen Strafbarkeit; Subventionsbetrug, § 264 StGB. Ebenfalls strafbar ist das vorsätzliche Vorlegen einer durch unrichtige oder unvollständige Angaben über die Subventionsberechtigung oder über subventionserhebliche Tatsachen erlangten Bescheinigung. Mit Unterschrift der Erklärung über subventionserhebliche Tatsachen versichern Sie die Richtigkeit und Vollständigkeit der im Antrag und in den Anlagen gemachten Angaben."
                                                                                                                                                                                                  ];
                                                                                                                                                                                          rdf:_7  [ xyz:bezeichnung  "eine Erklärung, dass im Kalenderjahr der Antragstellung voraussichtlich mindestens vier Geburten in Bayern verantwortlich betreut werden" ];
                                                                                                                                                                                          rdf:_8  [ xyz:bezeichnung  "eine Erklärung, dass entsprechende Ausgaben in Höhe von mindestens 1 500 Euro im laufenden Kalenderjahr entstehen werden" ];
                                                                                                                                                                                          rdf:_9  [ xyz:bezeichnung   "eine Erklärung gemäß Nr. 5 Buchst. a, c und d des Musters 4a zu Art. 44 BayHO sowie eine Erklärung, dass entsprechende Ausgaben in Höhe von mindestens 1 500 Euro im letzten Kalenderjahr entstanden sind";
                                                                                                                                                                                                    xyz:erlaeuterung  "Das Muster 4a zu Art. 44 BayHO ist die Verwendungsbestätigung für die im letzten Kalenderjahr entstandenen Kosten."
                                                                                                                                                                                                  ]
                                                                                                                                                                                        ]
                                                                                                                                                                        ];
                                                                                                                                           xyz:linkZurAntragsstellung   "https://formularserver-bp.bayern.de/intelliform/forms/rzsued/stmgp/stmgp/hebammenbonus/index";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "Der Antrag ist bis spätestens 30.06. eines Jahres für das vorherige Jahr beim LfP einzureichen. Nach Prüfung des Antrags und ggf. Nachforderung von Unterlagen wird ein Bewilligungsbescheid erlassen und die Auszahlung veranlasst.";
