                                                                                                                                           xyz:weiterfuehrendeInformationen
                                                                                                                                                   [ xyz:verweis  [ xyz:bezeichnung  "Broschüre \"Zuwendungsrecht des Freistaats Bayern - Zusammenstellung aktueller Rechtsvorschriften\" (nur im Bayerischen Behördennetz aufrufbar)";
                                                                                                                                                                    xyz:link         "https://www.bjr.de/fileadmin/redaktion/4._Foerderung/Basisfoerderung/2025-01-01_Broschuere_Zuwendungsrecht_10._Auflage_2025.pdf"
