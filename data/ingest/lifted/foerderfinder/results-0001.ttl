                                                                                                                       xyz:programmtitel             "Hebammenniederlassungsprämie";
                                                                                                                       xyz:verantwortlichesFachreferat
                                                                                                                               "Referat 32";
                                                                                                                       xyz:verantwortlichesMinisterium
                                                                                                                               "Staatsministerium für Gesundheit, Pflege und Prävention"
                                                                                                                     ];
                                                                                                             xyz:foerdervoraussetzungen  [ xyz:ausschlusskriterien  "<p>Eine Förderung nach dieser Richtlinie ist ausgeschlossen, wenn die Hebamme für denselben Zweck Zahlungen aus anderen Mitteln des Freistaates Bayern, eines anderen Landes, des Bundes, der EU oder anderer ausländischer Staaten erhält.</p>";
                                                                                                                                           xyz:buergerfreundlicheBeschreibung
                                                                                                                                                   "<p>Sie müssen:</p><p>- im Besitz einer Erlaubnis zur Führung der Berufsbezeichnung nach § 5 des Hebammengesetzes sein,</p><p>- Ihre Niederlassung in Bayern nach dem 31.12.2023 begründen,</p><p>- die Gründung der Niederlassung beim zuständigen Gesundheitsamt angezeigt haben.</p><p>- sich mit Antragstellung bereiterklären, mindestens drei Jahre freiberuflich als Hebamme in Bayern tätig zu sein.</p><p>Im Fall der Wiederaufnahme der freiberuflichen Tätigkeit muss der Zeitraum zwischen der Beendigung und der Wiederanmeldung der Tätigkeit nach Art. 10 Abs. 3 des Gesundheitsdienstgesetzes (GDG) mindestens ein Jahr betragen.</p>"
                                                                                                                                         ];
