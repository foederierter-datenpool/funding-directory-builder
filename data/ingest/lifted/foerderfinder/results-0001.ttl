                                                         ];
                                xyz:beschreibung         "<p>Mit dem Förderprogramm Regionalkultur sollen in ganz Bayern heimatpflegerische Initiativen gefördert und das Heimat- und Traditionsbewusstsein gestärkt werden.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Kultur, Medien und Sport" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Kommunen";
                                                           rdf:_2  "Vereine";
                                                           rdf:_3  "Verbände";
                                                           rdf:_4  "Stiftungen";
                                                           rdf:_5  "Privatpersonen"
                                                         ];
                                xyz:foerderprogramm      "Förderprogramm Regionalkultur";
                                xyz:foerderzeitraum.bis  "2028-09-30T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2022-10-01T00:00:00.000+00:00";
                                xyz:schluessel           "2d5a0217-7873-46eb-85a5-0119536e738b";
                                xyz:teaser               "Der Freistaat Bayern fördert heimatpflegerische Initiativen und die Stärkung des Heimat- und Traditionsbewusstseins.";
                                xyz:titel                "Förderung innovativer Einzelveranstaltungen und Projekte im Bereich Heimatpflege";
                                xyz:titel.tokens         [ rdf:_1  "Förderung innovativer Einzelveranstaltungen und Projekte im Bereich Heimatpflege" ];
                                xyz:voraussetzung        "<ul><li class=\"unordered-list-item--dash\">Die Zuwendung beträgt mehr als 5.000 Euro.</li><li class=\"unordered-list-item--dash\">Für Kommunen gilt eine Mindestzuwendung von mehr als 10.000 Euro.</li><li class=\"unordered-list-item--dash\">Sie können nachweisen, dass Sie den erforderlichen Eigenanteil finanziell tragen können.</li><li class=\"unordered-list-item--dash\">Das Vorhaben hat einen überregionalen Wirkbereich.</li><li class=\"unordered-list-item--dash\">Der Eigenanteil beträgt mindestens 10 Prozent der zuwendungsfähigen Ausgaben.</li><li class=\"unordered-list-item--dash\">Das Vorhaben ist innovativ: Es enthält ein neuartiges, kreatives oder qualitativ deutlich vom üblichen Standard abweichendes Element.</li><li class=\"unordered-list-item--dash\">Bei wiederkehrenden Veranstaltungen oder Veranstaltungsreihen wird in der Regel nur eine Anschubfinanzierung für die erstmalige Durchführung oder eine Förderung von einmaligen Sonderveranstaltungen gewährt.</li></ul>"
                              ];
