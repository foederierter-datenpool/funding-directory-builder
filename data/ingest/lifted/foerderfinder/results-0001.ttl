                                                                                                                                           xyz:linkZurAntragsstellung   "https://formularserver.bayern.de/intelliform/forms/rzsued/zbfs/zbfs/leistungen_an_inklusionsbetriebe/index";
                                                                                                                                           xyz:rechtsbehelf             "<p>Sie können Widerspruch oder Klage gegen die Entscheidung einlegen.</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<p>Der Antrag ist schriftlich oder elektronisch bei der örtlich zuständigen Regionalstelle des Zentrums Bayern Familie und Soziales (ZBFS-Inklusionsamt) zu stellen.&nbsp;</p><p>Zur Prüfung der Zuständigkeit ist es möglich, dass das ZBFS-Inklusionsamt bei Leistungen für den besonderen Aufwand auch Rehabilitationsträger, beispielsweise die Agentur für Arbeit oder die Deutsche Rentenversicherung, kontaktiert.&nbsp;</p><p>Möglicherweise werden auch andere Stellen außerhalb des ZBFS, z. B. der Integrationsfachdienst, beauftragt, eine Stellungnahme bzw. ein Gutachten zu erstellen.</p><p>Für Ihre Planungen weisen wir darauf hin, dass unser Verwaltungsverfahren zur Gründung eines Inklusionsbetriebes unter Umständen einige Zeit in Anspruch nehmen kann. Bitte planen Sie dies bei Ihrer Antragstellung mit ein.</p>";
                                                                                                                                                                          xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "002";
                                                                                                                                                                                                            xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
                                                                                                                                                                                                            xyz:listVersionID  "1"
                                                                                                                                                                                                          ]
                                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:finanzierungsartUndHoehe  "<p>Im Rahmen der Investitionskosten können pro geschaffenen oder gesicherten Arbeitsplatz für die schwerbehinderten Arbeitnehmer (Zielgruppenmitarbeiter) bis zu 75.000 EUR geleistet werden. Der Lohnkostenzuschuss bezüglich der laufenden Kosten orientiert sich an den jeweiligen Bedarfen.</p>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "001";
                                                                                                                                                                                                    xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
                                                                                                                                                                                                    xyz:listVersionID  "1";
                                                                                                                                                                                                    xyz:name           ""
                                                                                                                                                                                                  ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Nach § 217 Abs. 1 SGB IX können Inklusionsbetriebe aus Mitteln der Ausgleichsabgabe Leistungen für Aufbau, Erweiterung, Modernisierung und Ausstattung einschließlich einer betriebswirtschaftlichen Beratung sowie für besonderen Aufwand einen Lohnkostenzuschuss erhalten.</p>"
                                                                                                                                         ];
