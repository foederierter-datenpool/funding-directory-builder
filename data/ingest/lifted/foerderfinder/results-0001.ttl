                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>5f8ac1eb-c2e4-4c92-9592-70604a062b68</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2026-01-14T11:34:50</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>5f8ac1eb-c2e4-4c92-9592-70604a062b68</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>5f8ac1eb-c2e4-4c92-9592-70604a062b68</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-08-14T07:56:27</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>5f8ac1eb-c2e4-4c92-9592-70604a062b68</xflb:foerderschluessel>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400240017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Förderung für regionale Offene Behindertenarbeit (OBA)</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Menschen mit Behinderung und ihre Angehörigen können sich in allen Fragen, die sich zu ihrer Behinderung ergeben, an einen Dienst der regionalen Offenen Behindertenarbeit (OBA) wenden. Der Freistaat Bayern und die bayerischen Bezirke Fördern zu diesem Zweck bayernweit entsprechende Angebote im Rahmen einer gemeinsamen Richtlinie. Ziel der Förderung ist es, niedrigschwellige ambulante Betreuung und Sicherung der Teilhabe von körperlich und geistig behinderten, sinnesbehinderten oder chronisch kranken Menschen, die zum Personenkreis von § 99 SGB IX gehören, durch Träger und deren leistungsfähige Dienste anzubieten, die Führung eines möglichst selbstständigen, eigenverantwortlichen Lebens zu unterstützen und die Familien mit behinderten Angehörigen zu entlasten. Die Dienste fungieren zudem als Anlaufstelle für die Vermittlung in Angebote des Sozialraums (Lotsenfunktion). Die Förderung erfolgt mit dem Ziel, einer bayernweit flächendeckenden Beratung und Unterstützung.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern und die bayerischen Bezirke gewähren Zuwendungen für Maßnahmen der ambulanten Hilfen im Bereich der regionalen Offenen Behindertenarbeit.</xflb:teaser>\n                  <xflb:schluesselwoerter>Beratungsstelle, Behinderung, Familie, Angehörige</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:alternativeFoerdermoeglichkeiten>\n                  <xflb:alternativeFoerdermoeglichkeit>\n                     <xflb:beschreibung>EUTB (Ergänzende unabhängige Teilhabeberatung)\n-Leistung des Bundes-\n\nDas Bundesteilhabegesetz (BTHG) sieht vor, auf der Grundlage des neuen § 32 Neuntes Buch Sozialgesetzbuch (SGB IX), eine ergänzende unabhängige Teilhabeberatung zu fördern. Mit der Förderung wurde aufbauend auf bestehenden Strukturen ein niedrigschwelliges, flächendeckendes und nach bundeseinheitlichen Qualitätsstandards arbeitendes Beratungsangebot etabliert. Dieses Angebot steht Menschen mit Behinderung und von Behinderung bedrohten Menschen im Vorfeld der Beantragung von Leistungen zur Stärkung ihrer Teilhabe und Selbstbestimmung und insbesondere ihrer Position im Verhältnis zu den Rehabilitationsträgern und Leistungserbringern zur Verfügung.\n\nEin wesentliches Merkmal der Beratungsangebote soll so weit wie möglich die Etablierung einer Peer-Beratung sein, also die Beratung durch Betroffene. Die neuen Angebote sollen zudem unabhängig von Leistungsträgern und Leistungserbringern organisiert sein.</xflb:beschreibung>\n                     <xflb:verweis>\n                        <xflb:bezeichnung>EUTB (Ergänzende unabhängige Teilhabeberatung)</xflb:bezeichnung>\n                        <xflb:link>https://www.teilhabeberatung.de/</xflb:link>\n                     </xflb:verweis>\n                  </xflb:alternativeFoerdermoeglichkeit>\n                  <xflb:alternativeFoerdermoeglichkeit>\n                     <xflb:beschreibung>Der Freistaat Bayern und die bayerischen Bezirke gewähren Zuwendungen für Maßnahmen der ambulanten Hilfen im Bereich der regionalen Offenen Behindertenarbeit.</xflb:beschreibung>\n                     <xflb:verweis>\n                        <xflb:bezeichnung>Regionale Offene Behindertenarbeit; Beantragung einer Förderung</xflb:bezeichnung>\n                        <xflb:link>https://www.bayernportal.de/dokumente/leistung/807630563778</xflb:link>\n                     </xflb:verweis>\n                  </xflb:alternativeFoerdermoeglichkeit>\n               </xflb:alternativeFoerdermoeglichkeiten>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Link zur Freien Wolfahrtspflege Bayern</xflb:bezeichnung>\n                     <xflb:link>https://www.freie-wohlfahrtspflege-bayern.de/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Link zum Lebenshilfe für Menschen mit geistiger Behinderung - Landesverband Bayern</xflb:bezeichnung>\n                     <xflb:link>https://www.lebenshilfe-bayern.de</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Link zur Ermittlung des örtlich zuständigen Bezirks</xflb:bezeichnung>\n                     <xflb:link>https://www.bay-bezirke.de/die-sieben-bezirke.html</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Referat II4 Bayerisches Staatsministerium für Familie, Arbeit und Soziales</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>9</xflb:hausnummerPostfach>\n                     <xflb:strasse>Winzererstr.</xflb:strasse>\n                     <xflb:postleitzahl>80797</xflb:postleitzahl>\n                     <xflb:ort>München</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>Referat-II4@stmas.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Bayerisches Staatsministerium für Familie, Arbeit und Soziales/OBA</xflb:bezeichnung>\n                     <xflb:link>https://www.stmas.bayern.de/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>089/1261-1078</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Referat II4 Bayerisches Staatsministerium für Familie, Arbeit und Soziales</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>9</xflb:hausnummerPostfach>\n                           <xflb:strasse>Winzererstr.</xflb:strasse>\n                           <xflb:postleitzahl>80797</xflb:postleitzahl>\n                           <xflb:ort>München</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>Referat-II4@stmas.bayern.de</xflb:email>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Bayerisches Staatsministerium für Familie, Arbeit und Soziales</xflb:bezeichnung>\n                           <xflb:link>https://www.stmas.bayern.de/</xflb:link>\n                        </xflb:verweis>\n                        <xflb:telefonnummer>089/1261-1078</xflb:telefonnummer>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>42e26287-c3cc-4b96-8850-b9f54c2d6922</xflb:id>\n                     <xflb:bezeichnung>Formloser Antrag (mit Unterschrift)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/formloseSchreibenmitUnterschrift/index</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Spitzenverbände der freien Wohlfahrtspflege sowie die sonstigen auf Landesebene in Bayern wirkenden, rechtsfähigen und gemeinnützigen Verbände und die diesen Verbänden angeschlossenen Vereinigungen, die Menschen mit Behinderungen und deren Belange vertreten  sowie sonstige Träger der Offenen Behindertenarbeit, soweit sie keinem Spitzenverband der freien Wohlfahrtspflege oder Landesverband angeschlossen sind.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Zuwendung wird als Festbetragsfinanzierung (Förderpauschale) im Wege einer Projektförderung gewährt. Die jährliche Förderpauschale des Freistaats Bayern beträgt für Fachkräfte bis zu 28.800 Euro und für sonstige Fachkräfte bis zu 22.700 Euro.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Die Träger übernehmen mittels ihrer Dienste in ihrem Einzugsbereich folgende Aufgaben:&amp;nbsp;&lt;/p&gt;&lt;ol&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;allgemeine trägerneutrale Beratung, insbesondere über Angebote im Sozialraum gegebenenfalls Weitervermittlung zu anderen Akteuren im Sozialraum (Lotsenfunktion);&amp;nbsp;&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;Organisation und Sicherstellung von Freizeit-, Bildungs- und Begegnungsmaßnahmen;&amp;nbsp;&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;Durchführung von Freizeit-, Bildungs- und Begegnungsmaßnahmen, soweit nicht von der Richtlinie der Bayerischen Bezirke zur Förderung von Maßnahmen zur Teilhabe von Menschen mit Behinderungen (Freizeit-, Bildungs- und Begegnungsmaßnahmen) vom 17. März 2017 abgedeckt;&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;Organisation und Sicherstellung des Familienentlastenden Dienstes/Familienunterstützenden Dienstes;&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;Durchführung von Maßnahmen der Familienentlastenden Dienste/Familienunterstützenden Dienste;&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;&amp;nbsp;Öffentlichkeitsarbeit;&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;Gewinnung, Schulung und Koordination von ehrenamtlichen Mitarbeiterinnen und Mitarbeitern;&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;Einbindung in bestehende Netzwerke (innerhalb und außerhalb der Behindertenhilfe)&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;&amp;nbsp;fachliche Leitung des Dienstes sowie Anleitung und Betreuung des sonstigen Personals des Dienstes und der ehrenamtlichen Mitarbeiterinnen und Mitarbeiter, einschließlich deren Einarbeitung und Fortbildung.&lt;/li&gt;&lt;/ol&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n               <xflb:euBeihilferelevanz>Die Fördermaßnahme hat keine Auswirkungen auf den Handel zwischen \nden EU-Mitgliedstaaten</xflb:euBeihilferelevanz>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Familie, Arbeit und Soziales</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinie zur Förderung von regionalen ambulanten Diensten zur Sicherung der Teilhabe von Menschen mit geistigen und/oder körperlichen Behinderungen sowie sinnesbehinderten und chronisch kranken Menschen</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_8113_1_A_15287?hl=true</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>II4</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Regionale Offene Behindertenarbeit; Beantragung einer Förderung</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2026-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2026-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2026-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n               <xflb:euPublizitaetspflicht>https://www.gesetze-bayern.de/Content/Document/BayVV_8113_1_A_15287?hl=true</xflb:euPublizitaetspflicht>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Förderung von Beratungsangeboten für Menschen mit Behinderung und ihre Angehörigen in Bayern&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Eines der wichtigsten sozialpolitischen Anliegen ist es, Menschen mit Behinderung eine gleichberechtigte Teilhabe am Leben und ein selbstbestimmtes Leben zu ermöglichen. Dazu tragen insbesondere die Dienste der Offenen Behindertenarbeit mit bei. &lt;/p&gt;&lt;p&gt;Im Rahmen des Beratungsangebots sind diese Dienste Anlaufstelle zu sämtlichen Fragen rund um die Behinderung für Menschen mit Behinderung aller Behinderungsarten und ihrer Angehörigen.&lt;/p&gt;&lt;p&gt;Auf der Grundlage bayernweit gültiger Förderrichtlinien wurden in Bayern einheitliche Strukturen geschaffen. In jedem Landkreis und jeder kreisfreien Stadt wurde im regionalen Bereich ein Personalschlüssel von 1 : 50.000 (1 Fachkraft zu 50.000 Einwohner) umgesetzt.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Die Anerkennung eines neuen Angebots kann nur erfolgen, soweit der Fachkraftschlüssel von 1 Fachkraft zu 50.000 Einwohnern nicht ausgeschöpft ist. Dies ist aber grundsätzlich in allen Regionen Bayerns der Fall.&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/formloseSchreibenmitUnterschrift/index</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Über die fachliche, personelle und organisatorische Konzeption sowie die&lt;/p&gt;&lt;p&gt;Finanzierung des Dienstes ist zwischen dem Träger, seinem Spitzenverband bzw.&lt;/p&gt;&lt;p&gt;Landesverband, dem jeweiligen Bezirk sowie dem Freistaat Bayern Einvernehmen&lt;/p&gt;&lt;p&gt;herbeizuführen.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Dem Zentrum Bayern Familie und Soziales (ZBFS) als staatliche&lt;/p&gt;&lt;p&gt;Bewilligungsstelle sowie dem zuständigen Bezirk ist jeweils ein formgerechter&lt;/p&gt;&lt;p&gt;Antrag vorzulegen.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Den Anträgen sind ein Finanzierungsplan für den beantragten Förderzeitraum,&lt;/p&gt;&lt;p&gt;Übersichten über die förderfähigen Kräfte sowie bei Erstanträgen eine&lt;/p&gt;&lt;p&gt;Konzeption und eine fachliche Stellungnahme des Spitzenverbands bzw.&lt;/p&gt;&lt;p&gt;Landesverbands beizufügen.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Der Bewilligungszeitraum ist das Kalenderjahr.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Für die Förderung ist der Bezirk zuständig, in dessen Bereich der Dienst seine&lt;/p&gt;&lt;p&gt;Tätigkeit ausübt.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Formulare sind im jeweiligen Spitzenverband bzw. Landesverband verfügbar.&lt;/p&gt;</xflb:bewilligung>\n               </xflb:verfahrensablauf>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:sonstige>ja</xflb:sonstige>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Antragstellung: Erstanträge und Stellenerweiterungsanträge bis 31. März des Vorjahres - laufende Projekte bis 15. November des Vorjahres.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Finanzierungsplan für den beantragten Förderzeitraum</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Bei Erstantragstellung empfiehlt es sich an den zuständigen Spitzenverband oder Landesverband oder an den örtlich zuständigen Bezirk zu wenden (siehe Links unter der Rubrik weiterführende Informationen).</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Übersichten über die förderfähigen Kräfte</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Konzeption des Spitzenverbandes oder Landesverbandes</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Ausschließlich bei Erstanträgen</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Fachliche Stellungnahme des Spitzenverbandes oder Landesverbandes</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Ausschließlich bei Erstanträgen</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Keine Angabe.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_85   [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/13/rmf_13-092/index";
                                xyz:begriffeImKontext    [ rdf:_1  "psychiatrische Versorgung";
                                                           rdf:_2  "Behindertenhilfe";
                                                           rdf:_3  "Fortbildung"
                                                         ];
                                xyz:beschreibung         "<p>Die Förderung dient der Vermittlung, Vertiefung und Weiterentwicklung spezifischer Fachkenntnisse von Personen, die in den Bereichen Behindertenhilfe und psychiatrische Versorgung tätig sind.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Gesundheit und Soziales" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Verbände" ];
                                xyz:foerderprogramm      "Fortbildung und Laienhelfer";
                                xyz:foerderzeitraum.bis  "2028-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2021-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "706d26bc-97fd-418a-977a-7dcc73bee32c";
                                xyz:teaser               "Sie können eine Förderung für Maßnahmen zur Fortbildung in den Bereichen Behindertenhilfe und psychiatrische Versorgung beantragen.";
                                xyz:titel                "Fortbildung der in den Bereichen Behindertenhilfe und psychiatrische Versorgung tätigen Personen";
                                xyz:titel.tokens         [ rdf:_1  "Fortbildung der in den Bereichen Behindertenhilfe und psychiatrische Versorgung tätigen Personen" ];
                                xyz:voraussetzung        "<p>Die Antragsteller legen eine Auflistung aller geplanten Fortbildungsmaßnahmen vor (Fortbildungsprogramm). Für jede Fortbildungsmaßnahme sind Konzeption und Ziel auszuweisen.</p><p>Maßnahmen mit weniger als acht Teilnehmerinnen und Teilnehmern werden grundsätzlich nicht gefördert.</p>"
                              ];
              xyz:id          "706d26bc-97fd-418a-977a-7dcc73bee32c";
              xyz:payload     [ xyz:json  [ xyz:anfrage            [ xyz:anfragenummer  "706d26bc-97fd-418a-977a-7dcc73bee32c";
                                                                     xyz:flb            [ xyz:konkreteFLB  [ xyz:allgemeineAngaben       [ xyz:beschreibung       [ xyz:schluesselwoerter  "psychiatrische Versorgung; Behindertenhilfe; Fortbildung";
                                                                                                                                                                    xyz:teaser             "Sie können eine Förderung für Maßnahmen zur Fortbildung in den Bereichen Behindertenhilfe und psychiatrische Versorgung beantragen.";
                                                                                                                                                                    xyz:zuwendungszweck    "<p>Die Förderung dient der Vermittlung, Vertiefung und Weiterentwicklung spezifischer Fachkenntnisse von Personen, die in den Bereichen Behindertenhilfe und psychiatrische Versorgung tätig sind.</p>"
                                                                                                                                                                  ];
                                                                                                                                           xyz:formulare          [ xyz:formular  [ rdf:_1  [ xyz:bezeichnung  "Zuwendungsgewährung für Schulungsmaßnahmen für Laienhelferinnen/ Laienhelfer von Maßnahmen und Einrichtungen zur Versorgung psychisch kranker und psychisch behinderter Menschen - Antrag";
                                                                                                                                                                                              xyz:id           "9ac0ceaf-b29f-496e-8c45-afccc94ad64a";
                                                                                                                                                                                              xyz:link         "https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/13/rmf_13-092/index"
                                                                                                                                                                                            ];
                                                                                                                                                                                    rdf:_2  [ xyz:bezeichnung  "Zuwendungsgewährung für Schulungsmaßnahmen für Laienhelferinnen/Laienhelfer von Maßnahmen und Einrichtungen zur Versorgung psychisch kranker und psychisch behinderter Menschen - Verwendungsnachweis";
                                                                                                                                                                                              xyz:id           "8416b2d1-9af6-4ce4-8490-e5c6472eff07";
