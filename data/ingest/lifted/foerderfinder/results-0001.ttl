                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>3599ebb4-1b5d-45ec-a612-f3a638e0110c</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2025-05-13T16:15:47</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>3599ebb4-1b5d-45ec-a612-f3a638e0110c</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>3599ebb4-1b5d-45ec-a612-f3a638e0110c</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2025-05-13T16:15:47</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>3599ebb4-1b5d-45ec-a612-f3a638e0110c</xflb:foerderschluessel>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>09999000000003</xflb:leikaSchluessel>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Impulsprogramm Volksmusik</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Die Förderung hat das Ziel, in ganz Bayern Menschen zu motivieren, Volksmusik kennen zu lernen und über einen längeren Zeitraum zu praktizieren. Dadurch sollen neue musikalische Initiativen und Gruppenbildungen angeregt, nachhaltig eingeführt und so das Bewusstsein für Volksmusik gestärkt werden.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Gefördert werden halbjährliche oder jährliche Kurse mit externen Referenten zur Vermittlung von Volksmusik in vielfältigen stilistischen und regionalen Ausprägungen.</xflb:teaser>\n                  <xflb:schluesselwoerter>Volksmusik, Seminare, Musik, Kurse, Impulsprogramm</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Impulsprogramm Volksmusik</xflb:bezeichnung>\n                     <xflb:link>https://www.stmfh.bayern.de/heimat/impulsprogramm/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Referentenpool Volksmusik und regionale Musik</xflb:bezeichnung>\n                     <xflb:link>https://www.heimat-bayern.de/volksmusik/referentenpool/</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Staatsministerium der Finanzen und für Heimat, Referat Heimatpflege</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>4</xflb:hausnummerPostfach>\n                     <xflb:strasse>Odeonsplatz</xflb:strasse>\n                     <xflb:postleitzahl>80539</xflb:postleitzahl>\n                     <xflb:ort>München</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>volksmusik@stmfh.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Heimat - Impulsprogramm Volksmusik</xflb:bezeichnung>\n                     <xflb:link>https://www.stmfh.bayern.de/heimat/impulsprogramm/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>08923063161</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Bayerisches Staatsministerium der Finanzen und für Heimat, Referat Heimatpflege</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:onlinedienste>\n                  <xflb:onlinedienst>\n                     <xflb:id>92111220-864e-430a-9cb2-5df1a951f6b1</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Gewährung einer Förderung nach dem Impulsprogramm Volksmusik</xflb:bezeichnung>\n                     <xflb:link>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmfh/impulsprogramm_volksmusik/index?caller=bpgfqwmylbgnsdgyzymqytsyjrgafm2vfn6epkwd54ncjucevlz33rpayxg3wizhwcub6ieygl4ywa2yjwxerubzlzlfpdwecnykum3ffwyasm7idgy6okgo5pnpx2tobsbdcix2hgyjcosdylxksa32rljib47cb7jk3mnfrfjwaivrxgl442egtb56ju3faifgpgbgv65bmrpsp47jmusseq3rxcck2puocrz5q8</xflb:link>\n                     <xflb:beschreibung>Sie können eine Festbetragsförderung aus dem Impulsprogramm Volksmusik beantragen.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n               </xflb:onlinedienste>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>002</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Antrags- und zuwendungsberechtigt sind Institutionen und Einrichtungen mit staatlicher, kommunaler oder privatrechtlicher Trägerschaft im sozialen sowie im Bildungsbereich mit Sitz in Bayern (zum Beispiel Kindertageseinrichtungen, Volksschulen, weiterführende Schulen, Volkshochschulen, Seniorenheime, Erziehungsheime, inklusive, integrative oder sonstige soziale Einrichtungen, Vereine).</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Zuwendung wird als nicht rückzahlbarer Zuschuss (Projektförderung) im Wege der Festbetragsfinanzierung gewährt.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Der Freistaat Bayern beteiligt sich mit einem Festbetrag an den zuwendungsfähigen Ausgaben nach Abzug der Eigenmittel, jedoch maximal in Höhe von 3 000 Euro für ein jährliches Vorhaben und maximal in Höhe von 1 500 Euro für ein halbjährliches Vorhaben.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Eigenmittel der Zuwendungsempfängerin oder des Zuwendungsempfängers müssen nach Abzug von Zuwendungen und Finanzierungsbeteiligungen Dritter mindestens 10 % der zuwendungsfähigen Ausgaben betragen.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die zuwendungsfähigen Ausgaben müssen nach Abzug der Eigenmittel mindestens 2 000 Euro für ein jährliches Vorhaben und mindestens 1 000 Euro für ein halbjährliches Vorhaben betragen.&lt;/li&gt;&lt;/ul&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Zuwendungsfähig sind Honorare (inklusive Reisekosten entsprechend dem Bayerischen Reisekostengesetz) von Referenten des Referentenpools, soweit diese für die Vorbereitung und Umsetzung des geförderten Vorhabens im Bewilligungszeitraum erforderlich sind.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Nicht zuwendungsfähig sind insbesondere:&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Personalausgaben außerhalb der Referentenhonorare,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;allgemeine Organisationskosten (zum Beispiel für Telefon, Kopien, Büromaterial),&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Raummieten,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;ohnehin anfallende laufende Ausgaben des Zuwendungsempfängers, Ausgaben für kommunale Regiearbeiten, pauschale Verrechnungen von laufenden Ausgaben für Beschäftigte,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;ehrenamtlich erbrachte Leistungen.&lt;/li&gt;&lt;/ul&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium der Finanzen und für Heimat</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinie zur Förderung von Vorhaben im Rahmen des Impulsprogramms Volksmusik (Volksmusikförderrichtlinie - VförR)</xflb:bezeichnung>\n                     <xflb:link>https://www.verkuendung-bayern.de/baymbl/2025-217</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>54 Heimatpflege</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Impulsprogramm Volksmusik</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2027-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2025-06-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2027-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert werden Vorhaben, die sich mit der Vermittlung von Volksmusik in unterschiedlichen stilistischen, regionalen und gegebenenfalls auch internationalen Ausprägungen befassen. Der Begriff Volksmusik ist bezüglich der musikalischen Ausrichtung offen zu sehen und umfasst so neben traditionellen Formen auch Fusionen mit anderen Musikstilen.&lt;/p&gt;&lt;p&gt;Als Vorhaben gelten regelmäßig stattfindende Kurse im Bereich Volksmusik. Möglich sind jährliche Vorhaben mit mindestens 30 Stunden oder halbjährliche Vorhaben mit mindestens 15 Stunden. Die jährlichen Vorhaben orientieren sich am Schuljahr, die halbjährlichen Vorhaben an einem der beiden Schulhalbjahre. Blocksysteme sind in Ausnahmefällen zulässig.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>013</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Eine Förderung kommt nur in Betracht, wenn&lt;/p&gt;\n&lt;ul&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;die zuwendungsfähigen Ausgaben für das Vorhaben abzüglich des erforderlichen Eigenanteils der Höhe der Zuwendung entsprechen oder diese übersteigen,&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;der Antragsteller oder die Antragstellerin in der Lage ist, seine oder ihre finanzielle Leistungsfähigkeit zur Erbringung des Eigenanteils nachzuweisen,&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;mit dem Vorhaben keine kommerziellen Interessen verfolgt werden,&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;wenn es sich für die Institution um eine neuartige Aktivität handelt. Die Kurse müssen in den Institutionen vor Ort oder in anderen, hierfür den Institutionen zu Verfügung gestellten Räumlichkeiten abgehalten werden und&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;wenn die Kurse von externen Referenten geleitet werden, die vor Stellung des Förderantrags im Referentenpool (&lt;a href=\"https://www.heimat-bayern.de/volksmusik/referentenpool/\"&gt;https://www.heimat-bayern.de/volksmusik/referentenpool/&lt;/a&gt;) eingetragen sind.&lt;/li&gt;\n&lt;/ul&gt;\n&lt;p&gt;&lt;br&gt;&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Eine Förderung ist nicht möglich für&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;bestehende Gruppen im Bereich Volksmusik,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Institutionen, die bei Inkrafttreten dieser Richtlinie bereits derartige Aktivitäten im Bereich Volksmusik durchführen oder in den letzten drei Jahren vor Inkrafttreten dieser Richtlinie durchgeführt haben sowie&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;reinen Instrumentalunterricht außerhalb des Ensemblespiels.&lt;/li&gt;&lt;/ul&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmfh/impulsprogramm_volksmusik/index?caller=bpgfqwmylbgnsdgyzymqytsyjrgafm2vfn6epkwd54ncjucevlz33rpayxg3wizhwcub6ieygl4ywa2yjwxerubzlzlfpdwecnykum3ffwyasm7idgy6okgo5pnpx2tobsbdcix2hgyjcosdylxksa32rljib47cb7jk3mnfrfjwaivrxgl442egtb56ju3faifgpgbgv65bmrpsp47jmusseq3rxcck2puocrz5q8</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;In der Regel ist folgender Verfahrensablauf üblich:&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Antragstellung über Online-Formular unter&amp;nbsp;&lt;a href=\"https://www.stmfh.bayern.de/heimat/impulsprogramm/\"&gt;https://www.stmfh.bayern.de/heimat/impulsprogramm/&lt;/a&gt;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Gegebenenfalls Antrag zum vorzeitigem Vorhabensbeginn&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Antragsprüfung durch die Bewilligungsbehörde&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bei förderfähigen Vorhaben Übermittlung des Bewilligungsbescheides durch die Bewilligungsbehörde&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Übermittlung der Verwendungsbestätigung durch den Zuwendungsempfänger&lt;/li&gt;&lt;/ul&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristdatum>2026-03-31</xflb:fristdatum>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Die Frist 31. März 2026 betrifft die aktuelle Förderperiode für jährliche oder halbjährliche Projekte, die ab September 2026 beginnen. Der darauf folgende Stichtag ist der 30. September 2026 für halbjährliche Projekte, die ab Februar 2027 beginnen.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Nachweis Referenten-Eintragung im Referentenpool</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Nachweis, dass die Referentin oder der Referent im Referentenpool eingetragen ist (vgl. Voraussetzungen).</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Gegen den Zuwendungsbescheid kann der Antragsteller/Zuwendungsempfänger innerhalb eines Monats nach Bekanntgabe Klage erheben. Das zuständige Verwaltungsgericht, bei dem die Klage eingereicht werden kann, wird im Bescheid mitgeteilt.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_127  [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index";
                                xyz:begriffeImKontext    [ rdf:_1  "Wasserversorgungsanlagen";
                                                           rdf:_2  "Zuwendungen zu Abwasserentsorgungsanlagen";
                                                           rdf:_3  "Förderung von Abwasseranlagen";
                                                           rdf:_4  "Zuwendungen zu Abwasserbeseitigung";
                                                           rdf:_5  "Abwasserbeseitigung Förderung";
                                                           rdf:_6  "Zuwendungen zur öffentlichen Trinkwasserversorgung";
                                                           rdf:_7  "Härtefallförderung";
                                                           rdf:_8  "Zweckverbände"
                                                         ];
                                xyz:beschreibung         "<p>Der Beitritt eines Einrichtungsträgers zu einem Zweckverband (sowohl bei Abwasserentsorgern, als auch Wasserversorgern) gefördert. Ebenso die Abgabe der Betriebsführung auf einen Zweckverband oder ein gemeinsames kommunal Unternehmen (gkU).</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Umwelt- und Naturschutz" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Kommunen";
                                                           rdf:_2  "Verbände"
                                                         ];
                                xyz:foerderprogramm      "Richtlinien für Zuwendungen zu wasserwirtschaftlichen Vorhaben (RZWas 2025)";
                                xyz:foerderzeitraum.bis  "2028-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2024-04-01T00:00:00.000+00:00";
                                xyz:schluessel           "4cf5cd54-c424-4b1a-b97e-8278f63b6b62";
                                xyz:teaser               "Der Freistaat Bayern unterstützt die bayerischen Städte und Gemeinden beim Beitritt zu einem Zweckverband in Härtefällen mit Zuwendungen.";
                                xyz:titel                "Beitritt des Einrichtungsträgers zu einem Zweckverband oder die Abgabe der Betriebsführung auf einen Zweckverband oder ein Gemeinsames kommunal Unternehmen (gkU)";
                                xyz:titel.tokens         [ rdf:_1  "Beitritt des Einrichtungsträgers zu einem Zweckverband oder die Abgabe der Betriebsführung auf einen Zweckverband oder ein Gemeinsames kommunal Unternehmen (gkU)" ];
                                xyz:voraussetzung        "<p>Für Vorhaben nach Nrn. 2.2.1 und 2.2.3 wird die Förderung gewährt, wenn die nach Anlage 2 RZWas 2025 ermittelte Pro-Kopf-Belastung des beitretenden Satzungsgebietes eine der Härtefallschwellen nach Nr. 4.3 RZWas 2025 im aktuellen Kalenderjahr überschreitet. Für Vorhaben nach Nr. 2.2.4. muss keine Härtefallschwelle erreicht werden. Antragsteller ist der aufnehmende Zweckverband. Der Zweckverband muss alle Anlagen und Aufgaben aus dem Satzungsgebiet des Einrichtungsträgers übernehmen, auch den Ortskanal (Schmutz- und Niederschlagswasser). Es reicht nicht, dass der Zweckverband nur den Sammler oder nur die Kläranlage betreibt. Der Zweckverband muss Beiträge und Gebühren erheben (keine Innenzweckverbände). Weitere Details erfahren Sie bei Ihrem örtlich zuständigen Wasserwirtschaftsamt.</p>"
                              ];
              xyz:id          "4cf5cd54-c424-4b1a-b97e-8278f63b6b62";
              xyz:payload     [ xyz:json  [ xyz:anfrage            [ xyz:anfragenummer  "4cf5cd54-c424-4b1a-b97e-8278f63b6b62";
                                                                     xyz:flb            [ xyz:konkreteFLB  [ xyz:allgemeineAngaben       [ xyz:allgemeineFragen   [ xyz:name                  "regional zuständiges Wasserwirtschaftsamt";
                                                                                                                                                                    xyz:organisationseinheit  [ xyz:code           "002";
                                                                                                                                                                                                xyz:listURI        "urn:xoev-de:stmd:codeliste:organisationseinheit";
                                                                                                                                                                                                xyz:listVersionID  "1";
                                                                                                                                                                                                xyz:name           "Zuständige Stelle"
                                                                                                                                                                                              ];
                                                                                                                                                                    xyz:verweis               [ xyz:bezeichnung  "zuständiges Wasserwirtschaftsamt";
                                                                                                                                                                                                xyz:link         "https://www.stmuv.bayern.de/themen/wasserwirtschaft/wasserwirtschaft_in_bayern/wasseraemter.htm"
                                                                                                                                                                                              ]
                                                                                                                                                                  ];
                                                                                                                                           xyz:beschreibung       [ xyz:schluesselwoerter  "Wasserversorgungsanlagen, Zuwendungen zu Abwasserentsorgungsanlagen, Förderung von Abwasseranlagen, Zuwendungen zu Abwasserbeseitigung, Abwasserbeseitigung Förderung, Zuwendungen zur öffentlichen Trinkwasserversorgung, Härtefallförderung, Zweckverbände";
                                                                                                                                                                    xyz:teaser             "Der Freistaat Bayern unterstützt die bayerischen Städte und Gemeinden beim Beitritt zu einem Zweckverband in Härtefällen mit Zuwendungen.";
                                                                                                                                                                    xyz:zuwendungszweck    "<p>Der Beitritt eines Einrichtungsträgers zu einem Zweckverband (sowohl bei Abwasserentsorgern, als auch Wasserversorgern) gefördert. Ebenso die Abgabe der Betriebsführung auf einen Zweckverband oder ein gemeinsames kommunal Unternehmen (gkU).</p>"
                                                                                                                                                                  ];
                                                                                                                                           xyz:titel              "Beitritt des Einrichtungsträgers zu einem Zweckverband oder die Abgabe der Betriebsführung auf einen Zweckverband oder ein Gemeinsames kommunal Unternehmen (gkU)";
