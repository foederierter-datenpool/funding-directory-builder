                                          ];
                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>74f3432a-981a-4f19-a3dd-5c4e84c76539</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2026-09-04T08:20:57</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>74f3432a-981a-4f19-a3dd-5c4e84c76539</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>74f3432a-981a-4f19-a3dd-5c4e84c76539</xflb:schluessel>\n         <xflb:versionFLB>3</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-09-15T15:30:59</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>74f3432a-981a-4f19-a3dd-5c4e84c76539</xflb:foerderschluessel>\n                  <xflb:flbVersion>3</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99148264017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Förderung von Projekten im bayerisch-tschechischen Grenzraum</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Um den bayerisch-tschechischen Grenzraum weiter zu einem Zukunftsraum zu entwickeln und neue Impulse für die Zusammenarbeit mit Tschechien zu setzen, braucht es auch weiterhin Engagement und innovative Ideen örtlicher Akteure. &lt;/p&gt;&lt;p&gt;Mit der Unterstützung von wegweisenden, grenzüberschreitenden Projekten im ländlichen Raum in den Regierungsbezirken Niederbayern, Oberpfalz und Oberfranken, sollen&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;gleichwertige Lebensverhältnisse und Arbeitsbedingungen in ganz Bayern, Stadt und Land, geschaffen, erhalten und gefördert werden (Verfassungsauftrag nach Art. 3 Abs. 2 Satz 2 BV),&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;gezielte Impulse für die Grenzregion gesetzt werden, um Entwicklungspotentiale zu erkennen und zu nutzen und Stärken weiter zu verbessern,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;zukunftsweisende, maßgeschneiderte Lösungsansätze örtlicher Akteure unterstützt werden,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;die grenzüberschreitende Zusammenarbeit, Austausch und gegenseitige Unterstützung mit Tschechien weiter verstärkt und verfestigt,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Menschen vor Ort grenzüberschreitend zusammengebracht, vernetzt und so eine Verflechtungsregion geschaffen werden.&lt;/li&gt;&lt;/ul&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern fördert im ländlichen Raum der Regierungsbezirke Niederbayern, Oberpfalz oder Oberfranken zukunftsweisende Projekte mit grenzüberschreitendem Charakter und fachübergreifendem Ansatz.</xflb:teaser>\n                  <xflb:schluesselwoerter>Bayerisch-Tschechischer-Grenzraum, Grenzraum, Tschechien, grenzüberschreitende Zusammenarbeit, Bayerisch-Tschechische Zusammenarbeit, Grenzraumförderung</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:alternativeFoerdermoeglichkeiten>\n                  <xflb:alternativeFoerdermoeglichkeit>\n                     <xflb:beschreibung>Die grenzübergreifende Zusammenarbeit im bayerisch-tschechischen Grenzraum wird durch das INTERREG Programm \"Bayern-Tschechien\" gefördert.</xflb:beschreibung>\n                     <xflb:verweis>\n                        <xflb:bezeichnung>Grenzübergreifende Zusammenarbeit Bayern - Tschechien; Beantragung einer Förderung</xflb:bezeichnung>\n                        <xflb:link>https://www.bayernportal.de/dokumente/leistung/1888479884?localize=false</xflb:link>\n                     </xflb:verweis>\n                  </xflb:alternativeFoerdermoeglichkeit>\n                  <xflb:alternativeFoerdermoeglichkeit>\n                     <xflb:beschreibung>Der Freistaat Bayern fördert innovative, fachübergreifende Heimatprojekte mit Schwerpunkt Digitalisierung, die sich positiv auf die räumliche Entwicklung Bayerns auswirken und insbesondere der Stärkung der regionalen Identität dienen.</xflb:beschreibung>\n                     <xflb:verweis>\n                        <xflb:bezeichnung>Digitale regionale Heimatprojekte; Beantragung einer Förderung</xflb:bezeichnung>\n                        <xflb:link>https://www.bayernportal.de/dokumente/leistung/4636064075101</xflb:link>\n                     </xflb:verweis>\n                  </xflb:alternativeFoerdermoeglichkeit>\n               </xflb:alternativeFoerdermoeglichkeiten>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderung von Projekten im bayerischen-tschechischen Grenzraum</xflb:bezeichnung>\n                     <xflb:link>https://www.heimat.bayern/politik/foerdermoeglichkeiten</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Informationen zur Erhebung personenbezogener Daten</xflb:bezeichnung>\n                     <xflb:link>https://www.heimat.bayern/assets/content/politk/foerdermoeglichkeiten/formblatt-fuer-projektevaluierung.docx</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Staatsministerium der Finanzen und für Heimat - Referat 52</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>4</xflb:hausnummerPostfach>\n                     <xflb:strasse>Odeonsplatz</xflb:strasse>\n                     <xflb:postleitzahl>80539</xflb:postleitzahl>\n                     <xflb:ort>München</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>Referat52@stmfh.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Homepage StMFH</xflb:bezeichnung>\n                     <xflb:link>https://www.stmfh.bayern.de/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>089 2306-3127</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Bewilligungsbehörde ist die im jeweiligen Regierungsbezirk zuständige Regierung, zusätzlich wird das  Projekt durch das Bayerische Staatsministerium der Finanzen und für Heimat begleitet.</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>9512398d-bc56-4704-88c0-40840feaf21c</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Projektförderung</xflb:bezeichnung>\n                     <xflb:link>https://www.heimat.bayern/assets/content/politk/foerdermoeglichkeiten/antrag-auf-projektfoerderung.docx</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>5d3b1dad-93d2-44be-b91d-d15c2744dfee</xflb:id>\n                     <xflb:bezeichnung>Formblatt zur Projektevaluierung</xflb:bezeichnung>\n                     <xflb:link>https://www.heimat.bayern/assets/content/politk/foerdermoeglichkeiten/formblatt-fuer-projektevaluierung.docx</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>ba39161d-6281-4acf-8e37-483bb717b3a2</xflb:id>\n                     <xflb:bezeichnung>Subventionserklärung</xflb:bezeichnung>\n                     <xflb:link>https://www.heimat.bayern/assets/content/politk/foerdermoeglichkeiten/subventionserklaerung.pdf</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Antrags- und zuwendungsberechtigt sind Gebietskörperschaften, Vereine sowie gemeinnützige Stiftungen mit Sitz im Regierungsbezirk Niederbayern, Oberpfalz oder Oberfranken sowie andere Rechtsträger des\nöffentlichen oder privaten Rechts, wenn mindestens ein Mitglied oder ein Gesellschafter eine kommunale Gebietskörperschaft ist.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Pro Zuwendungsempfänger beträgt die Fördersumme maximal 400.000 Euro für insgesamt vier Jahre (= max. Förderzeitraum).&lt;/p&gt;&lt;p&gt;Die Zuwendung erfolgt als Projektförderung im Wege der Anteilfinanzierung. Der Fördersatz liegt je nach räumlichen Wirkungskreis und bereits erhaltenen Projektförderungen zwischen 30 % und 90 %:&amp;nbsp;&lt;/p&gt;&lt;ol&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;Bei erstmaliger Förderung beträgt der Basisfördersatz bis zu 70 %.&amp;nbsp;&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;Soweit der räumliche Wirkungskreis mehrheitlich im Raum mit besonderem Handlungsbedarf liegt, erhöht sich der Fördersatz um bis zu 15 %.&amp;nbsp;&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;Der Fördersatz erhöht sich ebenfalls um bis zu 5 % bei interkommunalen Projekten oder bei Projekten, an denen sich die tschechische Seite finanziell beteiligt bzw. bei denen eine Zusammenarbeit mit Akteuren eines tschechischen Projekts mit ähnlicher inhaltlicher Zielrichtung im Plzeňský kraj (Bezirk Pilsen), Karlovarský kraj (Bezirk Karlsbad) oder Jihočeský kraj (Bezirk Südböhmen) erfolgt.&amp;nbsp;&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;Bei einer zweiten bzw. dritten Projektförderung mindert sich der Fördersatz stufenweise, soweit keine finanzielle Beteiligung Tschechiens oder eine enge Zusammenarbeit vorliegt.&lt;/li&gt;&lt;/ol&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Gefördert werden können die zur Durchführung des Projekts erforderlichen Ausgaben für &lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Personal,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Fahrten und Übernachtungen,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bewirtung bei öffentlichkeitswirksamen Veranstaltungen in angemessenem Umfang,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Öffentlichkeitsarbeit,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;externe Beratungs- und Dienstleistungen,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Investitionen unter 50 % der zuwendungsfähigen Ausgaben&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;sowie sonstige Leistungen durch Dritte, soweit diese unmittelbar dem Projektziel dienen.&lt;/li&gt;&lt;/ul&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:jahre>1</xflb:jahre>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:jahre>4</xflb:jahre>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n               <xflb:euBeihilferelevanz>Gemäß Art. 107 Abs. 1 AEUV sind staatliche oder aus staatlichen Mitteln gewährte Beihilfen, die bestimmte Unternehmen oder Produktionszweige begünstigen und dadurch den Wettbewerb verfälschen oder zu verfälschen drohen, verboten, soweit sie den Handel zwischen Mitgliedstaaten beeinträchtigen (sog. allgemeines Beihilfeverbot). Beihilfen i.S.v. Art. 107 Abs. 1 AEUV sind vor ihrer Durchführung bei der Europäischen Kommission anzumelden (sog. Notifizierungspflicht gemäß Art. 108 Abs. 3 AEUV).\n\nDas allgemeine Beihilfeverbot greift ein, wenn sämtliche der folgenden Voraussetzungen erfüllt sind:\n- Es muss sich um eine Maßnahme zugunsten eines Unternehmens handeln;\n- Die Maßnahme muss das Unternehmen begünstigen;\n- Die Maßnahme muss aus staatlichen Mitteln finanziert werden;\n- Die Maßnahme muss bestimmte Unternehmen begünstigen, d.h. sie muss selektiv sein und\n- Die Maßnahme muss den Wettbewerb verfälschen oder zu verfälschen drohen und eine Beeinträchtigung des zwischenstaatlichen Handels hervorrufen.\n\nLiegt eine dieser Voraussetzungen nicht vor, stellt die Maßnahme keine Beihilfe i.S.v. Art. 107 Abs. 1 AEUV dar. Sie kann ohne Notifizierung durch die Europäische Kommission durchgeführt werden.\n\nAusnahmen vom allgemeinen Beihilfeverbot sind möglich, soweit eine der folgenden Regelungen eingreift, die die Maßnahme vom Beihilfetatbestand des Art. 107 Abs. 1 AEUV ausnimmt oder von der Notifizierungspflicht des Art. 108 Abs. 3 AEUV befreit:\n\nDe-minimis-Verordnung\nDie De-minimis-Verordnung ermöglicht die Ausreichung von geringen Beihilfebeträgen, da vermutet wird, dass sie keine (drohende) Wettbewerbsverfälschung i.S.v. Art. 107 Abs. 1 AEUV bewirken. Der Schwellenwert liegt bei 300.000 Euro innerhalb des laufenden und der letzten zwei Kalenderjahre.\n\nAllgemeine Gruppenfreistellungsverordnung (AGVO)\nDie AGVO befreit bestimmt Beihilfen von der Notifizierungspflicht des Art. 108 Abs. 3 AEUV. Es ist jedoch erforderlich, dass die Europäische Kommission regelmäßig durch den Zuwendungsgeber - innerhalb von 20 Arbeitstagen \nnach Gewährung der Beihilfe informiert wird.\n\nDAWI-Beschluss\nEine weitere Ausnahme vom allgemeinen Beihilfeverbot stellen die Vorschriften zu Dienstleistungen von allgemeinem wirtschaftlichem Interesse (DAWI) dar. Die Europäische Kommission beschreibt DAWI als Dienstleistungen, die von den Behörden der Mitgliedsstaaten als im allgemeinen Interesse liegend eingestuft werden und ohne staatliche Eingriffe am Markt überhaupt nicht oder in Bezug auf Qualität, Sicherheit, Bezahlbarkeit, Gleichbehandlung oder universaler Zugang zu anderen Standards durchgeführt würden. Die sog. Altmark Trans-Entscheidung des EuGH (Urteil vom 24. Juli 2003, C-280/00) legt fest, welche Voraussetzungen erfüllt sein müssen, damit die Maßnahme keine Begünstigung des Zuwendungsempfängers und damit auch keine Beihilfe i.S.v. Art. 107 Abs. 1 AEUV darstellt.</xflb:euBeihilferelevanz>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium der Finanzen und für Heimat</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinie zur Förderung von Projekten im bayerisch-tschechischen Grenzraum (Förderrichtlinie Bayerisch-Tschechischer-Grenzraum - BYCZFöR)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_7012_1_F_12963?hl=true</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Allgemeine Nebenbestimmungen für Zuwendungen zur Projektförderung (ANBest-P)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Resource?path=resources%2fVVBayHO_BayVV630-F-073-000-KF-015-VV44-anl2.pdf</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat 52</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Förderung von Projekten im bayerisch-tschechischen Grenzraum i.R. Förderrichtlinie Bayerisch-Tschechischer-Grenzraum (BYCZFöR)</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2026-05-14</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2022-05-15</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2030-05-14</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n               <xflb:kummulierbareFoerderungen>\n                  <xflb:voraussetzungen>&lt;p&gt;Kofinanzierung von Projekten ist möglich, die aus einem EU- oder Bundesprogramm gefördert werden, sofern das EU- oder Bundesprogramm eine Landeskofinanzierung erfordert oder zulässt. Die Kofinanzierung ist gegenüber der EU- oder Bundesförderung nachrangig. Die Mindesteigenmittel von 10 % der zuwendungsfähigen Ausgaben sind zu beachten, sofern nicht das EU- oder Bundesprogramm höhere Eigenmittel vorschreibt.&lt;/p&gt;</xflb:voraussetzungen>\n               </xflb:kummulierbareFoerderungen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert werden zukunftsweisende Projekte ausschließlich im ländlichen Raum der Regierungsbezirke Niederbayern, Oberpfalz, Oberfranken mit grenzüberschreitendem Charakter und fachübergreifendem Ansatz sowie positiver Auswirkung auf die Entwicklung der bayerisch-tschechischen Grenzregion.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>016</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Eine Förderung nach der BYCZFöR setzt voraus, dass es sich bei Ihrem Vorhaben um ein Projekt mit grenzüberschreitendem Charakter sowie fachübergreifendem Ansatz, das heißt mindestens zwei Themenfelder (z.B. Demografie, Kultur, Tourismus, Mobilität/ Verkehr, Daseinsvorsorge, oder Ehrenamt) müssen gleichranging behandelt werden, handelt und das Projektgebiet im ländlichen Raum des Regierungsbezirks Niederbayern, Oberpfalz oder Oberfranken liegt. &lt;/p&gt;&lt;p&gt;Darüber hinaus müssen folgende Voraussetzungen erfüllt sein:&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Übereinstimmung der Projekte mit den Festlegungen aus dem Landesentwicklungsprogramm Bayern und den einschlägigen Regionalplänen,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Übereinstimmung der Projekte mit vorhandenen Entwicklungsstrategien,&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Einreichung eines Förderantrags mit festgelegten Evaluierungsindikatoren&amp;nbsp;unter Verwendung der auf www.heimat.bayern/politik/foerdermoeglichkeiten abrufbaren Unterlagen,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Abgabe einer Erklärung über die Sicherstellung der Gesamtfinanzierung&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;die zuwendungsfähigen Ausgaben betragen je Projekt mehr als 25.000 Euro.&lt;/li&gt;&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Eine Projektförderung kommt nicht in Betracht, sofern&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;eine der Zuwendungsvoraussetzungen nicht erfüllt ist,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;das Projekt bereits begonnen hat.&lt;/li&gt;&lt;/ul&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.heimat.bayern/assets/content/politk/foerdermoeglichkeiten/antrag-auf-projektfoerderung.docx</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Vor Antragstellung ist mit dem zuständigen Referat 52 im Staatsministerium der Finanzen und für Heimat Kontakt aufzunehmen (per E-Mail oder telefonisch) sowie ein Beratungsgespräch auf Basis einer Projektskizze mit der Bewilligungsbehörde durchzuführen. Der endgültige Antrag ist mindestens sechs Wochen vor dem geplanten Förderbeginn digital bei der örtlich zuständigen Regierung als Bewilligungsbehörde einzureichen. Bei Nicht-Einhaltung der Einreichungsfrist von sechs Wochen für den Antrag verschiebt sich der Förderbeginn auf den nächstmöglichen Termin.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:sonstige>ja</xflb:sonstige>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Eine Antragsstellung ist immer zum 1. oder 15. eines Monats möglich.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Antrag auf Projektförderung</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Subventionserklärung</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>ggfs. Kofinanzierungserklärung</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>Keine Angabe möglich</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_189  [ xyz:attributes  [ xyz:antragsstellung      "https://fff-gamesfoerderung.antragsverwaltung.de/login.php";
                                xyz:begriffeImKontext    [ rdf:_1  "Computerspielförderung";
