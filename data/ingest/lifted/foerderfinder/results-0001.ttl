                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>e0fc396d-50b3-4035-970e-86864c4ed45d</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2026-09-04T11:04:23</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>e0fc396d-50b3-4035-970e-86864c4ed45d</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>e0fc396d-50b3-4035-970e-86864c4ed45d</xflb:schluessel>\n         <xflb:versionFLB>3</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-09-07T11:56:51</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>e0fc396d-50b3-4035-970e-86864c4ed45d</xflb:foerderschluessel>\n                  <xflb:flbVersion>3</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400013017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Förderung von Flüchtlings- und Integrationsberatung</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Zweck der Förderung ist es,&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;den Integrationsprozess von Menschen mit Migrationsgeschichte mit dauerhaftem Bleiberecht nach dem Grundsatz \"Fördern und Fordern\" zu stärken, um einerseits die Teilhabechancen in unserem Land und andererseits das gelebte Miteinander der Menschen mit und ohne Migrationsgeschichte vor Ort zu unterstützen sowie&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Leistungsberechtigte nach § 1 AsylbLG zu unterstützen.&lt;/li&gt;&lt;/ul&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern gewährt Zuwendungen zur Unterstützung und Beratung von Asylbewerberinnen\nund Asylbewerber sowie dauerhaft bleibeberechtigten Menschen mit Migrationshintergrund.</xflb:teaser>\n                  <xflb:schluesselwoerter>Zuwanderer, Aussiedlerberatung, Flüchtlingsberatung, Spätaussiedlerberatung, Flüchtling, Ausländerberatung, Asylberatung, Migrationsberatung, Integrationsberatung</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Flüchtlings- und Integrationsberatung</xflb:bezeichnung>\n                     <xflb:link>https://www.stmi.bayern.de/a-z/anzeigen/fluechtlings-und-integrationsberatung/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Integrationsförderung</xflb:bezeichnung>\n                     <xflb:link>https://www.stmi.bayern.de/a-z/anzeigen/integrationsfoerderung/</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Regierung von Mittelfranken - Sachgebiet 15 - Integration und Förderung, Ausgleichsamt</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>21</xflb:hausnummerPostfach>\n                     <xflb:strasse>Marienstraße</xflb:strasse>\n                     <xflb:postleitzahl>90402</xflb:postleitzahl>\n                     <xflb:ort>Nürnberg</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>Sachgebiet-15.Integration@reg-mfr.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Übersicht der Regierung von Mittelfranken</xflb:bezeichnung>\n                     <xflb:link>https://www.regierung.mittelfranken.bayern.de/aufgaben/40027/57461/leistung/leistung_53004/index.html</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>+49 (0)911 2352-0</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Regierung von Mittelfranken - Sachgebiet 15 - Integration und Förderung, Ausgleichsamt</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>21</xflb:hausnummerPostfach>\n                           <xflb:strasse>Marienstraße</xflb:strasse>\n                           <xflb:postleitzahl>90402</xflb:postleitzahl>\n                           <xflb:ort>Nürnberg</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>Sachgebiet-15.Integration@reg-mfr.bayern.de</xflb:email>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Übersicht der Regierung von Mittelfranken</xflb:bezeichnung>\n                           <xflb:link>https://www.regierung.mittelfranken.bayern.de/aufgaben/40027/57461/leistung/leistung_53004/index.html</xflb:link>\n                        </xflb:verweis>\n                        <xflb:telefonnummer>+49 (0)911 2352-150</xflb:telefonnummer>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>6a0ddc57-6f9e-44b0-8ee3-2c8bd2ad6105</xflb:id>\n                     <xflb:bezeichnung>Verwendungsbestätigung Flüchtlings- und Integrationsberatung in Bayern (BIR III) - Regelförderung</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/rmf-zz/15/rmf_15-053-zz/index?caller=762399674965&amp;caller=762399674965</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n               <xflb:onlinedienste>\n                  <xflb:onlinedienst>\n                     <xflb:id>5de3a2ab-5f77-4aa0-bd16-ae98fcdfe855</xflb:id>\n                     <xflb:bezeichnung>Verwendungsbestätigung für eine Förderung nach der Beratungs- und Integrationsrichtlinie (BIR III) - Regelförderung</xflb:bezeichnung>\n                     <xflb:link>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/rmf_15-053-zz/index?caller=bpgezdqmrvmnsgkobsmeytmmrrheqsygebrxwzfppj2xd6qrnobhp6hfft4bxbndpkdilr4bgnrahilcvmnf2robrejxcq5e7xbvyiaivxj5w7256pzmdjueh7a7u7kirmxd35pq3veb7zalirx2hhwcq27ddsq6dckmcf45jw3fnt77kidfntf4nj7eljtispaykngytenrkzk888</xflb:link>\n                     <xflb:beschreibung>Sie können den Verwendungsnachweis für eine Förderung der Flüchtlings- und Integrationsberatung (BIR III) online einreichen.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n                  <xflb:onlinedienst>\n                     <xflb:id>ced4a6c0-e2c8-433d-950e-5c74235fb516</xflb:id>\n                     <xflb:bezeichnung>Verwendungsbestätigung für eine Förderung nach der Beratungs- und Integrationsrichtlinie (BIR III) für Spitzenverbände der Freien Wohlfahrtspflege</xflb:bezeichnung>\n                     <xflb:link>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/rmf_15-063-zz/index?caller=bpmi2dgmbtgnrdgytfgm3dsmlcgkpwn7pu2donveoom7nmudw72q5ggwwqaei2u26zxctlikmxoxs65iey4aqrk3ru4hydrbmvpswnbgzcl4pg5vdolcmkdf75odb6px6fg2rbij3bjrzx4wnendki3325h5iho4y3dri6q6zetpptyzzoqbbvcvt5va7ucw6ohch5dnym6yax6888</xflb:link>\n                     <xflb:beschreibung>Spitzenverbände der Freien Wohlfahrtspflege auf Ebene der Landesverbände können die Verwendungsbestätigung für eine Förderung nach der Beratungs- und Integrationsrichtlinie (BIR III) online übermitteln.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n               </xflb:onlinedienste>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Zuwendungsempfänger sind rechtsfähige Träger auf der untersten Organisationsebene, bei denen das Personal beschäftigt ist, aus dem Bereich der freien Wohlfahrtspflege mit Sitz in Bayern sowie die Landkreise beziehungsweise kreisfreien Städte in Bayern. Es ist ebenso zulässig, andere Träger aus dem Kreise der Zuwendungsempfänger oder übergeordnete Dachverbände zur Antragstellung zu bevollmächtigen und sich zu einem Trägerverband zusammenzuschließen. Zuwendungsempfänger für Aufgaben der Koordination und Unterstützung der aktiven Flüchtlings- und Integrationsberatungsstellen sowie der bayernweiten bedarfsgerechten Sicherstellung der Beratung sind die Spitzenverbände der Freien Wohlfahrtspflege auf Ebene der Landesverbände.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Zuwendung wird als Festbetragsfinanzierung gewährt.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Zuwendungsfähig sind die tatsächlich entstehenden Personalausgaben für Beratungskräfte, jeweils begrenzt auf die Vergütung vergleichbarer staatlicher Beschäftigter. Für die Durchführung der Kappung sind die vom Staatsministerium der Finanzen und für Heimat ermittelten Personalausgabenhöchstsätze für Beschäftigte im Sozial- und Erziehungsdienst maximal bis Entgeltgruppe S 12 in ihrer jeweils geltenden Fassung maßgeblich. Zuwendungsfähig ist ferner ein pauschaler Ansatz für die im Rahmen des Vorhabens anfallenden notwendigen Sachausgaben für Ausbildungs-, Fortbildungs- und Supervisionskosten, Fahrtkosten, Software, Lizenzen und Schulungen zur digitalen Beratung der Beratungskräfte.&lt;/p&gt;&lt;p&gt;Zuwendungsfähig im Rahmen der Förderung der Spitzenverbände der Freien Wohlfahrtspflege auf Ebene der Landesverbände sind die tatsächlich entstehenden projektbezogenen Personalausgaben, jeweils begrenzt auf die Vergütung vergleichbarer staatlicher Beschäftigter. Für die Durchführung der Kappung sind die vom Staatsministerium der Finanzen und für Heimat ermittelten Personalausgabenhöchstsätze für die Entgeltgruppen 1 bis 15 TV-L anzuwenden.&lt;/p&gt;&lt;p&gt;Weitergehende Informationen sind der Förderrichtlinie zu entnehmen.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n               <xflb:euBeihilferelevanz>unzutreffend</xflb:euBeihilferelevanz>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium des Innern, für Sport und Integration</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinie für die Förderung der sozialen Beratung, Betreuung und Integration von Menschen mit Migrationsgeschichte (Beratungs- und Integrationsrichtlinie - BIR) vom 26. September 2023</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2176_I_14046</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Sachgebiet G3</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Richtlinie für die Förderung der sozialen Beratung, Betreuung und Integration von Menschen mit Migrationsgeschichte (Beratungs- und Integrationsrichtlinie - BIR)</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2026-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2024-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2026-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert werden im Rahmen des Zuwendungszwecks die Beratungs- und Betreuungstätigkeit und die Koordination und Unterstützung der aktiven Flüchtlings- und Integrationsberatungsstellen sowie die bayernweite bedarfsgerechte Sicherstellung der Beratung.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>022</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Die Beratungskräfte müssen fachlich qualifiziert sein. Die Qualifikationsanforderungen sind im Einzelnen der Beratungs- und Integrationsrichtlinie zu entnehmen. Grundsätzlich ist bei der Planung und Ergänzung der Beratungsstruktur darauf zu achten, dass bayernweit eine bedarfsorientierte Angebots- und Beratungsstruktur erreicht wird.&lt;/p&gt;&lt;p&gt;Der Antragsteller muss einen angemessenen Eigenanteil in Höhe von mindestens 10% der zuwendungsfähigen Gesamtausgaben erbringen, der auch über Drittmittel erbracht werden kann.&lt;/p&gt;&lt;p&gt;Voraussetzung für die Förderung der Landesverbände ist, dass diese oder die ihnen untergeordneten Verbände und Träger Zuwendungen für die Flüchtlings- und Integrationsberatung im Sinne der Beratungs- und Integrationsrichtlinie erhalten und der Landesverband hierfür koordinierende und verwaltende Aufgaben, insbesondere die bayernweite bedarfsgerechte Sicherstellung der Beratung, wahrnimmt.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/rmf_15-053-zz/index?caller=bpgezdqmrvmnsgkobsmeytmmrrheqsygebrxwzfppj2xd6qrnobhp6hfft4bxbndpkdilr4bgnrahilcvmnf2robrejxcq5e7xbvyiaivxj5w7256pzmdjueh7a7u7kirmxd35pq3veb7zalirx2hhwcq27ddsq6dckmcf45jw3fnt77kidfntf4nj7eljtispaykngytenrkzk888</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Anträge auf Förderung sind bei der Regierung von Mittelfranken, Sachgebiet 15, einzureichen, die über diese entscheidet (Bewilligungsbehörde). Der Bewilligungszeitraum beträgt bis zu drei Jahren. Der Antrag ist rechtzeitig im Voraus - bis 15.11. des jeweiligen Vorjahres - zu stellen. Die Anträge sind unter Verwendung der bei der Bewilligungsbehörde erhältlichen Vordrucke zu erstellen. Dem Staatsministerium des Innern, für Sport und Integration ist ein Abdruck (mit Anlagen) ausschließlich in digitaler Form zu übersenden. Die weiteren Einzelheiten zum Antragstellungs- und Bewilligungsverfahren entnehmen Sie bitte der Richtlinie (siehe unter \"Rechtsgrundlagen\").&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristdatum>2026-12-31</xflb:fristdatum>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Der Bewilligungszeitraum beträgt bis zu drei Jahre (Ende mit Außerkrafttreten der Richtlinie). Der Zuwendungsempfänger kann eine einjahres-, zweijahres- oder dreijahresbezogene Förderung beantragen. Der Antrag ist vor Beginn des Bewilligungszeitraums grundsätzlich bis spätestens 15. November des Vorjahres zu stellen. Etwaige Änderungen nach Antragstellung können der Bewilligungsbehörde noch bis spätestens 15. März des Bewilligungszeitraums mitgeteilt werden.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Ausgaben- und Finanzierungsplan</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Stellenübersicht</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Kofinanzierungsbestätigung(en): (vom Drittmittelgeber auszufüllen)</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Zuständigkeitsvereinbarung(en)</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Verwaltungsrechtliche Klage.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_176  [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/rmf_15-024-zz_zuwendungsantrag/index?caller=bpmu2dqmjqmfrgeolegrsggolgmzjsccafh6ang7xd6dbbvgkqjdz5pdxszqsxkpj245avkunc2ntpbs2avc6polf2wojqlvdywvutmmx3l373gmexecds5fpr2ytvcarvhdnyg7n5t3nw4usg4msz3n44lgeb63quajz5hszyfnf2dmqha43z3v5csznkqdmtxzhbaqoknw2dpxa7nzdd5aajja6j2jlwwrzshnq8";
                                xyz:begriffeImKontext    [ rdf:_1   "Zuwanderer";
                                                           rdf:_10  "Nachhilfe";
                                                           rdf:_2   "Spätaussiedler";
                                                           rdf:_3   "Deutschförderung";
                                                           rdf:_4   "Außerschulische Hausaufgabenhilfe mit Schwerpunkt Deutschförderung";
                                                           rdf:_5   "Migranten";
                                                           rdf:_6   "Hausaufgabehilfe";
                                                           rdf:_7   "Spätaussiedlerprojekte";
                                                           rdf:_8   "Deutschförderung";
                                                           rdf:_9   "Sprachförderung"
                                                         ];
                                xyz:beschreibung         "<p>Ziel der Förderung ist es, den Erwerb der Sprachkompetenz junger Menschen mit Migrationsgeschichte sowie junger Asylbewerberinnen und Asylbewerber mit guter Bleibeperspektive an bayerischen allgemeinbildenden Schulen zwischen der ersten und zehnten Jahrgangsstufe zu unterstützen und damit die alsbaldige Eingliederung zu ermöglichen.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Integration" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Privatpersonen" ];
                                xyz:foerderprogramm      "Richtlinie für die Förderung der sozialen Beratung, Betreuung und Integration von Menschen mit Migrationsgeschichte (Beratungs- und Integrationsrichtlinie - BIR)";
                                xyz:foerderzeitraum.bis  "2026-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2024-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "8fc84e50-5c1f-4323-8486-a04bcc88536b";
                                xyz:teaser               "Der Freistaat Bayern fördert mit der außerschulischen Hausaufgabenhilfe die sprachliche Integration von schulpflichtigen Kindern und Jugendlichen mit Migrationsgeschichte, die rechtmäßig und dauerhaft in Bayern leben bzw. eine gute Bleibeperspektive haben.";
                                xyz:titel                "Außerschulische Hausaufgabenhilfe mit Schwerpunkt Deutschförderung";
                                xyz:titel.tokens         [ rdf:_1  "Außerschulische Hausaufgabenhilfe mit Schwerpunkt Deutschförderung" ];
                                xyz:voraussetzung        "<ul><li class=\"unordered-list-item--dash\">Der Schüler bzw. die Schülerin hat einen rechtmäßigen und dauerhaften Aufenthalt in Bayern oder ist eine Asylbewerberin bzw. ein Asylbewerber mit guter Bleibeperspektive.</li><li class=\"unordered-list-item--dash\">Es wird eine an einer bayerischen allgemeinbildenden Schule zwischen der ersten und der zehnten Jahrgangsstufe eine Deutschförderklasse, ein Deutschförderkurs, eine Übergangsklasse (aktuell: eine Deutschklasse oder eine Maßnahme aus DeutschPLUS) besucht (bzw. die Voraussetzungen zum Besuch einer Deutschklasse oder einer Maßnahme aus DeutschPLUS werden erfüllt).</li><li class=\"unordered-list-item--dash\">Es besteht ein über die schulische Förderung hinausgehender Bedarf an Deutschförderung (Bestätigung durch die Schule erforderlich).</li></ul>"
                              ];
              xyz:id          "8fc84e50-5c1f-4323-8486-a04bcc88536b";
