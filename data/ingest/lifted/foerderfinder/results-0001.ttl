                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>bc609ac9-69cd-425a-8c1c-0ee6d7346dfe</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2025-05-28T14:02:48</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>bc609ac9-69cd-425a-8c1c-0ee6d7346dfe</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>bc609ac9-69cd-425a-8c1c-0ee6d7346dfe</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2025-05-28T14:02:48</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>bc609ac9-69cd-425a-8c1c-0ee6d7346dfe</xflb:foerderschluessel>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99148281017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Pilotförderprogramm Heimat.Engagiert</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Gefördert werden Vorhaben, die sich in besonderer oder innovativer Art und Weise mit der Pflege und Vermittlung von Heimatgeschichte und Kulturformen im Zusammenhang mit örtlich herausragenden Inhalten befassen.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Wenn Sie sich in besonderer oder innovativer Art und Weise mit der Pflege und Vermittlung von Heimatgeschichte und Kulturformen im Zusammenhang mit örtlich herausragenden Inhalten befassen, könnte eine Förderung für Sie in Betracht kommen.</xflb:teaser>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Ausführliche Informationsseite</xflb:bezeichnung>\n                     <xflb:link>https://www.stmfh.bayern.de/heimat/engagiert/</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Staatsministerium der Finanzen und für Heimat, Referat Heimatpflege</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>4</xflb:hausnummerPostfach>\n                     <xflb:strasse>Odeonsplatz</xflb:strasse>\n                     <xflb:postleitzahl>80539</xflb:postleitzahl>\n                     <xflb:ort>München</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>heimat.engagiert@stmfh.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Heimat.Engagiert</xflb:bezeichnung>\n                     <xflb:link>https://www.stmfh.bayern.de/heimat/engagiert/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>+4991198233439</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>StMFH Referat 54</xflb:name>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:onlinedienste>\n                  <xflb:onlinedienst>\n                     <xflb:id>0227ae53-643e-4225-b637-6acfef5da81a</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Gewährung einer Festbetragsförderung aus dem Programm \"Heimat.Engagiert\"</xflb:bezeichnung>\n                     <xflb:link>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmfh/gewaehrung_festbetrag/index?caller=bpmy4tkojuhbrtmnjthbrtinldmrbfkpszklr7hemx6mqag2a2mkvrrr5h7qq7sr57mi5ol2kpjvutqzkj6qa3y7mhxq2hq4ulcvbqs5vwl3beafri5sgpi72wj2csqowuu2kr2tx6oi6yr5eqia75rkdibpurj4d2n3wdtdxe4rifxiv5e4nmlf3f6yuugwptj6yrdktqk7u2ulmh7is6zkcemx3xp7xxcgkvnki8</xflb:link>\n                     <xflb:beschreibung>Mit diesem Assistenten können Sie eine Festbetragsförderung aus dem Programm Heimat.Engagiert online beantragen.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n               </xflb:onlinedienste>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>007</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>006</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>005</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>004</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>003</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>002</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Antragsberechtigt sind grundsätzlich alle natürlichen und juristischen Personen des privaten und öffentlichen Rechts im außerkommunalen Bereich.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Zuwendung wird als nicht rückzahlbarer Zuschuss (Projektförderung) im Wege der Festbetragsfinanzierung gewährt.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Der Freistaat Bayern beteiligt sich mit einem Festbetrag in Höhe von 2000 Euro an den zuwendungsfähigen Ausgaben.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Eigenmittel der Zuwendungsempfängerin oder des Zuwendungsempfängers müssen nach Abzug von Zuwendungen und Finanzierungsbeteiligungen Dritter mindestens 10 % der zuwendungsfähigen Ausgaben betragen.&lt;/li&gt;&lt;/ul&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Gefördert werden Vorhaben, die sich in besonderer oder innovativer Art und Weise mit der Pflege und Vermittlung von Heimatgeschichte und Kulturformen im Zusammenhang mit örtlich herausragenden Inhalten befassen. Förderwürdig sind dabei insbesondere&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;heimatpflegerisch besonders wertvolle Publikationen,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Veranstaltungen,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Ausstellungen,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;die Instandsetzung von aus heimatpflegerischen Aspekten besonders wertvollem Vereinsinventar,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;die Anschaffung von Ausstellungsinventar,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;die Instandsetzung von aus heimatpflegerischen Aspekten besonders wertvollem Ausstellungsinventar,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;technische Möglichkeiten zur Präsentation von Heimatgeschichte einschließlich der Entwicklung und Umsetzung neuer Darstellungsformen,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Wegweiser und Informationstafeln.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Ebenso förderwürdig sind Vorhaben, die Menschen für Besonderheiten im Bereich Heimat- und Brauchpflege sensibilisieren.&lt;/p&gt;&lt;p&gt;Bei der Umsetzung des Vorhabens ist auf eine inklusive und offene Ausgestaltung zu achten (offener Heimatbegriff).&lt;/p&gt;&lt;p&gt;Eine Förderung ist insbesondere &lt;strong&gt;nicht&lt;/strong&gt; möglich für&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bauvorhaben, einschließlich der Sanierung, und&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Neuanschaffung von Möbeln, Kleidung, Instrumenten oder vereinsüblicher Ausstattung.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Ausgeschlossen von der Förderung sind weiter grundsätzlich Vorhaben, die regional oder bayernweit sehr häufig vorkommen und daher keinen besonderen oder innovativen Charakter aufweisen, wie z.B. die Restaurierung von (Vereins-)Fahnen, Maibaumtafeln, Schützenscheiben, die Ausrichtung von (Vereins-)Festen und Fahrten oder Vergleichbares (\"massentypische Vorhaben\"). Ebenfalls ausgeschlossen sind bestehende, wiederkehrende Veranstaltungs- und Publikationsreihen.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium der Finanzen und für Heimat</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 23 und 44 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO/true</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Allgemeine Nebenbestimmungen für Zuwendungen zur Projektförderung (ANBest-P) - Verwaltungsvorschriften zur Bayerischen Haushaltsordnung (VV-BayHO) - Anlage 2 zu Art. 44 BayHO</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN121</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>54 Heimatpflege</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Pilotförderprogramm Heimat.Engagiert</xflb:programmtitel>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2024-03-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2027-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Besondere oder innovative Projekte zur Pflege und Vermittlung von Heimatgeschichte und Kulturformen im Zusammenhang mit örtlich herausragenden Inhalten&lt;/p&gt;&lt;p&gt;Förderwürdig sind dabei insbesondere&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;heimatpflegerisch besonders wertvolle Publikationen,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Veranstaltungen,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Ausstellungen,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;die Instandsetzung von aus heimatpflegerischen Aspekten besonders wertvollem Vereinsinventar,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;die Anschaffung von Ausstellungsinventar,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;die Instandsetzung von aus heimatpflegerischen Aspekten besonders wertvollem Ausstellungsinventar,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;technische Möglichkeiten zur Präsentation von Heimatgeschichte einschließlich der Entwicklung und Umsetzung neuer Darstellungsformen,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Wegweiser und Informationstafeln.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Ebenso förderwürdig sind Vorhaben, die Menschen für Besonderheiten im Bereich Heimat- und Brauchpflege sensibilisieren.&lt;/p&gt;&lt;p&gt;Bei der Umsetzung des Vorhabens ist auf eine inklusive und offene Ausgestaltung zu achten (offener Heimatbegriff).&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>013</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>016</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Förderanträge sind beim Bayerischen Staatsministerium der Finanzen und für Heimat als Bewilligungsbehörde über eine digitale Antragsplattform einzureichen.&lt;/p&gt;&lt;p&gt;Förderanträge können ganzjährig jeweils bis zum 31. März oder bis zum 31. Oktober gestellt werden (Stichtag/ Sammeltermin).&lt;/p&gt;&lt;p&gt;Jede Zuwendungsempfängerin und jeder Zuwendungsempfänger darf lediglich einen Antrag pro Sammeltermin einbringen.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Akteure aus dem kommunalen Bereich: Im Rahmen des Pilotförderprogramms \"Heimat.Engagiert\" ist der Begriff des außerkommunalen Bereichs so zu verstehen, dass kommunale Institutionen von der Antragstellung ausgeschlossen sind. Antragssteller dürfen daher keine kommunalen Gebietskörperschaften (Gemeinden einschließlich der Städte und kreisfreien Städte, Bezirke oder Landkreise) und keine Initiativen, Vereine oder sonstige juristische Personen, die unter kommunaler Trägerschaft stehen, sein. Die durch Kommunen bestellten Heimatpflegerinnen und Heimatpfleger werden der kommunalen Trägerschaft zugeordnet und sind mithin nicht zur Antragstellung berechtigt.&lt;/p&gt;&lt;p&gt;Eine Förderung ist insbesondere &lt;strong&gt;nicht&lt;/strong&gt; möglich für&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bauvorhaben, einschließlich der Sanierung, und&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Neuanschaffung von Möbeln, Kleidung, Instrumenten oder vereinsüblicher Ausstattung.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Ausgeschlossen von der Förderung sind weiter grundsätzlich Vorhaben, die regional oder bayernweit sehr häufig vorkommen und daher keinen besonderen oder innovativen Charakter aufweisen, wie z.B. die Restaurierung von (Vereins-)Fahnen, Maibaumtafeln, Schützenscheiben, die Ausrichtung von (Vereins-)Festen und Fahrten oder Vergleichbares (\"massentypische Vorhaben\"). Ebenfalls ausgeschlossen sind bestehende, wiederkehrende Veranstaltungs- und Publikationsreihen.&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmfh/gewaehrung_festbetrag/index?caller=bpmy4tkojuhbrtmnjthbrtinldmrbfkpszklr7hemx6mqag2a2mkvrrr5h7qq7sr57mi5ol2kpjvutqzkj6qa3y7mhxq2hq4ulcvbqs5vwl3beafri5sgpi72wj2csqowuu2kr2tx6oi6yr5eqia75rkdibpurj4d2n3wdtdxe4rifxiv5e4nmlf3f6yuugwptj6yrdktqk7u2ulmh7is6zkcemx3xp7xxcgkvnki8</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;In der Regel ist folgender Verfahrensablauf üblich:&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Antragstellung über Online-Formular mit Link über Website&amp;nbsp;Heimat.Engagiert&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Gegebenenfalls Antrag zum vorzeitigem Vorhabensbeginn&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Antragsprüfung durch die Bewilligungsbehörde&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bei förderfähigen Vorhaben Übergabe oder Übermittlung des Bewilligungsbescheides durch die Bewilligungsbehörde&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Übermittlung der Verwendungsbestätigung durch den Zuwendungsempfänger&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Jede Zuwendungsempfängerin und jeder Zuwendungsempfänger darf lediglich einen Antrag pro Sammeltermin einbringen.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:sonstige>ja</xflb:sonstige>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Förderanträge können ganzjährig jeweils bis zum 31. März oder bis zum 31. Oktober gestellt werden (Stichtag). Die Projektauswahl und Bewilligung erfolgt im Anschluss an den jeweiligen Stichtag im Rahmen eines Sammeltermins. Die Auszahlung der Förderung von 2.000 EUR erfolgt unmittelbar nach Bewilligung in einer Summe.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Projektbeschreibung</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Kosten- und Finanzierungsplan</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>ggf. weitere erläuternde Unterlagen</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Gegen einen Bescheid kann innerhalb eines Monats nach seiner Bekanntgabe beim jeweils zuständigen Verwaltungsgericht Klage erhoben werden.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_49   [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmwk/blfd/kulturfonds_kunst/index?caller=bpmvsdiobwgiytgytcmvtgindbgzqlaxkqvlgmhv2vtozyv4ar6vuoygjpsweeywtirp774me4sq34jqtm6o33h47iwknvj4kfyd7a5lzntit5enbekzpsmuch6yv2tq3w34fbcsmvglpjgisztwxvu4jq6x42yhw7vh6dz5rj5gie2zi4jdrhjy2vaqpckkb2e2j75g6eew4sh3abmbnvcwuvjixojuqalbj33xi8";
                                xyz:begriffeImKontext    [ rdf:_1  "Laienmusik Amateurmusik" ];
                                xyz:beschreibung         "<p>Förderung besonderer Projekte nichtstaatlicher und nichtkommerzieller Träger aus dem Bereich Laienmusik, sofern diesen Vorhaben bayernweite Bedeutung zukommt. Das Fördergebiet umfasst ganz Bayern, ausgeschlossen sind Vorhaben in München und Nürnberg. Zuständig für die Antragsbearbeitung ist die jeweilige Bezirksregierung, in deren Region das Vorhaben durchgeführt werden soll. Sofern das Vorhaben in mehreren Regierungsbezirken umgesetzt werden soll, ist die Bezirksregierung zuständig, in deren Region der Antragsteller seinen Sitz hat. Für Vorhaben aus dem Bereich Bildung (Projekte bei denen nicht die Präsentation/Vorführung von Kultur und kulturelle Darbietungen vor Publikum im Vordergrund stehen, wie z.B. bei Theaterstücken, Konzerten, Lesungen, Ausstellungen), sondern die gemeinsame Erarbeitung unterschiedlicher kultureller Themen, wäre der Kulturfonds \"Kulturelle Bildung\" (angesiedelt beim Bayerischen Staatsministerium für Unterricht und Kultus) einschlägig.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Kultur, Medien und Sport" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Privatpersonen";
                                                           rdf:_2  "Kommunen";
                                                           rdf:_3  "Vereine";
                                                           rdf:_4  "Verbände"
                                                         ];
                                xyz:foerderprogramm      "Kulturfonds Bayern - Kunst";
                                xyz:foerderzeitraum.bis  "2028-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2025-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "fbc93a27-0409-4497-87fa-4a9523a1b455";
                                xyz:teaser               "Der Freistaat Bayern fördert Veranstaltungen aus dem Bereich Laien- oder Amateurmusik die bayernweite Bedeutung haben.";
                                xyz:titel                "E2-Förderung von Einzelprojekten aus dem Bereich Laienmusik";
                                xyz:titel.tokens         [ rdf:_1  "E2-Förderung von Einzelprojekten aus dem Bereich Laienmusik" ];
                                xyz:voraussetzung        "<p>Aus dem Kulturfonds, **Bereich Kunst** , können kulturelle Projekte nichtstaatlicher Träger gefördert werden, aber keine laufenden Betriebskosten (institutionelle Förderung). Für regelmäßig wiederkehrende Veranstaltungen ist lediglich eine Anschubfinanzierung möglich. Die Vorhaben aus dem Bereich Laienmusik müssen von bayernweiter Bedeutung sein; Maßnahmen mit zuwendungsfähigen Gesamtkosten von weniger als 10.000 € können nicht gefördert werden. Das Fördergebiet umfasst ganz Bayern; grundsätzlich ausgeschlossen sind allerdings Vorhaben in München und Nürnberg. Eine gleichzeitige Förderung aus anderen staatlichen Förderansätzen (Mehrfachförderung) sowie aus Mitteln der Bayerischen Landesstiftung ist grundsätzlich ausgeschlossen. Die Förderung erfolgt nach Maßgabe der zur Verfügung stehenden Haushaltsmittel und ist grundsätzlich auf maximal 30 v. H. der zuwendungsfähigen Kosten begrenzt. Zuwendungen dürfen nur bewilligt werden, wenn mit dem Projekt noch nicht begonnen wurde.</p>"
                              ];
              xyz:id          "fbc93a27-0409-4497-87fa-4a9523a1b455";
