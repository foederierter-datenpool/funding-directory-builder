                                                                                                                                           xyz:zustaendigeStelle  [ xyz:zustaendigeStelleDetails  [ xyz:zustaendigeStelleInformationen
                                                                                                                                                                                      "Die Anträge auf staatliche Förderung der Mittagsbetreuung bzw. verlängerten Mittagsbetreuung sind über die Schulleitung und das Staatliche Schulamt (bzw. bei Förderschulen direkt)  bei der zuständigen Bezirksregierung einzureichen. Der Antragstermin und der Meldetermin nach Schuljahresbeginn werden jährlich im Rahmen des Antrags- und Genehmigungsverfahrens bekannt gegeben." ]
                                                                                                                                                                  ]
                                                                                                                                         ];
                                                                                                             xyz:antragsinformationen    [ xyz:antragsfrist             [ xyz:bemerkung             "Der Antragstermin und der Meldetermin nach Schuljahresbeginn werden jährlich im Rahmen des Antrags- und Genehmigungsverfahrens bekannt gegeben.\nIn der Regel sind Anträge vom Träger jeweils bis zum 1. Juli einzureichen.";
