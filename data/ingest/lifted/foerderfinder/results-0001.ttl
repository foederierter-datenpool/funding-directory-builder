                                                                                                                                           xyz:laufzeitFinanzierung      [ xyz:laufzeitFinanzierung  [ xyz:code           "001";
                                                                                                                                                                                                       xyz:listURI        "urn:xoev-de:stmd:codeliste:laufzeit-finanzierung";
                                                                                                                                                                                                       xyz:listVersionID  "1";
                                                                                                                                                                                                       xyz:name           "Gesamte Projektlaufzeit"
                                                                                                                                                                                                     ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1";
                                                                                                                                                                           xyz:name           ""
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Mobile Endgeräte die folgende Voraussetzungen erfüllen und die von den Schulen verbindlich vorgegebenen Ausstattungskomponenten:</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">Neugeräte mit mindestens 10 Zoll Bildschirmgröße oder Refurbished-Geräte mit mindestens 10 Zoll Bildschirmgröße von gewerblichen Händlern mit einer Garantie von mindestens einem Jahr.</li>\n  <li class=\"unordered-list-item--dash\">sowie zusätzlich festgelegte schulspezifische technische Mindestkriterien</li>\n</ul>"
                                                                                                                                         ];
                                                                                                             xyz:foerderbereich          [ xyz:foerderbereich  [ xyz:code           "006";
                                                                                                                                                                 xyz:listURI        "urn:xoev-de:stmd:codeliste:foerderbereich";
                                                                                                                                                                 xyz:listVersionID  "1";
                                                                                                                                                                 xyz:name           ""
                                                                                                                                                               ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergebiet           [ xyz:laender  [ xyz:land  [ xyz:code           "BY";
                                                                                                                                                                      xyz:listURI        "urn:xoev-de:pks:codeliste:bundesland";
                                                                                                                                                                      xyz:listVersionID  "1";
                                                                                                                                                                      xyz:name           "Bayern"
                                                                                                                                                                    ]
                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergegenstand       [ xyz:beschreibung
                                                                                                                               "<p>Gefördert werden&nbsp;Laptops/Notebooks, Tablets oder Convertibles sowie ggf. von der Schule verbindlich vorgegebene Ausstattungskomponenten (Tastatur und/oder Stift).</p>\n<p>Mobile Endgeräte sind Endgeräte, die aufgrund ihrer Größe und ihres Gewichts ohne größere körperliche Anstrengung tragbar und somit mobil zur Sprach- und Datenkommunikation einsetzbar sind. Von der Zuwendung ausgenommen sind Mobilfunktelefone sowie Smartphones.</p>" ];
                                                                                                             xyz:foerdernehmende         [ xyz:foerdernehmende  [ xyz:code           "001";
                                                                                                                                                                  xyz:listURI        "urn:xoev-de:stmd:codeliste:foerdernehmende";
                                                                                                                                                                  xyz:listVersionID  "1";
                                                                                                                                                                  xyz:name           "Privatpersonen"
                                                                                                                                                                ]
                                                                                                                                         ];
                                                                                                             xyz:foerderrichtlinieUndFoerderprogramm
                                                                                                                     [ xyz:ablaufdatumRichtlinie     "2028-12-31";
                                                                                                                       xyz:geldgebendeInstitutionen  [ xyz:geldgebendeInstitution  [ xyz:code           "003";
                                                                                                                                                                                     xyz:listURI        "urn:xoev-de:stmd:codeliste:geldgebende-institution";
                                                                                                                                                                                     xyz:listVersionID  "1";
                                                                                                                                                                                     xyz:name           ""
                                                                                                                                                                                   ]
                                                                                                                                                     ];
                                                                                                                       xyz:handlungsgrundlagen       [ xyz:verweis  [ xyz:bezeichnung  "Digitale Schule der Zukunft - Lernen mit mobilen Endgeräten Bekanntmachung des Bayerischen Staatsministeriums für Unterricht und Kultus  vom 31. Mai 2024, Az. I.3-BO1371.2/14/2";
                                                                                                                                                                      xyz:link         "https://www.verkuendung-bayern.de/baymbl/2024-278/"
                                                                                                                                                                    ]
                                                                                                                                                     ];
                                                                                                                       xyz:programmtitel             "Formularserver zur Förderantragstellung Digitale Schule der Zukunft - Förderung der 1:1-Ausstattung von Schülerinnen und Schülern mit mobilen Endgeräten";
                                                                                                                       xyz:verantwortlichesFachreferat
                                                                                                                               "I.4";
                                                                                                                       xyz:verantwortlichesMinisterium
                                                                                                                               "Staatsministerium für Unterricht und Kultus"
                                                                                                                     ];
                                                                                                             xyz:foerdervoraussetzungen  [ xyz:ausschlusskriterien     "<p>Die Förderung ist insbesondere ausgeschlossen, wenn</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">ihr Kind keine 1:1-Ausstattungsklasse im Rahmen der Digitalen Schule der Zukunft besucht</li>\n  <li class=\"unordered-list-item--dash\">das Gerät nicht die vorgegebenen technischen Mindestkriterien erfüllt</li>\n  <li class=\"unordered-list-item--dash\">Sie bereits zwei Mal eine Förderung im Rahmen der Digitalen Schule der Zukunft erhalten</li>\n  <li class=\"unordered-list-item--dash\">der Antrag zu spät abgegeben wurde&nbsp;</li>\n</ul>";
                                                                                                                                           xyz:buergerfreundlicheBeschreibung
                                                                                                                                                   "<p>Voraussetzung um eine Förderung beantragen zu können ist, dass die Schulklasse Ihres Kindes als 1:1-Ausstattungsklasse an der Digitalen Schule der Zukunft teilnimmt. Zudem muss das beschaffte Gerät alle festgelegten technischen Kriterien erfüllen.</p>";
                                                                                                                                           xyz:rechtlicheBeschreibung  "<p>Zuwendungsempfängerinnen und -empfänger sind die volljährigen Schülerinnen und Schüler einer 1:1-Ausstattungsklasse, bei minderjährigen Schülerinnen und Schülern deren Erziehungsberechtigte. Ein mobiles Endgerät ist nur förderfähig, wenn es die zwingenden technischen Mindestkriterien und ggf. die zusätzlich festgelegten schulspezifischen technischen Mindestkriterien erfüllt.</p>"
                                                                                                                                         ];
