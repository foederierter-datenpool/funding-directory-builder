                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>771dd9cc-addb-4a4d-9d94-4966c6082ee9</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-01-25T14:34:58</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>771dd9cc-addb-4a4d-9d94-4966c6082ee9</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>771dd9cc-addb-4a4d-9d94-4966c6082ee9</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-01-25T14:34:58</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>771dd9cc-addb-4a4d-9d94-4966c6082ee9</xflb:foerderschluessel>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99148180017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Landarztprämie</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;In ländlichen Regionen mit alternder Bevölkerung, steigender medizinischer Nachfrage, älter werdender Ärzteschaft und eingeschränkter Erreichbarkeit kann die medizinische Versorgung unzureichend sein. Die Landarztprämie unterstützt daher die Niederlassung, Gründung von Medizinischen Versorgungszentren (MVZ) und Filialen. Sie gleicht Nachteile aus, die durch hohe Arbeitsbelastung, lange Wege, infrastrukturelle Defizite, weniger flexible Arbeitsmodelle sowie die Altersstruktur und Morbidität der Patientinnen und Patienten entstehen.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern gewährt eine Prämie für die Niederlassung von Ärztinnen und Ärzten, die Gründung von Medizinischen Versorgungszentren (MVZ) und Filialbildungen in medizinisch schlechter versorgten Regionen.</xflb:teaser>\n                  <xflb:schluesselwoerter>Gesundheitsversorgung, Landärzte, Landarzt</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Landarztprämie</xflb:bezeichnung>\n                     <xflb:link>https://www.lgl.bayern.de/gesundheit/gesundheitsversorgung/bayerische_gesundheitsagentur/niederlassungsfoerderung/index.htm</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Hinweise und Informationen über die einzelnen Anmeldeverfahren (BayernID oder Online-Ausweisfunktion)</xflb:bezeichnung>\n                     <xflb:link>https://id.bayernportal.de/de/faq</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Landesamt für Gesundheit und Lebensmittelsicherheit (LGL), Sachgebiet K1 -Landarztprämie-</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>6</xflb:hausnummerPostfach>\n                     <xflb:strasse>Prinzregentenstraße</xflb:strasse>\n                     <xflb:postleitzahl>97688</xflb:postleitzahl>\n                     <xflb:ort>Bad Kissingen</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>NL-Foerderung@lgl.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Gewährung einer Landarztprämie: Antragstellung</xflb:bezeichnung>\n                     <xflb:link>https://www.lgl.bayern.de/gesundheit/gesundheitsversorgung/bayerische_gesundheitsagentur/niederlassungsfoerderung/antragstellung.htm</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>09131 6808-2933</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Bayerisches Landesamt für Gesundheit und Lebensmittelsicherheit (LGL), Sachgebiet K1 -Landarztprämie-</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>6</xflb:hausnummerPostfach>\n                           <xflb:strasse>Prinzregentenstraße</xflb:strasse>\n                           <xflb:postleitzahl>97688</xflb:postleitzahl>\n                           <xflb:ort>Bad Kissingen</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>NL-Foerderung@lgl.bayern.de</xflb:email>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Gewährung einer Landarztprämie</xflb:bezeichnung>\n                           <xflb:link>https://www.lgl.bayern.de/gesundheit/gesundheitsversorgung/bayerische_gesundheitsagentur/niederlassungsfoerderung/antragstellung.htm</xflb:link>\n                        </xflb:verweis>\n                        <xflb:telefonnummer>09131 6808-2933</xflb:telefonnummer>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:onlinedienste>\n                  <xflb:onlinedienst>\n                     <xflb:id>d73b7320-f233-4e2e-b47b-cce67df7529c</xflb:id>\n                     <xflb:bezeichnung>Die Landarztprämie (LAP) - Online-Antrag</xflb:bezeichnung>\n                     <xflb:link>https://formularserver-bp.bayern.de/intelliform/forms/rzsued/stmuv/stmuv/lgl/landarztpraemie/index</xflb:link>\n                     <xflb:beschreibung>Die Antragstellung ist elektronisch über den Formularserver Bayern (IT-DLZ) mittels des dort bereitgestellten Antragsformulars vorzunehmen. Den Formularserver erreichen Sie unter den bereitgestellten Links. Seit dem 01.04.2023 ist eine Registrierung/Anmeldung über die Bayern-ID, bzw. die Online-Ausweisfunktion des Personalausweises erforderlich.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1101</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n               </xflb:onlinedienste>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Der Freistaat Bayern gewährt im Landarztprämiengebiet jeweils einmalig Prämien (Landarztprämie) für die vertragsärztliche Niederlassung als\n- Hausärztin oder Hausarzt,\n- Frauenärztin oder Frauenarzt,\n- Kinderärztin oder Kinderarzt,\n- Augenärztin oder Augenarzt,\n- Chirurgin oder Chirurg, Orthopädin oder Orthopäde,\n- Hautärztin oder Hautarzt,\n- HNO-Ärztin oder HNO-Arzt,\n- Nervenärztin oder Nervenarzt,\n- Urologin oder Urologe,\n- Psychotherapeutin oder Psychotherapeut oder\n- Kinder- und Jugendpsychiaterin oder Kinder- und Jugendpsychiater,\n\ndie Gründung von Medizinischen Versorgungszentren (MVZ) in den Fachrichtungen der genannten Fachrichtungen und\n\nFilialbildungen in den genannten Fachrichtungen</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>003</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Gefördert werden die Niederlassung oder Filialgründung von Ärztinnen, Ärzten und Vertragspsychotherapeutinnen und -therapeuten im Landarztprämiengebiet. Die Prämienhöhe richtet sich nach der Fachgruppe, Art der Niederlassung und dem Versorgungsauftrag:&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Hausärzte, Kinderärzte, Frauenärzte, Kinder- und Jugendpsychiater, Augenärzte, Chirurgen, Hautärzte, HNO-Ärzte, Nervenärzte, Orthopäden, Urologen:&lt;br&gt;\nNiederlassung: bis zu 60.000 €&lt;br&gt;\nFilialbildung: bis zu 15.000 €&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Vertragspsychotherapeutinnen und -therapeuten oder Gründung eines MVZ mit Fachrichtung Psychotherapie:&lt;br&gt;\nNiederlassung: bis zu 20.000 €&lt;br&gt;\nFilialbildung: bis zu 5.000 €&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong&gt;Anpassungen und Besonderheiten:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bei einem halben Versorgungsauftrag reduziert sich die Prämie um die Hälfte, bei drei Vierteln um ein Viertel.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;In Planungsbereichen mit Unterversorgung oder drohender Unterversorgung kann die Prämie zusätzlich neben anderen Förderungen gewährt werden (dann ggf. reduzierte Höhe: Ärztinnen/Ärzte bis 20.000 € / Filiale bis 5.000 €, Psychotherapie bis 6.700 € / Filiale bis 1.700 €).&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;In Gemeinden mit weniger als 5.000 Einwohnern oder in Bereichen mit überdurchschnittlich alter Ärzteschaft wird ein &lt;strong&gt;einmaliger Zuschlag von 10 %&lt;/strong&gt; der Prämie gewährt.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Prämie kann mit Zustimmung des Staatsministeriums für Gesundheit, Pflege und Prävention angepasst werden, wenn die Gesamtsumme aus Landesmitteln und KVB-Förderung niedriger ist als der Regelsatz.&lt;/li&gt;&lt;/ul&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Der Freistaat Bayern gewährt im Landarztprämiengebiet jeweils einmalig Prämien (Landarztprämie) für &amp;nbsp;die vertragsärztliche Niederlassung als &amp;nbsp;a) &amp;nbsp;Hausärztin oder Hausarzt, &amp;nbsp;b) &amp;nbsp;Frauenärztin oder Frauenarzt, &amp;nbsp;c) &amp;nbsp;Kinderärztin oder Kinderarzt, &amp;nbsp;d) &amp;nbsp;Augenärztin oder Augenarzt, &amp;nbsp;e) &amp;nbsp;Chirurgin oder Chirurg, Orthopädin oder Orthopäde, &amp;nbsp;f) &amp;nbsp;&amp;nbsp;Hautärztin oder Hautarzt, &amp;nbsp;g) &amp;nbsp;HNO-Ärztin oder HNO-Arzt, &amp;nbsp;h) &amp;nbsp;Nervenärztin oder Nervenarzt, &amp;nbsp;i) &amp;nbsp;Urologin oder Urologe, &amp;nbsp;j) &amp;nbsp;Psychotherapeutin oder Psychotherapeut oder &amp;nbsp;k) &amp;nbsp;Kinder- und Jugendpsychiaterin oder Kinder- und Jugendpsychiater&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n               <xflb:euBeihilferelevanz>Soweit nicht ausgeschlossen ist, dass die einzelne Gewährung der Landarztprämie als eine Beihilfe im Sinne des EU-Beihilferechts anzusehen ist, hat die Bewilligungsbehörde zur Freistellung der Landarztprämie von der Anmeldepflicht bei der Kommission die Verordnung (EU) 2023/2831 der Kommission vom 13. Dezember 2023 über die Anwendung der Artikel 107 und 108 des Vertrags über die Arbeitsweise der Europäischen Union auf De-minimis-Beihilfen (ABl. L, 2023/2831 vom 15. Dezember 2023 - im Folgenden: De-minimis-Verordnung) anzuwenden. Die Bewilligungsbehörde prüft in diesem Fall, ob die Voraussetzungen der De-minimis-Verordnung vorliegen. Der Antragsteller gibt daher bereits bei Antragstellung eine De-minimis-Erklärung gegenüber der Bewilligungsbehörde ab. Dem Antragsteller wird bei Vorliegen der Voraussetzungen der De-minimis-Verordnung eine De-minimis-Bescheinigung ausgehändigt. Diese ist vom Antragsteller zehn Jahre lang aufzubewahren und auf Anforderung der Europäischen Kommission, der Bundesregierung, Landesverwaltung oder bewilligenden Stelle innerhalb von einer Woche oder einer in der Anforderung festgesetzten längeren Frist vorzulegen. Wird die Bescheinigung innerhalb der Frist nicht vorgelegt, entfällt rückwirkend die Bewilligungsvoraussetzung und die Beihilfe zuzüglich Zinsen wird zurückgefordert.\n\nDie Landarztprämie ist eine Subvention gemäß § 264 des Strafgesetzbuches. Die für die Gewährung der Landarztprämie maßgeblichen Tatsachen sind subventionserheblich im Sinne dieser Bestimmungen (vgl. Art. 1 des Bayerischen Strafrechtsausführungsgesetzes vom 13. Dezember 2016) in der jeweils geltenden Fassung. Mit dem Antrag auf Gewährung einer Landarztprämie ist eine entsprechende Erklärung abzugeben.</xflb:euBeihilferelevanz>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Gesundheit, Pflege und Prävention</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 53 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO-53</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 48, 49 und 49a Bayerisches Verwaltungsverfahrensgesetz (BayVwVfG)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVwVfG-G3_2</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinie über die Gewährung einer Landarztprämie (Landarztprämienrichtlinie - LAPR)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2126_0_G_11619/true</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>31</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Förderung der Niederlassung von Ärzten und Psychotherapeuten im ländlichen Raum</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2028-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2021-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2028-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert wird die Niederlassung oder Filialgründung von Ärztinnen und Ärzten sowie Vertragspsychotherapeutinnen und -therapeuten im ländlichen Raum. Ziel ist es, die Entscheidung für eine Praxisgründung oder -übernahme zu erleichtern und die medizinische Versorgung in Gemeinden mit geringer Bevölkerungszahl zu sichern.&lt;/p&gt;&lt;p&gt;Voraussetzungen für die Förderung:&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Ansiedlung im Landarztprämiengebiet (Gemeinden mit höchstens 40.000 bzw. 20.000 Einwohnern je nach Fachgruppe)&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Aufnahme der ärztlichen Tätigkeit erfolgt, Antrag spätestens sechs Monate nach Tätigkeitsbeginn&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Verpflichtung zur Mindestausübung von 60 Monaten am geförderten Praxissitz; Änderungen oder Unterbrechungen über drei Monate müssen dem LGL angezeigt werden. Unterbrechungen aufgrund von Geburt oder Kindererziehung verlängern die Bindungsdauer entsprechend&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Die Förderung richtet sich an Ärztinnen und Ärzte sowie Psychotherapeutinnen und Psychotherapeuten, die eine Praxis im ländlichen Raum neu gründen oder übernehmen wollen.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>008</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Niederlassung oder Praxisübernahme muss im &lt;strong&gt;Landarztprämiengebiet&lt;/strong&gt; erfolgen. Dies sind Planungsbereiche des Bedarfsplans der Kassenärztlichen Vereinigung Bayerns, für die keine Zulassungsbeschränkungen nach § 103 Abs. 1 SGB V bestehen. Zulassungsbeschränkungen gelten nur, wenn Ausnahmen nach den §§ 100, 101 oder 103 SGB V möglich sind oder ein unmittelbares schwerwiegendes lokales Versorgungsdefizit besteht, das nicht durch andere Ärztinnen und Ärzte ausgeglichen werden kann.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die ärztliche Tätigkeit muss bereits aufgenommen sein, der Antrag ist &lt;strong&gt;spätestens sechs Monate nach Tätigkeitsbeginn&lt;/strong&gt; einzureichen.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die geförderte Tätigkeit muss &lt;strong&gt;mindestens 60 Monate am Praxissitz&lt;/strong&gt; ausgeübt werden. Änderungen oder Unterbrechungen von mehr als drei Monaten müssen dem Landesamt für Gesundheit und Lebensmittelsicherheit (LGL) angezeigt werden. Unterbrechungen aufgrund von Geburt oder Kindererziehung verlängern die Bindungsdauer entsprechend.&lt;/li&gt;&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver-bp.bayern.de/intelliform/forms/rzsued/stmuv/stmuv/lgl/landarztpraemie/index</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Die Antragstellung ist elektronisch über den Formularserver Bayern (IT-DLZ) mittels des dort bereitgestellten Antragsformulars vorzunehmen.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Seit dem 01.04.2023 ist eine Registrierung/Anmeldung über die Bayern-ID bzw. die Online-Ausweisfunktion des Personalausweises erforderlich.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Hinweise und Informationen über die einzelnen Anmeldeverfahren (BayernID oder Online-Ausweisfunktion) finden Sie unter \"Weiterführende Links\".&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>001</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:monate>1</xflb:monate>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>2</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristFest>\n                        <xflb:monate>6</xflb:monate>\n                     </xflb:fristFest>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Die Authentifizierung und die Antragstellung muss innerhalb von 6 Monaten nach der Aufnahme der ärztlichen Tätigkeit (Stichtag) erfolgen.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Antragstellung elektronisch über den Formularserver Bayern (IT-DLZ) mittels des dort bereitgestellten Antragsformulars.</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Arztregisterauszug der KVB</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Zulassungsrechtliche Entscheidung über die vertragsärztliche Tätigkeit des Antragstellers oder die Gründung eines MVZ</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>Verwaltungsgerichtliche Klage</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
