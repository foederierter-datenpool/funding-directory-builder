                                                                                                             xyz:finanzierung            [ xyz:euBeihilferelevanz        "Verordnung (EU) Nr. 651 2014 (Allgemeine Gruppenfreistellungsverordnung  AGVO); Beihilfen für Studien und Beratungsleistungen in den Bereichen Umweltschutz und Energie (Art. 49)";
                                                                                                                                           xyz:finanzierungsartUndHoehe  "Die Zuwendung wird auf Antrag in Form einer nicht rückzahlbaren Geldleistung als Projektförderung im Weg der Anteilfinanzierung gewährt. Im Falle einer AGVO-Förderung handelt es sich um einen Zuschuss nach Art. 5 Abs. 2a AGVO.";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "001";
                                                                                                                                                                                                    xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
                                                                                                                                                                                                    xyz:listVersionID  "1";
                                                                                                                                                                                                    xyz:name           ""
                                                                                                                                                                                                  ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:laufzeitFinanzierung      [ xyz:laufzeitFinanzierung  [ xyz:code           "001";
                                                                                                                                                                                                       xyz:listURI        "urn:xoev-de:stmd:codeliste:laufzeit-finanzierung";
                                                                                                                                                                                                       xyz:listVersionID  "1";
                                                                                                                                                                                                       xyz:name           "Gesamte Projektlaufzeit"
                                                                                                                                                                                                     ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1";
                                                                                                                                                                           xyz:name           ""
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Die Zuwendung wird auf Antrag in Form einer nicht rückzahlbaren Geldleistung als Projektförderung im Weg der Anteilfinanzierung gewährt. Die Zuwendung (Beihilfeintensität) für die im Rahmen der Studie entstandenen zuwendungsfähigen Ausgaben beträgt&nbsp;</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">für kommunale/ interkommunale Energienutzungspläne und Folgeenergienutzungspläne bis zu 70 % wobei für Energienutzungspläne mit interkommunalen Projektansatz in den Schwerpunktthemen erneuerbarer Wasserstoff oder Wärmenetze (insbesondere mit Tiefengeothermie) ein Förderbonus von bis zu 10 % zusätzlich möglich ist,</li>\n  <li class=\"unordered-list-item--dash\">für Umsetzungsbegleitungen bis zu 70 %,</li>\n  <li class=\"unordered-list-item--dash\">für Energiekonzepte bis zu 50 % bei kommunalen Gebietskörperschaften und Trägern kirchlicher oder anderer Einrichtungen ohne wirtschaftliche Tätigkeit sowie bis zu 40 % bei Unternehmen. Bei kleineren und mittleren Unternehmen (KMU) kann die Intensität um bis zu 10 % erhöht werden.</li>\n  <li class=\"unordered-list-item--dash\">Die Förderhöchstsumme bei Energiekonzepten beträgt 50.000 Euro, bei der Umsetzungsbegleitung 40.000 Euro und bei Folgeenergienutzungsplänen 20.000 Euro bzw. 40.000 Euro bei Folgeenergienutzungsplänen mit interkommunalem Untersuchungsgebiet.</li>\n</ul>"
                                                                                                                                         ];
