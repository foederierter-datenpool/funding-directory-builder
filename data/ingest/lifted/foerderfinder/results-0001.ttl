                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>348a43b4-13a4-4cdd-853c-de3bbd68e9e7</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-03-19T16:18:15</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>348a43b4-13a4-4cdd-853c-de3bbd68e9e7</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>348a43b4-13a4-4cdd-853c-de3bbd68e9e7</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-03-19T16:18:15</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>348a43b4-13a4-4cdd-853c-de3bbd68e9e7</xflb:foerderschluessel>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400297017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Selbsthilfegruppen von Menschen mit Behinderung</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>Zweck der Förderung ist es, die Betroffenen bei Selbsthilfemaßnahmen\n(Austausch, Information, Teilhabe am Leben der Gemeinschaft) zu unterstützen.</xflb:zuwendungszweck>\n                  <xflb:teaser>Selbsthilfegruppen von Menschen mit Behinderung können eine Förderpauschale für ihre Gruppenarbeit vom Freistaat Bayern erhalten.</xflb:teaser>\n                  <xflb:schluesselwoerter>Selbsthilfegruppe; Behinderung</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Selbsthilfegruppen für Menschen mit Behinderung oder chronischer Krankheit</xflb:bezeichnung>\n                     <xflb:link>http://www.zbfs.bayern.de/foerderung/behinderte-menschen/selbsthilfegruppen/index.php</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Zentrum Bayern Familie und Soziales</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>2</xflb:hausnummerPostfach>\n                     <xflb:strasse>Hegelstr</xflb:strasse>\n                     <xflb:postleitzahl>95447</xflb:postleitzahl>\n                     <xflb:ort>Bayreuth</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>poststelle@zbfs.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Website Zentrum Bayern Familie und Soziales</xflb:bezeichnung>\n                     <xflb:link>https://www.zbfs.bayern.de/foerderung/behinderte-menschen/selbsthilfegruppen/index.php</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>0921 605-03</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Zentrum Bayern Familie und Soziales</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>2</xflb:hausnummerPostfach>\n                           <xflb:strasse>Hegelstraße</xflb:strasse>\n                           <xflb:postleitzahl>95447</xflb:postleitzahl>\n                           <xflb:ort>Bayreuth</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>poststelle@zbfs.bayern.de</xflb:email>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Website ZBFS</xflb:bezeichnung>\n                           <xflb:link>https://www.zbfs.bayern.de/foerderung/behinderte-menschen/selbsthilfegruppen/index.php</xflb:link>\n                        </xflb:verweis>\n                        <xflb:telefonnummer>0921 605-3328</xflb:telefonnummer>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>d224fb3d-15e3-47de-ace0-ea434fac871b</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Gewährung einer staatlichen Zuwendung nach den Bestimmungen zur Förderung von Selbsthilfegruppen für Inklusion und Teilhabe von Menschen mit Behinderung oder chronischer Krankheit</xflb:bezeichnung>\n                     <xflb:link>https://www.zbfs.bayern.de/imperia/md/content/blvf/esf/selbsthilfegruppen/001_-_shg_-_antrag_02_25.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>52ba43ca-40b1-45a4-9a9a-db6f3e3fd6f0</xflb:id>\n                     <xflb:bezeichnung>Stellungnahme des Spitzenverbandes/des Landesbehindertenverbandes/der Landesarbeitsgemeinschaft Selbsthilfe in Bayern e.V. zum Förderantrag</xflb:bezeichnung>\n                     <xflb:link>https://www.zbfs.bayern.de/imperia/md/content/blvf/esf/selbsthilfegruppen/004_-_shg_-_antrag_stellungnahme.pdf</xflb:link>\n                     <xflb:beschreibung>&lt;p&gt;(ist vom Spitzenverband/ Landesbehindertenverband/ Landesarbeitsgemeinschaft Selbsthilfe in Bayern e. V. beizufügen)&lt;/p&gt;</xflb:beschreibung>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>d39a1c83-8079-4b1f-8fc8-e15c50dd467f</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Förderung von Selbsthilfegruppen - Anlage 2 Projektbeschreibung</xflb:bezeichnung>\n                     <xflb:link>https://www.zbfs.bayern.de/imperia/md/content/blvf/esf/selbsthilfegruppen/003_-_shg_-_anlage_2.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>c961d3e1-ef02-4290-9f1d-20b18d61e23b</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Förderung von Selbsthilfegruppen - Anlage 3 Stellungnahme zum Antrag (vom Spitzenverband beizufügen)</xflb:bezeichnung>\n                     <xflb:link>https://www.zbfs.bayern.de/imperia/md/content/blvf/esf/selbsthilfegruppen/004_-_shg_-_antrag_stellungnahme.pdf</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Zuwendungsempfänger sind örtliche Selbsthilfegruppen von Menschen mit körperlicher oder geistiger Behinderung oder chronischer Krankheit und/oder deren Familienangehörigen.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>Für die Kosten der Gruppenarbeit wird eine jährliche Förderpauschale von bis zu 400 Euro gezahlt.</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>Bewirtungs- und Verpflegungskosten, Fahrtkosten des Gruppenleiters, Veranstaltungskosten; Rabattschutzversicherung; im Detail siehe Merkblatt förderfähige Ausgaben</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerFest>\n                        <xflb:jahre>1</xflb:jahre>\n                     </xflb:dauerFest>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Familie, Arbeit und Soziales</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderung von Selbsthilfegruppen für Inklusion und Teilhabe von Menschen mit Behinderung oder chronischer Krankheit. Bekanntmachung des Bayerischen Staatsministeriums für Familie, Arbeit und Soziales vom 21. Dezember 2020, Az. II4/6418.10-1/68</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_8113_1_A_11725</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>II 4</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Behindertenhilfe; Beantragung einer Förderung für Selbsthilfegruppen von Menschen mit Behinderung</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2026-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2021-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2026-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Förderfähige Selbsthilfegruppen sind Zusammenschlüsse von Menschen mit körperlicher oder geistiger Behinderung oder chronischer Krankheit und/oder von deren Familienangehörigen auf örtlicher Ebene zum Zwecke gegenseitiger Hilfe. Mitglieder dieser Selbsthilfegruppen können außer den Menschen mit körperlicher oder geistiger Behinderung oder chronischer Krankheit und/oder ihren Familienangehörigen auch ehrenamtliche Helferinnen und Helfer sein, die die Betroffenen in den Gruppen unterstützen.&amp;nbsp;&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Die zu fördernden Selbsthilfegruppen sollen ständig mindestens sechs Mitglieder haben und grundsätzlich bereit sein, alle Betroffenen des Einzugsgebiets aufzunehmen.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:rechtlicheBeschreibung>&lt;p&gt;Die Hilfen in den Selbsthilfegruppen umfassen den regelmäßigen Austausch von Informationen und Erfahrungen und Hilfen zur Lebensbewältigung und Teilhabe am Leben der Gemeinschaft in eigenständigen Gruppentreffen. Schriftliche Informationen allein, die bloße Vermittlung von Hilfeleistungen, Teilnahme an Veranstaltungen Dritter oder das Aufstellen politischer Forderungen reichen nicht aus.&lt;/p&gt;</xflb:rechtlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.zbfs.bayern.de/imperia/md/content/blvf/esf/selbsthilfegruppen/001_-_shg_-_antrag_02_25.pdf</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Die Anträge der Selbsthilfegruppen sind schriftlich mittels der beim Zentrum Bayern Familie und Soziales (ZBFS) erhältlichen Vordrucke zu stellen. Zwei vertretungsberechtigte Gruppenmitglieder müssen den Antrag unterschreiben, eine Bankverbindung ist nötig.&amp;nbsp;&lt;/p&gt;\n&lt;p&gt;Die Selbsthilfegruppen reichen den Antrag auf Zuschuss bei einem Spitzenverband der freien Wohlfahrtspflege, bei einem Landesbehindertenverband, bei dem sie Mitglied sind, oder bei der Landesarbeitsgemeinschaft SELBSTHILFE von Menschen mit Behinderung und chronischer Erkrankung und ihrer Angehörigen in Bayern e. V. ein. Selbsthilfegruppen, die Mitglied bei mehreren Landesbehindertenverbänden sind, reichen den Antrag bei dem Landesverband ihrer Wahl ein. Selbsthilfegruppen, die keinem Landesverband angeschlossen sind, reichen den Antrag bei der LAG Selbsthilfe ein. Diese geben den Antrag nach Prüfung an das Zentrum Bayern Familie und Soziales (ZBFS) weiter, das über den Antrag entscheidet.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>003</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:monate>3</xflb:monate>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>6</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristdatum>2026-11-01</xflb:fristdatum>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Der Antrag muss am 1. November des Vorjahres bei der vorprüfenden Stelle (Behindertenverband, Wohlfahrtsverband, LAG Selbsthilfe) eingereicht sein.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Vollmacht, Mitgliedernachweis</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Beschreibung der Selbsthilfegruppe (nur bei erstmaliger Antragstellung oder bei gravierenden Änderungen der bisherigen Aufgaben)</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Stellungnahme des Spitzenverbandes / des Landesbehindertenverbandes / der Landesarbeitsgemeinschaft Selbsthilfe in Bayern e.V.</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Gegen einen ablehnenden Bescheid kann Klage erhoben werden. Diese ist beim zuständigen Verwaltungsgericht einzureichen.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_106  [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmfh/foerderung_hdrfoer/index?caller=bpgfstkzjrgfswimbumzsgcmjwhgtzy7juiq2bfz4uz7mtks2asv3uqvmju42soyh2tbwrgn6ijn5uemmt7sswrcwn6t32o4ipolfd33redwyj7afrffyyhh2g4v2v5acsyne5t2pm5kx6akrukurnovfryp7wtnzbwmiums7d3fh42sx64kv2aq6puhbdi7pc6h7bzrbub2tvo888";
                                xyz:begriffeImKontext    [ rdf:_1   "HDRFöR";
                                                           rdf:_10  "Regionale Entwicklung";
                                                           rdf:_11  "Heimat digital regional";
                                                           rdf:_12  "Heimat digital";
                                                           rdf:_2   "Heimat-Digital-Förderrichtlinie";
                                                           rdf:_3   "Heimat-Digital-Regional-Förderrichtlinie";
                                                           rdf:_4   "Regionale Identität";
                                                           rdf:_5   "Digitale Heimatprojekte";
                                                           rdf:_6   "Regionalentwicklung";
                                                           rdf:_7   "Heimat-digital-regional";
                                                           rdf:_8   "Heimat-digital";
                                                           rdf:_9   "Heimat Förderung"
                                                         ];
                                xyz:beschreibung         "<p>Die Förderung unterstützt Bayerns Regionen dabei, mit digitalen Ansätzen die regionale Entwicklung voranzubringen. Sie leistet einen Beitrag, gleichwertige Lebens- und Arbeitsbedingungen in ganz Bayern zu fördern und zu sichern, die digitale Teilhabe und digitale Chancengleichheit in allen Regionen Bayerns zu ermöglichen und die Attraktivität von Verdichtungsraum und ländlichem Raum zu stärken. Die geförderten Projekte sollen dazu beitragen, lebenswerte Heimat in allen bayerischen Landesteilen zu erhalten und zu gestalten sowie die Stärkung des Heimatbewusstseins und der Heimatverbundenheit der Bürger zu unterstützen.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Anteilsfinanzierung/Kapitalbeteiligung" ];
                                xyz:foerderbereich       [ rdf:_1   "Arbeit";
                                                           rdf:_10  "Umwelt- und Naturschutz";
                                                           rdf:_2   "Aus und Weiterbildung";
                                                           rdf:_3   "Digitalisierung";
                                                           rdf:_4   "Energieeffizienz und Erneuerbare Energien";
                                                           rdf:_5   "Gesundheit und Soziales";
                                                           rdf:_6   "Infrastruktur";
                                                           rdf:_7   "Kultur, Medien und Sport";
                                                           rdf:_8   "Regionalförderung";
                                                           rdf:_9   "Smart Cities und Regionen"
                                                         ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Vereine";
                                                           rdf:_2  "Kommunen";
                                                           rdf:_3  "Verbände";
                                                           rdf:_4  "Stiftungen";
                                                           rdf:_5  "Einzelunternehmen";
                                                           rdf:_6  "Kleine und mittlere Unternehmen"
                                                         ];
                                xyz:foerderprogramm      "Heimat-Digital-Regional-Förderrichtlinie (HDRFöR)";
                                xyz:foerderzeitraum.bis  "2026-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2021-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "a6d62298-ae06-464c-86b6-0a8307aa9578";
                                xyz:teaser               "Der Freistaat Bayern fördert innovative, fachübergreifende Heimatprojekte mit Schwerpunkt Digitalisierung, die sich positiv auf die räumliche Entwicklung Bayerns auswirken und insbesondere der Stärkung der regionalen Identität dienen.";
                                xyz:titel                "Förderung digitaler regionaler Heimatprojekte";
                                xyz:titel.tokens         [ rdf:_1  "Förderung digitaler regionaler Heimatprojekte" ];
                                xyz:voraussetzung        "<ul>\n  <li class=\"unordered-list-item--dash\">Heimatprojekt: Das Projekt wirkt sich positiv auf die räumliche Entwicklung Bayerns aus und dient insbesondere der Stärkung der regionalen Identität.</li>\n  <li class=\"unordered-list-item--dash\">Fachübergreifender Ansatz: Das Projekt deckt mindestens zwei Themenbereiche ab. Hier kann insbesondere auf die Stärkung regionaler Identität abgezielt werden, aber beispielsweise auch auf Kultur/Heimatkultur, Daseinsvorsorge, ärztliche Versorgung, ÖPNV, Barrierefreiheit, Integration oder Klima.</li>\n  <li class=\"unordered-list-item--dash\">Innovativer Projektinhalt: Das Projekt geht inhaltlich, technologisch oder methodisch über bereits bestehende Ansätze im jeweiligen Themenfeld der räumlichen Entwicklung in Bayern hinaus und bietet dadurch einen erkennbaren Mehrwert gegenüber bislang vorhandenen Ansätzen.</li>\n  <li class=\"unordered-list-item--dash\">Digitaler Schwerpunkt: Im Rahmen des Projekts entsteht zum Beispiel eine App oder Internetplattform oder es werden \"smarte\" oder vernetzte Anwendungen realisiert. Im Falle einer Machbarkeitsstudie ist die Möglichkeit und Perspektive einer Digitalisierung zwingend zu prüfen.</li>\n</ul>\n<p>Antrags- und zuwendungsberechtigt sind Landkreise, Bezirke, kreisfreie Städte, Vereine, Stiftungen sowie steuerbegünstigte Unternehmergesellschaften (haftungsbeschränkt) und Gesellschaften mit beschränkter Haftung.&nbsp;Hinzu kommen auch andere Rechtsträger des öffentlichen oder privaten Rechts, wenn mindestens ein Mitglied oder Gesellschafter ein Landkreis, Bezirk oder eine kreisfreie Stadt ist.</p>"
                              ];
              xyz:id          "a6d62298-ae06-464c-86b6-0a8307aa9578";
              xyz:payload     [ xyz:json  [ xyz:anfrage            [ xyz:anfragenummer  "a6d62298-ae06-464c-86b6-0a8307aa9578";
                                                                     xyz:flb            [ xyz:konkreteFLB  [ xyz:allgemeineAngaben       [ xyz:beschreibung       [ xyz:schluesselwoerter  "HDRFöR, Heimat-Digital-Förderrichtlinie, Heimat-Digital-Regional-Förderrichtlinie, Regionale Identität, Digitale Heimatprojekte, Regionalentwicklung, Heimat-digital-regional, Heimat-digital, Heimat Förderung, Regionale Entwicklung, Heimat digital regional, Heimat digital";
                                                                                                                                                                    xyz:teaser             "Der Freistaat Bayern fördert innovative, fachübergreifende Heimatprojekte mit Schwerpunkt Digitalisierung, die sich positiv auf die räumliche Entwicklung Bayerns auswirken und insbesondere der Stärkung der regionalen Identität dienen.";
                                                                                                                                                                    xyz:zuwendungszweck    "<p>Die Förderung unterstützt Bayerns Regionen dabei, mit digitalen Ansätzen die regionale Entwicklung voranzubringen. Sie leistet einen Beitrag, gleichwertige Lebens- und Arbeitsbedingungen in ganz Bayern zu fördern und zu sichern, die digitale Teilhabe und digitale Chancengleichheit in allen Regionen Bayerns zu ermöglichen und die Attraktivität von Verdichtungsraum und ländlichem Raum zu stärken. Die geförderten Projekte sollen dazu beitragen, lebenswerte Heimat in allen bayerischen Landesteilen zu erhalten und zu gestalten sowie die Stärkung des Heimatbewusstseins und der Heimatverbundenheit der Bürger zu unterstützen.</p>"
                                                                                                                                                                  ];
