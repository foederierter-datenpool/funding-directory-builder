                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>298c967c-a5a4-413d-bd43-a077c40e2ede</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2026-09-04T11:06:02</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>298c967c-a5a4-413d-bd43-a077c40e2ede</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>298c967c-a5a4-413d-bd43-a077c40e2ede</xflb:schluessel>\n         <xflb:versionFLB>3</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-09-07T11:55:02</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>298c967c-a5a4-413d-bd43-a077c40e2ede</xflb:foerderschluessel>\n                  <xflb:flbVersion>3</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400019017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Förderung besonderer Maßnahmen zur Stärkung des Integrationsprozesses</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Ziel der Förderung ist die Unterstützung von Projekten, die auf die Stärkung des Integrationsprozesses von Menschen mit Migrationsgeschichte und von Asylbewerberinnen und Asylbewerbern mit guter Bleibeperspektive ausgerichtet sind.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Die gelingende Integration von Menschen mit Migrationsgeschichte bzw. guter Bleibeperspektive wird  vom Freistaat Bayern durch spezielle Integrationsprojekte (sog. \"besondere Maßnahmen\") unterstützt.</xflb:teaser>\n                  <xflb:schluesselwoerter>Integrationsprozess, Integrationsprojekte</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Regierung von Mittelfranken - Sachgebiet 15 - Integration und Förderung, Ausgleichsamt</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>21</xflb:hausnummerPostfach>\n                     <xflb:strasse>Marienstraße</xflb:strasse>\n                     <xflb:postleitzahl>90402</xflb:postleitzahl>\n                     <xflb:ort>Nürnberg</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>Sachgebiet-15.Integration@reg-mfr.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Übersicht der Regierung von Mittelfranken</xflb:bezeichnung>\n                     <xflb:link>https://www.regierung.mittelfranken.bayern.de/aufgaben/40027/57461/leistung/leistung_53004/index.html</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>+49 (0)911 2352-0</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Regierung von Mittelfranken - Sachgebiet 15 - Integration und Förderung, Ausgleichsamt</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>21</xflb:hausnummerPostfach>\n                           <xflb:strasse>Marienstraße</xflb:strasse>\n                           <xflb:postleitzahl>90402</xflb:postleitzahl>\n                           <xflb:ort>Nürnberg</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>Sachgebiet-15.Integration@reg-mfr.bayern.de</xflb:email>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Übersicht der Regierung von Mittelfranken</xflb:bezeichnung>\n                           <xflb:link>https://www.regierung.mittelfranken.bayern.de/aufgaben/40027/57461/leistung/leistung_53004/index.html</xflb:link>\n                        </xflb:verweis>\n                        <xflb:telefonnummer>+49 (0)911 2352-188</xflb:telefonnummer>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:onlinedienste>\n                  <xflb:onlinedienst>\n                     <xflb:id>2ea9832f-8d01-4ede-a876-2dda07de063f</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Auszahlung der Zuwendung nach der Beratungs- und Integrationsrichtlinie (BIR III) - Besondere Maßnahmen</xflb:bezeichnung>\n                     <xflb:link>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/rmf_15-036_zz_auszahlungsantrag_bm/index?caller=bpgjrdozrwhbstiyjvhfqtaobtmwpa7l7kbmah7fttz24zkz7ua6nko7g7bwgc4g7sepsq45pv3veqfbqshn7lqwb4gbenfznfmuuift7grbzumxy74g32c5l3j6sryhyy55psftox6m5senwvxgdo2bb7xukyn4vxer7nbtz7dfrpizm6i7n34m265prs4fvnjq4h63ix2d3ap3j5ygwtxyjcekc3obvzciujjbnzxtm4kook4mnmher5ecfwfudr</xflb:link>\n                     <xflb:beschreibung>Sie können die Auszahlung der Förderung nach der Beratungs- und Integrationsrichtlinie für besondere Maßnahmen online beantragen.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n                  <xflb:onlinedienst>\n                     <xflb:id>643e6b69-8e67-4ba8-833f-3dce143bb356</xflb:id>\n                     <xflb:bezeichnung>Verwendungsnachweis für eine Förderung nach der Beratungs- und Integrationsrichtlinie - Besondere Maßnahmen</xflb:bezeichnung>\n                     <xflb:link>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/rmf_15-013_zz_verwendungsnachweis_bm/index?caller=bpgq2dknrrmq4dqn3emnrdgobqmtydbg22o6tvu2aqioggds4tzhslklwjpuqmr77krxarnxuesr4ntafhrda6x3b5ev6vlhvpydqbctjn5g2slikxw5pqalbpfsbh4d3qmvh5r26dc2xfvcyiky4up3r7dlhqevdoovfx66nnopozxv5lmhcjgi5ejig43yp2q4bnrai4fdbqbuyoylxbl37efzent2udqletkqqbi3suqaqhbvj6bez6c7ohh5ww</xflb:link>\n                     <xflb:beschreibung>Sie können den Verwendungsnachweis für die Förderung nach der Beratungs- und Integrationsrichtlinie für besondere Maßnahmen online einreichen.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n               </xflb:onlinedienste>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Zuwendungsempfänger sind rechtsfähige Träger, die über die erforderliche Zuverlässigkeit und  Leistungsfähigkeit zur Durchführung dieser Maßnahmen verfügen bzw. deren bisherige  Tätigkeit eine erfolgreiche Erfüllung des Förderzwecks erwarten lässt.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Zuwendung wird als Anteilfinanzierung im Rahmen einer Projektförderung gewährt; jedoch bis maximal 90% der zuwendungsfähigen Ausgaben.&lt;/p&gt;&lt;p&gt;Die staatliche Förderung setzt eine Beteiligung des Zuwendungsempfängers in Höhe von mindestens 10% der zuwendungsfähigen Projektausgaben voraus, die auch über Drittmittel erbracht werden kann.&lt;/p&gt;&lt;p&gt;Die Förderung erfolgt ohne Rechtsanspruch im Rahmen zur Verfügung stehender Haushaltsmittel.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Zuwendungsfähig sind projektbezogene Personal- und Sachausgaben im Rahmen des Zuwendungszwecks. Die Höhe der zuwendungsfähigen Personalausgaben bemisst sich nach dem Personalausgabenhöchstsatz.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n               <xflb:euBeihilferelevanz>unzutreffend</xflb:euBeihilferelevanz>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium des Innern, für Sport und Integration</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinie für die Förderung der sozialen Beratung, Betreuung und Integration von Menschen mit Migrationsgeschichte (Beratungs- und Integrationsrichtlinie - BIR) vom 26. September 2023</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2176_I_14046</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Sachgebiet G3</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Richtlinie für die Förderung der sozialen Beratung, Betreuung und Integration von Menschen mit Migrationsgeschichte (Beratungs- und Integrationsrichtlinie - BIR)</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2026-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2024-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2026-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert wird im Rahmen des Zuwendungszwecks die projektbezogene Durchführung von besonderen Maßnahmen.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>022</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Die Projekte können insbesondere aus den Bereichen kulturelle Integration, Stärkung von Familien und Müttern als Schlüsselrolle im Integrationsprozess sowie Jugend und Ehrenamt kommen.&amp;nbsp;Auf die gesetzlichen Regelungen zum Kinder- und Jugendschutz bezüglich der Vorlage eines (erweiterten) Führungszeugnisses wird hingewiesen.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/rmf_15-036_zz_auszahlungsantrag_bm/index?caller=bpgjrdozrwhbstiyjvhfqtaobtmwpa7l7kbmah7fttz24zkz7ua6nko7g7bwgc4g7sepsq45pv3veqfbqshn7lqwb4gbenfznfmuuift7grbzumxy74g32c5l3j6sryhyy55psftox6m5senwvxgdo2bb7xukyn4vxer7nbtz7dfrpizm6i7n34m265prs4fvnjq4h63ix2d3ap3j5ygwtxyjcekc3obvzciujjbnzxtm4kook4mnmher5ecfwfudr</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;h4&gt;Antragstellung&lt;/h4&gt;&lt;p&gt;Anträge sind unter Verwendung der bei der Regierung von Mittelfranken erhältlichen Vordrucke zu erstellen und bei dieser einzureichen. Dem Staatsministerium des Innern, für Sport und Integration ist ein Abdruck (mit Anlagen) zu übersenden. Den Anträgen sind ein Ausgaben- und Finanzierungsplan, der auf die pauschalierten Personalausgaben abstellt, sowie eine Übersicht über das eingesetzte Personal beizufügen. Zusätzlich ist ein aussagekräftiges Projektkonzept einzureichen, in dem auf die Situation vor Ort, die im Projekt geplanten Maßnahmen und den gewünschten Erfolg (bzw. wie dieser erreicht wird) eingegangen wird.&lt;/p&gt;&lt;h4&gt;Bewilligung&lt;/h4&gt;&lt;p&gt;Zuständig für die Bewilligung ist die Regierung von Mittelfranken. Zuwendungen können grundsätzlich nur dann bewilligt werden, wenn mit dem jeweiligen Projekt noch nicht begonnen wurde. Der Bewilligungszeitraum beträgt bis zu drei Jahren.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristdatum>2026-12-31</xflb:fristdatum>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Der Bewilligungszeitraum beträgt bis zu drei Jahre (Ende mit Außerkrafttreten der Richtlinie). Der Zuwendungsempfänger kann eine einjahres-, zweijahres- oder dreijahresbezogene Förderung beantragen. Der Antrag ist vor Beginn des Bewilligungszeitraums grundsätzlich bis spätestens 15. November des Vorjahres zu stellen. Etwaige Änderungen nach Antragstellung können der Bewilligungsbehörde noch bis spätestens 15. März des Bewilligungszeitraums mitgeteilt werden.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Ausgaben- und Finanzierungsplan</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Übersicht über das eingesetzte Personal und dessen Ausgaben sowie über die sonstigen Ausgaben</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Projektkonzept (aussagekräftiges Konzept der geplanten Maßnahme)</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Gegen den Zuwendungsbescheid können Sie innerhalb eines Monats nach seiner Bekanntgabe Klage erheben. Das zuständige Gericht, bei dem Sie Klage einreichen können, wird Ihnen im Bescheid mitgeteilt.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_7    [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver-bp.bayern.de/intelliform/forms/rzsued/stmuv/stmuv/lgl/landarztpraemie/index";
                                xyz:begriffeImKontext    [ rdf:_1  "Gesundheitsversorgung";
                                                           rdf:_2  "Landärzte";
                                                           rdf:_3  "Landarzt"
                                                         ];
                                xyz:beschreibung         "<p>In ländlichen Regionen mit alternder Bevölkerung, steigender medizinischer Nachfrage, älter werdender Ärzteschaft und eingeschränkter Erreichbarkeit kann die medizinische Versorgung unzureichend sein. Die Landarztprämie unterstützt daher die Niederlassung, Gründung von Medizinischen Versorgungszentren (MVZ) und Filialen. Sie gleicht Nachteile aus, die durch hohe Arbeitsbelastung, lange Wege, infrastrukturelle Defizite, weniger flexible Arbeitsmodelle sowie die Altersstruktur und Morbidität der Patientinnen und Patienten entstehen.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Arbeit";
                                                           rdf:_2  "Existenzgründung und -festigung";
                                                           rdf:_3  "Gesundheit und Soziales";
                                                           rdf:_4  "Infrastruktur"
                                                         ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Privatpersonen" ];
                                xyz:foerderprogramm      "Förderung der Niederlassung von Ärzten und Psychotherapeuten im ländlichen Raum";
                                xyz:foerderzeitraum.bis  "2028-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2021-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "771dd9cc-addb-4a4d-9d94-4966c6082ee9";
                                xyz:teaser               "Der Freistaat Bayern gewährt eine Prämie für die Niederlassung von Ärztinnen und Ärzten, die Gründung von Medizinischen Versorgungszentren (MVZ) und Filialbildungen in medizinisch schlechter versorgten Regionen.";
                                xyz:titel                "Landarztprämie";
                                xyz:titel.tokens         [ rdf:_1  "Landarztprämie" ];
                                xyz:voraussetzung        "<ul><li class=\"unordered-list-item--dash\">Die Niederlassung oder Praxisübernahme muss im <strong>Landarztprämiengebiet</strong> erfolgen. Dies sind Planungsbereiche des Bedarfsplans der Kassenärztlichen Vereinigung Bayerns, für die keine Zulassungsbeschränkungen nach § 103 Abs. 1 SGB V bestehen. Zulassungsbeschränkungen gelten nur, wenn Ausnahmen nach den §§ 100, 101 oder 103 SGB V möglich sind oder ein unmittelbares schwerwiegendes lokales Versorgungsdefizit besteht, das nicht durch andere Ärztinnen und Ärzte ausgeglichen werden kann.</li><li class=\"unordered-list-item--dash\">Die ärztliche Tätigkeit muss bereits aufgenommen sein, der Antrag ist <strong>spätestens sechs Monate nach Tätigkeitsbeginn</strong> einzureichen.</li><li class=\"unordered-list-item--dash\">Die geförderte Tätigkeit muss <strong>mindestens 60 Monate am Praxissitz</strong> ausgeübt werden. Änderungen oder Unterbrechungen von mehr als drei Monaten müssen dem Landesamt für Gesundheit und Lebensmittelsicherheit (LGL) angezeigt werden. Unterbrechungen aufgrund von Geburt oder Kindererziehung verlängern die Bindungsdauer entsprechend.</li></ul>"
                              ];
              xyz:id          "771dd9cc-addb-4a4d-9d94-4966c6082ee9";
              xyz:payload     [ xyz:json  [ xyz:anfrage            [ xyz:anfragenummer  "771dd9cc-addb-4a4d-9d94-4966c6082ee9";
