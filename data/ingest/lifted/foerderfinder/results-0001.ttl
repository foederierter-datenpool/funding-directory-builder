                                xyz:xml   "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           produkt=\"Förderfinder\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produktversion=\"\"\n                                           standard=\"XFLB\"\n                                           test=\"\"\n                                           version=\"2.0.0\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0 xflb.xsd\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>4cf5cd54-c424-4b1a-b97e-8278f63b6b62</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2023-12-22T11:31:35</xflb:erstellungszeitpunkt>\n      <xflb:sender>Förderfinder Suche (Bayern)</xflb:sender>\n      <xflb:empfaenger>XFLB-Connect (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>4cf5cd54-c424-4b1a-b97e-8278f63b6b62</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>4cf5cd54-c424-4b1a-b97e-8278f63b6b62</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:zuordnungen>\n               <xflb:leika>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"1\">\n                        <code>4</code>\n                        <name>Regelungskompetenz auf Landesebene</name>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n               <xflb:interneKennung>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n                  <xflb:foerderschluessel>4cf5cd54-c424-4b1a-b97e-8278f63b6b62</xflb:foerderschluessel>\n               </xflb:interneKennung>\n            </xflb:zuordnungen>\n            <xflb:finanzierung>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Der aufnehmende Zweckverband erhält, jeweils für Anlagen der öffentlichen Wasserversorgung und Abwasserentsorgung, 40 Euro je aufgenommenen Einwohner einmalig im 4-Jahres-Zeitraum gemäß Nr. 9, maximal 100 000 Euro. Zusätzlich erhält der aufnehmende Zweckverband die Zuwendung, die der aufgenommene Einrichtungsträger nach den Nrn. 2.2.1 bis 2.2.3 erhalten würde, wenn er noch eigenständig wäre. Für die Abgabe der Betriebsführung an einen Zweckverband oder ein gemeinsames Kommunalunternehmen (gkU) gibt es 20 Euro je Einwohner, einmalig im 4-Jahres-Zeitraum gemäß Nr. 9, maximal 50 000 Euro.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>Die Härtefallförderung erfolgt bei Vorhaben nach Nrn. 2.2.3, 2.2.4 und 2.2.5 mit Förderpauschalen anhand von Einwohnerzahlen.</xflb:zuwendungsfaehigeKosten>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:zuwendungsart>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerSpanne>\n                        <xflb:maxDauer>\n                           <xflb:jahre>4</xflb:jahre>\n                        </xflb:maxDauer>\n                        <xflb:minDauer>\n                           <xflb:jahre>1</xflb:jahre>\n                        </xflb:minDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name>Bayern</name>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name>Kommunen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name>Verbände</name>\n               </xflb:foerdernehmende>\n            </xflb:foerdernehmende>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Beitritt des Einrichtungsträgers zu einem Zweckverband oder die Abgabe der Betriebsführung auf einen Zweckverband oder ein Gemeinsames kommunal Unternehmen (gkU)</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:teaser>Der Freistaat Bayern unterstützt die bayerischen Städte und Gemeinden beim Beitritt zu einem Zweckverband in Härtefällen mit Zuwendungen.</xflb:teaser>\n                  <xflb:zuwendungszweck>&lt;p&gt;Der Beitritt eines Einrichtungsträgers zu einem Zweckverband (sowohl bei Abwasserentsorgern, als auch Wasserversorgern) gefördert. Ebenso die Abgabe der Betriebsführung auf einen Zweckverband oder ein gemeinsames kommunal Unternehmen (gkU).&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:schluesselwoerter>Wasserversorgungsanlagen, Zuwendungen zu Abwasserentsorgungsanlagen, Förderung von Abwasseranlagen, Zuwendungen zu Abwasserbeseitigung, Abwasserbeseitigung Förderung, Zuwendungen zur öffentlichen Trinkwasserversorgung, Härtefallförderung, Zweckverbände</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:allgemeineFragen>\n                  <xflb:name>regional zuständiges Wasserwirtschaftsamt</xflb:name>\n                  <xflb:verweis>\n                     <xflb:link>https://www.stmuv.bayern.de/themen/wasserwirtschaft/wasserwirtschaft_in_bayern/wasseraemter.htm</xflb:link>\n                     <xflb:bezeichnung>zuständiges Wasserwirtschaftsamt</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Ihr zuständiges Wasserwirtschaftsamt</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:link>http://www.stmuv.bayern.de/themen/wasserwirtschaft/foerderung/index.htm</xflb:link>\n                     <xflb:bezeichnung>Förderung wasserwirtschaftlicher Vorhaben</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Der Beitritt des Einrichtungsträgers zu einem Zweckverband und/oder die Abgabe der Betriebsführung auf einen Zweckverband oder ein gemeinsames kommunal UNternehmen nach Nr. 2.2.4 der RZWas 2025.&lt;/p&gt;\n&lt;p&gt;Näheres siehe Handbuch zur RZWas 2025 (Stand 04/2025), Seite 10&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2023-12-22T11:31:35</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index</xflb:linkZurAntragsstellung>\n               <xflb:antragsfrist>\n                  <xflb:bemerkung>Es gilt der Posteinlaufstempel des zuständigen Wasserwirtschaftsamtes.</xflb:bemerkung>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristdatum>2028-09-30</xflb:fristdatum>\n                  </xflb:zeitlicheEingrenzung>\n               </xflb:antragsfrist>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>- Der Zuwendungsantrag ist beim örtlich zuständigen Wasserwirtschaftsamt zu stellen.\n- Nach erfolgreicher Prüfung erfolgt die Aufnahme in das Härtefallprogramm. Das Wasserwirtschaftsamt erlässt den Zuwendungsbescheid.\n- Zuwendungen können maximal einmal jährlich nach Vorlage einer Verwendungsbestätigung beim Wasserwirtschaftsamt abgerufen werden.\n- Zu den Details berät das örtlich zuständige Wasserwirtschaftsamt.</xflb:bewilligung>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>Wenn die Zuwendungsvoraussetzungen erfüllt waren, kann der Förderantrag auch nach Vertragsabschluss gestellt werden.</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>006</code>\n                     <name/>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Beitrittserklärung</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Nachweis über den Beitritt in Form eines Vertrages.</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:wochen>2</xflb:wochen>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:wochen>6</xflb:wochen>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n            </xflb:antragsinformationen>\n            <xflb:foerdervoraussetzungen>\n               <xflb:ausschlusskriterien>&lt;p&gt;Gebietskörperschaften, deren Eigenbetriebe sowie deren Unternehmen in Privatrechtsform, mit mehr als 20 000 Einwohnern werden nicht gefördert. Unternehmen in Privatrechtsform sowie Wasser- und Bodenverbände an denen Gebietskörperschaften zu weniger als 100 Prozent beteiligt sind. Ausgenommen von der Förderung sind folgende Fernwasserversorgungsunternehmen: Bayer. Rieswasser, &amp;nbsp;WV Bayerischer Wald, Fernwasserversorgung Franken, WV Steinwaldgruppe, &amp;nbsp;Fernwasserversorgung Oberfranken, ZV WV Fränk Wirtschaftsraum, Fernwasserversorgung Mittelmain, &amp;nbsp;ZV WV Spessartgruppe, Fernwasserversorgung Oberes Allgäu, ZV WV Reckenberger- Gruppe, ZV WV Rhön-Maintal-Gruppe, ZV WV Steinwaldgruppe&lt;/p&gt;</xflb:ausschlusskriterien>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Für Vorhaben nach Nrn. 2.2.1 und 2.2.3 wird die Förderung gewährt, wenn die nach Anlage 2 RZWas 2025 ermittelte Pro-Kopf-Belastung des beitretenden Satzungsgebietes eine der Härtefallschwellen nach Nr. 4.3 RZWas 2025 im aktuellen Kalenderjahr überschreitet. Für Vorhaben nach Nr. 2.2.4. muss keine Härtefallschwelle erreicht werden. Antragsteller ist der aufnehmende Zweckverband. Der Zweckverband muss alle Anlagen und Aufgaben aus dem Satzungsgebiet des Einrichtungsträgers übernehmen, auch den Ortskanal (Schmutz- und Niederschlagswasser). Es reicht nicht, dass der Zweckverband nur den Sammler oder nur die Kläranlage betreibt. Der Zweckverband muss Beiträge und Gebühren erheben (keine Innenzweckverbände). Weitere Details erfahren Sie bei Ihrem örtlich zuständigen Wasserwirtschaftsamt.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:programmtitel>Richtlinien für Zuwendungen zu wasserwirtschaftlichen Vorhaben (RZWas 2025)</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2028-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:verantwortlichesFachreferat>Referat 58 - Schutz oberirdischer Gewässer, Abwasserentsorgung</xflb:verantwortlichesFachreferat>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Umwelt und Verbraucherschutz</xflb:verantwortlichesMinisterium>\n               <xflb:programmlaufzeit>\n                  <xflb:endeLaufzeitFoerderprogramm>2028-12-31</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:beginnLaufzeitFoerderprogramm>2024-04-01</xflb:beginnLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_7538_U_15039?hl=true</xflb:link>\n                     <xflb:bezeichnung>Richtlinien für Zuwendungen zu wasserwirtschaftlichen Vorhaben (RZWas 2025)</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>019</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>\n"
                              ]
            ];
  rdf:_128  [ xyz:attributes  [ xyz:antragsstellung      "https://www.bayern-innovativ.de/de/seite/foerderprogramm-zum-aufbau-einer-wasserstofftankstelleninfrastruktur-in-bayern";
                                xyz:beschreibung         "Ziel der Förderung ist der Aufbau einer öffentlichen und betriebsinternen Infrastruktur zur Treibstoffversorgung mit Wasserstoff in allen Teilen Bayerns. Im Fokus der bayerischen Förderung steht die Infrastruktur für wasserstoffbetriebene Nutzfahrzeuge und Kraftomnibusse sowie Sonderfahrzeuge in der Logistik in Bayern, da hier die größten Potentiale gesehen werden. Damit wird im Einklang mit der Bayerischen Wasserstoffstrategie der Aufbau einer Basis-Wasserstoffbetankungsinfrastruktur in Bayern angestrebt. Dadurch soll insbesondere auch ein Anreiz für die Investition in die Tankstelleninfrastruktur durch Omnibus/Logistikunternehmen oder Stadtwerke und die Markteinführung von umweltfreundlichen und wettbewerbsfähigen wasserstoffbetriebenen Nutzfahrzeugen und Bussen geschaffen werden. Zugleich wird mit der Förderung ein Beitrag zur Reduktion der energiebedingten CO2-Emissionen und zum Klimaschutz im Energie- und Verkehrssektor geleistet sowie neue Arbeitsplätze in Bayern geschaffen.";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Energieeffizienz und Erneuerbare Energien" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Großunternehmen";
                                                           rdf:_2  "Kleine und mittlere Unternehmen";
                                                           rdf:_3  "Privatpersonen"
                                                         ];
                                xyz:foerderzeitraum.bis  "2024-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2020-10-01T00:00:00.000+00:00";
                                xyz:schluessel           "6d28d146-79a8-41c3-bb34-9739f7d052a3";
                                xyz:teaser               "Förderung von betriebsinternen Wasserstofftankstellen";
                                xyz:titel                "Betriebsinterne Wasserstofftankstellen";
                                xyz:titel.tokens         [ rdf:_1  "Betriebsinterne Wasserstofftankstellen" ];
                                xyz:voraussetzung        "Antragsberechtigt sind juristische Personen des öffentlichen und des Privatrechts sowie natürliche Personen, soweit sie wirtschaftlich tätig sind und zum Zeitpunkt der Auszahlung ihren Sitz, Niederlassung oder eine Betriebsstätte im Freistaat Bayern haben."
                              ];
