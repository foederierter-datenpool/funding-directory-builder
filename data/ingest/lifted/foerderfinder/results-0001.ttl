                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>dc1cf130-467b-4584-8b34-7a871992ab54</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-10-30T11:09:45</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>dc1cf130-467b-4584-8b34-7a871992ab54</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>dc1cf130-467b-4584-8b34-7a871992ab54</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-10-30T11:09:45</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>dc1cf130-467b-4584-8b34-7a871992ab54</xflb:foerderschluessel>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400178017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Mittagsbetreuung an Grund- und Förderschulen; Beantragung einer Förderung</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Die Mittagsbetreuung liegt in kommunaler oder freier Trägerschaft und&lt;/p&gt;&lt;p&gt;gewährleistet eine verlässliche Betreuung der Kinder nach dem&lt;/p&gt;&lt;p&gt;stundenplanmäßigen Unterrichtsende. Es handelt sich um ein sozial- und&lt;/p&gt;&lt;p&gt;freizeitpädagogisch ausgerichtetes Betreuungsangebot.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern fördert Gruppen der Mittagsbetreuung, um eine verlässliche Betreuung der Kinder nach dem stundenplanmäßigen Unterrichtsende zu unterstützen.</xflb:teaser>\n                  <xflb:schluesselwoerter>MiB, MiBe, Mittagsbetreuung, Ganztag, Mittag, Schule</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Mittagsbetreuung - Kind- und familiengerecht</xflb:bezeichnung>\n                     <xflb:link>https://www.km.bayern.de/eltern/schule-und-familie/mittagsbetreuung.html</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>ISB-Portal \"Ganztag in Bayern\"</xflb:bezeichnung>\n                     <xflb:link>https://www.isb.bayern.de/grundsatzabteilung/ganztag/</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Die Anträge auf staatliche Förderung der Mittagsbetreuung bzw. verlängerten Mittagsbetreuung sind über die Schulleitung und das Staatliche Schulamt (bzw. bei Förderschulen direkt)  bei der zuständigen Bezirksregierung einzureichen. Der Antragstermin und der Meldetermin nach Schuljahresbeginn werden jährlich im Rahmen des Antrags- und Genehmigungsverfahrens bekannt gegeben.</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>896cf6ed-5dd1-4dd5-8681-7e385ecfc26a</xflb:id>\n                     <xflb:bezeichnung>Antrag auf staatliche Förderung für Gruppen der Mittagsbetreuung mit Meldelisten; siehe unter: \"Förderhinweise und Antragsverfahren\"</xflb:bezeichnung>\n                     <xflb:link>https://www.km.bayern.de/gestalten/ganztagsschule/grundlagen#antragsunterlagen</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>923de543-5cf6-42d0-9d69-605a7ef0151d</xflb:id>\n                     <xflb:bezeichnung>Verwendungsnachweis für Mittagsbetreuung an Grundschulen</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rvs/b4/43/rvs_43-120/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>9f9bd59a-e2e8-487a-86e5-9a78110272b7</xflb:id>\n                     <xflb:bezeichnung>Verwendungsnachweis für Mittagsbetreuung an Förderschulen</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rvs/b4/43/rvs_43-121/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>b6250674-c56f-4b05-8ef4-d208979b3ee9</xflb:id>\n                     <xflb:bezeichnung>Erhebungsbogen zur Mittagsbetreuung und verlängerten Mittagsbetreuung (zu senden über das staatliche Schulamt an die zuständige Regierung)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rvs/b4/40.1/rvs_40.1-250/index</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Zuwendungsempfänger ist der Träger des Schulaufwands oder ein anderer freier Träger.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>002</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Jede Gruppe der Mittagsbetreuung oder verlängerten Mittagsbetreuung kann auf Antrag im Rahmen der bereitgestellten Haushaltsmittel eine staatliche Förderung erhalten, wenn sie eine Betreuung der Kinder an jedem Schultag im Anschluss an den Unterricht bis zum Ende der je nach Art der Mittagsbetreuung erforderlichen Mindestbetreuungszeit gewährleistet, während eines ganzen Schuljahres besteht und sie sich aus mindestens 12 Schülerinnen und Schülern zusammensetzt.&lt;/p&gt;&lt;p&gt;Die Kosten für die Mittagsbetreuung und verlängerte Mittagsbetreuung werden im Regelfall gemeinsam von Freistaat, Kommunen und Eltern getragen.&lt;/p&gt;&lt;p&gt;Der staatliche Zuschuss im Schuljahr 2026/2027 beträgt für:&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Mittagsbetreuung (Gruppen bis 14.00 Uhr): 5.737 €&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;verlängerte Mittagsbetreuung (Gruppen bis 15.00 Uhr): 12.293 €&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;verlängerte Mittagsbetreuung (Gruppen bis 16.00 Uhr) 16.391 €&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Aufgrund der Unterschiede bei Betreuungszeiten, Qualifikationen der Betreuungskräfte, Gruppengrößen und der möglichen kommunalen Zuschüsse kann die Höhe der Elternbeiträge nicht einheitlich bestimmt werden. Sie werden vom jeweiligen Träger vor Ort festgelegt und den Eltern mitgeteilt.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Zuwendungsfähig ist die Durchführung einer genehmigten Gruppe der Mittagsbetreuung bzw. verlängerten Mittagsbetreuung.&amp;nbsp;&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Unterricht und Kultus</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 31 Abs. 3 Bayerisches Gesetz über das Erziehungs- und Unterrichtswesen (BayEUG)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayEUG-31</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Mittagsbetreuung und verlängerte Mittagsbetreuung an Grund- und Förderschulen - Bekanntmachung des Bayerischen Staatsministeriums für Unterricht und Kultus</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2232_1_K_12025</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2021-04-26</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2030-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Die Mittagsbetreuung ist eine eigenständige Einrichtung eines kommunalen oder freien Trägers, der grundsätzlich auch für die Finanzierung und Durchführung der Angebotsform zuständig ist.&lt;/p&gt;&lt;p&gt;Sie gewährleistet eine verlässliche Betreuung der Kinder nach dem Unterrichtsende&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;bis 14.00 Uhr oder&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;bis mindestens 15.00 Uhr mit der verlängerten Mittagsbetreuung oder&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;bis 16.00 Uhr mit der verlängerten Mittagsbetreuung.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Die Einrichtung und Ausgestaltung erfolgt im Zusammenwirken mit der Schulleitung. Den Schülerinnen und Schülern soll die Gelegenheit geboten werden, sich zu entspannen, allein oder mit anderen zu spielen, kreativ zu sein und soziale Kontakte zu pflegen.&lt;/p&gt;&lt;p&gt;Bei den drei unterschiedlichen Formen der Mittagsbetreuung gibt es folgende Angebote:&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bei der Mittagsbetreuung bis 14.00 Uhr sind das Anfertigen von Hausaufgaben sowie ein Mittagessen nicht verpflichtend, können aber auf freiwilliger Basis zum Betreuungskonzept des jeweiligen Trägers gehören.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die verlängerte Mittagsbetreuung bis 15.00 Uhr bzw. 16.00 Uhr bietet neben einer verlässlichen Hausaufgabenbetreuung ein möglichst ausgewogenes Mittagessen sowie zusätzliche Förderangebote, wie z. B. ein musisch-kreatives Angebot oder ein Sport- und Bewegungsangebot.&lt;/li&gt;&lt;/ul&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>002</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>022</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Mittagsbetreuung ersetzt nicht die Aufgaben von Horten, Tagesstätten, die mit Förderschulen verbunden sind, und ähnlichen Einrichtungen.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Sie ist keine Fortsetzung oder Aufarbeitung des lehrplanmäßigen Unterrichts, sie kann aber in Teile des Schullebens eingebunden werden.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Das Betreuungsangebot richtet sich nach der personellen und sächlichen Ausstattung.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Die Genehmigungsvoraussetzungen sind der jeweiligen kultusministeriellen Bekanntmachung sowie den Unterlagen zum jährlichen Antragsverfahren zu entnehmen.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.km.bayern.de/gestalten/ganztagsschule/grundlagen#antragsunterlagen</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Anträge auf staatliche Förderung sind vom Träger jeweils bis zum festgelegten Antragstermin für das darauffolgende Schuljahr über die Schulleitung und das zuständige Staatliche Schulamt - bei Förderschulen direkt - bei der Bezirksregierung einzureichen, welche die Prüfung und Bewilligung der Anträge sowie die Zuweisung der Mittel übernimmt. Zu einem festgelegten Zeitpunkt nach Schuljahresbeginn ist eine Meldung der tatsächlich teilnehmenden Schülerinnen und Schüler sowie der eingerichteten Gruppen über das Staatliche Schulamt (bzw. bei Förderschulen direkt) bei der Bezirksregierung abzugeben.&lt;/p&gt;&lt;p&gt;Weitere Hinweise:&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Der Antrag wird bereits im laufenden Schuljahr für das darauffolgende Schuljahr gestellt, um frühzeitig Planungssicherheit zu schaffen.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die beantragte Zahl der Gruppen muss auf einem vorherigen Anmeldeverfahren bei den Erziehungsberechtigten beruhen.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Dem Antrag sind namentliche Meldelisten der verbindlich angemeldeten Schülerinnen und Schüler beizufügen.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Bewilligung erfolgt auf Basis des Antrags, die Auszahlung der Fördermittel jedoch erst, nachdem die tatsächlich eingerichteten Gruppen gemeldet wurden und diese zum festgelegten Zeitpunkt nach Schuljahresbeginn bestätigt sind.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Gruppen, die trotz Antragstellung nicht zustande kommen, werden nicht gefördert; bewilligte Zuwendungen können in diesen Fällen ganz oder teilweise widerrufen werden.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bei zusätzlichem Bedarf können weitere Gruppen nachträglich beantragt und gefördert werden, sofern Haushaltsmittel verfügbar sind und die Beantragung fristgerecht erfolgt.&lt;/li&gt;&lt;/ul&gt;</xflb:bewilligung>\n               </xflb:verfahrensablauf>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:sonstige>ja</xflb:sonstige>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Der Antragstermin und der Meldetermin nach Schuljahresbeginn werden jährlich im Rahmen des Antrags- und Genehmigungsverfahrens bekannt gegeben.\nIn der Regel sind Anträge vom Träger jeweils bis zum 1. Juli einzureichen.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Antragsformular</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Anlage 1: Antragsformular Mittagsbetreuung</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Meldeliste</xflb:bezeichnung>\n                     <xflb:erlaeuterung>siehe Anlage 2</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Pädagogisches Konzept für MiB und verlängerte MiB</xflb:bezeichnung>\n                     <xflb:erlaeuterung>siehe Anlage 3</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Liegt in der Zuständigkeit der jeweiligen Regierung als zuständige Vollzugsbehörde&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_169  [ xyz:attributes  [ xyz:antragsstellung      "https://www.bayerischer-musikrat.de/festivalfoerderung/antrag";
                                xyz:beschreibung         "<p>Zweck der Förderung sind der Erhalt und Ausbau der bayerischen Festivallandschaft mit breiten, profilierten Musikangeboten in allen Regionen Bayerns, um das künstlerische Musikschaffen im professionellen Bereich nachhaltig zu stärken.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Kultur, Medien und Sport" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Privatpersonen";
                                                           rdf:_2  "Kommunen";
                                                           rdf:_3  "Vereine";
                                                           rdf:_4  "Stiftungen"
                                                         ];
                                xyz:foerderprogramm      "Förderung von Festivals und Veranstaltungsreihen im Bereich der klassischen Musik und Jazz";
                                xyz:foerderzeitraum.bis  "2028-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2023-07-10T00:00:00.000+00:00";
                                xyz:schluessel           "7ee47924-b027-4777-8dad-0af91822e20c";
                                xyz:teaser               "Für musikalische Festivals oder Veranstaltungsreihen mit Schwerpunkt im Bereich der klassischen Musik (z.B. Alte Musik, romantische Musik, zeitgenössische Musik etc.) oder Jazz, die in Bayern stattfinden, kann eine staatliche Förderung beantragt werden.";
                                xyz:titel                "Förderung von Festivals und Veranstaltungsreihen im Bereich der klassischen Musik und Jazz";
                                xyz:titel.tokens         [ rdf:_1  "Förderung von Festivals und Veranstaltungsreihen im Bereich der klassischen Musik und Jazz" ];
                                xyz:voraussetzung        "<p>Die Förderung setzt voraus, dass</p><ul><li class=\"unordered-list-item--dash\">mit dem Festival oder der Veranstaltungsreihe noch nicht begonnen worden ist,</li><li class=\"unordered-list-item--dash\">unter Berücksichtigung der möglichen staatlichen Förderung die Gesamtfinanzierung des Festivals oder der Veranstaltungsreihe hinreichend gesichert ist,</li><li class=\"unordered-list-item--dash\">das Festival oder die Veranstaltungsreihe nicht allein mit eigenen Einnahmen (z. B. Beiträge, Spenden, Konzerteinnahmen) und unter Ausschöpfung aller weiteren Finanzierungsmöglichkeiten (z. B. Zuwendungen des Bundes und der Kommunen, Sponsoren- und Stiftungsgelder) durchgeführt werden kann,&nbsp;</li><li class=\"unordered-list-item--dash\">mit dem Festival oder der Veranstaltungsreihe keine Gewinnerzielungsabsicht verfolgt wird,&nbsp;</li><li class=\"unordered-list-item--dash\">das Festival oder die Veranstaltungsreihe an Veranstaltungsorten in Bayern stattfindet,&nbsp;</li><li class=\"unordered-list-item--dash\">das Festival oder die Veranstaltungsreihe mindestens bereits zwei Mal erfolgreich durchgeführt worden ist,</li><li class=\"unordered-list-item--dash\">das Festival durch die Mitwirkung professioneller Künstlerinnen und Künstler geprägt wird&nbsp;</li><li class=\"unordered-list-item--dash\">und&nbsp;das Festival oder die Veranstaltungsreihe eine überregionale Reichweite entfaltet.</li></ul>"
                              ];
