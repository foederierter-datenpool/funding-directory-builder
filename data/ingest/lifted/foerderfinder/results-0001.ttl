                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Zuwendungsfähig sind die Personalkosten für notwendige Fachkräfte zur Beratung und Betreuung der Frauen und die Personalkosten für notwendige Fachkräfte zur Betreuung der Kinder, sowie Personal für die Geschäftsführung und Leitung und Personal für die Aufgabenbereiche Verwaltung und Gebäudemanagement.</p>"
                                                                                                                                         ];
