                                                                                                             xyz:foerdergegenstand       [ xyz:beschreibung
                                                                                                                               "<p>Gefördert werden die psychosoziale Beratung und Unterstützung von an Krebs erkrankten Personen und ihren Angehörigen durch ambulante Krebsberatungsstellen in Bayern.&nbsp;</p>" ];
