                                                                                                                                                                                              ];
                                                                                                                                                                    xyz:telefonnummer         "0921 605-3688";
                                                                                                                                                                    xyz:verweis               [ xyz:bezeichnung  "Förderprogramm - Verlinkung";
                                                                                                                                                                                                xyz:link         "https://www.zbfs.bayern.de/foerderung/familie/erholung/index.php"
                                                                                                                                                                                              ]
