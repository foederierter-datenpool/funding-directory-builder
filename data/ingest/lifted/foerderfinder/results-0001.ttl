                                                                                                                                           xyz:linkZurAntragsstellung   "https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/vereinspauschale/index?caller=bpgi2wky3ggfqwgojxg5sgczbvgs22yfbuq7nzi5h2qvjsyhjfccsgnec7wlproftr7hvwhqqhs77pkcnp64but6svkchxdkd4uuetzbdqtcrr4mjuk5vhpwddg77mxophj4i7k5r2ke54fjgvmnyarqsgwwww67m6pqi4nfdsd6i7xp3kj642s6tbq2wffvqylx4mgaegsy3hq888";
                                                                                                                                           xyz:rechtsbehelf             "<p>Gegen den Zuwendungsbescheid können Sie innerhalb von einem Monat Klage vor dem Verwaltungsgericht erheben. Das zuständige Gericht, bei dem Sie Klage einreichen können, wird Ihnen im Bescheid mitgeteilt.</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<p>Der Antrag auf Gewährung der Vereinspauschale ist bei den Kreisverwaltungsbehörden einzureichen und muss dort vollständig mit allen Angaben und Anlagen spätestens am 1. März des Förderjahres (Ausschlussfrist) eingegangen sein. Auf der Grundlage aller beantragten und berücksichtigungsfähigen Fördereinheiten sowie der im Förderjahr zur Verfügung stehenden Haushaltsmittel wird der Wert einer Fördereinheit ermittelt. Die Kreisverwaltungsbehörden errechnen aus der Anzahl der für den Verein jeweils berücksichtigungsfähigen Fördereinheiten sowie dem Wert der Fördereinheit die Höhe der Vereinspauschale im Förderjahr und zahlt diese an den Verein aus.</p>";
                                                                                                                                                                          xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "001";
                                                                                                                                                                                                            xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
                                                                                                                                                                                                            xyz:listVersionID  "1"
                                                                                                                                                                                                          ]
                                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:finanzierungsartUndHoehe  "<p>Es handelt sich um eine Festbetragsfinanzierung. Die Höhe der Vereinspauschale bemisst sich nach den auf den jeweiligen &nbsp;Verein für das Förderjahr entfallenden Fördereinheiten. Der Wert einer &nbsp;Fördereinheit wird auf der Grundlage der im Förderjahr für die Gewährung &nbsp;der Vereinspauschale zur Verfügung stehenden Haushaltsmittel sowie der &nbsp;Gesamtzahl der für das Förderjahr beantragten berücksichtigungsfähigen &nbsp;Fördereinheiten ermittelt.</p>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "001";
                                                                                                                                                                                                    xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
                                                                                                                                                                                                    xyz:listVersionID  "1";
                                                                                                                                                                                                    xyz:name           ""
                                                                                                                                                                                                  ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:laufzeitFinanzierung      [ xyz:laufzeitFinanzierung  [ xyz:code           "001";
                                                                                                                                                                                                       xyz:listURI        "urn:xoev-de:stmd:codeliste:laufzeit-finanzierung";
                                                                                                                                                                                                       xyz:listVersionID  "1"
                                                                                                                                                                                                     ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Die Anzahl der Fördereinheiten je Verein bestimmt sich nach der Anzahl &nbsp;seiner Mitglieder sowie den Trainer- und Übungsleiterlizenzen, die im &nbsp;Förderjahr eingesetzt werden sollen.</p>\n<p>Die Mitglieder werden dabei wie folgt gewichtet:</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">Mitglieder unter 27 Jahren zehnfach und</li>\n  <li class=\"unordered-list-item--dash\">alle übrigen Mitglieder einfach.</li>\n</ul>\n<p>Mitglieder mit Behinderung können unter bestimmten Voraussetzungen ebenfalls zehnfach gewichtet werden.</p>\n<p>Trainer- und Übungsleiterlizenzen sind berücksichtigungsfähig, wenn &nbsp;sie in der vom Staatsministerium jährlich veröffentlichten Liste &nbsp;enthalten sind und im Förderjahr im Verein eingesetzt werden sollen.&nbsp;Bei &nbsp;der Berechnung werden die Lizenzen entsprechend den sich aus der &nbsp;Lizenzliste ergebenden Punktwerten gewichtet. Die Anzahl der Lizenzen &nbsp;die je Verein geltend gemacht werden können ist begrenzt.</p>"
                                                                                                                                         ];
