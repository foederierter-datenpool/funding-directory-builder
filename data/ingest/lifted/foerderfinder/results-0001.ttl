                                                                                                                                           xyz:zuwendungsfaehigeKosten   "Neubau, Ersatzerrichtung und Erweiterung von Feuerwehrhäusern und Feuerwachen"
                                                                                                                                         ];
                                                                                                             xyz:foerderbereich          [ xyz:foerderbereich  [ xyz:code           "012";
                                                                                                                                                                 xyz:listURI        "urn:xoev-de:stmd:codeliste:foerderbereich";
                                                                                                                                                                 xyz:listVersionID  "1";
                                                                                                                                                                 xyz:name           ""
                                                                                                                                                               ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergebiet           [ xyz:laender  [ xyz:land  [ xyz:code           "BY";
                                                                                                                                                                      xyz:listURI        "urn:xoev-de:pks:codeliste:bundesland";
                                                                                                                                                                      xyz:listVersionID  "1";
                                                                                                                                                                      xyz:name           "Bayern"
                                                                                                                                                                    ]
                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergegenstand       [ xyz:beschreibung
                                                                                                                               "<p>Die Förderung soll den Kommunen die Unterbringung der für den abwehrenden Brandschutz und den technischen Hilfsdienst im Sinne des Bayerischen Feuerwehrgesetzes (BayFwG) beschafften Fahrzeuge und Ausrüstung in Feuerwehrhäusern ermöglichen.</p>\n<p>Gefördert werden der Neubau, die Generalsanierung bzw. die Ersatzerrichtung von Feuerwehrhäusern und Feuerwachen und deren Erweiterung um weitere notwendige Stellplätze. Zudem werden als besondere Einrichtungen in Feuerwehrhäusern und Feuerwachen auch der Bau von Schlauchpflegeeinrichtungen, Atemschutzwerkstätten und Atemschutzübungsanlagen sowie die dazu gehörenden Geräteausstattungen gefördert.</p>" ];
                                                                                                             xyz:foerdernehmende         [ xyz:foerdernehmende  [ xyz:code           "009";
                                                                                                                                                                  xyz:listURI        "urn:xoev-de:stmd:codeliste:foerdernehmende";
                                                                                                                                                                  xyz:listVersionID  "1";
                                                                                                                                                                  xyz:name           "Kommunen"
                                                                                                                                                                ]
                                                                                                                                         ];
