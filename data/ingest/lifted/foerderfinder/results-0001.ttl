                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Zuwendungsfähig sind Personalausgaben, Sachausgaben, Ausgaben für die Kinderbetreuung sowie Gemeinausgaben im Rahmen des Zuwendungszwecks. Die Höhe der zuwendungsfähigen Personalausgaben bemisst sich</p><p>nach den vom Bayerischen Finanzministerium veröffentlichten</p><p>Personalausgabenhöchstsätzen.</p>"
                                                                                                                                         ];
