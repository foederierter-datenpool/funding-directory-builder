                                                           rdf:_12  "Nachtpflege";
                                                           rdf:_13  "ambulant betreute Wohngemeinschaft";
                                                           rdf:_14  "Dauerpflege";
                                                           rdf:_15  "Pflegeheim";
                                                           rdf:_16  "Altenheim";
                                                           rdf:_17  "Seniorenheim";
                                                           rdf:_18  "Begegnungsstätte";
                                                           rdf:_2   "Pflegeplatz";
                                                           rdf:_3   "Pflegeplätze";
                                                           rdf:_4   "Pflegeeinrichtungen";
                                                           rdf:_5   "Pflege im sozialen Nahraum";
                                                           rdf:_6   "Nahraum";
                                                           rdf:_7   "Quartier";
                                                           rdf:_8   "Kurzzeitpflege";
                                                           rdf:_9   "Verhinderungspflege"
                                                         ];
                                xyz:beschreibung         "<p>Zweck der Förderung ist der demenzsensible Umbau, die Modernisierung und die Schaffung von vollstationären Dauerpflegeeinrichtungen mit einer Öffnung in den sozialen Nahraum.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Gesundheit und Soziales" ];
