                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>f98eccad-da35-42f8-a679-582826574ade</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2025-01-21T15:04:42</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>f98eccad-da35-42f8-a679-582826574ade</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>f98eccad-da35-42f8-a679-582826574ade</xflb:schluessel>\n         <xflb:versionFLB>6</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-09-14T13:11:49</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>f98eccad-da35-42f8-a679-582826574ade</xflb:foerderschluessel>\n                  <xflb:flbVersion>6</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400300017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Förderleistung für Schwangere in Not durch die \"Landesstiftung Hilfe für Mutter und Kind\"</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Reichen die öffentlichen und privaten Hilfen, die die Fortsetzung der Schwangerschaft und die Lage von Mutter und Kind erleichtern, im Einzelfall nicht aus, so kommen Leistungen der \"Landesstiftung Hilfe für Mutter und Kind\" in Betracht. Damit soll Schwangeren, die sich in einer Notlage befinden und auf die Hilfe anderer angewiesen sind, die Fortsetzung der Schwangerschaft erleichtert werden.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Die \"Landesstiftung Hilfe für Mutter und Kind\" hilft schwangeren Frauen vor Geburt und bis zu 36 Monate nach Geburt des Kindes, sofern sie sich in einer Notlage befinden.</xflb:teaser>\n                  <xflb:schluesselwoerter>Schwangere in Not, Notlage, Schwangerschaft, Hilfe für Schwangere</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Schwanger in Bayern</xflb:bezeichnung>\n                     <xflb:link>http://www.schwanger-in-bayern.de/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Familienland Bayern - Finanzielle Leistungen</xflb:bezeichnung>\n                     <xflb:link>https://www.familienland.bayern.de/themen/finanzielle-leistungen/index.php</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Schwangerschaftsberatungsstellen in Bayern</xflb:bezeichnung>\n                     <xflb:link>https://www.stmas.bayern.de/themen/schwangerschaft/#sec5</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Landesstiftung Hilfe für Mutter und Kind - Stiftungszweck \"Schwangere in Not\"</xflb:bezeichnung>\n                     <xflb:link>https://www.zbfs.bayern.de/foerderungen/stiftungen/landesstiftung_mutter_kind_schwangere/#top</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Erklärung, wo der Antrag für Schwangere in Not gestellt werden kann. Siehe auf der Website unter der Rubrik \"Wo kann der Antrag gestellt werden\".</xflb:bezeichnung>\n                     <xflb:link>https://www.zbfs.bayern.de/foerderungen/stiftungen/landesstiftung_mutter_kind_schwangere/</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>\"Landesstiftung Hilfe für Mutter und Kind\" - Stiftungsverwaltung im Zentrum Bayern Familie und Soziales</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>2</xflb:hausnummerPostfach>\n                     <xflb:strasse>Hegelstraße</xflb:strasse>\n                     <xflb:postleitzahl>95447</xflb:postleitzahl>\n                     <xflb:ort>Bayreuth</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>landesstiftung@zbfs.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Landesstiftung Hilfe für Mutter und Kind</xflb:bezeichnung>\n                     <xflb:link>https://www.zbfs.bayern.de/foerderungen/stiftungen/landesstiftung_mutter_kind_schwangere/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>+49 921 605-1</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Eine beiliebige staatlich anerkannte Beratungsstelle für Schwangerschaftsfragen in Bayern oder eine vom Staatsministerium für Familie, Arbeit und Soziales freiwillig geförderte katholische Beratungsstellen in Bayern</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Die Leistungen der \"Landesstiftung Hilfe für Mutter und Kind\" aus dem Stiftungszweck \"Schwangere in Not\" werden nur an Mädchen und Frauen ausgereicht, die im Zeitpunkt des Hilfeersuchens schwanger sind.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Förderung erfolgt als auflösend bedingte Zweckzuwendungen. Der Umfang der Leistung richtet sich nach dem notwendigen Bedarf und den besonderen Umständen des Einzelfalls.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Berücksichtigungsfähig sind Ausgaben, die aus Anlass der Geburt eines Kindes entstehen und geeignet sind, die Austragung der Schwangerschaft wesentlich zu erleichtern. Vorgesehen sind Leistungen für:&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Umstandskleidung und Wäsche für die Schwangere,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;die Erstausstattung des Kindes,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;die Weiterführung des Haushalts (Haushaltshilfe),&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;die Wohnung und für Einrichtungs- und Haushaltsgegenstände,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;die Betreuung des Kindes durch Dritte,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;die Unterstützung der Lebensführung und der Betreuung des Kindes durch die Mutter,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;die vorübergehende auswärtige Unterbringung vor und nach der Geburt des Kindes und&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;sonstige Hilfen (zum Beispiel Erholungsmaßnahmen, Fortsetzung der Ausbildung, Pauschale für Leistungsberechtigte nach dem Asylbewerberleistungsgesetz etc.).&lt;/li&gt;&lt;/ul&gt;</xflb:zuwendungsfaehigeKosten>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Familie, Arbeit und Soziales</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Vergabegrundsätze für die Gewährung von Leistungen der Landesstiftung \"Hilfe für Mutter und Kind\" an Schwangere in Not</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2172_A_14787?hl=true</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat V 2</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Schwangere in Not; Beantragung von Hilfen</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2028-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2025-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2028-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Berücksichtigungsfähig sind Ausgaben, die aus Anlass der Geburt eines Kindes entstehen und geeignet sind, die Austragung der Schwangerschaft wesentlich zu erleichtern (z. B. Umstandskleidung, Baby-Erstausstattung, Haushalts- und Einrichtungsgegenstände). Berücksichtigungsfähig sind Ausgaben für einen Zeitraum bis zu 36 Monaten nach der Geburt des Kindes, in begründeten Ausnahmefällen bis zu 48 Monaten.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Ärztliche Bescheinigung über bestehende Schwangerschaft, Vorliegen einer Notlage&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bereitschaft, Beratung in Anspruch zu nehmen&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Hauptwohnung in Bayern&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;ungünstige wirtschaftliche Verhältnisse&lt;/li&gt;&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Das Hilfegesuch muss während der Schwangerschaft, also vor der Geburt des Kindes, gestellt werden.&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.stmas.bayern.de/themen/schwangerschaft/#sec5</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Eine Antragstellung ist ausschließlich über eine der staatlich anerkannten Beratungsstellen für Schwangerschaftsfragen sowie über die vom Staatsministerium für Familie, Arbeit und Soziales freiwillig geförderten katholischen Beratungsstellen möglich.&lt;/p&gt;&lt;p&gt;Der Antrag muss vor der Geburt des Kindes persönlich vor Ort bei einer der genannten Beratungsstellen gestellt werden.&lt;/p&gt;&lt;p&gt;Die Beratungsstelle überprüft die Leistungsvoraussetzungen und übermittelt bei deren Vorliegen alle notwendigen Informationen, Nachweise und Belege über ein Internetportal der \"Landesstiftung Hilfe für Mutter und Kind\" (Stiftungsverwaltung).&lt;/p&gt;&lt;p&gt;Die \"Landesstiftung Hilfe für Mutter und Kind\" (Stiftungsverwaltung) prüft, ob die Voraussetzungen für die Gewährung einer Leistung an die Schwangere gegeben sind und schließt dann die Zuwendungsvereinbarung selbst.&lt;/p&gt;&lt;p&gt;Die Auszahlungen erfolgen bargeldlos auf ein von der Schwangeren genanntes Bankkonto. Auf ausdrücklichen Wunsch der Schwangeren können Zahlungen auch an die Beratungsstelle oder sonstige Dritte geleistet werden.&lt;/p&gt;&lt;p&gt;Die Leistungsempfängerin hat gegenüber der Beratungsstelle, die beim Vertragsabschluss eingeschaltet war, die zweckentsprechende Verwendung mittels geeigneter Belege nachzuweisen.&lt;/p&gt;</xflb:bewilligung>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:tage>7</xflb:tage>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:wochen>3</xflb:wochen>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:sonstige>ja</xflb:sonstige>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Die Hilfesuchenden, also werdende Mütter, müssen bereits vor der Geburt des Kindes einen Antrag bei der Landesstiftung Hilfe für Mutter und Kind stellen, sonst ist eine Förderung nicht möglich.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Nachweis über bestehende Schwangerschaft</xflb:bezeichnung>\n                     <xflb:erlaeuterung>z. B. Ärztliche Bescheinigung</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Nachweis über Hauptwohnsitz in Bayern</xflb:bezeichnung>\n                     <xflb:erlaeuterung>z. B. aktuelle Meldebescheinigung des Einwohnermeldeamtes</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Es besteht kein Rechtsanspruch auf diese Leistung, daher ist die Möglichkeit eines Rechtsbehelfs nicht gegeben.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_18   [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rof/b5/55.2/rof_55.2-128-zz/index";
                                xyz:begriffeImKontext    [ rdf:_1  "Tierheime" ];
                                xyz:beschreibung         "<p>Zweck der Zuwendungen ist die Förderung von</p><ul><li class=\"unordered-list-item--dash\">Investitionen für Bau- und Sanierungsvorhaben in und an Tierheimen,</li><li class=\"unordered-list-item--dash\">Ausgaben für Ausrüstung und Ausstattung von Tierheimen mit Geräten und Materialien, die für den ordnungsgemäßen Betrieb erforderlich sind,</li><li class=\"unordered-list-item--dash\">Ausgaben im Zusammenhang mit der Vermittlung von Heimtieren an Privathaushalte durch Tierheime und</li><li class=\"unordered-list-item--dash\">Vorhaben zur Eindämmung der Anzahl herrenloser Hauskatzen.</li></ul>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss";
                                                           rdf:_2  "Anteilsfinanzierung/Kapitalbeteiligung"
                                                         ];
                                xyz:foerderbereich       [ rdf:_1  "Gesundheit und Soziales" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Vereine";
                                                           rdf:_2  "Stiftungen";
                                                           rdf:_3  "Verbände";
                                                           rdf:_4  "Kommunen"
                                                         ];
                                xyz:foerderprogramm      "Förderung von Bau- und Sanierungsvorhaben für Tierheime";
                                xyz:foerderzeitraum.bis  "2026-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2023-11-16T00:00:00.000+00:00";
                                xyz:schluessel           "4a71927f-9f35-4b7a-95c4-b24918b75e2e";
                                xyz:teaser               "Der Freistaat Bayern fördert Bau- und Sanierungsvorhaben in und an Tierheimen, Ausgaben im Zusammenhang mit der Vermittlung von Heimtieren an Privathaushalte durch Tierheime und Vorhaben zur Eindämmung der Anzahl herrenloser Hauskatzen.";
                                xyz:titel                "Förderung von Bau- und Sanierungsvorhaben für Tierheime";
                                xyz:titel.tokens         [ rdf:_1  "Förderung von Bau- und Sanierungsvorhaben für Tierheime" ];
                                xyz:voraussetzung        "<ul><li class=\"unordered-list-item--dash\">Erhalt regelmäßiger kommunaler Unterstützung (gilt nicht für Vorhaben nach Nr. 2.4)</li><li class=\"unordered-list-item--dash\">Die Vorhaben müssen geeignet sein, die Unterbringung oder Pflege von Heimtieren zu verbessern; sie müssen den Vorgaben des § 2 TierSchG bzw., sofern es um die Haltung von Hunden geht, der Tierschutz-Hundeverordnung entsprechen</li><li class=\"unordered-list-item--dash\">Nachweis aller notwendigen bestandskräftigen öffentlich-rechtlichen Genehmigungen gegenüber der Bewilligungsbehörde; bei nicht im Eigentum stehenden Grundstücken Nachweis der Berechtigung zur Durchführung des Vorhabens</li><li class=\"unordered-list-item--dash\">Durchführung von tiermedizinischen Maßnahmen von bzw. unter Aufsicht einer approbierten Tierärztin oder eines approbierten Tierarztes</li></ul><p>Zuwendungsempfänger sind gemeinnützige Träger von in Bayern gelegenen Tierheimen sowie bayerische Kommunen oder rechtsfähige kommunale Zusammenschlüsse als Träger eines Tierheims.</p><p>Zuwendungsempfänger bei Vorhaben nach Nr. 2.4 sind ferner auf Dauer angelegte gemeinnützige Tierschutzorganisationen mit Sitz in Bayern.</p>"
                              ];
