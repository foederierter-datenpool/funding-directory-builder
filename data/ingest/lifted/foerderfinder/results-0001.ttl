                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>3f7b5e19-28c1-497c-9474-d7b9843c8173</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-06-26T14:16:29</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>3f7b5e19-28c1-497c-9474-d7b9843c8173</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>3f7b5e19-28c1-497c-9474-d7b9843c8173</xflb:schluessel>\n         <xflb:versionFLB>4</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-09-01T13:45:29</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>3f7b5e19-28c1-497c-9474-d7b9843c8173</xflb:foerderschluessel>\n                  <xflb:flbVersion>4</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400011017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Förderung von zertifizierten BOS-TETRA-Pagern (APRT) und von Komponenten zur Ertüchtigung von Sirenenanlagen für die TETRA-Alarmierung - Digitalfunk</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Zuwendungen werden für die Erstbeschaffung von digitalen TETRA-Endgeräten zur Teilnahme am Betrieb des digitalen Sprech- und Datenfunksystems der Behörden und Organisationen mit Sicherheitsaufgaben (BOS) in Bayern in den Bereichen Feuerwehr, Rettungsdienst und Katastrophenschutz gewährt. Sie sollen den Zuwendungsempfängern die für den Umstieg vom Analogfunk zur Teilnahme am digitalen BOS-Funk notwendigen Beschaffungen ermöglichen.&lt;/p&gt;&lt;p&gt;Mittlerweile ist der erste Teil der Endgeräteförderung, die Ausstattung von Fahrzeugen und Funktionen mit Fahrzeugfunkgeräten MRT, Handfunkgeräten HRT und Festfunkstellen FRT weitestgehend abgeschlossen. Der Fokus liegt damit auf dem zweiten Teil, der Förderung von Alarmmeldeempfängern (Pagern) und Sirenensteuergeräten für den Umstieg von der analogen zur digitalen Alarmierung.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern unterstützt Kommunen, die Durchführenden des Land- und Luftrettungsdienstes, die Kassenärztliche Vereinigung Bayerns und die freiwilligen Hilfsorganisationen des Katastrophenschutzes bei der Erstbeschaffung der Endgeräte für den digitalen BOS-Funk.</xflb:teaser>\n                  <xflb:schluesselwoerter>BayernPortal, Beantragung, Digitalfunkförderung, digitale Endgeräte, staatliche Förderung, Digitalfunk</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:alternativeFoerdermoeglichkeiten>\n                  <xflb:alternativeFoerdermoeglichkeit>\n                     <xflb:beschreibung>Zum Betrieb von ortsfesten Funkanlagen (FRT) und Sirenensteuereinheiten (TSE) wird in Bayern das Anmeldeverfahren für ortsfeste Funkanlagen der Bundesanstalt für den Digitalfunk der Behörden und Organisationen mit Sicherheitsaufgaben (BDBOS) vorausgesetzt.</xflb:beschreibung>\n                     <xflb:verweis>\n                        <xflb:bezeichnung>Digitalfunk BOS; Anmeldung von ortsfesten Funkanlagen und Sirenensteuereinheiten</xflb:bezeichnung>\n                        <xflb:link>https://www.bayernportal.de/dokumente/leistung/4178486289149</xflb:link>\n                     </xflb:verweis>\n                  </xflb:alternativeFoerdermoeglichkeit>\n               </xflb:alternativeFoerdermoeglichkeiten>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Autorisierte Stelle Bayern Digitalfunk</xflb:bezeichnung>\n                     <xflb:link>https://www.polizei.bayern.de/wir-ueber-uns/004129/index.html</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayer. Staatsministerium des Innern, für Sport und Integration, Sachgebiet D1 (Allgemeine Angelegenheiten der Feuerwehren; Kaminkehrerwesen)</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>3</xflb:hausnummerPostfach>\n                     <xflb:strasse>Odeonsplatz</xflb:strasse>\n                     <xflb:postleitzahl>80539</xflb:postleitzahl>\n                     <xflb:ort>München</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>poststelle@stmi.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Homepage Bayerisches Staatsministerium des Innern, für Sport und Integration</xflb:bezeichnung>\n                     <xflb:link>https://www.stmi.bayern.de/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>+4989219201</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Ihre zuständige Regierung</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Antragsberechtigt sind\n \n- Kommunen für ihre Feuerwehren, einschließlich örtlicher und überörtlicher Fahrzeuge, besondere Führungsdienstgrade und vorab benannter örtlicher Einsatzleiter.\n- Durchführende des Land- und Luftrettungsdienstes für landgebundene Einsatzfahrzeuge, Luftfahrzeuge und das jeweilige Personal.\n- Kassenärztliche Vereinigung Bayerns für Notärzte, Leitende Notärzte, Außenärzte sowie deren staatlich anerkannte private Einsatz- und Kommandofahrzeuge.\n- Freiwillige Hilfsorganisationen für Katastrophenschutzfahrzeuge und deren Personal.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Förderung erfolgt mit Festbeträgen, ist aber auf maximal 80 % der tatsächlichen Endgerätekosten beschränkt.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Die Förderung erfolgt ohne Rechtsanspruch im Rahmen der verfügbaren Haushaltsmittel.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Beschaffung von neuen, zertifizierten digitalen&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;BOS-Fahrzeugfunkgeräten&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;BOS Funkgeräten zur Nutzung in Rettungs- und Intensivtransporthubschraubern&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;BOS-Handfunkgeräten&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;BOS-Festfunkstellen&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;BOS-TETRA-Pagern (APRT)&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Komponenten zur Ertüchtigung von Sirenenanlagen für die TETRA-Alarmierung ausschließlich mit den jeweils weiter spezifizierten Bestandteilen, sowie ggf. Funktionen und Zubehör.&lt;/li&gt;&lt;/ul&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n               <xflb:euBeihilferelevanz>unzutreffend</xflb:euBeihilferelevanz>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium des Innern, für Sport und Integration</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Sonderförderprogramm für Zuwendungen des Freistaats Bayern zur Beschaffung der Endgeräte des digitalen BOS-Funks in Bayern (Sonderförderprogramm Digitalfunk)</xflb:bezeichnung>\n                     <xflb:link>https://www.stmi.bayern.de/media/a-z/feuerwehr/foerderung-feuerwehr/2024-12-10-sonderfoerderprogramm-digitalfunk-verlaengerung.pdf</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Anlage 1 Sonderförderprogramm für Zuwendungen des Freistaats Bayern zur Beschaffung der Endgeräte des digitalen BOS-Funks in Bayern (Sonderförderprogramm Digitalfunk)</xflb:bezeichnung>\n                     <xflb:link>https://www.stmi.bayern.de/media/_bayernportal/sonderfoerderprogramm-digitalfunk_anlage_1_20130729.pdf</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Anlage 2 Sonderförderprogramm für Zuwendungen des Freistaats Bayern zur Beschaffung der Endgeräte des digitalen BOS-Funks in Bayern (Sonderförderprogramm Digitalfunk)</xflb:bezeichnung>\n                     <xflb:link>https://www.stmi.bayern.de/media/_bayernportal/2024-12-10-anlage2-festbetragsuebersicht-anlage-zum-ims-vom-10-12-2024.pdf</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 23 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO-23</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 44 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO-44</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Verwaltungsvorschriften (VV) zu Art. 44 BayHO</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN44?hl=true</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Anlage 3 zu Art. 44 BayHO (Allgemeine Nebenbestimmungen für Zuwendungen zur Projektförderung an kommunale Köperschaften - ANBest-K))</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN122?hl=true</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Anlage 2 zu Art. 44 BayHO (Allgemeine Nebenbestimmungen für Zuwendungen zur Projektförderung  - ANBest-P))</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN121?hl=true</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Sachgebiet D1</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Sonderförderprogramm Digitalfunk</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2026-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2021-09-13</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2026-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert werden&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Digitale Funkgeräte für Fahrzeuge und Personal.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Ausstattung von Fahrzeugen und Funktionen gemäß Sonderförderprogramm Digitalfunk.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Installations- und Ausstattungsmaßnahmen, die notwendig sind, um die Geräte einsatzbereit zu machen.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Im Sonderförderprogramm Digitalfunk sind die mit digitalen Endgeräten auszustattenden Fahrzeuge und Funktionen sowie die Gerätearten und der jeweilige Ausstattungsumfang festgelegt.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>006</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Gefördert werden die Beschaffungen insbesondere nur dann, wenn sie im Rahmen des Umstiegs vom Analogfunk zur Teilnahme am digitalen BOS-Funk in den Bereichen Feuerwehr, Rettungsdienst und Katastrophenschutz erfolgen. Die zur Förderung beantragten Endgeräte müssen ferner fachlich notwendig sowie für die Teilnahme am BOS-Funk zertifiziert sein und die weiteren Anforderungen der Autorisierten Stelle Bayern erfüllen.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Es können nur Vorhaben gefördert werden, mit denen noch nicht begonnen worden ist. Bei Beschaffungen ist als Vorhabenbeginn grundsätzlich der Abschluss eines Lieferungs- oder Leistungsvertrages zu werten.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Gefördert wird zudem nur der Kauf von Endgeräten, eine Förderung von Leasing oder Mietkauf ist ausgeschlossen.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Weitere Fördervoraussetzungen für die Beschaffung digitaler Endgeräte sind im einschlägigen Sonderförderprogramm und den allgemeinen haushaltsrechtlichen Bestimmungen, insbesondere den Verwaltungsvorschriften zu Art. 44 Bayerische Haushaltsordnung (BayHO), enthalten.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:rechtlicheBeschreibung>&lt;p&gt;Antragsberechtigt sind ausschließlich&amp;nbsp;die im Förderprogramm genannten Zuwendungsberechtigten für die erstmalige Beschaffung der dort gelisteten Endgeräte.&lt;/p&gt;</xflb:rechtlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Förderfähig sind ausschließlich zertifizierte digitale Endgeräte für die am digitalen BOS-Funk teilnahmeberechtigten Zuwendungsempfänger&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.polizei.bayern.de/wir-ueber-uns/004129/index.html</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Einen entsprechenden Förderantrag &amp;nbsp;können die Zuwendungsberechtigten bei der für sie zuständigen Regierung (Förderbehörde) stellen.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:wochen>3</xflb:wochen>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:wochen>16</xflb:wochen>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristdatum>2026-12-31</xflb:fristdatum>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Das Sonderförderprogramm Digitalfunk wurde mit IMS vom 10.12.2024 letztmalig verlängert und ist bis zum 31.12.2026 befristet. Der Nachweis der Verwendung für eine Förderung nach diesem Programm muss der Förderbehörde bis spätestens 31.12.2028 vorliegen.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Antragsbogen Alarmempfänger (Pager)</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Antragsbogen Sirenensteueranlagen</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Antrag auf Gewährung einer Zuwendung nach dem Sonderförderprogramm Digitalfunk - Anlage 3.1</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Verwendungsbestätigung bei Gewährung einer Zuwendung nach dem Sonderförderprogramm Digitalfunk - Anlage 4</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;verwaltungsgerichtliche Klage&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_172  [ xyz:attributes  [ xyz:antragsstellung      "https://foerderung.bayern.de/landingpage/7bd249e3-b848-4af8-a980-b56bc8db34cd";
