                                                                                                                                           xyz:linkZurAntragsstellung   "https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/13/rmf_13-037/index";
                                                                                                                                           xyz:rechtsbehelf             "<p>Gegen den Bescheid kann innerhalb eines Monats nach seiner Bekanntgabe Klage beim örtlich zuständigen Verwaltungsgericht eingereicht werden.</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<p>Projekte und Maßnahmen sind in enger fachlicher Abstimmung mit der Bewilligungsbehörde &nbsp;und dem StMGP zu planen und durchzuführen.&nbsp;</p>";
                                                                                                                                                                          xyz:erlaeuterungVorzeitigerMassnahmebeginn
                                                                                                                                                                                  "<p>Ist es für eine erfolgreiche Durchführung des Vorhabens zwingend notwendig, bereits vor Erhalt des Förderbescheids einen Arbeits- oder Leistungsvertrag abzuschließen, ist eine Zustimmung zu einem vorzeitigen Maßnahmebeginn möglich.</p>";
                                                                                                                                                                          xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "002";
                                                                                                                                                                                                            xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
                                                                                                                                                                                                            xyz:listVersionID  "1"
                                                                                                                                                                                                          ]
                                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:euBeihilferelevanz        "Bei Zuwendungen im Rahmen dieser Förderrichtlinie handelt es sich grundsätzlich um eine sog. DAWI-De-minimis-Beihilfe nach der DAWI-De-minimis-Verordnung: Verordnung Nr. 2023/2832 der Kommission vom 13. Dezember 2023 über die Anwendung der Artikel 107 und 108  des Vertrags über die Arbeitsweise der Europäischen Union auf De-minimis-Beihilfen an Unternehmen, die Dienstleistungen von allgemeinem wirtschaftlichem Interesse erbringen (Amtsblatt der Europäischen Union L, 2023/2832, 15. Dezember 2023).";
                                                                                                                                           xyz:finanzierungsartUndHoehe  "<ul><li class=\"unordered-list-item--dash\">Die Zuwendung wird als Zuschuss im Rahmen einer Projektförderung in Form der Festbetragsfinanzierung (Förderpauschale) gewährt.&nbsp;</li><li class=\"unordered-list-item--dash\">Die Förderung der Personalausgaben bemisst sich nach den Personalausgabenhöchstsätzen bei Zuwendungen des Freistaates Bayern des Staatsministeriums der Finanzen und für Heimat in der jeweils geltenden Fassung.&nbsp;</li><li class=\"unordered-list-item--dash\">Für Fahrtausgaben, die durch notwendige Dienstfahrten entstehen, wird pro Vollzeitstelle ein Fahrtkostenhöchstbetrag gewährt. Dieser beträgt für</li><li class=\"unordered-list-item--dash\">Kategorie I (Entfernung JVA - Beratungsstelle bis 20 km): bis zu 500 Euro, Kategorie II (Entfernung JVA - Beratungsstelle von 21 bis 60 km): bis zu 1 500 Euro, Kategorie III (Entfernung JVA - Beratungsstelle von 61 bis 100 km): bis zu 2 500 Euro, Kategorie IV (Entfernung JVA - Beratungsstelle von mehr als 100 km): bis zu 3 000 Euro.</li><li class=\"unordered-list-item--dash\">Für Sachausgaben, die zuwendungsfähig sind, wird, ausgenommen der Fahrtkosten, ein Höchstbetrag von bis zu 2 000 Euro pro Vollzeitstelle gewährt.</li></ul>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "001";
                                                                                                                                                                                                    xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
                                                                                                                                                                                                    xyz:listVersionID  "1";
                                                                                                                                                                                                    xyz:name           ""
