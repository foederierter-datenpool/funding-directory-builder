                                            xyz:standard           "XFLB";
                                            xyz:version            "2.0.0"
                                          ];
                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>96b61ea0-5aa1-4563-b35e-9ebf63ca14b7</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2025-01-30T17:51:09</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>96b61ea0-5aa1-4563-b35e-9ebf63ca14b7</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>96b61ea0-5aa1-4563-b35e-9ebf63ca14b7</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2025-01-30T17:51:09</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>96b61ea0-5aa1-4563-b35e-9ebf63ca14b7</xflb:foerderschluessel>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99148297017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Komplementäre Förderung des Baus oder Ausbaus von Verkehrswegen und -anlagen des allgemeinen ÖPNV und von S-Bahnen nach Art. 13c Abs. 2 BayFAG</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Die Mittel des Art. 13c Abs. 2 des Bayerischen Finanzausgleichsgesetzes (BayFAG) sind gemäß Art. 21 Abs. 2 des Gesetzes über den öffentlichen Personennahverkehr in Bayern (BayÖPNVG) zur Sicherung der Komplementärfinanzierung von Bau- oder Ausbauvorhaben an Verkehrsanlagen des allgemeinen ÖPNV (z.B. der U-Bahnen, Straßenbahnen und Linienbusse) und der S-Bahnen (Art. 29 Abs. 3 BayÖPNVG) einzusetzen, die nach dem Bayerischen Gemeindesverkehrsfinanzierungsgesetz (BayGVFG) oder Gemeindesverkehrsfinanzierungsgesetz des Bundes (GVFG) gefördert werden.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Eine Förderung dieser ÖPNV-Baumaßnahmen aus Mitteln des GVFG-Bundesprogramms ist u.&amp;nbsp;a. nur dann möglich, wenn die förderfähigen Kosten mehr als 30&amp;nbsp;Mio. € betragen.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern gewährt Zuwendungen nach Art. 13c Abs. 2 BayFAG für den Bau oder Ausbau von Verkehrsanlagen des allgemeinen öffentlichen Personennahverkehrs (ÖPNV) und der S-\\Bahnen, soweit dieser auch nach BayGVFG/GVFG förderfähig ist.</xflb:teaser>\n                  <xflb:schluesselwoerter>ÖPNV, Infrastrukturförderung, Härtefonds, BayFAG, Komplementärförderung, Finanzausgleich</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Broschüre \"Der kommunale Finanzausgleich in Bayern\"</xflb:bezeichnung>\n                     <xflb:link>http://www.bestellen.bayern.de/shoplink/06006002.htm</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Broschüre \"Zuwendungsrecht des Freistaats Bayern - Zusammenstellung aktueller Rechtsvorschriften\" (nur im Bayerischen Behördennetz aufrufbar)</xflb:bezeichnung>\n                     <xflb:link>https://www.stmf.bybn.de/haushalt/recht/Brosch%C3%BCre%20Zuwendungsrecht%2011.%20Auflage%202026%20(m.%C3%84.z.%201.6.26).pdf</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Staatsministerium der Finanzen und für Heimat</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>4</xflb:hausnummerPostfach>\n                     <xflb:strasse>Odeonsplatz</xflb:strasse>\n                     <xflb:postleitzahl>80539</xflb:postleitzahl>\n                     <xflb:ort>München</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>Referat62@stmfh.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Bayerisches Staatsministerium der Finanzen und für Heimat</xflb:bezeichnung>\n                     <xflb:link>https://www.stmfh.bayern.de/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Ihre zuständige Bezirksregierung</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>dd311457-f003-4250-aa7e-ef933098f2f5</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Gewährung einer Zuwendung (Muster 1a zu Art. 44 BayHO) - Muster veraltet, kann aber vorläufig weiterverwendet werden</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>49fa5d45-e521-4002-b790-1888191caa7d</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Bewilligung weiterer Zuwendungsraten (Muster 1b zu Art. 44 BayHO) - Muster veraltet, kann aber vorläufig weiterverwendet werden</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-024/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>96a24cc1-fcad-4b2f-a652-1aaf3e4cc984</xflb:id>\n                     <xflb:bezeichnung>Angaben zu den finanziellen Verhältnissen (Muster 2a zu Art. 44 BayHO - Kameralistik) - Muster veraltet, kann aber vorläufig weiterverwendet werden</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-025/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>4ae8a3f1-cb84-4fc7-ada6-c228cc182e5b</xflb:id>\n                     <xflb:bezeichnung>Angaben zu den finanziellen Verhältnissen (Muster 2b zu Art. 44 BayHO - Doppik) - Muster veraltet, kann aber vorläufig weiterverwendet werden</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-028/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>a6327bc9-1ade-43ba-b5b2-997d97fa64b8</xflb:id>\n                     <xflb:bezeichnung>Auszahlungsantrag (Muster 3 zu Art. 44 BayHO in der bis Ende 2025 gültigen Fassung) - vorläufig weiterverwendbar</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-006/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>de50a557-28db-4c57-91b3-213a7853e3ac</xflb:id>\n                     <xflb:bezeichnung>Verwendungsnachweis, vorläufiger Verwendungsnachweis (Muster 4 zu Art. 44 BayHO in der bis Ende 2025 gültigen Fassung) - vorläufig noch weiterverwendbar</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-019/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>bba36e80-22ab-4086-9f96-62b9796d1c88</xflb:id>\n                     <xflb:bezeichnung>Verwendungsbestätigung (Muster 1 zu Art. 44 BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-027/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>f2554733-db2b-4548-913d-73af7a769309</xflb:id>\n                     <xflb:bezeichnung>Ausgaben für Hochbaumaßnahmen analog DIN 276 (Muster 2 zu Art. 44 BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-020/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>dc251306-303f-416c-899f-103485f786dc</xflb:id>\n                     <xflb:bezeichnung>Erläuterungsbericht zum Antrag auf Gewährung einer Zuwendung für eine Hochbaumaßnahme (Muster 3 zu Art. 44 BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-021/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>8bbbf46d-f1af-4594-9c93-3dddd1f28c67</xflb:id>\n                     <xflb:bezeichnung>Flächenzusammenstellung zum Erläuterungsbericht (Muster 3a zu Art. 44 BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-022/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>c0be5d1d-f169-41c1-b87f-a8fe13d2a913</xflb:id>\n                     <xflb:bezeichnung>RZÖPNV - Anlage 1 - Erklärung zur Subventionserheblichkeit der Angaben</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rop/b2/23/rop_23-067/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>6ae4e6c4-6684-4724-987d-8c6e56857749</xflb:id>\n                     <xflb:bezeichnung>RZÖPNV - Anlage 2 - Ermittlung der zuwendungsfähigen Kosten</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rop/b2/23/rop_23-068/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>e25f0aff-4058-4dfe-b7c0-9244581d5149</xflb:id>\n                     <xflb:bezeichnung>RZÖPNV - Anlage 3 - Zwischennachweis</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rop/b2/23/rop_23-069/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>46bf2e60-ff0c-4a7f-916c-3bd1448fe386</xflb:id>\n                     <xflb:bezeichnung>RZÖPNV - Anlage 4 - Übersicht über die Ausgaben</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rop/b2/23/rop_23-070/index</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>002</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>003</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>005</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Eine Förderung können erhalten:\n- Gemeinden, Landkreise und kommunale Zusammenschlüsse in Bayern (zum Beispiel Zweckverbände),\n\n- öffentliche und private Verkehrsunternehmen sowie andere Vorhabenträger, wenn sie ihr Vorhaben in Bayern umsetzen.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Zuwendungen nach Art. 13c Abs. 2 BayFAG werden als Vomhundertsatz bezogen auf die zuwendungsfähigen Kosten mit Höchstbetrag gewährt (Anteilfinanzierung), soweit nicht im Einzelfall, insbesondere bei der Anwendung von Kostenrichtwerten, eine Festbetragsfinanzierung sachgerecht erscheint.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Bemessung der Höhe der Förderung des Einzelfalls richtet sich nach Nr. 6.4 RZÖPNV.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Höhe der BayFAG-Zuwendung beträgt bei zuwendungsfähigen Ausgaben bis einschließlich 2,5 Mio. € bis zu 5 %, bei zuwendungsfähigen Ausgaben von mehr als 2,5 Mio. € in der Regel bis zu 10 % der zuwendungsfähigen Ausgaben.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Der Gesamtbetrag der Zuwendungen soll 90 % der zuwendungsfähigen Ausgaben nicht überschreiten.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Vom Zuwendungsempfänger ist ein angemessener Eigenanteil in Höhe von mindestens 10 % der zuwendungsfähigen Ausgaben zu tragen.&lt;/li&gt;&lt;/ul&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Förderfähig sind nicht die Gesamtkosten einer Baumaßnahme, sondern die von der Bewilligungsbehörde ermittelten zuwendungsfähigen Ausgaben.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Grundsätzlich gelten die Ausgaben für Maßnahmen des Baus oder Ausbaus von Verkehrsanlagen und Verkehrswegen des ÖPNV in dem Umfang als nach Art. 13c Abs. 2 BayFAG förderfähig, in dem sie nach GVFG oder BayGVFG und deren Ausführungsbestimmungen zuwendungsfähig sind.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Ermittlung der zuwendungsfähigen Ausgaben erfolgt nach Maßgabe der Nrn. 6.2 und 6.3 RZÖPNV.&lt;/li&gt;&lt;/ul&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n               <xflb:euBeihilferelevanz>Einzelfallbezogen</xflb:euBeihilferelevanz>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium der Finanzen und für Heimat zusammen mit dem Staatsministerium für Wohnen, Bau und Verkehr</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 21ff des Gesetzes über den öffentlichen Personennahverkehr in Bayern (BayÖPNVG)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayOePNVG-21</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 13c des Gesetzes über den Finanzausgleich zwischen Staat, Gemeinden und Gemeindeverbänden (Bayerisches Finanzausgleichsgesetz - BayFAG)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayFAG-13c</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinien für die Gewährung von Zuwendungen des Freistaates Bayern für den öffentlichen Personennahverkehr (ÖPNV-Zuwendungsrichtlinien - RZÖPNV)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_97_B_14197/true</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Gesetz über Zuwendungen des Freistaates Bayern zur Verbesserung der Verkehrsverhältnisse der Gemeinden (Bayerisches Gemeindeverkehrsfinanzierungsgesetz - BayGVFG)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayGVFG</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Gesetz über Finanzhilfen des Bundes zur Verbesserung der Verkehrsverhältnisse der Gemeinden (Gemeindeverkehrsfinanzierungsgesetz - GVFG)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-im-internet.de/gvfg/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 44 Bayerische Haushaltsordnung (BayHO) und VV zu Art. 44 BayHO</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN44</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat 62</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Öffentlicher Personennahverkehr - Komplementäre Förderung des Baus oder Ausbaus von Verkehrswegen und -anlagen des allgemeinen ÖPNV und von S-Bahnen nach Art. 13c Abs. 2 BayFAG</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2027-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2024-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2027-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n               <xflb:kummulierbareFoerderungen>\n                  <xflb:beschreibungAusschluss>&lt;ul&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Baumaßnahme steht nicht im Zusammenhang mit einer Verkehrsanlage des allgemeinen ÖPNV oder der S-Bahn.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Geplante Baumaßnahme ist nicht nach BayGVFG oder GVFG förderfähig.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Mit der Baumaßnahme wurde noch vor Erlass des Förderbescheides und ohne vorherige Zustimmung zum vorzeitigen Maßnahmebeginn begonnen.&lt;/li&gt;\n&lt;/ul&gt;</xflb:beschreibungAusschluss>\n                  <xflb:verweise>\n                     <xflb:verweis>\n                        <xflb:bezeichnung>ÖPNV-Infrastrukturförderung nach BayGVFG</xflb:bezeichnung>\n                        <xflb:link>https://foerderfinder.digital/bayern/suche/detail/b99f62ae-5cf3-467b-96dd-f90ecd4d337a</xflb:link>\n                     </xflb:verweis>\n                  </xflb:verweise>\n                  <xflb:voraussetzungen>&lt;p&gt;Die Förderung des Baus- oder Ausbaus von Verkehrswegen und -anlagen des ÖPNV nach Art. 13c Abs. 2 BayFAG erfolgt nur, sofern diese ÖPNV-Infrastrukturmaßnahme auch nach BayGVFG oder Bundes-GVFG gefördert wird.&amp;nbsp;&lt;/p&gt;\n&lt;p&gt;Eine Förderung entfällt jedoch, wenn für den gleichen Zuwendungszweck andere Mittel des Freistaates Bayern - vorbehaltlich der Förderung aus Sonderprogrammen und nach dem Dritten Buch Sozialgesetzbuch - Arbeitsförderung - in Anspruch genommen werden.&lt;/p&gt;\n&lt;p&gt;Soweit die Inanspruchnahme zusätzlicher Fördermittel für den gleichen Zuwendungszweck zulässig ist, werden diese Mittel nicht auf die gemäß RZÖPNV bewilligten Zuwendungen angerechnen. Bei der Bemessung der Höhe der Gesamtzuwendung muss ein angemessener Eigenanteil des Zuwendungsempfängers (VV Nr. 2.4.2 zu Art. 44 BayHO) verbleibt. Dieser beträgt bei Projektförderungen wie der Förderung nach Art. 13c Abs. 2 BayFAG mindestens 10% der förderfähigen (= zuwendungsfähigen) Ausgaben (VV Nr. 2.4.2 Satz 3 zu Art. 44 BayHO).&lt;/p&gt;</xflb:voraussetzungen>\n               </xflb:kummulierbareFoerderungen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Der Bau oder Ausbau nachfolgender Verkehrseinrichtungen kann nach Art. 13c Abs. 2 BayFAG gefördert werden, soweit diese dem ÖPNV dienen und die Baumaßnahme nach BayGVFG oder GVFG gefördert wird:&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Verkehrswege der Straßenbahnen, Hoch- und Untergrundbahnen sowie von Bahnen besonderer Bauart, soweit sie überwiegend, also zu mehr als 50 %, entweder auf besonderen Bahnkörpern oder auf Streckenabschnitten, die eine Bevorrechtigung der Bahnen durch geeignete Bauformen bzw. Fahrleitsysteme sicherstellen, geführt werden,&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Verkehrswege der S-Bahnen,&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Zentrale Omnibusbahnhöfe,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Haltestelleneinrichtungen zum Ein- und Aussteigen von fahrgästen bei Fahrzeugen des ÖPNV,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Betriebshöfen und zentralen Werkstätten,&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Beschleunigungsmaßnahmen für den ÖPNV, insbesondere rechnergesteuerte Betriebsleitsysteme und technische Maßnahmen zur Steuerung von Lichtsignalanlagen (also z. B. Busvorrangschaltungen und Busspuren),&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;öffentliche Umsteigeparkplätze für Kraftfahrzeuge und Fahrräder an Haltestellen des ÖPNV, soweit sie dazu bestimmt und geeignet sind, dem Übergang zwischen Individualverkehr und ÖPNV zu dienen.&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Die ausführliche Beschreibung der Fördergegenstände und die Grundlagen für die Förderung von Infrastruktureinrichtungen des ÖPNV nach dem GVFG-Bundesprogramm/&amp;nbsp;BayGVFG und BayFAG können den Richtlinien für die Gewährung von Zuwendungen des Freistaats Bayern für den öffentlichen Personennahverkehr (RZÖPNV) entnommen werden.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Die Zuwendungen nach Art. 13c Abs. 2 BayFAG können nur gewährt werden, wenn die Voraussetzungen des Art. 3 BayGVFG erfüllt sind. Danach muss das Vorhaben&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;nach Art und Umfang zur Verbesserung der Verkehrsverhältnisse dringend erforderlich sein,&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;die Ziele der Raumordnung und Landesplanung berücksichtigen sowie die sonstigen rechtlichen Voraussetzungen erfüllen,&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;in einem Generalverkehrsplan oder gleichwertigen Plan vorgesehen sein,&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;bau- und verkehrstechnisch einwandfrei und unter Berücksichtigung des Grundsatzes der Wirtschaftlichkeit und Sparsamkeit geplant sein,&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;mit städtebaulichen Maßnahmen, die gegebenenfalls betroffen sind, abgestimmt sein,&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;die Belange von Menschen mit Behinderungen oder mit Mobilitätseinschränkungen berücksichtigen und den Anforderungen der Barrierefreiheit möglichst weitreichend entsprechen.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Finanzierung des Vorhabens oder eines Bauabschnittes des Vorhabens mit eigener Verkehrsbedeutung muss gewährleistet sein.&lt;/li&gt;&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:rechtlicheBeschreibung>&lt;p&gt;Nähere Ausführungen zu den Fördervoraussetzungen können Nr. 5 der RZÖPNV entnommen werden.&lt;/p&gt;</xflb:rechtlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Baumaßnahme steht nicht im Zusammenhang mit einer Verkehrsanlage des allgemeinen ÖPNV oder der S-Bahn.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Geplante Baumaßnahme ist nicht nach BayGVFG oder GVFG förderfähig.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Mit der Baumaßnahme wurde noch vor Erlass des Förderbescheides und ohne vorherige Zustimmung zum vorzeitigen Maßnahmebeginn begonnen.&lt;/li&gt;&lt;/ul&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Der Antrag auf Gewährung einer Zuwendung ist unter Verwendung des Formblatts nach Muster 1a zu Art. 44 BayHO zusammen mit den erforderlichen Unterlagen bei der jeweils zuständigen Bezirksregierung schriftlich und zusätzlich elektronisch einzureichen. Die geltenden Formulare finden Sie unter \"Erforderliche Unterlagen\" (siehe auch Nr. 8 RZÖPNV).&amp;nbsp;&lt;/p&gt;&lt;p&gt;Weiteres Verfahren:&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Regierung prüft und verbescheidet den Zuwendungsantrag.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Zuweisungen werden von der Regierung jeweils für ein Haushaltsjahr bewilligt.&lt;/li&gt;&lt;/ul&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>&lt;p&gt;Mit der Baumaßnahme darf erst nach Erteilung eines entsprechenden ersten Bewilligungsbescheids oder nach vorheriger Zustimmung der Regierung zum vorzeitigen Maßnahmebeginn begonnen werden.&lt;/p&gt;</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Antrag auf Gewährung einer Zuwendung (Muster 1a zu Art. 44 BayHO)</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Erläuterungsbericht mit ausführlicher Darlegung der angestrebten Verbesserung der Verkehrsverhältnisse</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Übersichtsplan des Vorhabens</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>für die Beurteilung der Maßnahme notwendige Pläne (Baupläne, Lageplan, ggf. Grunderwerbsplan, Gestaltungsplan, Querschnitte)</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Kostenschätzung/ Kostenberechnung mit Kostenzusammenfassung</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Ermittlung der zuwendungsfähigen Kosten gemäß Anlage 2 der RZÖPNV</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Stellungnahme des Aufgabenträgers</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Beteiligung des zuständigen Beauftragten für Belange von Menschen mit Behinderung nach Art. 18 Bayerisches Behindertengleichstellungsgesetz oder des örtlichen Behindertenbeauftragten oder der Behindertenbeiräte</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Ergänzende Unterlagen bei Omnibusbetriebshöfen und zentralen Werkstätten gemäß Nr. 8.2.1.10 RZÖPNV</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Erklärung zur Subventionserheblichkeit gemäß Anlage 1 der RZÖPNV</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Gegen den Zuwendungsbescheid kann der Antragsteller/Zuwendungsempfänger innerhalb eines Monats nach Bekanntgabe Klage erheben. Das zuständige Verwaltungsgericht, bei dem die Klage eingereicht werden kann, wird im Bescheid mitgeteilt.&amp;nbsp;&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_123  [ xyz:attributes  [ xyz:antragsstellung      "https://foerderung.bayern.de/landingpage/14a6dc56-5fb7-4f7d-b368-c461b8394ff6";
                                xyz:begriffeImKontext    [ rdf:_1  "BayGVFG";
                                                           rdf:_2  "Kommunalstraßenbau";
                                                           rdf:_3  "Kommunalstraßenförderung"
                                                         ];
                                xyz:beschreibung         "<p>Der Freistaat Bayern gewährt Landkreisen und Gemeinden projektbezogene Zuwendungen für den Bau oder Ausbau kommunaler Straßen. Ziele sind die Verbesserung der Verkehrsverhältnisse und die Erhöhung der Verkehrssicherheit.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Infrastruktur" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Kommunen" ];
                                xyz:foerderprogramm      "Förderungen nach Art. 2 BayGVFG (Straßen- und Brückenbau)";
                                xyz:foerderzeitraum.bis  "2030-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2007-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "c17e9686-c9f4-4709-976f-7947b8d3d3c4";
                                xyz:teaser               "Der Freistaat Bayern gewährt Zuwendungen für kommunale Straßen- und Brückenbaumaßnahmen, soweit sie zur Verbesserung der Verkehrsverhältnisse dringend notwendig sind.";
                                xyz:titel                "Radweginfrastruktur, Straßen- und Brückenbau nach Art. 2 BayGVFG";
                                xyz:titel.tokens         [ rdf:_1  "Radweginfrastruktur";
                                                           rdf:_2  "Straßen- und Brückenbau nach Art. 2 BayGVFG"
                                                         ];
                                xyz:voraussetzung        "<ul><li class=\"unordered-list-item--dash\">Das Vorhaben kann auf Grund der finanziellen Möglichkeiten des Antragstellers nur dann realisiert werden, wenn staatliche Zuwendungen gewährt werden.&nbsp;</li><li class=\"unordered-list-item--dash\">Die übrige Finanzierung des Vorhabens oder eines Bauabschnittes mit eigener Verkehrsbedeutung muss gewährleistet sein.&nbsp;</li><li class=\"unordered-list-item--dash\">Das Vorhaben muss nach Art und Umfang zur Verbesserung der Verkehrsverhältnisse dringend erforderlich sein.&nbsp;</li><li class=\"unordered-list-item--dash\">Die Erfordernisse der Raumordnung und Landesplanung müssen berücksichtigt und die sonstigen rechtlichen Voraussetzungen erfüllt sein.&nbsp;</li><li class=\"unordered-list-item--dash\">Das Vorhaben muss bau- und verkehrstechnisch einwandfrei, den Naturhaushalt, das Landschaftsbild und Flächen soweit wie möglich schonend und unter Berücksichtigung des Grundsatzes der Wirtschaftlichkeit und Sparsamkeit geplant sein.&nbsp;</li><li class=\"unordered-list-item--dash\">Die Belange von Menschen mit Behinderungen oder mit Mobilitätseinschränkungen müssen berücksichtigt sein.&nbsp;</li><li class=\"unordered-list-item--dash\">Das Vorhaben muss mit städtebaulichen Planungen und Maßnahmen, die mit ihm zusammenhängen, zuvor abgestimmt sein.&nbsp;</li><li class=\"unordered-list-item--dash\">Das Vorhaben muss in einem Flächennutzungsplan, einem Generalverkehrsplan oder einem für die Beurteilung gleichwertigen Plan vorgesehen sein.&nbsp;</li><li class=\"unordered-list-item--dash\">Eine Förderung aus BayGVFG-Mitteln ist nur dann möglich, wenn die zuwendungsfähigen Kosten die Bagatellgrenze von 100.000 Euro, bei verkehrswichtigen selbständigen Geh- und Radwegen, mehr als 50.000 Euro und bei verkehrswichtigen öffentlichen Feld- und Waldwegen mit Bedeutung für den Radverkehr von 25.000 Euro übersteigen. Für Umsteigeanlagen und Kreuzungsmaßnahmen nach dem Eisenbahnkreuzungsgesetz bestehen keine Bagatellgrenzen.&nbsp;</li><li class=\"unordered-list-item--dash\">Das Förderkontingent für neu in das BayGVFG-Programm aufzunehmende Projekte ist begrenzt. Ein Rechtsanspruch auf Förderung innerhalb eines bestimmten Zeitraumes wird durch die Programmaufnahme nicht begründet. Wenn die Nachfrage über dieses Kontingent hinausgeht, werden seitens der einzelnen Regierungen Prioritätensetzungen vorgenommen.</li></ul><p>Mit dem Vorhaben darf noch nicht begonnen worden sein.</p><p><br></p>"
                              ];
              xyz:id          "c17e9686-c9f4-4709-976f-7947b8d3d3c4";
              xyz:payload     [ xyz:json  [ xyz:anfrage            [ xyz:anfragenummer  "c17e9686-c9f4-4709-976f-7947b8d3d3c4";
                                                                     xyz:flb            [ xyz:konkreteFLB  [ xyz:allgemeineAngaben       [ xyz:beschreibung       [ xyz:schluesselwoerter  "BayGVFG, Kommunalstraßenbau, Kommunalstraßenförderung";
                                                                                                                                                                    xyz:teaser             "Der Freistaat Bayern gewährt Zuwendungen für kommunale Straßen- und Brückenbaumaßnahmen, soweit sie zur Verbesserung der Verkehrsverhältnisse dringend notwendig sind.";
                                                                                                                                                                    xyz:zuwendungszweck    "<p>Der Freistaat Bayern gewährt Landkreisen und Gemeinden projektbezogene Zuwendungen für den Bau oder Ausbau kommunaler Straßen. Ziele sind die Verbesserung der Verkehrsverhältnisse und die Erhöhung der Verkehrssicherheit.</p>"
                                                                                                                                                                  ];
