                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>30202c21-5ecd-47e6-9d6b-de8d491db3ac</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-11-19T13:34:20</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>30202c21-5ecd-47e6-9d6b-de8d491db3ac</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>30202c21-5ecd-47e6-9d6b-de8d491db3ac</xflb:schluessel>\n         <xflb:versionFLB>6</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-11-19T13:34:20</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>30202c21-5ecd-47e6-9d6b-de8d491db3ac</xflb:foerderschluessel>\n                  <xflb:flbVersion>6</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99148287017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Radweginfrastruktur, Straßen- und Brückenbau nach Art. 13f BayFAG (kommunales Sonderbaulastprogramm)</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Die Fördermittel dienen zur Stärkung der Finanzierung von Investitionen der Landkreise und Gemeinden in die Verkehrsinfrastruktur. Ziele sind die Verbesserung der Verkehrsverhältnisse und die Erhöhung der Verkehrssicherheit und der Barrierefreiheit.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern gewährt Zuwendungen für Baumaßnahmen an Staatsstraßen, sowie für den Bau von selbständigen Radwegen und für Maßnahmen zur Verbesserung von Barrierefreiheit und Zuwegung vom Individual- zum öffentlichen Verkehr.</xflb:teaser>\n                  <xflb:schluesselwoerter>Art. 13f BayFAG, Sonderbaulast, Kommunalstraßenbau, Kommunalstraßenförderung</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Die zuständige Bezirksregierung</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>3d0d41aa-22ef-4dae-92ce-e399ad412c44</xflb:id>\n                     <xflb:bezeichnung>Angaben zu den finanziellen Verhältnissen (Muster 2a zu Art. 44 BayHO - Kameralistik)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-025/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>ed4a71fc-0828-491e-85a0-c7194266d1b1</xflb:id>\n                     <xflb:bezeichnung>Angaben zu den finanziellen Verhältnissen (Muster 2b zu Art. 44 BayHO - Doppik)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-028/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>90255da1-fed1-427b-8cb3-183a4120970c</xflb:id>\n                     <xflb:bezeichnung>Auszahlungsantrag (Muster 3 zu Art. 44 BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-006/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>139193cb-9a5f-4161-b920-7765d4327918</xflb:id>\n                     <xflb:bezeichnung>Verwendungsnachweis (Muster 4 zu Art. 44 BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-019/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>0fd464f3-6288-44fa-b08c-b96754a7044a</xflb:id>\n                     <xflb:bezeichnung>Verwendungsbestätigung (Muster 4a zu Art. 44 BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-027/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>8110e120-607a-4f35-9d07-783a15465af3</xflb:id>\n                     <xflb:bezeichnung>Ermittlung zuwendungsfähige Kosten nach Muster 1 zu den Nrn. 11.1.2 und 11.4 RZStra</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rnb/rnb-zz/31/rnb_31-001/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>229f4e3b-6b79-4ad2-b611-9e73646e51fb</xflb:id>\n                     <xflb:bezeichnung>Mitteilung gem. Nr. 1.1 NBest-Bau - Zuwendungen/Zuweisungen nach BayFAG und BayGVFG</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-009/index</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n               <xflb:onlinedienste>\n                  <xflb:onlinedienst>\n                     <xflb:id>596f229b-16f0-4ecb-80d1-d37bb064ec5a</xflb:id>\n                     <xflb:bezeichnung>Beantragung einer Zuwendung für Radweginfrastruktur, Straßen- und Brückenbau nach Art. 13f BayFAG</xflb:bezeichnung>\n                     <xflb:link>https://foerderung.bayern.de/landingpage/f7881088-d5d1-4d98-b58f-7339a28e9c8e</xflb:link>\n                     <xflb:beschreibung>Sie können die Förderung über die Fördermanagementplattform Bayern (FMP) digital beantragen.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n               </xflb:onlinedienste>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Zuwendungen zu den einzelnen Fördertatbeständen können Gemeinden und Landkreise gemäß den Zuordnungen in der Beschreibung erhalten.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Es wird eine Anteils- oder Festbetragsförderung bezogen auf die zuwendungsfähigen Kosten gewährt. Die Bemessung der Höhe der Förderung richtet sich nach Nr. 7 RZStra.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Zuwendungsfähig sind Bauausgaben für den Straßenkörper und das Zubehör. Weiterführende Informationen finden Sie in Nr. 6 der Richtlinien für Zuwendungen des Freistaates Bayern zu Straßen- und Brückenbauvorhaben kommunaler Baulastträger (RZStra).&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Wohnen, Bau und Verkehr</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 44 Bayerische Haushaltsordnung (BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO-44</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 13f Bayerisches Gesetz über den Finanzausgleich zwischen Staat, Gemeinden und Gemeindeverbänden (Bayerisches Finanzausgleichsgesetz - BayFAG)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayFAG-13f</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinien für Zuwendungen des Freistaates Bayern zu Straßen- und Brückenbauvorhaben kommunaler Baulastträger (RZStra)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_605_B_14508</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Allgemeine Nebenbestimmungen für Zuwendungen zur Projektförderung an kommunale Körperschaften (ANBest-K)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN122</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Baufachliche Ergänzungsbestimmungen für Zuwendungen (BayZBau)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN123</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Baufachliche Nebenbestimmungen (NBest-Bau)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN125</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Allgemeine Nebenbestimmungen für Zuwendungen zur Projektförderung (ANBest-P)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN121</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Verordnung zur Durchführung des Gesetzes über den Finanzausgleich zwischen Staat, Gemeinden und Gemeindeverbänden (Bayerische Durchführungsverordnung Finanzausgleichsgesetz - FAGDV)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayFAGDV02</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Anlage 4a zu Art. 44 BayHO - Unterlagen für Baumaßnahmen</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN124</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat 43</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Förderungen nach Art. 13f BayFAG (Sonderbaulast)</xflb:programmtitel>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2025-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2030-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Aus Mitteln des Bayerischen Finanzausgleichsgesetzes (Art. 13f BayFAG) können gefördert werden:&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bau von in gemeindlicher Sonderbaulast stehenden Ortsumfahrungen bzw. Entlastungsstraßen im Zuge von Staatsstraßen,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Änderung von bestehenden Kreuzungen von Staatsstraßen mit Kreis- und/oder Gemeindestraßen, soweit die betroffenen Gemeinden und Landkreise die Änderungskosten übernehmen,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bau von unselbständigen (Geh- und) Radwegen an Staatsstraßen, soweit die Gemeinde die Kosten übernimmt,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bau oder Ausbau von Radschnellwegen und anderen Geh- und Radwegen im Sinn von Art. 53 Nr. 2 des Bayerischen Straßen- und Wegegesetzes sowie der Ausbau von öffentlichen Feld- und Waldwegen im Sinn von Art. 53 Nr. 1 BayStrWG, die für den überörtlichen Radverkehr von Verkehrsbedeutung sind und bei denen die Gemeinden Träger der Baulast oder die Landkreise Träger der Sonderbaulast sind,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;bauliche Maßnahmen der Gemeinden und Landkreise zur Herstellung der Barrierefreiheit und Verbesserung der Zuwegung im Übergangsbereich vom Individual- zum öffentlichen Verkehr,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Planungen im Hinblick auf Maßnahmen zur Herstellung der Barrierefreiheit an Bahnstationen.&lt;/li&gt;&lt;/ul&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die übrige Finanzierung des Vorhabens oder eines Bauabschnittes mit eigener Verkehrsbedeutung muss gewährleistet sein.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Das Vorhaben muss nach Art und Umfang zur Verbesserung der Verkehrsverhältnisse dringend erforderlich sein.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Das Vorhaben muss bau- und verkehrstechnisch einwandfrei sein, den Naturhaushalt, das Landschaftsbild und Flächen so weit wie möglich schonend und unter Berücksichtigung des Grundsatzes der Wirtschaftlichkeit und Sparsamkeit geplant sein.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Belange von Menschen mit Behinderungen oder mit Mobilitätseinschränkungen müssen berücksichtigt sein.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Eine Förderung nach Art. 13f BayFAG ist nur dann möglich, wenn die zuwendungsfähigen Kosten die Bagatellgrenze von 50.000 Euro und bei Planungen im Hinblick auf Maßnahmen zur Herstellung der Barrierefreiheit an Bahnstationen von 100.000 Euro übersteigen.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Das Förderkontingent für neu in das Programm aufzunehmende Projekte ist begrenzt. Wenn die Fördernachfrage die zur Verfügung stehenden Ausgabemittel übersteigt, werden die anderen Fördertatbestände gegenüber den Maßnahmen zur Verbesserung der Barrierefreiheit und Zuwegung sowie gegenüber Planungen im Hinblick auf Maßnahmen zur Herstellung der Barrierefreiheit an Bahnstationen vorrangig finanziert.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Vorhaben an Staatsstraßen sind frühzeitig mit dem zuständigen Staatlichen Bauamt abzustimmen.&lt;/li&gt;&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://foerderung.bayern.de/landingpage/f7881088-d5d1-4d98-b58f-7339a28e9c8e</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Der Förderantrag ist bei der zuständigen Bezirksregierung einzureichen.&lt;/p&gt;</xflb:bewilligung>\n               </xflb:verfahrensablauf>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristJaehrlich>01.09.</xflb:fristJaehrlich>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Anträge sind bis spätestens 1. September des dem Förderbeginn vorausgehenden Jahres einzureichen. \n\nEs wird darauf hingewiesen, dass für die Vorlage von Anträgen auf Gewährung von Zuwendungen aus Mitteln des Art. 13f BayFAG eine Vorlagefrist \nbesteht. \n\nMit dem Vorhaben darf noch nicht begonnen sein.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Erläuterungsbericht</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Ein in Anlehnung an die Richtlinien für die Entwurfsgestaltung im Straßenbau (RE) aufgestellter Entwurf</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Übersichtslageplan Maßstab 1:25.000 oder 1:5.000 mit farbiger Darstellung des überörtlichen Verkehrsnetzes</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Lageplan</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Regelquerschnitt</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Sonderbaulastvereinbarung</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Nachprüfbare Berechnung oder/und Erläuterung über die Kostenbeteiligung Dritter</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Nachweis über die Erfüllung der rechtlichen Voraussetzungen</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Gegen den Zuwendungsbescheid können Sie innerhalb eines Monats Klage erheben. Das zuständige Gericht, bei dem Sie Klage einreichen können, wird Ihnen im Bescheid mitgeteilt.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_126  [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmfh/impulsprogramm_volksmusik/index?caller=bpgfqwmylbgnsdgyzymqytsyjrgafm2vfn6epkwd54ncjucevlz33rpayxg3wizhwcub6ieygl4ywa2yjwxerubzlzlfpdwecnykum3ffwyasm7idgy6okgo5pnpx2tobsbdcix2hgyjcosdylxksa32rljib47cb7jk3mnfrfjwaivrxgl442egtb56ju3faifgpgbgv65bmrpsp47jmusseq3rxcck2puocrz5q8";
                                xyz:begriffeImKontext    [ rdf:_1  "Volksmusik";
                                                           rdf:_2  "Seminare";
                                                           rdf:_3  "Musik";
                                                           rdf:_4  "Kurse";
                                                           rdf:_5  "Impulsprogramm"
                                                         ];
                                xyz:beschreibung         "<p>Die Förderung hat das Ziel, in ganz Bayern Menschen zu motivieren, Volksmusik kennen zu lernen und über einen längeren Zeitraum zu praktizieren. Dadurch sollen neue musikalische Initiativen und Gruppenbildungen angeregt, nachhaltig eingeführt und so das Bewusstsein für Volksmusik gestärkt werden.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Kultur, Medien und Sport" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Vereine";
                                                           rdf:_2  "Kleine und mittlere Unternehmen";
                                                           rdf:_3  "Kommunen"
                                                         ];
                                xyz:foerderprogramm      "Impulsprogramm Volksmusik";
                                xyz:foerderzeitraum.bis  "2027-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2025-06-01T00:00:00.000+00:00";
                                xyz:schluessel           "3599ebb4-1b5d-45ec-a612-f3a638e0110c";
                                xyz:teaser               "Gefördert werden halbjährliche oder jährliche Kurse mit externen Referenten zur Vermittlung von Volksmusik in vielfältigen stilistischen und regionalen Ausprägungen.";
                                xyz:titel                "Impulsprogramm Volksmusik";
                                xyz:titel.tokens         [ rdf:_1  "Impulsprogramm Volksmusik" ];
                                xyz:voraussetzung        "<p>Eine Förderung kommt nur in Betracht, wenn</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">die zuwendungsfähigen Ausgaben für das Vorhaben abzüglich des erforderlichen Eigenanteils der Höhe der Zuwendung entsprechen oder diese übersteigen,</li>\n  <li class=\"unordered-list-item--dash\">der Antragsteller oder die Antragstellerin in der Lage ist, seine oder ihre finanzielle Leistungsfähigkeit zur Erbringung des Eigenanteils nachzuweisen,</li>\n  <li class=\"unordered-list-item--dash\">mit dem Vorhaben keine kommerziellen Interessen verfolgt werden,</li>\n  <li class=\"unordered-list-item--dash\">wenn es sich für die Institution um eine neuartige Aktivität handelt. Die Kurse müssen in den Institutionen vor Ort oder in anderen, hierfür den Institutionen zu Verfügung gestellten Räumlichkeiten abgehalten werden und</li>\n  <li class=\"unordered-list-item--dash\">wenn die Kurse von externen Referenten geleitet werden, die vor Stellung des Förderantrags im Referentenpool (<a href=\"https://www.heimat-bayern.de/volksmusik/referentenpool/\">https://www.heimat-bayern.de/volksmusik/referentenpool/</a>) eingetragen sind.</li>\n</ul>\n<p><br></p>"
                              ];
              xyz:id          "3599ebb4-1b5d-45ec-a612-f3a638e0110c";
              xyz:payload     [ xyz:json  [ xyz:anfrage            [ xyz:anfragenummer  "3599ebb4-1b5d-45ec-a612-f3a638e0110c";
