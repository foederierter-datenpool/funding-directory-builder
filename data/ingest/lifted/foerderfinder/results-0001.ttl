                                xyz:beschreibung         "<p>Zweck der Förderung ist der demenzsensible Umbau, die Modernisierung und die Schaffung von Tages- und Nachtpflegeplätzen.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
