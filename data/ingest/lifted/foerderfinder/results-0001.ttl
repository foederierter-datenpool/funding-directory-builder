                                                         ];
                                xyz:beschreibung         "Die Förderung hat das Ziel, partizipative Projekte mit künstlerisch-kulturellem Schwerpunkt für Kinder, Jugendliche und Erwachsene, bayernweit und mit besonderem Nachdruck in der Fläche zu unterstützen.";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
