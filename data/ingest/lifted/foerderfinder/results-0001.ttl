                                                                                                             xyz:antragsinformationen    [ xyz:antragsfrist             [ xyz:bemerkung             "Dies ist der Stichtag für die Abgabe von Anträgen auf Gewährung der Vereinspauschale eines Förderjahres. Es handelt sich hierbei um eine Ausschlussfrist. Verspätet eingegangene Anträge können nicht mehr berücksichtigt werden.";
                                                                                                                                                                          xyz:zeitlicheEingrenzung  [ xyz:fristJaehrlich
                                                                                                                                                                                            "01.03." ]
                                                                                                                                                                        ];
