                                                                                                                       xyz:kummulierbareFoerderungen  [ xyz:beschreibungAusschluss  "<p>Eine Förderung entfällt, wenn für die entstehenden zuwendungsfähigen Ausgaben anderweitige Mittel des Freistaates Bayern in Anspruch genommen werden.</p>";
                                                                                                                                                        xyz:voraussetzungen         "<p>Eine Komplementärförderung mit Mitteln der Kommunen, des Bundes oder der Europäischen Union ist möglich.</p>"
                                                                                                                                                      ];
                                                                                                                       xyz:programmlaufzeit           [ xyz:beginnLaufzeitFoerderprogramm
                                                                                                                                                                "2026-01-01";
                                                                                                                                                        xyz:endeLaufzeitFoerderprogramm
