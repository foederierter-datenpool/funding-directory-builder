                                xyz:xml   "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           produkt=\"Förderfinder\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produktversion=\"\"\n                                           standard=\"XFLB\"\n                                           test=\"\"\n                                           version=\"2.0.0\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0 xflb.xsd\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>12949681-3a6f-4397-82c9-cd2dc630ea52</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-12-09T13:07:48</xflb:erstellungszeitpunkt>\n      <xflb:sender>Förderfinder Suche (Bayern)</xflb:sender>\n      <xflb:empfaenger>XFLB-Connect (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>12949681-3a6f-4397-82c9-cd2dc630ea52</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>12949681-3a6f-4397-82c9-cd2dc630ea52</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:programmtitel>Gewährung eines Staatszuschusses zur Lernmittelfreiheit nach Art. 46 BaySchFG</xflb:programmtitel>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Unterricht und Kultus</xflb:verantwortlichesMinisterium>\n               <xflb:verantwortlichesFachreferat>II.6</xflb:verantwortlichesFachreferat>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BaySchFG-46</xflb:link>\n                     <xflb:bezeichnung>Art 46 i. V. m. Art. 21 Bayerisches Schulfinanzierungsgesetz (BaySchFG)</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayAVSchFG</xflb:link>\n                     <xflb:bezeichnung>§§ 19a, 13b Verordnung zur Ausführung des Bayerischen Schulfinanzierungsgesetzes (Ausführungsverordnung Schulfinanzierungsgesetz - AVBaySchFG)</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BaySchFG-22</xflb:link>\n                     <xflb:bezeichnung>Art. 22 Bayerisches Schulfinanzierungsgesetz (BaySchFG)</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVwV229856</xflb:link>\n                     <xflb:bezeichnung>Vollzug der Vorschriften des Bayerischen Gesetzes über das Erziehungs- und Unterrichtswesen und des Bayerischen Schulfinanzierungsgesetzes über die Lernmittelfreiheit</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name>Bayern</name>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Private Schulen; Beantragung eines Zuschusses zur Lernmittelfreiheit</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Durch Zuschüsse sollen private Träger des Schulaufwands bei der Finanzierung von Schulbüchern unterstützt werden.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Zuschuss für Träger privater Ersatzschulen, wenn Lernmittelfreiheit wie an den öffentlichen Schulen gewährt wird</xflb:teaser>\n                  <xflb:schluesselwoerter>Private Ersatzschule, Lernmittelfreiheit</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Landesamt für Schule</xflb:name>\n                  <xflb:telefonnummer>+49 9831 5166-0</xflb:telefonnummer>\n                  <xflb:email>poststelle@las.bayern.de</xflb:email>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n                  <xflb:adresse>\n                     <xflb:strasse>Stuttgarter Straße</xflb:strasse>\n                     <xflb:hausnummerPostfach>1</xflb:hausnummerPostfach>\n                     <xflb:ort>Gunzenhausen</xflb:ort>\n                     <xflb:postleitzahl>91710</xflb:postleitzahl>\n                  </xflb:adresse>\n                  <xflb:verweis>\n                     <xflb:link>www.las.bayern.de</xflb:link>\n                     <xflb:bezeichnung>Bayerisches Landesamt für Schule</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Bayerisches Landesamt für Schule</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Den privaten Ersatzschulen ist es freigestellt, Lernmittelfreiheit zu gewähren. Sofern Lernmittelfreiheit wie an den öffentlichen Schulen gewährt wird, erhalten sie entsprechend eine staatliche Förderung.&lt;/p&gt;\n&lt;p&gt;Sofern an privaten Ersatzsschulen Lernmittelfreiheit wie an den öffentlichen Schulen gewährt wird, erhalten sie entsprechend eine staatliche Förderung. Zu den Kosten gewährt der Staat pauschalierte Zuweisungen pro Schüler und Schuljahr.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>002</code>\n                  <name>Kleine und mittlere Unternehmen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name>Verbände</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name>Vereine</name>\n               </xflb:foerdernehmende>\n            </xflb:foerdernehmende>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Gewährung von Lernmittelfreiheit wie an öffentlichen Schulen, d. h. (kostenfreie) leihweise Versorgung der Schülerinnen und Schüler mit Schulbüchern.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:finanzierung>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Zu den Kosten gewährt der Staat pauschalierte Zuweisungen pro Schülerin und Schüler und Schuljahr i.H.v. - schulartabhängig - 12 € bzw. 26,67 €, abweichend bei privaten Grundschulen, Mittelschulen und Förderschulen 18 € bzw. 40 €. Grundlage der Zuschussberechnung sind die amtlichen Schülerzahlen des vorangegangenen Schuljahres.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Kosten der Lernmittelfreiheit (Finanzierung von Schulbüchern)&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n            </xflb:finanzierung>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.las.bayern.de/schulfinanzierung/downloads/Lernmittelzuschuss%20-%20ausfuellbares%20PDF.pdf</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Die Aufwandsträger der Ersatzschulen reichen die Anträge bis zum 1. Juni eines jeden Jahres für das bevorstehende Schuljahr beim Landesamt für Schule mit dem bereitgestellten Formular ein.&lt;/p&gt;\n&lt;p&gt;Das Landesamt für Schule prüft die eingereichten Anträge und setzt die Höhe der Staatszuschüsse für die einzelnen Antragsteller fest.&lt;/p&gt;\n&lt;p&gt;Bei einem fristgerechten Antragseingang werden zwei Drittel der Zuschüsse zu Beginn des Schuljahres und das verbleibende Drittel im Laufe des zweiten Schulhalbjahres an die Aufwandsträger der privaten Schulen ausgezahlt.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>006</code>\n                     <name/>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n            </xflb:antragsinformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>12949681-3a6f-4397-82c9-cd2dc630ea52</xflb:foerderschluessel>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n               </xflb:interneKennung>\n            </xflb:zuordnungen>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-12-09T13:07:48</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>002</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>\n"
                              ]
            ];
  rdf:_117  [ xyz:attributes  [ xyz:antragsstellung      "https://www.zbfs.bayern.de/imperia/md/content/blvf/esf/landesmittel/antragsformular_barrierefrei_2025.pdf";
                                xyz:begriffeImKontext    [ rdf:_1  "Krebsberatung";
                                                           rdf:_2  "Krebs";
                                                           rdf:_3  "Gesundheit"
                                                         ];
                                xyz:beschreibung         "<p>Mit dieser Förderung unterstützt der Freistaat Bayern gemeinsam mit den Bezirken ambulante Krebsberatungsstellen. Ziel ist es, dass Menschen mit einer Krebserkrankung und ihre Angehörigen wohnortnah Beratung und psychosoziale Hilfe erhalten.</p><p>Träger ambulanter Krebsberatungsstellen in Bayern, die bereits eine Förderung durch den GKV-Spitzenverband nach § 65e SGB V erhalten, können im Wege einer Kofinanzierung zusätzlich eine Förderung des Freistaats und der Bezirke erhalten.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Arbeit";
                                                           rdf:_2  "Beratung";
                                                           rdf:_3  "Gesundheit und Soziales"
                                                         ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Verbände" ];
                                xyz:foerderprogramm      "Förderung ambulanter Krebsberatungsstellen in Bayern; Beantragung einer Förderung";
                                xyz:foerderzeitraum.bis  "2028-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2026-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "bd9aa6d0-8d2a-445b-92b3-5d274d687627";
                                xyz:teaser               "Der Freistaat Bayern und die bayerischen Bezirke unterstützen ambulante Krebsberatungsstellen, die psychosoziale Beratung und Unterstützung für krebskranke Menschen und ihre Angehörigen anbieten.";
                                xyz:titel                "Förderung ambulanter Krebsberatungsstellen";
                                xyz:titel.tokens         [ rdf:_1  "Förderung ambulanter Krebsberatungsstellen" ];
                                xyz:voraussetzung        "<p>Antragsberechtigt sind die Träger ambulanter Krebsberatungsstellen in Bayern.</p><p>Sofern Sie eine Krebsberatungsstelle betreiben,&nbsp;</p><ul><li class=\"unordered-list-item--dash\">die ihren Standort in Bayern hat,&nbsp;</li><li class=\"unordered-list-item--dash\">dort den an Krebs erkrankten Personen und ihren Angehörigen psychosoziale Beratung und Unterstützung anbieten&nbsp;</li><li class=\"unordered-list-item--dash\">und hierfür eine Förderung gemäß § 65e des Fünften Buches Sozialgesetzbuch (SGB V) nach den Fördergrundsätzen des Spitzenverbands Bund der Krankenkassen (GKV-Spitzenverband) erhalten,&nbsp;</li></ul><p>können Sie im Wege einer Kofinanzierung - zusätzlich zur Förderung durch den GKV-Spitzenverband - eine Förderung des Freistaats und der Bezirke erhalten.&nbsp;Wenn die GKV-Förderung durch die Krankenkassen ganz oder teilweise entfällt, endet oder reduziert sich auch die Förderung durch den Freistaat und die Bezirke.</p>"
                              ];
              xyz:id          "bd9aa6d0-8d2a-445b-92b3-5d274d687627";
