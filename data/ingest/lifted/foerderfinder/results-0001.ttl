                                                                                                                                           xyz:linkZurAntragsstellung   "https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/rmf_15-024-zz_zuwendungsantrag/index?caller=bpmu2dqmjqmfrgeolegrsggolgmzjsccafh6ang7xd6dbbvgkqjdz5pdxszqsxkpj245avkunc2ntpbs2avc6polf2wojqlvdywvutmmx3l373gmexecds5fpr2ytvcarvhdnyg7n5t3nw4usg4msz3n44lgeb63quajz5hszyfnf2dmqha43z3v5csznkqdmtxzhbaqoknw2dpxa7nzdd5aajja6j2jlwwrzshnq8";
                                                                                                                                           xyz:rechtsbehelf             "<p>Gegen den Zuwendungsbescheid können Sie innerhalb eines Monats nach seiner Bekanntgabe Klage erheben. Das zuständige Gericht, bei dem Sie Klage einreichen können, wird Ihnen im Bescheid mitgeteilt.</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<h4>Antragstellung</h4><p>Anträge sind unter Verwendung der bei der Regierung von Mittelfranken erhältlichen Vordrucke zu stellen. Dieser ist rechtzeitig vor Beginn des geplanten Bewilligungszeitraums zu stellen.</p><h4>Bewilligung</h4><p>Zuständig für die Bewilligung ist die Regierung von Mittelfranken.</p>";
                                                                                                                                                                          xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "002";
                                                                                                                                                                                                            xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
                                                                                                                                                                                                            xyz:listVersionID  "1"
                                                                                                                                                                                                          ]
                                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:euBeihilferelevanz        "unzutreffend";
                                                                                                                                           xyz:finanzierungsartUndHoehe  "<p>Die Förderung wird als nicht rückzahlbarer Zuschuss als Festbetragsfinanzierung im Rahmen der Projektförderung in Form von Individualhilfen gewährt (Pro-Kopf-Pauschalen). Die Förderung der außerschulischen Hausaufgabenhilfe erfolgt ohne Rechtsanspruch im Rahmen der zur Verfügung stehenden Haushaltsmittel und subsidiär zu eventuellen anderen Leistungen.</p>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "001";
                                                                                                                                                                                                    xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
                                                                                                                                                                                                    xyz:listVersionID  "1";
                                                                                                                                                                                                    xyz:name           ""
                                                                                                                                                                                                  ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:laufzeitFinanzierung      [ xyz:laufzeitFinanzierung  [ xyz:code           "001";
                                                                                                                                                                                                       xyz:listURI        "urn:xoev-de:stmd:codeliste:laufzeit-finanzierung";
                                                                                                                                                                                                       xyz:listVersionID  "1";
                                                                                                                                                                                                       xyz:name           "Gesamte Projektlaufzeit"
                                                                                                                                                                                                     ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Zuwendungsfähig ist die außerschulische Hausaufgabenhilfe mit Schwerpunkt Deutschförderung. Gefördert werden pro Schuljahr maximal 39 Wochen außerhalb der Ferienzeiten mit maximal bis zu vier Zeitstunden (zu 60 Minuten) wöchentlich pro Teilnehmenden. Die Förderung erfolgt je Teilnehmenden für maximal vier Jahre an bayerischen Schulen im Sinne der Nr. 4.4.2. Die Förderung beträgt je Gruppe 15 Euro je Zeitstunde und erhöht sich ab dem siebten Teilnehmenden um 1,50 Euro je Teilnehmenden und Stunde.</p>"
                                                                                                                                         ];
