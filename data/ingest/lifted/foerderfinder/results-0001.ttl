                                xyz:titel.tokens         [ rdf:_1  "Erstellung von Sanierungs- und Strukturkonzepten" ];
                                xyz:voraussetzung        "Sanierungs- und Strukturkonzepte nach Nr. 2.2.5 RZWas 2021 sind ohne Erreichen einer Härtefallschwelle  und ohne vorherige Prüfung förderfähig.\nDas Konzept muss für das Wasserwirtschaftsamt akzeptabel sein.\nWeitere Details erfahren Sie bei Ihrem örtlich zuständigen Wasserwirtschaftsamt."
                              ];
