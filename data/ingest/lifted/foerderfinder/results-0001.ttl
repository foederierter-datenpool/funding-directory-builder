                                                                                                                                                             "ja" ];
                                                                                                                                           xyz:bearbeitungsdauer        [ xyz:bewilligung  [ xyz:dauerSpanne  [ xyz:maxDauer  [ xyz:monate  "18" ];
                                                                                                                                                                                                                xyz:minDauer  [ xyz:monate  "9" ]
                                                                                                                                                                                                              ]
                                                                                                                                                                                           ]
