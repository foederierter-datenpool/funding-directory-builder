                                                                                                                                           xyz:erforderlicheUnterlagen  [ xyz:dokument  [ rdf:_1   [ xyz:bezeichnung  "Antragsformular und folgende Anlagen:" ];
                                                                                                                                                                                          rdf:_10  [ xyz:bezeichnung  "c) Erläuterungsbericht nach Muster 6 zu den VV zu Art. 44 BayHO," ];
                                                                                                                                                                                          rdf:_11  [ xyz:bezeichnung  "d) Flächenzusammenstellung zum Erläuterungsbericht nach Muster 6a zu Art. 44 BayHO" ];
                                                                                                                                                                                          rdf:_12  [ xyz:bezeichnung  "e) Kostenermittlung nach Muster 5 zu den VV zu Art. 44 BayHO oder nach DIN276, wobei diejenigen Kosten, für die eine Zuwendung beantragt wird, gesondert auszuweisen sind; gegebenenfalls sind weitere Kostenaufschlüsselungen oder Berechnungen, deren Ergebnisse der Kostenermittlung zugrunde gelegt wurden, beizufügen; Flächen und Rauminhalte sind nach DIN277 zu berechnen." ];
                                                                                                                                                                                          rdf:_13  [ xyz:bezeichnung  "Im Einzelfall kann die Bewilligungsbehörde auf die Vorlage bestimmter Unterlagen verzichten oder weitere Unterlagen anfordern." ];
                                                                                                                                                                                          rdf:_2   [ xyz:bezeichnung  "a) Eine Projektbeschreibung, in der neben Einzelheiten zum Projekt, insbesondere Titel, Ort, Beginn und Ende, vor allem Hintergrund und Ziele sowie die Bedeutung des Projekts für die medizinische Qualität in den hochprädikatisierten Kurorten und Heilbädern dargestellt werden," ];
                                                                                                                                                                                          rdf:_3   [ xyz:bezeichnung  "b) ein Finanzierungsplan (aufgegliederte Berechnung der mit dem Zuwendungszweck zusammenhängenden Ausgaben mit einer Übersicht über die beabsichtigte Finanzierung)," ];
                                                                                                                                                                                          rdf:_4   [ xyz:bezeichnung  "c) EU-Beihilferechtliche Erklärung ((DAWI-)De-minimis-Erklärung)." ];
                                                                                                                                                                                          rdf:_5   [ xyz:bezeichnung  "Ggf. Stellungnahme des Datenschutzbeauftragten" ];
                                                                                                                                                                                          rdf:_6   [ xyz:bezeichnung  "Ggf. Votum der zuständigen Ethikkommission" ];
                                                                                                                                                                                          rdf:_7   [ xyz:bezeichnung  "Sollte das Projekt Baumaßnahmen enthalten, sind dem Antragsformular ferner beizufügen:" ];
                                                                                                                                                                                          rdf:_8   [ xyz:bezeichnung   "a) Planunterlagen bestehend aus:";
                                                                                                                                                                                                     xyz:erlaeuterung  "aa) dem Bau-, dem Raumprogramm oder beidem, gegebenenfalls mit Anerkennungsvermerk,\n\nbb) einem Übersichtsplan und - sofern vorhanden - eine topografische Karte im Maßstab 1:25.000 (TK 25),\n\ncc) einem Lageplan des Bauvorhabens, mindestens im Maßstab 1:1000, mit Darstellung der Erschließung,\n\ndd) Plänen, die Art und Umfang des Bauvorhabens prüfbar nachweisen,"
                                                                                                                                                                                                   ];
                                                                                                                                                                                          rdf:_9   [ xyz:bezeichnung  "b) Vorbescheide oder sonstige Nachweise über die baurechtliche Zulässigkeit," ]
                                                                                                                                                                                        ]
                                                                                                                                                                        ];
                                                                                                                                           xyz:linkZurAntragsstellung   "https://www.lgl.bayern.de/gesundheit/praevention/kurorte_heilbaeder/foerderprogramm/index.htm";
                                                                                                                                           xyz:rechtsbehelf             "<p>Gegen den Zuwendungsbescheid können Sie innerhalb eines Monats nach seiner Bekanntgabe Klage erheben. Das zuständige Gericht, bei dem Sie Klage einreichen können, wird Ihnen im Bescheid mitgeteilt.</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<p>Der Antrag ist beim Bayerischen Landesamt für Gesundheit und Lebensmittelsicherheit (LGL) einzureichen. Bei Anträgen von Gemeinden ist zusätzlich das Formblatt nach Muster 1a zu Art. 44 BayHO beizufügen. Das LGL ist Bewilligungsbehörde.</p><p>Bevor Sie das Antragsformular anfordern, empfehlen wir Ihnen, anhand der kurzen Checkliste (<a href=\"https://www.lgl.bayern.de/downloads/gesundheit/praevention/doc/kuhemo_foer_checkliste.pdf\" dir=\"ltr\">https://www.lgl.bayern.de/downloads/gesundheit/praevention/doc/kuhemo_foer_checkliste.pdf</a>) zu überprüfen, ob Sie die wesentlichen Zuwendungsvoraussetzungen erfüllen und damit eine Antragstellung grundsätzlich Aussicht auf Erfolg haben könnte bzw. der Antrag prüffähig ist. Das Antragsformular ist per E-Mail (<a href=\"mailto:ikom@lgl.bayern.de\" dir=\"ltr\">ikom@lgl.bayern.de</a>) anzufordern.</p>";
                                                                                                                                                                          xyz:erlaeuterungVorzeitigerMassnahmebeginn
                                                                                                                                                                                  "<p>Sofern bis zum beantragten Projektbeginn keine abschließende Förderentscheidung getroffen werden kann, muss die Zustimmung zum \"Vorzeitigen Vorhabenbeginn\" eingeholt werden. Dies erfolgt mit einem separaten Antrag. Es ist zu beachten, dass bereits begonnene Projekte nicht gefördert werden können. Folglich darf mit dem Projekt nicht vor der Förderzusage bzw. der Zustimmung zum vorzeitigen Vorhabenbeginn begonnen werden.</p>";
