                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>e368b99e-a725-49af-8d1a-01845adb6410</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-12-17T16:38:03</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>e368b99e-a725-49af-8d1a-01845adb6410</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>e368b99e-a725-49af-8d1a-01845adb6410</xflb:schluessel>\n         <xflb:versionFLB>3</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-09-21T13:40:55</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>e368b99e-a725-49af-8d1a-01845adb6410</xflb:foerderschluessel>\n                  <xflb:flbVersion>3</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99148187000000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Projekte und Maßnahmen zur Suchtprävention und Suchtbekämpfung</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Durchführung gezielter, niedrigschwelliger Schwerpunktprojekte zur Suchtprävention und Suchtbekämpfung unter Beachtung regionaler Gegebenheiten, insbesondere zu neu auftretenden stofflichen und nicht-stofflichen Suchtgefahren und solchen mit herausgehobener gesundheitlicher Bedeutung.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Projekte und Maßnahmen zur Suchtprävention und Suchtbekämpfung</xflb:teaser>\n                  <xflb:schluesselwoerter>Suchtprävention, Suchtbekämpfung</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Grundsätze für die suchtpräventive Arbeit in Bayern</xflb:bezeichnung>\n                     <xflb:link>fimportal.de/search?sdg_relevant=undefined&amp;sprache=undefined&amp;vollzugsbehoerde=undefined&amp;leistung_geaendert_seit=&amp;term=99090009027000&amp;leistung_suche_in=undefined&amp;order_by=relevance&amp;resource=leistung-steckbriefe&amp;page_size=20</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Staatsministerium für Gesundheit, Pflege und Prävention</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>1</xflb:hausnummerPostfach>\n                     <xflb:strasse>Haidenauplatz</xflb:strasse>\n                     <xflb:postleitzahl>81667</xflb:postleitzahl>\n                     <xflb:ort>München</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>poststelle@stmgp.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Bayerisches Staatsministerium für Gesundheit, Pflege und Prävention</xflb:bezeichnung>\n                     <xflb:link>https://www.stmgp.bayern.de/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>089 95414 0</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>für den Maßnahmenstandort zuständige Regierung</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>90b2b426-fb09-40ba-b601-a5816ed0d253</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Gewährung einer staatlichen Zuwendung - Förderprogramm: Suchtbekämpfung</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/13/rmf_13-037/index</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Träger dieser Projekte und Maßnahmen können ebenfalls die Spitzenverbände der freien Wohlfahrtspflege und deren Mitgliedsorganisationen sowie kommunale Gebietskörperschaften in Bayern sein.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Förderung wird als Zuschuss im Rahmen einer Projektförderung in Form der Anteilfinanzierung gewährt.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Der Fördersatz beträgt bis zu 90 % der zuwendungsfähigen Ausgaben.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Personalausgaben sind maximal zuwendungsfähig in Höhe der Personalausgabenhöchstsätze bei Zuwendungen des Freistaats Bayern des Staatsministeriums der Finanzen und für Heimat in der jeweils geltenden Fassung.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Festsetzung der maßgeblichen Pauschale (Entgeltgruppe) orientiert sich an den Eingruppierungsbestimmungen des TV-L. &amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Für Personal, dessen Beschäftigung für eine geringere als die regelmäßige tarifliche Arbeitszeit nach TV-L vereinbart ist, werden die Personalausgaben im Verhältnis der vereinbarten zur regelmäßigen tariflichen Arbeitszeit nach TV-L gekürzt.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Der Zuwendungsempfänger hat sich mit einem angemessenen Eigenanteil in Höhe von mindestens 10 %&amp;nbsp;der zuwendungsfähigen Ausgaben an der Finanzierung zu beteiligen. &amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Zuwendungsfähig sind Personalausgaben für Fachpersonal und für Verwaltungskräfte.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Zuwendungsfähig sind Sachausgaben, die im Zusammenhang mit dem jeweiligen Projekt anfallen.&lt;/li&gt;&lt;/ul&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerFest>\n                        <xflb:jahre>1</xflb:jahre>\n                     </xflb:dauerFest>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n               <xflb:euBeihilferelevanz>Bei Zuwendungen im Rahmen dieser Förderrichtlinie handelt es sich grundsätzlich um eine sog. DAWI-De-minimis-Beihilfe nach der DAWI-De-minimis-Verordnung: Verordnung Nr. 2023/2832 der Kommission vom 13. Dezember 2023 über die Anwendung der Artikel 107 und 108  des Vertrags über die Arbeitsweise der Europäischen Union auf De-minimis-Beihilfen an Unternehmen, die Dienstleistungen von allgemeinem wirtschaftlichem Interesse erbringen (Amtsblatt der Europäischen Union L, 2023/2832, 15. Dezember 2023).</xflb:euBeihilferelevanz>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Gesundheit, Pflege und Prävention</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinie zur Förderung von Präventions- und Beratungsangeboten im  Suchtbereich (PBS-Förderrichtlinie PBS-FöR) ,BayMBl. 2021 Nr. 805</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2126_1_G_12555</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 44 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO-44</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 23 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO-23</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat 54</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Förderung von Präventions- und Beratungsangeboten im Suchtbereich</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2027-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2025-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2027-12-31</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:verlaengerungsoption>jährlich</xflb:verlaengerungsoption>\n               </xflb:programmlaufzeit>\n               <xflb:kummulierbareFoerderungen>\n                  <xflb:beschreibungAusschluss>&lt;p&gt;Eine Förderung nach dieser Richtlinie entfällt, wenn für den gleichen Zuwendungszweck andere Mittel des Freistaates Bayern in Anspruch genommen werden.&lt;/p&gt;</xflb:beschreibungAusschluss>\n                  <xflb:verweise>\n                     <xflb:verweis>\n                        <xflb:bezeichnung>Bayerisches Staatsministerium für Gesundheit, Pflege und Prävention</xflb:bezeichnung>\n                        <xflb:link>https://www.stmgp.bayern.de/service/foerderprogramme/#PBS</xflb:link>\n                     </xflb:verweis>\n                  </xflb:verweise>\n                  <xflb:voraussetzungen>&lt;p&gt;Eine Komplementärförderung mit Mitteln der Kommunen, des Bundes oder der Europäischen Union ist möglich.&amp;nbsp;Auch in diesen Fällen hat sich der Zuwendungsempfänger mit einem angemessenen Eigenanteil in Höhe von mindestens 10 % der zuwendungsfähigen Ausgaben an der Finanzierung zu beteiligen.&lt;/p&gt;</xflb:voraussetzungen>\n               </xflb:kummulierbareFoerderungen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert werden Personalausgaben sowie Sachausgaben.&amp;nbsp;&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Projekte und Maßnahmen sind in enger fachlicher Abstimmung mit der Bewilligungsbehörde und dem Staatsministerium für Gesundheit, Pflege und Prävention (StMGP) zu planen und durchzuführen.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die projektbezogenen Qualitätsstandards der Suchtprävention in Bayern, die auf den Seiten des Bayerischen Zentrums für Prävention und Gesundheitsförderung (ZPG) genannt sind, sind umzusetzen.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Vor Projektbeginn sind verständliche, konkrete, erreichbare und überprüfbare Ziele der Maßnahme zu definieren. Einen Orientierungsrahmen hierfür bilden z. B. die SMART-Kriterien, also spezifisch, messbar, aktuell, realistisch und terminiert.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Maßnahmen müssen mit dem Dokumentationssystem Dot.sys erfasst und die Projektschritte dokumentiert werden.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Ergebnisse bezogen auf die definierten Ziele, sollen erfasst und dargestellt werden.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Eine begleitende Prozessevaluation ist standardmäßig durchzuführen.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Fachkräfte verfügen über eine für die Durchführung des Projekts oder der Maßnahme erforderliche Qualifikation.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Gegenüber der Bewilligungsbehörde ist darzulegen, welche Qualifikation für das Projekt oder die Maßnahme erforderlich ist und nachzuweisen, dass diese bei den Fachkräften vorliegt.&lt;/li&gt;&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Eine Förderung nach dieser Richtlinie entfällt, wenn für den gleichen Zuwendungszweck andere Mittel des Freistaates Bayern in Anspruch genommen werden.&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/13/rmf_13-037/index</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Projekte und Maßnahmen sind in enger fachlicher Abstimmung mit der Bewilligungsbehörde &amp;nbsp;und dem Bayerischen Staatsministerium für Gesundheit, Pflege und Prävention&amp;nbsp;(StMGP) zu planen und durchzuführen. Die projektbezogenen Qualitätsstandards der Suchtprävention in Bayern, die auf den Seiten des Bayerischen Zentrums für Prävention und Gesundheitsförderung (ZPG) genannt sind, sind umzusetzen.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>&lt;p&gt;Ist es für eine erfolgreiche Durchführung des Vorhabens zwingend notwendig, bereits vor Erhalt des Förderbescheids einen Arbeits- oder Leistungsvertrag abzuschließen, ist eine Zustimmung zu einem vorzeitigen Maßnahmebeginn möglich.&lt;/p&gt;</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:wochen>2</xflb:wochen>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:wochen>4</xflb:wochen>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristFest>\n                        <xflb:jahre>1</xflb:jahre>\n                     </xflb:fristFest>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Förderanträge zur Fortführung bereits bestehender Maßnahmen und Projekte (Folgeanträge) sind bei der Bewilligungsbehörde jeweils bis zum 1. Dezember des dem beantragten Förderzeitraum vorausgehenden Jahres vorzulegen. Bewilligungszeitraum ist das Kalenderjahr.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Projektplan, Qualifikationsnachweis</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Vor Projektbeginn sind verständliche, konkrete, erreichbare und überprüfbare Ziele der Maßnahme zu definieren. Einen Orientierungsrahmen hierfür bilden z. B. die SMART-Kriterien, also spezifisch, messbar, aktuell, realistisch und terminiert.\nDie Fachkräfte verfügen über eine für die Durchführung des Projekts oder der Maßnahme erforderliche Qualifikation. Gegenüber der Bewilligungsbehörde ist darzulegen, welche Qualifikation für das Projekt oder die Maßnahme erforderlich ist und nachzuweisen, dass diese bei den Fachkräften vorliegt.</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Gegen den Bescheid kann innerhalb eines Monats nach seiner Bekanntgabe Klage beim örtlich zuständigen Verwaltungsgericht eingereicht werden.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_91   [ xyz:attributes  [ xyz:antragsstellung      "https://www.stmb.bayern.de/assets/stmi/wohnen/foerderung/bewerbung_jahresbauprogramm_sp.xlsx";
