                                            xyz:nachrichtenkopf    [ xyz:empfaenger            "Förderfinder Suche (Bayern)";
                                                                     xyz:erstellungszeitpunkt  "2024-06-24T08:07:34";
                                                                     xyz:nachrichtennummer     "7e281c6d-cd8c-429e-8b72-102dd8bf5b43";
                                                                     xyz:sender                "XFLB-Connect (Bayern)"
                                                                   ];
                                            xyz:produkt            "Förderfinder";
                                            xyz:produkthersteller  "StMD Bayern";
                                            xyz:schemaLocation     "http://xoev.de/schemata/xflb/2_0_0";
                                            xyz:standard           "XFLB";
                                            xyz:version            "2.0.0"
                                          ];
                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>7e281c6d-cd8c-429e-8b72-102dd8bf5b43</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-06-24T08:07:34</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>7e281c6d-cd8c-429e-8b72-102dd8bf5b43</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>7e281c6d-cd8c-429e-8b72-102dd8bf5b43</xflb:schluessel>\n         <xflb:versionFLB>4</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-08-20T08:02:12</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>7e281c6d-cd8c-429e-8b72-102dd8bf5b43</xflb:foerderschluessel>\n                  <xflb:flbVersion>4</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99148283017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Werteprojekte allgemein</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Zweck der Förderung ist es, Zuwanderinnen und Zuwanderern unsere Werte und Kultur näher zu bringen und verständlich zu machen, um sich besser im Alltag und in unserer Gesellschaft zurechtzufinden. Die Wertevermittlung umfasst dabei die Grundlagen unserer Rechts- und Werteordnung wie Demokratieverständnis, Gleichberechtigung und Toleranz, die Stärkung der Akzeptanz dieser grundlegenden Werte und Regeln sowie die Vermittlung von Wissen über unsere Kultur. Durch interkulturelle und interreligiöse Begegnungen und Austausch soll gegenseitiges Verständnis und das gesellschaftliche Miteinander gestärkt werden. Gleichzeitig wird mit der Förderung bezweckt, Neuzugewanderten mit praktischen Hilfen das Ankommen in der Gesellschaft zu erleichtern und Möglichkeiten zur gesellschaftlichen Partizipation aufzuzeigen.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Das Bayerische Staatsministerium des Innern, für Sport und Integration fördert die Integration von zugewanderten Menschen mit Projekten zur Wertevermittlung. Unterstützt werden Vorhaben, die demokratische Grundwerte stärken und den gesellschaftlichen Zusammenhalt fördern.</xflb:teaser>\n                  <xflb:schluesselwoerter>BayernPortal, Beantragung, Integrationsförderung, Wertevermittlung, Asyl, Integrationsprojekte Beantragung einer Förderung im Bereich der Wertevermittlung, Integration, Werte, Förderung, Werteprojekte, Leben in Bayern, Lebenswirklichkeit in Bayern</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Projekte zur Wertevermittlung in Bayern</xflb:bezeichnung>\n                     <xflb:link>https://www.stmi.bayern.de/a-z/anzeigen/wertevermittlung-in-bayern/</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Regierung von Mittelfranken - Sachgebiet 15 (Integration und Förderung, Ausgleichsamt)</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>21</xflb:hausnummerPostfach>\n                     <xflb:strasse>Marienstraße</xflb:strasse>\n                     <xflb:postleitzahl>90402</xflb:postleitzahl>\n                     <xflb:ort>Nürnberg</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>Sachgebiet-15.Integration@reg-mfr.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Übersicht bei der Regierung von Mittelfranken</xflb:bezeichnung>\n                     <xflb:link>https://www.regierung.mittelfranken.bayern.de/aufgaben/40027/57461/leistung/leistung_132361/index.html</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>+49 (0)911 2352-0</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Regierung von Mittelfranken - Sachgebiet 15 (Integration und Förderung, Ausgleichsamt)</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>21</xflb:hausnummerPostfach>\n                           <xflb:strasse>Marienstraße</xflb:strasse>\n                           <xflb:postleitzahl>90402</xflb:postleitzahl>\n                           <xflb:ort>Nürnberg</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>Sachgebiet-15.Integration@reg-mfr.bayern.de</xflb:email>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Übersicht bei der Regierung von Mittelfranken</xflb:bezeichnung>\n                           <xflb:link>https://www.regierung.mittelfranken.bayern.de/aufgaben/40027/57461/leistung/leistung_132361/index.html</xflb:link>\n                        </xflb:verweis>\n                        <xflb:telefonnummer>+49 (0)911 2352-0</xflb:telefonnummer>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>5f296a09-864b-41ba-8715-318c7938c641</xflb:id>\n                     <xflb:bezeichnung>Formloser Antrag (mit Unterschrift)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/formloseSchreibenmitUnterschrift/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>e5e103e7-4896-4d67-9962-e550765f7070</xflb:id>\n                     <xflb:bezeichnung>Ausgaben- und Finanzierungsplan</xflb:bezeichnung>\n                     <xflb:link>https://www.stmi.bayern.de/media/07_migration-und-integration/Integration/Ausgaben-_und_Finanzierungsplan_2026_Leben_in_Bayern.xlsx</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n               <xflb:onlinedienste>\n                  <xflb:onlinedienst>\n                     <xflb:id>35f4e0f7-cbc5-49ff-9dab-6f40cd7990ba</xflb:id>\n                     <xflb:bezeichnung>Werteprojekte: Zuwendungsantrag</xflb:bezeichnung>\n                     <xflb:link>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/werteprojekte_bayern/index?caller=bpgi2gcnlcmi4don3ggqzggnrumhe4zxgip7e2eb5bx34ao4zgyixwp2wtfkrg2yatsh5zl4zbnc45kmhdxne7wqfl63dhz2axeaultkirtxx4coa4t7eytnomwmowsc3ik2jq7lhg4yijpr7dba4kjglcaswmtrxjpbpzimzic2tmelszz256cwciuozklypqgrkrrjgkmxtmdz76gvkz33oagbooxyu4spgrl6a8</xflb:link>\n                     <xflb:beschreibung>Hier können Sie das Formular Schritt für Schritt online ausfüllen und anschließend online einreichen. Sie erhalten ein fertig ausgefülltes Dokument als PDF-Dokument für Ihre Unterlagen.</xflb:beschreibung>\n                     <xflb:zahlungsweisen>\n                        <xflb:zahlungsweise listURI=\"urn:de:xzufi:codeliste:zahlungsweise\" listVersionID=\"20210401\">\n                           <code>3010000</code>\n                           <name/>\n                        </xflb:zahlungsweise>\n                     </xflb:zahlungsweisen>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n               </xflb:onlinedienste>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Antragsberechtigt sind alle rechtsfähigen Träger, die über die erforderliche Zuverlässigkeit und Leistungsfähigkeit zur Durchführung des Projektes verfügen und deren bisherige Tätigkeit das Erreichen des Förderzwecks erwarten lässt.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Zuwendung wird als Anteilfinanzierung im Rahmen einer Projektförderung bis&lt;/p&gt;&lt;p&gt;maximal 90 % der zuwendungsfähigen Ausgaben gewährt. Die staatliche Förderung&lt;/p&gt;&lt;p&gt;setzt eine Beteiligung des Zuwendungsempfängers in Höhe von mindestens 10 %&lt;/p&gt;&lt;p&gt;der zuwendungsfähigen Projektausgaben voraus.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Die Förderung erfolgt ohne Rechtsanspruch im Rahmen zur Verfügung stehender&lt;/p&gt;&lt;p&gt;Haushaltsmittel.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Zuwendungsfähig sind Personalausgaben, Sachausgaben, Ausgaben für die Kinderbetreuung sowie Gemeinausgaben im Rahmen des Zuwendungszwecks. Die Höhe der zuwendungsfähigen Personalausgaben bemisst sich&lt;/p&gt;&lt;p&gt;nach den vom Bayerischen Finanzministerium veröffentlichten&lt;/p&gt;&lt;p&gt;Personalausgabenhöchstsätzen.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium des Innern, für Sport und Integration</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderrichtlinie Werteprojekte</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2176_I_15397/true</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Sachgebiet G2 - Integration in Arbeit, Wertevermittlung</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Integrationsprojekte; Beantragung einer Förderung im Bereich der Wertevermittlung</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2027-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2026-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2027-12-31</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:verlaengerungsoption>Vor Ablauf der Förderperiode kann ein Verlängerungsantrag gestellt werden.</xflb:verlaengerungsoption>\n               </xflb:programmlaufzeit>\n               <xflb:kummulierbareFoerderungen>\n                  <xflb:voraussetzungen>&lt;p&gt;Eine Komplementärförderung mit Mitteln der Kommunen, des Bundes oder der Europäischen Union ist möglich&lt;/p&gt;</xflb:voraussetzungen>\n               </xflb:kummulierbareFoerderungen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert wird die projektbezogene Durchführung von Angeboten der Wertevermittlung. Hierunter fallen unter anderem Kurse, Workshops, Austauschtreffen oder Fortbildungen. Die Angebote sollen sowohl die Wissensvermittlung als auch praktische Beteiligungsformen umfassen.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>022</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Neben der Beachtung der bereits oben genannten Voraussetzungen sowie der Hinweise zum Verfahren sind die weiteren Anforderungen im Einzelnen der \"Förderrichtlinie Werteprojekte\" zu entnehmen (siehe unter \"Rechtsgrundlagen\").&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:rechtlicheBeschreibung>&lt;p&gt;Es gelten die allgemeinen Bewilligungsvoraussetzungen der VV Nr. 1 zu Art. 44 BayHO. Insbesondere muss die Gesamtfinanzierung des Projekts gesichert sein (VV Nr. 1.4 zu Art. 44 BayHO). Außerdem darf eine Zuwendung zur Projektförderung nur für Vorhaben bewilligt werden, die noch nicht begonnen worden sind (VV Nr. 1.5.1 zu Art. 44 BayHO).&lt;/p&gt;</xflb:rechtlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Eine Förderung entfällt, wenn für die entstehenden zuwendungsfähigen Ausgaben anderweitige Mittel des Freistaates Bayern in Anspruch genommen werden. Eine Komplementärförderung mit Mitteln der Kommunen, des Bundes oder der Europäischen Union ist möglich.&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/werteprojekte_bayern/index?caller=bpgi2gcnlcmi4don3ggqzggnrumhe4zxgip7e2eb5bx34ao4zgyixwp2wtfkrg2yatsh5zl4zbnc45kmhdxne7wqfl63dhz2axeaultkirtxx4coa4t7eytnomwmowsc3ik2jq7lhg4yijpr7dba4kjglcaswmtrxjpbpzimzic2tmelszz256cwciuozklypqgrkrrjgkmxtmdz76gvkz33oagbooxyu4spgrl6a8</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Der Antrag ist zunächst per E-Mail zusammen mit einem aussagekräftigen Projektkonzept und einem Ausgaben- und Finanzierungsplan beim Bayerischen Staatsministerium des Innern, für Sport und Integration (StMI) (&lt;a href=\"mailto:Sachgebiet-G2@stmi.bayern.de\" dir=\"ltr\"&gt;Sachgebiet-G2@stmi.bayern.de&lt;/a&gt;) einzureichen.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Nach Freigabe des Projektkonzepts durch das StMI ist der Antrag sodann bei der Regierung von Mittelfranken, Sachgebiet 15 - Integration und Förderung, Ausgleichsamt, Marienstr. 21, 90402 Nürnberg (über das BayernPortal oder schriftlich und per E-Mail: &lt;a href=\"mailto:Sachgebiet-15.Integration@reg-mfr.bayern.de\" dir=\"ltr\"&gt;Sachgebiet-15.Integration@reg-mfr.bayern.de&lt;/a&gt;) zu stellen.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Die Regierung von Mittelfranken ist zuständig für die Bewilligung. Bewilligungszeitraum ist grundsätzlich die Zeit vom 1. Januar bis 31. Dezember.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>004</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>&lt;p&gt;Zuwendungen dürfen grundsätzlich nur für solche Vorhaben bewilligt werden, die noch nicht begonnen worden sind.&amp;nbsp;Rein vorbereitende oder planende Maßnahmen wie etwa die Teilnehmerakquise gelten nicht als Vorhabenbeginn.&lt;/p&gt;</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:monate>1</xflb:monate>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>3</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristFest>\n                        <xflb:monate>2</xflb:monate>\n                     </xflb:fristFest>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Die Antragstellung soll in der Regel mindestens zwei Monate vor dem Projektbeginn erfolgen.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Antrag auf Gewährung einer Zuwendung</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Projektkonzept</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Ausgaben- und Finanzierungsplan</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Bitte füllen Sie das zur Verfügung gestellte Formular aus.</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Verwaltungsgerichtliche Klage gegen Bewilligungsbescheid&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_184  [ xyz:attributes  [ xyz:antragsstellung      "https://www.lfp.bayern.de/dokumente/AUA/Foerderantrag%20Sorgenetzwerke.pdf";
                                xyz:begriffeImKontext    [ rdf:_1  "Pflegebedürftige";
                                                           rdf:_2  "Ehrenamt";
                                                           rdf:_3  "Pflege";
                                                           rdf:_4  "Selbsthilfe";
                                                           rdf:_5  "Pflege durch Familie";
                                                           rdf:_6  "Familie";
                                                           rdf:_7  "Sorgenetzwerke"
                                                         ];
                                xyz:beschreibung         "<p>In Deutschland wird die überwiegende Zahl von Pflegebedürftigen zu Hause von Angehörigen und nahestehenden Personen gepflegt. Hierbei gelangen häuslich Pflegende oft an die Grenze ihrer physischen und psychischen Belastbarkeit, weshalb der Freistaat Bayern Angebote zur Unterstützung im Alltag fördert, um einer Überforderung entgegenzuwirken. Um unterstützende Angebote weiter auszubauen und neue innovative Konzepte zu entwickeln, fördert Bayern auch den Auf- und Ausbau ehrenamtlicher Strukturen und der Selbsthilfe in der Pflege.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Gesundheit und Soziales" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Stiftungen";
                                                           rdf:_2  "Verbände";
                                                           rdf:_3  "Vereine";
                                                           rdf:_4  "Kommunen"
                                                         ];
                                xyz:foerderprogramm      "Ehrenamt, bürgerschaftliches Engagement und Selbsthilfe; Beantragung einer Förderung";
                                xyz:foerderzeitraum.bis  "2026-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2025-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "f46e90a0-d838-43fe-83d6-c34baab1d10d";
                                xyz:teaser               "Ehrenamtliche Strukturen, die sich die Unterstützung, Betreuung und Entlastung von Pflegebedürftigen sowie deren An- und Zugehörigen zum Ziel gesetzt haben, können eine Zuwendung im Rahmen einer Projektförderung erhalten.";
                                xyz:titel                "Förderung von Ehrenamt, bürgerschaftliches Engagement und Selbsthilfe in der Pflege";
                                xyz:titel.tokens         [ rdf:_1  "Förderung von Ehrenamt";
                                                           rdf:_2  "bürgerschaftliches Engagement und Selbsthilfe in der Pflege"
                                                         ];
                                xyz:voraussetzung        "<p>Die einzelnen Voraussetzungen für die Anerkennung und Förderung solcher Angebote sind in Teil 8 Abschnitt 6 und 8 der AVSG und den Hinweisen zum Vollzug der AVSG Teil 8 Abschnitt 5 bis 8 geregelt. Abhängig von der Art des Angebots ist die Erfüllung jeweiliger Qualifizierungs- und Qualitätskriterien nachzuweisen.</p>"
                              ];
              xyz:id          "f46e90a0-d838-43fe-83d6-c34baab1d10d";
