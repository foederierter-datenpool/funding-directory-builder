                                xyz:foerderprogramm      "Sportförderung";
                                xyz:foerderzeitraum.bis  "2028-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2023-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "f1ccbb7c-df59-4117-be23-30d5d51d5e96";
                                xyz:teaser               "Der Freistaat Bayern fördert den Neubau, die Erweiterung oder Sanierung von leistungssportlichen Trainingseinrichtungen.";
                                xyz:titel                "Leistungssport; Beantragung einer Förderung für eine leistungssportliche Trainingseinrichtung";
                                xyz:titel.tokens         [ rdf:_1  "Leistungssport";
                                                           rdf:_2  "Beantragung einer Förderung für eine leistungssportliche Trainingseinrichtung"
                                                         ];
                                xyz:voraussetzung        "<p>Die Zuwendungen setzen voraus, dass die Einrichtung den Nachwuchskaderathleten des jeweiligen bayerischen Verbandes sowie sonstigen vom Staatsministerium ermächtigten Nutzungsberechtigten in leistungssportgerechtem Zustand unentgeltlich zur Verfügung steht, bei investiven Maßnahmen mindestens bis zur Höhe eines dem jeweiligen Finanzierungsanteil des Freistaates Bayern entsprechenden Anteils der Nutzungszeiten. Sonstige Einrichtungen und Geräte der Gesamtanlage sind, soweit dies im Zusammenhang mit der Nutzung im Landesinteresse erforderlich ist, ebenfalls unentgeltlich zur Verfügung zu stellen. Sofern Träger und zuständiger bayerischer Verband nicht identisch sind, ist eine Nutzungsvereinbarung abzuschließen.</p>"
                              ];
              xyz:id          "f1ccbb7c-df59-4117-be23-30d5d51d5e96";
              xyz:payload     [ xyz:json  [ xyz:anfrage            [ xyz:anfragenummer  "f1ccbb7c-df59-4117-be23-30d5d51d5e96";
