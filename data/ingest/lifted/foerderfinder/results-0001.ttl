                                                                                                                     ];
                                                                                                             xyz:foerdervoraussetzungen  [ xyz:buergerfreundlicheBeschreibung
                                                                                                                               "<p>Voraussetzung für die Förderung eines Pflegestützpunkts ist, dass&nbsp;</p><ul><li class=\"unordered-list-item--dash\">eine von der Kommune (anteilig) finanzierte Fachkraft mit mindestens 50 v. H. der tarifvertraglichen Arbeitszeit einer Vollzeitkraft des Trägers im Pflegestützpunkt tätig ist und</li><li class=\"unordered-list-item--dash\">eine Zusammenarbeit vor allem mit den Trägern in der Betreuung, Unterstützung und Pflege von Menschen mit Pflegebedarf sowie den Beratungsstellen (insbesondere den Fachstellen für pflegende Angehörige) sowie mit den in Betracht kommenden Behörden und Stellen in der jeweiligen Region erfolgt.</li></ul>" ];
