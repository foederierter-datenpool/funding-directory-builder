                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>bc01cf40-9371-49ef-9e0b-0201abdd32a8</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-07-31T15:40:13</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>bc01cf40-9371-49ef-9e0b-0201abdd32a8</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>bc01cf40-9371-49ef-9e0b-0201abdd32a8</xflb:schluessel>\n         <xflb:versionFLB>4</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-11-21T10:26:02</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>bc01cf40-9371-49ef-9e0b-0201abdd32a8</xflb:foerderschluessel>\n                  <xflb:flbVersion>4</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99148293017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Mietwohnung; Beantragung einer Zusatzförderung</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Die Förderung soll den Bewohnern von im Rahmen der Einkommensorientierten Förderung (EOF) gefördertem Wohnraum für die Dauer der Belegungsbindung ermöglichen die laufenden Mietbelastungen mit dem jeweils zur Verfügung stehenden Einkommen zu tragen.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Um eine zumutbare Miete zu gewährleisten, erhalten berechtigte Mieter laufende Zuschüsse (Zusatzförderung).</xflb:teaser>\n                  <xflb:schluesselwoerter>Mietzuschuss, Zusatzförderung, EOF</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Bayerisches Staatsministerium für Wohnen, Bau und Verkehr(StMB) - Förderung von Mietwohnungen</xflb:bezeichnung>\n                     <xflb:link>https://www.stmb.bayern.de/wohnen/foerderung/mietwohnungen/index.php</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Ihre zuständige Kreisverwaltungsbehörde</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>1f615313-86f5-4c65-b697-a8870ef08cf6</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Mietwohnraum - Zusatzförderung - Formblatt Stabau I c</xflb:bezeichnung>\n                     <xflb:link>https://www.stmb.bayern.de/wohnen/foerderung/mietwohnungen/index.php</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>b8c6352e-6ea6-4d46-b486-79f3788ae4b5</xflb:id>\n                     <xflb:bezeichnung>Einkommenserklärung des Antragstellers - Stabau III a</xflb:bezeichnung>\n                     <xflb:link>https://www.stmb.bayern.de/assets/stmi/wohnen/foerderung/antrag_stabau_iiia.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>3a922a3c-d725-4015-83fb-3aea76971a25</xflb:id>\n                     <xflb:bezeichnung>Einkommenserklärung für weitere Haushaltsangehörige - Stabau III b</xflb:bezeichnung>\n                     <xflb:link>https://www.stmb.bayern.de/assets/stmi/wohnen/wohnberechtigungundrecht/antrag_stabau_iiib_mai_2018.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>9a16974c-9257-465e-8b9a-e73c1d727120</xflb:id>\n                     <xflb:bezeichnung>Erläuterungen zur Einkommenserklärung des Antragstellers und weiterer Haushaltsangehörigen</xflb:bezeichnung>\n                     <xflb:link>https://www.stmb.bayern.de/assets/stmi/wohnen/erlaeuterungen_stabau_iiia_iiib.pdf</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Zuwendungsempfänger sind Mieter.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Zusatzförderung erfolgt als Zuschuss ohne Rechtsanspruch und im Rahmen der verfügbaren Haushaltsmittel. Grundlage für die Bemessung der Zusatzförderung ist der Unterschiedsbetrag zwischen der höchstzulässigen Miete und der zumutbaren Miete. Dieser Betrag bleibt für die Bindungsdauer unverändert. Bei der Berechnung der monatlichen Zusatzförderung ist die von der Bewilligungsstelle festgestellte Wohnfläche zugrunde zu legen.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Es werden die Mietkosten gefördert.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Wohnen, Bau und Verkehr</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Wohnraumförderungsbestimmungen 2023 (WFB 2023)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2330_B_13734/true</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Verordnung zur Durchführung des Wohnungsrechts und des Besonderen Städtebaurechts (Durchführungsverordnung Wohnungsrecht - DVWoR)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayDVWoR/true</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat 31</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Mietwohnraum - Zusatzförderung</xflb:programmtitel>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2023-04-13</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2028-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Die Zusatzförderung stellt sicher, dass die Bewohner von im Rahmen der Einkommensorientierten Förderung (EOF) gefördertem Wohnraum während der Dauer der Belegungsbindung in der Lage sind, mit dem ihnen jeweils zur Verfügung stehenden Einkommen die laufende Mietbelastung zu tragen.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>021</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Der Antragssteller muss eine Wohnung bewohnen, die in der Einkommensorientierten Förderung (EOF) gefördert wurde und einer Sozialbindung unterliegt.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Die Zusatzförderung richtet sich nach dem Gesamteinkommen des jeweiligen Haushalts (vergleiche Art. 5 BayWoFG) und dessen Zuordnung in Einkommensstufen.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.stmb.bayern.de/wohnen/foerderung/mietwohnungen/index.php</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Schriftliche Antragsstellung&amp;nbsp;&lt;/p&gt;&lt;p&gt;Der Förderantrag ist unter Verwendung der jeweils aktuell gültigen Antragsformulare (Einkommenserklärung im Original - Formblatt Stabau III a - mit einem Antrag auf die Zusatzförderung - Formblatt Stabau I c - und dort bezeichneten Unterlagen) bei der zuständigen Kreisverwaltungsbehörde einzureichen.&lt;/p&gt;&lt;p&gt;Elektronische Antragsstellung&amp;nbsp;&lt;/p&gt;&lt;p&gt;Wenn die zuständige ein Online-Verfahren bereitstellt, können Sie darüber den Antrag übermitteln.&lt;/p&gt;</xflb:bewilligung>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Stabau I c</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Stabau III a</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Stabau III b</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;verwaltungsgerichtliche Klage&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_101  [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/formloseSchreibenmitUnterschrift/index";
