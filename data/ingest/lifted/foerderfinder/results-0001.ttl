                                                                                                             xyz:antragsinformationen    [ xyz:antragsfrist             [ xyz:bemerkung             "Anträge auf Grundförderung Bildungsarbeit BNE/UB sind bis zum 1. Oktober eines Jahres für das Folgejahr einzureichen. Der Ausgaben- und Finanzierungsplan, eine erforderliche Präzisierung des Arbeitsprogramms sowie weitere erläuternde Unterlagen können bis spätestens zum 1. Februar des Bewilligungszeitraums eingereicht werden.";
                                                                                                                                                                          xyz:zeitlicheEingrenzung  [ xyz:fristJaehrlich
                                                                                                                                                                                            "01.10." ]
                                                                                                                                                                        ];
                                                                                                                                           xyz:beantragungskosten       [ xyz:kostenlos
                                                                                                                                                             "ja" ];
                                                                                                                                           xyz:bearbeitungsdauer        [ xyz:bewilligung  [ xyz:dauerFest  [ xyz:monate  "3" ]
                                                                                                                                                                                           ]
                                                                                                                                                                        ];
                                                                                                                                           xyz:erforderlicheUnterlagen  [ xyz:dokument  [ rdf:_1  [ xyz:bezeichnung   "Arbeitsprogramm";
                                                                                                                                                                                                    xyz:erlaeuterung  "aussagekräftige Darstellung der im Bewilligungszeitraum geplanten Bildungsaktivitäten BNE/UB."
                                                                                                                                                                                                  ];
                                                                                                                                                                                          rdf:_2  [ xyz:bezeichnung  "Ausgaben- und Finanzierungsplan" ];
                                                                                                                                                                                          rdf:_3  [ xyz:bezeichnung  "ggf. weitere erläuternde Unterlagen" ]
                                                                                                                                                                                        ]
                                                                                                                                                                        ];
                                                                                                                                           xyz:linkZurAntragsstellung   "https://www.bne-lernen.bayern.de/foerderung/foerderung_umweltstationen/doc/umwst_antrag.docx";
                                                                                                                                           xyz:rechtsbehelf             "<p>Gegen den Zuwendungsbescheid können Sie innerhalb eines Monats Klage erheben. Das zuständige Gericht, bei dem Sie Klage einreichen können, wird Ihnen im Bescheid mitgeteilt.</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<p>Der Antrag auf Grundförderung Bildungsarbeit BNE/UB muss zusammen mit den erforderlichen Unterlagen über das bereitgestellte Antragsformblatt schriftlich oder elektronisch bei der zuständigen Regierung eingereicht werden.</p>";
                                                                                                                                                                          xyz:erlaeuterungVorzeitigerMassnahmebeginn
                                                                                                                                                                                  "<p>Vorhaben, mit deren Ausführung vor der Bewilligung oder vor Einwilligung in den vorzeitigen Vorhabenbeginn begonnen wurde und die keine Anschlussbewilligungen sind, werden nicht gefördert. Die Bewilligungsbehörde kann auf Antrag schriftlich oder elektronisch die Einwilligung in den vorzeitigen Vorhabenbeginn erteilen, wenn die Voraussetzungen der VV Nr. 1.3.3 zu Art. 44 BayHO vorliegen. Die Beachtung der ANBest-P oder der ANBest-K, namentlich der Vergabevorschriften, ist Voraussetzung für den Erlass eines Zuwendungsbescheids. Aus der Einwilligung in den vorzeitigen Vorhabenbeginn kann kein Anspruch auf Förderung abgeleitet werden; der Vorhabenträger trägt das volle Finanzierungsrisiko. Einer Einwilligung zum vorzeitigen Vorhabenbeginn bedarf es nicht, wenn es sich um ein wiederholendes gleichartiges Vorhaben desselben Trägers handelt und die Voraussetzungen der VV Nr. 1.3 zu Art. 44 BayHO erfüllt sind (Anschlussbewilligung). Dies ist regelmäßig der Fall, wenn der Antrag zu dem in Nr. 6 genannten Termin bei der Bewilligungsbehörde vorliegt und eine Grundförderung in gleicher Höhe auch für das vorhergehende Förderjahr bereits beantragt und bewilligt wurde.</p>";
                                                                                                                                                                          xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "003";
                                                                                                                                                                                                            xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
                                                                                                                                                                                                            xyz:listVersionID  "1"
                                                                                                                                                                                                          ]
                                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:finanzierungsartUndHoehe  "<p>Die Höhe der Zuwendung beträgt 30.000 Euro pro Umweltstation. Vorausgesetzt wird dabei, dass die Gesamtsumme der für die Bildungsarbeit BNE/UB der Umweltstation im Bewilligungszeitraum getätigten zuwendungsfähigen Ausgaben nach Abzug der mit der Bildungsarbeit BNE/UB im Zusammenhang stehenden Einnahmen den Betrag von 30.000 Euro erreicht oder überschreitet.</p>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "001";
                                                                                                                                                                                                    xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
                                                                                                                                                                                                    xyz:listVersionID  "1";
                                                                                                                                                                                                    xyz:name           ""
                                                                                                                                                                                                  ]
                                                                                                                                                                         ];
