                                                                                                                                                                                                     ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1";
                                                                                                                                                                           xyz:name           ""
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<ul>\n  <li class=\"unordered-list-item--dash\">Förderfähig sind die Bauausgaben für den Straßenkörper und das Zubehör von in Nr. 2.1 RZStra genannten Verkehrswege und -anlagen.</li>\n  <li class=\"unordered-list-item--dash\">Nähere Einzelheiten können Nr. 6 der Richtlinien für Zuwendungen des Freistaates Bayern zu Straßen- und Brückenbauvorhaben kommunaler Baulastträger (RZStra) entnommen werden.</li>\n</ul>"
                                                                                                                                         ];
                                                                                                             xyz:foerderbereich          [ xyz:foerderbereich  [ xyz:code           "012";
                                                                                                                                                                 xyz:listURI        "urn:xoev-de:stmd:codeliste:foerderbereich";
