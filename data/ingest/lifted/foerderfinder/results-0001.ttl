                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Zuwendungsfähig sind Ausgaben, die zur Durchführung des zu fördernden Vorhabens erforderlich sind.</p>"
                                                                                                                                         ];
                                                                                                             xyz:foerderbereich          [ xyz:foerderbereich  [ xyz:code           "011";
