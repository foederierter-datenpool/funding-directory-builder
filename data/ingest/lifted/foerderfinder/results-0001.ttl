                                                           rdf:_7  "Härtefallförderung"
                                                         ];
                                xyz:beschreibung         "In Härtefällen werden Vorhaben zur Sanierung bestehender Anlagen der öffentlichen Wasserversorgung und Abwasserentsorgung gefördert, wenn diese zu unzumutbaren Belastungen von Gebietskörperschaften sowie Bürgerinnen und\nBürgern führen.";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Umwelt- und Naturschutz" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Kommunen";
                                                           rdf:_2  "Verbände"
                                                         ];
                                xyz:foerderprogramm      "Richtlinien für Zuwendungen zu wasserwirtschaftlichen Vorhaben (RZWas 2025)";
                                xyz:foerderzeitraum.bis  "2028-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2024-04-01T00:00:00.000+00:00";
                                xyz:schluessel           "fbcdde84-d1fd-4a52-8e1e-4db788484541";
                                xyz:teaser               "Der Freistaat Bayern unterstützt die bayerischen Städte und Gemeinden bei der Sanierung von öffentlichen Trinkwasser- und Abwasseranlagen in Härtefällen mit Zuwendungen.";
                                xyz:titel                "Sanierung von Bauwerken bestehender Trinkwassergewinnungs- und -aufbereitungsanlagen, Trinkwasserspeicher, Kläranlagen, Pumpwerke und Regenbecken";
                                xyz:titel.tokens         [ rdf:_1  "Sanierung von Bauwerken bestehender Trinkwassergewinnungs- und -aufbereitungsanlagen";
                                                           rdf:_2  "Trinkwasserspeicher";
                                                           rdf:_3  "Kläranlagen";
                                                           rdf:_4  "Pumpwerke und Regenbecken"
                                                         ];
                                xyz:voraussetzung        "<p>Für Vorhaben nach Nrn. 2.2.3 wird die Förderung gewährt, wenn die nach Anlage 2 mit Stichtag im aktuellen Kalenderjahr ermittelte Pro-Kopf-Belastung eine der Härtefallschwellen nach Nr. 4.3 RZWas 2025 überschreitet. Es können nur Vorhaben gefördert werden, die noch nicht begonnen worden sind. Weitere Details erfahren Sie bei Ihrem örtlich zuständigen Wasserwirtschaftsamt.</p>"
                              ];
