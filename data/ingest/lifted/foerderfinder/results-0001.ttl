                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>4ecca1a2-bcda-4c04-8e4a-02d64fdd230a</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-08-27T16:15:40</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>4ecca1a2-bcda-4c04-8e4a-02d64fdd230a</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>4ecca1a2-bcda-4c04-8e4a-02d64fdd230a</xflb:schluessel>\n         <xflb:versionFLB>5</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-08-27T16:15:40</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>4ecca1a2-bcda-4c04-8e4a-02d64fdd230a</xflb:foerderschluessel>\n                  <xflb:flbVersion>5</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400254017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Wohnungslosenhilfe Bayern; Beantragung einer Förderung für ein Modellprojekt</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Der Freistaat Bayern fördert die Anschubfinanzierung von Modellprojekten zur Beratung und Betreuung wohnungsloser sowie von Wohnungslosigkeit bedrohter Personen, insbesondere im Hinblick auf die Information über und den Zugang zu den Angeboten des regulären Hilfesystems.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern gewährt Zuwendungen für Modellprojekte in Bayern, die sich mit der Betreuung und Beratung von wohnungslosen oder von Wohnungslosigkeit bedrohten Personen befassen.</xflb:teaser>\n                  <xflb:schluesselwoerter>Wohnungslosenhilfe, Obdachlosigkeit</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Wohnungslosenhilfe Bayern</xflb:bezeichnung>\n                     <xflb:link>https://www.stmas.bayern.de/wohnungslosenhilfe/index.php</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Koordination Wohnungslosenhilfe Nord- und Südbayern</xflb:bezeichnung>\n                     <xflb:link>https://wohnungslosenhilfe-bayern.de/?ueberunstax=uebersicht</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Staatsministerium für Familie, Arbeit und Soziales Referat II 1 Teilhabe; Belange der Wohnungslosen- und Obdachlosenhilfe</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>9</xflb:hausnummerPostfach>\n                     <xflb:strasse>Winzererstr.</xflb:strasse>\n                     <xflb:postleitzahl>80797</xflb:postleitzahl>\n                     <xflb:ort>München</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>referat-II5@stmas.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Link zur Wohnungslosenhilfe Bayern</xflb:bezeichnung>\n                     <xflb:link>https://www.stmas.bayern.de/wohnungslosenhilfe/index.php</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>089-1261-1094</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Regierung von Mittelfranken</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>27</xflb:hausnummerPostfach>\n                           <xflb:strasse>Promenade</xflb:strasse>\n                           <xflb:postleitzahl>91522</xflb:postleitzahl>\n                           <xflb:ort>Ansbach</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>poststelle@reg-mfr.bayern.de</xflb:email>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Link zur Regierung von Mittelfranken</xflb:bezeichnung>\n                           <xflb:link>https://www.regierung.mittelfranken.bayern.de/meta/kontakt/index.php</xflb:link>\n                        </xflb:verweis>\n                        <xflb:telefonnummer>49 (0)981 53-0</xflb:telefonnummer>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Antrags- und zuwendungsberechtigt sind die Träger der öffentlichen und freien Wohlfahrtspflege im Freistaat Bayern.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Zuwendung wird als Projektförderung im Wege einer Anteilsfinanzierung als Zuschuss gewährt. Sie umfasst grundsätzlich die Personalkosten für eine Fachkraftstelle sowie eine Sachkostenpauschale in Höhe von 20 % der Personalkosten.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Ab dem 01.03.2021 werden die zuwendungsfähigen Personalkosten nach den Verwaltungsvorschriften (VV) Nr. 2.5. Satz 3 zu Art 44 Bayerische Haushaltsordnung (BayHO) berechnet.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Die Förderung von höheren Sachkosten kann nach den §§ 3 und 4 der Durchführungsverordnung zum Bayerischen Schwangerschaftsberatungsgesetz erfolgen sowie mit Zustimmung im Einzelfall durch das Bayerische Staatsministerium für Familie, Arbeit und Soziales.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Gefördert werden können Ausgaben für Personal- und Sachkosten für Modellprojekte in Bayern die sich mit der Betreuung und Beratung von Wohnungslosen oder von Wohnungslosigkeit bedrohter Personen befassen.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerFest>\n                        <xflb:monate>12</xflb:monate>\n                     </xflb:dauerFest>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Familie, Arbeit und Soziales</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 23 und 44 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO-G1</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat II 1 Teilhabe; Belange der Wohnungslosen- und Obdachlosenhilfe</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>\"Aktionsplan Hilfe bei Obdachlosigkeit\" (Förderung von Maßnahmen für Personen mit besonderen sozialen Schwierigkeiten)</xflb:programmtitel>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2019-05-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2029-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert werden Modellprojekte zur&amp;nbsp;Betreuung und Beratung von Wohnungslosen und von Wohnungslosigkeit bedrohten Personen in Bayern.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Gefördert werden die oben genannten Maßnahmen unter Maßgabe der Bayerischen Haushaltsordnung, wenn eine positive Stellungnahme zum Modellprojekt von der zuständigen Koordinierungsstelle Wohnungslosenhilfe vorliegt.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.stmas.bayern.de/wohnungslosenhilfe/index.php</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Die Förderanträge für Modellprojekte sind über die jeweils zuständige Koordinierungsstelle Wohnungslosenhilfe Nord- oder Südbayern beim Bayerischen Staatsministerium für Familie, Arbeit und Soziales einzureichen. Die Förderabwicklung erfolgt durch die Regierung von Mittelfranken, welche bayernweit für diese Förderung zuständig ist. Die Formvorgaben zum Antrag werden über die Koordinatoren an den jeweiligen Träger übermittelt.&lt;/p&gt;\n&lt;p&gt;Wenden Sie sich mit ihrem Vorschlag/Konzept und Kostenaufstellung für ein Modellprojekt zur Betreuung und Beratung von wohnungs- und obdachlosen und / oder von Wohnungslosigkeit bedrohten Personen an die zuständige Koordination Wohnungslosenhilfe Nord- oder Südbayern.&lt;/p&gt;\n&lt;p&gt;Die Koordination wird Ihren Projektvorschlag prüfen. Von dort erhalten Sie dann auch das Formblatt für den Antrag. Im Anschluss wird die Koordination Ihren Projektantrag (Formblatt und Konzept) zusammen mit einer fachlichen Stellungnahme dem Staatsministerium für Familie, Arbeit und Soziales sowie der Regierung von Mittelfranken übermitteln. Dort wird ihr Antrag geprüft und verbeschieden.&amp;nbsp;&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>004</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>&lt;p&gt;Sollte der Projektbeginn in zeitlicher Nähe zur Antragstellung liegen, ist ggf. ein ergänzender Antrag auf vorzeitigen Maßnahmenbeginn zu stellen, um hierüber den gewünschten Start des Projekts nicht zu gefährden.&lt;/p&gt;</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:monate>1</xflb:monate>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>2</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>fachliche Konzeption des Modellprojekts</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>Unmittelbare Klageerhebung ohne Widerspruchsverfahren \n(Art. 15 Abs. 2 AGVwGO)</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_119  [ xyz:attributes  [ xyz:antragsstellung      "https://www.stmgp.bayern.de/service/foerderprogramme/";
