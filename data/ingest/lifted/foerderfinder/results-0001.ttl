                                                                                                                                           xyz:linkZurAntragsstellung  "https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/rmf-zz/13/rmf_13-027-zz/index";
                                                                                                                                           xyz:rechtsbehelf            "<p>Einreichung einer Klage zum Verwaltungsgericht oder fakultatives Widerspruchsverfahren.&nbsp;</p>";
                                                                                                                                           xyz:verfahrensablauf        [ xyz:bewilligung
                                                                                                                                                             "Die vollständigen Förderanträge müssen spätestens einen Monat vor Beginn des\nBewilligungszeitraums unter Verwendung des hierfür zur Verfügung gestellten\nAntragsformulars bei der Regierung von Mittelfranken gestellt werden. Bei der\nAntragstellung ist von einem realistisch eingeschätzten Bedarf unter\nBerücksichtigung der Inanspruchnahme der Dolmetscherdienste in den Vorjahren\nauszugehen.  \n\nAls Projektbeginn (Beginn des Bewilligungszeitraums) kann der 01.01., der\n01.04. oder der 01.07. des jeweiligen Haushaltsjahres beantragt werden. Der\nBewilligungszeitraum endet am 31.12. des jeweiligen Haushaltsjahres. Eine\nrückwirkende Förderung erfolgt nicht." ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:finanzierungsartUndHoehe  "<p>Die staatliche Zuwendung wird im Rahmen einer Projektförderung als Anteilfinanzierung mit Höchstgrenze gewährt.</p>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "001";
                                                                                                                                                                                                    xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
