                                                           rdf:_4  "Wohnheime für Studierende";
                                                           rdf:_5  "Studierende";
                                                           rdf:_6  "Wohnraumförderung";
                                                           rdf:_7  "Studenten"
                                                         ];
                                xyz:beschreibung         "<p>Zweck der Zuwendung ist die Schaffung und die Erhaltung von Wohnraum für Studierende an staatlichen und staatlich anerkannten Hochschulen.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Kredit/Darlehen" ];
                                xyz:foerderbereich       [ rdf:_1  "Wohnungsbau und Modernisierung" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1   "Privatpersonen";
                                                           rdf:_10  "Forschungseinrichtungen";
                                                           rdf:_11  "Behörden";
                                                           rdf:_12  "Freiberufler";
                                                           rdf:_2   "Kleine und mittlere Unternehmen";
                                                           rdf:_3   "Einzelunternehmen";
                                                           rdf:_4   "Unternehmen mit ausländischem Mehrheitsbesitz";
                                                           rdf:_5   "Großunternehmen";
                                                           rdf:_6   "Verbände";
                                                           rdf:_7   "Stiftungen";
                                                           rdf:_8   "Kommunen";
                                                           rdf:_9   "Vereine"
                                                         ];
                                xyz:foerderprogramm      "Förderung von Wohnraum für Studierende (StudR 2023)";
                                xyz:foerderzeitraum.bis  "2026-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2023-08-04T00:00:00.000+00:00";
                                xyz:schluessel           "e5075cba-73b5-4883-9a16-7b3b22463508";
                                xyz:teaser               "Der Staat fördert die Schaffung und Erhaltung von Wohnraum für Studierende mit Mitteln aus öffentlichen Haushalten.";
                                xyz:titel                "Förderung von Wohnraum für Studierende";
                                xyz:titel.tokens         [ rdf:_1  "Förderung von Wohnraum für Studierende" ];
                                xyz:voraussetzung        "<p>Voraussetzung für eine Förderung ist ein dringender, nicht nur vorübergehender Bedarf an staatlich gefördertem Wohnraum für Studierende am jeweiligen Hochschulort. Wohnraum für Studierende wird nur auf Grundstücken gefördert, die verkehrsgünstig zu Hochschule liegen.&nbsp;</p><p>Belegungsbindung</p><p>Die geförderten Wohnheimplätze dürfen während der Dauer der Belegungsbindung von 25 oder 40 Jahren nur mit bedürftigen Studierenden belegt werden. Ausländische Studierende müssen angemessen berücksichtigt werden. Bis zu 20 Prozent der Wohnplätze dürfen mit Auszubildnenden belegt werden.&nbsp;</p><p><br></p>"
                              ];
              xyz:id          "e5075cba-73b5-4883-9a16-7b3b22463508";
              xyz:payload     [ xyz:json  [ xyz:anfrage            [ xyz:anfragenummer  "e5075cba-73b5-4883-9a16-7b3b22463508";
