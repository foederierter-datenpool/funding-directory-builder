                                          ];
                                xyz:xml   "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           produkt=\"Förderfinder\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produktversion=\"\"\n                                           standard=\"XFLB\"\n                                           test=\"\"\n                                           version=\"2.0.0\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0 xflb.xsd\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>482b1f7a-5af7-4edf-a0c3-411a0ded1b9e</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-08-16T12:00:30</xflb:erstellungszeitpunkt>\n      <xflb:sender>Förderfinder Suche (Bayern)</xflb:sender>\n      <xflb:empfaenger>XFLB-Connect (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>482b1f7a-5af7-4edf-a0c3-411a0ded1b9e</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>482b1f7a-5af7-4edf-a0c3-411a0ded1b9e</xflb:schluessel>\n         <xflb:versionFLB>5</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesFachreferat>13</xflb:verantwortlichesFachreferat>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Gesundheit, Pflege und Prävention</xflb:verantwortlichesMinisterium>\n               <xflb:ablaufdatumRichtlinie>2027-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmtitel>Bayerische Förderrichtlinie für digitale, innovative Gesundheits- und Pflegeprojekte (Gesundheits- und Pflegedigitalisierungsrichtlinie - BayDiGuP</xflb:programmtitel>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2126_0_G_14560</xflb:link>\n                     <xflb:bezeichnung>Bayerische Förderrichtlinie für digitale, innovative Gesundheits- und Pflegeprojekte (Gesundheits- und Pflegedigitalisierungsrichtlinie - BayDiGuP</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO/true</xflb:link>\n                     <xflb:bezeichnung>Bayerische Haushaltsordnung (BayHO)</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN23</xflb:link>\n                     <xflb:bezeichnung>VV zu Art. 23 BayHO</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN44</xflb:link>\n                     <xflb:bezeichnung>VV zu Art. 44 BayHO</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN121</xflb:link>\n                     <xflb:bezeichnung>Allgemeine Nebenbestimmungen für Zuwendungen zur Projektförderung (ANBest-P)</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN122</xflb:link>\n                     <xflb:bezeichnung>Allgemeine Nebenbestimmungen für Zuwendungen zur Projektförderung an kommunale Körperschaften (ANBest-K)</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2024-07-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2027-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n               <xflb:kummulierbareFoerderungen>\n                  <xflb:voraussetzungen>&lt;p&gt;Eine Komplementärförderung mit Mitteln der Kommunen, des Bundes oder der Europäischen Union ist möglich.&lt;/p&gt;\n&lt;p&gt;Bei der Bewilligung ist darauf zu achten, dass sich der Zuwendungsempfänger mit einem angemessenen Eigenanteil in Höhe von mindestens 10 % der zuwendungsfähigen Ausgaben an der Finanzierung beteiligt.&lt;/p&gt;</xflb:voraussetzungen>\n                  <xflb:beschreibungAusschluss>Eine Förderung entfällt, wenn für den gleichen Zuwendungszweck andere Mittel des Freistaates Bayern in Anspruch genommen werden.</xflb:beschreibungAusschluss>\n               </xflb:kummulierbareFoerderungen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name>Bayern</name>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Förderung für Pilotprojekte für innovative Lösungen mit Bezug zur Digitalisierung in Gesundheit und Prävention</xflb:titel>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Landesamt für Gesundheit und Lebensmittelsicherheit</xflb:name>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Für Projektinhalte der Pflege ist das Landesamt für Pflege zuständig; bei übrigen Themen das Landesamt für Gesundheit und Lebensmittelsicherheit. Ggf. kann insbesondere bei Förderaufrufen auch eine dritte Stelle zuständig sein; dies wird in den spezifischen Förderaufrufen bekannt gegeben.</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:beschreibung>\n                  <xflb:teaser>Durch die Förderlinie 3 der Gesundheits- und Pflegedigitalisierungsrichtlinie (BayDiGuP) werden durch den Freistaat Bayern Pilotprojekte für innovative Lösungen mit Bezug zur Digitalisierung in Gesundheit, Pflege und Prävention gefördert.</xflb:teaser>\n                  <xflb:schluesselwoerter>\"Digitalisierung\", \"Telematikinfrastruktur\", \"Open Access\", \"Robotik\", \"Künstliche Intelligenz\", \"KI\" \"Automatisierung\", \"Pflege\", \"Gesundheit\", \"Prävention\"</xflb:schluesselwoerter>\n                  <xflb:zuwendungszweck>&lt;p&gt;Der Zweck der Förderung nach dieser Förderlinie ist es, innovative Lösungen mit einem weiteren Bezug zur Digitalisierung oder auch anderen, damit zusammenhängenden, technologischen Entwicklungen wie Automatisierung oder Robotik im Bereich der Gesundheit, Pflege und Prävention zu unterstützen. Diese Lösungen bieten Vorschläge für zukunftsträchtige Erneuerungen, stellen aber auch Beiträge und Antworten für notwendige Transformationen und Strukturwandel in Folge der demografischen Entwicklung dar. Durch die Vorhaben soll das System von Gesundheit, Pflege und Prävention perspektivisch entlastet, modernisiert und zukunftssicher gemacht werden können, um insbesondere auch Versorgungsstrukturen zu verbessern.&lt;/p&gt;</xflb:zuwendungszweck>\n               </xflb:beschreibung>\n               <xflb:alternativeFoerdermoeglichkeiten>\n                  <xflb:alternativeFoerdermoeglichkeit>\n                     <xflb:beschreibung>Bei reinen Entwicklungsvorhaben ist eine Förderung aus dem StMWi denkbar; bei der BayDiGuP braucht es einen Versorgungsaspekt</xflb:beschreibung>\n                     <xflb:verweis>\n                        <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_7071_W_10442/true</xflb:link>\n                        <xflb:bezeichnung>Bayerisches Verbundforschungsprogramm (BayVFP)</xflb:bezeichnung>\n                     </xflb:verweis>\n                  </xflb:alternativeFoerdermoeglichkeit>\n                  <xflb:alternativeFoerdermoeglichkeit>\n                     <xflb:beschreibung>Richtlinie zur Förderung neuer ambulant betreuter Wohngemeinschaften sowie zur  Förderung von Vorhaben zur Verbesserung der Lebensqualität und der  Rahmenbedingungen in der Pflege</xflb:beschreibung>\n                     <xflb:verweis>\n                        <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2175_4_G_13718</xflb:link>\n                        <xflb:bezeichnung>Richtlinie zur Förderung neuer ambulant betreuter Wohngemeinschaften sowie zur Förderung von Vorhaben zur Verbesserung der Lebensqualität und der Rahmenbedingungen in der Pflege</xflb:bezeichnung>\n                     </xflb:verweis>\n                  </xflb:alternativeFoerdermoeglichkeit>\n               </xflb:alternativeFoerdermoeglichkeiten>\n            </xflb:allgemeineAngaben>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>482b1f7a-5af7-4edf-a0c3-411a0ded1b9e</xflb:foerderschluessel>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n                  <xflb:flbVersion>5</xflb:flbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"1\">\n                        <code>4a</code>\n                        <name>Regelungskompetenz auf Landesebene - Vollzug auf Landesebene</name>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:finanzierung>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Zuwendung wird als Projektförderung im Wege der Anteilfinanzierung gewährt.&lt;/p&gt;\n&lt;p&gt;Maximal können je nach Eigeninteresse und Leistungskraft des Zuwendungsempfängers 90 Prozent der zuwendungsfähigen Ausgaben gefördert werden.&lt;/p&gt;\n&lt;p&gt;Es ist bei der Finanzierung ein Eigenanteil mindestens in Höhe von 10 % aller zuwendungsfähigen Ausgaben in Form von baren Mitteln (Eigenmittel) zur Finanzierung einzubringen.&amp;nbsp;&lt;/p&gt;\n&lt;p&gt;Die konkrete Förderhöhe im Einzelfall ist zudem abhängig von weitergehenden, anzuwendenden EU-Beihilfevorschriften (s. Fördervoraussetzungen).&lt;/p&gt;\n&lt;p&gt;Die finanzielle Beteiligung von Drittmittelgebern ist anzustreben. Entsprechende Bemühungen müssen Sie vor Erlass des Zuwendungsbescheides nachweisen.&amp;nbsp;&lt;/p&gt;\n&lt;p&gt;Zweckgebundene Geldspenden dürfen als Eigenmittel eingesetzt werden. Dies gilt nicht, wenn ein Dritter sich aus eigenem Interesse an der Finanzierung beteiligt oder von Gesetzes wegen zur Leistung verpflichtet ist.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Zuwendungsfähig sind Ausgaben, die in einem ursächlichen Zusammenhang mit dem Projekt stehen und zur Durchführung des Projekts erforderlich sind, soweit sich aus der Förderrichtlinie nicht etwas anderes ergibt.&amp;nbsp;&lt;/p&gt;\n&lt;p&gt;Zuwendungsfähig sind dabei folgende Ausgabenarten:&lt;/p&gt;\n&lt;ol&gt;\n  &lt;li class=\"ordered-list-item--alphabet\"&gt;Personalausgaben,&amp;nbsp;&lt;/li&gt;\n  &lt;li class=\"ordered-list-item--alphabet\"&gt;Sachausgaben sowie&lt;/li&gt;\n  &lt;li class=\"ordered-list-item--alphabet\"&gt;Investitionen.&lt;/li&gt;\n&lt;/ol&gt;\n&lt;p&gt;Investitionen, deren geplante Nutzung über den Förderzeitraum hinaus laufen soll, werden grundsätzlich nur anteilig gefördert. Es gilt nur die nach den Grundsätzen ordnungsgemäßer Buchführung ermittelte Wertminderung während des geförderten Vorhabenszeitraums als zuwendungsfähig. Nicht zuwendungsfähig sind nachfolgende Ausgaben:&lt;/p&gt;\n&lt;ol&gt;\n  &lt;li class=\"ordered-list-item--alphabet\"&gt;Ausgaben für Bau- und Sanierungsmaßnahmen sowie Grunderwerb,&lt;/li&gt;\n  &lt;li class=\"ordered-list-item--alphabet\"&gt;Ausgaben für Weiterbildungs- und Schulungsmaßnahmen, sofern diese nicht unmittelbar dem Projektziel dienen,&lt;/li&gt;\n  &lt;li class=\"ordered-list-item--alphabet\"&gt;Gemeinkosten sowie&lt;/li&gt;\n  &lt;li class=\"ordered-list-item--alphabet\"&gt;Leistungszulagen oder Prämien.&lt;/li&gt;\n&lt;/ol&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:euBeihilferelevanz>Grundsätzlich wird vom Vorliegen einer Beihilfe ausgegangen, es sei denn, der Tatbestand kann insbesondere bei nicht-wirtschaftlichen Tätigkeiten von Forschungseinrichtungen unter den Voraussetzungen des Unionsrahmens für staatliche Beihilfen zur Förderung von Forschung, Entwicklung und Innovation (ABl. C 414 vom 28. Oktober 2022 - FEI-Unionsrahmen) ausgeschlossen werden.\n\nEs bedarf stets einer Prüfung im Einzelfall.</xflb:euBeihilferelevanz>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:zuwendungsart>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:jahre>1</xflb:jahre>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:jahre>3</xflb:jahre>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name>Vereine</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>002</code>\n                  <name>Kleine und mittlere Unternehmen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>004</code>\n                  <name>Unternehmen mit ausländischem Mehrheitsbesitz</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>006</code>\n                  <name>Forschungseinrichtungen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name>Verbände</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>005</code>\n                  <name>Großunternehmen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name>Privatpersonen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>003</code>\n                  <name>Einzelunternehmen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name>Stiftungen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name>Kommunen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>007</code>\n                  <name>Freiberufler</name>\n               </xflb:foerdernehmende>\n            </xflb:foerdernehmende>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.stmgp.bayern.de/service/foerderprogramme/</xflb:linkZurAntragsstellung>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Antragsformular unter Verwendung des Antragsvordrucks nach Muster 1a zu Art. 44 BayHO</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Vorhabensbeschreibung; im Falle von Verbundvorhaben ist eine Gesamtvorhabensbeschreibung (Mantelantrag) sowie eine kurze Beschreibung je Partner beizufügen</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Ausführliche Vorhabensbeschreibung unter Verwendung SMARTer Zielformulierungsvorschläge (spezifisch, messbar, erreichbar, angemessen und terminiert) und Beifügung eines Konzeptes zur Evaluierung.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Ausgaben- und Finanzierungsplan</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Aufstellung der im Zusammenhang mit dem Zuwendungszweck anfallenden Ausgaben und Übersicht über die angedachte Finanzierung; der Ausgaben und Finanzierungsplan kann in die Vorhabensbeschreibung integriert werden.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Nachweise über Bemühungen, zusätzliche Mittel von Dritten einzuwerben oder eine entsprechende Erklärung darüber, dass keine Mittel eingeworben werden konnten.</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Einverständniserklärung zur Datenweitergabe:</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Eine Einverständniserklärung des Zuwendungsempfängers darüber, dass die Vorhabensbeschreibung zum Zweck der Einholung erforderlicher Expertisen an andere Stellen weitergereicht werden darf.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>ggf. weitere Unterlagen</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Datenschutzkonzepte, Personalunterlagen oder Erklärungen nach EU-Beihilferecht</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:antragsfrist>\n                  <xflb:bemerkung>Förderungen erfolgen ausschließlich im Rahmen von Förderaufrufen (sog. Fördercalls bzw. Förderwettbewerbe). Entsprechende Fristen zur Einreichung von Skizzen bzw. Anträgen werden jeweils gesondert bekannt gegeben.</xflb:bemerkung>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristdatum>2027-12-31</xflb:fristdatum>\n                  </xflb:zeitlicheEingrenzung>\n               </xflb:antragsfrist>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Der Förderantrag ist unterzeichnet und schriftlich oder digital (einschließlich sämtlicher mindestens erforderlicher Unterlagen) bei der zuständigen Bewilligungsbehörde einzureichen. Vor der finalen Antragsstellung sollen Projektinhalt und -umfang mit der Bewilligungsbehörde oder dem StMGP abgestimmt werden. Über alle innerhalb der Frist eingegangenen Anträge wird nach pflichtgemäßem Ermessen und im Rahmen der zur Verfügung stehenden Haushaltsmittel entschieden.&lt;/p&gt;\n&lt;p&gt;&lt;u&gt;Förderung im Wettbewerb (Förderaufrufe)&lt;/u&gt;&lt;/p&gt;\n&lt;p&gt;Die Förderung nach den Förderlinien erfolgt insbesondere durch Förderaufrufe, die den Rahmen dieser Richtlinie gegebenenfalls weiter konkretisieren können. In den Förderaufrufen werden thematische Schwerpunkte und Fördergegenstände sowie Wertungskriterien spezifisch festgelegt.&lt;/p&gt;\n&lt;p&gt;Förderaufrufe finden als zweistufiges Verfahren statt.&lt;/p&gt;\n&lt;p&gt;Bei der ersten Stufe können aussagekräftige Projektskizzen eingereicht werden. Das StMGP setzt zur Bewertung der eingegangenen Projektvorschläge eine Jury ein, die anhand der im Aufruf definierten Wertungskriterien sowohl fachliche und technische Aspekte als auch die gesellschaftliche Bedeutung und den Transferaspekt des Antrages beurteilt. Die Jury unterstützt das StMGP mit ihrer Empfehlung bei der Entscheidungsfindung und der Auswahl geeigneter Projekte. Die Bewilligungsbehörde prüft anschließend das Vorliegen der Fördervoraussetzungen anhand dieser Richtlinie und anhand weiterführender Kriterien aus dem Förderaufruf. Das StMGP trifft eine Auswahlentscheidung.&lt;/p&gt;\n&lt;p&gt;In Stufe 2 werden nach einer vorgenommenen Auswahl die Einreichenden aufgefordert, einen Antrag bei der zuständigen Bewilligungsbehörde zu stellen (s.o).&lt;/p&gt;\n&lt;p&gt;Über das Ergebnis des Wettbewerbs werden die Antragsteller schriftlich unterrichtet. Die Teilnahme an einem Förderaufruf oder der Aufruf, einen Antrag einzureichen, begründet keinen Rechtsanspruch auf eine Förderung. Erfüllt kein Antragsteller und kein Verbund die Voraussetzungen der ersten oder zweiten wettbewerblichen Stufe, kann ein Wettbewerbsaufruf ohne Zuschlag enden.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>&lt;p&gt;Es gelten hier die&amp;nbsp;Bestimmungen der VV Nr. 1.3 zu Art. 44 BayHO.&lt;/p&gt;</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                     <name/>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:monate>5</xflb:monate>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>7</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n            </xflb:antragsinformationen>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-08-16T12:00:30</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert werden in dieser Förderlinie Vorhaben mit modellhaftem und innovativem Charakter, welche im Bereich der Gesundheit, Pflege und Prävention experimentell neue Ideen erproben oder Lösungen für bestehende Probleme in der Versorgung anbieten. Die Vorhaben sollten einen Bezug zur Digitalisierung oder anderen Zukunftstechnologien wie beispielsweise der Robotik oder der Künstlichen Intelligenz aufweisen und eine zukunftssichere Gestaltung der Versorgung ermöglichen.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Für eine Förderung ist das Erfüllen einer Reihe von Voraussetzungen notwendig. Es gibt dabei Voraussetzungen, die für jede Förderlinie zutreffen und solche, die nur spezifisch für eine Förderlinie gelten.&lt;/p&gt;\n&lt;p&gt;Die allgemeinen Voraussetzungen sind:&lt;/p&gt;\n&lt;ul&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Die allgemeinen bayerischen Voraussetzungen nach der Bayerischen Haushaltsordnung &amp;nbsp;(Art. 23 und 44) und der dazu erlassenen Verwaltungsvorschriften müssen erfüllt werden.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Ihr Projekt muss mindestens einem der geförderten Themengebiete (Förderlinien) entsprechen, kann aber auch mehrere abdecken.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Die angestrebten Projektziele müssen nach der SMART-Methode (spezifisch, messbar, erreichbar, angemessen und terminiert) definiert und im Antrag dargelegt werden.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Die Projekte müssen in Bayern durchgeführt werden oder zumindest einen Durchführungsschwerpunkt in Bayern haben.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Ergebnisse, Veröffentlichungen und Daten müssen frei im Internet verfügbar gemacht werden (Open Access und Open Data).&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Jedes Projekt soll eine unabhängige Evaluation beinhalten.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Alle Projekte müssen datenschutzrechtliche Anforderungen erfüllen.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Soweit es sich bei der Förderung Ihres Vorhabens um eine mögliche Beihilfe im Sinne des Art. 107 Abs. 1 des Vertrages über die Arbeitsweise der Europäischen Union (AEUV) handeln könnte, muss das Vorhaben zusätzliche Voraussetzungen entsprechender und nach Art des Vorhabens einschlägiger EU-Beihilfevorschriften erfüllen. Das wird durch die Bewilligungsbehörde geprüft.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Für Verbundprojekte, bei denen mindestens ein Partner eine Einrichtung für Forschung und Entwicklung im Sinne des Unionsrahmens für staatliche Beihilfen zur Förderung von Forschung, Entwicklung und Innovation (ABl. C 414 vom 28. Oktober 2022 - FEI-Unionsrahmen) &amp;nbsp;ist und beihilfefrei gefördert werden kann, und ein oder mehrere Unternehmen i.S.d. Art. 107 AEUV beteiligt sind, muss vor Antragstellung oder spätestens vor Beginn der gemeinsamen Projektarbeiten ein Kooperationsvertrag vorgelegt werden. Dieser Vertrag muss den Anforderungen der Randnummern 28, 29 und 30 des FEI-Unionsrahmens entsprechen.&lt;/li&gt;\n&lt;/ul&gt;\n&lt;p&gt;Details zu den allgemeinen Voraussetzungen können der&amp;nbsp;Nr. 1.3 der Förderrichtlinie entnommen werden.&lt;/p&gt;\n&lt;p&gt;Neben den allgemeinen Voraussetzungen kommen die spezifischen Voraussetzungen:&lt;/p&gt;\n&lt;ul&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Ihr Vorhaben muss einen innovativen Ansatz zur Verbesserung von Versorgungsstrukturen aufweisen.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Das Vorhaben sollte geeignet sein, in die Regelversorgung überführt zu werden.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Gleichsam müssen alle eingesetzten Komponenten anerkannte interoperable Standards, insbesondere hinsichtlich der Telematikinfrastruktur aufweisen, soweit dies für die eingesetzte Technologie möglich ist.&lt;/li&gt;\n&lt;/ul&gt;\n&lt;p&gt;Details zu den Voraussetzungen können der Nr.&amp;nbsp;4.3 der Förderrichtlinie entnommen werden.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Die Förderung erfolgt ohne Rechtsanspruch im Rahmen der verfügbaren Haushaltsmittel. Zuwendungen&amp;nbsp;aus dem Programm stellen freiwillige Leistungen dar und können nur&amp;nbsp;insoweit bewilligt werden, als dafür Haushaltsmittel zur Verfügung &amp;nbsp;stehen. Ein Zuwendungsantrag kann deshalb unter Umständen wegen Überzeichnung des Förderprogramms nicht bewilligt werden.&lt;/p&gt;\n&lt;p&gt;Projektideen und Anträge sollten im Vorfeld mit der Bewilligungsbehörde oder dem Bayerischen Staatsministerium für Gesundheit, Pflege und Prävention (StMGP) abgestimmt werden. Nur vollständige Anträge können bearbeitet werden.&lt;/p&gt;\n&lt;p&gt;Zu beachten ist, dass die in Nr. 1.1.3 sowie spezifisch in der Nr. 4.2.2 der Richtlinie genannten Vorhaben nicht gefördert werden können.&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>006</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>\n"
                              ]
            ];
  rdf:_12   [ xyz:attributes  [ xyz:antragsstellung      "https://www.stmas.bayern.de/imperia/md/content/stmas/stmas_inet/arbeit/antrag_auf_bewilligung_einer_zuwendung_aus_dem_amf.pdf";
