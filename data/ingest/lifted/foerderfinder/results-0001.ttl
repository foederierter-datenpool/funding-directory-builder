                                xyz:xml   "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           produkt=\"Förderfinder\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produktversion=\"\"\n                                           standard=\"XFLB\"\n                                           test=\"\"\n                                           version=\"2.0.0\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0 xflb.xsd\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>eab704e5-7bce-4d22-9b34-8e2fd8431b73</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-10-18T11:18:49</xflb:erstellungszeitpunkt>\n      <xflb:sender>Förderfinder Suche (Bayern)</xflb:sender>\n      <xflb:empfaenger>XFLB-Connect (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>eab704e5-7bce-4d22-9b34-8e2fd8431b73</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>eab704e5-7bce-4d22-9b34-8e2fd8431b73</xflb:schluessel>\n         <xflb:versionFLB>3</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:ablaufdatumRichtlinie>2028-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Unterricht und Kultus</xflb:verantwortlichesMinisterium>\n               <xflb:verantwortlichesFachreferat>I.4</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Formularserver zur Förderantragstellung Digitale Schule der Zukunft - Förderung der 1:1-Ausstattung von Schülerinnen und Schülern mit mobilen Endgeräten</xflb:programmtitel>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.verkuendung-bayern.de/baymbl/2024-278/</xflb:link>\n                     <xflb:bezeichnung>Digitale Schule der Zukunft - Lernen mit mobilen Endgeräten Bekanntmachung des Bayerischen Staatsministeriums für Unterricht und Kultus  vom 31. Mai 2024, Az. I.3-BO1371.2/14/2</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name>Bayern</name>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Digitale Schule der Zukunft - Lernen mit mobilen Endgeräten</xflb:titel>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.km.bayern.de/dsdz</xflb:link>\n                     <xflb:bezeichnung>Homepage des Bayerischen Staatsministeriums für Unterricht und Kultus</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Im Rahmen der Digitalen Schule der Zukunft wird die Beschaffung von privaten mobilen Endgeräten für das Lernen in der Schule und zu Hause durch einen staatlichen Zuschuss unterstützt.&amp;nbsp;&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:schluesselwoerter>Digitale Schule der Zukunft; 1:1-Ausstattung; Lernen mit mobilen Endgeräten</xflb:schluesselwoerter>\n                  <xflb:teaser>Die Digitale Schule der Zukunft verfolgt das Ziel der Weiterentwicklung des Unterrichts auf Basis einer 1:1-Ausstattung mit mobilen Endgeräten.</xflb:teaser>\n               </xflb:beschreibung>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Die Schule Ihres Kindes sowie das Bayerische Landesamt für Schule</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n            </xflb:allgemeineAngaben>\n            <xflb:finanzierung>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Höhe des maximalen Förderbetrags beträgt 350 Euro.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Mobile Endgeräte die folgende Voraussetzungen erfüllen und die von den Schulen verbindlich vorgegebenen Ausstattungskomponenten:&lt;/p&gt;\n&lt;ul&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Neugeräte mit mindestens 10 Zoll Bildschirmgröße oder Refurbished-Geräte mit mindestens 10 Zoll Bildschirmgröße von gewerblichen Händlern mit einer Garantie von mindestens einem Jahr.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;sowie zusätzlich festgelegte schulspezifische technische Mindestkriterien&lt;/li&gt;\n&lt;/ul&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:zuwendungsart>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.dsdz.bayern.de</xflb:linkZurAntragsstellung>\n               <xflb:antragsfrist>\n                  <xflb:bemerkung>Der Förderantrag ist bis spätestens neun Monate nach Beschaffung des Endgeräts einzureichen, spätestens jedoch zwei Monate nach Verlassen der Schule, für die das Gerät beschafft wurde. Später eingehende Anträge können grundsätzlich nicht mehr berücksichtigt werden.</xflb:bemerkung>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristFest>\n                        <xflb:monate>9</xflb:monate>\n                     </xflb:fristFest>\n                  </xflb:zeitlicheEingrenzung>\n               </xflb:antragsfrist>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Online-Antrag</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Kauf- und Zahlungsbelege</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;ul&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Ausfüllen des Online-Formulars (ab September 2024 möglich)&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Hochladen der erforderlichen Belege (Kaufbeleg und/oder Zahlungsbeleg)&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Prüfung des Antrags durch die Schule und das Landesamt für Schule&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Bewilligung und Auszahlung durch das Landesamt für Schule&lt;/li&gt;\n&lt;/ul&gt;</xflb:bewilligung>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>&lt;p&gt;Der vorzeitige Vorhabenbeginn wird ab Bestätigung der Teilnahme der Schule druch das Staatsministerium für Unterricht und Kultus zugelassen.&amp;nbsp;&lt;/p&gt;</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>006</code>\n                     <name/>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n            </xflb:antragsinformationen>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Voraussetzung um eine Förderung beantragen zu können ist, dass die Schulklasse Ihres Kindes als 1:1-Ausstattungsklasse an der Digitalen Schule der Zukunft teilnimmt. Zudem muss das beschaffte Gerät alle festgelegten technischen Kriterien erfüllen.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Die Förderung ist insbesondere ausgeschlossen, wenn&lt;/p&gt;\n&lt;ul&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;ihr Kind keine 1:1-Ausstattungsklasse im Rahmen der Digitalen Schule der Zukunft besucht&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;das Gerät nicht die vorgegebenen technischen Mindestkriterien erfüllt&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Sie bereits zwei Mal eine Förderung im Rahmen der Digitalen Schule der Zukunft erhalten&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;der Antrag zu spät abgegeben wurde&amp;nbsp;&lt;/li&gt;\n&lt;/ul&gt;</xflb:ausschlusskriterien>\n               <xflb:rechtlicheBeschreibung>&lt;p&gt;Zuwendungsempfängerinnen und -empfänger sind die volljährigen Schülerinnen und Schüler einer 1:1-Ausstattungsklasse, bei minderjährigen Schülerinnen und Schülern deren Erziehungsberechtigte. Ein mobiles Endgerät ist nur förderfähig, wenn es die zwingenden technischen Mindestkriterien und ggf. die zusätzlich festgelegten schulspezifischen technischen Mindestkriterien erfüllt.&lt;/p&gt;</xflb:rechtlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>eab704e5-7bce-4d22-9b34-8e2fd8431b73</xflb:foerderschluessel>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n                  <xflb:flbVersion>3</xflb:flbVersion>\n               </xflb:interneKennung>\n            </xflb:zuordnungen>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name>Privatpersonen</name>\n               </xflb:foerdernehmende>\n            </xflb:foerdernehmende>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert werden&amp;nbsp;Laptops/Notebooks, Tablets oder Convertibles sowie ggf. von der Schule verbindlich vorgegebene Ausstattungskomponenten (Tastatur und/oder Stift).&lt;/p&gt;\n&lt;p&gt;Mobile Endgeräte sind Endgeräte, die aufgrund ihrer Größe und ihres Gewichts ohne größere körperliche Anstrengung tragbar und somit mobil zur Sprach- und Datenkommunikation einsetzbar sind. Von der Zuwendung ausgenommen sind Mobilfunktelefone sowie Smartphones.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-10-18T11:18:49</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>006</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>\n"
                              ]
            ];
  rdf:_104  [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index";
                                xyz:beschreibung         "<p>Zweck der Zuwendung ist eine Unterstützung der Landkreise und kreisfreien Städte im ländlichen Raum, die das Defizit einer in ihrem Gebiet gelegenen Abteilung Gynäkologie und Geburtshilfe an einem Plankrankenhaus ausgleichen. Insgesamt soll damit die flächendeckende und qualitativ hochwertige geburtshilfliche Versorgung in Krankenhäusern gesichert und aufrechterhalten werden</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Gesundheit und Soziales" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Kommunen" ];
                                xyz:foerderprogramm      "Förderprogramm Geburtshilfe (GebHilfR) Säule 2";
                                xyz:foerderzeitraum.bis  "2027-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2022-10-01T00:00:00.000+00:00";
                                xyz:schluessel           "2e505761-082c-4d31-8dca-bf24265d787e";
                                xyz:teaser               "Der Freistaat Bayern unterstützt Landkreise und kreisfeie Städte, die Defizite kleinerer Abteilungen Gynäkologie und Geburtshilfe ausgleichen.";
                                xyz:titel                "Geburtshilfe; Beantragung einer Förderung für Defizitausgleich für Krankenhaus";
                                xyz:titel.tokens         [ rdf:_1  "Geburtshilfe";
                                                           rdf:_2  "Beantragung einer Förderung für Defizitausgleich für Krankenhaus"
                                                         ];
                                xyz:voraussetzung        "Fördervoraussetzung sind relativ geringe Geburtenzahlen in Verbindung mit dem\nStatus als Hauptversorger in der Region.\n\nWeitere Zuwendungsvoraussetzungen siehe Richtlinie unter \"Rechtsgrundlagen\"."
                              ];
