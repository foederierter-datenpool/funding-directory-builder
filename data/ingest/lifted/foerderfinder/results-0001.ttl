                                xyz:beschreibung         "<p>Mit dem Förderprogramm Regionalkultur sollen in ganz Bayern heimatpflegerische Initiativen gefördert und das Heimat- und Traditionsbewusstsein gestärkt werden.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Kultur, Medien und Sport" ];
