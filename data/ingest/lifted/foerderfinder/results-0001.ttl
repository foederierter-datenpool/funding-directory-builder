                                                                                                                                           xyz:alternativeFoerdermoeglichkeiten
                                                                                                                                                   [ xyz:alternativeFoerdermoeglichkeit
                                                                                                                                                             [ xyz:beschreibung  "Zum Betrieb von ortsfesten Funkanlagen (FRT) und Sirenensteuereinheiten (TSE) wird in Bayern das Anmeldeverfahren für ortsfeste Funkanlagen der Bundesanstalt für den Digitalfunk der Behörden und Organisationen mit Sicherheitsaufgaben (BDBOS) vorausgesetzt.";
                                                                                                                                                               xyz:verweis       [ xyz:bezeichnung  "Digitalfunk BOS; Anmeldung von ortsfesten Funkanlagen und Sirenensteuereinheiten";
                                                                                                                                                                                   xyz:link         "https://www.bayernportal.de/dokumente/leistung/4178486289149"
                                                                                                                                                                                 ]
