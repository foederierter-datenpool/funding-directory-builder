                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>d62d789a-0c67-4721-abdb-49b6c216e4a3</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2023-12-21T15:32:57</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>d62d789a-0c67-4721-abdb-49b6c216e4a3</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>d62d789a-0c67-4721-abdb-49b6c216e4a3</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2023-12-21T15:32:57</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>d62d789a-0c67-4721-abdb-49b6c216e4a3</xflb:foerderschluessel>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Bauliche Sanierung (Erneuerung und Renovierung, nicht Reparatur) bestehender Trinkwasserleitungen und Abwasserkanäle (Misch-, Schmutz- und Niederschlagswasserkanäle)</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>In Härtefällen werden Vorhaben zur baulichen Sanierung (Erneuerung und Renovierung; nicht Reparatur) bestehender  Trinkwasserleitungen der öffentlichen Wasserversorgung und Abwasserkanäle (Misch-, Schmutz- und Niederschlagswasserkanäle) gefördert, wenn diese zu\nunzumutbaren Belastungen von Gebietskörperschaften sowie Bürgerinnen und Bürgern führen.</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern unterstützt die bayerischen Städte und Gemeinden bei der\nSanierung von öffentlichen Trinkwasser- und Abwasseranlagen in Härtefällen mit Zuwendungen.</xflb:teaser>\n                  <xflb:schluesselwoerter>Wasserversorgungsanlagen, Zuwendungen zu Abwasserentsorgungsanlagen, Kanalsanierung, Zuwendungen zur öffentlichen Trinkwasserversorgung, Härtefallförderung, Trinkwasserleitungen</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderung wasserwirtschaftlicher Vorhaben</xflb:bezeichnung>\n                     <xflb:link>http://www.stmuv.bayern.de/themen/wasserwirtschaft/foerderung/index.htm</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>regional zuständiges Wasserwirtschaftsamt</xflb:name>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>zuständiges Wasserwirtschaftsamt</xflb:bezeichnung>\n                     <xflb:link>https://www.stmuv.bayern.de/themen/wasserwirtschaft/wasserwirtschaft_in_bayern/wasseraemter.htm</xflb:link>\n                  </xflb:verweis>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Ihr zuständiges Wasserwirtschaftsamt</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>76257d30-3191-42ce-a75b-133ea11fbc9c</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Gewährung einer Zuwendung nach Muster 1a zu Art. 44 BayHO für kommunale Gebietskörperschaften</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>40e59373-5f6a-47f8-ba84-e240995fe6ae</xflb:id>\n                     <xflb:bezeichnung>Ermittlung der Pro-Kopf-Belastung (Anlage 2 RZWas 2025)</xflb:bezeichnung>\n                     <xflb:link>https://www.stmuv.bayern.de/themen/wasserwirtschaft/foerderung/doc/anlage_2_ermittlung_pkb.pdf</xflb:link>\n                     <xflb:beschreibung>&lt;p&gt;Um eine Förderung zu erhalten, muss die Härtefallschwelle erreicht werden. Hierzu bitte Anlage 2 ausfüllen.&lt;/p&gt;</xflb:beschreibung>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Gebietskörperschaften (einschließlich deren Eigenbetriebe), öffentlich-rechtliche Zusammenschlüsse von Gebietskörperschaften, Kommunalunternehmen nach Art. 89 der Gemeindeordnung und Gemeinsame Kommunalunternehmen nach Art. 49 des Gesetzes über die kommunale Zusammenarbeit.\nWasser- und Bodenverbände, soweit sie zu 100% an der Gebietskörperschaft beteiligt sind.\nAusgenommen sind Gebietskörperschaften mit mehr als 20.000 Einwohnern und große Wasserversorgungsunternehmen (die Auflistung finden Sie in der RZWas2025, Seite 12).</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Förderung von Wasserleitungen und Abwasserkanälen erfolgt längenabhängig. Der Festbetrag beträgt für Vorhaben nach Nr. 2.2.1 über der Härtefallschwelle 1 nach Nr. 4.3.1: 120 Euro Zuwendung pro saniertem Meter Wasserleitung, 150 Euro Zuwendung pro renoviertem Meter Abwasserkanal und 300 Euro pro erneuertem oder im Trennsystem erstmalig gebautem Meter Abwasserkanal; mindestens jedoch 40 % bzw. maximal 90 % der Ausgaben nach Ausführung. Der Festbetrag beträgt davon abweichend für Vorhaben nach Nr. 2.2.1 ab Erreichen der Härtefallschwelle 2 nach Nr. 4.3.2: 180 Euro Zuwendung pro saniertem Meter Wasserleitung, 225 Euro Zuwendung pro renoviertem Meter Abwasserkanal und 450 Euro pro erneuertem oder im Trennsystem erstmalig gebautem Meter Abwasserkanal; mindestens jedoch 70 % bzw. maximal 90 % der Ausgaben nach Ausführung. Die Längen werden in ganzen Metern ermittelt; Schächte werden übermessen. Bei Trennsystemen zählen sowohl die sanierten Längen des Schmutz-, als auch des Niederschlagswasserkanals. Es sind nur die Längen in dem Umfang förderfähig, in dem bestehende Leitungen und Kanäle saniert werden. Insgesamt gibt es max. 5 Mio Euro im Bewilligungszeitraum.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Sanierung von Wasserleitungen (keine Reparatur)&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Kanal-Renovierung (keine Reperatur)&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Kanal-Erneuerung&lt;/li&gt;&lt;/ul&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:jahre>1</xflb:jahre>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:jahre>4</xflb:jahre>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Umwelt und Verbraucherschutz</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinien für Zuwendungen zu wasserwirtschaftlichen Vorhaben (RZWas 2025)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_7538_U_15039?hl=true</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat 58 - Schutz oberirdischer Gewässer, Abwasserentsorgung</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Richtlinien für Zuwendungen zu wasserwirtschaftlichen Vorhaben (RZWas 2025)</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2028-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2025-04-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2028-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>Nr. 2.2.1 - die bauliche Sanierung (Erneuerung und Renovierung, nicht Reparatur) bestehender Trinkwasserleitungen und Abwasserkanäle (Misch-, Schmutz und Niederschlagswasserkanäle)</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>019</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Für Vorhaben nach Nrn. 2.2.1 wird die Förderung gewährt, wenn die nach Anlage 2 RZWas 2025 ermittelte Pro-Kopf-Belastung eine der Härtefallschwellen nach Anhang Teil B Nr. 4.3 RZWas 2025 überschreitet. Es können nur Vorhaben gefördert werden, die noch nicht begonnen worden sind. Weitere Details erfahren Sie bei Ihrem örtlich zuständigen Wasserwirtschaftsamt.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:rechtlicheBeschreibung>&lt;p&gt;RZWas 2025, 4.1 Die Wirtschaftlichkeit und Sparsamkeit eines Vorhabens sind nachzuweisen nach Nr. 6.2 VV zu Art. 44 BayHO in Verbindung mit Nr. 4.1 BayZBau). Wenn mehrere Lösungen möglich sind, kann nur die wirtschaftlichste und sparsamste Lösung gefördert werden. 4.2 Es können nur Vorhaben gefördert werden, die noch nicht begonnen worden sind (Nr. 1.3 VV zu Art. 44 BayHO). Als Vorhabenbeginn ist grundsätzlich die Abgabe einer verbindlichen Willenserklärung zum Abschluss eines der Ausführung zuzurechnenden Lieferungs- oder Leistungsvertrags zu werten. Bei Baumaßnahmen gelten Planungsaufträge bis einschließlich Leistungsphase sieben der HOAI, Baugrunduntersuchungen, Grunderwerb und Herrichten des Grundstücks (zum Beispiel Gebäudeabbruch, Planieren), naturschutzfachliche Erhebungen sowie naturschutzfachliche Ausgleichs- und Ersatzmaßnahmen, die vor dem Beginn der Hauptmaßnahme ausgeführt werden müssen, nicht als Beginn des Vorhabens. &amp;nbsp;RZWas 2025 Teil B zu Nr. 4 4.3. Die Härtefallförderung wird für Vorhaben nach den Nrn. 2.2.1 und 2.2.3 gewährt, wenn die nach Anlage 2 ermittelte Pro-Kopf-Belastung für die öffentliche Wasserversorgung und Abwasserentsorgung getrennt oder gemeinsam (bei deckungsgleichem Satzungs-bzw. Versorgungsgebiet) berechnet eine der in Nr. 4.3.1 genannten Härtefallschwellen überschreitet. Die Pro-Kopf-Belastung ist für das gesamte Satzungs-bzw. Versorgungsgebiet für das aktuelle Kalenderjahr zu ermitteln. Das Satzungs-bzw. Versorgungsgebiet im Sinne der RZWas 2025 entspricht dem räumlichen Geltungsbereich, in dem einheitliche Beiträge und Gebühren bzw. Preise erhoben werden. Ein deckungsgleiches Satzungs-bzw. Versorgungsgebiet ist gegeben, wenn sich das Satzungs-bzw. Versorgungsgebiet der öffentlichen Wasserversorgung und das Satzungsgebiet der kommunalen Abwasserentsorgung bei 75 % der angeschlossenen Einwohner zum Datum Stichtag auf Seite 2 der Anlage 2 überschneiden; dies ist vom Antragsteller nachzuweisen. Ein deckungsgleiches Satzungs-bzw. Versorgungsgebiet ist außerdem gegeben, wenn 75 % der Einwohner in Satzungs-bzw. Versorgungsgebieten liegen, deren Pro-Kopf-Belastung in gemeinsamer Betrachtung über der Härtefallschwelle liegt. Überschreitung einer der Härtefallschwellen nach Nrn. 4.3.1 oder 4.3.2 Teil B RZWas 2025. Ermittlung der maßgeblichen Pro-Kopf-Belastung gemäß Anlage 2 RZWas 2025.&lt;/p&gt;</xflb:rechtlicheBeschreibung>\n               <xflb:ausschlusskriterien>Gebietskörperschaften, deren Eigenbetriebe sowie deren Unternehmen in Privatrechtsform, mit mehr als 20 000 Einwohnern werden nicht gefördert. Unternehmen in Privatrechtsform sowie Wasser- und Bodenverbände an denen Gebietskörperschaften zu weniger als 100 Prozent beteiligt sind. \nAusgenommen von der Förderung sind folgende Fernwasserversorgungsunternehmen:\n- Wasserversorgung Bayerischer Wald,\n- Wasserversorgung Steinwaldgruppe,\n- Fernwasserversorgung Oberfranken,\n- Fernwasserversorgung Franken,\n- Fernwasserversorgung Mittelmain,\n- Fernwasserversorgung Oberes Allgäu.</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>- Der Zuwendungsantrag ist beim örtlich zuständigen Wasserwirtschaftsamt zu stellen.\n- Nach erfolgreicher Prüfung erfolgt die Aufnahme in das Härtefallprogramm. Das Wasserwirtschaftsamt erlässt den Zuwendungsbescheid.\n- Zuwendungen können maximal einmal jährlich nach Vorlage einer Verwendungsbestätigung beim Wasserwirtschaftsamt abgerufen werden.\n- Zu den Details berät das örtlich zuständige Wasserwirtschaftsamt.</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>001</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:wochen>2</xflb:wochen>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>2</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristdatum>2028-09-30</xflb:fristdatum>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Es gilt der Posteinlaufstempel des Wasserwirtschaftsamtes.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Muster 1a zu Art 44 BayHO (Antragsformular)</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Digital verfügbar</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Erläuterung (Kurzfassung für den im Bauabschnitt zu fördernden Teil)</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Lageplan, in dem die zu fördernden Teile rot gekennzeichnet sind</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Anlage 2 RZWas 2025 - Ermittlung der Pro-Kopf-Belastung (PKB)</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Barrierefreies, ausfüllbares pdf-Datei verfügbar</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Beschluss des zuständigen Organs des Zuwendungsempfängers, das vorhaben durchführen zu wollen</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Erklärung- Weitergabe</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Erklärung des Vorhabensträgers, ob er die Zuwendungen an einen Dritten weitergibt</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>verwaltungsgerichtliche Klage</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_113  [ xyz:attributes  [ xyz:antragsstellung      "https://www.bayernportal.de/dokumente/onlineservice/21329684787?";
                                xyz:begriffeImKontext    [ rdf:_1   "BayernPortal";
