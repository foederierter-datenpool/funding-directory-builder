                                                                                                                                                               rdf:_2  [ xyz:beschreibung  "Der Freistaat Bayern fördert innovative, fachübergreifende Heimatprojekte mit Schwerpunkt Digitalisierung, die sich positiv auf die räumliche Entwicklung Bayerns auswirken und insbesondere der Stärkung der regionalen Identität dienen.";
                                                                                                                                                                         xyz:verweis       [ xyz:bezeichnung  "Digitale regionale Heimatprojekte; Beantragung einer Förderung";
                                                                                                                                                                                             xyz:link         "https://www.bayernportal.de/dokumente/leistung/4636064075101"
                                                                                                                                                                                           ]
