                                                                                                                                           xyz:erforderlicheUnterlagen  [ xyz:dokument  [ rdf:_1  [ xyz:bezeichnung   "Aussagekräftige Vorhabensbeschreibung";
                                                                                                                                                                                                    xyz:erlaeuterung  "Ort, Zeitraum der Durchführung der Maßnahme\nBeschreibung der Bibliothek\nBaubeschreibung mit Raumkonzept, ggf. Planunterlagen"
                                                                                                                                                                                                  ];
                                                                                                                                                                                          rdf:_2  [ xyz:bezeichnung   "Kostenplan";
                                                                                                                                                                                                    xyz:erlaeuterung  "Aufschlüsselung aller, mit dem Vorhaben zusammenhängenden Ausgaben nach Kostengruppen (DIN 276), je nach Vorsteuerabzugsberechtigung brutto oder netto."
                                                                                                                                                                                                  ];
                                                                                                                                                                                          rdf:_3  [ xyz:bezeichnung   "Finanzierungsplan";
                                                                                                                                                                                                    xyz:erlaeuterung  "Der Finanzierungsplan muss neben der Antragssumme auch die Zuwendungen Dritter (z.B. Kommune), sonstige Finanzierungsbeteiligungen (Spenden, Sponsoren) sowie die vom Antragsteller zu erbringende Eigenbeteiligung ausweisen."
                                                                                                                                                                                                  ]
                                                                                                                                                                                        ]
