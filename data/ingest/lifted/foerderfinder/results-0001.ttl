                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<ul><li class=\"unordered-list-item--dash\">Zuwendungsfähig sind Personalausgaben für Fachpersonal und für Verwaltungskräfte.</li><li class=\"unordered-list-item--dash\">Zuwendungsfähig sind Sachausgaben, die im Zusammenhang mit dem jeweiligen Projekt anfallen.</li></ul>"
                                                                                                                                         ];
