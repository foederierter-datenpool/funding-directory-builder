                                                                                                             xyz:antragsinformationen    [ xyz:antragsfrist            [ xyz:zeitlicheEingrenzung  [ xyz:fristJaehrlich
                                                                                                                                                                                           "01.09." ]
                                                                                                                                                                       ];
                                                                                                                                           xyz:beantragungskosten      [ xyz:kostenlos
