                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>72e11f7d-6e6e-4552-9639-58ffce3dc0a6</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-11-21T17:11:21</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>72e11f7d-6e6e-4552-9639-58ffce3dc0a6</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>72e11f7d-6e6e-4552-9639-58ffce3dc0a6</xflb:schluessel>\n         <xflb:versionFLB>4</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-11-21T17:11:21</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:ozgThemenfeld>12</xflb:ozgThemenfeld>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>72e11f7d-6e6e-4552-9639-58ffce3dc0a6</xflb:foerderschluessel>\n                  <xflb:flbVersion>4</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400079017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Mobilität im ländlichen Raum; Förderung ergänzender Nahverkehrsangebote (ErNa)</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Das Förderprogramm unterstützt die Aufgabenträger des Öffentlichen&lt;/p&gt;&lt;p&gt;Personennahverkehrs (ÖPNV), die Verkehrserschließung im ländlichen Raum zu&lt;/p&gt;&lt;p&gt;verbessern und auszuweiten. Um eine angepasste Mobilität zu ermöglichen,&lt;/p&gt;&lt;p&gt;werden Aufwendungen für bedarfsorientierte Bedienformen des allgemeinen ÖPNV&lt;/p&gt;&lt;p&gt;im ländlichen Raum und Pilotprojekte für landkreisübergreifende&lt;/p&gt;&lt;p&gt;Expressbusverbindungen im Omnibusverkehr gefördert.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern fördert die Mobilität im ländlichen Raum.</xflb:teaser>\n                  <xflb:schluesselwoerter>Mobilität, Ländlicher Raum, Bedarfsorientierte Bedienformen, flexible Bedienformen, On-Demand-Verkehr, Expressbus</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Ihre zuständige Regierung</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:onlinedienste>\n                  <xflb:onlinedienst>\n                     <xflb:id>a13ac54a-a61d-4bc2-a593-7f0ef4d43608</xflb:id>\n                     <xflb:bezeichnung>Förderung für ergänzende Nahverkehrsangebote (ErNa) beantragen</xflb:bezeichnung>\n                     <xflb:link>https://foerderung.bayern.de/landingpage/020e7693-f133-498d-bd17-37f7bf1a62fa</xflb:link>\n                     <xflb:beschreibung>Sie können die Förderung über die Fördermanagementplattform Bayern (FMP) digital beantragen.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n               </xflb:onlinedienste>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Zuwendungsempfänger sind ÖPNV-Aufgabenträger nach dem Gesetz über den öffentlichen Personennahverkehr in Bayern (BayÖPNVG), in der Regel die  Landkreise und kreisfreien Städte.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Im Rahmen der Anteilsfinanzierung können mit degressiven Fördersätzen mit anfangs bis zu 75 % der förderfähigen Kosten als Projektförderung gefördert werden.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Zuwendungsfähige Kosten sind die Betriebskostendefizite der Verkehre, die der&lt;/p&gt;&lt;p&gt;ÖPNV-Aufgabenträger ausgleicht.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Wohnen, Bau und Verkehr</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 23 und 44 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO/true</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinie zum Förderprogramm Ergänzender Nahverkehrsangebote zur Verbesserung der Mobilität im ländlichen Raum mit bedarfsorientierten Bedienformen des allgemeinen ÖPNV und Pilotprojekten landkreisübergreifender Expressbusverbindungen im Omnibusverkehr (ErNa)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_97_B_13808</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>62</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Mobilität im ländlichen Raum</xflb:programmtitel>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2023-03-16</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2027-01-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert wird die Einrichtung von flexiblen und bedarfsorientierten&lt;/p&gt;&lt;p&gt;Mobilitätsangeboten im ÖPNV sowie landkreisübergreifende&lt;/p&gt;&lt;p&gt;Expressbusverbindungen. Für die neuen Projekte ist ein Pilotcharakter&lt;/p&gt;&lt;p&gt;wünschenswert.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>016</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Nur die Einführung von neuen flexiblen Bedienformen und Expressverbindungen mit Omnibussen im ländlichen Raum sind von dieser Förderung erfasst. Es ist ein schriftlicher Antrag erforderlich. Die Projekte müssen im Einklang mit dem Nahverkehrsplan stehen. Die genauen Vorgaben sind in der Richtlinie zum Förderprogramm Ergänzender Nahverkehrsangebote zur Verbesserung der Mobilität im ländlichen Raum mit bedarfsorientierten Bedienformen des allgemeinen ÖPNV und Pilotprojekten landkreisübergreifender Expressbusverbindungen im Omnibusverkehr (ErNa) vom 16. Mai 2023, 97-B (BayMBl. Nr. 275) dargestellt.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://foerderung.bayern.de/landingpage/020e7693-f133-498d-bd17-37f7bf1a62fa</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Der Antrag muss bei der zuständigen Regierung eingereicht werden. Diese ist&lt;/p&gt;&lt;p&gt;auch für die Bewilligung zuständig.&lt;/p&gt;</xflb:bewilligung>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:rechtsbehelf>&lt;p&gt;Klage&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ]
] .
