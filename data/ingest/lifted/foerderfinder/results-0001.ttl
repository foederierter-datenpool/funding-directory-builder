                                                                                                                                           xyz:erforderlicheUnterlagen  [ xyz:dokument  [ rdf:_1  [ xyz:bezeichnung  "Genaue Projektbeschreibung" ];
                                                                                                                                                                                          rdf:_2  [ xyz:bezeichnung   "Finanzierungsplan";
                                                                                                                                                                                                    xyz:erlaeuterung  "Aufgegliederte Berechnung der mit dem Förderzweck zusammenhängenden Ausgaben mit einer Übersicht über die beabsichtigte Finanzierung. Soweit Zuwendungen die Umsetzung baulicher Maßnahmen beinhalten, muss eine Kostenschätzung in Anlehnung an Muster 5 zu Art. 44 BayHO oder nach DIN 276 beigelegt werden."
                                                                                                                                                                                                  ];
                                                                                                                                                                                          rdf:_3  [ xyz:bezeichnung  "Erklärung, dass mit der Maßnahme noch nicht begonnen wurde." ];
                                                                                                                                                                                          rdf:_4  [ xyz:bezeichnung  "Erklärung darüber, ob der Förderungsempfänger allgemein oder für das betreffende Vorhaben zum Vorsteuerabzug nach § 15 UStG berechtigt ist." ];
                                                                                                                                                                                          rdf:_5  [ xyz:bezeichnung  "Bestätigung der zugeordneten Kommunen zur Bedarfsnotwendigkeit der Maßnahme." ]
                                                                                                                                                                                        ]
                                                                                                                                                                        ];
                                                                                                                                           xyz:linkZurAntragsstellung   "https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/rmf-zz/13/rmf_13-002-zz/index";
                                                                                                                                           xyz:rechtsbehelf             "<p>keine Angabe</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung
                                                                                                                                                             "<p>Die Förderung erfolgt auf Antrag des Trägers des Frauenhauses.&nbsp;</p><p>Der Bewilligungszeitraum beträgt höchstens 36 Monate.&nbsp;</p><p>Der Antrag ist schriftlich oder elektronisch unter Verwendung der bei der Regierung von Mittelfranken (Bewilligungsbehörde) erhältlichen Vordrucke bis zu vier Monate vor Beginn der Maßnahme dort einzureichen. Diese Frist gilt nicht für Anträge, die im Jahr 2019 gestellt werden.&nbsp;</p><p>Die Bewilligungsbehörde meldet das Vorhaben dem Staatsministerium für Familie, Arbeit und Soziales. Dieses entscheidet über die grundsätzliche Förderfähigkeit des Projekts.</p>" ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:finanzierungsartUndHoehe  "<p>Die staatliche Zuwendung wird im Rahmen einer Projektförderung als Festbetragsfinanzierung gewährt.&nbsp;</p><p>Die Höhe der Zuwendung beträgt pro zusätzlich geschaffenem oder bedarfsgerecht angepasstem Frauenhausplatz bis zu 50.000 Euro, maximal 90 % der zuwendungsfähigen Ausgaben. Werden pro Platz mit der Maßnahme von den unter Nr. 4.1 der Richtlinie genannten Zuwendungsvoraussetzungen beide gleichzeitig erfüllt, erhöht sich hierdurch die Zuwendung nicht.</p>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "001";
                                                                                                                                                                                                    xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
                                                                                                                                                                                                    xyz:listVersionID  "1";
                                                                                                                                                                                                    xyz:name           ""
                                                                                                                                                                                                  ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Zuwendungsfähig sind</p><ul><li class=\"unordered-list-item--dash\">Ausgaben zur Beschaffung von Immobilien, insbesondere für Neubau und Kauf sowie Miete von Häusern oder Wohnungen und für die notwendige Ausstattung inklusive Erstmöblierung; Mietkosten (Einmalförderung) können zuwendungsfähig sein in Höhe der Differenz zwischen den Mietkosten, die sich als Folge einer Maßnahme im Sinne von Nr. 4.1 der Richtlinie ergeben, und den bisherigen Mietkosten;</li><li class=\"unordered-list-item--dash\">Ausgaben für bauliche Veränderungen, insbesondere Umbau, Erweiterungen und Anpassung an die unter Nr. 4.1 der Richtlinie genannten besonderen Bedarfe und für die notwendige Ausstattung inklusive Erstmöblierung;</li><li class=\"unordered-list-item--dash\">Ausgaben für Erwerbs- und Baunebenkosten, insbesondere Planungskosten, Bewertungskosten, Genehmigungskosten, Grundbuchkosten und Maklerkosten;</li><li class=\"unordered-list-item--dash\">Ausgaben für den Umzug des Frauenhauses einschließlich Serviceleistungen.</li></ul>"
                                                                                                                                         ];
                                                                                                             xyz:foerderbereich          [ xyz:foerderbereich  [ xyz:code           "011";
                                                                                                                                                                 xyz:listURI        "urn:xoev-de:stmd:codeliste:foerderbereich";
                                                                                                                                                                 xyz:listVersionID  "1";
                                                                                                                                                                 xyz:name           ""
                                                                                                                                                               ]
                                                                                                                                         ];
