                                                                                                                                           xyz:linkZurAntragsstellung   "https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/vereinseigener_sportstaettenbau_bssb/index?caller=bpmyytimbyg43tiy3fgbsdomzrheb6d5cfe7fjywbgazm5t6wkppncqoxvqhxlsen7zfs2amutpphoqxcrx7prhlquza2rt7c4q3p4czm2sb3hnepgzftfgx7moxnqdiiusknmui3zrvkgbu57gnroiywllaz743w24lonvrvb2y5eyorpngr6gn2k334su7pwq5xzk4avnz4xoyw43rahopxn6xcmb4zvjhejdaksjeyvdqs3w4mvldmimhfn73wy";
                                                                                                                                           xyz:rechtsbehelf             "<p>Gegen den Zuwendungsbescheid können Sie innerhalb von einem Monat Klage vor dem Verwaltungsgericht erheben. Das zuständige Gericht, bei dem Sie Klage einreichen können, wird Ihnen im Bescheid mitgeteilt.</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<p>Förderanträge der Schützenvereine sind bei der zuständigen Regierung einzureichen. Die Regierungen beteiligen die jeweils zuständige Dachorganisation (BSSB oder OSB) und setzen nach erfolgter positiver Prüfung die Höhe des staatlichen Zuschusses für das Bauvorhaben fest.</p>";
                                                                                                                                                                          xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "002";
                                                                                                                                                                                                            xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
                                                                                                                                                                                                            xyz:listVersionID  "1"
                                                                                                                                                                                                          ]
                                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:finanzierungsartUndHoehe  "<p>Die Zuwendungen werden als projektbezogene Zuschüsse im Wege der Festbetragsfinanzierung gewährt. Der Fördersatz beträgt bis zu 25 Prozent der zuwendungsfähigen Kosten.</p>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "001";
                                                                                                                                                                                                    xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
                                                                                                                                                                                                    xyz:listVersionID  "1";
                                                                                                                                                                                                    xyz:name           ""
                                                                                                                                                                                                  ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Gefördert werden Ausgaben für den Neubau, Umbau und die Erweiterung von Sportstätten. Zudem sind Instandsetzungs- und Modernisierungsmaßnahmen förderfähig, wenn die Neuerrichtung oder letzte Generalsanierung mindestens sechs Jahre zurückliegt oder die Ausgaben für die Instandsetzungs- oder Modernisierungsmaßnahme mindestens 65.000 Euro betragen. Förderfähig ist auch der Erwerb eines Objekts (ohne Grundstückskosten), wenn damit ein an sich notwendiger Neu- oder Erweiterungsbau einer Sportstätte entbehrlich wird und der Erwerb einschließlich notwendiger Sanierungen die wirtschaftlichere Lösung gegenüber einem Neu- oder Erweiterungsbau darstellt.</p>"
                                                                                                                                         ];
                                                                                                             xyz:foerderbereich          [ xyz:foerderbereich  [ xyz:code           "013";
                                                                                                                                                                 xyz:listURI        "urn:xoev-de:stmd:codeliste:foerderbereich";
                                                                                                                                                                 xyz:listVersionID  "1";
                                                                                                                                                                 xyz:name           ""
                                                                                                                                                               ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergebiet           [ xyz:laender  [ xyz:land  [ xyz:code           "BY";
                                                                                                                                                                      xyz:listURI        "urn:xoev-de:pks:codeliste:bundesland";
                                                                                                                                                                      xyz:listVersionID  "1";
                                                                                                                                                                      xyz:name           ""
                                                                                                                                                                    ]
                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergegenstand       [ xyz:beschreibung
                                                                                                                               "<p>Gegenstand der Förderung sind vereinseigene Sportstätten einschließlich Nebenanlagen, die für den unmittelbaren Sportbetrieb der Mitglieder erforderlich sind.</p><p>Gefördert werden der Neubau, Umbau und die Erweiterung von Sportstätten sowie Generalsanierungen und Modernisierungsmaßnahmen. Letztere sind förderfähig, wenn die Neuerrichtung oder letzte Generalsanierung mindestens sechs Jahre zurückliegt oder die Ausgaben mindestens 65.000 Euro betragen.</p><p>Ebenfalls förderfähig ist der Erwerb eines Objekts (ohne Grundstückskosten), sofern dadurch ein notwendiger Neu- oder Erweiterungsbau entbehrlich wird und der Erwerb einschließlich erforderlicher Sanierungen wirtschaftlicher ist als eine entsprechende Baumaßnahme.</p>" ];
                                                                                                             xyz:foerdernehmende         [ xyz:beschreibung     "Antragsberechtigt sind Schützenvereine, die Mitglied des Bayerischen Sportschützenbundes e. V. (BSSB) oder des Oberpfälzer Schützenbundes e. V. (OSB) sind.";
                                                                                                                                           xyz:foerdernehmende  [ xyz:code           "010";
                                                                                                                                                                  xyz:listURI        "urn:xoev-de:stmd:codeliste:foerdernehmende";
                                                                                                                                                                  xyz:listVersionID  "1";
                                                                                                                                                                  xyz:name           ""
                                                                                                                                                                ]
                                                                                                                                         ];
                                                                                                             xyz:foerderrichtlinieUndFoerderprogramm
                                                                                                                     [ xyz:ablaufdatumRichtlinie      "2028-12-31";
                                                                                                                       xyz:geldgebendeInstitutionen   [ xyz:geldgebendeInstitution  [ xyz:code           "003";
                                                                                                                                                                                      xyz:listURI        "urn:xoev-de:stmd:codeliste:geldgebende-institution";
                                                                                                                                                                                      xyz:listVersionID  "1";
                                                                                                                                                                                      xyz:name           ""
                                                                                                                                                                                    ]
                                                                                                                                                      ];
                                                                                                                       xyz:handlungsgrundlagen        [ xyz:verweis  [ xyz:bezeichnung  "Richtlinien über die Gewährung von Zuwendungen des Freistaates Bayern zur Förderung des organisierten Sports (Sportförderrichtlinien - SportFöR)";
                                                                                                                                                                       xyz:link         "https://www.gesetze-bayern.de/Content/Document/BayVV_2273_I_13469"
                                                                                                                                                                     ]
                                                                                                                                                      ];
                                                                                                                       xyz:kummulierbareFoerderungen  [ xyz:voraussetzungen
                                                                                                                                         "Auch bei Kumulierung von Förderungen hat der Verein einen Eigenanteil zu erbringen, der nicht unter zehn Prozent der zuwendungsfähigen Ausgaben liegen darf." ];
                                                                                                                       xyz:programmlaufzeit           [ xyz:beginnLaufzeitFoerderprogramm
                                                                                                                                                                "2023-01-01";
                                                                                                                                                        xyz:endeLaufzeitFoerderprogramm
                                                                                                                                                                "2028-12-31"
                                                                                                                                                      ];
                                                                                                                       xyz:programmtitel              "Sportförderung";
                                                                                                                       xyz:verantwortlichesFachreferat
                                                                                                                               "Sachgebiet H2 (Sportförderung)";
                                                                                                                       xyz:verantwortlichesMinisterium
                                                                                                                               "Staatsministerium des Innern, für Sport und Integration"
                                                                                                                     ];
                                                                                                             xyz:foerdervoraussetzungen  [ xyz:ausschlusskriterien  "<p>Von der Förderung ausgenommen sind die Teilsanierung von Bauteilen, der laufende Bauunterhalt sowie Maßnahmen, die durch mangelhaften Bauunterhalt verursacht wurden. Ferner werden Maßnahmen mit zuwendungsfähigen Ausgaben unter 10.000 Euro nicht gefördert.</p>";
                                                                                                                                           xyz:buergerfreundlicheBeschreibung
                                                                                                                                                   "<p>Eine Förderung ist nur im Rahmen des nachgewiesenen sportfachlichen Bedarfs zulässig. Der Bedarfsnachweis soll in der Regel durch eine Darstellung des geplanten Sportbetriebs, der erwarteten Teilnehmerzahlen, der dem Verein ansonsten zur Verfügung stehenden Einrichtungen sowie der geplanten Auslastung der Sportstätte durch den eigenen Vereinssport geführt werden.&nbsp;</p><p>Der antragstellende Verein muss der Träger aller beantragten Baumaßnahmen sein sowie grundsätzlich über ein Eigentums- bzw. Erbbaurecht an den Förderobjekten verfügen. In wenigen Fällen genügt anstelle des Eigentums- bzw. Erbbaurecht ein langfristiges Nutzungsrecht. Ab Fertigstellung der Anlage müssen dem Verein das Nutzungs- sowie das Hausrecht auf die Dauer von mindestens 25 Jahren uneingeschränkt, unkündbar und unabdingbar eingeräumt werden. Die allgemein gültigen zuwendungsrechtlichen Bestimmungen der Verwaltungsvorschriften zu den Artikeln 23 und 44 der bayerischen Haushaltsordnung (BayHO) finden Anwendung. Dem Verein kann eine Zuwendung nur gewährt werden, sofern die Bewilligung der Maßnahme vor dem Baubeginn erfolgt ist. Der Verein muss einen Eigenanteil erbringen, der nicht unter zehn Prozent der zuwendungsfähigen Ausgaben liegen darf.</p>"
                                                                                                                                         ];
