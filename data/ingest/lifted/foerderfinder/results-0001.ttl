                                                                                                                                                                    xyz:email                 "niederlassungspraemie@lfp.bayern.de";
                                                                                                                                                                    xyz:name                  "Bayerisches Landesamt für Pflege - Hebammenniederlassungsprämie";
                                                                                                                                                                    xyz:organisationseinheit  [ xyz:code           "002";
                                                                                                                                                                                                xyz:listURI        "urn:xoev-de:stmd:codeliste:organisationseinheit";
