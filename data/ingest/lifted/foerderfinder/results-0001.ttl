                                                                                                                                                               ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergebiet           [ xyz:laender  [ xyz:land  [ xyz:code           "BY";
                                                                                                                                                                      xyz:listURI        "urn:xoev-de:pks:codeliste:bundesland";
                                                                                                                                                                      xyz:listVersionID  "1";
                                                                                                                                                                      xyz:name           "Bayern"
                                                                                                                                                                    ]
                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergegenstand       [ xyz:beschreibung
                                                                                                                               "<p>Aus Mitteln des Art. 13c Abs. 1 BayFAG können gefördert werden die notwendigen Baumaßnahmen zur Beseitigung von durch Elementarschadensereignisse verursachte Schäden an nach dieser Vorschrift förderfähigen</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">Kreis- und Gemeindestraßen,</li>\n  <li class=\"unordered-list-item--dash\">Ortsdurchfahrten im Zuge von Bundes-, Staats- und Kreisstraßen in der Baulast von Gemeinden, sowie Gehwege und/oder Radwege, wenn deren Baulast nach § 5 Abs. 3 FStrG oder Art. 42 Abs. 3 BayStrWG bei der Gemeinde liegt,</li>\n  <li class=\"unordered-list-item--dash\">unselbstständigen Geh- und Radwegen an Bundes-, Staats- und Kreisstraßen, soweit die Kosten von Gemeinden getragen werden, weil der Träger der Straßenbaulast die Durchführung auf eigene Kosten ablehnt,</li>\n  <li class=\"unordered-list-item--dash\">selbstständigen Geh- und Radwege im Sinne von Art. 53 Nr. 2 BayStrWG.</li>\n</ul>\n<p>Gefördert wird die Wiederherstellung des ursprünglichen Zustandes unter Berücksichtigung des aktuell notwendigen verkehrlichen und technischen Bedarfs.</p>" ];
