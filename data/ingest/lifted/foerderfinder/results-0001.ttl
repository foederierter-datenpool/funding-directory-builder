                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "Zuwendungsfähig sind die angefallenen Stundenvergütungen für die reine\nDolmetscherleistung und eine Vergütung für eventuelle Reisezeiten der\ndolmetschenden Person. Es sind zuwendungsfähige Höchstbeträge festgelegt.\nEbenfalls zuwendungsfähig sind Ausgaben für Bereitstellungskosten für einen\ntelefonischen Dolmetscherdienst (einschließlich der einmaligen\nEinrichtungskosten), Ausgaben für eine Webcam im notwendigen Umfang und\nAusgaben für Fortbildungsmaßnahmen zur Erweiterung von Kompetenzen für die\nGestaltung eines Beratungssettings mit Dolmetschenden."
                                                                                                                                         ];
                                                                                                             xyz:foerderbereich          [ xyz:foerderbereich  [ xyz:code           "011";
