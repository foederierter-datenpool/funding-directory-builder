                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>f46e90a0-d838-43fe-83d6-c34baab1d10d</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-08-29T16:21:49</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>f46e90a0-d838-43fe-83d6-c34baab1d10d</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>f46e90a0-d838-43fe-83d6-c34baab1d10d</xflb:schluessel>\n         <xflb:versionFLB>3</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-09-27T07:59:49</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>f46e90a0-d838-43fe-83d6-c34baab1d10d</xflb:foerderschluessel>\n                  <xflb:flbVersion>3</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Förderung von Ehrenamt, bürgerschaftliches Engagement und Selbsthilfe in der Pflege</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;In Deutschland wird die überwiegende Zahl von Pflegebedürftigen zu Hause von Angehörigen und nahestehenden Personen gepflegt. Hierbei gelangen häuslich Pflegende oft an die Grenze ihrer physischen und psychischen Belastbarkeit, weshalb der Freistaat Bayern Angebote zur Unterstützung im Alltag fördert, um einer Überforderung entgegenzuwirken. Um unterstützende Angebote weiter auszubauen und neue innovative Konzepte zu entwickeln, fördert Bayern auch den Auf- und Ausbau ehrenamtlicher Strukturen und der Selbsthilfe in der Pflege.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Ehrenamtliche Strukturen, die sich die Unterstützung, Betreuung und Entlastung von Pflegebedürftigen sowie deren An- und Zugehörigen zum Ziel gesetzt haben, können eine Zuwendung im Rahmen einer Projektförderung erhalten.</xflb:teaser>\n                  <xflb:schluesselwoerter>Pflegebedürftige, Ehrenamt, Pflege, Selbsthilfe, Pflege durch Familie, Familie, Sorgenetzwerke</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderprogramme zum Auf- und Ausbau ehrenamtlicher Strukturen und der Selbsthilfe in der Pflege</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/ehrenamtliche-strukturen-und-selbsthilfe/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderprogramme zum Auf- und Ausbau ehrenamtlicher Strukturen und der Selbsthilfe in der Pflege sowie von Modellprojekten zur Erprobung neuer Versorgungskonzepte und Versorgungsstrukturen</xflb:bezeichnung>\n                     <xflb:link>https://www.stmgp.bayern.de/service/foerderprogramme/auf-und-ausbau-ehrenamtlicher-strukturen-und-der-selbsthilfe/</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Landesamt für Pflege</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>4</xflb:hausnummerPostfach>\n                     <xflb:strasse>Mildred-Scheel-Straße</xflb:strasse>\n                     <xflb:postleitzahl>92224</xflb:postleitzahl>\n                     <xflb:ort>Amberg</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>poststelle@lfp.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Bayerisches Landesamt für Pflege</xflb:bezeichnung>\n                     <xflb:link>www.lfp.bayern.de</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>+49 9621 9669-0</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Bayerisches Landesamt für Pflege</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>4</xflb:hausnummerPostfach>\n                           <xflb:strasse>Mildred-Scheel-Straße</xflb:strasse>\n                           <xflb:postleitzahl>92224</xflb:postleitzahl>\n                           <xflb:ort>Amberg</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>poststelle@lfp.bayern.de</xflb:email>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Bayerisches Landesamt für Pflege</xflb:bezeichnung>\n                           <xflb:link>www.lfp.bayern.de</xflb:link>\n                        </xflb:verweis>\n                        <xflb:telefonnummer>+49 9621 9669-0</xflb:telefonnummer>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>eb7bb86e-3b83-4093-8429-e51b578c4a7b</xflb:id>\n                     <xflb:bezeichnung>Förderantrag auf Bewilligung einer staatlichen Zuwendung für ehrenamtliche Strukturen und weitere Angebote nach § 45c SGB XI sowie Teil 8 Abschnitt 6 der Verordnung zur Ausführung der Sozialgesetze (AVSG)</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/dokumente/AUA/Foerderantrag%20Sorgenetzwerke.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>116cc413-9d12-4445-b079-5580f42ed75e</xflb:id>\n                     <xflb:bezeichnung>Musterkonzept Sorgenetzwerke für regionale Alzheimer Gesellschaften</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/wp-content/uploads/2025/03/20250313_Musterkonzept_Sorgenetzwerke_Kontrollkaestchen_final.docx</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>d37dc78e-337a-4e55-b74c-17178dc7a63d</xflb:id>\n                     <xflb:bezeichnung>Förderantrag auf Bewilligung einer staatlichen Zuwendung für Selbsthilfekontaktstellen nach § 45d SGB XI sowie Teil 8 Abschnitt 8 der Verordnung zur Ausführung der Sozialgesetze (AVSG)</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/wp-content/uploads/2024/10/Foerderantrag_SH-Kontaktstellen.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>6a59fc6c-003c-45ce-9a34-a869ec0cd2b7</xflb:id>\n                     <xflb:bezeichnung>Musterkonzept für Selbsthilfekontaktstellen</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/wp-content/uploads/2024/10/Musterkonzept_SH-Kontaktselle.docx</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>c0962384-6b5c-4c4f-beca-812847f3a1a2</xflb:id>\n                     <xflb:bezeichnung>Förderantrag auf Bewilligung einer staatlichen Zuwendung für Selbsthilfeorganisationen und -gruppen nach § 45d SGB XI sowie Teil 8 Abschnitt 8 der Verordnung zur Ausführung der Sozialgesetze (AVSG)</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/wp-content/uploads/2024/10/Foerderantrag_SH-Organisation_SH-Gruppen.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>835fd35e-da83-4e37-927a-b798698c08fb</xflb:id>\n                     <xflb:bezeichnung>Erklärung zum Antrag auf Gewährung einer Förderung als DAWI-De-minimis-Beihilfe nach der Verordnung (EU) Nr. 2023/2832</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/wp-content/uploads/2024/01/DAWI-De-minimis-Erklaerung.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>58848bad-9028-453b-8994-cf5915dca1ce</xflb:id>\n                     <xflb:bezeichnung>Erklärung Subventionserhebliche Tatsachen bzgl. ehrenamtlicher Strukturen</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/wp-content/uploads/2023/03/240821_Erklaerung-Subventionserhebliche-Tatsachen.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>1b30e344-ab42-4328-a9b0-db1d4673c9e9</xflb:id>\n                     <xflb:bezeichnung>Erklärung Subventionserhebliche Tatsachen bzgl. Selbsthilfe</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/wp-content/uploads/2023/03/240821_Erklaerung-Subventionserhebliche-Tatsachen.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>66b9a0d7-56f6-4fa0-a35e-831418989c94</xflb:id>\n                     <xflb:bezeichnung>Ausgabenübersicht</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/wp-content/uploads/2025/11/Ausgabenuebersicht_AA-AUA-SN-SH.xlsx</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>586516c5-631a-4433-8d61-fbcfdae95f18</xflb:id>\n                     <xflb:bezeichnung>Verwendungsnachweis über die staatliche Zuwendung für ehrenamtliche Strukturen</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/dokumente/AUA/Verwendungsnachweis%20Sorgenetzwerke_2025.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>4e88b4d4-5aaf-4ad6-acf9-0c06fa97148d</xflb:id>\n                     <xflb:bezeichnung>Verwendungsnachweis über die staatliche Zuwendung für die Selbsthilfe</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/wp-content/uploads/2024/01/Verwendungsnachweis_Selbsthilfe.pdf</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Gefördert werden können Sorgenetzwerke, Schulungen und Fortbildungen von ehrenamtlich Tätigen, weitere Angebote zum Aus- und Aufbau von Gruppen ehrenamtlich Tätiger und sonstiger zum bürgerschaftlichen Engagement bereiter Personen sowie Angebote der Selbsthilfe in der Pflege.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Zuwendung erfolgt im Rahmen einer Projektförderung.&lt;/p&gt;&lt;p&gt;Die Förderung erfolgt angebotsabhängig zu pauschalierten Sätzen, wie in den Hinweisen zum Vollzug der AVSG Teil 8 Abschnitt 5 bis 8 näher bestimmt.&lt;br&gt;&lt;br&gt;Die Förderung ehrenamtlicher Strukturen und weiterer Angebote nach § 45c SGB XI&amp;nbsp;erfolgt zu gleichen Teilen durch den Freistaat Bayern und die kommunale Gebietskörperschaft einerseits sowie die soziale und private Pflegeversicherung andererseits. Die soziale und private Pflegeversicherung verdoppelt also die Förderung des Freistaats Bayern und der kommunalen Gebietskörperschaft.&lt;/p&gt;&lt;p&gt;Die Förderung der Selbsthilfe nach § 45d SGB XI erfolgt zu 25% durch den Freistaat Bayern und die kommunale Gebietskörperschaft sowie zu 75% durch die soziale und private Pflegeversicherung. Die soziale und private Pflegeversicherung verdreifacht also den Betrag, den der Freistaat Bayern und die kommunale Gebietskörperschaft für die Förderung der Selbsthilfe nach § 45d SGB XI bereitstellen.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Gefördert werden können die Kosten des Angebots.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerFest>\n                        <xflb:jahre>1</xflb:jahre>\n                     </xflb:dauerFest>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n               <xflb:euBeihilferelevanz>Die Prüfung der Freistellung der Fördermaßnahme von der Anmeldepflicht bei der EU-Kommission erfolgt im Rahmen der Antragsbearbeitung durch die Bewilligungsbehörde.</xflb:euBeihilferelevanz>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Gesundheit, Pflege und Prävention</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>§ 45c Abs. 1 Satz 1 Nr. 2 und Abs. 4 und § 45d Sozialgesetzbuch (SGB) - Elftes Buch (XI)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-im-internet.de/sgb_11/BJNR101500994.html#BJNR101500994BJNG004403301</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Verordnung zur Ausführung der Sozialgesetze (AVSG) - Teil 8 Abschnitt 6 bis 8</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayAVSG-G8_6</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Hinweise zum Vollzug der AVSG Teil 8 Abschnitt 5 bis 8</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_861_G_10013</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat 42</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Ehrenamt, bürgerschaftliches Engagement und Selbsthilfe; Beantragung einer Förderung</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2026-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2025-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2026-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert werden können Sorgenetzwerke, Schulungen und Fortbildungen von ehrenamtlich Tätigen sowie weitere Angebote zum Aus- und Aufbau von Gruppen ehrenamtlich Tätiger sowie sonstiger zum bürgerschaftlichen Engagement bereiter Personen.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Die einzelnen Voraussetzungen für die Anerkennung und Förderung solcher Angebote sind in Teil 8 Abschnitt 6 und 8 der AVSG und den Hinweisen zum Vollzug der AVSG Teil 8 Abschnitt 5 bis 8 geregelt. Abhängig von der Art des Angebots ist die Erfüllung jeweiliger Qualifizierungs- und Qualitätskriterien nachzuweisen.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.lfp.bayern.de/dokumente/AUA/Foerderantrag%20Sorgenetzwerke.pdf</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Der Antrag auf Förderung ist schriftlich oder elektronisch beim Bayerischen Landesamt für Pflege zu stellen. Die bereitgestellten Vordrucke sind zu verwenden.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>005</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>&lt;p&gt;Die Zustimmung zum vorzeitigen Maßnahmebeginn gilt mit der Antragstellung allgemein als erteilt.&lt;/p&gt;</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristdatum>2026-12-31</xflb:fristdatum>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Die Antragstellung muss in der Regel bis 31.12. des dem Förderjahr vorangehenden Jahres erfolgt sein.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>ggf. Satzung und Vereinsregisterauszug</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Nachweis des Versicherungsschutzes</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Schulung und Fortbildung (der ehrenamtlichen Helferinnen und Helfer)</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Gegen den Zuwendungsbescheid können Sie innerhalb eines Monats Klage erheben. Das zuständige Gericht, bei dem Sie Klage einreichen können, wird Ihnen im Bescheid mitgeteilt.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_185  [ xyz:attributes  [ xyz:antragsstellung      "https://www.lfar.bayern.de/lfar_im_ueberblick/aufgabenbereiche/freiwilligerueckkehr/index.html";
                                xyz:begriffeImKontext    [ rdf:_1  "Freiwillige Rückkehr";
                                                           rdf:_2  "Rückkehrvorbereitung";
                                                           rdf:_3  "Reintegrationsvorbereitung"
                                                         ];
                                xyz:beschreibung         "<p>Durch die staatliche Förderung von Rückkehr- und Reintegrationsprojekten sollen ausreisewillige Personen motiviert werden, den Entschluss zur Rückkehr in das jeweilige Heimatland freiwillig und nach möglichst kurzem Aufenthalt in Deutschland zu treffen. Ein umfassendes Angebot von Unterstützungsleistungen in allen für die Rückkehr relevanten Anliegen soll eine Rückkehr in Würde ermöglichen.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Anteilsfinanzierung/Kapitalbeteiligung" ];
                                xyz:foerderbereich       [ rdf:_1  "Arbeit" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Kommunen";
                                                           rdf:_2  "Verbände";
                                                           rdf:_3  "Vereine"
                                                         ];
                                xyz:foerderprogramm      "Projekte zur Förderung der Freiwilligen Rückkehr aus Bayern, zur Reintegration sowie zur Rückkehr- und Reintegrationsvorbereitung";
                                xyz:foerderzeitraum.bis  "2026-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2026-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "215fb07e-d9ae-4d01-8510-1c0566e2b467";
                                xyz:teaser               "Der Freistaat Bayern fördert Projekte, die die freiwillige Ausreise, insbesondere ausreisepflichtiger ausländischer Staatsangehöriger, in ihr Herkunftsland oder einen aufnahmebereiten Drittstaat unterstützen.";
                                xyz:titel                "Projektförderung zur freiwilligen Rückkehr aus Bayern, zur Reintegration sowie zur Rückkehr- und Reintegrationsvorbereitung";
                                xyz:titel.tokens         [ rdf:_1  "Projektförderung zur freiwilligen Rückkehr aus Bayern";
                                                           rdf:_2  "zur Reintegration sowie zur Rückkehr- und Reintegrationsvorbereitung"
                                                         ];
                                xyz:voraussetzung        "<p>Das Projekt muss dem Bedarf des Freistaats Bayern im Bereich der Freiwilligen Rückkehr entsprechen und geeignet sein, nachweisbar und effektiv die freiwillige Rückkehr aus Bayern zu intensivieren.</p>"
                              ];
