                                                         ];
                                xyz:beschreibung         "<p>Der Kurs hat das Ziel, dass Jugendliche befähigt werden, den erfolgreichen Abschlusses der Mittelschule bzw. des Qualifizierenden Abschlusses der Mittelschule anzustreben.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Aus und Weiterbildung" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Kommunen";
                                                           rdf:_2  "Vereine";
