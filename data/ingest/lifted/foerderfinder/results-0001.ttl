                                                                                                                       xyz:kummulierbareFoerderungen  [ xyz:beschreibungAusschluss  "<p>Schulen mit weniger als <strong>14 Schülerinnen und Schülern</strong> erhalten keinen Zuschuss.</p>";
                                                                                                                                                        xyz:voraussetzungen         "<p>Wird im Einzelfall durch die örtlich zuständige Regierung im Rahmen der Antragsbearbeitung geprüft.</p>"
                                                                                                                                                      ];
