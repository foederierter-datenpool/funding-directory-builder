                                                                                                                                                                    xyz:zuwendungszweck    "<p>Der Kurs hat das Ziel, dass Jugendliche befähigt werden, den erfolgreichen Abschlusses der Mittelschule bzw. des Qualifizierenden Abschlusses der Mittelschule anzustreben.</p>"
                                                                                                                                                                  ];
