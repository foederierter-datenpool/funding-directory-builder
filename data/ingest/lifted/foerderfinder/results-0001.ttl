                                                                                                                                           xyz:erforderlicheUnterlagen  [ xyz:dokument  [ rdf:_1  [ xyz:bezeichnung  "Der Antrag auf Förderung ist einzureichen beim Landesamt für Gesundheit und Lebensmittelsicherheit mit dem auf der Internetseite des Landesamts bereitgestellten Antragsformular. Dem Antrag sind beizufügen" ];
