                                                                                                                                           xyz:zustaendigeStelle  [ xyz:zustaendigeStelleDetails  [ xyz:zustaendigeStelleInformationen
                                                                                                                                                                                      "Für die Antragstellung ist die untere Naturschutzbehörde bei Ihrem zuständigen Landratsamt bzw. Ihrer kreisfreien Stadt zu kontaktieren, die Bewilligung erfolgt durch die höhere Naturschutzbehörde an der Bezirksregierung." ]
                                                                                                                                                                  ]
                                                                                                                                         ];
                                                                                                             xyz:antragsinformationen    [ xyz:antragsfrist             [ xyz:bemerkung             "Die Antragstellung findet aktuell in jährlich mehreren Phasen - Sommer bzw. Winter - statt. Die Frist für die aktuelle Antragstellung der Sommermaßnahmen 2026 läuft bis zum 27.03.2026.\nDie Wintermaßnahmen 2026 können anschließend bis zum Fristablauf 24.07.2026 beantragt werden.";
