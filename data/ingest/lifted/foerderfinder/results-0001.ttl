                                xyz:xml   "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           produkt=\"Förderfinder\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produktversion=\"\"\n                                           standard=\"XFLB\"\n                                           test=\"\"\n                                           version=\"2.0.0\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0 xflb.xsd\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>86649b76-f78e-484a-8071-003ae4b99016</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-06-14T09:24:10</xflb:erstellungszeitpunkt>\n      <xflb:sender>Förderfinder Suche (Bayern)</xflb:sender>\n      <xflb:empfaenger>XFLB-Connect (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>86649b76-f78e-484a-8071-003ae4b99016</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>86649b76-f78e-484a-8071-003ae4b99016</xflb:schluessel>\n         <xflb:versionFLB>3</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>86649b76-f78e-484a-8071-003ae4b99016</xflb:foerderschluessel>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n                  <xflb:flbVersion>3</xflb:flbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400012017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"1\">\n                        <code>4</code>\n                        <name>Regelungskompetenz auf Landesebene</name>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Feuerwehr; Beantragung einer staatlichen Förderung für den Bau von Feuerwehrhäusern</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:teaser>Der Freistaat Bayern unterstützt die bayerischen Kommunen  beim Bau von Feuerwehrhäusern mit staatlichen Zuwendungen.</xflb:teaser>\n                  <xflb:schluesselwoerter>BayernPortal, beantragung, feuerwehrfahrzeugförderung, geräte, feuerwehren, förderung, staatlich, feuerwehrfahrzeugen, feuerwehr, beschaffung, bau, feuerwehrhäusern, feuerwehrgerätehausförderung, feurwehrförderung, Feuerwehr Beantragung einer staatlichen Förderung für die Beschaffung von Feuerwehrfahrzeugen und geräten sowie den Bau von Feuerwehrhäusern, sowie</xflb:schluesselwoerter>\n                  <xflb:zuwendungszweck>&lt;p&gt;Die staatliche Förderung soll es den Kommunen ermöglichen, die für den abwehrenden Brandschutz und den technischen Hilfsdienst im Sinne des Bayerischen Feuerwehrgesetzes (BayFwG) beschafften Fahrzeuge und Ausrüstungsgegenstände in Feuerwehrhäusern und in Feuerwachen unterzubringen.&lt;/p&gt;</xflb:zuwendungszweck>\n               </xflb:beschreibung>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayer. Staatsministerium des Innern, für Sport und Integration; Sachgebiet D1, Allgemeine Angelegenheiten der Feuerwehren; Kaminkehrerwesen</xflb:name>\n                  <xflb:telefonnummer>089 / 21 92 01</xflb:telefonnummer>\n                  <xflb:email>poststelle@stmi.bayern.de</xflb:email>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n                  <xflb:adresse>\n                     <xflb:strasse>Odeonsplatz</xflb:strasse>\n                     <xflb:hausnummerPostfach>3</xflb:hausnummerPostfach>\n                     <xflb:postleitzahl>80539</xflb:postleitzahl>\n                     <xflb:ort>München</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:verweis>\n                     <xflb:link>https://www.innenministerium.bayern.de/</xflb:link>\n                     <xflb:bezeichnung>Homepage Bayerisches Innenministerium</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Ihre zuständige Regierung</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.bayernportal.de/dokumente/leistung/68554259279?localize=false</xflb:link>\n                     <xflb:bezeichnung>Feuerwehr; Beantragung einer staatlichen Förderung für die Beschaffung von Feuerwehrfahrzeugen und -geräten sowie den Bau von Feuerwehrhäusern</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>Die Fördervoraussetzungen sind in den einschlägigen Zuwendungsrichtlinien und\nden allgemeinen haushaltsrechtlichen Bestimmungen enthalten.\n\nGefördert werden Maßnahmen insbesondere nur dann, wenn sie für die Erfüllung der kommunalen Pflichtaufgaben im abwehrenden Brandschutz und im technischen Hilfsdienst geeignet sind, die Leistungsfähigkeit der Feuerwehr aufrechtzuerhalten oder zu verbessern. Die zur Förderung beantragten Maßnahmen müssen ferner notwendig und wirtschaftlich sein</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>Förderfähig sind ausschließlich kommunale Maßnahmen im Feuerwehrwesen</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name>Bayern</name>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium des Innern, für Sport und Integration</xflb:verantwortlichesMinisterium>\n               <xflb:programmtitel>Richtlinien für Zuwendungen des Freistaates Bayern zur Förderung des kommunalen Feuerwehrwesens, Feuerwehr-Zuwendungsrichtlinien, FwZR</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2027-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:verantwortlichesFachreferat>Sachgebiet D1</xflb:verantwortlichesFachreferat>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2153_I_14931</xflb:link>\n                     <xflb:bezeichnung>Richtlinien für Zuwendungen des Freistaats Bayern zur Förderung des kommunalen Feuerwehrwesens (Feuerwehr-Zuwendungsrichtlinien - FwZR) (Stand 23.12.2024)</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Resource?path=resources%2fBayVV_2153_I_14931_BayVV2153-I-14931-Anhang-001.PDF</xflb:link>\n                     <xflb:bezeichnung>Anlage 1 der Richtlinien für Zuwendungen des Freistaats Bayern zur Förderung des kommunalen Feuerwehrwesens (Feuerwehr-Zuwendungsrichtlinien - FwZR) (Stand 23.12.2024))</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Resource?path=resources%2fBayVV_2153_I_14931_BayVV2153-I-14931-Anhang-002.PDF</xflb:link>\n                     <xflb:bezeichnung>Anlage 2 der Richtlinien für Zuwendungen des Freistaats Bayern zur Förderung des kommunalen Feuerwehrwesens (Feuerwehr-Zuwendungsrichtlinien - FwZR) (Stand 23.12.2024))</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2025-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2027-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n               <xflb:kummulierbareFoerderungen>\n                  <xflb:voraussetzungen>Werden für ein Vorhaben neben der Förderung aus Feuerschutzsteuermitteln nach den FwZR ausnahmsweise auch Fördermittel in Anspruch genommen, die zu einem anderen als dem unmittelbar mit den FwZR verfolgten Förderzweck bereitgestellt sind, die Kommunen bei der Sicherstellung von abwehrendem Brandschutz und technischem Hilfsdienst zu unterstützen, ist das grundsätzlich zugelassen.  Beispiele dafür sind: Förderungen im Bereich Energieeffizienz und erneuerbare Energien, Förderung der Elektromobilität oder zum Klimaschutz, auch aus Programmen der im Auftrag der Staatsregierung tätigen Förderbanken und des Förderinstituts BayernLabo.</xflb:voraussetzungen>\n                  <xflb:beschreibungAusschluss>grundsätzlicher Ausschluss der Förderung, wenn für eine Maßnahme neben Mitteln nach den FwZR auch andere Mittel des Freistaates Bayern in Anspruch genommen werden (siehe Nr. 4.7 der Fördergrundsätze der Staatsregierung).</xflb:beschreibungAusschluss>\n               </xflb:kummulierbareFoerderungen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.bayernportal.de/dokumente/onlineservice/21329684787?</xflb:linkZurAntragsstellung>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Stellungnahme des Kreisbrandrats</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Aussage des Kreisbrandrats zur fachlichen Notwendigkeit des beantragten Fördergegenstands unter Berücksichtigung der Ausstattung anderer Feuerwehren der Gemeinde und benachbarter Feuerwehren</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Bauunterlagen: Übersichtsplan (Maßstab 1 : 5 000); Lageplan (Maßstab 1 : 1 000); Baupläne, aus denen sich Art und Umfang des Bauvorhabens nachprüfbar ergeben (Grundrisse, Ansichten, Schnitte),</xflb:bezeichnung>\n                     <xflb:erlaeuterung>bei Baumaßnahmen für Feuerwehrhäüser und Feuerwachen vorzulegende Bauunterlagen</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>Einen entsprechenden Förderantrag (siehe unter \"Formulare\") kann eine Kommune\nbei der für sie zuständigen Regierung (= zuständige Förderbehörde) stellen.\nDem Förderantrag ist eine fachliche Stellungnahme des zuständigen Kreis- bzw.\nStadtbrandrats oder Leiters der Berufsfeuerwehr beizufügen.\n\nBei Bedarf ist eine fachliche Beratung der Kommunen durch die örtlich\nzuständigen Stadt- und Kreisbrandräte sowie durch die Fachberater für Brand-\nund Katastrophenschutz bei den Regierungen sichergestellt.</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                     <name/>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:wochen>3</xflb:wochen>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:wochen>12</xflb:wochen>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n            </xflb:antragsinformationen>\n            <xflb:finanzierung>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>Festbetragsförderung</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>Neubau, Ersatzerrichtung und Erweiterung von Feuerwehrhäusern und Feuerwachen</xflb:zuwendungsfaehigeKosten>\n               <xflb:euBeihilferelevanz>unzutreffend</xflb:euBeihilferelevanz>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:zuwendungsart>\n            </xflb:finanzierung>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Die Förderung soll den Kommunen die Unterbringung der für den abwehrenden Brandschutz und den technischen Hilfsdienst im Sinne des Bayerischen Feuerwehrgesetzes (BayFwG) beschafften Fahrzeuge und Ausrüstung in Feuerwehrhäusern ermöglichen.&lt;/p&gt;\n&lt;p&gt;Gefördert werden der Neubau, die Generalsanierung bzw. die Ersatzerrichtung von Feuerwehrhäusern und Feuerwachen und deren Erweiterung um weitere notwendige Stellplätze. Zudem werden als besondere Einrichtungen in Feuerwehrhäusern und Feuerwachen auch der Bau von Schlauchpflegeeinrichtungen, Atemschutzwerkstätten und Atemschutzübungsanlagen sowie die dazu gehörenden Geräteausstattungen gefördert.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name>Kommunen</name>\n               </xflb:foerdernehmende>\n            </xflb:foerdernehmende>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-06-14T09:24:10</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>\n"
                              ]
            ];
  rdf:_114  [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index";
