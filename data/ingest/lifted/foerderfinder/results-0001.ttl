                                                                                                                                           xyz:erforderlicheUnterlagen  [ xyz:dokument  [ rdf:_1  [ xyz:bezeichnung  "Bei Erstantrag oder eingetretenen Änderungen können folgende Unterlagen erforderlich sein:" ];
                                                                                                                                                                                          rdf:_2  [ xyz:bezeichnung  "Vereinssatzung, Gesellschaftsvertrag oder entsprechende Verträge" ];
                                                                                                                                                                                          rdf:_3  [ xyz:bezeichnung  "Nachweis über die Eigenschaft als staatlich geförderter Frauenhausträger oder über Zugehörigkeit zu einem Spitzenverband, der in der Landesarbeitsgemeinschaft der freien Wohlfahrtspflege Bayern Mitglied ist" ];
                                                                                                                                                                                          rdf:_4  [ xyz:bezeichnung  "wenn Antragssteller nicht selbst Frauenhausträger ist: Kooperationsvereinbarung mit Frauenhaus" ];
