                                                                                                                       xyz:kummulierbareFoerderungen  [ xyz:voraussetzungen
                                                                                                                                         "<p>Kommt für eine Baumaßnahme neben einer Zuweisung nach Art. 10 BayFAG eine weitere Zuwendung eines anderen Zuwendungsgebers in Betracht, gilt Folgendes zu beachten:&nbsp;</p><ul><li class=\"unordered-list-item--dash\">Eine Kumulierung ist im Bereich der Förderung nach Art. 10 BayFAG grundsätzlich möglich, sofern der Zuweisungsempfänger noch keinen Bewilligungsbescheid für Zuweisungen nach Art. 10 BayFAG erhalten hat und angibt, dass er eine zusätzliche Zuwendung aus einem anderen Förderprogramm erhält oder beantragt.&nbsp;</li><li class=\"unordered-list-item--dash\">Wird die zusätzliche Zuwendung zu denselben Ausgaben gewährt, ist darauf zu achten, dass der Kommune mindestens ein Eigenanteil von 10 % der zuweisungsfähigen Ausgaben verbleibt.</li></ul>" ];
                                                                                                                       xyz:programmlaufzeit           [ xyz:beginnLaufzeitFoerderprogramm
                                                                                                                                                                "2026-01-01";
                                                                                                                                                        xyz:endeLaufzeitFoerderprogramm
                                                                                                                                                                "2030-12-31";
                                                                                                                                                        xyz:verlaengerungsoption  "Die Förderung erfolgt im Rahmen der verfügbaren Haushaltsmittel grundsätzlich zeitlich unbefristet"
                                                                                                                                                      ];
                                                                                                                       xyz:programmtitel              "Förderung kommunaler Hochbaumaßnahmen nach Art. 10 BayFAG";
                                                                                                                       xyz:verantwortlichesFachreferat
                                                                                                                               "Referat 62";
                                                                                                                       xyz:verantwortlichesMinisterium
                                                                                                                               "Staatsministerium der Finanzen und für Heimat"
                                                                                                                     ];
                                                                                                             xyz:foerdervoraussetzungen  [ xyz:ausschlusskriterien  "<p>Nicht nach Art. 10 BayFAG förderfähig sind:&nbsp;</p><ul><li class=\"unordered-list-item--dash\">Maßnahmen der laufenden Instandhaltung (Erhaltungsaufwand) und Kosten des laufenden Betriebs.&nbsp;</li><li class=\"unordered-list-item--dash\">Kleine Baumaßnahmen mit zuweisungsfähigen Ausgaben von unter 100.000 €.&nbsp;</li><li class=\"unordered-list-item--dash\">Bereits begonnene oder abgeschlossene Baumaßnahmen.</li></ul>";
                                                                                                                                           xyz:buergerfreundlicheBeschreibung
                                                                                                                                                   "<ul><li class=\"unordered-list-item--dash\">Das Vorhaben muss schulaufsichtlich genehmigt sein.</li><li class=\"unordered-list-item--dash\">Die Gesamtfinanzierung muss gesichert sein. Die Kommune muss in der Lage sein, die notwendigen Eigenmittel aufzubringen und auch die zu erwartenden Folgekosten in der Zukunft zu finanzieren.</li><li class=\"unordered-list-item--dash\">Zuweisungen nach Art. 10 BayFAG dürfen nur für Maßnahmen gewährt werden, die noch nicht begonnen worden sind.</li><li class=\"unordered-list-item--dash\">Maßnahmen können nur gefördert werden, wenn deren zuweisungsfähige Ausgaben die Bagatellgrenze von 100.000 € überschreiten.</li><li class=\"unordered-list-item--dash\">Durch Elementarschadensereignisse verursachte Schäden sowie Maßnahmen zur Umsetzung von Barrierefreiheit sind förderfähig, wenn deren zuweisungsfähige Ausgaben mindestens 25.000 € betragen.</li><li class=\"unordered-list-item--dash\">Das geförderte Objekt muss grundsätzlich mindestens&nbsp;25 Jahre entsprechend dem Zuweisungszweck verwendet werden. Abweichend&nbsp;hiervon ist die Errichtung temporärer Bauten förderfähig, wenn deren Nutzung für mindestens zehn Jahre gesichert und der Bedarf hierfür festgestellt ist.</li><li class=\"unordered-list-item--dash\">Bei kürzerer Nutzungszeit ist ein zeitanteiliger Betrag zurückzuerstatten, es sei denn, das Projekt wird für andere förderfähige kommunale Zwecke oder zur Erfüllung anderer kommunaler Aufgaben des Zuweisungsempfängers verwendet und es werden hieraus keine Einnahmen erzielt.</li><li class=\"unordered-list-item--dash\">Werden für ein Vorhaben neben der Förderung nach Art. 10 BayFAG auch andere Zuweisungen zu denselben zuweisungsfähigen Ausgaben gewährt, ist bei der Festsetzung des Fördersatzes zu berücksichtigen, dass dem Zuweisungsempfänger ein Eigenanteil von mindestens 10 % der zuweisungsfähigen Ausgaben verbleibt.</li></ul>"
                                                                                                                                         ];
