                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>f66be0a5-f6cb-411f-8770-f00baab7432e</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2026-01-21T17:16:51</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>f66be0a5-f6cb-411f-8770-f00baab7432e</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>f66be0a5-f6cb-411f-8770-f00baab7432e</xflb:schluessel>\n         <xflb:versionFLB>1</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-01-21T17:16:51</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>f66be0a5-f6cb-411f-8770-f00baab7432e</xflb:foerderschluessel>\n                  <xflb:flbVersion>1</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99148126017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Eigenwohnraumförderung -  Bayerisches Zinsverbilligungsprogramm</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Die Förderung soll dazu beitragen, Wohnungssuchenden die Bildung von Wohneigentum durch den Bau oder Erwerb eines Hauses oder einer Eigentumswohnung zu eigenen Wohnzwecken (= Selbstnutzung, Art. 3 Abs. 1 Satz 4 des Bayerischen Wohnraumförderungsgesetzes, BayWoFG) zu ermöglichen.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Staat fördert das Schaffen oder den Erwerb von Eigenwohnraum (eigenes Haus oder Eigentumswohnung zur Eigennutzung).</xflb:teaser>\n                  <xflb:schluesselwoerter>Förderung Eigenwohnungen, Eigenheime, Eigenwohnraumförderung, eigenes Haus, Wohnungsbauförderung, Wohnraumförderung, Eigentumswohnungen, Wohnbauförderung</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderung von Wohneigentum</xflb:bezeichnung>\n                     <xflb:link>http://www.bauen.bayern.de/wohnen/foerderung/wohneigentum/index.php</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Ihre Kreisverwaltungsbehörde</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>7556a9b7-18c0-4e26-8e2f-e3ce7c0a0c84</xflb:id>\n                     <xflb:bezeichnung>Antrag \"Eigenwohnraum und Mietwohnraum im Zweifamilienhaus\" - Stabau Ia</xflb:bezeichnung>\n                     <xflb:link>http://www.stmb.bayern.de/assets/stmi/wohnen/foerderung/31_wohneigentum_stabau_ia.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>5dbdb0e5-11e9-43ef-93fb-549d5e40e261</xflb:id>\n                     <xflb:bezeichnung>Erläuterungen zum Ausfüllen des Antrags \"Eigenwohnraum und Mietwohnraum im Zweifamilienhaus\" - Stabau Ia</xflb:bezeichnung>\n                     <xflb:link>http://www.stmb.bayern.de/assets/stmi/wohnen/foerderung/31_wohneingentum_stabau_ia_erl.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>d983ac60-8e68-4c10-a4b5-32ed9a952064</xflb:id>\n                     <xflb:bezeichnung>Einkommenserklärung des Antragstellers (Stabau III a)</xflb:bezeichnung>\n                     <xflb:link>https://www.stmb.bayern.de/assets/stmi/wohnen/foerderung/antrag_stabau_iiia.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>9d1b6377-7afe-4c64-a425-46da9278a6e5</xflb:id>\n                     <xflb:bezeichnung>Einkommenserklärung für weitere Haushaltsangehörige (Stabau III b)</xflb:bezeichnung>\n                     <xflb:link>http://www.stmb.bayern.de/assets/stmi/wohnen/wohnberechtigungundrecht/antrag_stabau_iiib_mai_2018.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>6063fd81-fcde-4967-bd69-c4ca16ce47ad</xflb:id>\n                     <xflb:bezeichnung>Erläuterungen zur Einkommenserklärung des Antragstellers und weiterer Haushaltsangehörigen</xflb:bezeichnung>\n                     <xflb:link>https://www.stmb.bayern.de/assets/stmi/wohnen/erlaeuterungen_stabau_iiia_iiib.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>bfba03ac-5b81-46d7-ba4d-af80155e5917</xflb:id>\n                     <xflb:bezeichnung>Nachweis \"Einnahmen- und Ausgabenübersicht für geförderte Wohngebäude\" - Stabau IV</xflb:bezeichnung>\n                     <xflb:link>http://www.bauen.bayern.de/assets/stmi/wohnen/iic1_foerderung_nachweis_einnahmen_ausgaben_20130313.doc</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>10458dd2-4813-4f53-9001-2643f2bfc752</xflb:id>\n                     <xflb:bezeichnung>Ratenabruf - Bayerisches Wohnungsbauprogramm beziehungsweise Zinsverbilligungsprogramm, Neubau und Ersterwerb - RA 1</xflb:bezeichnung>\n                     <xflb:link>https://www.bauen.bayern.de/assets/stmi/wohnen/wohneigentum_ra1.docx</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>6593d385-75ce-46ca-ba5e-c26d779559ce</xflb:id>\n                     <xflb:bezeichnung>Ratenabruf - Bayerisches Wohnungsbauprogramm beziehungsweise Zinsverbilligungsprogramm, Zweiterwerb - RA 2</xflb:bezeichnung>\n                     <xflb:link>https://www.bauen.bayern.de/assets/stmi/wohnen/wohneigentum_ra2.docx</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>2ce991df-fbcd-472b-b320-7460faafe975</xflb:id>\n                     <xflb:bezeichnung>Ratenabruf - Bayerisches Wohnungsbauprogramm, Gebäudeänderung und Gebäudeerweiterung - RA 3</xflb:bezeichnung>\n                     <xflb:link>http://www.bauen.bayern.de/assets/stmi/wohnen/iic1_wohneigentum_ra3.doc</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n               <xflb:onlinedienste>\n                  <xflb:onlinedienst>\n                     <xflb:id>67443697-39ea-47b2-a6c2-02dae0ccafc1</xflb:id>\n                     <xflb:bezeichnung>Online Beantragung über das Serviceportal der BayernLabo</xflb:bezeichnung>\n                     <xflb:link>https://banking.bayernlb.de/bayernlabo_fl/mini-lotse/</xflb:link>\n                     <xflb:beschreibung>Über das Serviceportal der BayernLabo können Förderanträge online verwaltet und online gestellt werden.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n               </xflb:onlinedienste>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Zuwendungsempfänger sind Privatpersonen.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>002</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Im Zinsverbilligungsprogramm erfolgt die Förderung mit einem zinsverbilligten Darlehen mit bis zu einem Drittel der Gesamtkosten. Zudem kann in Verbindung mit dem Darlehen ein Kinderzuschuss in Höhe von 5.000 Euro je Kind gewährt werden.&amp;nbsp;&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Beim Bau von Wohnraum sind die Gesamtkosten im Sinn der §§ 5 bis 8 Verordnung über wohnungswirtschaftliche Berechnungen nach dem Zweiten Wohnungsbaugesetz (Zweite Berechnungsverordnung - II. BV) (= Grundstücks- Bau- und Baunebenkosten) förderfähig.&lt;/p&gt;&lt;p&gt;Beim Erwerb von Wohnraum sind der Kaufpreis sowie die Erwerbskosten; bei einem Zweiterwerb (= gebrauchter Wohnraum) sind darüber hinaus die Kosten von erforderlichen Modernisierungs- und Instandsetzungsmaßnahmen förderfähig.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Wohnen, Bau und Verkehr</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Gesetz über die Wohnraumförderung in Bayern (Bayerisches Wohnraumförderungsgesetz - BayWoFG)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayWoFG</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Wohnraumförderungsbestimmungen 2023 (WFB 2023)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2330_B_13734/true</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Bayerisches Zinsverbilligungsprogramm zur Förderung von Eigenwohnraum</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVwV97112</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat 31</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Eigenwohnraum</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2026-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2023-05-13</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2027-01-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Der Staat fördert im Rahmen des Bayerischen Zinsverbilligungsprogramms zur Förderung von Eigenwohnraum&amp;nbsp;das Schaffen oder den Erwerb von Eigenwohnraum.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>021</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Durch die Förderung können nur Haushalte begünstigt werden, deren Einkommen die in Art. 11 Abs. 1 BayWoFG bezeichneten Einkommensgrenzen nicht übersteigt.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Gefördert wird mit einer Zinsverbilligung von bis zu 1/3 der Gesamtkosten und einem Kinderzuschuss von 5.000 Euro je Kind in Verbindung mit dem Darlehen.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Vor der Bewilligung der Fördermittel darf mit dem Bauvorhaben nicht begonnen werden.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Ein Rechtsanspruch auf eine Förderung besteht nicht.&lt;/li&gt;&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Eigenwohnraum darf nur für Antragsteller gefördert werden, die sich nicht nur vorübergehend im Bundesgebiet aufhalten und rechtlich und tatsächlich in der Lage sind, für ihren Haushalt auf längere Dauer einen Wohnsitz als Mittelpunkt der Lebensbeziehungen zu begründen und dabei einen selbstständigen Haushalt zu führen.&lt;/p&gt;&lt;p&gt;Die Förderung des Erwerbs von Eigenwohnraum ist ausgeschlossen, wenn Verkäufer und Käufer in gerader Linie verwandt sind.&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://banking.bayernlb.de/bayernlabo_fl/mini-lotse/</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Das Verfahren ist zweistufig:&lt;/p&gt;&lt;ol&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;Der Antrag ist bei der Bayerischen Landesbodenkreditanstalt mittels der dafür vorgesehenen Formulare und Unterlagen einzureichen. Die Bewilligung erfolgt durch die Kreisverwaltungsbehörde.&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;Die Darlehenszusage und Zustellung des Bewilligungsbescheids erfolgt durch die Bayerische Landesbodenkreditanstalt. Die Auszahlung erfolgt nach Baufortschritt und ist bei der Kreisverwaltungsbehörde zu beantragen. Für die Beratung sind die Landratsämter oder kreisfreien Städte zuständig.&lt;/li&gt;&lt;/ol&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Antrag Bayerisches Zinsverbilligungsprogramm zur Förderung von Eigenwohnraum</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Stabau Ia</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Einkommenserklärung des Antragstellers</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Stabau III a</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Einkommenserklärung für weitere Haushaltsangehörige</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Stabau III b</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;verwaltungsgerichtliche Klage&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_99   [ xyz:attributes  [ xyz:antragsstellung      "https://foerderung.bayern.de/landingpage/020e7693-f133-498d-bd17-37f7bf1a62fa";
                                xyz:begriffeImKontext    [ rdf:_1  "Mobilität";
                                                           rdf:_2  "Ländlicher Raum";
                                                           rdf:_3  "Bedarfsorientierte Bedienformen";
                                                           rdf:_4  "flexible Bedienformen";
                                                           rdf:_5  "On-Demand-Verkehr";
                                                           rdf:_6  "Expressbus"
                                                         ];
                                xyz:beschreibung         "<p>Das Förderprogramm unterstützt die Aufgabenträger des Öffentlichen</p><p>Personennahverkehrs (ÖPNV), die Verkehrserschließung im ländlichen Raum zu</p><p>verbessern und auszuweiten. Um eine angepasste Mobilität zu ermöglichen,</p><p>werden Aufwendungen für bedarfsorientierte Bedienformen des allgemeinen ÖPNV</p><p>im ländlichen Raum und Pilotprojekte für landkreisübergreifende</p><p>Expressbusverbindungen im Omnibusverkehr gefördert.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Anteilsfinanzierung/Kapitalbeteiligung" ];
                                xyz:foerderbereich       [ rdf:_1  "Regionalförderung" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Kommunen" ];
                                xyz:foerderprogramm      "Mobilität im ländlichen Raum";
                                xyz:foerderzeitraum.bis  "2027-01-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2023-03-16T00:00:00.000+00:00";
                                xyz:schluessel           "72e11f7d-6e6e-4552-9639-58ffce3dc0a6";
                                xyz:teaser               "Der Freistaat Bayern fördert die Mobilität im ländlichen Raum.";
                                xyz:titel                "Mobilität im ländlichen Raum; Förderung ergänzender Nahverkehrsangebote (ErNa)";
                                xyz:titel.tokens         [ rdf:_1  "Mobilität im ländlichen Raum";
                                                           rdf:_2  "Förderung ergänzender Nahverkehrsangebote (ErNa)"
                                                         ];
                                xyz:voraussetzung        "<p>Nur die Einführung von neuen flexiblen Bedienformen und Expressverbindungen mit Omnibussen im ländlichen Raum sind von dieser Förderung erfasst. Es ist ein schriftlicher Antrag erforderlich. Die Projekte müssen im Einklang mit dem Nahverkehrsplan stehen. Die genauen Vorgaben sind in der Richtlinie zum Förderprogramm Ergänzender Nahverkehrsangebote zur Verbesserung der Mobilität im ländlichen Raum mit bedarfsorientierten Bedienformen des allgemeinen ÖPNV und Pilotprojekten landkreisübergreifender Expressbusverbindungen im Omnibusverkehr (ErNa) vom 16. Mai 2023, 97-B (BayMBl. Nr. 275) dargestellt.</p>"
                              ];
