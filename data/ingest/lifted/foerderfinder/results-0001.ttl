                                                                                                                                                                                          rdf:_7  [ xyz:bezeichnung  "Beschreibung des zur Verfügung gestellten Wohnraums" ];
                                                                                                                                                                                          rdf:_8  [ xyz:bezeichnung  "Qualifikations- und Fortbildungsnachweise der Fachkräfte (Zeugnisse, Diplome etc.)" ];
