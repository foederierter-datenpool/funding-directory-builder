                                                                                                                                           xyz:rechtsbehelf             "<p>verwaltungsgerichtliche Klage</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<p>Das Verfahren ist zweistufig: 1. Das Vorhaben ist möglichst frühzeitig mit der Bewilligungsstelle (siehe unter \"Für Sie zuständig\") abzustimmen. In der Folge kann der Antrag mittels der dafür vorgesehenen Formulare und Unterlagen eingereicht werden. Die Bewilligung erfolgt durch die Bewilligungsstelle. 2. Die Darlehenszusage und Zustellung des Bewilligungsbescheids erfolgt durch die Bayerische Landesbodenkreditanstalt. Die Auszahlung erfolgt nach Baufortschritt und ist bei der Bewilligungsstelle zu beantragen.</p>";
                                                                                                                                                                          xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "002";
                                                                                                                                                                                                            xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
                                                                                                                                                                                                            xyz:listVersionID  "1"
                                                                                                                                                                                                          ]
                                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:finanzierungsartUndHoehe  "<ul><li class=\"unordered-list-item--dash\">Die Förderung erfolgt über ein Baudarlehen und einen Zuschuss.</li><li class=\"unordered-list-item--dash\">Die Förderung erfolgt für die Dauer von 40 oder 55 Jahren.</li><li class=\"unordered-list-item--dash\">Der Mieter erhält bei der Einkommensorientierten Förderung einen Mietzuschuss, der die vereinbarte Marktmiete auf eine ihm nach seinem Einkommen zumutbare Miete senkt.&nbsp;</li></ul>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "002";
