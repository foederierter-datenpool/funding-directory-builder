                                                                                                                                           xyz:erforderlicheUnterlagen  [ xyz:dokument  [ rdf:_1  [ xyz:bezeichnung  "In Antragsphase I: Ausgefülltes Antragsformblatt Teilhabeangebote oder Demenzsensible Kommunen (Antragsphase I) sowie Erklärung über subventionserhebliche Tatsachen" ];
                                                                                                                                                                                          rdf:_2  [ xyz:bezeichnung  "In Antragsphase II nach positivem Votum (s. unter Verfahrensablauf): Ausgefülltes Antragsformblatt Teilhabeangebote oder Demenzsensible Kommunen (Antragsphase II), De-minimis-Erklärung sowie Finanzierungsplan" ];
                                                                                                                                                                                          rdf:_3  [ xyz:bezeichnung  "Weitere Informationen für eine Antragstellung finden Sie auf der Website des Bayerischen Demenzfonds." ]
