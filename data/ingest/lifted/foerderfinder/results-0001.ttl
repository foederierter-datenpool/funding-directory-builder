                                                         ];
                                xyz:beschreibung         "<p>Durch die Zuwendungen sollen Sportvereine in die Lage versetzt werden, eigene Sportstätten zu errichten und zu erhalten, die sie für den unmittelbaren Sportbetrieb ihrer Mitglieder benötigen.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Kultur, Medien und Sport" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
