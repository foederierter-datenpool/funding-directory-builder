                                                                                                                                                                      xyz:name           ""
                                                                                                                                                                    ]
                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergegenstand       [ xyz:beschreibung
                                                                                                                               "<p>Gegenstand der Förderung ist</p><ul><li class=\"unordered-list-item--dash\">der Bau, die Erweiterung sowie der Ersterwerb von Wohnraum für Auszubildende,</li><li class=\"unordered-list-item--dash\">der Umbau von Wohnraum für Auszubildende sowie Maßnahmen der umfassenden energetischen Modernisierung,</li><li class=\"unordered-list-item--dash\">der Erwerb und die Änderung von Gebäuden, die bisher nicht zu Wohnzwecken genutzt wurden, zu Wohnraum für Auszubildende.</li></ul>" ];
                                                                                                             xyz:foerdernehmende         [ xyz:beschreibung     "Zuwendungsempfänger sind Grundstückseigentümer, Erbbauberechtigte oder Erwerber. Und insbesondere gemeinnützige Träger und Organisationen, Träger und Organisationen der freien Wohlfahrtspflege und der Jugendhilfe, Träger der beruflichen Bildung, Zusammenschlüsse von Berufs- und Fachverbänden, kommunale Unternehmen und Kommunen.";
