                                xyz:beschreibung         "<p>Am Hightech- und Medienstandort Bayern ist die Medienbranche ein wichtiger Wirtschaftsfaktor mit einem großen Wachstumspotential im kreativ-technischen Bereich. Die Förderung soll die Entwicklung qualitativ hochwertiger, kulturell oder pädagogisch bedeutsamer digitaler Spiele und innovativer, interaktiver Medienprojekte mit Spielecharakter unterstützen. Ziel ist es, die Leistungsfähigkeit der bayerischen Entwicklungs- und Produktionswirtschaft sowie den digitalen audiovisuellen Standort in Europa zu stärken.</p><p>Ein besonderes Augenmerk wird auf die Nachwuchsförderung gelegt.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Anteilsfinanzierung/Kapitalbeteiligung" ];
                                xyz:foerderbereich       [ rdf:_1  "Digitalisierung";
                                                           rdf:_2  "Forschung und Innovation (themenoffen)";
                                                           rdf:_3  "Kultur, Medien und Sport";
                                                           rdf:_4  "Unternehmensfinanzierung"
                                                         ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Privatpersonen";
                                                           rdf:_2  "Kleine und mittlere Unternehmen";
