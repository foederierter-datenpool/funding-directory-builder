                                xyz:foerderprogramm      "Förderprogramm Regionalkultur";
                                xyz:foerderzeitraum.bis  "2028-09-30T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2022-10-01T00:00:00.000+00:00";
                                xyz:schluessel           "b68906d5-c421-4ff8-b49a-1d1c0e793497";
                                xyz:teaser               "Der Freistaat Bayern fördert heimatpflegerische Initiativen und die Stärkung des Heimat- und Traditionsbewusstseins.";
                                xyz:titel                "Investitionsförderung für Spielstätten historischer Heimatschauspiele";
                                xyz:titel.tokens         [ rdf:_1  "Investitionsförderung für Spielstätten historischer Heimatschauspiele" ];
                                xyz:voraussetzung        "<ul><li class=\"unordered-list-item--dash\">Die &nbsp;Zuwendung beträgt mehr als 5.000 Euro.</li><li class=\"unordered-list-item--dash\">Für Kommunen gilt eine Mindestzuwendung von mehr als 10.000 Euro.</li><li class=\"unordered-list-item--dash\">Der Eigenanteil beträgt mindestens 10 Prozent der zuwendungsfähigen Ausgaben. Sie können nachweisen, dass Sie diesen finanziell tragen können.&nbsp;</li><li class=\"unordered-list-item--dash\">Das Vorhaben hat einen überregionalen Wirkbereich.</li><li class=\"unordered-list-item--dash\">Die Spielstätte dient zu mindestens 80 Prozent historischen Heimatschauspielen.</li><li class=\"unordered-list-item--dash\">Bei Sanierungen erreichen die zuwendungsfähigen Ausgaben mindestens 25 Prozent der Kosten eines vergleichbaren Neubaus (dies gilt nicht, wenn die Maßnahme durch ein Elementarschadenereignis veranlasst ist und die Zuwendung die Kosten betrifft, die nicht durch Versicherungsleistungen oder staatliche Hilfsleistungen abgedeckt werden).</li><li class=\"unordered-list-item--dash\">Bei Sanierungen aufgrund von Elementarschadensfällen ist eine regional angemessene Absicherung von Elementarschäden vorhanden.</li></ul>"
                              ];
