                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Förderfähig sind die Gesamtkosten (inkl. der Kosten für die Erstmöblierung).</p>"
                                                                                                                                         ];
