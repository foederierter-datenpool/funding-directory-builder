                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>7c89b2bd-980f-4697-b896-3b0fd4942660</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-03-05T10:54:03</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>7c89b2bd-980f-4697-b896-3b0fd4942660</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>7c89b2bd-980f-4697-b896-3b0fd4942660</xflb:schluessel>\n         <xflb:versionFLB>3</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-03-05T10:54:03</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>7c89b2bd-980f-4697-b896-3b0fd4942660</xflb:foerderschluessel>\n                  <xflb:flbVersion>3</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99403001017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Schützenverein; Beantragung einer Förderung für den vereinseigenen Sportstättenbau</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Durch die Zuwendungen sollen Schützenvereine in die Lage versetzt werden, eigene Sportstätten zu errichten und zu erhalten, die sie für den unmittelbaren Sportbetrieb ihrer Mitglieder benötigen.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern fördert die Errichtung und die Sanierung von Schießsportstätten, die Schützenvereine für den unmittelbaren Sportbetrieb ihrer Mitglieder benötigen.</xflb:teaser>\n                  <xflb:schluesselwoerter>Schützenverein; Sportstättenbau; vereinseigener Schießsportstättenbau</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Bayerischer Sportschützenbund</xflb:bezeichnung>\n                     <xflb:link>http://www.bssb.de</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Oberpfälzer Schützenbund e.V.</xflb:bezeichnung>\n                     <xflb:link>https://www.osb-ev.de/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Sportstättenbau der Vereine</xflb:bezeichnung>\n                     <xflb:link>https://www.stmi.bayern.de/sport/foerderung/sportstaettenbau/index.php</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Allgemeine Nebenbestimmungen für Zuwendungen zur Projektförderung (ANBest-P)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN121</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Unterlagen für die Beantragung einer Zuwendung zu Baumaßnahmen</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN123</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Baufachliche Nebenbestimmungen (NBest-Bau, Anlage 4b zu Art. 44 BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN125</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Regierungen, Bayerischer Sportschützenbund e.V.</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>938b77b1-456b-465d-a699-54e075db3507</xflb:id>\n                     <xflb:bezeichnung>Verwendungsnachweis Förderung von vereinseigenem Sportstättenbau (Sportförderung Schützen)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-035/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>02117b66-6c4d-4d06-bbbc-3c5f5884bb29</xflb:id>\n                     <xflb:bezeichnung>Auszahlungsantrag Förderung von vereinseigenem Sportstättenbau (Sportförderung Schützen)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-036/index</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n               <xflb:onlinedienste>\n                  <xflb:onlinedienst>\n                     <xflb:id>364fe2e4-10b9-4ae2-a97f-fd29f1286543</xflb:id>\n                     <xflb:bezeichnung>Beantragung einer Förderung für den vereinseigenen Sportstättenbau im Schießsport</xflb:bezeichnung>\n                     <xflb:link>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/vereinseigener_sportstaettenbau_bssb/index?caller=bpmyytimbyg43tiy3fgbsdomzrheb6d5cfe7fjywbgazm5t6wkppncqoxvqhxlsen7zfs2amutpphoqxcrx7prhlquza2rt7c4q3p4czm2sb3hnepgzftfgx7moxnqdiiusknmui3zrvkgbu57gnroiywllaz743w24lonvrvb2y5eyorpngr6gn2k334su7pwq5xzk4avnz4xoyw43rahopxn6xcmb4zvjhejdaksjeyvdqs3w4mvldmimhfn73wy</xflb:link>\n                     <xflb:beschreibung>Die Beantragung einer Förderung für den vereinseigenen Sportstättenbau im Schießsport ermöglicht Vereinen, finanzielle Unterstützung für den Bau oder die Modernisierung ihrer Schießsportanlagen zu erhalten.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n               </xflb:onlinedienste>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Antragsberechtigt sind Schützenvereine, die Mitglied des Bayerischen Sportschützenbundes e. V. (BSSB) oder des Oberpfälzer Schützenbundes e. V. (OSB) sind.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Zuwendungen werden als projektbezogene Zuschüsse im Wege der Festbetragsfinanzierung gewährt. Der Fördersatz beträgt bis zu 25 Prozent der zuwendungsfähigen Kosten.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Gefördert werden Ausgaben für den Neubau, Umbau und die Erweiterung von Sportstätten. Zudem sind Instandsetzungs- und Modernisierungsmaßnahmen förderfähig, wenn die Neuerrichtung oder letzte Generalsanierung mindestens sechs Jahre zurückliegt oder die Ausgaben für die Instandsetzungs- oder Modernisierungsmaßnahme mindestens 65.000 Euro betragen. Förderfähig ist auch der Erwerb eines Objekts (ohne Grundstückskosten), wenn damit ein an sich notwendiger Neu- oder Erweiterungsbau einer Sportstätte entbehrlich wird und der Erwerb einschließlich notwendiger Sanierungen die wirtschaftlichere Lösung gegenüber einem Neu- oder Erweiterungsbau darstellt.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium des Innern, für Sport und Integration</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinien über die Gewährung von Zuwendungen des Freistaates Bayern zur Förderung des organisierten Sports (Sportförderrichtlinien - SportFöR)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2273_I_13469</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Sachgebiet H2 (Sportförderung)</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Sportförderung</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2028-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2023-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2028-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n               <xflb:kummulierbareFoerderungen>\n                  <xflb:voraussetzungen>Auch bei Kumulierung von Förderungen hat der Verein einen Eigenanteil zu erbringen, der nicht unter zehn Prozent der zuwendungsfähigen Ausgaben liegen darf.</xflb:voraussetzungen>\n               </xflb:kummulierbareFoerderungen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gegenstand der Förderung sind vereinseigene Sportstätten einschließlich Nebenanlagen, die für den unmittelbaren Sportbetrieb der Mitglieder erforderlich sind.&lt;/p&gt;&lt;p&gt;Gefördert werden der Neubau, Umbau und die Erweiterung von Sportstätten sowie Generalsanierungen und Modernisierungsmaßnahmen. Letztere sind förderfähig, wenn die Neuerrichtung oder letzte Generalsanierung mindestens sechs Jahre zurückliegt oder die Ausgaben mindestens 65.000 Euro betragen.&lt;/p&gt;&lt;p&gt;Ebenfalls förderfähig ist der Erwerb eines Objekts (ohne Grundstückskosten), sofern dadurch ein notwendiger Neu- oder Erweiterungsbau entbehrlich wird und der Erwerb einschließlich erforderlicher Sanierungen wirtschaftlicher ist als eine entsprechende Baumaßnahme.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>013</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Eine Förderung ist nur im Rahmen des nachgewiesenen sportfachlichen Bedarfs zulässig. Der Bedarfsnachweis soll in der Regel durch eine Darstellung des geplanten Sportbetriebs, der erwarteten Teilnehmerzahlen, der dem Verein ansonsten zur Verfügung stehenden Einrichtungen sowie der geplanten Auslastung der Sportstätte durch den eigenen Vereinssport geführt werden.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Der antragstellende Verein muss der Träger aller beantragten Baumaßnahmen sein sowie grundsätzlich über ein Eigentums- bzw. Erbbaurecht an den Förderobjekten verfügen. In wenigen Fällen genügt anstelle des Eigentums- bzw. Erbbaurecht ein langfristiges Nutzungsrecht. Ab Fertigstellung der Anlage müssen dem Verein das Nutzungs- sowie das Hausrecht auf die Dauer von mindestens 25 Jahren uneingeschränkt, unkündbar und unabdingbar eingeräumt werden. Die allgemein gültigen zuwendungsrechtlichen Bestimmungen der Verwaltungsvorschriften zu den Artikeln 23 und 44 der bayerischen Haushaltsordnung (BayHO) finden Anwendung. Dem Verein kann eine Zuwendung nur gewährt werden, sofern die Bewilligung der Maßnahme vor dem Baubeginn erfolgt ist. Der Verein muss einen Eigenanteil erbringen, der nicht unter zehn Prozent der zuwendungsfähigen Ausgaben liegen darf.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Von der Förderung ausgenommen sind die Teilsanierung von Bauteilen, der laufende Bauunterhalt sowie Maßnahmen, die durch mangelhaften Bauunterhalt verursacht wurden. Ferner werden Maßnahmen mit zuwendungsfähigen Ausgaben unter 10.000 Euro nicht gefördert.&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/vereinseigener_sportstaettenbau_bssb/index?caller=bpmyytimbyg43tiy3fgbsdomzrheb6d5cfe7fjywbgazm5t6wkppncqoxvqhxlsen7zfs2amutpphoqxcrx7prhlquza2rt7c4q3p4czm2sb3hnepgzftfgx7moxnqdiiusknmui3zrvkgbu57gnroiywllaz743w24lonvrvb2y5eyorpngr6gn2k334su7pwq5xzk4avnz4xoyw43rahopxn6xcmb4zvjhejdaksjeyvdqs3w4mvldmimhfn73wy</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Förderanträge der Schützenvereine sind bei der zuständigen Regierung einzureichen. Die Regierungen beteiligen die jeweils zuständige Dachorganisation (BSSB oder OSB) und setzen nach erfolgter positiver Prüfung die Höhe des staatlichen Zuschusses für das Bauvorhaben fest.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>genaue Projektbeschreibung</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Darlegung der Zuwendungsvoraussetzungen</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Ausgaben- und Finanzierungsplan</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Darlegung dauerhafter finanzieller Leistungsfähigkeit</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Erklärung, dass mit der Maßnahme noch nicht begonnen worden ist</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Erklärung, ob der Zuwendungsempfänger allgemein oder für das betreffende Vorhaben zum Vorsteuerabzug nach § 15 UStG berechtigt ist</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Gegen den Zuwendungsbescheid können Sie innerhalb von einem Monat Klage vor dem Verwaltungsgericht erheben. Das zuständige Gericht, bei dem Sie Klage einreichen können, wird Ihnen im Bescheid mitgeteilt.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
