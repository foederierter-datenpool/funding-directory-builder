                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>215fb07e-d9ae-4d01-8510-1c0566e2b467</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-09-20T11:16:15</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>215fb07e-d9ae-4d01-8510-1c0566e2b467</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>215fb07e-d9ae-4d01-8510-1c0566e2b467</xflb:schluessel>\n         <xflb:versionFLB>5</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-09-01T14:25:32</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>215fb07e-d9ae-4d01-8510-1c0566e2b467</xflb:foerderschluessel>\n                  <xflb:flbVersion>5</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400015017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Projektförderung zur freiwilligen Rückkehr aus Bayern, zur Reintegration sowie zur Rückkehr- und Reintegrationsvorbereitung</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Durch die staatliche Förderung von Rückkehr- und Reintegrationsprojekten sollen ausreisewillige Personen motiviert werden, den Entschluss zur Rückkehr in das jeweilige Heimatland freiwillig und nach möglichst kurzem Aufenthalt in Deutschland zu treffen. Ein umfassendes Angebot von Unterstützungsleistungen in allen für die Rückkehr relevanten Anliegen soll eine Rückkehr in Würde ermöglichen.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern fördert Projekte, die die freiwillige Ausreise, insbesondere ausreisepflichtiger ausländischer Staatsangehöriger, in ihr Herkunftsland oder einen aufnahmebereiten Drittstaat unterstützen.</xflb:teaser>\n                  <xflb:schluesselwoerter>Freiwillige Rückkehr, Rückkehrvorbereitung, Reintegrationsvorbereitung</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:alternativeFoerdermoeglichkeiten>\n                  <xflb:alternativeFoerdermoeglichkeit>\n                     <xflb:beschreibung>Asyl-, Migrations- und Integrationsfonds der EU (AMIF)</xflb:beschreibung>\n                     <xflb:verweis>\n                        <xflb:bezeichnung>Informationen des BAMF zum AMIF</xflb:bezeichnung>\n                        <xflb:link>https://www.bamf.de/DE/Themen/Foerderangebote/AMIF21/amif21-node.html</xflb:link>\n                     </xflb:verweis>\n                  </xflb:alternativeFoerdermoeglichkeit>\n               </xflb:alternativeFoerdermoeglichkeiten>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Webseite des Landesamt für Asyl und Rückführungen (LfAR)</xflb:bezeichnung>\n                     <xflb:link>https://www.lfar.bayern.de/lfar_im_ueberblick/aufgabenbereiche/freiwilligerueckkehr/index.html</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Landesamt für Asyl und Rückführungen (LfAR), Sachgebiet R2 - Freiwillige Rückkehr</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>72</xflb:hausnummerPostfach>\n                     <xflb:strasse>St.-Martin-Straße</xflb:strasse>\n                     <xflb:postleitzahl>81541</xflb:postleitzahl>\n                     <xflb:ort>München</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>Sachgebiet-R2@lfar.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Internetauftritt LfAR, Freiwillige Rückkehr</xflb:bezeichnung>\n                     <xflb:link>https://www.lfar.bayern.de/lfar_im_ueberblick/aufgabenbereiche/freiwilligerueckkehr/index.html</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>08450-9000220</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Herr Robatsch</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>72</xflb:hausnummerPostfach>\n                           <xflb:strasse>St.-Martin-Straße</xflb:strasse>\n                           <xflb:postleitzahl>81541</xflb:postleitzahl>\n                           <xflb:ort>München</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>projektfoerderung@lfar.bayern.de</xflb:email>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Internetauftritt LfAR, Freiwillige Rückkehr</xflb:bezeichnung>\n                           <xflb:link>https://www.lfar.bayern.de/lfar_im_ueberblick/aufgabenbereiche/freiwilligerueckkehr/index.html</xflb:link>\n                        </xflb:verweis>\n                        <xflb:telefonnummer>08450-9000296</xflb:telefonnummer>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>001</code>\n                           <name>Kontaktperson</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Antrags- und zuwendungsberechtigt sind Vereine, Wohlfahrtsverbände und sonstige gemeinnützige Organisationen (z.B. gGmbH) im Bereich der Freiwilligen Rückkehr.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Zuwendung erfolgt im Rahmen einer Projektförderung auf Basis der zuwendungsfähigen Ausgaben.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Die Höhe der zuschussfähigen Personalkosten bemisst sich nach der Höhe der tatsächlich ausgezahlten Löhne und Gehälter. Die Personalkosten dürfen weder die Löhne, Gehälter sowie sonstige dem Zuwendungsempfänger entstehenden Arbeitskosten, noch die günstigsten marktüblichen Sätze (Tarifvertrag der Länder - TV-L) überschreiten (Besserstellungsverbot).&amp;nbsp;&lt;/p&gt;&lt;p&gt;Erfolgt die Förderung im Rahmen einer Kofinanzierung, ist der Umfang der Förderung zwischen den Zuwendungsgebern abzustimmen und kann von den genannten Angaben abweichen.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Gefördert werden können Personalausgaben und Sachkosten.&amp;nbsp;&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium des Innern, für Sport und Integration</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Bayerische Richtlinie zur Förderung  der freiwilligen Rückkehr ins Herkunftsland  \"Bayerisches Rückkehrprogramm\"</xflb:bezeichnung>\n                     <xflb:link>https://www.lfar.bayern.de/mam/ueber_das_lfar/aufgabenbereiche/freiwilligerueckkehr/231228_richtlinie_bayerisches_r%C3%BCckkehrprogramm_ab_2024.pdf</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Bayerisches Landesamt für Asyl und Rückführungen (LfAR)</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Projekte zur Förderung der Freiwilligen Rückkehr aus Bayern, zur Reintegration sowie zur Rückkehr- und Reintegrationsvorbereitung</xflb:programmtitel>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2026-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2026-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Es können Projekte in Deutschland oder einem relevanten Rückkehrstaat gefördert werden, die den genannten Zweck erfüllen Zweck erfüllen und positive Effekte auf den Bereich der freiwilligen Rückkehr haben. Welche Maßnahmen gefördert werden können, wird regelmäßig neu bewertet.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Das Projekt muss dem Bedarf des Freistaats Bayern im Bereich der Freiwilligen Rückkehr entsprechen und geeignet sein, nachweisbar und effektiv die freiwillige Rückkehr aus Bayern zu intensivieren.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Der Zuwendungsempfänger hat i.d.R. eine Eigenbeteiligung von mindestens 10 % der zuwendungsfähigen Ausgaben zu erbringen.&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.lfar.bayern.de/lfar_im_ueberblick/aufgabenbereiche/freiwilligerueckkehr/index.html</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Die Projektidee ist dem Bayerischen Landesamt für Asyl und Rückführungen (LfAR) möglichst frühzeitig vorzustellen. Wird eine Förderfähigkeit prognostiziert, muss der Antrag auf Förderung schriftlich beim LfAR unter Vorlage eines vorläufigen Finanzplans mit den voraussichtlichen Projektkosten eingereicht werden.&lt;/p&gt;</xflb:bewilligung>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Projektskizze</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Kurzbeschreibung des Projektes und der Ziele</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>ausführliche Projektbeschreibung</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Indikatorenübersicht</xflb:bezeichnung>\n                     <xflb:erlaeuterung>an den angegebenen Indikatoren wird der Projekterfolg gemessen</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Finanzplan</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Verwaltungsrechtliche Klage&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_186  [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/13/rmf_13-080/index";
