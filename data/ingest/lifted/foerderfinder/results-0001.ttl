                                                                                                                                                                                                  ];
                                                                                                                                                                                          rdf:_3  [ xyz:bezeichnung   "ggf. Vereinbarung AsA-Maßnahme";
                                                                                                                                                                                                    xyz:erlaeuterung  "Bei einer Antragstellung für Auszubildende, die mit Assistierter Ausbildung (AsA) gefördert werden, hat das antragstellende Ausbildungsunternehmen zusätzlich eine Erklärung des Bildungsträgers einzureichen, wann mit der oder dem Auszubildenden die AsA-Maßnahme vereinbart wurde."
                                                                                                                                                                                                  ];
