                                                                   ];
                                            xyz:produkt            "Förderfinder";
                                            xyz:produkthersteller  "StMD Bayern";
                                            xyz:produktversion     "";
                                            xyz:schemaLocation     "http://xoev.de/schemata/xflb/2_0_0 xflb.xsd";
                                            xyz:standard           "XFLB";
                                            xyz:test               "";
                                            xyz:version            "2.0.0"
                                          ];
                                xyz:xml   "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           produkt=\"Förderfinder\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produktversion=\"\"\n                                           standard=\"XFLB\"\n                                           test=\"\"\n                                           version=\"2.0.0\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0 xflb.xsd\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>a6d62298-ae06-464c-86b6-0a8307aa9578</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-04-03T13:55:51</xflb:erstellungszeitpunkt>\n      <xflb:sender>Förderfinder Suche (Bayern)</xflb:sender>\n      <xflb:empfaenger>XFLB-Connect (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>a6d62298-ae06-464c-86b6-0a8307aa9578</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>a6d62298-ae06-464c-86b6-0a8307aa9578</xflb:schluessel>\n         <xflb:versionFLB>4</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:zuordnungen>\n               <xflb:leika>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"1\">\n                        <code>4</code>\n                        <name>Regelungskompetenz auf Landesebene</name>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n               <xflb:interneKennung>\n                  <xflb:flbVersion>4</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n                  <xflb:foerderschluessel>a6d62298-ae06-464c-86b6-0a8307aa9578</xflb:foerderschluessel>\n               </xflb:interneKennung>\n            </xflb:zuordnungen>\n            <xflb:finanzierung>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Zuwendung erfolgt als Projektförderung im Wege der Anteilfinanzierung. Sie beträgt maximal 300 000 Euro pro Projekt. Der Basisfördersatz beträgt bis zu 50 Prozent und erhöht sich für Projekte im ländlichen Raum und im Raum mit besonderem Handlungsbedarf um jeweils bis zu 15 Prozentpunkte sowie für interkommunale oder interregionale Zusammenarbeit um bis zu 10 Prozentpunkte.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Gefördert werden können Ausgaben für Personal, Fahrten und Übernachtungen, Bewirtung bei öffentlichkeitswirksamen Veranstaltungen, Öffentlichkeitsarbeit, externe Beratungs- und Dienstleistungen, Investitionen in digitale Güter (zum Beispiel Apps, Websites und andere Online-Angebote) sowie sonstige Leistungen durch Dritte und sonstige Investitionen.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:euBeihilferelevanz>Den im Rahmen der HDRFöR geförderten Projekten kommt in der Regel keine beihilferechtliche Relevanz zu, da die Projektträger typischerweise keine Unternehmen im Sinn des Beihilferechts sind und die geförderten Projekte auf einen Beitrag zur räumlichen Entwicklung zielen und sich somit nicht auf einzelne Unternehmen fokussieren. Sofern es sich jedoch im jeweiligen Einzelfall um eine aus staatlichen Mitteln finanzierte Maßnahme zugunsten bestimmter Unternehmen handelt, die den Wettbewerb verfälscht oder zu verfälschen droht und eine Beeinträchtigung des zwischenstaatlichen Handels hervorruft, liegt eine gemäß Art. 107 Abs. 1 AEUV verbotene Beihilfe vor. Hier kommt insbesondere auch eine mittelbare Beihilfe durch eine Förderung wirtschaftsnaher Projekte, die ggf. einzelne Unternehmen begünstigen, in Betracht.\n\nBeihilfen i.S.v. Art. 107 Abs. 1 AEUV sind vor ihrer Durchführung bei der Europäischen Kommission anzumelden (sog. Notifizierungspflicht gemäß Art. 108 Abs. 3 AEUV). Ausnahmen vom allgemeinen Beihilfeverbot sind möglich, soweit eine der folgenden Regelungen eingreift, die die Maßnahme vom Beihilfetatbestand des Art. 107 Abs. 1 AEUV ausnimmt oder von der Notifizierungspflicht des Art. 108 Abs. 3 AEUV befreit:\n\n- De-minimis-Verordnung\nDie De-minimis-Verordnung ermöglicht die Ausreichung von geringen Beihilfebeträgen, da vermutet wird, dass sie keine (drohende) Wettbewerbsverfälschung i.S.v. Art. 107 Abs. 1 AEUV bewirken. Der Schwellenwert liegt bei 300 000 Euro innerhalb des laufenden und der letzten zwei Kalenderjahre.\n\n- Allgemeine Gruppenfreistellungsverordnung (AGVO)\nDie AGVO befreit bestimmte Beihilfen von der Notifizierungspflicht des Art. 108 Abs. 3 AEUV. Es ist jedoch erforderlich, dass die Europäische Kommission - regelmäßig durch den Zuwendungsgeber - innerhalb von 20 Arbeitstagen nach Gewährung der Beihilfe informiert wird.\n\n- DAWI-Beschluss\nEine weitere Ausnahme vom allgemeinen Beihilfeverbot stellen die Vorschriften zu Dienstleistungen von allgemeinem wirtschaftlichem Interesse (DAWI) dar. Die Europäische Kommission beschreibt DAWI als Dienstleistungen, die von den Behörden der Mitgliedsstaaten als im allgemeinen Interesse liegend eingestuft werden und ohne staatliche Eingriffe am Markt überhaupt nicht oder in Bezug auf Qualität, Sicherheit, Bezahlbarkeit, Gleichbehandlung oder universalen Zugang zu anderen Standards durchgeführt würden. Die sog. Altmark Trans-Entscheidung des EuGH (Urteil vom 24. Juli 2003, C-280/00) legt fest, welche Voraussetzungen erfüllt sein müssen, damit die Maßnahme keine Begünstigung des Zuwendungsempfängers und damit auch keine Beihilfe i.S.v. Art. 107 Abs. 1 AEUV darstellt.</xflb:euBeihilferelevanz>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:zuwendungsart>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name>Bayern</name>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name>Vereine</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name>Kommunen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name>Verbände</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name>Stiftungen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>003</code>\n                  <name>Einzelunternehmen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>002</code>\n                  <name>Kleine und mittlere Unternehmen</name>\n               </xflb:foerdernehmende>\n            </xflb:foerdernehmende>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Förderung digitaler regionaler Heimatprojekte</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:teaser>Der Freistaat Bayern fördert innovative, fachübergreifende Heimatprojekte mit Schwerpunkt Digitalisierung, die sich positiv auf die räumliche Entwicklung Bayerns auswirken und insbesondere der Stärkung der regionalen Identität dienen.</xflb:teaser>\n                  <xflb:zuwendungszweck>&lt;p&gt;Die Förderung unterstützt Bayerns Regionen dabei, mit digitalen Ansätzen die regionale Entwicklung voranzubringen. Sie leistet einen Beitrag, gleichwertige Lebens- und Arbeitsbedingungen in ganz Bayern zu fördern und zu sichern, die digitale Teilhabe und digitale Chancengleichheit in allen Regionen Bayerns zu ermöglichen und die Attraktivität von Verdichtungsraum und ländlichem Raum zu stärken. Die geförderten Projekte sollen dazu beitragen, lebenswerte Heimat in allen bayerischen Landesteilen zu erhalten und zu gestalten sowie die Stärkung des Heimatbewusstseins und der Heimatverbundenheit der Bürger zu unterstützen.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:schluesselwoerter>HDRFöR, Heimat-Digital-Förderrichtlinie, Heimat-Digital-Regional-Förderrichtlinie, Regionale Identität, Digitale Heimatprojekte, Regionalentwicklung, Heimat-digital-regional, Heimat-digital, Heimat Förderung, Regionale Entwicklung, Heimat digital regional, Heimat digital</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Bewilligungsbehörde ist die örtlich zuständige Regierung.</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.stmfh.bayern.de/heimat/regionale_identitaet/?thema=pf</xflb:link>\n                     <xflb:bezeichnung>Projektförderung nach der Heimat-Digital-Regional-Förderrichtlinie</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>https://www.stmfh.bayern.de/heimat/regionale_identitaet/?thema=ri</xflb:link>\n                     <xflb:bezeichnung>Regionale Identität und digitale Heimatprojekte</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>http://www.stmfh.bayern.de/heimat/</xflb:link>\n                     <xflb:bezeichnung>Heimat Bayern</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Mit Hilfe der Zuwendung wird die Durchführung von Heimatprojekten mit Schwerpunkt Digitalisierung gefördert, die einen innovativen Charakter sowie einen fachübergreifenden Ansatz aufweisen und die Entwicklung Bayerns dem Zuwendungszweck entsprechend unterstützen.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-04-03T13:55:51</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmfh/foerderung_hdrfoer/index?caller=bpgfstkzjrgfswimbumzsgcmjwhgtzy7juiq2bfz4uz7mtks2asv3uqvmju42soyh2tbwrgn6ijn5uemmt7sswrcwn6t32o4ipolfd33redwyj7afrffyyhh2g4v2v5acsyne5t2pm5kx6akrukurnovfryp7wtnzbwmiums7d3fh42sx64kv2aq6puhbdi7pc6h7bzrbub2tvo888</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Antragstellung&amp;nbsp;&lt;/p&gt;\n&lt;p&gt;Zur grundsätzlichen Abschätzung der Förderfähigkeit ist zunächst eine Projektskizze beim Bayerischen Staatsministerium der Finanzen und für Heimat einzureichen. Vor der Antragstellung ist zudem ein Beratungsgespräch mit Vertretern des Staatsministeriums und der örtlich zuständigen Regierung (Bewilligungsbehörde) durchzuführen. Förderanträge können bei der Bewilligungsbehörde oder über das verlinkte Online-Verfahren eingereicht werden.&amp;nbsp;&lt;/p&gt;\n&lt;p&gt;Bewilligung&amp;nbsp;&lt;/p&gt;\n&lt;p&gt;Zuständig für die Bewilligung sind die Regierungen. Zuwendungen können grundsätzlich nur dann bewilligt werden, wenn mit dem jeweiligen Projekt noch nicht begonnen wurde. Der Bewilligungszeitraum für die Projektumsetzung beträgt maximal drei Jahre.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>004</code>\n                     <name/>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n            </xflb:antragsinformationen>\n            <xflb:foerdervoraussetzungen>\n               <xflb:ausschlusskriterien>&lt;p&gt;Eine Projektförderung kommt nicht in Betracht, wenn - die zuwendungsfähigen Ausgaben bei kommunalen Gebietskörperschaften als Antragssteller nicht mehr als 25 000 Euro betragen und bei allen sonstigen Antragsstellern nicht mehr als 10 000 Euro - für den Fördergegenstand eine Förderung im Rahmen anderer Programme der Europäischen Union, des Bundes oder des Freistaats Bayern in Anspruch genommen werden kann, es sei denn, das jeweilige EU- oder Bundesförderprogramm erfordert eine Landeskofinanzierung oder lässt eine solche zu.&lt;/p&gt;</xflb:ausschlusskriterien>\n               <xflb:buergerfreundlicheBeschreibung>&lt;ul&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Heimatprojekt: Das Projekt wirkt sich positiv auf die räumliche Entwicklung Bayerns aus und dient insbesondere der Stärkung der regionalen Identität.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Fachübergreifender Ansatz: Das Projekt deckt mindestens zwei Themenbereiche ab. Hier kann insbesondere auf die Stärkung regionaler Identität abgezielt werden, aber beispielsweise auch auf Kultur/Heimatkultur, Daseinsvorsorge, ärztliche Versorgung, ÖPNV, Barrierefreiheit, Integration oder Klima.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Innovativer Projektinhalt: Das Projekt geht inhaltlich, technologisch oder methodisch über bereits bestehende Ansätze im jeweiligen Themenfeld der räumlichen Entwicklung in Bayern hinaus und bietet dadurch einen erkennbaren Mehrwert gegenüber bislang vorhandenen Ansätzen.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Digitaler Schwerpunkt: Im Rahmen des Projekts entsteht zum Beispiel eine App oder Internetplattform oder es werden \"smarte\" oder vernetzte Anwendungen realisiert. Im Falle einer Machbarkeitsstudie ist die Möglichkeit und Perspektive einer Digitalisierung zwingend zu prüfen.&lt;/li&gt;\n&lt;/ul&gt;\n&lt;p&gt;Antrags- und zuwendungsberechtigt sind Landkreise, Bezirke, kreisfreie Städte, Vereine, Stiftungen sowie steuerbegünstigte Unternehmergesellschaften (haftungsbeschränkt) und Gesellschaften mit beschränkter Haftung.&amp;nbsp;Hinzu kommen auch andere Rechtsträger des öffentlichen oder privaten Rechts, wenn mindestens ein Mitglied oder Gesellschafter ein Landkreis, Bezirk oder eine kreisfreie Stadt ist.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:programmtitel>Heimat-Digital-Regional-Förderrichtlinie (HDRFöR)</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2026-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:verantwortlichesFachreferat>Referat 55 - Regionale Identität</xflb:verantwortlichesFachreferat>\n               <xflb:verantwortlichesMinisterium>Staatsministerium der Finanzen und für Heimat</xflb:verantwortlichesMinisterium>\n               <xflb:programmlaufzeit>\n                  <xflb:endeLaufzeitFoerderprogramm>2026-12-31</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:beginnLaufzeitFoerderprogramm>2021-01-01</xflb:beginnLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_7072_1_F_11592/true</xflb:link>\n                     <xflb:bezeichnung>Richtlinie zur Förderung von Heimatprojekten mit Schwerpunkt Digitalisierung insbesondere zur Stärkung regionaler Identität in Bayern (Heimat-Digital-Regional-Förderrichtlinie - HDRFöR)</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN121</xflb:link>\n                     <xflb:bezeichnung>Allgemeine Nebenbestimmungen für Zuwendungen zur Projektförderung (ANBest-P)</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN122</xflb:link>\n                     <xflb:bezeichnung>Allgemeine Nebenbestimmungen für Zuwendungen zur Projektförderung an kommunale Körperschaften (ANBest-K)</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:kummulierbareFoerderungen>\n                  <xflb:voraussetzungen>Kofinanzierung von Projekten möglich, die aus einem EU- oder Bundesprogramm gefördert werden, sofern das EU- oder Bundesprogramm eine Landeskofinanzierung erfordert oder zulässt. Die Kofinanzierung ist gegenüber der EU- oder Bundesförderung nachrangig. Die Mindesteigenmittel von 10 % der zuwendungsfähigen Ausgaben sind zu beachten, sofern nicht das EU- oder Bundesprogramm höhere Eigenmittel vorschreibt.</xflb:voraussetzungen>\n               </xflb:kummulierbareFoerderungen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>002</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>006</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>007</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>013</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>016</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>017</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>019</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>\n"
                              ]
            ];
  rdf:_107  [ xyz:attributes  [ xyz:antragsstellung      "https://www.stmi.bayern.de/a-z/anzeigen/katastrophenschutz-ausstattung-und-finanzierung/";
                                xyz:begriffeImKontext    [ rdf:_1  "Katastrophenschutzfonds";
                                                           rdf:_2  "Erstattung"
                                                         ];
                                xyz:beschreibung         "<p>Nach dem Bayerischen Katastrophenschutzgesetz sind unter anderem Feuerwehren, freiwillige Hilfsorganisationen zur Erbringung von Katastrophenhilfe verpflichtet. Aus Mitteln des Katastrophenschutzfonds werden Zuwendungen gewährt, die die Einsatzkosten der Katastrophenschutzbehörden und der zur Katastrophenhilfe Verpflichteten bei der Abwehr von Katastrophen teilweise ausgleichen und somit unzumutbare Belastungen durch die Pflicht zur Katastrophenhilfe verhindern.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Anteilsfinanzierung/Kapitalbeteiligung" ];
                                xyz:foerderbereich       [ rdf:_1  "Regionalförderung" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Kommunen";
                                                           rdf:_2  "Vereine";
                                                           rdf:_3  "Verbände"
                                                         ];
                                xyz:foerderprogramm      "Zuwendung zu den Einsatzkosten der Katastrophenbewältigung";
                                xyz:foerderzeitraum.bis  "2027-04-30T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2018-06-01T00:00:00.000+00:00";
                                xyz:schluessel           "caa08826-e6bb-41ff-9534-78d8b92b647c";
                                xyz:teaser               "Der Freistaat Bayern gewährt Zuwendungen zu den Einsatzkosten der Katastrophenabwehr und Bewältigung.";
                                xyz:titel                "Zuwendung zu Einsatzkosten der Katastrophenbewältigung";
                                xyz:titel.tokens         [ rdf:_1  "Zuwendung zu Einsatzkosten der Katastrophenbewältigung" ];
                                xyz:voraussetzung        "<p>Zuwendungen werden nur für Aufwendungen gewährt, die</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">in direkten zeitlichen und sachlichen Zusammenhang mit einer Katastrophe stehen,</li>\n  <li class=\"unordered-list-item--dash\">notwendig waren um eine Gefahr oder hohe Sachschäden zu vermeiden oder</li>\n  <li class=\"unordered-list-item--dash\">angemessen und effizient sind.</li>\n</ul>\n<p>Die Kosten für die Beauftragung von Dritten, die nicht zur Katastrophenhilfe verpflichtet sind, werden nur dann gefördert, wenn sie von der Katastrophenschutzbehörde beauftragt wurden. Ausnahmen gelten, wenn:</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">eine Beauftragung durch die Katastrophenschutzbehörde aufgrund von Gefahr im Verzug nicht möglich war und</li>\n  <li class=\"unordered-list-item--dash\">gleichwertige Hilfskräfte oder Mittel der zur Katastrophenhilfe verpflichteten Organisationen nicht oder nicht rechtzeitig verfügbar waren.</li>\n</ul>"
                              ];
              xyz:id          "caa08826-e6bb-41ff-9534-78d8b92b647c";
              xyz:payload     [ xyz:json  [ xyz:anfrage            [ xyz:anfragenummer  "caa08826-e6bb-41ff-9534-78d8b92b647c";
