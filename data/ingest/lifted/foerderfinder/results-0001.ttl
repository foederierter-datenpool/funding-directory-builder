                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>notwendiger Schulaufwand (einmaliger und laufender Schulaufwand); Bei privaten Förderschulen: Kosten von Schulbauten (einschließlich Schulsportbau); notwendiger Personalaufwand; Härteausgleich</p>"
                                                                                                                                         ];
