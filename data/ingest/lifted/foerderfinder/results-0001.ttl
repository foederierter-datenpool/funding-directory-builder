                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>4227a456-a2ab-4be8-976d-8bfc278d4f3d</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-02-02T10:46:45</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>4227a456-a2ab-4be8-976d-8bfc278d4f3d</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>4227a456-a2ab-4be8-976d-8bfc278d4f3d</xflb:schluessel>\n         <xflb:versionFLB>3</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-09-22T08:46:39</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>4227a456-a2ab-4be8-976d-8bfc278d4f3d</xflb:foerderschluessel>\n                  <xflb:flbVersion>3</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4a</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Förderung kommunalen Engagements für die ärztliche Versorgung vor Ort</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Das Förderprogramm unterstützt bayerische Gemeinden im ländlichen Raum bestmögliche Rahmenbedingungen für den Erhalt und die Verbesserung der ambulanten medizinischen Versorgung in ihren Gemeinden zu schaffen. Als Ergänzung zur gesetzlich normierten Sicherstellungsverpflichtung der Kassenärztlichen Vereinigung Bayerns können auch Gemeinden durch kommunales Engagement einen Beitrag zur Schaffung geeigneter Rahmenbedingungen leisten. Durch geeignete Maßnahmen zum Erhalt oder zur Verbesserung der ambulanten medizinischen Versorgung soll die Versorgungslage in Regionen, die häufig einen ländlichen Charakter aufweisen, langfristig stabilisiert werden. Zentrales Ziel ist es, für alle Bürgerinnen und Bürger unabhängig vom Alter, Einkommen und von sozialer Herkunft eine möglichst wohnortnahe und qualitativ hochwertige medizinische Versorgung sicherzustellen.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Das Förderprogramm unterstützt bayerische Gemeinden im ländlichen Raum dabei bestmögliche Rahmenbedingungen für den Erhalt und die Verbesserung der ambulanten medizinischen Versorgung in ihren Gemeinden zu schaffen.</xflb:teaser>\n                  <xflb:schluesselwoerter>Gesundheitsversorgung, bayerische Gemeinden, Kommunalförderung, Ärzteversorgung</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderung des kommunalen Engagements für die ärztliche Versorgung vor Ort</xflb:bezeichnung>\n                     <xflb:link>https://www.lgl.bayern.de/gesundheit/gesundheitsversorgung/kommunalfoerderung/index.htm</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Landesamt für Gesundheit und Lebensmittelsicherheit (LGL) Sachgebiet K1: Rechtsangelegenheiten, Vergabestelle, Förderwesen</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>6</xflb:hausnummerPostfach>\n                     <xflb:strasse>Prinzregentenstraße</xflb:strasse>\n                     <xflb:postleitzahl>97688</xflb:postleitzahl>\n                     <xflb:ort>Bad Kissingen</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>Kommunalfoerderung@lgl.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderung des kommunalen Engagements für die ärztliche Versorgung vor Ort</xflb:bezeichnung>\n                     <xflb:link>https://www.lgl.bayern.de/gesundheit/gesundheitsversorgung/kommunalfoerderung/index.htm</xflb:link>\n                  </xflb:verweis>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Bayerisches Landesamt für Gesundheit und Lebensmittelsicherheit (LGL) Sachgebiet K1: Rechtsangelegenheiten, Vergabestelle, Förderwesen</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>6</xflb:hausnummerPostfach>\n                           <xflb:strasse>Prinzregentenstraße</xflb:strasse>\n                           <xflb:postleitzahl>97688</xflb:postleitzahl>\n                           <xflb:ort>Bad Kissingen</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>Kommunalfoerderung@lgl.bayern.de</xflb:email>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Kontakt zum Fördersachgebiet - Für zuwendungsrechtliche Belange und Einreichung des Projektantrags</xflb:bezeichnung>\n                           <xflb:link>https://www.lgl.bayern.de/gesundheit/gesundheitsversorgung/kommunalfoerderung/index.htm</xflb:link>\n                        </xflb:verweis>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>08108c48-e177-4f0e-958b-26dca20b6ccf</xflb:id>\n                     <xflb:bezeichnung>Antragsformular</xflb:bezeichnung>\n                     <xflb:link>https://www.lgl.bayern.de/gesundheit/gesundheitsversorgung/kommunalfoerderung/doc/Antragsformular.docx</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>14658fba-7c0a-4e62-93ef-7e8a628e914c</xflb:id>\n                     <xflb:bezeichnung>Finanzierungsplan</xflb:bezeichnung>\n                     <xflb:link>https://www.lgl.bayern.de/downloads/gesundheit/gesundheitsversorgung/doc/finanzierungsplan.xlsx</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>c7c2ddf2-e6dc-4993-b56b-405ccfe3b478</xflb:id>\n                     <xflb:bezeichnung>Vorlage Projektbeschreibung</xflb:bezeichnung>\n                     <xflb:link>https://www.lgl.bayern.de/gesundheit/gesundheitsversorgung/kommunalfoerderung/doc/Vorlage_Projektbeschreibung.docx</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>065ae853-d592-486b-bbb7-7ecf6ef976a2</xflb:id>\n                     <xflb:bezeichnung>De-minimis Erklärung</xflb:bezeichnung>\n                     <xflb:link>https://www.lgl.bayern.de/downloads/gesundheit/gesundheitsversorgung/doc/de_minimis_erklaerung.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>df814c31-5cfd-48e4-bab7-c62a0844e6df</xflb:id>\n                     <xflb:bezeichnung>DAWI-De-minimis-Erklärung</xflb:bezeichnung>\n                     <xflb:link>https://www.lgl.bayern.de/downloads/gesundheit/gesundheitsversorgung/doc/dawi_de_erklaerung.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>a334b61a-8f70-4d92-92f0-5ac783305515</xflb:id>\n                     <xflb:bezeichnung>Strukturkarte</xflb:bezeichnung>\n                     <xflb:link>https://www.lgl.bayern.de/downloads/gesundheit/gesundheitsversorgung/doc/Strukturkarte.pdf</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Gemeinden im ländlichen Raum bis 20.000 Einwohner sowie deren öffentlich-rechtliche Zusammenschlüsse, kommunale Unternehmen und gemeindliche Einrichtungen mit Sitz in Bayern.\n\nGemeinden im ländlichen Raum mit mehr als 20.000 bis 30.000 Einwohnern, sofern sie zu den \"Räumen mit besonderem Handlungsbedarf\" nach dem Landesentwicklungsprogramm Bayern (LEP) gehören. Damit sind Teilräume gemeint mit wirtschaftsstrukturellen oder sozioökonomischen Nachteilen sowie Teilräume, in denen eine nachteilige Entwicklung zu befürchten sind, wenn diese nicht gefördert werden.\n\nBei den größeren Gemeinden sind auch deren öffentlich-rechtliche Zusammenschlüsse, kommunale Unternehmen und gemeindliche Einrichtungen mit Sitz in Bayern antragsberechtigt.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Zuwendung wird als Projektförderung im Wege der Anteilfinanzierung als zweckgebundener Zuschuss oder zweckgebundene Zuweisung gewährt. Eine Förderung kann pro Gemeinde nur einmalig gewährt werden, wobei eine Kombination mehrerer Maßnahmen möglich ist. Die Projektlaufzeit beträgt höchstens 48 Monate.Im Falle der Etablierung von Mobilitätsangeboten für Ärztinnen und Ärzte oder Patientinnen und Patienten, insbesondere die Einrichtung von Patientenfahrdiensten erfolgt die Förderung als einmalige Anschubförderung.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Zuwendungsfähig sind ausschließlich Ausgaben, die in ursächlichem Zusammenhang mit den Maßnahmen stehen, zur Durchführung der Maßnahmen erforderlich sind und den Grundsätzen der Wirtschaftlichkeit und Sparsamkeit entsprechen. Zuwendungsfähig sind insbesondere Personal- und Sachausgaben, die unmittelbar dem Förderzweck zugeordnet werden können; Personalkosten sind nur dann zuwendungsfähig, wenn es sich um eigens zur Projektdurchführung eingestelltes Personal handelt. Die zur Erfüllung von Pflichtaufgaben der Gemeinden anfallenden Ausgaben sind nicht zuwendungsfähig ebenso wie Ausgaben für Bauarbeiten, mit Ausnahme von Umbaumaßnahmen, die beispielsweise der Verbesserung der Barrierefreiheit dienen, und Ausgaben für kommunale Regiearbeiten.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:monate>0</xflb:monate>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>48</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n               <xflb:euBeihilferelevanz>Die Bewilligungsbehörde hat in jedem einzelnen Förderfall zu prüfen, ob eine Beihilfe vorliegt. Soweit eine einzelne Förderung als Beihilfe im Sinn des EU-Beihilferechts anzusehen ist, prüft die Bewilligungsbehörde, ob die Voraussetzungen der Verordnung (EU) 2023/2832 der Kommission vom 13. Dezember 2023 über die Anwendung der Art. 107 und 108 AEUV auf De-minimis-Beihilfen an Unternehmen, die Dienstleistungen von allgemeinem wirtschaftlichem Interesse erbringen (sogenannte DAWI-De-minimis-Verordnung), des Beschlusses 2012/21/EU der Kommission vom 20. Dezember 2011 über die Anwendung von Art. 106 Abs. 2 AEUV auf staatliche Beihilfen in Form von Ausgleichsleistungen zugunsten bestimmter Unternehmen, die mit der Erbringung von Dienstleistungen von allgemeinem wirtschaftlichem Interesse betraut sind (sogenannter DAWI-Freistellungsbeschluss) oder der Verordnung (EU) 2023/2831 der Kommission vom 13. Dezember 2023 über die Anwendung der Art. 107 und 108 des Vertrags über die Arbeitsweise der Europäischen Union auf De-minimis-Beihilfen (sogenannte De-minimis-Verordnung) vorliegen. \nSofern eine DAWI-De-minimis-Beihilfe oder eine De-minimis-Beihilfe in Betracht kommt, hat der Antragsteller eine De-minimis-Erklärung gegenüber der Bewilligungsbehörde abzugeben. Dem Antragsteller wird bei Vorliegen der Voraussetzungen der DAWI-De-minimis-Verordnung oder der De-minimis-Verordnung eine De-minimis-Bescheinigung ausgehändigt. Diese ist vom Antragsteller zehn Jahre lang aufzubewahren und auf Anforderung der Europäischen Kommission, der Bundesregierung, der Landesverwaltung oder der bewilligenden Stelle innerhalb von einer Woche oder einer in der Anforderung festgesetzten längeren Frist vorzulegen. Der Antragsteller wird bei Vorliegen der Voraussetzungen der DAWI-De-minimis-Verordnung oder des DAWI-Freistellungsbeschlusses mit der jeweiligen Dienstleistung von allgemeinem wirtschaftlichem Interesse betraut. Wird die Bescheinigung innerhalb der Frist nicht vorgelegt, entfallen rückwirkend die Voraussetzungen für die Zahlung und die Beihilfen zuzüglich Zinsen werden zurückgefordert.\n\nBei der im Rahmen dieser Förderrichtlinie gewährten Zuwendung kann es sich um eine Subvention im Sinn des § 264 des Strafgesetzbuches handeln. Die für die Gewährung der Zuwendung maßgeblichen Tatsachen sind in diesen Fällen subventionserheblich im Sinn dieser Bestimmungen (vgl. Art. 1 des Bayerischen Strafrechtsausführungsgesetzes). In diesen Fällen ist mit dem Zuwendungsantrag eine entsprechende Erklärung abzugeben.</xflb:euBeihilferelevanz>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Gesundheit, Pflege und Prävention</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 44 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2126_0_G_14221/true</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 48, 49 und 49a Bayerisches Verwaltungsverfahrensgesetz (BayVwVfG)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVwVfG-G3_23</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 23 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO-23</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinie über die Förderung kommunalen Engagements für die ärztliche Versorgung vor Ort (Kommunalförderrichtlinie - KoFöR)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2126_0_G_14221/true</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat 31</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Förderung kommunalen Engagements  für die ärztliche Versorgung vor Ort</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2026-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2024-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2026-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n               <xflb:kummulierbareFoerderungen>\n                  <xflb:beschreibungAusschluss>Eine Förderung nach dieser Richtlinie entfällt, soweit für den gleichen Zweck andere Haushaltsmittel des Freistaates Bayern in Anspruch genommen werden.</xflb:beschreibungAusschluss>\n                  <xflb:verweise>\n                     <xflb:verweis>\n                        <xflb:bezeichnung>Website des Bayerischen Landesamt für Gesundheit und Lebensmittelsicherheit: Förderung des kommunalen Engagements für die ärztliche Versorgung vor Ort</xflb:bezeichnung>\n                        <xflb:link>https://www.lgl.bayern.de/gesundheit/gesundheitsversorgung/kommunalfoerderung/index.htm</xflb:link>\n                     </xflb:verweis>\n                  </xflb:verweise>\n                  <xflb:voraussetzungen>Eine Komplementärfinanzierung mit Mitteln der Kommunen, des Bundes oder der Europäischen Union ist möglich, soweit EU-beihilferechtlich zulässig.</xflb:voraussetzungen>\n               </xflb:kummulierbareFoerderungen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert werden Maßnahmen bayerischer Kommunen zum Erhalt oder zur Verbesserung der &lt;strong&gt;ambulanten medizinischen Versorgung vor Ort.&lt;/strong&gt; Förderfähig sind:&lt;/p&gt;&lt;ol&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;&lt;strong&gt;Aufbau von Einrichtungen der vernetzten Versorgung&lt;/strong&gt;, z. B. Gesundheitszentren, Primärversorgungszentren, Teampraxen oder intersektorale Gesundheitszentren. Jede Einrichtung muss mind. ein zur vertragsärztlichen Versorgung zugelassenes oder ermächtigtes &amp;nbsp;&lt;strong&gt;haus- oder kinderärztliches Versorgungsangebot&lt;/strong&gt; umfassen.&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;&lt;strong&gt;Gründung kommunaler Eigeneinrichtungen&lt;/strong&gt; nach § 105 Abs. 5 SGB V oder &lt;strong&gt;kommunaler medizinischer Versorgungszentren (MVZ)&lt;/strong&gt; nach § 95 Abs. 1a SGB V.&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;&lt;strong&gt;Service- und Beratungsangebote &lt;/strong&gt;zur Gewinnung von Ärztinnen und Ärzten, z. B. &amp;nbsp;Beratung zu Förderungen und Ansiedlung, Unterstützung bei der Suche nach Standort, &amp;nbsp;Praxisräumen, Wohnraum, Baugrundstücken oder Kindergartenplätzen.&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;&lt;strong&gt;Etablierung von Mobilitätsangeboten&lt;/strong&gt; für Ärztinnen, Ärzte oder Patientinnen und Patienten, z. B. Patientenfahrdienste.&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;&lt;strong&gt;Imagekampagnen und Marketingaktivitäten&lt;/strong&gt; zur Gewinnung von Ärztinnen und Ärzten.&lt;/li&gt;&lt;/ol&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>004</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>014</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>016</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Die Förderung setzt voraus, dass&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;ein zustimmender Beschluss des jeweiligen Kollegialorgans bezüglich der geplanten Maßnahme vorliegt,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;die Kassenärztliche Vereinigung Bayerns bei der Planung des Projekts beteiligt wurde und eine Stellungnahme zu der geplanten Maßnahme abgegeben hat und,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;der Zuwendungsempfänger sich verpflichtet, innerhalb von sechs Monaten nach Erlass des Zuwendungsbescheides mit der Umsetzung der Maßnahme zu beginnen; wenn und soweit die Einhaltung dieser Frist zu besonderen Härten führt, kann auf Antrag einer Fristverlängerung zugestimmt werden.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Mit dem Projekt darf noch nicht begonnen worden sein.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Ausgeschlossen sind Maßnahmen, die im Zusammenhang mit der Richtlinie zum Förderprogramm von Bürgerbusprojekten förderfähig sind und reine Machbarkeitsstudien.&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.lgl.bayern.de/gesundheit/gesundheitsversorgung/kommunalfoerderung/doc/Antragsformular.docx</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Die Bewilligungsbehörde entscheidet über die Anträge und erlässt Zuwendungsbescheide. Sofern dem Antrag nicht entsprochen werden kann, ergeht ein Ablehnungsbescheid. Die Auszahlung der Zuwendung erfolgt auf gesonderten Antrag. Der Verwendungsnachweis ist bei der Bewilligungsbehörde einzureichen und wird von dieser abschließend geprüft.&lt;/p&gt;</xflb:bewilligung>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Das Antragsformular samt Anlagen finden Sie unter Formularen. Folgende Anlagen sind dem Antrag beizulegen:</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Zustimmender Beschluss des jeweiligen Kollegialorgans</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Eine Stellungnahme der Kassenärztlichen Vereinigung Bayerns zum Vorhaben</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Bitte nutzen Sie für eine Kontaktaufnahme zur KVB folgende E-Mail-Adresse: regionale-versorgung@kvb.de</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Angaben zu den finanziellen Verhältnissen nach Muster 2a oder 2b zu Art. 44 BayHO</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Sofern die Herabsetzung des Eigenanteils gemäß Nr. 6.3 Satz 3 beantragt wird.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Detaillierte Projektbeschreibung</xflb:bezeichnung>\n                     <xflb:erlaeuterung>In der die Hintergründe und Ziele sowie die Bedeutung der Maßnahme für die wohnortnahe ärztliche Versorgung dargestellt werden.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Finanzierungsplan</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Erklärung zu den (DAWI-)De-minimis-Beihilfen</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Im Einzelfall kann die Bewilligungsbehörde auf die Vorlage bestimmter Unterlagen verzichten oder weitere Unterlagen anfordern.</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Verwaltungsgerichtliche Klage&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_89   [ xyz:attributes  [ xyz:antragsstellung      "https://www.lgl.bayern.de/downloads/gesundheit/bayerische_gesundheitsagentur/doc/antrag_stipendium_medizinstudierende.pdf";
