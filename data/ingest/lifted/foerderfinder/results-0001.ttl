                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>5c36ad34-3a10-431e-b4b9-bfe92aa6f799</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-08-29T15:12:11</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>5c36ad34-3a10-431e-b4b9-bfe92aa6f799</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>5c36ad34-3a10-431e-b4b9-bfe92aa6f799</xflb:schluessel>\n         <xflb:versionFLB>3</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-09-27T09:06:29</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>5c36ad34-3a10-431e-b4b9-bfe92aa6f799</xflb:foerderschluessel>\n                  <xflb:flbVersion>3</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>09000000144626</xflb:leikaSchluessel>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Bewerbung für die Auszeichnung des Bayerischen Demenzfonds</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Der Bayerische Demenzfonds vergibt jährlich bis zu drei Preise für wissenschaftliche Arbeiten, die sich mit praxisbezogenen Fragestellungen zur Verbesserung der Lebenssituation von Menschen mit Demenz, die zu Hause leben, sowie ihren An- und Zugehörigen beschäftigen.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Aus den Mitteln des Bayerischen Demenzfonds werden jährlich Preise für wissenschaftliche Arbeiten vergeben, die sich mit praxisbezogenen Fragestellungen zur Verbesserung der Lebenssituation von Menschen mit Demenz sowie ihren An- und Zugehörigen befassen.</xflb:teaser>\n                  <xflb:schluesselwoerter>Demenzfonds, Demenz-Auszeichnung, Demenzforschung, Demenzwissenschaft, Wissenschaft, Forschung</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:alternativeFoerdermoeglichkeiten>\n                  <xflb:alternativeFoerdermoeglichkeit>\n                     <xflb:beschreibung>Mit dem Bayerischen Demenzfonds fördert der Freistaat Bayern Angebote zur Teilhabe von Menschen mit Demenz und ihren An- und Zugehörigen sowie Programme zur Stärkung von demenzsensiblen Kommunen.</xflb:beschreibung>\n                     <xflb:verweis>\n                        <xflb:bezeichnung>Bayerischer Demenzfonds; Beantragung einer Förderung</xflb:bezeichnung>\n                        <xflb:link>https://www.bayernportal.de/dokumente/leistung/8113442994242</xflb:link>\n                     </xflb:verweis>\n                  </xflb:alternativeFoerdermoeglichkeit>\n               </xflb:alternativeFoerdermoeglichkeiten>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Bayerischer Demenzfonds</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/bayerischerdemenzfonds/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Bayerischer Demenzfonds - allgemeine Informationen (Bayerisches Staatsministerium für Gesundheit, Pflege und Prävention)</xflb:bezeichnung>\n                     <xflb:link>https://www.stmgp.bayern.de/service/foerderprogramme/bayerischer-demenzfonds/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Bayerische Demenzstrategie</xflb:bezeichnung>\n                     <xflb:link>https://www.stmgp.bayern.de/pflege/demenz/</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Landesamt für Pflege</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>4</xflb:hausnummerPostfach>\n                     <xflb:strasse>Mildred-Scheel-Straße</xflb:strasse>\n                     <xflb:postleitzahl>92224</xflb:postleitzahl>\n                     <xflb:ort>Amberg</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>poststelle@lfp.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Bayerisches Landesamt für Pflege</xflb:bezeichnung>\n                     <xflb:link>www.lfp.bayern.de</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>+49 9621 9669-0</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Bayerisches Landesamt für Pflege</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>4</xflb:hausnummerPostfach>\n                           <xflb:strasse>Mildred-Scheel-Straße</xflb:strasse>\n                           <xflb:postleitzahl>92224</xflb:postleitzahl>\n                           <xflb:ort>Amberg</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>poststelle@lfp.bayern.de</xflb:email>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Bayerisches Landesamt für Pflege</xflb:bezeichnung>\n                           <xflb:link>www.lfp.bayern.de</xflb:link>\n                        </xflb:verweis>\n                        <xflb:telefonnummer>+49 9621 9669-0</xflb:telefonnummer>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>5833b620-159b-4719-9e33-4a7bdf154fb9</xflb:id>\n                     <xflb:bezeichnung>Bewerbungsformular Wissenschaftspreis für die Vergabe von Auszeichnungen aus dem Bayerischen Demenzfonds</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/wp-content/uploads/2023/11/Bewerbungsformular-Auszeichnungen.pdf</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Absolventinnen und Absolventen sowie Nachwuchswissenschaftlerinnen und Nachwuchswissenschaftler aus unterschiedlichen Fachrichtungen können sich für die Preisverleihung bewerben. Willkommen sind wissenschaftliche Arbeiten aus den Bereichen Pflegewissenschaft, Psychologie, Architektur, Gerontologie sowie anderen Fachrichtungen. Es können sich aber auch Verbände, Vereine, Kommunen, Schulen, Organisationen und Einrichtungen des Gesundheits- und Sozialwesens, Körperschaften des öffentlichen Rechts sowie Unternehmen für die Preisverleihung bewerben.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Neben einer offiziellen Urkunde wird eine Geldprämie in Höhe von &lt;strong&gt;1.000 Euro &lt;/strong&gt;vergeben.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;keine&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:euBeihilferelevanz>Soweit nicht ausgeschlossen ist, dass die einzelne Förderung nach den Nrn. 1 und 2 als eine Beihilfe im Sinne des EU Beihilferechts anzusehen ist, hat die Bewilligungsbehörde zur Freistellung der Fördermaßnahme von der Anmeldepflicht bei der Kommission insbesondere die Verordnung (EU) Nr.\n1407/2013 (De-minimis-Verordnung) anzuwenden.</xflb:euBeihilferelevanz>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Gesundheit, Pflege und Prävention</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Teil 1 der Richtlinie für die Gewährung von Förderungen und Vergabe von Auszeichnungen aus dem Bayerischen Demenzfonds sowie zur Vergabe des Bayerischen Demenzpreises (Förderrichtlinie Demenz und Teilhabe, DEMTeil</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2038_3_11_G_13478</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat 42</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Richtlinie für die Gewährung von Förderungen und Vergabe von Auszeichnungen aus dem Bayerischen Demenzfonds</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2028-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2023-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2028-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Jährlich können Preise für wissenschaftliche Arbeiten, wie Bachelor- oder Masterarbeiten sowie Dissertationen oder Habilitationen, vergeben werden. Dadurch sollen praxisrelevante Erkenntnisse zur Verbesserung der Lebenssituation Betroffener und ihrer An- und Zugehörigen generiert werden.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Die Preise bestehen jeweils aus einer Urkunde und einer Geldprämie in Höhe von 1.000 EUR. Vergeben werden bis zu drei Preise pro Jahr.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Weitere Informationen für eine Antragstellung bzw. Bewerbung finden Sie auf der Website des Bayerischen Demenzfonds.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Wissenschaftliche Abschlussarbeiten - egal ob Bachelorarbeit, Masterarbeit, Dissertation oder Habilitation - kommen für eine Auszeichnung infrage, wenn&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;die Arbeit einen &lt;strong&gt;Bezug zu Menschen mit Demenz sowie deren An- und Zugehörigen im Freistaat Bayern&lt;/strong&gt; hat,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;die Arbeit zum Zeitpunkt der Bewerbung &lt;strong&gt;abgeschlossen&lt;/strong&gt; ist und&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;die Abgabe &lt;strong&gt;nicht länger als 18 Monate&lt;/strong&gt; zurückliegt.&lt;/li&gt;&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.lfp.bayern.de/wp-content/uploads/2023/11/Bewerbungsformular-Auszeichnungen.pdf</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Die Bewerbung ist bis spätestens 31. Dezember des Vorjahres (Eingang beim Landesamt für Pflege) einzureichen. Dazu ist das bereitgestellte Antragsformblatt zu verwenden. Zusätzlich sollen ein tabellarischer Lebenslauf, eine einseitige Zusammenfassung der Arbeit, ein PDF der Abschlussarbeit sowie ein Empfehlungsschreiben der Betreuerin beziehungsweise des Betreuers eingereicht werden. Die Unterlagen sollen&amp;nbsp;ausschließlich per E-Mail als pdf-Datei&amp;nbsp;geschickt werden:&lt;/p&gt;&lt;p&gt;E-Mail:&amp;nbsp;&lt;a href=\"mailto:demenzfonds@lfp.bayern.de?subject=Auszeichnungen%20Bayer.%20Demenzfonds\" title=\"Öffnet Ihr E-Mail Programm\" dir=\"ltr\"&gt;demenzfonds@lfp.bayern.de&lt;/a&gt;&amp;nbsp;mit dem Kennwort \"Auszeichnungen Bayer. Demenzfonds\"&lt;/p&gt;</xflb:bewilligung>\n               </xflb:verfahrensablauf>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristJaehrlich>31.12.</xflb:fristJaehrlich>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Einsendeschluss der Unterlagen ist jährlich der 31. Dezember beim Landesamt für Pflege.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Antragsformblatt</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Siehe Antrag unter Formular.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Tabellarischer Lebenslauf</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Einseitige Zusammenfassung der Arbeit</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Abschlussarbeit</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Im PDF-Format.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Empfehlungsschreiben des wissenschaftlichen Betreuers</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Gegen den Zuwendungsbescheid können Sie mit einer Klage zum Verwaltungsgericht innerhalb eines Monats nach seiner Bekanntgabe Klage erheben. Das zuständige Gericht, bei dem Sie Klage einreichen können, wird Ihnen im Bescheid mitgeteilt.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_203  [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rop/b2/23/rop_23-016/index";
