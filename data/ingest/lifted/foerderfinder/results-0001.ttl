                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:euBeihilferelevanz        "Verordnung (EU) Nr. 651 2014 (Allgemeine Gruppenfreistellungsverordnung  AGVO); \nInvestitionsbeihilfen zur Förderung von erneuerbaren Energien, von erneuerbarem Wasserstoff und von hocheffizienter\nKraft-Wärme-Kopplung (Art. 41)";
                                                                                                                                           xyz:finanzierungsartUndHoehe  "Die Zuwendungssumme soll fünf Millionen Euro nicht überschreiten. Die Zuwendung (Beihilfeintensität) für die im Rahmen des Vorhabens gemachten Ausgaben beträgt bis zu 45 % der zuwendungsfähigen Ausgaben gem. Art. 41 Abs. 7 Buchst. a) AGVO. Bei Beihilfen für mittlere Unternehmen kann die Intensität um bis zu 10 Prozentpunkte, bei Beihilfen für kleine Unternehmen um bis zu 20 Prozentpunkte erhöht werden (Art. 41 Abs. 8 AGVO). Die tatsächliche Erhöhung der Beihilfeintensität wird durch den Zuwendungsgeber unter Berücksichtigung der wirtschaftlichen Leistungsfähigkeit des Zuwendungsempfängers und der Lage des Investitionsortes im Zuwendungsbescheid festgelegt.";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "001";
                                                                                                                                                                                                    xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
                                                                                                                                                                                                    xyz:listVersionID  "1";
                                                                                                                                                                                                    xyz:name           ""
                                                                                                                                                                                                  ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:laufzeitFinanzierung      [ xyz:laufzeitFinanzierung  [ xyz:code           "001";
                                                                                                                                                                                                       xyz:listURI        "urn:xoev-de:stmd:codeliste:laufzeit-finanzierung";
                                                                                                                                                                                                       xyz:listVersionID  "1";
                                                                                                                                                                                                       xyz:name           "Gesamte Projektlaufzeit"
                                                                                                                                                                                                     ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1";
                                                                                                                                                                           xyz:name           ""
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "Zuwendungsfähig sind die gesamten Investitionskosten, die für die Neuerrichtung von Elektrolyseuren und unmittelbar damit verbundene Anlagenbestandteile zur bedarfsgerechten Erzeugung von erneuerbarem Wasserstoff erforderlich sind (Art. 41 Abs. 6 AGVO). Nicht zuwendungsfähig sind die Ausgaben der Infrastruktur für die Verteilung und Übertragung des Wasserstoffs, Batterie-Speicher, zugehörige Stromerzeugungsanlagen und Anlagen zur Rückverstromung sowie für den Erwerb von Grundstücken. Ausgaben für den Betrieb der Anlage sind ebenfalls nicht zuwendungsfähig. Soweit die Umsatzsteuer nach § 15 des Umsatzsteuergesetzes (UStG) als Vorsteuer abziehbar ist, gehört sie nicht zu den zuwendungsfähigen Ausgaben."
                                                                                                                                         ];
