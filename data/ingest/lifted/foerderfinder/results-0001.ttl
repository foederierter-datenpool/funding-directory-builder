                                                                                                                                           xyz:erforderlicheUnterlagen  [ xyz:dokument  [ rdf:_1  [ xyz:bezeichnung  "Antrag über die Errichtung eines Pflegestützpunktes gem. Anlage 1 des Rahmenvertrags zur Arbeit und zur Finanzierung der Pflegestützpunkte nach § 7c Abs. 6 Sozialgesetzbuch (SGB) - Elftes Buch (XI) in Bayern" ];
                                                                                                                                                                                          rdf:_2  [ xyz:bezeichnung  "Vertrag über die Errichtung eines Pflegestützpunktes (Stützpunktvertrag) gem. Anlage 2 des Rahmenvertrags" ];
                                                                                                                                                                                          rdf:_3  [ xyz:bezeichnung  "Konzept mit ausführlicher Beschreibung der Maßnahme für den Förderzeitraum" ];
                                                                                                                                                                                          rdf:_4  [ xyz:bezeichnung  "Weitere Informationen für eine Antragstellung finden Sie auf der Homepage des Bayerischen Landesamtes für Pflege" ]
                                                                                                                                                                                        ]
                                                                                                                                                                        ];
                                                                                                                                           xyz:linkZurAntragsstellung   "https://www.lfp.bayern.de/wp-content/uploads/2022/12/Antragsformblatt_Pflegestuetzpunkte_Regelfoerderung_BFP.pdf";
                                                                                                                                           xyz:rechtsbehelf             "<p>Gegen den Zuwendungsbescheid können Sie innerhalb eines Monats nach seiner Bekanntgabe Klage erheben. Das zuständige Gericht, bei dem Sie Klage einreichen können, wird Ihnen im Bescheid mitgeteilt.</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung
                                                                                                                                                             "<p>Der Antrag auf Förderung ist schriftlich oder elektronisch beim Bayerischen Landesamt für Pflege zu stellen. Die bereitgestellten Vordrucke sind zu verwenden.</p>" ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:euBeihilferelevanz        "Die Prüfung der Freistellung der Fördermaßnahme von der Anmeldepflicht bei der EU-Kommission erfolgt im Rahmen der Antragsbearbeitung durch die Bewilligungsbehörde.";
                                                                                                                                           xyz:finanzierungsartUndHoehe  "<ul><li class=\"unordered-list-item--dash\">Die Förderpauschale beträgt für eine vollzeitbeschäftigte Fachkraft jährlich bis zu 20.000 EUR. Berücksichtigungsfähig ist nur der kommunale Anteil, maximal im Umfang einer Vollzeitstelle.&nbsp;</li><li class=\"unordered-list-item--dash\">Bei einer räumlichen Anbindung an eine Fachstelle für pflegende Angehörige, die durch eine Bescheinigung der Fachstelle für pflegende Angehörige nachzuweisen ist, erhöht sich die Förderpauschale für insgesamt maximal drei Jahre um jährlich bis zu 3.000 EUR.&nbsp;</li></ul><p>Die Zuwendung wird als Festbetragsfinanzierung im Rahmen einer Projektförderung gewährt.</p>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "003";
                                                                                                                                                                                                    xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
                                                                                                                                                                                                    xyz:listVersionID  "1";
                                                                                                                                                                                                    xyz:name           ""
                                                                                                                                                                                                  ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Zuwendungsfähig sind Personalausgaben, die der Kommune aufgrund der Beteiligung an der Trägerschaft des Pflegestützpunktes entstehen.</p>"
                                                                                                                                         ];
                                                                                                             xyz:foerderbereich          [ xyz:foerderbereich  [ xyz:code           "004";
