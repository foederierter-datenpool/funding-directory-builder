                                xyz:foerdernehmer        [ rdf:_1  "Kommunen";
                                                           rdf:_2  "Vereine";
                                                           rdf:_3  "Verbände";
                                                           rdf:_4  "Stiftungen";
                                                           rdf:_5  "Behörden"
                                                         ];
