                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>2a567659-ff4e-44e4-a672-e0622d8dd809</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2026-01-16T14:33:26</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>2a567659-ff4e-44e4-a672-e0622d8dd809</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>2a567659-ff4e-44e4-a672-e0622d8dd809</xflb:schluessel>\n         <xflb:versionFLB>1</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-01-16T14:33:26</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>2a567659-ff4e-44e4-a672-e0622d8dd809</xflb:foerderschluessel>\n                  <xflb:flbVersion>1</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99098002027000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Sport- und Schützenverein (Vereinspauschale)</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Die Vereinspauschale dient der finanziellen Unterstützung der Sport- und &amp;nbsp;Schützenvereine bei der Bewältigung ihrer vielfältigen Aufgaben im &amp;nbsp;Zusammenhang mit der Organisation des Sportbetriebs.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern unterstützt den Sportbetrieb in den Sport- und Schützenvereinen in Form einer Vereinspauschale. Die Zuschüsse müssen bis spätestens zum 1. März des Förderjahres bei der zuständigen Kreisverwaltungsbehörde beantragt werden.</xflb:teaser>\n                  <xflb:schluesselwoerter>Sport, Sportbetrieb, Verein, Sport und Schützenverein, Sportverein, Schützenverein, Vereinspauschale</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Homepage des Bayerischen Staatsministerium des Innern, für Sport und Integration mit weiterführenden Informationen zur Vereinspauschale.</xflb:bezeichnung>\n                     <xflb:link>https://www.stmi.bayern.de/a-z/anzeigen/vereinspauschale/</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Kreisverwaltungsbehörde</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>a1473597-c7fa-440d-a67f-43d41ee9257e</xflb:id>\n                     <xflb:bezeichnung>Erklärung zur Teilung von Lizenzen</xflb:bezeichnung>\n                     <xflb:link>https://www.stmi.bayern.de/media/_bayernportal/vp-2024-erklaerung-zur-teilung-von-lizenzen.pdf</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n               <xflb:onlinedienste>\n                  <xflb:onlinedienst>\n                     <xflb:id>2d71c2a4-d981-4480-8b7e-29fe962e7654</xflb:id>\n                     <xflb:bezeichnung>Link zur Beantragung der Förderung über die HKSoftware</xflb:bezeichnung>\n                     <xflb:link>https://vereinspauschale.de/</xflb:link>\n                     <xflb:beschreibung>Hier kann man die Vereinspauschale über die HKSoftware bei allen teilnehmenden Kreisverwaltungsbehörden beantragen.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n                  <xflb:onlinedienst>\n                     <xflb:id>d4ae91dd-d9fd-4089-bfa8-6ca170c00b9b</xflb:id>\n                     <xflb:bezeichnung>Link zur Beantragung</xflb:bezeichnung>\n                     <xflb:link>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/vereinspauschale/index?caller=bpgi2wky3ggfqwgojxg5sgczbvgs22yfbuq7nzi5h2qvjsyhjfccsgnec7wlproftr7hvwhqqhs77pkcnp64but6svkchxdkd4uuetzbdqtcrr4mjuk5vhpwddg77mxophj4i7k5r2ke54fjgvmnyarqsgwwww67m6pqi4nfdsd6i7xp3kj642s6tbq2wffvqylx4mgaegsy3hq888</xflb:link>\n                     <xflb:beschreibung>Hier kann man die Vereinspauschale über den Formularserver beantragen.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n               </xflb:onlinedienste>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Gemeinnützige Vereine mit Rechtspersönlichkeit mit Sitz in Bayern, deren Satzung als Vereinszweck die Pflege des Sports oder einer Sportart enthält.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Es handelt sich um eine Festbetragsfinanzierung. Die Höhe der Vereinspauschale bemisst sich nach den auf den jeweiligen &amp;nbsp;Verein für das Förderjahr entfallenden Fördereinheiten. Der Wert einer &amp;nbsp;Fördereinheit wird auf der Grundlage der im Förderjahr für die Gewährung &amp;nbsp;der Vereinspauschale zur Verfügung stehenden Haushaltsmittel sowie der &amp;nbsp;Gesamtzahl der für das Förderjahr beantragten berücksichtigungsfähigen &amp;nbsp;Fördereinheiten ermittelt.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Die Anzahl der Fördereinheiten je Verein bestimmt sich nach der Anzahl &amp;nbsp;seiner Mitglieder sowie den Trainer- und Übungsleiterlizenzen, die im &amp;nbsp;Förderjahr eingesetzt werden sollen.&lt;/p&gt;\n&lt;p&gt;Die Mitglieder werden dabei wie folgt gewichtet:&lt;/p&gt;\n&lt;ul&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Mitglieder unter 27 Jahren zehnfach und&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;alle übrigen Mitglieder einfach.&lt;/li&gt;\n&lt;/ul&gt;\n&lt;p&gt;Mitglieder mit Behinderung können unter bestimmten Voraussetzungen ebenfalls zehnfach gewichtet werden.&lt;/p&gt;\n&lt;p&gt;Trainer- und Übungsleiterlizenzen sind berücksichtigungsfähig, wenn &amp;nbsp;sie in der vom Staatsministerium jährlich veröffentlichten Liste &amp;nbsp;enthalten sind und im Förderjahr im Verein eingesetzt werden sollen.&amp;nbsp;Bei &amp;nbsp;der Berechnung werden die Lizenzen entsprechend den sich aus der &amp;nbsp;Lizenzliste ergebenden Punktwerten gewichtet. Die Anzahl der Lizenzen &amp;nbsp;die je Verein geltend gemacht werden können ist begrenzt.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium des Innern, für Sport und Integration</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinien über die Gewährung von Zuwendungen des Freistaates Bayern zur Förderung des organisierten Sports (Sportförderrichtlinien - SportFöR)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2273_I_13469</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Sachgebiet H2 (Sportförderung)</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Sportförderung</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2028-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2023-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2028-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Die Vereinspauschale wird für ein Haushaltsjahr gewährt und kann entsprechend ihrer Zweckbestimmung für Ausgaben im personellen (zum Beispiel Beschäftigung von Trainern und Übungsleitern) und sachlichen Bereich (zum Beispiel Bewirtschaftung der notwendigen Räume und Flächen, Ausstattung mit Sport- oder Pflegegeräten) eingesetzt werden.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>013</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Antragsberechtigt sind gemeinnützige Sport- und Schützenvereine mit Sitz in Bayern, die Mitglied bei einem anerkannten Dachverband sind und bestimmte Mindestvoraussetzungen in Bezug auf ihre Finanz- und Kassenverhältnisse und die Jugendarbeit erfüllen und eine Mindestanzahl von 500 Fördereinheiten erreichen.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:rechtlicheBeschreibung>&lt;p&gt;Die Anzahl der Fördereinheiten je Verein bestimmt sich nach der Anzahl seiner Mitglieder sowie den Trainer- und Übungsleiterlizenzen, die im Förderjahr eingesetzt werden sollen.&lt;/p&gt;</xflb:rechtlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Um eine Vereinspauschale zu erhalten muss ein Verein mindestens 500 Mitgliedereinheiten erreichen.&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/vereinspauschale/index?caller=bpgi2wky3ggfqwgojxg5sgczbvgs22yfbuq7nzi5h2qvjsyhjfccsgnec7wlproftr7hvwhqqhs77pkcnp64but6svkchxdkd4uuetzbdqtcrr4mjuk5vhpwddg77mxophj4i7k5r2ke54fjgvmnyarqsgwwww67m6pqi4nfdsd6i7xp3kj642s6tbq2wffvqylx4mgaegsy3hq888</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Der Antrag auf Gewährung der Vereinspauschale ist bei den Kreisverwaltungsbehörden einzureichen und muss dort vollständig mit allen Angaben und Anlagen spätestens am 1. März des Förderjahres (Ausschlussfrist) eingegangen sein. Auf der Grundlage aller beantragten und berücksichtigungsfähigen Fördereinheiten sowie der im Förderjahr zur Verfügung stehenden Haushaltsmittel wird der Wert einer Fördereinheit ermittelt. Die Kreisverwaltungsbehörden errechnen aus der Anzahl der für den Verein jeweils berücksichtigungsfähigen Fördereinheiten sowie dem Wert der Fördereinheit die Höhe der Vereinspauschale im Förderjahr und zahlt diese an den Verein aus.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>001</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerFest>\n                        <xflb:monate>6</xflb:monate>\n                     </xflb:dauerFest>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristJaehrlich>01.03.</xflb:fristJaehrlich>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Dies ist der Stichtag für die Abgabe von Anträgen auf Gewährung der Vereinspauschale eines Förderjahres. Es handelt sich hierbei um eine Ausschlussfrist. Verspätet eingegangene Anträge können nicht mehr berücksichtigt werden.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Erklärung zur Teilung von Lizenzen</xflb:bezeichnung>\n                     <xflb:erlaeuterung>(siehe unter \"Formulare\")</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Gegen den Zuwendungsbescheid können Sie innerhalb von einem Monat Klage vor dem Verwaltungsgericht erheben. Das zuständige Gericht, bei dem Sie Klage einreichen können, wird Ihnen im Bescheid mitgeteilt.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_141  [ xyz:attributes  [ xyz:antragsstellung      "https://foerderung.bayern.de/landingpage/bdd87fd4-4991-4e8e-9edb-fc35102f3766";
                                xyz:begriffeImKontext    [ rdf:_1  "Grund- und Mittelschulen";
                                                           rdf:_2  "Beförderung";
                                                           rdf:_3  "Schwerbehinderung"
                                                         ];
                                xyz:beschreibung         "<p>Durch die staatlichen Zuschüsse sollen private Träger unterstützt werden. Finanzhilfen für die Beförderung von schwerbehinderten Schülerinnen und Schülern privater Grund- und Mittelschulen.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Aus und Weiterbildung";
                                                           rdf:_2  "Integration"
                                                         ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Einzelunternehmen" ];
                                xyz:foerderprogramm      "Beförderung von Schülerinnen und Schüler mit Schwerbehinderung";
                                xyz:foerderzeitraum.bis  "2030-11-30T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2024-11-30T00:00:00.000+00:00";
                                xyz:schluessel           "980da20b-e8db-472f-a408-5682329c1ad7";
                                xyz:teaser               "Schulaufsichtlich genehmigte private Grundschulen und Mittelschulen können Sonderzuschüsse für die Beförderung von Schülerinnen und Schüler mit nachgewiesener Schwerbehinderung erhalten.";
                                xyz:titel                "Sonderzuschuss für die Beförderung von Schülerinnen und Schülern mit Schwerbehinderung";
                                xyz:titel.tokens         [ rdf:_1  "Sonderzuschuss für die Beförderung von Schülerinnen und Schülern mit Schwerbehinderung" ];
                                xyz:voraussetzung        "<p>Voraussetzungen sind unter anderem:&nbsp;</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">Beförderung einer Schülerin oder eines Schülers, wenn auf Grund einer durch einen Schwerbehindertenausweis mit dem Merkzeichen \"G\", \"aG\", \"H\" oder \"Bl\" nachgewiesenen Schwerbehinderung die Beförderung mit einem speziellen Kraftfahrzeug auf dem Schulweg zwischend erforderlich ist&nbsp;</li>\n  <li class=\"unordered-list-item--dash\">Nachweis der Gemeinnützigkeit des Schulträgers (Art. 29 Abs. 2 BaySchFG)&nbsp;</li>\n  <li class=\"unordered-list-item--dash\">Vorliegen einer schulaufsichtlichen Genehmigung der Schule nach Art. 92 ff. BayEUG&nbsp;</li>\n  <li class=\"unordered-list-item--dash\">Leistungen werden erst gewährt, wenn die Schule mindestens zwei Jahre ohne wesentliche schulaufsichtliche Beanstandungen bestanden hat.</li>\n  <li class=\"unordered-list-item--dash\">Schulen mit weniger als 14 Schülerinnen und Schüler erhalten keinen Zuschuss.</li>\n</ul>"
                              ];
              xyz:id          "980da20b-e8db-472f-a408-5682329c1ad7";
              xyz:payload     [ xyz:json  [ xyz:anfrage            [ xyz:anfragenummer  "980da20b-e8db-472f-a408-5682329c1ad7";
