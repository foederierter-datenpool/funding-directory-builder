                                                                                                                                                                       rdf:_2  [ xyz:bezeichnung  "Art. 23 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)";
                                                                                                                                                                                 xyz:link         "https://www.gesetze-bayern.de/Content/Document/BayHO-23"
                                                                                                                                                                               ]
                                                                                                                                                                     ]
                                                                                                                                                      ];
