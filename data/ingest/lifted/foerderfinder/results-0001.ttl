                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>bc6651d6-6bec-468d-ac7f-dc7e08692c63</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2025-02-27T11:25:53</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>bc6651d6-6bec-468d-ac7f-dc7e08692c63</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>bc6651d6-6bec-468d-ac7f-dc7e08692c63</xflb:schluessel>\n         <xflb:versionFLB>5</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-08-20T08:28:56</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>bc6651d6-6bec-468d-ac7f-dc7e08692c63</xflb:foerderschluessel>\n                  <xflb:flbVersion>5</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>09999000000032</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Kulturförderung für Vertriebene und Flüchtlinge nach dem Zweiten Weltkrieg</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Die Zuwendung dient der Förderung von Maßnahmen zur Bewahrung, Vermittlung und Weiterentwicklung des Kulturguts der deutschen Heimatvertriebenen, Aussiedler und Spätaussiedler sowie zur Stärkung ihrer kulturellen Identität und Teilhabe. Ziel ist es, das Kulturerbe der Vertreibungsgebiete zu erhalten, in das kulturelle Leben in Bayern einzubinden und generationenübergreifend zugänglich zu machen.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern fördert kulturelle Projekte zur Pflege, Vermittlung und Weiterentwicklung des Kulturerbes deutscher Heimatvertriebener und Spätaussiedler, die infolge des Zweiten Weltkriegs ihre Heimat verlassen mussten.</xflb:teaser>\n                  <xflb:schluesselwoerter>Vertriebene, Krieg, Sudetendeutsche, Böhmen, Mähren, Siebenbürgen, Spätaussiedler, Kulturförderung, Kultur, Spätaussiedler, Erinnerungskultur, Vertreibung, Zweiter Weltkrieg, BVFG, Aussiedler, Heimatvertriebene, Gedenkarbeit, Integration, kulturelles Erbe</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Grundlagen und notwendige Formulare für die Antragstellung</xflb:bezeichnung>\n                     <xflb:link>https://www.hdo.bayern.de/foerderung/faq/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Antragsformulare für die Kulturförderung des Haus des Deutschen Ostens (HDO)</xflb:bezeichnung>\n                     <xflb:link>https://www.hdo.bayern.de/foerderung/formulare/</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Haus des Deutschen Ostens</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>5</xflb:hausnummerPostfach>\n                     <xflb:strasse>Am Lilienberg 5</xflb:strasse>\n                     <xflb:postleitzahl>81669</xflb:postleitzahl>\n                     <xflb:ort>München</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>poststelle@hdo.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Website des Hauses des Deutschen Ostens (HDO)</xflb:bezeichnung>\n                     <xflb:link>https://hdo.bayern.de</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>089 4499930</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Haus des Deutschen Ostens</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>5</xflb:hausnummerPostfach>\n                           <xflb:strasse>Am Lilienberg</xflb:strasse>\n                           <xflb:postleitzahl>81669</xflb:postleitzahl>\n                           <xflb:ort>München</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>poststelle@hdo.bayern.de</xflb:email>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Website der zuständigen Stelle</xflb:bezeichnung>\n                           <xflb:link>www.hdo.bayern.de</xflb:link>\n                        </xflb:verweis>\n                        <xflb:telefonnummer>089 449993 0</xflb:telefonnummer>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>7a8e4ee8-75a2-42f3-98d9-bfdc7dff1cbd</xflb:id>\n                     <xflb:bezeichnung>Projektantrag Kulturförderung nach § 96 BVFG</xflb:bezeichnung>\n                     <xflb:link>https://www.hdo.bayern.de/imperia/md/content/stmas/hdo_2024/projektantrag_2023.doc</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>9bc2d063-462d-406c-a28d-ebcdc5bfd73e</xflb:id>\n                     <xflb:bezeichnung>Auszahlungsantrag</xflb:bezeichnung>\n                     <xflb:link>https://www.hdo.bayern.de/imperia/md/content/stmas/hdo_2024/auszahlungsantrag_2025_1.docx</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>006</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Antragsberechtigt sind Betreibende von Kultureinrichtungen wie Archive, Museen und Bibliotheken, wissenschaftliche Einrichtungen, künstlerische Träger sowie spezialisierte Institutionen sein, die sich mit dem Kulturgut der Vertreibungsgebiete befassen.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Finanzierungsarten können Fehlbedarfsfinanzierung, Festbetragsfinanzierung oder die anteilieg Fehlbedarfsfinanzieung, jeweils bis zu einer maximalen im Bescheid vorgegebenen Höhe, sein.&lt;/p&gt;&lt;p&gt;Es ist ein Mindestbetrag von 10% der Gesamtkosten als Eigenmittel zu erbringen.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Projekte welche sich mit der Kultur der deutschen Vetriebenen und Spätaussiedler beschäftigen.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:monate>1</xflb:monate>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>12</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Familie, Arbeit und Soziales</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Gesetz über die Angelegenheiten der Vertriebenen und Flüchtlinge (Bundesvertriebenengesetz - BVFG) § 96 Pflege des Kulturgutes der Vertriebenen und Flüchtlinge und Förderung der wissenschaftlichen Forschung</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-im-internet.de/bvfg/BJNR002010953.html</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 44 BayHO</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN44</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Ref. III 4</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Kulturförderung nach § 96 Bundesvertrieben- und Flüchtlingsgesetz</xflb:programmtitel>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2007-08-10</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>9999-01-01</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:verlaengerungsoption>Kein Ende der Förderung derzeit festgelegt</xflb:verlaengerungsoption>\n               </xflb:programmlaufzeit>\n               <xflb:kummulierbareFoerderungen>\n                  <xflb:beschreibungAusschluss>Eine Mehrfachförderung aus dem Haushalt des Freistaates Bayern ist nicht möglich.</xflb:beschreibungAusschluss>\n                  <xflb:verweise>\n                     <xflb:verweis>\n                        <xflb:bezeichnung>Website Haus des Deutschen Ostens</xflb:bezeichnung>\n                        <xflb:link>https://www.hdo.bayern.de/</xflb:link>\n                     </xflb:verweis>\n                  </xflb:verweise>\n                  <xflb:voraussetzungen>&lt;p&gt;Die anderen Zuwendungsgeber sind im Förderantrag mit Anschrift und eventuell Ansprechpartner anzugeben.&amp;nbsp;&lt;/p&gt;</xflb:voraussetzungen>\n               </xflb:kummulierbareFoerderungen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert werden Projekte die der Erhaltung und Weiterentwicklung der Kultur der deutschen Vertreibenen und Spätausiedler&amp;nbsp;dienen. Gefördert werden insbesondere:&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;kulturelle Projekte mit Bezug zur Geschichte, Sprache, Religion oder Tradition der Vertriebenen,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Veranstaltungen und Bildungsangebote zur Erinnerungskultur,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Maßnahmen zur kulturellen Integration und Begegnung,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;wissenschaftliche Forschungsvorhaben, Dokumentationen und Publikationen,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;die Arbeit von Institutionen mit besonderem Bezug zu § 96 BVFG.&lt;/li&gt;&lt;/ul&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>013</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Sie müssen Ihren Wohnsitz oder Sitz in Bayern oder in den ehemaligen Siedungsgebieten in Ost- / Südosteuropa haben.&lt;a href=\"http://haben.er\"&gt;&lt;/a&gt;Der Ort der Maßnahme kann im In- und Ausland liegen.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Sie müssen 10% der Gesamtkosten des Projektes als Eigenmittel aufbringen.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;&amp;nbsp;Sie müssen einen ordnungsgemäßen Ablauf des Projektes und Nachweis der Verwendung der Zuwendung leisten können&lt;/li&gt;&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Sie haben Ihren Wohnsitz oder Sitz nicht in Bayern oder in den Siedlungsgebieten.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Sie können keine 10% Eigenmittel erbringen.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;&amp;nbsp;Sie sind nicht in der Lage einen ordnungsgemäßen Nachweis der Verwendung zu erbringen.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Zuwendungen dürfen nur für solche Projekte bewilligt werden, die noch nicht begonnen wurden.&lt;/li&gt;&lt;/ul&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.hdo.bayern.de/imperia/md/content/stmas/hdo_2024/projektantrag_2023.doc</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Nach einer Prüfung des Antrages Ende Januar/ Anfang Februar des Durchführungsjahres des Projektes erhalten Sie dann vom Haus des Deutschen Osten einen Bescheid oder es erfolgen Nachfragen&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>&lt;p&gt;Für den vorzeitigen Maßnahmebeginn muss ein schriftlicher formloser Antrag mit einer Begründung gestellt werden, der entweder genehmigt oder abgelehnt wird.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:monate>3</xflb:monate>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>9</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristJaehrlich>30.11.</xflb:fristJaehrlich>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Die Anträge sind immer bis zum 30. November des Vorjahres zu stellen.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Verwendungsbestätigung</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Mit diesem Formular bestätigen Sie die zweckentsprechende Verwendung der Fördermittel gemäß Zuwendungsbescheid. Geben Sie die tatsächlichen Ausgaben an und fügen Sie alle erforderlichen Nachweise bei.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Belegliste</xflb:bezeichnung>\n                     <xflb:erlaeuterung>In der Belegliste dokumentieren Sie alle einzelnen Ausgaben Ihrer Maßnahme. Die Angaben müssen prüffähig sein und mit den eingereichten Belegen übereinstimmen.</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Gegen den Bescheid kann Klage bei dem Bayerischen Verwaltungsgericht in München erhoben werden.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_63   [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver-bp.bayern.de/intelliform/forms/rzsued/stmgp/stmgp/staerkung_pflege/index";
                                xyz:begriffeImKontext    [ rdf:_1  "Pflege";
                                                           rdf:_2  "Fortbildung";
                                                           rdf:_3  "Resilienz";
                                                           rdf:_4  "Personalführung";
                                                           rdf:_5  "Organisationsentwicklung"
                                                         ];
                                xyz:beschreibung         "<p>Die Förderung dient der Unterstützung von Maßnahmen zur Stärkung der Führungskompetenzen und der Resilienz der in Pflegeeinrichtungen tätigen Personen in Bayern. Fortbildungen bilden den nötigen Raum, diese Kompetenzen gezielt zu fördern und weiterzuentwickeln und leisten einen Beitrag zur Sicherung einer qualitativ hochwertigen Pflege und Betreuung in der ambulanten wie in der stationären Langzeitpflege.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Gesundheit und Soziales" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Kleine und mittlere Unternehmen";
                                                           rdf:_2  "Einzelunternehmen";
                                                           rdf:_3  "Großunternehmen";
                                                           rdf:_4  "Kommunen";
                                                           rdf:_5  "Vereine";
                                                           rdf:_6  "Verbände";
                                                           rdf:_7  "Stiftungen"
                                                         ];
                                xyz:foerderprogramm      "Richtlinie zur Förderung von Maßnahmen zur Stärkung der Führungskompetenzen und Resilienz der Beschäftigten in Pflegeeinrichtungen (Förderrichtlinie Fortbildung Pflege - FoPfFöR)";
                                xyz:foerderzeitraum.bis  "2027-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2026-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "bcd0723a-9166-497c-a464-73a99d0a8ead";
                                xyz:teaser               "Der Freistaat Bayern fördert Maßnahmen zur Stärkung der Führungskompetenzen und Resilienz der Beschäftigten in Pflegeeinrichtungen.";
                                xyz:titel                "Pflegeeinrichtungen; Beantragung einer Förderung für Fortbildungsmaßnahmen";
                                xyz:titel.tokens         [ rdf:_1  "Pflegeeinrichtungen";
                                                           rdf:_2  "Beantragung einer Förderung für Fortbildungsmaßnahmen"
                                                         ];
                                xyz:voraussetzung        "<p>Voraussetzung für eine Förderung ist</p><p>a) der Nachweis der fachlichen Notwendigkeit einer Fortbildungsmaßnahme, insbesondere bei Veränderungen in den Strukturen und Prozessen in den Einrichtungen, Wechsel in der Leitung und außerordentlichen Belastungen</p><p>b) die Vorlage eines Angebotes eines zertifizierten Anbieters (TÜV oder vergleichbare andere Institution) mit Informationen zum Inhalt, Dauer, Datum und Kosten der Maßnahme sowie</p><p>c) die Benennung der Führungskraft, der Führungsposition und deren Verantwortungsbereich oder der Mitarbeitenden, die die Maßnahme wahrnehmen sollen.</p>"
                              ];
              xyz:id          "bcd0723a-9166-497c-a464-73a99d0a8ead";
