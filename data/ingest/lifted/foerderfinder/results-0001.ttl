                                                                                                                                                                      xyz:name           ""
                                                                                                                                                                    ]
                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergegenstand       [ xyz:beschreibung
                                                                                                                               "<p>Ergänzend zu den bereits staatlich geförderten schulischen und außerschulischen Maßnahmen wird außerschulische Hausaufgabenhilfe mit Schwerpunkt Deutschförderung gewährt.</p>" ];
                                                                                                             xyz:foerdernehmende         [ xyz:beschreibung     "Zuwendungsempfänger ist die unterrichtende\nLehrkraft.";
