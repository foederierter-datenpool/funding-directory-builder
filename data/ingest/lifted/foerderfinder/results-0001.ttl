                                                                                                                                                                                                     ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Die Förderung erfolgt in Anlehnung an die Zuweisungsrichtlinie des Freistaates Bayern für kommunale Baumaßnahmen im kommunalen Finanzausgleich (FAZR). Notwendige und schulaufsichtlich genehmigte Baumaßnahmen werden unterstützt, wenn sie im öffentlichen Interesse liegen. Förderberechtigt sind staatlich anerkannte Ersatzschulen, private Schülerheime gemeinnütziger Träger sowie staatlich genehmigte Schulen, sofern diese die Voraussetzungen des Art. 45 Abs. 2 BaySchFG erfüllen.</p>"
                                                                                                                                         ];
                                                                                                             xyz:foerderbereich          [ xyz:foerderbereich  [ xyz:code           "012";
                                                                                                                                                                 xyz:listURI        "urn:xoev-de:stmd:codeliste:foerderbereich";
                                                                                                                                                                 xyz:listVersionID  "1";
                                                                                                                                                                 xyz:name           ""
                                                                                                                                                               ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergebiet           [ xyz:laender  [ xyz:land  [ xyz:code           "BY";
                                                                                                                                                                      xyz:listURI        "urn:xoev-de:pks:codeliste:bundesland";
                                                                                                                                                                      xyz:listVersionID  "1";
                                                                                                                                                                      xyz:name           ""
                                                                                                                                                                    ]
                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergegenstand       [ xyz:beschreibung
                                                                                                                               "<p>Den Trägern privater staatlich anerkannter sowie genehmigter Realschulen, Gymnasien, Freier Waldorfschulen (ab Jahrgangsstufe 5), beruflicher Schulen sowie Schulen des Zweiten Bildungsweges kann gemäß der Art. 43, 45 Abs. 3 Bayerisches Schulfinanzierungsgesetz (BaySchFG) zu notwendigen, schulaufsichtlich genehmigte Baumaßnahmen eine freiwillige staatliche Zuwendung nach Maßgabe des Staatshaushaltes gewährt werden. Gefördert werden auch Maßnahmen des Schulsportstättenbaus der genannten Schularten sowie private Schülerheime gemeinnütziger Träger. Die Errichtung oder der Betrieb der Schule oder des Heimes müssen im öffentlichen Interesse liegen.&nbsp;</p>\n<p>Finanzhilfen zu Baumaßnahmen (Art. 43 BaySCHFG): Der Staat unterstützt notwendige und schulaufsichtlich genehmigte Baumaßnahmen, sofern diese im öffentlichen Interesse liegen. Förderberechtigt sind:</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">Staatlich anerkannte Ersatzschulen einschließlich Heimschulen.</li>\n  <li class=\"unordered-list-item--dash\">Private Schülerheime, die von gemeinnützigen Trägern betrieben werden.</li>\n</ul>\n<p>Die Maßnahmen müssen durch die Schulaufsicht genehmigt und für den Betrieb oder die Errichtung der Einrichtung erforderlich sein.</p>\n<p>Die Förderung staatlich genehmigter Schulen ist gemäß Art. 45 Abs. 3 BaySchFG ebenfalls möglich, sofern die Schule die Voraussetzungen des Art. 45 Abs. 2 BaySchFG erfüllt.</p>" ];
                                                                                                             xyz:foerdernehmende         [ xyz:beschreibung     "Gemeinnützige Träger privater staatlich anerkannter sowie genehmigter Realschulen, Gymnasien, Freier Waldorfschulen (ab Jahrgangsstufe 5), beruflicher Schulen sowie Schulen des Zweiten Bildungsweges.";
