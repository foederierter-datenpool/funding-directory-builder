                                                                                                                                           xyz:linkZurAntragsstellung   "https://www.lfp.bayern.de/dokumente/AUA/Foerderantrag%20Sorgenetzwerke.pdf";
                                                                                                                                           xyz:rechtsbehelf             "<p>Gegen den Zuwendungsbescheid können Sie innerhalb eines Monats Klage erheben. Das zuständige Gericht, bei dem Sie Klage einreichen können, wird Ihnen im Bescheid mitgeteilt.</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<p>Der Antrag auf Förderung ist schriftlich oder elektronisch beim Bayerischen Landesamt für Pflege zu stellen. Die bereitgestellten Vordrucke sind zu verwenden.</p>";
                                                                                                                                                                          xyz:erlaeuterungVorzeitigerMassnahmebeginn
                                                                                                                                                                                  "<p>Die Zustimmung zum vorzeitigen Maßnahmebeginn gilt mit der Antragstellung allgemein als erteilt.</p>";
                                                                                                                                                                          xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "005";
                                                                                                                                                                                                            xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
                                                                                                                                                                                                            xyz:listVersionID  "1"
                                                                                                                                                                                                          ]
                                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:euBeihilferelevanz        "Die Prüfung der Freistellung der Fördermaßnahme von der Anmeldepflicht bei der EU-Kommission erfolgt im Rahmen der Antragsbearbeitung durch die Bewilligungsbehörde.";
                                                                                                                                           xyz:finanzierungsartUndHoehe  "<p>Die Zuwendung erfolgt im Rahmen einer Projektförderung.</p><p>Die Förderung erfolgt angebotsabhängig zu pauschalierten Sätzen, wie in den Hinweisen zum Vollzug der AVSG Teil 8 Abschnitt 5 bis 8 näher bestimmt.<br><br>Die Förderung ehrenamtlicher Strukturen und weiterer Angebote nach § 45c SGB XI&nbsp;erfolgt zu gleichen Teilen durch den Freistaat Bayern und die kommunale Gebietskörperschaft einerseits sowie die soziale und private Pflegeversicherung andererseits. Die soziale und private Pflegeversicherung verdoppelt also die Förderung des Freistaats Bayern und der kommunalen Gebietskörperschaft.</p><p>Die Förderung der Selbsthilfe nach § 45d SGB XI erfolgt zu 25% durch den Freistaat Bayern und die kommunale Gebietskörperschaft sowie zu 75% durch die soziale und private Pflegeversicherung. Die soziale und private Pflegeversicherung verdreifacht also den Betrag, den der Freistaat Bayern und die kommunale Gebietskörperschaft für die Förderung der Selbsthilfe nach § 45d SGB XI bereitstellen.</p>";
