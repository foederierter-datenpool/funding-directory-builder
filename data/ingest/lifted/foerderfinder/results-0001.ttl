                                                                                                                                           xyz:linkZurAntragsstellung   "https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmwk/blfd/kulturfonds_kunst/index?caller=bpmvsdiobwgiytgytcmvtgindbgzqlaxkqvlgmhv2vtozyv4ar6vuoygjpsweeywtirp774me4sq34jqtm6o33h47iwknvj4kfyd7a5lzntit5enbekzpsmuch6yv2tq3w34fbcsmvglpjgisztwxvu4jq6x42yhw7vh6dz5rj5gie2zi4jdrhjy2vaqpckkb2e2j75g6eew4sh3abmbnvcwuvjixojuqalbj33xi8";
                                                                                                                                           xyz:rechtsbehelf             "<p>Keine Angabe möglich</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<p>Anträge sind online über das Antragsportal bis zum 1. Oktober (für das darauf folgende Jahr) bei der zuständigen Bezirksregierung einzureichen. Die Bezirksregierungen prüfen die Anträge und legen sie dann zur Entscheidung dem Bayerischen Staatsministerium für Wissenschaft und Kunst vor.<br> Die Förderentscheidung fällt dann jeweils im Früjahr.</p>";
                                                                                                                                                                          xyz:erlaeuterungVorzeitigerMassnahmebeginn
                                                                                                                                                                                  "<p>Mit dem Vorhaben darf noch nicht (förderschädlich) begonnen worden sein, d.h. es dürfen keine Verträge geschlossen, Räume verbindlich gebucht worden sein usw.</p><p>Die Zustimmung zum vorzeitigen Maßnahmebeginn kann gemeinsam mit dem Förderantrag über die entsprechende Antragsplattform beantragt werden (Bitte dort die entsprechende Fragestellung beantworten.)</p>";
                                                                                                                                                                          xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "002";
                                                                                                                                                                                                            xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
                                                                                                                                                                                                            xyz:listVersionID  "1"
                                                                                                                                                                                                          ]
                                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:finanzierungsartUndHoehe  "<p>Fördersatz bis zu 30 % der zuwendungsfähigen Kosten (Zuschuss oder Darlehen möglich).</p><p>Höchstförderbetrag 1,0 Mio. €.</p>";
