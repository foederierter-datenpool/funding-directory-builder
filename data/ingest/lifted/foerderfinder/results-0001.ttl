                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>5b1c3172-60fc-4221-86eb-aada3717d51f</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2026-01-21T18:56:51</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>5b1c3172-60fc-4221-86eb-aada3717d51f</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>5b1c3172-60fc-4221-86eb-aada3717d51f</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-08-26T11:15:23</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>5b1c3172-60fc-4221-86eb-aada3717d51f</xflb:foerderschluessel>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400078017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Neu- und Umbaumaßnahmen bei Mietwohnungen</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Unterstützt wird der Bau oder Umbau von bedarfsgerechten und bezahlbaren Miet- und Genossenschaftswohnungen in Mehrfamilienhäusern für Haushalte, mit geringen und mittleren Einkommen.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Das Förderverfahren wird derzeit überarbeitet. Aktuelle Informationen zum Jahresbauprogramm 2027 stehen unter \"https://www.stmb.bayern.de/wohnen/foerderung\" zur Verfügung. Unten stehende Informationen beziehen sich auf die bis Ende 2026 geltenden Richtlinien.</xflb:teaser>\n                  <xflb:schluesselwoerter>Wohnungsbauprogramm, Mietwohnraum, Mietwohnungen, Wohnungsbauförderung, Förderung, Wohnraumförderung, Förderung Mietwohnungen Neubau, Wohnbauförderung</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderung von Mietwohnungen</xflb:bezeichnung>\n                     <xflb:link>http://www.bauen.bayern.de/wohnen/foerderung/mietwohnungen/index.php</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>örtlich zuständige Bezirksregierung; Städte München, Nürnberg und Augsburg</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>ec575c43-4c68-473b-b44b-fa3c5abb3e7c</xflb:id>\n                     <xflb:bezeichnung>Grundförderung: Ratenabruf (Neubau, Gebäudeänderung und Gebäudeerweiterung) - RA 4-SV</xflb:bezeichnung>\n                     <xflb:link>https://www.stmb.bayern.de/assets/stmi/wohnen/foerderung/31_mietwohnungen_ra4sv_eof-orientiert.docx</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>d0accbd1-4d84-43ca-b85e-d83198dd4a3d</xflb:id>\n                     <xflb:bezeichnung>Grundförderung: Ratenabruf (Neubau, Gebäudeänderung und Gebäudeerweiterung) - RA 4</xflb:bezeichnung>\n                     <xflb:link>https://www.stmb.bayern.de/assets/stmi/wohnen/foerderung/31_mietwohnungen_ra4.docx</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>dff5faee-f122-4cf6-a1ae-346c7a6238d0</xflb:id>\n                     <xflb:bezeichnung>Antrag Zusatzförderung - Stabau Ic</xflb:bezeichnung>\n                     <xflb:link>https://www.bauen.bayern.de/assets/stmi/wohnen/foerderung/mietwohnungen_stabau_ic.docx</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>070ebbbe-8462-49c4-8287-f3d890a370b6</xflb:id>\n                     <xflb:bezeichnung>Einkommenserklärung des Antragstellers (Stabau III a)</xflb:bezeichnung>\n                     <xflb:link>https://www.stmb.bayern.de/assets/stmi/wohnen/foerderung/antrag_stabau_iiia.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>ffba52f1-0bd8-4982-a779-38683b8a686f</xflb:id>\n                     <xflb:bezeichnung>Einkommenserklärung für weitere Haushaltsangehörige (Stabau III b)</xflb:bezeichnung>\n                     <xflb:link>http://www.stmb.bayern.de/assets/stmi/wohnen/wohnberechtigungundrecht/antrag_stabau_iiib_mai_2018.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>f90af6c1-c348-44df-9516-45b624e356a2</xflb:id>\n                     <xflb:bezeichnung>Erläuterungen zur Einkommenserklärung des Antragstellers und weiterer Haushaltsangehörigen</xflb:bezeichnung>\n                     <xflb:link>https://www.stmb.bayern.de/assets/stmi/wohnen/erlaeuterungen_stabau_iiia_iiib.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>95fbfb6c-b4a6-4ce8-9054-f20bc7f166e6</xflb:id>\n                     <xflb:bezeichnung>Bewerbung Jahresbauprogramm Standardprogramm</xflb:bezeichnung>\n                     <xflb:link>https://www.stmb.bayern.de/assets/stmi/wohnen/foerderung/bewerbung_jahresbauprogramm_sp.xlsx</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>df758058-ee3b-47a3-88ac-dbbea9c778df</xflb:id>\n                     <xflb:bezeichnung>Anlage 2: Erklärung des Antragstellers zur Zwischenfinanzierung Jahresbauprogramm</xflb:bezeichnung>\n                     <xflb:link>https://www.stmb.bayern.de/assets/stmi/wohnen/foerderung/anlage_2_erkl%C3%A4rung_des_antragstellers_zwischenfinanzierung_jahrebauprogramm_sp.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>76407058-12ec-47bb-8444-f7e3919e80c8</xflb:id>\n                     <xflb:bezeichnung>Verzeichnis der Wohnungen</xflb:bezeichnung>\n                     <xflb:link>https://www.stmb.bayern.de/assets/stmi/wohnen/foerderung/stabau_anl_1_wohnungsverzeichnis.docx</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>002</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>008</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>006</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>007</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>004</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>005</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>003</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Antragsberechtigt sind natürliche Personen, juristische Person des  öffentlichen oder privaten Rechts als Eigentümer, Erbbauberechtigte oder  der Nießbraucher eines geeigneten Grundstücks.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>002</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Förderung erfolgt über ein Baudarlehen und einen Zuschuss.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Förderung erfolgt für die Dauer von 40 oder 55 Jahren.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Der Mieter erhält bei der Einkommensorientierten Förderung einen Mietzuschuss, der die vereinbarte Marktmiete auf eine ihm nach seinem Einkommen zumutbare Miete senkt.&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Förderfähig sind die Gesamtkosten im Sinn der §§ 5 bis 8 der Zweiten Berechnungsverordnung (II. BV).&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Wohnen, Bau und Verkehr</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Gesetz über die Wohnraumförderung in Bayern (Bayerisches Wohnraumförderungsgesetz - BayWoFG)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayWoFG</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Wohnraumförderungsbestimmungen 2023 (WFB 2023)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2330_B_13734/true</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinien für das Darlehensprogramm zur Schaffung von effizientem Mietwohnraum (EMWR)</xflb:bezeichnung>\n                     <xflb:link>https://www.verkuendung-bayern.de/baymbl/2022-308/</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat 31</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Wohnraumförderungsgesetz und Darlehensprogramm</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2027-01-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2023-04-13</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2027-01-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Der Freistaat Bayern fördert im Bayerischen Wohnungsbauprogramm den Bau und den Umbau von bedarfsgerechten Mietwohnungen in Mehrfamilienhäusern. Das Ziel ist bezahlbaren Wohnraum für Haushalte mit geringen und mittleren Einkommen zu schaffen. Die geförderten Wohnungen sollen so geplant und ausgeführt werden, dass sie langfristig von einem möglichst großen Personenkreis genutzt werden können, insbesondere auch von älteren Menschen.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>021</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Mietwohnraum in Mehrfamilienhäusern darf nur gefördert werden, wenn vor Ort nachweislich ein bedeutsamer, nicht nur kurzfristiger Bedarf für diesen Wohnraum besteht. Als Mehrfamilienhäuser gelten Gebäude mit mindestens drei Mietwohnungen.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Wohnungen dürfen nur an Haushalte (Mieter) vermietet werden, deren Einkommen die in Art. 11 BayWoFG bestimmten Einkommensgrenzen nicht übersteigt. Ziel ist es, dass mit den höchstmöglichen Einkommensgrenzen rund 60 Prozent der bayerischen Haushalte Zugang zur Wohnraumförderung haben.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Es ist ein angemessener Eigenkapitalanteil von mind.15 % der Gesamtkosten erforderlich.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Landesbodenkreditanstalt führt gegebenenfalls eine Bonitätsprüfung durch.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Vor der Bewilligung der Fördermittel darf mit dem Bauvorhaben nicht begonnen werden.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Ein Rechtsanspruch auf eine Förderung besteht nicht.&lt;/li&gt;&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.stmb.bayern.de/assets/stmi/wohnen/foerderung/bewerbung_jahresbauprogramm_sp.xlsx</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Das Verfahren ist zweistufig: 1. Das Vorhaben ist möglichst frühzeitig mit der Bewilligungsstelle (siehe unter \"Für Sie zuständig\") abzustimmen. In der Folge kann der Antrag mittels der dafür vorgesehenen Formulare und Unterlagen eingereicht werden. Die Bewilligung erfolgt durch die Bewilligungsstelle. 2. Die Darlehenszusage und Zustellung des Bewilligungsbescheids erfolgt durch die Bayerische Landesbodenkreditanstalt. Die Auszahlung erfolgt nach Baufortschritt und ist bei der Bewilligungsstelle zu beantragen.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Nachweis zum Grundstück und Erbbaurecht</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Nachweis über Fremd- und Eigenmittel</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Sonstige Nachweise (z.B. bei einer Baubetreuung)</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Bautechnische Unterlagen zum Bauvorhaben</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;verwaltungsgerichtliche Klage&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_92   [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/13/rmf_13-037/index";
                                xyz:begriffeImKontext    [ rdf:_1  "Suchtprävention";
                                                           rdf:_2  "Suchtbekämpfung";
                                                           rdf:_3  "ehrenamtliche Suchtkrankenhilfe";
                                                           rdf:_4  "Forbildung"
                                                         ];
                                xyz:beschreibung         "<p>Ziel ist es, durch gezielte Fortbildungsmaßnahmen ehrenamtliche Helferinnen oder Helfer und Angehörige von Betroffenen im Umgang mit Suchtkranken zu schulen. Die Gruppe der ehrenamtlichen oder familiären Helferinnen oder Helfer leistet einen entscheidenden Beitrag zur Versorgung von Menschen mit Abhängigkeitserkrankungen.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Gesundheit und Soziales" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Verbände";
                                                           rdf:_2  "Kommunen"
                                                         ];
                                xyz:foerderprogramm      "Förderung von Präventions- und Beratungsangeboten im Suchtbereich";
                                xyz:foerderzeitraum.bis  "2027-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2025-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "240799e0-2779-48a2-a327-8646ca4cea86";
                                xyz:teaser               "Förderung von Fortbildungsmaßnahmen im Bereich der ehrenamtlichen Suchtkrankenhilfe.";
                                xyz:titel                "Fortbildungsmaßnahmen im Bereich der ehrenamtlichen Suchtkrankenhilfe";
                                xyz:titel.tokens         [ rdf:_1  "Fortbildungsmaßnahmen im Bereich der ehrenamtlichen Suchtkrankenhilfe" ];
                                xyz:voraussetzung        "<ul><li class=\"unordered-list-item--dash\">Im Rahmen der geplanten Fortbildungsmaßnahmen legen die Antragsteller eine Auflistung aller geplanten Fortbildungsveranstaltungen vor, die neben der Nennung der Veranstaltungen auch deren Konzeption und Lernziele darlegt.&nbsp;</li><li class=\"unordered-list-item--dash\">Die Konzeption umfasst eine Beschreibung des Themas, der Inhalte, der Arbeitsmethoden, der Dauer und Organisation, der Zielgruppen, der Teilnahmevoraussetzungen und der geplanten Teilnehmerzahl sowie der Kosten und Maßnahmen zur Qualitätssicherung.</li></ul>"
                              ];
