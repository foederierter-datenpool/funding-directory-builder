                                                                                                             xyz:foerdergegenstand       [ xyz:beschreibung
                                                                                                                               "<p>Gefördert wird die Niederlassung freiberuflicher Hebammen in Bayern.</p>" ];
                                                                                                             xyz:foerdernehmende         [ xyz:beschreibung     "Antragsberechtigt sind ausschließlich Hebammen mit einer Erlaubnis zum Führen der Berufsbezeichnung nach § 5 des Hebammengesetzes (HebG), die die in Nr. 4.2 normierten Voraussetzungen erfüllen.";
                                                                                                                                           xyz:foerdernehmende  [ rdf:_1  [ xyz:code           "007";
