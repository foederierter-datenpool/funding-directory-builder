                                                                                                                       xyz:handlungsgrundlagen       [ xyz:verweis  [ rdf:_1  [ xyz:bezeichnung  "Art. 6 Abs. 4 Bayerisches Gesetz über das Erziehungs- und Unterrichtswesen (BayEUG)";
                                                                                                                                                                                xyz:link         "https://www.gesetze-bayern.de/Content/Document/BayEUG-6"
                                                                                                                                                                              ];
                                                                                                                                                                      rdf:_2  [ xyz:bezeichnung  "Offene Ganztagsangebote an Schulen für Schülerinnen und Schüler der Jahrgangsstufen 1 bis 4 - Bekanntmachung des Bayerischen Staatsministeriums für Unterricht und Kultus";
                                                                                                                                                                                xyz:link         "https://www.gesetze-bayern.de/Content/Document/BayVV_2230_1_1_1_2_4_K_15474"
                                                                                                                                                                              ];
                                                                                                                                                                      rdf:_3  [ xyz:bezeichnung  "Offene Ganztagsangebote an Schulen für Schülerinnen und Schüler ab der Jahrgangsstufe 5";
                                                                                                                                                                                xyz:link         "https://www.gesetze-bayern.de/Content/Document/BayVV_2230_1_1_1_2_4_K_11098?hl=true"
                                                                                                                                                                              ]
                                                                                                                                                                    ]
