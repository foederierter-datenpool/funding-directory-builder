                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>f884a36c-4689-4c7d-a892-ca18f538bb90</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-06-24T08:06:43</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>f884a36c-4689-4c7d-a892-ca18f538bb90</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>f884a36c-4689-4c7d-a892-ca18f538bb90</xflb:schluessel>\n         <xflb:versionFLB>4</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-08-20T08:04:23</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>f884a36c-4689-4c7d-a892-ca18f538bb90</xflb:foerderschluessel>\n                  <xflb:flbVersion>4</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>09999000000021</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Kursreihe \"Leben in Bayern\"</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Ziel der Kursreihe \"Leben in Bayern\" ist es, den Teilnehmerinnen und Teilnehmern die Kultur, die Werte und unser Zusammenleben in Bayern näherzubringen und ihnen das Zurechtfinden im Alltag zu erleichtern. Die Teilnehmerinnen und Teilnehmer erhalten praktische Unterstützung in Fragen des Alltags, der Erziehung, Bildung und Gesundheit sowie die Gelegenheit zur Vertiefung der deutschen Sprache. Die Wertevermittlungskurse sollen keinen strengen Frontalunterrichtscharakter haben, sondern Raum für den Austausch untereinander und mit den Kursleiterinnen und Kursleitern lassen. Zur Veranschaulichung gelebter Werte soll der Unterricht auch Einblicke in das Vereinsleben oder in ehrenamtliches Engagement umfassen.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Das Bayerische Staatsministerium des Innern, für Sport und Integration fördert Projekte zur Wertevermittlung. Die Kursreihe \"Leben in Bayern\" vermittelt Wissen zu Alltag, Werten und gesellschaftlichem Zusammenleben im Freistaat.</xflb:teaser>\n                  <xflb:schluesselwoerter>BayernPortal, Beantragung, Integrationsförderung, Wertevermittlung, Asyl, Integrationsprojekte Beantragung einer Förderung im Bereich der Wertevermittlung, Integration, Werte, Förderung, Werteprojekte, Leben in Bayern, Lebenswirklichkeit in Bayern, Kursreihe</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Projekte zur Wertevermittlung in Bayern</xflb:bezeichnung>\n                     <xflb:link>https://www.stmi.bayern.de/a-z/anzeigen/wertevermittlung-in-bayern/</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Regierung von Mittelfranken - Sachgebiet 15 (Integration und Förderung, Ausgleichsamt)</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>21</xflb:hausnummerPostfach>\n                     <xflb:strasse>Marienstraße</xflb:strasse>\n                     <xflb:postleitzahl>90402</xflb:postleitzahl>\n                     <xflb:ort>Nürnberg</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>Sachgebiet-15.Integration@reg-mfr.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Übersicht bei der Regierung von Mittelfranken</xflb:bezeichnung>\n                     <xflb:link>https://www.regierung.mittelfranken.bayern.de/aufgaben/40027/57461/leistung/leistung_132361/index.html</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>+49 (0)911 2352-0</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Regierung von Mittelfranken - Sachgebiet 15 (Integration und Förderung, Ausgleichsamt)</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>21</xflb:hausnummerPostfach>\n                           <xflb:strasse>Marienstraße</xflb:strasse>\n                           <xflb:postleitzahl>90402</xflb:postleitzahl>\n                           <xflb:ort>Nürnberg</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>Sachgebiet-15.Integration@reg-mfr.bayern.de</xflb:email>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Übersicht bei der Regierung von Mittelfranken</xflb:bezeichnung>\n                           <xflb:link>https://www.regierung.mittelfranken.bayern.de/aufgaben/40027/57461/leistung/leistung_132361/index.html</xflb:link>\n                        </xflb:verweis>\n                        <xflb:telefonnummer>+49 (0)911 2352-0</xflb:telefonnummer>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>70c22cd9-e549-41c6-838b-fd00002766be</xflb:id>\n                     <xflb:bezeichnung>Projektkonzept Kursreihe \"Leben in Bayern\"</xflb:bezeichnung>\n                     <xflb:link>https://www.stmi.bayern.de/media/07_migration-und-integration/Integration/projektkonzept_leben_in_bayern_2026.docx</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>a0e72484-fe53-4dd7-8d3f-f80251794db2</xflb:id>\n                     <xflb:bezeichnung>Ausgaben- und Finanzierungsplan</xflb:bezeichnung>\n                     <xflb:link>https://www.stmi.bayern.de/media/07_migration-und-integration/Integration/Ausgaben-_und_Finanzierungsplan_2026_Leben_in_Bayern.xlsx</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n               <xflb:onlinedienste>\n                  <xflb:onlinedienst>\n                     <xflb:id>0efde796-9419-44ee-9ece-985a7879639f</xflb:id>\n                     <xflb:bezeichnung>Werteprojekte: Zuwendungsantrag</xflb:bezeichnung>\n                     <xflb:link>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/werteprojekte_bayern/index?caller=bpgi2gcnlcmi4don3ggqzggnrumhe4zxgip7e2eb5bx34ao4zgyixwp2wtfkrg2yatsh5zl4zbnc45kmhdxne7wqfl63dhz2axeaultkirtxx4coa4t7eytnomwmowsc3ik2jq7lhg4yijpr7dba4kjglcaswmtrxjpbpzimzic2tmelszz256cwciuozklypqgrkrrjgkmxtmdz76gvkz33oagbooxyu4spgrl6a8</xflb:link>\n                     <xflb:beschreibung>Hier können Sie das Formular online Schritt für Schritt ausfüllen und anschließend online einreichen. Sie erhalten ein fertig ausgefülltes Dokument als PDF-Dokument für Ihre Unterlagen.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n               </xflb:onlinedienste>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Antragsberechtigt sind alle rechtsfähigen Träger, die über die erforderliche Zuverlässigkeit und Leistungsfähigkeit zur Durchführung des Projektes verfügen und deren bisherige Tätigkeit das Erreichen des Förderzwecks erwarten lässt.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Zuwendung wird als Anteilfinanzierung im Rahmen einer Projektförderung bis&lt;/p&gt;&lt;p&gt;maximal 90 % der zuwendungsfähigen Ausgaben gewährt. Die staatliche Förderung&lt;/p&gt;&lt;p&gt;setzt eine Beteiligung des Zuwendungsempfängers in Höhe von mindestens 10 %&lt;/p&gt;&lt;p&gt;der zuwendungsfähigen Projektausgaben voraus.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Die Förderung erfolgt ohne Rechtsanspruch im Rahmen zur Verfügung stehender&lt;/p&gt;&lt;p&gt;Haushaltsmittel.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Im Rahmen der Kursreihe \"Leben in Bayern\" sind folgende projektbezogene Ausgaben zuwendungsfähig:&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Projektleitung und Projektkoordination&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Vor- und Nachbereitung der Kurse und Module&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Ausgaben für die Kinderbetreuung&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;ehrenamtlicher Einsatz von Kulturmittlern&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Ausgaben für eine Abschlussveranstaltung&lt;/li&gt;&lt;/ul&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerFest>\n                        <xflb:jahre>1</xflb:jahre>\n                     </xflb:dauerFest>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium des Innern, für Sport und Integration</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderrichtlinie Werteprojekte</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2176_I_15397/true</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Sachgebiet G2 - Integration in Arbeit, Wertevermittlung</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Integrationsprojekte; Beantragung einer Förderung im Bereich der Wertevermittlung</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2027-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2026-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2026-12-31</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:verlaengerungsoption>Vor Ablauf der Förderperiode kann ein Verlängerungsantrag gestellt werden.</xflb:verlaengerungsoption>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert wird die Kursreihe \"Leben in Bayern\" bestehend aus den drei Modulen:&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Miteinander leben in Bayern&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Erziehung und Bildung in Bayern&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Gesundheit in Bayern&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Der Inhalt der Module richtet sich nach den von der Bayerischen Landeszentrale für politische Bildungsarbeit erarbeiteten Unterrichtsmaterialien, bestehend aus dem Lehrkonzept für die Kursleiterinnen und Kursleiter sowie dem Arbeitsbuch für die Teilnehmerinnen und Teilnehmer. Jedes Modul wird von einer Unternehmung, die einen thematischen Bezug zu unseren Werten oder zu unserer Kultur hat, begleitet (zum Beispiel Besuch einer Schule oder einer Kindertagesstätte, Museumsbesuch, Stadtrundgänge).&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>022</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Neben der Beachtung der bereits oben genannten Voraussetzungen sowie der Hinweise zum Verfahren sind die weiteren Anforderungen im Einzelnen der \"Förderrichtlinie Werteprojekte\" zu entnehmen (siehe unter \"Rechtsgrundlagen\").&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:rechtlicheBeschreibung>&lt;p&gt;Es gelten die allgemeinen Bewilligungsvoraussetzungen der VV Nr. 1 zu Art. 44 BayHO. Insbesondere muss die Gesamtfinanzierung des Projekts gesichert sein (VV Nr. 1.4 zu Art. 44 BayHO). 3Außerdem darf eine Zuwendung zur Projektförderung nur für Vorhaben bewilligt werden, die noch nicht begonnen worden sind (VV Nr. 1.5.1 zu Art. 44 BayHO).&lt;/p&gt;</xflb:rechtlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Eine Förderung entfällt, wenn für die entstehenden zuwendungsfähigen Ausgaben anderweitige Mittel des Freistaates Bayern in Anspruch genommen werden. Eine Komplementärförderung mit Mitteln der Kommunen, des Bundes oder der Europäischen Union ist möglich.&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/werteprojekte_bayern/index?caller=bpgi2gcnlcmi4don3ggqzggnrumhe4zxgip7e2eb5bx34ao4zgyixwp2wtfkrg2yatsh5zl4zbnc45kmhdxne7wqfl63dhz2axeaultkirtxx4coa4t7eytnomwmowsc3ik2jq7lhg4yijpr7dba4kjglcaswmtrxjpbpzimzic2tmelszz256cwciuozklypqgrkrrjgkmxtmdz76gvkz33oagbooxyu4spgrl6a8</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Der Antrag ist zunächst per E-Mail zusammen mit einem aussagekräftigen Projektkonzept und einem Ausgaben- und Finanzierungsplan beim Bayerischen Staatsministerium des Innern, für Sport und Integration (StMI) (&lt;a href=\"mailto:Sachgebiet-G2@stmi.bayern.de\" dir=\"ltr\"&gt;Sachgebiet-G2@stmi.bayern.de&lt;/a&gt;) einzureichen.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Nach Freigabe des Projektkonzepts durch das StMI ist der Antrag per E-Mail bei der Regierung von Mittelfranken, Sachgebiet 15 - Integration und Förderung, (&lt;a href=\"mailto:SG15.Integration@reg-mfr.bayern.de\" dir=\"ltr\"&gt;SG15.Integration@reg-mfr.bayern.de&lt;/a&gt;) zu stellen.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Die Regierung von Mittelfranken ist zuständig für die Bewilligung. Bewilligungszeitraum ist grundsätzlich die Zeit vom 1. Januar bis 31. Dezember.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>&lt;p&gt;Zuwendungen dürfen grundsätzlich nur für solche Vorhaben bewilligt werden, die noch nicht begonnen worden sind. Rein vorbereitende oder planende Maßnahmen wie etwa die Teilnehmerakquise gelten nicht als Vorhabenbeginn.&lt;/p&gt;</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:monate>1</xflb:monate>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>3</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristJaehrlich>30.09.</xflb:fristJaehrlich>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Der Antrag ist so rechtzeitig zu stellen, dass die Antragsbewilligung vor Maßnahmenbeginn zeitlich möglich ist.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Antrag auf Gewährung einer Zuwendung</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Bitte formlos per E-Mail an Sachgebiet-G2@stmi.bayern.de</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Projektkonzept</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Ausgefülltes Projektkonzept (Link s.o.) per E-Mail an Sachgebiet-G2@stmi.bayern.de</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Ausgaben- und Finanzierungsplan</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Ausgefüllter Ausgaben- und Finanzierungsplan (Link s.o.) per E-Mail an Sachgebiet-G2@stmi.bayern.de</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Verwaltungsgerichtliche Klage gegen Bewilligungsbescheid.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_84   [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/formloseSchreibenmitUnterschrift/index";
                                xyz:begriffeImKontext    [ rdf:_1  "Beratungsstelle";
                                                           rdf:_2  "Behinderung";
                                                           rdf:_3  "Familie";
                                                           rdf:_4  "Angehörige"
                                                         ];
                                xyz:beschreibung         "<p>Menschen mit Behinderung und ihre Angehörigen können sich in allen Fragen, die sich zu ihrer Behinderung ergeben, an einen Dienst der regionalen Offenen Behindertenarbeit (OBA) wenden. Der Freistaat Bayern und die bayerischen Bezirke Fördern zu diesem Zweck bayernweit entsprechende Angebote im Rahmen einer gemeinsamen Richtlinie. Ziel der Förderung ist es, niedrigschwellige ambulante Betreuung und Sicherung der Teilhabe von körperlich und geistig behinderten, sinnesbehinderten oder chronisch kranken Menschen, die zum Personenkreis von § 99 SGB IX gehören, durch Träger und deren leistungsfähige Dienste anzubieten, die Führung eines möglichst selbstständigen, eigenverantwortlichen Lebens zu unterstützen und die Familien mit behinderten Angehörigen zu entlasten. Die Dienste fungieren zudem als Anlaufstelle für die Vermittlung in Angebote des Sozialraums (Lotsenfunktion). Die Förderung erfolgt mit dem Ziel, einer bayernweit flächendeckenden Beratung und Unterstützung.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Gesundheit und Soziales" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Verbände" ];
                                xyz:foerderprogramm      "Regionale Offene Behindertenarbeit; Beantragung einer Förderung";
                                xyz:foerderzeitraum.bis  "2026-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2026-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "5f8ac1eb-c2e4-4c92-9592-70604a062b68";
                                xyz:teaser               "Der Freistaat Bayern und die bayerischen Bezirke gewähren Zuwendungen für Maßnahmen der ambulanten Hilfen im Bereich der regionalen Offenen Behindertenarbeit.";
                                xyz:titel                "Förderung für regionale Offene Behindertenarbeit (OBA)";
                                xyz:titel.tokens         [ rdf:_1  "Förderung für regionale Offene Behindertenarbeit (OBA)" ];
                                xyz:voraussetzung        "<p>Eines der wichtigsten sozialpolitischen Anliegen ist es, Menschen mit Behinderung eine gleichberechtigte Teilhabe am Leben und ein selbstbestimmtes Leben zu ermöglichen. Dazu tragen insbesondere die Dienste der Offenen Behindertenarbeit mit bei. </p><p>Im Rahmen des Beratungsangebots sind diese Dienste Anlaufstelle zu sämtlichen Fragen rund um die Behinderung für Menschen mit Behinderung aller Behinderungsarten und ihrer Angehörigen.</p><p>Auf der Grundlage bayernweit gültiger Förderrichtlinien wurden in Bayern einheitliche Strukturen geschaffen. In jedem Landkreis und jeder kreisfreien Stadt wurde im regionalen Bereich ein Personalschlüssel von 1 : 50.000 (1 Fachkraft zu 50.000 Einwohner) umgesetzt.</p>"
                              ];
              xyz:id          "5f8ac1eb-c2e4-4c92-9592-70604a062b68";
              xyz:payload     [ xyz:json  [ xyz:anfrage            [ xyz:anfragenummer  "5f8ac1eb-c2e4-4c92-9592-70604a062b68";
