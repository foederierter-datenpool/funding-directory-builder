                                                                                                                                                        xyz:verlaengerungsoption  "ja"
                                                                                                                                                      ];
                                                                                                                       xyz:programmtitel              "Beförderung von Schülerinnen und Schüler mit Schwerbehinderung";
                                                                                                                       xyz:verantwortlichesFachreferat
                                                                                                                               "IV.4";
                                                                                                                       xyz:verantwortlichesMinisterium
                                                                                                                               "Staatsministerium für Unterricht und Kultus"
                                                                                                                     ];
                                                                                                             xyz:foerdervoraussetzungen  [ xyz:ausschlusskriterien     "<p>Schulen mit weniger als 14 Schülerinnen und Schülern erhalten keinen Zuschuss.</p>";
                                                                                                                                           xyz:buergerfreundlicheBeschreibung
                                                                                                                                                   "<p>Voraussetzungen sind unter anderem:&nbsp;</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">Beförderung einer Schülerin oder eines Schülers, wenn auf Grund einer durch einen Schwerbehindertenausweis mit dem Merkzeichen \"G\", \"aG\", \"H\" oder \"Bl\" nachgewiesenen Schwerbehinderung die Beförderung mit einem speziellen Kraftfahrzeug auf dem Schulweg zwischend erforderlich ist&nbsp;</li>\n  <li class=\"unordered-list-item--dash\">Nachweis der Gemeinnützigkeit des Schulträgers (Art. 29 Abs. 2 BaySchFG)&nbsp;</li>\n  <li class=\"unordered-list-item--dash\">Vorliegen einer schulaufsichtlichen Genehmigung der Schule nach Art. 92 ff. BayEUG&nbsp;</li>\n  <li class=\"unordered-list-item--dash\">Leistungen werden erst gewährt, wenn die Schule mindestens zwei Jahre ohne wesentliche schulaufsichtliche Beanstandungen bestanden hat.</li>\n  <li class=\"unordered-list-item--dash\">Schulen mit weniger als 14 Schülerinnen und Schüler erhalten keinen Zuschuss.</li>\n</ul>";
                                                                                                                                           xyz:rechtlicheBeschreibung  "<p>Finanzhilfen für die Beförderung von schwerbehinderten Schülerinnen und Schülern privater Grund- und Mittelschulen für die Dauer des Schulbesuchs.</p>"
                                                                                                                                         ];
