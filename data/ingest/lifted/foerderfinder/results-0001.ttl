                                                                                                                                           xyz:linkZurAntragsstellung   "https://portal.adamas.lfu.bybn.de/app/luna/home";
                                                                                                                                           xyz:rechtsbehelf             "<p>Verwaltungsgerichtliche Klage: Gegen den Zuwendungsbescheid können Sie Klage erheben. Die Frist und das zuständige Gericht, bei dem Sie Klage einreichen können, wird Ihnen im Bescheid mitgeteilt.</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<p>Anträge werden über die Kreisverwaltungsbehörde (untere Naturschutzbehörde) bei der Bewilligungsbehörde eingereicht. Bewilligungsbehörde ist die örtlich zuständige Regierung (höhere Naturschutzbehörde).</p>";
                                                                                                                                                                          xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "002";
                                                                                                                                                                                                            xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
                                                                                                                                                                                                            xyz:listVersionID  "1"
