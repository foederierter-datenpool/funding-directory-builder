                                                           rdf:_2   "Ausbildung";
                                                           rdf:_3   "Schule";
                                                           rdf:_4   "Mittlerer Schulabschluss";
                                                           rdf:_5   "Berufsbegleitend";
                                                           rdf:_6   "Online-gestützt";
                                                           rdf:_7   "Online-Kurs";
                                                           rdf:_8   "Mittlerer Schulabschluss";
                                                           rdf:_9   "MSA"
                                                         ];
                                xyz:beschreibung         "<p>Der Kurs hat das Ziel, dass berufstätige Personen befähigt werden, den Mittleren Schulabschluss zu erreichen.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Aus und Weiterbildung" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Kommunen";
                                                           rdf:_2  "Vereine";
                                                           rdf:_3  "Verbände";
                                                           rdf:_4  "Stiftungen"
                                                         ];
                                xyz:foerderprogramm      "Kurse zur Vorbereitung auf das erfolgreiche Nachholen des Mittelschulabschlusses und des Mittleren Schulabschlusses";
                                xyz:foerderzeitraum.bis  "2027-01-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2026-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "be2f47f4-92ba-4ef6-82d0-b6067f380b90";
                                xyz:teaser               "Anerkannte Träger können eine Förderung für berufsbegleitende, online-gestützte Kurse zum Nachholen des Mittleren Schulabschlussses beantragen.";
                                xyz:titel                "Berufsbegleitende (online-gestützte) Kurse zur Vorbereitung auf den Mittleren Schulabschluss";
                                xyz:titel.tokens         [ rdf:_1  "Berufsbegleitende (online-gestützte) Kurse zur Vorbereitung auf den Mittleren Schulabschluss" ];
                                xyz:voraussetzung        "<ul>\n  <li class=\"unordered-list-item--dash\">Die Kurse müssen teilnehmeroffen sein; d. h. es können sowohl Peronen mit Schulabschluss als auch Personen ohne Schulabschluss teilnehmen.</li>\n  <li class=\"unordered-list-item--dash\">An einem Kurs müssen mindestens 5 Personen teilnehmen.</li>\n  <li class=\"unordered-list-item--dash\">Um die Personen sinnvoll auf den Mittleren Schulabschluss vorzubereiten, sind mindestens 700 Unterrichtseinheiten erforderlich.</li>\n  <li class=\"unordered-list-item--dash\">Der Projektträger ist verpflichtet, qualifiziertes Personal für den Unterricht einzusetzen und eine qualifizierte sozialpädagogische Betreuung sicherzustellen.</li>\n  <li class=\"unordered-list-item--dash\">Der Maßnahmenzeitraum muss mindestens 7 Monate betragen.</li>\n</ul>"
                              ];
