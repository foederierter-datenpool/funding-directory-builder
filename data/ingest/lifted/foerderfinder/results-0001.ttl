                                                                                                                       xyz:programmtitel             "Digitalbonus.Bayern - Förderung Digitalisierung und IT-Sicherheit für kleine Unternehmen";
                                                                                                                       xyz:verantwortlichesFachreferat
                                                                                                                               "Referat 24";
