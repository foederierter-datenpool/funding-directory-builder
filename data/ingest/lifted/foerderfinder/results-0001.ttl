                                                           rdf:_4  "Stiftungen"
                                                         ];
                                xyz:foerderprogramm      "Kurse zur Vorbereitung auf das erfolgreiche Nachholen des Mittelschulabschlusses und des Mittleren Schulabschlusses";
                                xyz:foerderzeitraum.bis  "2027-01-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2026-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "37c9a90d-94da-471b-86bd-620ca8949fad";
                                xyz:teaser               "Anerkannte Träger können eine Förderung für Kurse für Jugendliche, die den erfolgreichen Abschluss bzw. den qualifizierenden Abschluss der Mittelschule nachholen möchten, beantragen.";
                                xyz:titel                "Kurse zur Vorbereitung auf das Nachholen des Mittelschulabschlusses";
                                xyz:titel.tokens         [ rdf:_1  "Kurse zur Vorbereitung auf das Nachholen des Mittelschulabschlusses" ];
                                xyz:voraussetzung        "<ul>\n  <li class=\"unordered-list-item--dash\">Die Kurse müssen teilnehmeroffen sein; d. h. es können sowohl Jugendliche mit Schulabschluss als auch Jugendliche ohne Schulabschluss teilnehmen.</li>\n  <li class=\"unordered-list-item--dash\">An einem Kurs müssen mindestens 10 Jugendliche teilnehmen.</li>\n  <li class=\"unordered-list-item--dash\">Um die Jugendlichen sinnvoll auf den Abschluss der Mittelschule vorzubereiten, sind mindestens 900 Unterrichtseinheiten erforderlich.</li>\n  <li class=\"unordered-list-item--dash\">Der Projektträger ist verpflichtet, qualifiziertes Personal für den Unterricht einzusetzen und es ist auch eine qualifizierte sozialpädagogische Betreuung sicherzustellen.</li>\n  <li class=\"unordered-list-item--dash\">Der Maßnahmenzeitraum muss mindestens 7 Monate betragen.</li>\n</ul>"
                              ];
