                                                           rdf:_8  "Klimazuschuss"
                                                         ];
                                xyz:beschreibung         "<p>Ziel der Förderung ist es, durch eine vermehrte Verwendung von Bauelementen aus Holz und anderen nachwachsenden Rohstoffen endliche Ressourcen zu schonen und mit der Speicherung von CO2 einen wesentlichen Beitrag zum Klimaschutz im Bausektor zu leisten.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Wohnungsbau und Modernisierung" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1   "Privatpersonen";
                                                           rdf:_10  "Verbände";
                                                           rdf:_2   "Kleine und mittlere Unternehmen";
                                                           rdf:_3   "Einzelunternehmen";
                                                           rdf:_4   "Großunternehmen";
                                                           rdf:_5   "Forschungseinrichtungen";
                                                           rdf:_6   "Freiberufler";
