                                xyz:xml   "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           produkt=\"Förderfinder\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produktversion=\"\"\n                                           standard=\"XFLB\"\n                                           test=\"\"\n                                           version=\"2.0.0\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0 xflb.xsd\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>b39a56b7-5640-46f1-a420-0bb67a3b22bf</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2025-04-25T09:05:38</xflb:erstellungszeitpunkt>\n      <xflb:sender>Förderfinder Suche (Bayern)</xflb:sender>\n      <xflb:empfaenger>XFLB-Connect (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>b39a56b7-5640-46f1-a420-0bb67a3b22bf</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>b39a56b7-5640-46f1-a420-0bb67a3b22bf</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Unterricht und Kultus</xflb:verantwortlichesMinisterium>\n               <xflb:programmtitel>Förderung von Praxis an Mittelschulen</xflb:programmtitel>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.bayernportal.de/dokumente/leistung/484101539206?localize=false</xflb:link>\n                     <xflb:bezeichnung>zur Richtlinie für die Förderung von Projekten - Praxis an Mittelschulen</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:programmlaufzeit>\n                  <xflb:endeLaufzeitFoerderprogramm>2030-11-30</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:beginnLaufzeitFoerderprogramm>2025-04-30</xflb:beginnLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>b39a56b7-5640-46f1-a420-0bb67a3b22bf</xflb:foerderschluessel>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n               </xflb:interneKennung>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Förderung von Praxis an Mittelschulen</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Die Mittel aus Kap. 05 12 TG 55 stehen für die Finanzierung außerschulischer Fachkräfte zur Verfügung, die im Auftrag der Schule handwerkliche, künstlerische, musische, soziale und hauswirtschaftliche Projekte durchführen. Dabei steht das praktische Arbeiten der Schülerinnen und Schüler im Vordergrund.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Das Programm \"Praxis an Mittelschulen\" steht grundsätzlich allen Mittelschulen offen.</xflb:teaser>\n               </xflb:beschreibung>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Bayerisches Staatsministerium für Unterricht und Kultus Ref. IV.2</xflb:name>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                        <xflb:adresse>\n                           <xflb:strasse>Salvatorstraße</xflb:strasse>\n                           <xflb:hausnummerPostfach>2</xflb:hausnummerPostfach>\n                           <xflb:postleitzahl>80327</xflb:postleitzahl>\n                           <xflb:ort>München</xflb:ort>\n                        </xflb:adresse>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Im Programm \"Praxis an Mittelschulen\" erstellen die Schülerinnen und Schüler der Mittelschule im Rahmen eines berufsrelevanten handwerklichen, künstlerischen, musischen, sozialen oder hauswirtschaftlichen Projektes unter Anleitung von außerschulischen Fachkräften, wie Handwerksmeister, Dienstleister, Künstler, betriebliche Ausbilder oder gewerbliche Fachlehrer und der Lehrkraft ein Produkt oder eine Dienstleistung, wodurch ein unmittelbarer Bezug zur Arbeits- und Berufswelt hergestellt wird. \"Praxis an Mittelschulen\" beinhaltet dabei v.a. die Kooperation ortsansässiger Firmen mit den Schulen, um insbesondere das Handwerk in den Schulen vorzustellen und Kontakte zu möglichen Praktikanten oder potenziellen Auszubildenden zu knüpfen&lt;em&gt;.&amp;nbsp;&lt;/em&gt;&lt;/p&gt;\n&lt;p&gt;Als Projektkosten können die Personalkosten für außerschulisches Fachpersonal - z. B. Handwerksmeister, Dienstleister, Künstler, betriebliche Ausbilder oder gewerbliche Fachlehrer - und die damit in Zusammenhang entstehenden Vergütungen und Löhne, Reisekosten, Erstattungen von Personalkosten an Gemeinden und Gemeindeverbände sowie Erstattungen von Personalkosten an Sonstige beantragt werden.&lt;/p&gt;\n&lt;p&gt;Die beantragten Mittel können nicht verwendet werden, um den Sachaufwand der Schulen zu bestreiten. Nicht erstattungsfähig sind Projekte, die sozialpädagogisch und/oder pädagogisch-psychologisch arbeiten, um die Stabilisierung der Schülerpersönlichkeit zu bewirken. Darunter fallen Projekte im Rahmen von Sucht- und Gewaltprävention, erlebnispädagogische Projekte, Einsatz von Sozial- und Diplompädagogen, Mediatorenausbildung bzw. Streitschlichterprojekte.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name>Privatpersonen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>008</code>\n                  <name>Behörden</name>\n               </xflb:foerdernehmende>\n            </xflb:foerdernehmende>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Schülerinnen und Schüler der Mittelschule erstellen im Rahmen eines berufsrelevanten handwerklichen, künstlerischen, musischen, sozialen oder hauswirtschaftlichen Projektes unter Anleitung von außerschulischen Fachkräften, wie Handwerksmeister, Dienstleister, Künstler, betriebliche Ausbilder oder gewerbliche Fachlehrer und der Lehrkraft ein Produkt oder eine Dienstleistung, wodurch ein unmittelbarer Bezug zur Arbeits- und Berufswelt hergestellt wird. \"Praxis an Mittelschulen\" beinhaltet dabei v.a. die Kooperation ortsansässiger Firmen mit den Schulen, um insbesondere das Handwerk in den Schulen vorzustellen und Kontakte zu möglichen Praktikanten oder potenziellen Auszubildenden zu knüpfen&lt;em&gt;.&lt;/em&gt;&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:rechtlicheBeschreibung>&lt;p&gt;Haushalt des Staatsministeriums für Unterricht und Kultus, Kap. 05 12, Titelgruppe 55 mit der Zweckbestimmung \"Ausgaben für Praxis an Mittelschulen und Mittelschulen an sozialen Brennpunkten\"&lt;/p&gt;</xflb:rechtlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Das Programm \"Praxis an Mittelschulen\" steht grundsätzlich allen Mittelschulen offen.&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:finanzierung>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Haushalt des Staatsministeriums für Unterricht und Kultus, Kap. 05 12, Titelgruppe 55 mit der Zweckbestimmung \"Ausgaben für Praxis an Mittelschulen und Mittelschulen an sozialen Brennpunkten\"&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Programm \"Praxis an Mittelschulen\"&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:zuwendungsart>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.bayernportal.de/dokumente/leistung/484101539206?localize=false</xflb:linkZurAntragsstellung>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristSpanne>\n                        <xflb:min>\n                           <xflb:tage>1</xflb:tage>\n                        </xflb:min>\n                        <xflb:max>\n                           <xflb:wochen>1</xflb:wochen>\n                        </xflb:max>\n                     </xflb:fristSpanne>\n                  </xflb:zeitlicheEingrenzung>\n               </xflb:antragsfrist>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Die sieben Bezirksregierungen erfüllen als Mittelbehörden im dreistufigen Behördenaufbau der bayerischen Staatsverwaltung Aufgaben aus den Geschäftsbereichen fast aller bayerischen Staatsministerien. Sie verstehen sich als Kompetenzzentren zur Bündelung und Koordinierung der verschiedensten Interessen, beraten in Rechts- und Fachangelegenheiten und fördern private und öffentliche Vorhaben.&lt;/p&gt;</xflb:bewilligung>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:wochen>1</xflb:wochen>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>1</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n            </xflb:antragsinformationen>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2025-04-25T09:05:38</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name>Bayern</name>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>002</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>\n"
                              ]
            ];
  rdf:_11   [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver-bp.bayern.de/intelliform/forms/rzsued/stmgp/stmgp/hebammenbonus/index";
                                xyz:begriffeImKontext    [ rdf:_1  "Hebammenbonus";
                                                           rdf:_2  "Hebamme";
                                                           rdf:_3  "Hebammen";
                                                           rdf:_4  "Förderung";
                                                           rdf:_5  "Geburtshilfe";
                                                           rdf:_6  "Bonus";
                                                           rdf:_7  "Zuschuss";
                                                           rdf:_8  "Geburten";
                                                           rdf:_9  "freiberuflich"
                                                         ];
                                xyz:beschreibung         "<p>Der Freistaat Bayern gewährt nach Maßgabe dieser Richtlinie und der allgemeinen haushaltsrechtlichen Vorschriften, insbesondere der Art.&nbsp;23 und 44 der Bayerischen Haushaltsordnung (BayHO) und der hierzu erlassenen Verwaltungsvorschriften, Zuwendungen an in Bayern freiberuflich tätige Hebammen. Zuwendungen nach dieser Richtlinie werden ohne Rechtsanspruch im Rahmen der verfügbaren Haushaltsmittel gewährt. Zuwendungen aus dem Programm stellen freiwillige Leistungen dar und können nur insoweit bewilligt werden, als dafür Haushaltsmittel zur Verfügung stehen. Ein Zuwendungsantrag kann deshalb unter Umständen wegen Überzeichnung des Förderprogramms nicht bewilligt werden.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Arbeit";
                                                           rdf:_2  "Gesundheit und Soziales"
                                                         ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Privatpersonen";
                                                           rdf:_2  "Freiberufler"
                                                         ];
                                xyz:foerderprogramm      "Gewährung eines Bonus zur Sicherstellung der Geburtshilfe durch freiberuflich tätige Hebammen";
                                xyz:foerderzeitraum.bis  "2027-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2025-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "83b654b9-e93a-4836-b027-b53b4e239eea";
                                xyz:teaser               "Wenn Sie in Bayern in der Geburtshilfe freiberuflich tätig sind, können Sie unter Umständen den Bayerischen Hebammenbonus erhalten.";
                                xyz:titel                "Hebammenbonus";
                                xyz:titel.tokens         [ rdf:_1  "Hebammenbonus" ];
                                xyz:voraussetzung        "<p>Sie müssen: - den Beruf in Bayern ausüben, - freiberuflich tätig sein und mindestens vier Geburten pro Jahr bzw. mindestens eine Geburt pro Quartal verantwortlich betreut haben.</p>"
                              ];
