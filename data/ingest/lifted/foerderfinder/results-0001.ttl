                                xyz:beschreibung         "<p>Der Arbeitsmarktfonds (AMF) unterstützt Maßnahmen zur Qualifizierung und Arbeitsförderung mit dem Ziel der Integration von besonders benachteiligten Personengruppen in Ausbildung und Arbeit.&nbsp;</p>\n<p>Dies trägt dem weiteren wichtigen Ziel der Sicherung der Fachkräftebedarfe auf dem bayerischen Arbeitsmarkt bei.&nbsp;</p>\n<p>Der AMF stellt eine subsidiäre Projektförderung in Form einer \"Anschubfinanzierung\" von bis zu drei Jahren für Initiativen dar, die in erster Linie Arbeitslose und von Arbeitslosigkeit bedrohte Personen ansprechen. Einzelne Personen erhalten keine Förderung.&nbsp;</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Anteilsfinanzierung/Kapitalbeteiligung" ];
                                xyz:foerderbereich       [ rdf:_1  "Arbeit";
                                                           rdf:_2  "Aus und Weiterbildung";
                                                           rdf:_3  "Beratung";
                                                           rdf:_4  "Digitalisierung";
                                                           rdf:_5  "Gesundheit und Soziales"
                                                         ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Vereine";
                                                           rdf:_2  "Kommunen";
