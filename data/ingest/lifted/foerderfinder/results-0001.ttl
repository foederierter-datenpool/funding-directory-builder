                                                                                                                                           xyz:zustaendigeStelle  [ xyz:zustaendigeStelleDetails  [ xyz:zustaendigeStelleInformationen
                                                                                                                                                                                      "Zuständig ist die jeweilige für Sie zuständige Bezirksregierung; Ministerialbeauftragte für Realschulen und Gymnasien sowie die staatlichen Schulämter" ]
                                                                                                                                                                  ]
