                                xyz:xml   "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           produkt=\"Förderfinder\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produktversion=\"\"\n                                           standard=\"XFLB\"\n                                           test=\"\"\n                                           version=\"2.0.0\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0 xflb.xsd\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>7b46b240-ee09-4595-bb96-34a575540b04</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-12-18T08:57:29</xflb:erstellungszeitpunkt>\n      <xflb:sender>Förderfinder Suche (Bayern)</xflb:sender>\n      <xflb:empfaenger>XFLB-Connect (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>7b46b240-ee09-4595-bb96-34a575540b04</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>7b46b240-ee09-4595-bb96-34a575540b04</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>7b46b240-ee09-4595-bb96-34a575540b04</xflb:foerderschluessel>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400185017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"1\">\n                        <code>4</code>\n                        <name>Regelungskompetenz auf Landesebene</name>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Finanzhilfen für Baumaßnahmen privater Grund- und Mittelschulen</xflb:titel>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/rob-zz/44/rob_44-001-zz/index</xflb:link>\n                     <xflb:bezeichnung>Unterlagenverzeichnis zur Bauförderung nach Schulfinanzierungsgesetz</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:beschreibung>\n                  <xflb:teaser>Schulaufsichtlich genehmigte private Grundschulen und Mittelschulen können Zuschüsse für Baumaßnahmen erhalten.</xflb:teaser>\n                  <xflb:zuwendungszweck>&lt;p&gt;Finanzhilfen für Baumaßnahmen privater Grund- und Mittelschulen. Durch die staatlichen Baukostenzuschüsse sollen private Träger unterstützt werden.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:schluesselwoerter>Baumaßnahmen, Zuschüsse, Grund- und Mittelschulen, Schulbau, Finanzierung, Projektförderung</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Staatsministerium für Unterricht und Kultus</xflb:name>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n                  <xflb:adresse>\n                     <xflb:strasse>Salvatorstraße</xflb:strasse>\n                     <xflb:hausnummerPostfach>2</xflb:hausnummerPostfach>\n                     <xflb:postleitzahl>31333</xflb:postleitzahl>\n                     <xflb:ort>München</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:verweis>\n                     <xflb:link>https://www.bayernportal.de/dokumente/leistung/904070599873</xflb:link>\n                     <xflb:bezeichnung>Private Grund- und Mittelschulen; Beantragung eines Zuschusses für Baumaßnahmen</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>die örtlich zuständige Regierung</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name>Bayern</name>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Unterricht und Kultus</xflb:verantwortlichesMinisterium>\n               <xflb:verantwortlichesFachreferat>IV.4</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Private Grund- und Mittelschulen; Beantragung eines Zuschusses für Baumaßnahmen gem. Art. 32 BaySchFG</xflb:programmtitel>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BaySchFG-32</xflb:link>\n                     <xflb:bezeichnung>Art. 32 BaySchFG; Leistungen für den Schulaufwand, Verordnungsermächtigung,</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2024-11-30</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2030-11-30</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:verlaengerungsoption>ja</xflb:verlaengerungsoption>\n               </xflb:programmlaufzeit>\n               <xflb:kummulierbareFoerderungen>\n                  <xflb:voraussetzungen>&lt;p&gt;Private Grund- und Mittelschulen, die von einer juristischen Person des öffentlichen oder privaten Rechts betrieben werden und auf gemeinnütziger Grundlage wirken, erhalten gemäß Art. 32 Bayerisches Schulfinanzierungsgesetz (BaySchFG) für notwendige und schulaufsichtlich genehmigte Baumaßnahmen einen Zuschuss in Höhe von 60 % (70 % bei staatlich anerkannten Grundschulen und Mittelschulen) der förderfähigen Kosten, sofern diese mehr als 25.000 Euro betragen. Dabei können die Kosten als förderfähig anerkannt werden, die bei kommunalen Schulbaumaßnahmen im kommunalen Finanzausgleich als förderfähiger Aufwand gelten. Der Zeitpunkt der Ersatzleistungen für Baukosten richtet sich nach den im Staatshaushalt ausgebrachten Mitteln. Für private Grundschulen und Haupt-/Mittelschulen, die am 7. Oktober 2014 errichtet oder als staatliche Ersatzschule anerkannt waren, werden Zuschusssätze in Höhe von 70 % bzw. 80% geleistet.&lt;/p&gt;\n&lt;p&gt;Weitere Voraussetzungen für die Förderung sind:&lt;/p&gt;\n&lt;p&gt;· Vorliegen einer schulaufsichtlichen Genehmigung der Schule nach Art. 92 ff. BayEUG&lt;/p&gt;\n&lt;p&gt;· Leistungen werden erst gewährt, wenn die Schule mindestens zwei Jahre ohne wesentliche schulaufsichtliche Beanstandungen bestanden hat&lt;/p&gt;\n&lt;p&gt;· noch nicht erfolgter Baubeginn&lt;/p&gt;\n&lt;p&gt;· dingliche Sicherung etwaiger Rückforderungsansprüche für die Zeit der Zweckbindung der Zuwendung (im Regelfall 25 Jahre)&lt;/p&gt;\n&lt;p&gt;· Bei der Vergabe von Aufträgen zur Erfüllung des Zuwendungszwecks sind die vergaberechtlichen Vorschriften einzuhalten.&lt;/p&gt;</xflb:voraussetzungen>\n                  <xflb:verweise>\n                     <xflb:verweis>\n                        <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/rob-zz/44/rob_44-001-zz/index</xflb:link>\n                        <xflb:bezeichnung>Formular zur Antragstellung</xflb:bezeichnung>\n                     </xflb:verweis>\n                  </xflb:verweise>\n                  <xflb:beschreibungAusschluss>&lt;p&gt;keine&lt;/p&gt;</xflb:beschreibungAusschluss>\n               </xflb:kummulierbareFoerderungen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.bayernportal.de/dokumente/leistung/904070599873</xflb:linkZurAntragsstellung>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Die Regierungen geben Auskunft über die beizufügenden Unterlagen</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Die Regierungen geben Auskunft über die beizufügenden Unterlagen</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristSpanne>\n                        <xflb:min>\n                           <xflb:monate>1</xflb:monate>\n                        </xflb:min>\n                        <xflb:max>\n                           <xflb:monate>6</xflb:monate>\n                        </xflb:max>\n                     </xflb:fristSpanne>\n                  </xflb:zeitlicheEingrenzung>\n               </xflb:antragsfrist>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Der Antrag ist mit sämtlichen benötigten Unterlagen schriftlich bei der entsprechend dem Sitz der privaten Grund- oder Mittelschule örtlich zuständigen Regierung einzureichen. Nach Prüfung entscheidet die Regierung über die Bewilligung des Zuschusses.&lt;/p&gt;\n&lt;p&gt;&lt;br&gt;&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                     <name/>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:monate>1</xflb:monate>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>6</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:beantragungskosten>\n                  <xflb:kostenbehaftet>\n                     <xflb:kostenhoehe>\n                        <xflb:kostenhoeheVariabel>\n                           <xflb:minGeldbetrag>10</xflb:minGeldbetrag>\n                           <xflb:maxGeldbetrag>2150</xflb:maxGeldbetrag>\n                        </xflb:kostenhoeheVariabel>\n                     </xflb:kostenhoehe>\n                     <xflb:vorkasse>false</xflb:vorkasse>\n                     <xflb:kostentyp listURI=\"urn:xoev-de:fim:codeliste:xzufi.kostentyp\" listVersionID=\"1\">\n                        <code>017</code>\n                        <name/>\n                     </xflb:kostentyp>\n                     <xflb:zahlungsweisen>\n                        <xflb:zahlungsweise listURI=\"urn:de:xzufi:codeliste:zahlungsweise\" listVersionID=\"1\">\n                           <code>2000100</code>\n                           <name>Überweisung/Zahlschein</name>\n                        </xflb:zahlungsweise>\n                     </xflb:zahlungsweisen>\n                     <xflb:kassenzeichen>Wird von der Bewilligungsstelle mitgeteilt</xflb:kassenzeichen>\n                     <xflb:bemerkung>Die notwendigen Antragsformulare erhalten Sie bei der entsprechend dem Sitz der privaten Grund- oder Mittelschule örtlich zuständigen Regierung.</xflb:bemerkung>\n                  </xflb:kostenbehaftet>\n               </xflb:beantragungskosten>\n            </xflb:antragsinformationen>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Privaten Grundschulen und Mittelschulen, die von einer juristischen Person des öffentlichen oder privaten Rechts betrieben werden und auf gemeinnütziger Grundlage wirken, werden für notwendige und schulaufsichtlich genehmigte Baumaßnahmen Zuschüsse gewährt. Es gilt eine zweijährige Karenzzeit.&lt;/p&gt;\n&lt;p&gt;Private Grund- und Mittelschulen, die von einer juristischen Person des öffentlichen oder privaten Rechts betrieben werden und auf gemeinnütziger Grundlage wirken, erhalten gemäß Art. 32 Bayerisches Schulfinanzierungsgesetz (BaySchFG) für notwendige und schulaufsichtlich genehmigte Baumaßnahmen einen Zuschuss in Höhe von 60 % (70 % bei staatlich anerkannten Grundschulen und Mittelschulen) der förderfähigen Kosten, sofern diese mehr als 25.000 Euro betragen. Dabei können die Kosten als förderfähig anerkannt werden, die bei kommunalen Schulbaumaßnahmen im kommunalen Finanzausgleich als förderfähiger Aufwand gelten. Der Zeitpunkt der Ersatzleistungen für Baukosten richtet sich nach den im Staatshaushalt ausgebrachten Mitteln. Für private Grundschulen und Haupt-/Mittelschulen, die am 7. Oktober 2014 errichtet oder als staatliche Ersatzschule anerkannt waren, werden Zuschusssätze in Höhe von 70 % bzw. 80% geleistet. Es gilt eine zweijährige Karenzzeit.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:finanzierung>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Höhe der Förderung beträgt 60 % (70 % bei staatlich anerkannten Grundschulen und Mittelschulen) der förderfähigen Kosten, sofern diese mehr als 25.000 Euro betragen. Dabei können die Kosten als förderfähig anerkannt werden, die bei kommunalen Schulbaumaßnahmen im kommunalen Finanzausgleich als förderfähiger Aufwand gelten. Der Zeitpunkt der Ersatzleistungen für Baukosten richtet sich nach den im Staatshaushalt ausgebrachten Mitteln. Für private Grundschulen und Haupt-/Mittelschulen, die am 7. Oktober 2014 errichtet oder als staatliche Ersatzschule anerkannt waren, werden Zuschusssätze in Höhe von 70 % bzw. 80% geleistet.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Baumaßnahmen bei Grund- und Mittelschulen&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:zuwendungsart>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>003</code>\n                  <name>Einzelunternehmen</name>\n               </xflb:foerdernehmende>\n            </xflb:foerdernehmende>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Privaten Grund- und Mittelschulen, die von einer juristischen Person des öffentlichen oder privaten Rechts betrieben werden und auf gemeinnütziger Grundlage wirken, erhalten gemäß Art. 32 Bayerisches Schulfinanzierungsgesetz (BaySchFG) für notwendige und schulaufsichtlich genehmigte Baumaßnahmen einen Zuschuss in Höhe von 60 % (70 % bei staatlich anerkannten Grundschulen und Mittelschulen) der förderfähigen Kosten, sofern diese mehr als 25.000 Euro betragen. Dabei können die Kosten als förderfähig anerkannt werden, die bei kommunalen Schulbaumaßnahmen im kommunalen Finanzausgleich als förderfähiger Aufwand gelten. Der Zeitpunkt der Ersatzleistungen für Baukosten richtet sich nach den im Staatshaushalt ausgebrachten Mitteln. Für private Grundschulen und Haupt-/Mittelschulen, die am 7. Oktober 2014 errichtet oder als staatliche Ersatzschule anerkannt waren, werden Zuschusssätze in Höhe von 70 % bzw. 80% geleistet.&lt;/p&gt;\n&lt;p&gt;Weitere Voraussetzungen für die Förderung sind:&lt;/p&gt;\n&lt;p&gt;· Vorliegen einer schulaufsichtlichen Genehmigung der Schule nach Art. 92 ff. BayEUG&lt;/p&gt;\n&lt;p&gt;· Leistungen werden erst gewährt, wenn die Schule mindestens zwei Jahre ohne wesentliche schulaufsichtliche Beanstandungen bestanden hat&lt;/p&gt;\n&lt;p&gt;· noch nicht erfolgter Baubeginn&lt;/p&gt;\n&lt;p&gt;· dingliche Sicherung etwaiger Rückforderungsansprüche für die Zeit der Zweckbindung der Zuwendung (im Regelfall 25 Jahre)&lt;/p&gt;\n&lt;p&gt;· Bei der Vergabe von Aufträgen zur Erfüllung des Zuwendungszwecks sind die vergaberechtlichen Vorschriften einzuhalten.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-12-18T08:57:29</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>016</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>\n"
                              ]
            ];
  rdf:_30   [ xyz:attributes  [ xyz:antragsstellung      "https://foerderung.bayern.de/landingpage/2f3fbc5e-1a2d-4f21-b5d3-273b0782216d";
