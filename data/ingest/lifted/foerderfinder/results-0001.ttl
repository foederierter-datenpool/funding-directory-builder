                                xyz:xml   "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           produkt=\"Förderfinder\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produktversion=\"\"\n                                           standard=\"XFLB\"\n                                           test=\"\"\n                                           version=\"2.0.0\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0 xflb.xsd\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>b8987cc6-e680-43d3-b1af-30132d958a1c</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-01-11T14:50:57</xflb:erstellungszeitpunkt>\n      <xflb:sender>Förderfinder Suche (Bayern)</xflb:sender>\n      <xflb:empfaenger>XFLB-Connect (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>b8987cc6-e680-43d3-b1af-30132d958a1c</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>b8987cc6-e680-43d3-b1af-30132d958a1c</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n                  <xflb:foerderschluessel>b8987cc6-e680-43d3-b1af-30132d958a1c</xflb:foerderschluessel>\n               </xflb:interneKennung>\n            </xflb:zuordnungen>\n            <xflb:finanzierung>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>Zuwendung beträgt 50 %der zuwendungsfähigen Ausgaben, maximal 1 Million Euro.</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>Ergänzungen zu den Regelungen der RZWas 2021\nZu Nr. 5.2.4 Ausgaben der Architekten- und Ingenieurleistungen\nDie Ausgaben der Architekten- und Ingenieurleistungen werden mit einem pauschalen Zuschlag von 10 %\nauf die Summe der ermittelten Investitionsausgaben nach Nr. 5.2.1 zugerechnet, sofern die Pauschale nicht\nentfällt. Liegt die Summe der ermittelten Investitionsausgaben über 5 Millionen Euro, beträgt der Zuschlag\n9 %. Für gesonderte Alternativplanungen (wenigstens Leistungsphase 1 und 2) erhöht sich der Pauschal-\nzuschlag je beauftragtem weiteren Ingenieurbüro um 1,5, maximal um 3,0 Prozentpunkte. Die tatsächlich\nangefallenen Ausgaben für Architekten- und Ingenieurleistungen sind, soweit sie im Bauausgabebuch er-\nfasst werden, dort als nicht zuwendungsfähig auszuweisen.</xflb:zuwendungsfaehigeKosten>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:zuwendungsart>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerFest>\n                        <xflb:jahre>4</xflb:jahre>\n                     </xflb:dauerFest>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name>Bayern</name>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name>Kommunen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name>Verbände</name>\n               </xflb:foerdernehmende>\n            </xflb:foerdernehmende>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Vorhaben zur Umsetzung der EG-Wasserrahmenrichtlinie bei Anlagen der öffentlichen Abwasserentsorgung (Teil C RZWas 2021)</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:teaser>Wenn ergänzende Maßnahmen nach EG_WRRL im Maßnahmenprogramm gefordert sind, können Sie Zuwendungen erhalten.</xflb:teaser>\n                  <xflb:zuwendungszweck>Gefördert werden in Förderprogrammen nach Nr. 7 Vorhaben zur Umsetzung der EGWasserrahmenrichtlinie,\ndie bei Anlagen der öffentlichen Abwasserentsorgung durchzuführen sind (nur in\nMaßnahmenprogrammen aufgeführte ergänzende Maßnahmen).</xflb:zuwendungszweck>\n                  <xflb:schluesselwoerter>EG-WRRL, Stickstoff-Elimination, Phosphor-Elimination, weitergehende Maßnahmen</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:allgemeineFragen>\n                  <xflb:name>regional zuständiges Wasserwirtschaftsamt</xflb:name>\n                  <xflb:verweis>\n                     <xflb:link>https://www.stmuv.bayern.de/themen/wasserwirtschaft/wasserwirtschaft_in_bayern/wasseraemter.htm</xflb:link>\n                     <xflb:bezeichnung>Ihr zuständiges Wasserwirtschaftsamt</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Das regional zuständige Wasserwirtschaftsamt</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>Vorhaben zur Umsetzung der EGWasserrahmenrichtlinie, die bei Anlagen der öffentlichen Abwasserentsorgung durchzuführen sind (nur in Maßnahmenprogrammen aufgeführte ergänzende Maßnahmen).</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-01-11T14:50:57</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index</xflb:linkZurAntragsstellung>\n               <xflb:antragsfrist>\n                  <xflb:bemerkung>Der Antrag muss bis 30 09.2028 gestellt werden</xflb:bemerkung>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristSpanne>\n                        <xflb:max>\n                           <xflb:jahre>4</xflb:jahre>\n                        </xflb:max>\n                        <xflb:min>\n                           <xflb:jahre>1</xflb:jahre>\n                        </xflb:min>\n                     </xflb:fristSpanne>\n                  </xflb:zeitlicheEingrenzung>\n               </xflb:antragsfrist>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>Antrag beim Wasserwirtschaftsamt abgeben. Nach der Prüfung erhält der Antragsteller den Zuwendungsbescheid und kann mit der Umsetzung der Maßnahme beginnen.</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Entwurf nach REWas</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Entwurf für das Vorhaben beziehungsweise den Bauabschnitt, aufgestellt nach den Richtlinien für den\nEntwurf von wasserwirtschaftlichen Vorhaben (REWas) in der jeweils geltenden Fassung (zweifach)</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Erläuterung</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Erläuterung (Kurzfassung für den im Bauabschnitt zu fördernden Teil, zweifach)</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Lageplan</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Lageplan, in dem die zu fördernden Teile rot gekennzeichnet sind (zweifach)</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Gemeinderatsbeschluss</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Beschluss des zuständigen Organs des Zuwendungsempfängers, das Vorhaben durchführen zu wollen\n(zweifach)</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Erklärung</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Erklärung des Vorhabenträgers, ob er die Zuwendung an einen Dritten weiterleitet (zweifach)</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:monate>1</xflb:monate>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>3</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n            </xflb:antragsinformationen>\n            <xflb:foerdervoraussetzungen>\n               <xflb:ausschlusskriterien>Nach Art. 16 Abs. 1 Satz 3 BayAbwAG ist für Zuführungsanlagen eine Förderung gänzlich ausgeschlossen, wenn für diese gemäß § 10 Abs. 4 AbwAG eine Verrechnung nach dem 1. Januar 2007 erklärt worden ist.</xflb:ausschlusskriterien>\n               <xflb:buergerfreundlicheBeschreibung>- Die zuwendungsfähigen Ausgaben müssen über 50.000 Euro betragen.\n- Die Wirtschaftlichkeit und Sparsamkeit eines Vorhabens sind nachzuweisen nach Nr. 6.2 VV zu Art. 44 BayHO in Verbindung mit Nr. 4.1 BayZBau). Wenn mehrere Lösungen möglich sind, kann nur die\nwirtschaftlichste und sparsamste Lösung gefördert werden.\n- Es können nur Vorhaben gefördert werden, die noch nicht begonnen worden sind (Nr. 1.3 VV zu Art. 44 BayHO). Als Vorhabenbeginn ist grundsätzlich die Abgabe einer verbindlichen Willenserklärung zum Abschluss eines der Ausführung zuzurechnenden Lieferungs- oder Leistungsvertrags zu werten. Bei\nBaumaßnahmen gelten Planungsaufträge bis einschließlich Leistungsphase sieben der HOAI, Baugrunduntersuchungen, Grunderwerb und Herrichten des Grundstücks (zum Beispiel Gebäudeabbruch,\nPlanieren), naturschutzfachliche Erhebungen sowie naturschutzfachliche Ausgleichs- und Ersatzmaßnahmen, die vor dem Beginn der Hauptmaßnahme ausgeführt werden müssen, nicht als Beginndes Vorhabens. Das Wasserwirtschaftsamt (WWA) kann im Ausnahmefall dem vorzeitigen Vorhabenbeginn schriftlich zustimmen.</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:programmtitel>Vorhaben zur Umsetzung der EG-Wasserrahmenrichtlinie bei Anlagen der öffentlichen Abwasserentsorgung (Teil C RZWas 2021)</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2028-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:verantwortlichesFachreferat>58</xflb:verantwortlichesFachreferat>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Umwelt und Verbraucherschutz</xflb:verantwortlichesMinisterium>\n               <xflb:programmlaufzeit>\n                  <xflb:endeLaufzeitFoerderprogramm>2024-12-31</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:beginnLaufzeitFoerderprogramm>2021-04-01</xflb:beginnLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_7538_U_15039-ANL_1</xflb:link>\n                     <xflb:bezeichnung>Anhang Teil C zur RZWas 2025</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>019</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>\n"
                              ]
            ];
