                                                                                                                                                                                                       xyz:listURI        "urn:xoev-de:stmd:codeliste:laufzeit-finanzierung";
                                                                                                                                                                                                       xyz:listVersionID  "1";
                                                                                                                                                                                                       xyz:name           "Gesamte Projektlaufzeit"
                                                                                                                                                                                                     ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Zuwendungsfähig sind Personalausgaben, Sachausgaben und Ausgaben für die Kinderbetreuung. Es können nur Ausgaben anerkannt werden, die durch das bewilligte Projekt veranlasst, dem Projekt zuordenbar und angemessen sind. Gemeinausgaben sind begrenzt zuwendungsfähig.</p><p>Die Höhe der Zuwendung wird auf höchstens 50.000 Euro begrenzt.</p>"
                                                                                                                                         ];
