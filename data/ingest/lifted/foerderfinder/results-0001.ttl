                                                                                                                                           xyz:zustaendigeStelle  [ xyz:zustaendigeStelleDetails  [ xyz:zustaendigeStelleInformationen
                                                                                                                                                                                      "Die zuständige Bewilligungsbehörde ist Ihre Bezirksregierung: Für Kommunen in Oberbayern und der Oberpfalz die Regierung von Oberbayern (E-Mailadresse: kommklimafoer@reg-ob.bayern.de, Frau Metz und Herr Kögl), in Schwaben und Niederbayern die Regierung von Schwaben (E-Mailadresse: kommklimafoer@reg-schw.bayern.de, Frau Löw-Beer und Frau Danzer) sowie in Unter-, Ober- und Mittelfranken die Regierung von Unterfranken (E-Mailadresse: kommklimafoer@reg-ufr.bayern.de, Frau Sprenger-Zier und Frau Grgic)." ]
                                                                                                                                                                  ]
                                                                                                                                         ];
