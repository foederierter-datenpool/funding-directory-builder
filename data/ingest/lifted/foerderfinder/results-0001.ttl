                                                                                                                       xyz:handlungsgrundlagen        [ xyz:verweis  [ xyz:bezeichnung  "Richtlinie zur Förderung von partizipativen Projekten der Kulturellen Bildung mit Kindern, Jugendlichen und Erwachsenen, auch im internationalen Ideenaustausch Förderrichtlinie Kulturfonds Kulturelle Bildung";
                                                                                                                                                                       xyz:link         "https://www.gesetze-bayern.de/Content/Document/BayVV_2230_1_2_K_13959/true"
                                                                                                                                                                     ]
                                                                                                                                                      ];
                                                                                                                       xyz:kummulierbareFoerderungen  [ xyz:beschreibungAusschluss  "<p>Eine gleichzeitige Förderung aus anderen staatlichen Förderansätzen (des Freistaats Bayern) ist grundsätzlich ausgeschlossen (Verbot der Doppelförderung).</p>";
                                                                                                                                                        xyz:voraussetzungen         "<p>Zuschüsse anderer öffentlicher Zuwendungsgeber (insb. Bezirk, Landkreis, Gemeinde/Stadt) sind dagegen möglich und erwünscht. Eine gleichzeitige Förderung aus EU-Mitteln oder Bundesmitteln ist möglich (Ausnahme: Vorhaben des Internationalen Ideenaustausches). Weitere private Fördermittelgeber sind möglich, wie z.B. Stiftungen, örtliche Banken, Sponsoring, Spenden durch Organisationen und Private.</p>"
                                                                                                                                                      ];
