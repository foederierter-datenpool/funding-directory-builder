                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>a03eeb77-bea5-438a-b86c-c6662ea45e54</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-08-29T16:33:15</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>a03eeb77-bea5-438a-b86c-c6662ea45e54</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>a03eeb77-bea5-438a-b86c-c6662ea45e54</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-08-29T16:33:15</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>a03eeb77-bea5-438a-b86c-c6662ea45e54</xflb:foerderschluessel>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99148176017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Angehörigenarbeit; Beantragung einer Förderung</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>Zweck der Förderung ist es, ein auf Dauer angelegtes und landesweites Angebot\nfür pflegende Angehörige sicherzustellen, das die Pflegeberatung nach § 7a SGB\nXI oder das Versorgungsmanagement nach § 11 Abs. 4 SGB V ergänzt. Neben\nAngehörigen können auch sonstige nicht erwerbsmäßige Pflegepersonen und ältere\npflegebedürftige Menschen beraten werden.</xflb:zuwendungszweck>\n                  <xflb:teaser>Fachstellen für pflegende Angehörige beraten und unterstützen vor allem psychosozial pflegende Angehörige von älteren pflegebedürftigen Menschen. Deren Träger können eine Zuwendung im Rahmen einer Projektförderung erhalten.</xflb:teaser>\n               </xflb:beschreibung>\n               <xflb:alternativeFoerdermoeglichkeiten>\n                  <xflb:alternativeFoerdermoeglichkeit>\n                     <xflb:beschreibung>Der Freistaat Bayern gewährt Zuwendungen für Pflegestützpunkte</xflb:beschreibung>\n                     <xflb:verweis>\n                        <xflb:bezeichnung>Pflegestützpunkte; Beantragung einer Zuwendung Der Freistaat Bayern gewährt Zuwendungen für Pflegestützpunkte</xflb:bezeichnung>\n                        <xflb:link>https://www.bayernportal.de/dokumente/leistung/4841776479242</xflb:link>\n                     </xflb:verweis>\n                  </xflb:alternativeFoerdermoeglichkeit>\n               </xflb:alternativeFoerdermoeglichkeiten>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>\"Bayerisches Netzwerk Pflege\" - Förderung der Familienpflege, Angehörigenarbeit / Fachstellen für pflegende Angehörige und Pflegestützpunkte</xflb:bezeichnung>\n                     <xflb:link>https://www.stmgp.bayern.de/service/foerderprogramme/foerderprogramm-bayerisches-netzwerk-pflege-und-richtlinie-netzwerk-pflege-familienpflegefachstellen-pflegende-angehoerige/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Fachstellen für pflegende Angehörige</xflb:bezeichnung>\n                     <xflb:link>https://www.stmgp.bayern.de/pflege/pflege-zu-hause/fachstellen_pflegende_angehoerige/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Angehörigenarbeit/ Fachstellen für pflegende Angehörige</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/angehorigenarbeit-fachstellen-fur-pflegende-angehorige/</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Landesamt für Pflege</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>4</xflb:hausnummerPostfach>\n                     <xflb:strasse>Mildred-Scheel-Straße</xflb:strasse>\n                     <xflb:postleitzahl>92224</xflb:postleitzahl>\n                     <xflb:ort>Amberg</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>poststelle@lfp.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Bayerisches Landesamt für Pflege</xflb:bezeichnung>\n                     <xflb:link>www.lfp.bayern.de</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>+49 9621 9669-0</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Bayerisches Landesamt für Pflege</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>4</xflb:hausnummerPostfach>\n                           <xflb:strasse>Mildred-Scheel-Straße</xflb:strasse>\n                           <xflb:postleitzahl>92224</xflb:postleitzahl>\n                           <xflb:ort>Amberg</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>poststelle@lfp.bayern.de</xflb:email>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Bayerisches Landesamt für Pflege</xflb:bezeichnung>\n                           <xflb:link>www.lfp.bayern.de</xflb:link>\n                        </xflb:verweis>\n                        <xflb:telefonnummer>+49 9621 9669-0</xflb:telefonnummer>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>7483f2fe-c45c-428c-9bb3-ac1aa1311d11</xflb:id>\n                     <xflb:bezeichnung>Förderantrag auf Bewilligung einer staatlichen Zuwendung</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/Dokumente/Foerderantrag%20AUA%20AA.pdf</xflb:link>\n                     <xflb:beschreibung>&lt;p&gt;Förderantrag für Angebote zur Unterstützung im Alltag nach § 45a SGB XI, ehrenamtliche Strukturen und weitere Angebote nach § 45c SGB XI sowie Teil 8 Abschnitte 5 und 6 der Verordnung zur Ausführung der Sozialgesetze (AVSG), für Angehörigenarbeit nach der Richtlinie für die Förderung im \"Bayerischen Netzwerk Pflege\".&lt;/p&gt;</xflb:beschreibung>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>a0852023-affd-41d6-b5f4-881f496a498e</xflb:id>\n                     <xflb:bezeichnung>Erklärung zum Antrag auf Gewährung einer Förderung als DAWI-De-minimis-Beihilfe nach der Verordnung (EU) 2023/28321</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/wp-content/uploads/2024/01/DAWI-De-minimis-Erklaerung.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>348c3eae-df02-4c64-b0d8-226e807ee966</xflb:id>\n                     <xflb:bezeichnung>Konzeption/Bescheinigung über die Anbindung der Fachstelle für pflegende Angehörige an einen Pflegestützpunkt</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/wp-content/uploads/2022/12/Bescheinigung_Konzeption-raeumliche-Anbindung_PSP-FfpA.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>8c752c2d-36ea-47d9-bd60-5ff9864e93f7</xflb:id>\n                     <xflb:bezeichnung>Erklärung Subventionserhebliche Tatsachen</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/wp-content/uploads/2023/03/240821_Erklaerung-Subventionserhebliche-Tatsachen.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>7bba4ca5-301b-4e61-ba52-ae42d3894015</xflb:id>\n                     <xflb:bezeichnung>Formular Verwendungsnachweis</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/dokumente/AUA/Verwendungsnachweis_AUA+SN+AA.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>a7493499-95b5-44bf-9eec-27806c007d93</xflb:id>\n                     <xflb:bezeichnung>Ausgabenübersicht</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/wp-content/uploads/2022/10/Ausgabenuebersicht_AUA-SN-AA.xlsx</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Zuwendungsempfänger sind vorrangig die Verbände der freien Wohlfahrtspflege und die ihnen angeschlossenen Organisationen, freigemeinnützige Stiftungen sowie private Anbieter, soweit sie Angehörigenarbeit durchführen und Fachkräfte beschäftigen.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die staatliche Zuwendung wird als Festbetragsfinanzierung im Rahmen einer Projektförderung gewährt. Die mögliche Förderpauschale orientiert sich an der in der Fachstelle beschäftigten, berücksichtigungsfähigen Fachkraft. Für eine vollzeitbeschäftigte Fachkraft beträgt die Pauschale jährlich bis zu 35.000,00 Euro.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Personal- und Sachausgaben der Fachstelle.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerFest>\n                        <xflb:jahre>1</xflb:jahre>\n                     </xflb:dauerFest>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n               <xflb:euBeihilferelevanz>Die Prüfung der Freistellung der Fördermaßnahme von der Anmeldepflicht bei der EU-Kommission erfolgt im Rahmen der Antragsbearbeitung durch die Bewilligungsbehörde.</xflb:euBeihilferelevanz>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Gesundheit, Pflege und Prävention</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinie für die Förderung im \"Bayerischen Netzwerk Pflege\"</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVwV294809</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat 42</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Angehörigenarbeit; Beantragung einer Förderung</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2028-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2025-07-31</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2028-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Aufgabe der Fachstellen für pflegende Angehörige ist es, kontinuierlich und in offener Zusammenarbeit mit allen am Pflegenetzwerk Beteiligten Angehörige psychosozial zu beraten, (auch längerfristig) zu begleiten und mit Entlastungsangeboten zu unterstützen.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>004</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Die einzelnen Voraussetzungen für die Förderung einer Fachstelle für pflegende Angehörige sind in Abschnitt I. 2. der Richtlinie für die Förderung im \"Bayerischen Netzwerk Pflege\" geregelt. Die Förderpauschale wird insbesondere für fortgebildete Pflegefachkräfte sowie für Sozialpädagoginnen bzw. Sozialpädagogen und vergleichbare akademische Qualifikationen gewährt, die aufgrund mehrjähriger Berufstätigkeit mit den Hilfemöglichkeiten für pflegende Angehörige vertraut sind oder an einer entsprechenden Fortbildung teilgenommen haben. Gesetzliche Leistungen sind vorrangig in Anspruch zu nehmen. Die Fachstellen für pflegende Angehörige benötigen eine kommunale Befürwortung durch den Landkreis bzw. die kreisfreie Stadt, in welchem bzw. welcher sie tätig werden wollen.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.lfp.bayern.de/Dokumente/Foerderantrag%20AUA%20AA.pdf</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Der Antrag ist schriftlich oder elektronisch beim Bayerischen Landesamt für Pflege zu stellen. Die bereitgestellten Vordrucke sind zu verwenden.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>003</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>Die Zustimmung zum vorzeitigen Maßnahmebeginn gilt mit der Antragstellung allgemein als erteilt.</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:sonstige>ja</xflb:sonstige>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Die Antragstellung muss bis 31.12. des dem Förderjahr vorangehenden Jahres erfolgt sein.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Projektbeschreibung (Aufbau, Umsetzung, Qualitätssicherung, Leitung)</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Kommunale Befürwortung für die Fachstelle (Nachweis gemäß Abschnitt I. 2. Nr. 2.3.3 der Richtlinie für die Förderung im \"Bayerischen Netzwerk Pflege\")</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>Gegen den Zuwendungsbescheid können Sie innerhalb eines Monats Klage erheben. Das zuständige Gericht, bei dem Sie Klage einreichen können, wird Ihnen im Bescheid mitgeteilt.</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_40   [ xyz:attributes  [ xyz:antragsstellung      "https://foerderung.bayern.de/landingpage/301b4649-9390-429d-b004-acb3f748266e";
                                xyz:begriffeImKontext    [ rdf:_1  "Bildung";
