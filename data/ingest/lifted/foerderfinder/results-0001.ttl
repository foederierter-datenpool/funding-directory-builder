                                                           rdf:_19  "kulturelles Erbe";
                                                           rdf:_2   "Krieg";
                                                           rdf:_3   "Sudetendeutsche";
                                                           rdf:_4   "Böhmen";
                                                           rdf:_5   "Mähren";
                                                           rdf:_6   "Siebenbürgen";
