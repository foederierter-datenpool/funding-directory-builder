                                                         ];
                                xyz:beschreibung         "<p>Der Freistaat Bayern fördert die behindertengerechte Anpassung von bestehendem Mietwohnraum an die Belange von Menschen mit Behinderung im Rahmen des Bayerischen Wohnungsbauprogramms mit einem leistungsfreien Baudarlehen von bis zu 10.000 Euro.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Kredit/Darlehen" ];
                                xyz:foerderbereich       [ rdf:_1  "Wohnungsbau und Modernisierung" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1   "Kleine und mittlere Unternehmen";
