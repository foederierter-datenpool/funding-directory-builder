                                                                                                                       xyz:kummulierbareFoerderungen  [ xyz:voraussetzungen
                                                                                                                                         "<p>Kofinanzierung von Projekten ist möglich, die aus einem EU- oder Bundesprogramm gefördert werden, sofern das EU- oder Bundesprogramm eine Landeskofinanzierung erfordert oder zulässt. Die Kofinanzierung ist gegenüber der EU- oder Bundesförderung nachrangig. Die Mindesteigenmittel von 10 % der zuwendungsfähigen Ausgaben sind zu beachten, sofern nicht das EU- oder Bundesprogramm höhere Eigenmittel vorschreibt.</p>" ];
                                                                                                                       xyz:programmlaufzeit           [ xyz:beginnLaufzeitFoerderprogramm
                                                                                                                                                                "2022-05-15";
                                                                                                                                                        xyz:endeLaufzeitFoerderprogramm
                                                                                                                                                                "2030-05-14"
                                                                                                                                                      ];
                                                                                                                       xyz:programmtitel              "Förderung von Projekten im bayerisch-tschechischen Grenzraum i.R. Förderrichtlinie Bayerisch-Tschechischer-Grenzraum (BYCZFöR)";
                                                                                                                       xyz:verantwortlichesFachreferat
                                                                                                                               "Referat 52";
                                                                                                                       xyz:verantwortlichesMinisterium
                                                                                                                               "Staatsministerium der Finanzen und für Heimat"
                                                                                                                     ];
                                                                                                             xyz:foerdervoraussetzungen  [ xyz:ausschlusskriterien  "<p>Eine Projektförderung kommt nicht in Betracht, sofern&nbsp;</p><ul><li class=\"unordered-list-item--dash\">eine der Zuwendungsvoraussetzungen nicht erfüllt ist,</li><li class=\"unordered-list-item--dash\">das Projekt bereits begonnen hat.</li></ul>";
                                                                                                                                           xyz:buergerfreundlicheBeschreibung
                                                                                                                                                   "<p>Eine Förderung nach der BYCZFöR setzt voraus, dass es sich bei Ihrem Vorhaben um ein Projekt mit grenzüberschreitendem Charakter sowie fachübergreifendem Ansatz, das heißt mindestens zwei Themenfelder (z.B. Demografie, Kultur, Tourismus, Mobilität/ Verkehr, Daseinsvorsorge, oder Ehrenamt) müssen gleichranging behandelt werden, handelt und das Projektgebiet im ländlichen Raum des Regierungsbezirks Niederbayern, Oberpfalz oder Oberfranken liegt. </p><p>Darüber hinaus müssen folgende Voraussetzungen erfüllt sein:&nbsp;</p><ul><li class=\"unordered-list-item--dash\">Übereinstimmung der Projekte mit den Festlegungen aus dem Landesentwicklungsprogramm Bayern und den einschlägigen Regionalplänen,</li><li class=\"unordered-list-item--dash\">Übereinstimmung der Projekte mit vorhandenen Entwicklungsstrategien,&nbsp;</li><li class=\"unordered-list-item--dash\">Einreichung eines Förderantrags mit festgelegten Evaluierungsindikatoren&nbsp;unter Verwendung der auf www.heimat.bayern/politik/foerdermoeglichkeiten abrufbaren Unterlagen,</li><li class=\"unordered-list-item--dash\">Abgabe einer Erklärung über die Sicherstellung der Gesamtfinanzierung</li><li class=\"unordered-list-item--dash\">die zuwendungsfähigen Ausgaben betragen je Projekt mehr als 25.000 Euro.</li></ul>"
                                                                                                                                         ];
