                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>65b68244-f3f4-4e60-8dc0-50639e252d8d</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-03-19T16:16:05</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>65b68244-f3f4-4e60-8dc0-50639e252d8d</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>65b68244-f3f4-4e60-8dc0-50639e252d8d</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-03-19T16:16:05</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>65b68244-f3f4-4e60-8dc0-50639e252d8d</xflb:foerderschluessel>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400296017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Fortbildungsmaßnahmen Behindertenhilfe</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>Zweck der Förderung ist die Unterstützung von Fortbildungsmaßnahmen.</xflb:zuwendungszweck>\n                  <xflb:teaser>Träger, die Fortbildungen anbieten für Personen, die in der Behindertenhilfe tätig sind, können eine Zuwendung für die Fortbildungsmaßnahmen vom Freistaat Bayern erhalten.</xflb:teaser>\n                  <xflb:schluesselwoerter>Behinderte, Fortbildung</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Fortbildung in der Behindertenhilfe</xflb:bezeichnung>\n                     <xflb:link>http://www.zbfs.bayern.de/foerderung/behinderte-menschen/fortbildung/index.php</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Zentrum Bayern Familie und Soziales</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>2</xflb:hausnummerPostfach>\n                     <xflb:strasse>Hegelstr.</xflb:strasse>\n                     <xflb:postleitzahl>95440</xflb:postleitzahl>\n                     <xflb:ort>Bayreuth</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>poststelle@zbfs.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Website ZBFS</xflb:bezeichnung>\n                     <xflb:link>https://www.zbfs.bayern.de/foerderung/behinderte-menschen/fortbildung/index.php</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>0921 605-3380</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Zentrum Bayern Familie und Soziales</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>2</xflb:hausnummerPostfach>\n                           <xflb:strasse>Hegelstr.</xflb:strasse>\n                           <xflb:postleitzahl>95447</xflb:postleitzahl>\n                           <xflb:ort>Bayreuth</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>poststelle@zbfs.bayern.de</xflb:email>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Website ZBFS</xflb:bezeichnung>\n                           <xflb:link>https://www.zbfs.bayern.de/foerderung/behinderte-menschen/fortbildung/index.php</xflb:link>\n                        </xflb:verweis>\n                        <xflb:telefonnummer>0921-605-3380</xflb:telefonnummer>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Zuwendungsempfänger sind Spitzenverbände der freien Wohlfahrtspflege und deren Mitgliedsorganisationen in Bayern sowie auf Landesebene wirkende oder andere fachlich anerkannte Verbände und sonstige Fortbildungsanbieter.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>Die Zuwendung wird als Festbetrag pro Fortbildungseinheit (FE = 45 Minuten) ausgereicht. Die Stundensätze werden gesondert festgesetzt. Dabei ist ein angemessener Eigenmitteleinsatz des Zuwendungsempfängers, mindestens aber in Höhe von 10 % der zuwendungsfähigen Ausgaben zu berücksichtigen.</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Zuwendungsfähig sind Sachausgaben für die Durchführung der Fortbildungsmaßnahmen, wie beispielsweise Raummiete, Referentenhonorare, Fahrtkosten und Material. &amp;nbsp;Pro Fortbildungseinheit wird ein Pauschalbetrag gewährt, der maximal 50 Euro betragen kann. Die Pauschalbeträge pro Fortbildungseinheit werden für jeden Förderbereich gesondert festgesetzt und betragen in der Behindertenhilfe derzeit weniger als 50 Euro.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerFest>\n                        <xflb:jahre>1</xflb:jahre>\n                     </xflb:dauerFest>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Familie, Arbeit und Soziales</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderrichtlinie Fortbildung der in den Bereichen Behindertenhilfe und psychiatrische Versorgung tätigen Personen (Förderrichtlinie Fortbildung - Fortbildung-FöR)</xflb:bezeichnung>\n                     <xflb:link>https://www.verkuendung-bayern.de/baymbl/2021-41/</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat II 4</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Behindertenhilfe; Beantragung einer Förderung für Fortbildungsmaßnahmen</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2028-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2025-05-15</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2028-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>Förderfähig sind Fortbildungsmaßnahmen, die zur Vermittlung, Erweiterung, Vertiefung und Weiterentwicklung der spezifischen Fachkenntnisse von in der Behindertenhilfe Tätigen (insbes. Fachpersonal, ehrenamtliche Helfer und Angehörige) erforderlich sind.</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Antragsteller legen vorab eine Auflistung aller geplanten Fortbildungsmaßnahmen vor (Fortbildungsprogramm). Das Zentrum Bayern Familie und Soziales (ZBFS) entscheidet, welche Maßnahmen für welche Zielgruppen gefördert werden.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Maßnahmen mit weniger als acht Teilnehmerinnen und Teilnehmern werden grundsätzlich nicht gefördert.&lt;/li&gt;&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:rechtlicheBeschreibung>&lt;p&gt;Mindestens 8 Teilnehmende, die in der Behindertenhilfe in Bayern tätig sind&lt;/p&gt;</xflb:rechtlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>http://www.zbfs.bayern.de/foerderung/behinderte-menschen/fortbildung/index.php</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Der Förderantrag muss beim Zentrum Bayern Familie und Soziales (ZBFS) bis 31. Oktober des Vorjahres eingereicht werden. Er kann zunächst ein formloser Antrag gestellt werden.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Es muss der vollständige Antrag mit Fortbildungsprogramm des Maßnahmeträgers vorgelegt werden. Bewilligungszeitraum ist das Kalenderjahr.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Nach Eingang des Durchführungsnachweises, einzureichen bis spätestens 1. März des auf den Bewilligungszeitraum folgenden Jahres, entscheidet das Zentrum Bayern Familie und Soziales (ZBFS) über die Bewilligung der Zuwendung.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>003</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:monate>3</xflb:monate>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>6</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristdatum>2026-10-31</xflb:fristdatum>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Das Fortbildungsprogramm muss dem Zentrum Bayern Familie und Soziales (ZBFS) bis 31. Oktober des dem Bewilligungszeitraum vorgehenden Jahres vorliegen.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Antragsformular</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Antragsunterlagen erhalten Sie von der Bewilligungsbehörde - Zentrum Bayern Familie und Soziales</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Fortbildungsprogramm bzw. - maßnahmen</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Verwendungsnachweis</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Gegen den Zuwendungsbescheid können Sie innerhalb von &amp;nbsp;einem Monat nach seiner Bekanntgabe Klage erheben. Das zuständige Gericht, bei dem Sie Klage einreichen können, wird Ihnen im Bescheid mitgeteilt.&lt;/p&gt;\n&lt;p&gt;&lt;br&gt;&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_13   [ xyz:attributes  [ xyz:antragsstellung      "https://www.bayernportal.de/dokumente/leistung/036075275773?localize=false";
                                xyz:beschreibung         "Durch die staatlichen Zuschüsse sollen private Träger bei der Finanzierung des\nSchulaufwands unterstützt werden.";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Aus und Weiterbildung";
                                                           rdf:_2  "Integration"
                                                         ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Kommunen";
                                                           rdf:_2  "Vereine";
                                                           rdf:_3  "Verbände"
                                                         ];
                                xyz:foerderprogramm      "Private Grund- und Mittelschulen; Private Grund- und Mittelschulen; Beantragung eines Zuschusses für den Schulaufwand gem. Art. 32 BaySchFG";
                                xyz:foerderzeitraum.bis  "2030-01-30T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2025-01-30T00:00:00.000+00:00";
                                xyz:schluessel           "74a90c1a-0af2-4f19-917b-8a4626ba1ee1";
                                xyz:teaser               "Schulaufsichtlich genehmigte private Grundschulen und Mittelschulen werden auf\nAntrag des Schulträgers staatlich gefördert. Für den notwendigen Schulaufwand\nwerden pauschalierte Zuschüsse gewährt.";
                                xyz:titel                "Private Grund- und Mittelschulen; Beantragung eines Zuschusses für den Schulaufwand";
                                xyz:titel.tokens         [ rdf:_1  "Private Grund- und Mittelschulen";
                                                           rdf:_2  "Beantragung eines Zuschusses für den Schulaufwand"
                                                         ];
                                xyz:voraussetzung        "<p>Private Grund- und Mittelschulen, die von einer juristischen Person des öffentlichen oder privaten Rechts betrieben werden und auf gemeinnütziger Grundlage wirken, erhalten gemäß Art. 32 Bayerisches Schulfinanzierungsgesetz (BaySchFG) für den notwendigen Schulaufwand im Rahmen der schulaufsichtlichen Genehmigung einen pauschalierten Zuschussbetrag je Schülerin oder Schüler und Schuljahr. Leistungen werden erst gewährt, wenn die Schule mindestens zwei Schuljahre (Karenzzeit) ohne wesentliche schulaufsichtliche Beanstandungen bestanden hat. Eine Schule mit weniger als 14 Schülerinnen und Schülern ist von der Leistungsgewährung ausgeschlossen.</p>\n<p>Weitere Voraussetzung für die Förderung sind:</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">Vorliegen einer schulaufsichtlichen Genehmigung der Schule nach Art. 92 ff BayEUG</li>\n</ul>"
                              ];
