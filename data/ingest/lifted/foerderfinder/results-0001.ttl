                                                                                                                                           xyz:linkZurAntragsstellung   "https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/b1/12/rmf_12-128/index";
                                                                                                                                           xyz:rechtsbehelf             "<p>Gegen den Zuweisungsbescheid können Sie innerhalb eines Monats Widerspruch einlegen. Die Stelle, bei der Sie den Widerspruch einreichen können, wird Ihnen im Bescheid mitgeteilt.</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<p>Anträge auf Zuweisungen sind bei der für die Kommune zuständigen Bezirksregierung einzureichen. Hierzu sind die von der Bewilligungsbehörde bereitgestellten Muster zu verwenden.</p><p>Weiteres Verfahren:&nbsp;</p><ul><li class=\"unordered-list-item--dash\">Die Regierung prüft und verbescheidet den Antrag.&nbsp;</li><li class=\"unordered-list-item--dash\">Zuweisungen werden von der Regierung jeweils für ein Haushaltsjahr bewilligt.&nbsp;</li><li class=\"unordered-list-item--dash\">Nach Fertigstellung der Maßnahme ist ein Nachweis über die zweckentsprechende Verwendung der Zuweisung vorzulegen.</li></ul>";
                                                                                                                                                                          xyz:erlaeuterungVorzeitigerMassnahmebeginn
                                                                                                                                                                                  "<p>Mit der Baumaßnahme darf erst nach Erteilung eines entsprechenden Bewilligungsbescheids oder nach vorheriger Zustimmung zum vorzeitigen Vorhabenbeginn begonnen werden.</p>";
                                                                                                                                                                          xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "002";
                                                                                                                                                                                                            xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
                                                                                                                                                                                                            xyz:listVersionID  "1"
                                                                                                                                                                                                          ]
                                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:finanzierungsartUndHoehe  "<p>Die Zuweisungen werden als Projektförderung im Wege der Anteilsfinanzierung mit einem bestimmten Prozentsatz an den zuweisungsfähigen Ausgaben gewährt.&nbsp;</p><ul><li class=\"unordered-list-item--dash\">Der Förderrahmen beträgt grundsätzlich 0 bis 80 %.&nbsp;</li><li class=\"unordered-list-item--dash\">Bei der Bemessung der Höhe der Zuweisung werden insbesondere die finanzielle Lage der Kommune unter Berücksichtigung der demografischen Entwicklung, die Bedeutung der Baumaßnahme, ein über das Hoheitsgebiet der Kommune hinausgehendes Einzugsgebiet, das Staatsinteresse und die Höhe der verfügbaren Mittel berücksichtigt.&nbsp;</li><li class=\"unordered-list-item--dash\">Für Kommunen, deren finanzielle Lage dem Landesdurchschnitt vergleichbarer Kommunen entspricht, kann von einem Fördersatz-Orientierungswert von 50 % ausgegangen werden.</li></ul>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "003";
                                                                                                                                                                                                    xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
                                                                                                                                                                                                    xyz:listVersionID  "1";
                                                                                                                                                                                                    xyz:name           ""
                                                                                                                                                                                                  ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:laufzeitFinanzierung      [ xyz:laufzeitFinanzierung  [ xyz:code           "001";
                                                                                                                                                                                                       xyz:listURI        "urn:xoev-de:stmd:codeliste:laufzeit-finanzierung";
                                                                                                                                                                                                       xyz:listVersionID  "1"
                                                                                                                                                                                                     ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Grundlage für die staatliche Förderung sind nicht die Gesamtkosten, sondern die zuweisungsfähigen Ausgaben. Die Ermittlung der zuweisungsfähigen Ausgaben erfolgt nach Maßgabe der Nr. 5.2 der Zuweisungsrichtlinie (FAZR).</p>"
                                                                                                                                         ];
