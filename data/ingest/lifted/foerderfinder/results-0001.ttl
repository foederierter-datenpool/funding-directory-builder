                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>e3ca43eb-d8cd-4787-a73c-5d16b1907c1f</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2026-01-21T16:27:37</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>e3ca43eb-d8cd-4787-a73c-5d16b1907c1f</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>e3ca43eb-d8cd-4787-a73c-5d16b1907c1f</xflb:schluessel>\n         <xflb:versionFLB>1</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-01-21T16:27:37</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>e3ca43eb-d8cd-4787-a73c-5d16b1907c1f</xflb:foerderschluessel>\n                  <xflb:flbVersion>1</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>09999000000005</xflb:leikaSchluessel>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Digitalisierung in Pflegeeinrichtungen</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Um die Digitalisierung in den bayerischen Pflegeeinrichtungen zu beschleunigen und die Einrichtungen finanziell zu entlasten bzw. die Umlage der Kosten auf die Pflegebedürftigen zu reduzieren, stellt der Freistaat Bayern insgesamt 15,0 Mio. Euro für eine Komplementärförderung ergänzend zur Bundesförderung bereit.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern fördert die Anschaffung von digitaler und technischer Ausstattung in Pflegeeinrichtungen.</xflb:teaser>\n                  <xflb:schluesselwoerter>100% WLAN-Strategie, Komplementärförderung, Beschleunigung der Digitalisierung, stationären und ambulanten Einrichtungen</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:alternativeFoerdermoeglichkeiten>\n                  <xflb:alternativeFoerdermoeglichkeit>\n                     <xflb:beschreibung>Gute Pflege; Beantragung einer Förderung</xflb:beschreibung>\n                     <xflb:verweis>\n                        <xflb:bezeichnung>Der Freistaat Bayern gewährt Kommunen Zuwendungen zur Stärkung einer bedarfsgerechten und bedürfnisorientierten auf den sozialen Nahraum ausgerichteten Pflege sowie für die Schaffung, den Ausbau und den Betrieb von Koordinierungsstellen.</xflb:bezeichnung>\n                        <xflb:link>https://www.bayernportal.de/dokumente/leistung/2209445122238?contrast=high</xflb:link>\n                     </xflb:verweis>\n                  </xflb:alternativeFoerdermoeglichkeit>\n               </xflb:alternativeFoerdermoeglichkeiten>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>100% WLAN-Strategie - Komplementärförderung Digitalisierung</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/digitalisierung-in-stationaeren-und-ambulanten-pflegeeinrichtungen/</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Bayerisches Landesamt für Pflege</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>4</xflb:hausnummerPostfach>\n                           <xflb:strasse>Mildred-Scheel-Straße</xflb:strasse>\n                           <xflb:postleitzahl>92224</xflb:postleitzahl>\n                           <xflb:ort>Amberg</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>poststelle@lfp.bayern.de</xflb:email>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Homepage des Landesamts für Pflege</xflb:bezeichnung>\n                           <xflb:link>www.lfp.bayern.de</xflb:link>\n                        </xflb:verweis>\n                        <xflb:telefonnummer>+49 9621 9669-0</xflb:telefonnummer>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>34e2ce13-d4c2-4375-9dfe-8cbe80dfcb5a</xflb:id>\n                     <xflb:bezeichnung>DAWI-De-minimis-Erklärung</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/dokumente/WLan_Pflege/Muster_DAWI-De-minimis-Erklaerung.pdf</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n               <xflb:onlinedienste>\n                  <xflb:onlinedienst>\n                     <xflb:id>4a49b0ce-7933-40cd-8f93-6885d7cdffc6</xflb:id>\n                     <xflb:bezeichnung>Digitalisierung 100% WLAN - Komplementärförderung für Digitalisierung in Pflegeeinrichtungen beantragen</xflb:bezeichnung>\n                     <xflb:link>https://foerderung.bayern.de/landingpage/841c6e1d-4516-456e-9801-df1aaff1d511</xflb:link>\n                     <xflb:beschreibung>Sie können die Förderung der Anschaffung von digitaler oder technischer Ausrüstung, die als Hauptzweck insbesondere die Entlastung der Pflegekräfte, die Verbesserung der pflegerischen Versorgung oder die Förderung einer stärkeren Beteiligung der Pflegebedürftigen verfolgen, digital beantragen.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n               </xflb:onlinedienste>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>002</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>003</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>005</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>008</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Antragsberechtigt sind nach § 71 SGB XI zugelassene ambulante und stationäre Pflegeeinrichtungen.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Gefördert werden bis zu 40% der durch die Pflegeeinrichtung verausgabten Mittel. Pro Pflegeeinrichtung ist höchstens ein einmaliger Zuschuss in Höhe von bis zu 12.000 Euro möglich.&lt;/p&gt;\n&lt;p&gt;Bayerische Pflegeeinrichtungen erhalten mit diesem Förderprogramm, ergänzend zum Abruf der Bundesmittel, weitere 40 % der nachgewiesenen Kosten aus Mitteln des Freistaats Bayern. Damit wird der Eigenanteil von 60 % auf 20 % reduziert sowie eine maximale Förderung in Höhe von 24.000 Euro (statt bisher 12.000 Euro) erreicht. Anträge auf Komplementärförderung können nur für Pflegeeinrichtungen gestellt werden, die in Bayern betrieben werden.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Förderfähig sind Anschaffungen von digitaler oder technischer Ausrüstung sowie damit verbundene Schulungen, die beispielsweise Investitionen in die IT- und Cybersicherheit, das interne Qualitätsmanagement, die Erhebung von Qualitätsindikatoren, verbesserte Arbeitsabläufe und Organisation bei der Pflege und die Zusammenarbeit zwischen Ärzten und stationären Pflegeeinrichtungen unterstützen.&lt;/p&gt;\n&lt;p&gt;Förderfähig sind auch die Aus-, Fort- und Weiterbildungen sowie Schulungen zu digitalen Kompetenzen von Pflegebedürftigen und Pflegekräften in der Langzeitpflege.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Gesundheit, Pflege und Prävention</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>§ 8 Abs. 8 Sozialgesetzbuch (SGB) - Elftes Buch (XI)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-im-internet.de/sgb_11/__8.html</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Merkblatt für das Förderprogramm \"100% WLAN-Strategie - Komplementärförderung zur Beschleunigung der Digitalisierung in stationären und ambulanten Einrichtungen nach § 8 Abs. 8 SGB XI (kurz: 100% WLAN-Strategie - Komplementärförderung)\" des Freistaates Bayern.</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/wp-content/uploads/2025/05/02_Merkblatt-zu-Foerderhinweise.pdf</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat 43</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Digitalisierung in Pflegeeinrichtungen</xflb:programmtitel>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2025-05-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2027-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Die Pflegeversicherung fördert nach § 8 Abs. 8 SGB XI die Anschaffung von digitaler und technischer Ausrüstung. Ergänzend zur Förderung der Pflegeversicherung (§8 Abs. 8 SGB XI) wird im Rahmen der \"100% WLAN-Strategie - Komplementärförderung\" des Freistaates Bayern eine Komplementärförderung in Höhe von weiteren 12.000 Euro und maximal 40% der verausgabten Mittel gewährt.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>006</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Voraussetzung für die Bewilligung der Förderung ist die Vorlage des Zuwendungsbescheides der für den Vollzug des Bundesförderprogramms zuständigen Pflegekasse, der nach dem 01.04.2025 erlassen wurde sowie eine Erklärung zur Einhaltung der sich aus dem Beihilferecht ergebenden Vorgaben.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://foerderung.bayern.de/landingpage/841c6e1d-4516-456e-9801-df1aaff1d511</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Der Antrag muss digital beim Landesamt für Pflege gestellt werden. Bewilligungsbehörde ist das Landesamt für Pflege.&lt;/p&gt;</xflb:bewilligung>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>DAWI-De-minimis-Erklärung (siehe unter \"Formulare\")</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Erforderlich bei der Antragsstellung.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Zuwendungsbescheid der zuständigen Pflegekasse, der nach dem  01.04.2025 ausgestellt wurde</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Erforderlich bei der Antragsstellung.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Vorlage der durch die Pflegekasse geprüften Abrechnung</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Erforderlich bei der Einreichung des Verwendungnachweises.</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Gegen diesen Bescheid kann innerhalb eines Monats nach seiner Bekanntgabe Klage erhoben werden bei dem Bayerischen Verwaltungsgericht Bayreuth.&lt;/p&gt;\n&lt;p&gt;&lt;br&gt;&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_133  [ xyz:attributes  [ xyz:antragsstellung      "https://www.vditz.de/bayfeli";
                                xyz:beschreibung         "Ziel der Förderung ist es, regionale Wasserstoffproduktionskapazitäten zur anteiligen Deckung des mittelfristig steigenden Wasserstoffbedarfs in Bayern aufzubauen. Die bayerische Wasserstoff-Roadmap zeigt für Bayern einen schnell wachsenden Bedarf an vorzugsweise grünem Wasserstoff auf. Der Aufbau heimischer Produktionskapazitäten für grünen Wasserstoff soll dabei vom Ausbau zusätzlicher Erneuerbaren-Energien-Anlagen in Bayern begleitet werden. Gleichzeitig wird mit der Förderung ein Anschub geleistet, um Technologiekompetenz zu demonstrieren, lokale Wertschöpfung zu ermöglichen, die Importabhängigkeit im Bereich grüner Wasserstoff so gering wie möglich zu halten und somit insbesondere Wettbewerbs- und Standortvorteile für die Bayerische Wirtschaft zu generieren, um Bayerns führende Rolle im Wettlauf um die künftige globale Wasserstoffwirtschaft auszubauen.";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Energieeffizienz und Erneuerbare Energien" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1   "Kleine und mittlere Unternehmen";
                                                           rdf:_10  "Kommunen";
                                                           rdf:_11  "Behörden";
                                                           rdf:_12  "Freiberufler";
                                                           rdf:_2   "Einzelunternehmen";
                                                           rdf:_3   "Großunternehmen";
                                                           rdf:_4   "Vereine";
                                                           rdf:_5   "Unternehmen mit ausländischem Mehrheitsbesitz";
                                                           rdf:_6   "Forschungseinrichtungen";
                                                           rdf:_7   "Verbände";
                                                           rdf:_8   "Privatpersonen";
                                                           rdf:_9   "Stiftungen"
                                                         ];
                                xyz:foerderprogramm      "Bayerisches Förderprogramm zum Aufbau einer Elektrolyseur-Infrastruktur in Bayern";
                                xyz:foerderzeitraum.bis  "2026-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2023-07-27T00:00:00.000+00:00";
                                xyz:schluessel           "bc98a853-db5b-4ceb-84ca-992215769623";
                                xyz:teaser               "Förderung von Elektrolyseuren zur Erzeugung von erneuerbarem Wasserstoff";
                                xyz:titel                "Elektrolyseure zur Produktion von erneuerbarem Wasserstoff";
                                xyz:titel.tokens         [ rdf:_1  "Elektrolyseure zur Produktion von erneuerbarem Wasserstoff" ];
                                xyz:voraussetzung        "Das Vorhaben muss im Freistaat Bayern durchgeführt werden. \n\nDie Elektrolyseure müssen eine Mindestleistung von 1 MW haben und zu 100 Prozent mit Strom aus erneuerbaren Energiequellen nach Art. 2 Nr. 109 AGVO betrieben werden. Bei Vorhaben im Bereich des erneuerbaren Wasserstoffs, die einen Elektrolyseur und eine oder mehrere Einheiten zur Erzeugung erneuerbarer Energien nach einem einzigen Netzanschlusspunkt beinhalten, darf nach Art. 41 Abs. 3 Satz 2 AGVO die Kapazität des Elektrolyseurs die Gesamtkapazität der Einheiten zur Erzeugung erneuerbarer Energien nicht überschreiten."
                              ];
              xyz:id          "bc98a853-db5b-4ceb-84ca-992215769623";
              xyz:payload     [ xyz:json  [ xyz:anfrage            [ xyz:anfragenummer  "bc98a853-db5b-4ceb-84ca-992215769623";
