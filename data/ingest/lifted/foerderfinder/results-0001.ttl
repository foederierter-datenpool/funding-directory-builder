                                xyz:foerderprogramm      "Richtlinien für Zuwendungen zu wasserwirtschaftlichen Vorhaben (RZWas 2025)";
                                xyz:foerderzeitraum.bis  "2028-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2024-04-01T00:00:00.000+00:00";
                                xyz:schluessel           "c94f84b7-f39b-4de1-9378-a59fde9f536a";
                                xyz:teaser               "Der Freistaat Bayern unterstützt die bayerischen Städte und Gemeinden bei der\nSanierung von öffentlichen Trinkwasser- und Abwasseranlagen in Härtefällen mit Zuwendungen.";
                                xyz:titel                "Erstmaliger Bau von Verbundleitungen für Wasserversorgungsanlagen und erstmaliger Bau von Verbundkanälen bei Auflassung von Kläranlagen (nach Nr. 2.2.2 der RZWas 2025)";
                                xyz:titel.tokens         [ rdf:_1  "Erstmaliger Bau von Verbundleitungen für Wasserversorgungsanlagen und erstmaliger Bau von Verbundkanälen bei Auflassung von Kläranlagen (nach Nr. 2.2.2 der RZWas 2025)" ];
                                xyz:voraussetzung        "<p>Es werden Verbundleitungen und -kanäle nach Nr. 2.2.2 RZWas 2025, sowie Sanierungs- und Strukturkonzepte nach Nr. 2.2.5 RZWas 2025 unabhängig vom Erreichen einer Härtefallschwelle gefördert. Es können nur Vorhaben gefördert werden, die noch nicht begonnen worden sind. Weitere Details erfahren Sie bei Ihrem örtlich zuständigen Wasserwirtschaftsamt.</p>"
                              ];
