                                xyz:xml   "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           produkt=\"Förderfinder\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produktversion=\"\"\n                                           standard=\"XFLB\"\n                                           test=\"\"\n                                           version=\"2.0.0\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0 xflb.xsd\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>b2cbedf0-086f-41e4-bd24-15c005a2b7be</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2025-07-28T12:09:56</xflb:erstellungszeitpunkt>\n      <xflb:sender>Förderfinder Suche (Bayern)</xflb:sender>\n      <xflb:empfaenger>XFLB-Connect (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>b2cbedf0-086f-41e4-bd24-15c005a2b7be</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>b2cbedf0-086f-41e4-bd24-15c005a2b7be</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Umwelt und Verbraucherschutz</xflb:verantwortlichesMinisterium>\n               <xflb:ablaufdatumRichtlinie>2028-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:verantwortlichesFachreferat>57</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Sonderprogramm \"Kommunale Trinkbrunnen\" nach Nr. 2.4 RZWas 2025</xflb:programmtitel>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.stmuv.bayern.de/themen/wasserwirtschaft/foerderung/kommunale_trinkbrunnen.htm</xflb:link>\n                     <xflb:bezeichnung>RZWas 2025, Nr. 2.4 Sonderprogramm</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2024-04-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2028-12-31</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:verlaengerungsoption>In Aussicht gestellt bei ausreichen Haushaltsmittel</xflb:verlaengerungsoption>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>b2cbedf0-086f-41e4-bd24-15c005a2b7be</xflb:foerderschluessel>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n               </xflb:interneKennung>\n            </xflb:zuordnungen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name>Bayern</name>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Förderung eines Trinkbrunnen im öffentlichen Raum</xflb:titel>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Jeweils regional zuständiges Wasserwirtschaftsamt</xflb:name>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n                  <xflb:verweis>\n                     <xflb:link>https://www.stmuv.bayern.de/themen/wasserwirtschaft/wasserwirtschaft_in_bayern/wasseraemter.htm</xflb:link>\n                     <xflb:bezeichnung>Link zum regional zuständigen Wasserwirtschaftsamt</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:allgemeineFragen>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.stmuv.bayern.de/themen/wasserwirtschaft/foerderung/kommunale_trinkbrunnen.htm</xflb:link>\n                     <xflb:bezeichnung>Link zum Förderprogramm Kommunale Trinkbrunnen</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>Das Berücksichtigen der Verhaltensregeln des allgemeinen Grundwasserschutzes, der Wasserschutzgebiete sowie der Trinkwasserverordnung kann nur erfolgreich sein, wenn deren Notwendigkeit in der Bevölkerung verstanden, akzeptiert und gelebt wird. Trinkbrunnen dienen dem Zweck, das Leitungswasser der öffentlichen Wasserversorgung als Lebensmittel in Wert zu setzen. Es ist Ziel die Einsicht zu vermitteln, dass dieses Trinkwasser den notwendigen Schutz verdient und erfordert, weil es so wertvoll und deshalb schützenswert ist. Das gilt gerade auch dann, wenn der Schutz persönliche Einschränkungen und gegebenenfalls auch Änderungen in den persönlichen Verhaltensweisen mit sich bringt. Öffentliche Trinkbrunnen an gut frequentierten Plätzen oder Wegen bieten die gute Möglichkeit, auf den Wert des Lebensmittels Leitungswasser sowie auf die Notwendigkeit des Trinkwasserschutzes mit geeigneten Medien hinzuweisen. Gerade Personen, die ihren Durst mit frischem Wasser stillen können, haben ein besonders offenes Ohr für diese Botschaft.\n\nTrinkbrunnen dienen der öffentlichen Klimavorsorge. Der Klimawandel führt zu immer länger werdenden Hitzeperioden, was das Leben gerade in den innerstädtischen Bereichen zunehmend belastend macht. Im Sinne der allgemeinen Gesundheitsvorsorge wirkt das Bereitstellen von kühlem, frischem Trinkwasser belebend.\n\nÖffentliche Trinkbrunnen sind ein Beitrag zur Verminderung von klimaschädlichem CO2 durch das Einsparen von Emissionen aus der Getränkelogistik und zur Vermeidung von Plastikabfällen aus (Einweg-)Flaschen für Mineral- oder Tafelwasser. Die Wertschätzung von Leitungswasser als Lebensmittel soll gefördert werden.</xflb:zuwendungszweck>\n                  <xflb:teaser>Wenn Sie für Ihre Bürger einen öffentlich zugänglichen Trinkbrunnen anbieten möchten, können Sie sich den Bau von maximal zwei Trinkbrunnen fördern lassen.</xflb:teaser>\n                  <xflb:schluesselwoerter>Öffentliche Trinkbrunnen, Wasserversorgung, Wasser als Lebensmittel, Trinkwasser</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Ihr regional zuständiges Wasserwirtschaftsamt</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert werden kommunale Trinkbrunnen auf öffentlichen Plätzen. Förderfähig ist der Bau von Trinkbrunnen im öffentlichen Raum. Es werden höchstens zwei Trinkbrunnen pro Gemeinde gefördert. Sollte das Förderprogramm finanziell ausgeschöpft sein, zählt die Reihenfolge (Eingangsdatum) des Antragseingangs.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name>Kommunen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name>Verbände</name>\n               </xflb:foerdernehmende>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Zuwendung beträgt 90 v. H. der zuwendungsfähigen Ausgaben nach Nr. 4 RZWas 2025, maximal 10.000 Euro je Trinkbrunnen-Projekt.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>Neubau eines Trinkbrunnens im öffentlichen Raum</xflb:zuwendungsfaehigeKosten>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:zuwendungsart>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:jahre>1</xflb:jahre>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:jahre>2</xflb:jahre>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>Der Antrag wird beim zuständigen Wasserwirtschaftsamt gestellt. Nach Prüfung erhält der Antragsteller einen Bewilligungsbescheid und kann danach mit dem Bau beginnen.</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristdatum>2028-09-30</xflb:fristdatum>\n                  </xflb:zeitlicheEingrenzung>\n               </xflb:antragsfrist>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Unterlagen nach Nr. 8.2 der RZWas 2025</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Kein Entwurf nach REWas, sondern Angebot für Trinkbrunnen beilegen.\nAntrag mit \"Muster 1a zu Art. 44 BayHO\"\nErläuterung und Lageplan.\nBeschluss des zuständigen Organs des Zuwendungsempfängers (z.B Gemeinderat), das Vorhaben durchführen zu wollen.</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:wochen>2</xflb:wochen>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>3</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n            </xflb:antragsinformationen>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Sie sind nur antragsberechtigt, wenn Sie ein kommunales Wasserversorgungsunternehmen sind. (siehe Nr. 3 RZWas 2025)&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>Doppelförderung mit Trinkbrunnenkampagne des BMUV nicht möglich</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2025-07-28T12:09:56</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>019</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>\n"
                              ]
            ];
  rdf:_136  [ xyz:attributes  [ xyz:antragsstellung      "https://portal.adamas.lfu.bybn.de/app/luna/home";
                                xyz:begriffeImKontext    [ rdf:_1  "Naturschutz";
                                                           rdf:_2  "Landschaftspflege"
                                                         ];
                                xyz:beschreibung         "<p>Maßnahmen nach den Landschaftspflege- und Naturpark-Richtlinien (LNPR) dienen dazu,</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">Natur und Landschaft als Lebensgrundlage, Umwelt und Erholungsbereich des Menschen zu erhalten und zu entwickeln,</li>\n  <li class=\"unordered-list-item--dash\">Lebensräume gefährdeter oder vom Aussterben bedrohter Tier- und Pflanzenarten zu sichern oder wieder zu schaffen,</li>\n  <li class=\"unordered-list-item--dash\">den mit der Inschutznahme von Flächen und Einzelbestandteilen der Natur verfolgten Zweck zu erreichen,</li>\n  <li class=\"unordered-list-item--dash\">der Bevölkerung auf naturverträgliche Weise die heimische Natur und Landschaft zugänglich zu machen und deren ökologischen Wert zu vermitteln,</li>\n  <li class=\"unordered-list-item--dash\">Ziele des Naturschutzes und der Landschaftspflege, die in Plänen nach Art. 4 Bayerisches Naturschutzgesetz (BayNatSchG) enthalten sind, zu verwirklichen,</li>\n  <li class=\"unordered-list-item--dash\">einen landesweiten Biotopverbund zu entwickeln, zu erhalten und zu pflegen,</li>\n  <li class=\"unordered-list-item--dash\">einen Beitrag zur Sicherung und Entwicklung des europäischen ökologischen Netzes Natura 2000 zu leisten.</li>\n</ul>";
                                xyz:finanzierungsform    [ rdf:_1  "Anteilsfinanzierung/Kapitalbeteiligung" ];
                                xyz:foerderbereich       [ rdf:_1  "Umwelt- und Naturschutz" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Vereine";
                                                           rdf:_2  "Kommunen";
                                                           rdf:_3  "Verbände";
                                                           rdf:_4  "Stiftungen";
                                                           rdf:_5  "Privatpersonen"
                                                         ];
                                xyz:foerderprogramm      "Landschaftspflege und Naturpark-Richtlinien (LNPR)";
                                xyz:foerderzeitraum.bis  "2026-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2022-11-01T00:00:00.000+00:00";
                                xyz:schluessel           "3d165a7f-8d3b-43d4-bed7-c0a1f444fdf6";
                                xyz:teaser               "Das Bayerische Staatsministerium für Umwelt und Verbraucherschutz gewährt Zuwendungen für Maßnahmen zur Pflege, Erhaltung und Entwicklung geschützter und schutzwürdiger Flächen und Einzelbestandteile der Natur.";
                                xyz:titel                "Förderung von Maßnahmen des Natur- und Artenschutzes, der Landschaftspflege sowie Naturparks";
                                xyz:titel.tokens         [ rdf:_1  "Förderung von Maßnahmen des Natur- und Artenschutzes";
                                                           rdf:_2  "der Landschaftspflege sowie Naturparks"
                                                         ];
                                xyz:voraussetzung        "<p>Vorhaben auf folgenden Flächen beziehungsweise an folgenden Einzelbestandteilen der Natur:&nbsp;</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">Gebiete des Europäischen ökologischen Netzes Natura 2000 gemäß den Richtlinien 2009 147 EG und 92 43 EWG,&nbsp;</li>\n  <li class=\"unordered-list-item--dash\">Feuchtgebiete von internationaler Bedeutung im Sinn von Art. 2 Nr. 1 des Übereinkommens über Feuchtgebiete, insbesondere als Lebensraum für Wasser- und Watvögel, BGBl II 1976 S. 1265,&nbsp;</li>\n  <li class=\"unordered-list-item--dash\">Flächen, die zum Aufbau des Biotopverbundes BayernNetzNatur beitragen,&nbsp;</li>\n  <li class=\"unordered-list-item--dash\">Naturparke sowie alle anderen Flächen und Einzelbestandteile der Natur, die nach BNatSchG bzw. BayNatSchG geschützt sind oder dies entsprechend gilt,&nbsp;</li>\n  <li class=\"unordered-list-item--dash\">Biosphärenreservate,&nbsp;</li>\n  <li class=\"unordered-list-item--dash\">Flächen und Einzelbestandteile der Natur, die als schutzwürdige Biotope erfasst oder die Lebensräume von Arten der \"Roten Listen\" sind&nbsp;und auch&nbsp;</li>\n  <li class=\"unordered-list-item--dash\">Flächen im Siedlungsraum und kommunale Flächen, die für das Naturerleben von besonderer Bedeutung sind.</li>\n</ul>"
                              ];
