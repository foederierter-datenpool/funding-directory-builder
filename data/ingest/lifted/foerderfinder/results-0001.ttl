                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>7ee47924-b027-4777-8dad-0af91822e20c</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2026-02-09T13:53:18</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>7ee47924-b027-4777-8dad-0af91822e20c</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>7ee47924-b027-4777-8dad-0af91822e20c</xflb:schluessel>\n         <xflb:versionFLB>1</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-02-09T13:53:18</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>7ee47924-b027-4777-8dad-0af91822e20c</xflb:foerderschluessel>\n                  <xflb:flbVersion>1</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Förderung von Festivals und Veranstaltungsreihen im Bereich der klassischen Musik und Jazz</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Zweck der Förderung sind der Erhalt und Ausbau der bayerischen Festivallandschaft mit breiten, profilierten Musikangeboten in allen Regionen Bayerns, um das künstlerische Musikschaffen im professionellen Bereich nachhaltig zu stärken.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Für musikalische Festivals oder Veranstaltungsreihen mit Schwerpunkt im Bereich der klassischen Musik (z.B. Alte Musik, romantische Musik, zeitgenössische Musik etc.) oder Jazz, die in Bayern stattfinden, kann eine staatliche Förderung beantragt werden.</xflb:teaser>\n               </xflb:beschreibung>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerischer Musikrat gemeinnützige Projekt GmbH</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>31</xflb:hausnummerPostfach>\n                     <xflb:strasse>Sandstraße</xflb:strasse>\n                     <xflb:postleitzahl>80335</xflb:postleitzahl>\n                     <xflb:ort>München</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>festivalfoerderung@bayerischer-musikrat.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Bayerischer Musikrat gemeinnützige Projekt GmbH</xflb:bezeichnung>\n                     <xflb:link>https://www.bayerischer-musikrat.de/Foerderung/Festivalf%C3%B6rderung/Kontakt</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>089/52 04 64 - 25</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>https://www.bayerischer-musikrat.de/Foerderung/Festivalf%C3%B6rderung/Aktuelles</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>1b15a957-d6a4-4e7e-a5a3-85986d4f97c7</xflb:id>\n                     <xflb:bezeichnung>Link zum Antrag und weiteren Informationen.</xflb:bezeichnung>\n                     <xflb:link>https://www.bayerischer-musikrat.de/festivalfoerderung/antrag</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Antragsberechtigt sind natürliche Personen sowie juristische Personen des Privatrechts, Gesellschaften bürgerlichen Rechts, Körperschaften des öffentlichen Rechts und kommunale Gebietskörperschaften, die als Festival- oder Konzertveranstalter ohne Gewinnerzielungsabsicht tätig sind.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Zuwendung wird als Projektförderung im Wege der Festbetragsfinanzierung gewährt.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Im Rahmen der zur Verfügung stehenden Mittel kann eine Förderung maximal bis zu 50&amp;nbsp;% der zuwendungsfähigen Gesamtausgaben betragen.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bei der Bemessung der Höhe der Zuwendung wird je nach Leistungsfähigkeit ein angemessener Eigenanteil der Antragstellerin oder des Antragstellers an den zuwendungsfähigen Ausgaben grundsätzlich in Form von Eigenmitteln gefordert; der Eigenmittelanteil soll 10&amp;nbsp;% der zuwendungsfähigen Ausgaben nicht unterschreiten.&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Zuwendungsfähig sind Sach- und Personalausgaben, die in unmittelbarem Zusammenhang &amp;nbsp;mit der Durchführung des Festivals oder der Veranstaltungsreihe anfallen, einschließlich der auf das Projekt entfallenden anteiligen sächlichen Verwaltungsausgaben (z. B. für Telefon, Kopien, Büromaterial) &amp;nbsp;in Höhe von bis zu 10 v. H. der übrigen zuwendungsfähigen Ausgaben.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Wissenschaft und Kunst</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 44 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO-44</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 23 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO-23</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 44a Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO-44a</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:programmtitel>Förderung von Festivals und Veranstaltungsreihen im Bereich der klassischen Musik und Jazz</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2028-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2023-07-10</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2028-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n               <xflb:kummulierbareFoerderungen>\n                  <xflb:beschreibungAusschluss>Das Projekt darf aber nicht aus einem weiteren bayerischen Landesprogramm gefördert werden.</xflb:beschreibungAusschluss>\n                  <xflb:voraussetzungen>&lt;p&gt;Die Kombination mit einer Bundesförderung oder kommunalen Förderungen ist möglich.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;</xflb:voraussetzungen>\n               </xflb:kummulierbareFoerderungen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Eine Förderung zur Durchführung von im Freistaat Bayern stattfindenden musikalischer Festivals und Veranstaltungsreihen mit Schwerpunkt im Bereich der klassischen Musik (z. B. Alte Musik, romantische Musik, zeitgenössische Musik etc.) und Jazz.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>013</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Die Förderung setzt voraus, dass&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;mit dem Festival oder der Veranstaltungsreihe noch nicht begonnen worden ist,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;unter Berücksichtigung der möglichen staatlichen Förderung die Gesamtfinanzierung des Festivals oder der Veranstaltungsreihe hinreichend gesichert ist,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;das Festival oder die Veranstaltungsreihe nicht allein mit eigenen Einnahmen (z. B. Beiträge, Spenden, Konzerteinnahmen) und unter Ausschöpfung aller weiteren Finanzierungsmöglichkeiten (z. B. Zuwendungen des Bundes und der Kommunen, Sponsoren- und Stiftungsgelder) durchgeführt werden kann,&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;mit dem Festival oder der Veranstaltungsreihe keine Gewinnerzielungsabsicht verfolgt wird,&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;das Festival oder die Veranstaltungsreihe an Veranstaltungsorten in Bayern stattfindet,&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;das Festival oder die Veranstaltungsreihe mindestens bereits zwei Mal erfolgreich durchgeführt worden ist,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;das Festival durch die Mitwirkung professioneller Künstlerinnen und Künstler geprägt wird&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;und&amp;nbsp;das Festival oder die Veranstaltungsreihe eine überregionale Reichweite entfaltet.&lt;/li&gt;&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:rechtlicheBeschreibung>&lt;p&gt;Es handelt sich um eine frewillige Leistung ohne Rechtsanspruch.&lt;/p&gt;</xflb:rechtlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.bayerischer-musikrat.de/festivalfoerderung/antrag</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Nach dem Eingang des Antrags werden die eingereichten Unterlagen auf Vollständigkeit geprüft. Nach Ablauf der Antragsfrist werden alle Anträge abschließend geprüft und die Bewilligungsbescheide erstellt.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>003</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>&lt;p&gt;Die Zustimmung zum vorzeitigen Vorhabenbeginn kann mit Einreichung des Förderantrags beantragt werden.&lt;/p&gt;&lt;p&gt;Die Zustimmung kann nur erteilt werden, wenn dies aus sachlichen oder wirtschaftlichen Gründen geboten ist.&lt;/p&gt;&lt;p&gt;Die Zustimmung zum vorzeitigen Vorhabenbeginn stellt keine endgültige Förderentscheidung dar und begründet auch keinen Anspruch auf eine tatsächliche Förderung.&amp;nbsp;Die Antragstellerin oder der Antragsteller trägt das volle Finanzierungsrisiko.&lt;/p&gt;</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristJaehrlich>15.03.</xflb:fristJaehrlich>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Anträge sind jeweils bis zum 15. März des Bewilligungsjahres an die Bayerischer Musikrat gemeinnützige Projekt GmbH zu richten (Ausschlussfrist).</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Aussagekräftige Projektbeschreibung</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Ausgaben- und Finanzierungsplan</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Programmplanung</xflb:bezeichnung>\n                     <xflb:erlaeuterung>aus der sich die geplanten Konzertdaten, die auftretenden\nKünstlerinnen und Künstler sowie die aufzuführenden musikalischen Werke ergeben</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>eine Erklärung, dass mit dem Vorhaben noch nicht begonnen worden ist</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>eine Erklärung darüber, ob der Zuwendungsempfänger allgemein oder für das betreffende Vorhaben zum Vorsteuerabzug nach § 15 UStG berechtigt ist</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>bei Erstanträgen für dieses Förderprogramm zusätzlich die Abrechnung des Vorjahres</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Gegen den Bewilligungs- oder Ablehnungsbescheid kann bei dem zuständigen Verwaltungsgericht &lt;strong&gt;innerhalb eines Monats nach seiner Bekanntgabe Klage&lt;/strong&gt; erhoben werden.&amp;nbsp;Die Einlegung des Rechtsbehelfs ist schriftlich, zur Niederschrift oder elektronisch in einer für den Schriftformersatz zugelassenen Form möglich. Die Erhebung einer Klage per einfacher E-Mail ist nicht zugelassen und entfaltet &lt;u&gt;keine&lt;/u&gt; rechtlichen Wirkungen.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_17   [ xyz:attributes  [ xyz:antragsstellung      "https://www.zbfs.bayern.de/imperia/md/content/blvf/esf/landesmittel/forderantrag_wbi_u_wbi-k.pdf";
                                xyz:begriffeImKontext    [ rdf:_1  "Berufliche Weiterbildung";
                                                           rdf:_2  "Weiterbildung";
                                                           rdf:_3  "Fortbildung";
                                                           rdf:_4  "Qualifizierung";
                                                           rdf:_5  "Beratung";
                                                           rdf:_6  "Weiterbildungsinitiatoren"
                                                         ];
                                xyz:beschreibung         "<p>Die Weiterbildungsinitiatorinnen und -initiatoren (WBI) bieten allen Beschäftigten und Unternehmen in ganz Bayern eine kostenfreie Beratung zum Thema berufliche Weiterbildung an. Dabei zeigen sie passgenaue Weiterbildungsangebote und Fördermöglichkeiten auf und unterstützen bei der Auswahl dieser. Die WBI erstellen auch individuelle Weiterbildungskonzepte und begleiten auf Wunsch auch die Umsetzung der Maßnahme. Die WBI werden von einer zentralen Koordinationsstelle (WBI-K) gesteuert. Das Ziel der Förderung ist eine Erhöhung der Weiterbildungsbereitschaft in Bayern, die aufgrund der sich wandelnden Arbeitswelt, des demografischen Wandels und des Fachkräftebedarfs notwendig ist. Darüber hinaus erhalten und erhöhen berufliche Weiterbildungen die Beschäftigungsfähigkeit der Beschäftigten und die Wettbewerbsfähigkeit der Wirtschaft.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Anteilsfinanzierung/Kapitalbeteiligung" ];
                                xyz:foerderbereich       [ rdf:_1  "Arbeit";
                                                           rdf:_2  "Aus und Weiterbildung";
                                                           rdf:_3  "Beratung"
                                                         ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Kleine und mittlere Unternehmen";
                                                           rdf:_2  "Einzelunternehmen";
                                                           rdf:_3  "Großunternehmen";
                                                           rdf:_4  "Forschungseinrichtungen";
                                                           rdf:_5  "Kommunen";
                                                           rdf:_6  "Vereine";
                                                           rdf:_7  "Verbände";
                                                           rdf:_8  "Stiftungen"
                                                         ];
                                xyz:foerderprogramm      "Richtlinie zur Förderung von Weiterbildungsinitiatorinnen und -initiatoren zur Qualifizierungsberatung und einer Koordinationsstelle für den Förderzeitraum von 2025 bis 2027 (WBI-Förderrichtlinie)";
                                xyz:foerderzeitraum.bis  "2027-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2025-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "0303340e-ac22-4050-8a7f-d15c448443a3";
                                xyz:teaser               "Die Förderung unterstützt Beratungsleistungen für Beschäftigte und Unternehmen, um die Weiterqualifizierung zu fördern und damit den Arbeitsmarkt zu stärken.";
                                xyz:titel                "Förderung von Weiterbildungsinitiatorinnen und -initiatoren sowie einer Koordinationsstelle";
                                xyz:titel.tokens         [ rdf:_1  "Förderung von Weiterbildungsinitiatorinnen und -initiatoren sowie einer Koordinationsstelle" ];
                                xyz:voraussetzung        "<p>Für die Tätigkeit der WBI bzw. der oder des WBI-K sind folgende Qualifikationen und Fähigkeiten erforderlich:</p><ul><li class=\"unordered-list-item--dash\">(Fach-)Hochschulabschluss oder gleichwertige berufliche Qualifikation mit mehrjähriger Berufserfahrung (WBI) beziehungsweise abgeschlossene wissenschaftliche Hochschulbildung (WBI-K) und nachgewiesene Kenntnisse im Bereich der beruflichen Fort- und Weiterbildung,&nbsp;</li><li class=\"unordered-list-item--dash\">Erfahrungen und Kenntnisse in der Weiterbildungsberatung, dem Arbeitsrecht, dem Arbeitsförderungsrecht, dem Förderwesen, sowie Kenntnisse der Verwaltungsstrukturen oder die Bereitschaft, sich in diese Themen zügig und intensiv einzuarbeiten,</li><li class=\"unordered-list-item--dash\">Kenntnisse über die Zusammenarbeit der regionalen Arbeitsmarktakteure (Sozialpartnerschaft) und</li><li class=\"unordered-list-item--dash\">hohe Organisationsfähigkeit und Flexibilität, Weiterbildungsbereitschaft, hohe Motivation (insbesondere auch zur Netzwerkarbeit), Teamfähigkeit und Engagement.</li></ul>"
                              ];
