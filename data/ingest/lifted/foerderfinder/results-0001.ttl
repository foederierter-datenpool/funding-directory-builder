                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>54892668-d84e-40b6-8f55-a4c44976db3f</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2025-07-31T13:00:31</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>54892668-d84e-40b6-8f55-a4c44976db3f</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>54892668-d84e-40b6-8f55-a4c44976db3f</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2025-07-31T13:00:31</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>54892668-d84e-40b6-8f55-a4c44976db3f</xflb:foerderschluessel>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99148179017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Unterstützung, Stärkung und Sicherung der geburtshilflichen Hebammenversorgung</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>Krankenhäuser haben zunehmend Probleme, Hebammen und Entbindungspfleger für\ndie geburtshilfliche Tätigkeit im Kreißsaal zu gewinnen und dort zu halten.\nDies gilt auch in der Wochenbettbetreuung. Zweck der Zuweisung ist die\nUnterstützung, Stärkung und Sicherung der Hebammenversorgung in der\nGeburtshilfe und in der Wochenbettbetreuung.</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern unterstützt die Kommunen bei der Sicherstellung der Hebammenversorgung in der Geburtshilfe und in der Wochenbettbetreuung.</xflb:teaser>\n                  <xflb:schluesselwoerter>Hebammen, Geburtshilfe</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Regierung von Oberfranken</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>20</xflb:hausnummerPostfach>\n                     <xflb:strasse>Ludwigstraße</xflb:strasse>\n                     <xflb:postleitzahl>95444</xflb:postleitzahl>\n                     <xflb:ort>Bayreuth</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>geburtshilfe@reg-ofr.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderung Geburtshilfe</xflb:bezeichnung>\n                     <xflb:link>https://www.regierung.oberfranken.bayern.de/aufgaben/192188/192196/leistung/leistung_64186/index.html</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>0921604-0</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Regierung von Oberfranken - Sachgebiet 55.2</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>b1ee9c53-3caa-4dd1-b967-1ab7ab068b91</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Gewährung einer Zuwendung</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>6d397740-7d0c-4411-a1a1-15f046ac6ae1</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Bewilligung weiterer Zuwendungsraten (Muster 1b zu Art. 44 BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-024/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>e23de20a-dea2-437d-a23d-6c290a176c83</xflb:id>\n                     <xflb:bezeichnung>Auszahlungsantrag (Muster 3 zu Art. 44 BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-006/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>ea2dd630-d45e-459b-aebb-bbd7375165c4</xflb:id>\n                     <xflb:bezeichnung>Verwendungsnachweis (Muster 4 zu Art. 44 BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-019/index</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Zuweisungsempfänger sind die für die stationäre Versorgung und die Hebammenhilfe sicherstellungsverpflichteten Landkreise und kreisfreien Städte im Freistaat Bayern</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>Die maximale Höhe der Zuweisung bemisst sich nach der Anzahl der Geburten in\nKrankenhäusern im Gebiet des Landkreises bzw. der kreisfreien Stadt im Jahr\nvor dem Bewilligungszeitraum multipliziert mit dem Faktor 40.</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>Zuwendungsfähig sind Personal- und Sachausgaben, die im Zusammenhang mit dem\njeweils geförderten Projekt anfallen.</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerFest>\n                        <xflb:jahre>1</xflb:jahre>\n                     </xflb:dauerFest>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n               <xflb:euBeihilferelevanz>Die Sicherung der Geburtshilfe und der Wochenbettbetreuung stellt eine Dienstleistung von allgemeinem wirtschaftlichen Interesse dar.  Gemäß DAWI-Freistellungsbeschluss gelten Beihilfen, die für solche Dienstleistungen an Krankenhäuser und Unternehmen gewährt werden, als mit dem Binnenmarkt vereinbar.</xflb:euBeihilferelevanz>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Gesundheit, Pflege und Prävention</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinie zur Förderung der Geburtshilfe in Bayern (GebHilfR)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2126_0_G_13305</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat 24</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Förderprogramm Geburtshilfe (GebHilfR) Säule 1</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2027-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2018-11-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2027-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>Gefördert werden Maßnahmen und Projekte, die die geburtshilfliche\nHebammenversorgung sowie die Wochenbettbetreuung durch Hebammen und\nEntbindungspfleger stärken und sichern.</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>Die Zuwendung wird unter der Voraussetzung gewährt, dass der Förderzweck\neingehalten wird und die europäischen Beihilfevorschriften mit seinen De-\nminimis-Verordnungen eingehalten werden.\n\nMit der Fördermaßnahme darf erst begonnen werden, wenn der vollständige\nEingang der Antragsunterlagen von der Regierung von Oberfranken bestätigt\nworden ist.\n\nDie Regierung von Oberfranken kann im Bewilligungsbescheid die Weiterleitung\nder Fördermittel an Dritte zulassen.</xflb:buergerfreundlicheBeschreibung>\n               <xflb:rechtlicheBeschreibung>&lt;p&gt;Die Zuweisung wird unter der Voraussetzung gewährt, dass der Förderzweck eingehalten wird und die Weitergabe staatlicher Mittel mit dem EU-Beihilferecht vereinbar ist. Bei der Weitergabe staatlicher Mittel an Unternehmen im Sinne von Art. 107 Abs. 1 des Vertrags über die Arbeitsweise der Europäischen Union (AEUV) ist von den Kommunen das EU-Beihilferecht mit seinen De-minimis-Verordnungen in der jeweils geltenden Fassung zu beachten oder eine marktkonforme Gegenleistung nach den geltenden rechtlichen Vorgaben festzustellen.&lt;/p&gt;</xflb:rechtlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Es gibt in dem Landkreis oder der kreisfreien Stadt kein Krankenhaus mit einer Geburtshilfeeinrichtung.&amp;nbsp;&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>Der Antrag ist bei der Regierung von Oberfranken schriftlich oder per E-Mail\neinzureichen.\n\nDie Regierung von Oberfranken entscheidet über den Antrag und erteilt einen\nvorläufigen Zuwendungsbescheid.\n\nNach Ablauf des im Bescheid angegebenen Bewilligungszeitraums ist vom\nAntragsteller innerhalb eines halben Jahres ein Verwendungsnachweis\nvorzulegen.\n\nDer Verwendungsnachweis wird von der Regierung von Oberfranken geprüft. Danach\nwird ein Schlussbescheid mit der endgültigen Zuschussumme erlassen.\n\nNachdem der Bescheid Rechtskraft erlangt hat, wird der Zuschussbetrag\nausbezahlt.</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>Die Genehmigung des vorzeitigen Maßnahmenbeginns kann bereits nach Antragseingang erteilt werden. Danach dürfen bis zum Beginn des Förderjahres nur Angebote eingeholt und Verträge ab Beginn des Förderjahres geschlossen werden.</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:monate>3</xflb:monate>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>9</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristdatum>2026-11-15</xflb:fristdatum>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Der Antrag muss zum 15.11. für das darauf folgende Jahr gestellt werden</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Geburtenzahlen des Vorjahres</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Beschreibung der Maßnahmen</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Kosten- und Finanzierungsplan</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>verwaltungsgerichtliche Klage</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_27   [ xyz:attributes  [ xyz:antragsstellung      "https://foerderung.bayern.de/landingpage/8e02e146-567a-4e97-8610-bc9e8b5aacbe";
                                xyz:begriffeImKontext    [ rdf:_1  "Alphabetisierungskurs";
                                                           rdf:_2  "Lehrgänge";
                                                           rdf:_3  "Sprachen";
                                                           rdf:_4  "Sprachkurs"
                                                         ];
                                xyz:beschreibung         "<p>Zweck der Förderung von Alphabetisierungskursen ist primär die Verbesserung der schriftsprachlichen Kompetenzen gering literalisierter Menschen. Das Förderprogramm \"ALPHA+ besser lesen und schreiben\" verfolgt das Ziel, möglichst flächendeckend in Bayern geeigneten Trägern einen finanziellen Anreiz für die Durchführung von Kursen zur Alphabetisierung von erwachsenen Personen anzubieten, die aufgrund ihrer begrenzten schriftsprachlichen Kompetenzen nicht in der Lage sind, in angemessener Form am beruflichen und gesellschaftlichen Leben teilzuhaben.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Anteilsfinanzierung/Kapitalbeteiligung" ];
                                xyz:foerderbereich       [ rdf:_1  "Arbeit";
                                                           rdf:_2  "Aus und Weiterbildung";
                                                           rdf:_3  "Integration"
                                                         ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Vereine";
                                                           rdf:_2  "Verbände";
                                                           rdf:_3  "Stiftungen"
                                                         ];
                                xyz:foerderprogramm      "Alphabetisierungskurse";
                                xyz:foerderzeitraum.bis  "2026-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2024-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "cb8c87b5-cf32-4478-b202-15afb07fdbfa";
                                xyz:teaser               "Mit der Förderung \"ALPHA+ besser lesen und schreiben\" soll flächendeckend in Bayern geeigneten Trägern ein finanzieller Anreiz für die Durchführung von Kursen zur Alphabetisierung von erwachsenen Personen geboten werden.";
                                xyz:titel                "ALPHA+ besser lesen und schreiben";
                                xyz:titel.tokens         [ rdf:_1  "ALPHA+ besser lesen und schreiben" ];
                                xyz:voraussetzung        "<p>Die Zuwendungsempfänger müssen anhand eines Musterformulars ein Kurskonzept vorlegen, das mindestens nachfolgende Punkte berücksichtigt:</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">konkrete Ausgangslage vor Ort und Notwendigkeit des Projektes,</li>\n  <li class=\"unordered-list-item--dash\">Beschreibung des Kursinhalts,</li>\n  <li class=\"unordered-list-item--dash\">Darstellung der Ermittlung des Lern- bzw. Leistungsstands der Kursteilnehmer</li>\n  <li class=\"unordered-list-item--dash\">zeitgerechte Umsetzung der Maßnahme,</li>\n  <li class=\"unordered-list-item--dash\">Einsatz von qualifiziertem Personal, das folgende Voraussetzungen erfüllen muss:\n    <ul>\n      <li class=\"unordered-list-item--dash\">pädagogisches Studium (z. B. Lehramt, Erziehungswissenschaften, Sozialpädagogik, Sonder- oder Heilpädagogik)</li>\n      <li class=\"unordered-list-item--dash\">oder abgeschlossenes Studium \"Deutsch als Zweitsprache oder Deutsch als Fremdsprache\" oder Sprachwissenschaften</li>\n      <li class=\"unordered-list-item--dash\">oder mindestens vier Fachsemester in einem der oben genannten Studiengänge absolviert haben</li>\n      <li class=\"unordered-list-item--dash\">oder mehrjährige Berufserfahrung im Grundbildungs- und sprachlichen Bereich oder in der Erwachsenenbildung.</li>\n    </ul>\n  </li>\n  <li class=\"unordered-list-item--dash\">Darüber hinaus benötigen die Lehrkräfte\n    <ul>\n      <li class=\"unordered-list-item--dash\">eine erfolgreiche Basisqualifizierung Alphabetisierung/Grundbildung (ProGrundbildung)</li>\n      <li class=\"unordered-list-item--dash\">oder eine Zulassung des Bundesamtes für Migration und Flüchtlinge für Alphabetisierungskurse</li>\n      <li class=\"unordered-list-item--dash\">oder eine anderweitige Qualifikation für Alphabetisierungskurse.</li>\n    </ul>\n  </li>\n  <li class=\"unordered-list-item--dash\">Ein Kurs ist förderfähig, wenn durchgängig während der gesamten Projektlaufzeit mindestens drei Teilnehmende anwesend sind.</li>\n  <li class=\"unordered-list-item--dash\">Ein Kurs muss mindestens 60 und darf höchstens 200 Unterrichtseinheiten zu jeweils 45 Minuten umfassen.</li>\n  <li class=\"unordered-list-item--dash\">Für die sozialpädagogische Betreuung oder allgemeine Hilfestellung in allen Lebenslagen können folgende zusätzliche Unterrichtseinheiten (UE) geltend gemacht werden:\n    <ul>\n      <li class=\"unordered-list-item--dash\">für Lehrgänge bis zu 100 UE Unterricht zusätzlich bis zu 30 UE,</li>\n      <li class=\"unordered-list-item--dash\">für Lehrgänge bis zu 150 UE Unterricht zusätzlich bis zu 35 UE,</li>\n      <li class=\"unordered-list-item--dash\">für Lehrgänge bis zu 200 UE Unterricht zusätzlich bis zu 40 UE.</li>\n    </ul>\n  </li>\n  <li class=\"unordered-list-item--dash\">Bis zu 30 v. H. der Unterrichtseinheiten können mit alternativen Lernmethoden (z. B. im online-Format) abgehalten werden. Soweit der Kurs Unterrichtseinheiten zum Ausgleich von Grundbildungsdefiziten im mathematischen und wirtschaftlichen Bereich (z. B. Umgang mit Geld) umfasst, haben diese im Rahmen des regulären Unterrichts zu erfolgen.</li>\n</ul>\n<p>Der Zuwendungsempfänger muss Klassenbuch und Teilnehmerliste führen.</p>"
                              ];
              xyz:id          "cb8c87b5-cf32-4478-b202-15afb07fdbfa";
              xyz:payload     [ xyz:json  [ xyz:anfrage            [ xyz:anfragenummer  "cb8c87b5-cf32-4478-b202-15afb07fdbfa";
                                                                     xyz:flb            [ xyz:konkreteFLB  [ xyz:allgemeineAngaben       [ xyz:alternativeFoerdermoeglichkeiten
                                                                                                                                                   [ xyz:alternativeFoerdermoeglichkeit
                                                                                                                                                             [ xyz:beschreibung  "Der Freistaat Bayern fördert Kurse zur Alphabetisierung für Asylsuchende im Rahmen eines Förderprogramms \"Kurse zur Alphabetisierung für Asylsuchende - Alpha Asyl\"";
                                                                                                                                                               xyz:verweis       [ xyz:bezeichnung  "Alphabetisierungskurse für Asylsuchende; Beantragung einer Förderung";
                                                                                                                                                                                   xyz:link         "https://www.bayernportal.de/dokumente/leistung/472075023778"
                                                                                                                                                                                 ]
                                                                                                                                                             ]
                                                                                                                                                   ];
                                                                                                                                           xyz:beschreibung       [ xyz:schluesselwoerter  "Alphabetisierungskurs, Lehrgänge, Sprachen, Sprachkurs";
                                                                                                                                                                    xyz:teaser             "Mit der Förderung \"ALPHA+ besser lesen und schreiben\" soll flächendeckend in Bayern geeigneten Trägern ein finanzieller Anreiz für die Durchführung von Kursen zur Alphabetisierung von erwachsenen Personen geboten werden.";
                                                                                                                                                                    xyz:zuwendungszweck    "<p>Zweck der Förderung von Alphabetisierungskursen ist primär die Verbesserung der schriftsprachlichen Kompetenzen gering literalisierter Menschen. Das Förderprogramm \"ALPHA+ besser lesen und schreiben\" verfolgt das Ziel, möglichst flächendeckend in Bayern geeigneten Trägern einen finanziellen Anreiz für die Durchführung von Kursen zur Alphabetisierung von erwachsenen Personen anzubieten, die aufgrund ihrer begrenzten schriftsprachlichen Kompetenzen nicht in der Lage sind, in angemessener Form am beruflichen und gesellschaftlichen Leben teilzuhaben.</p>"
                                                                                                                                                                  ];
