                                                                                                                                                                    xyz:verweis               [ xyz:bezeichnung  "Kulturfonds Bayern, Bereich Kunst";
                                                                                                                                                                                                xyz:link         "https://www.stmwk.bayern.de/kunst-und-kultur/foerderung/kulturfonds-bayern.html"
                                                                                                                                                                                              ]
