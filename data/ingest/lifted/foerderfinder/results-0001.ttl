                                                                                                             xyz:foerdergegenstand       [ xyz:beschreibung
                                                                                                                               "<h4>Entwicklungskonzept \"Klimaneutrale Kommune\"</h4><p>- Erstellung eines Konzepts zum Erreichen der Klimaneutralität<br>- Begleitmaßnahmen (z. B. Info-Aktionen)<br>- Folgeantrag auf Umsetzungsvorhaben, das mindestens 50 % CO2 einspart</p><p>Förderhöhe: <strong>bis zu 50 %</strong><br>maximal insgesamt: <strong>200.000 €</strong></p><h4><br></h4><h4>Kommunen unter 2.000 Einwohnern bzw. interkommunale Zusammenschlüsse unter 5.000 Einwohnern erhalten <strong>10 Prozentpunkte, finanzschwache Kommunen bekommen 20 Prozentpunkte mehr.</strong><br>(Achtung: Eine Kombination beider Aufschläge ist nicht möglich.)</h4><p>Hinweis: Bei einer zusätzlichen Förderung durch den Bund kann der Prozentsatz noch angepasst werden.</p>" ];
                                                                                                             xyz:foerdernehmende         [ xyz:beschreibung     "Gefördert werden bayerische Städte und Gemeinden, Landkreise und Bezirke, deren Zweckverbände und andere Zusammenschlüsse sowie kommunale Unternehmen.";
                                                                                                                                           xyz:foerdernehmende  [ xyz:code           "009";
                                                                                                                                                                  xyz:listURI        "urn:xoev-de:stmd:codeliste:foerdernehmende";
                                                                                                                                                                  xyz:listVersionID  "1";
                                                                                                                                                                  xyz:name           ""
                                                                                                                                                                ]
                                                                                                                                         ];
                                                                                                             xyz:foerderrichtlinieUndFoerderprogramm
                                                                                                                     [ xyz:ablaufdatumRichtlinie      "2029-12-31";
