                                                                                                                       xyz:programmtitel             "Impulsprogramm Volksmusik";
                                                                                                                       xyz:verantwortlichesFachreferat
                                                                                                                               "54 Heimatpflege";
                                                                                                                       xyz:verantwortlichesMinisterium
                                                                                                                               "Staatsministerium der Finanzen und für Heimat"
                                                                                                                     ];
                                                                                                             xyz:foerdervoraussetzungen  [ xyz:ausschlusskriterien  "<p>Eine Förderung ist nicht möglich für&nbsp;</p><ul><li class=\"unordered-list-item--dash\">bestehende Gruppen im Bereich Volksmusik,</li><li class=\"unordered-list-item--dash\">Institutionen, die bei Inkrafttreten dieser Richtlinie bereits derartige Aktivitäten im Bereich Volksmusik durchführen oder in den letzten drei Jahren vor Inkrafttreten dieser Richtlinie durchgeführt haben sowie</li><li class=\"unordered-list-item--dash\">reinen Instrumentalunterricht außerhalb des Ensemblespiels.</li></ul>";
                                                                                                                                           xyz:buergerfreundlicheBeschreibung
                                                                                                                                                   "<p>Eine Förderung kommt nur in Betracht, wenn</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">die zuwendungsfähigen Ausgaben für das Vorhaben abzüglich des erforderlichen Eigenanteils der Höhe der Zuwendung entsprechen oder diese übersteigen,</li>\n  <li class=\"unordered-list-item--dash\">der Antragsteller oder die Antragstellerin in der Lage ist, seine oder ihre finanzielle Leistungsfähigkeit zur Erbringung des Eigenanteils nachzuweisen,</li>\n  <li class=\"unordered-list-item--dash\">mit dem Vorhaben keine kommerziellen Interessen verfolgt werden,</li>\n  <li class=\"unordered-list-item--dash\">wenn es sich für die Institution um eine neuartige Aktivität handelt. Die Kurse müssen in den Institutionen vor Ort oder in anderen, hierfür den Institutionen zu Verfügung gestellten Räumlichkeiten abgehalten werden und</li>\n  <li class=\"unordered-list-item--dash\">wenn die Kurse von externen Referenten geleitet werden, die vor Stellung des Förderantrags im Referentenpool (<a href=\"https://www.heimat-bayern.de/volksmusik/referentenpool/\">https://www.heimat-bayern.de/volksmusik/referentenpool/</a>) eingetragen sind.</li>\n</ul>\n<p><br></p>"
                                                                                                                                         ];
