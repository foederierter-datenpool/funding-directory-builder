                                                         ];
                                xyz:beschreibung         "<p>Die Zuwendung dient der Förderung von Maßnahmen zur Bewahrung, Vermittlung und Weiterentwicklung des Kulturguts der deutschen Heimatvertriebenen, Aussiedler und Spätaussiedler sowie zur Stärkung ihrer kulturellen Identität und Teilhabe. Ziel ist es, das Kulturerbe der Vertreibungsgebiete zu erhalten, in das kulturelle Leben in Bayern einzubinden und generationenübergreifend zugänglich zu machen.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Kultur, Medien und Sport" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Privatpersonen";
                                                           rdf:_2  "Vereine";
                                                           rdf:_3  "Verbände";
                                                           rdf:_4  "Stiftungen";
                                                           rdf:_5  "Kommunen";
                                                           rdf:_6  "Forschungseinrichtungen"
                                                         ];
                                xyz:foerderprogramm      "Kulturförderung nach § 96 Bundesvertrieben- und Flüchtlingsgesetz";
                                xyz:foerderzeitraum.bis  "9999-01-01T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2007-08-10T00:00:00.000+00:00";
                                xyz:schluessel           "bc6651d6-6bec-468d-ac7f-dc7e08692c63";
                                xyz:teaser               "Der Freistaat Bayern fördert kulturelle Projekte zur Pflege, Vermittlung und Weiterentwicklung des Kulturerbes deutscher Heimatvertriebener und Spätaussiedler, die infolge des Zweiten Weltkriegs ihre Heimat verlassen mussten.";
                                xyz:titel                "Kulturförderung für Vertriebene und Flüchtlinge nach dem Zweiten Weltkrieg";
                                xyz:titel.tokens         [ rdf:_1  "Kulturförderung für Vertriebene und Flüchtlinge nach dem Zweiten Weltkrieg" ];
                                xyz:voraussetzung        "<ul><li class=\"unordered-list-item--dash\">Sie müssen Ihren Wohnsitz oder Sitz in Bayern oder in den ehemaligen Siedungsgebieten in Ost- / Südosteuropa haben.<a href=\"http://haben.er\"></a>Der Ort der Maßnahme kann im In- und Ausland liegen.&nbsp;</li><li class=\"unordered-list-item--dash\">Sie müssen 10% der Gesamtkosten des Projektes als Eigenmittel aufbringen.</li><li class=\"unordered-list-item--dash\">&nbsp;Sie müssen einen ordnungsgemäßen Ablauf des Projektes und Nachweis der Verwendung der Zuwendung leisten können</li></ul>"
                              ];
