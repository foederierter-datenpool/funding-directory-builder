                                                                                                             xyz:foerdergegenstand       [ xyz:beschreibung
                                                                                                                               "<p>Gefördert werden&nbsp;</p><ol><li class=\"ordered-list-item--numbered\">das Schaffen von Mietwohnraum durch Neubau, Änderung oder Erweiterung von Gebäuden, einschließlich solcher, die bisher nicht zu Wohnzwecken genutzt wurden,&nbsp;</li><li class=\"ordered-list-item--numbered\">die Modernisierung bestehenden Mietwohnraums,&nbsp;</li><li class=\"ordered-list-item--numbered\">der Erwerb von leerstehenden Gebäuden zur Durchführung von Maßnahmen nach den Nrn. 2.1 und 2.2 oder der Ersterwerb von Wohngebäuden sowie&nbsp;</li><li class=\"ordered-list-item--numbered\">vorbereitende planerische Maßnahmen (dazu gehören insbesondere Wohnraumkonzepte, Fachgutachten und Wettbewerbe).</li></ol>" ];
                                                                                                             xyz:foerdernehmende         [ xyz:beschreibung     "Zuwendungsempfänger können sein:\n\nGemeinden - auch im Rahmen einer kommunalen Zusammenarbeit (zum Beispiel als Zweckverband oder auf Grundlage einer Zweckvereinbarung), sofern ausschließlich Gemeinden beteiligt sind.\n\nLandkreise und Bezirke, wenn der geförderte Wohnraum für eigene Bedienstete bestimmt ist oder dazu dient, neue Bedienstete zu gewinnen.\n\nDie Zuwendungsempfänger müssen Eigentümer des geförderten Wohnraums sein. Zur Umsetzung können sie sich insbesondere kommunaler Wohnungsbauunternehmen bedienen. Kirchen können als Kooperationspartner Grundstücke im Wege eines Erbbaurechts bereitstellen.";
                                                                                                                                           xyz:foerdernehmende  [ xyz:code           "009";
                                                                                                                                                                  xyz:listURI        "urn:xoev-de:stmd:codeliste:foerdernehmende";
                                                                                                                                                                  xyz:listVersionID  "1";
                                                                                                                                                                  xyz:name           ""
                                                                                                                                                                ]
                                                                                                                                         ];
