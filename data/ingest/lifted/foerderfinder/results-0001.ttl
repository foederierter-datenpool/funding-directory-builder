                                                                                                                                           xyz:linkZurAntragsstellung   "https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/werteprojekte_bayern/index?caller=bpgi2gcnlcmi4don3ggqzggnrumhe4zxgip7e2eb5bx34ao4zgyixwp2wtfkrg2yatsh5zl4zbnc45kmhdxne7wqfl63dhz2axeaultkirtxx4coa4t7eytnomwmowsc3ik2jq7lhg4yijpr7dba4kjglcaswmtrxjpbpzimzic2tmelszz256cwciuozklypqgrkrrjgkmxtmdz76gvkz33oagbooxyu4spgrl6a8";
                                                                                                                                           xyz:rechtsbehelf             "<p>Verwaltungsgerichtliche Klage gegen Bewilligungsbescheid.</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<p>Der Antrag ist zunächst per E-Mail zusammen mit einem aussagekräftigen Projektkonzept und einem Ausgaben- und Finanzierungsplan beim Bayerischen Staatsministerium des Innern, für Sport und Integration (StMI) (<a href=\"mailto:Sachgebiet-G2@stmi.bayern.de\" dir=\"ltr\">Sachgebiet-G2@stmi.bayern.de</a>) einzureichen.&nbsp;</p><p>Nach Freigabe des Projektkonzepts durch das StMI ist der Antrag per E-Mail bei der Regierung von Mittelfranken, Sachgebiet 15 - Integration und Förderung, (<a href=\"mailto:SG15.Integration@reg-mfr.bayern.de\" dir=\"ltr\">SG15.Integration@reg-mfr.bayern.de</a>) zu stellen.&nbsp;</p><p>Die Regierung von Mittelfranken ist zuständig für die Bewilligung. Bewilligungszeitraum ist grundsätzlich die Zeit vom 1. Januar bis 31. Dezember.</p>";
                                                                                                                                                                          xyz:erlaeuterungVorzeitigerMassnahmebeginn
                                                                                                                                                                                  "<p>Zuwendungen dürfen grundsätzlich nur für solche Vorhaben bewilligt werden, die noch nicht begonnen worden sind. Rein vorbereitende oder planende Maßnahmen wie etwa die Teilnehmerakquise gelten nicht als Vorhabenbeginn.</p>";
                                                                                                                                                                          xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "002";
                                                                                                                                                                                                            xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
                                                                                                                                                                                                            xyz:listVersionID  "1"
                                                                                                                                                                                                          ]
                                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:finanzierungsartUndHoehe  "<p>Die Zuwendung wird als Anteilfinanzierung im Rahmen einer Projektförderung bis</p><p>maximal 90 % der zuwendungsfähigen Ausgaben gewährt. Die staatliche Förderung</p><p>setzt eine Beteiligung des Zuwendungsempfängers in Höhe von mindestens 10 %</p><p>der zuwendungsfähigen Projektausgaben voraus.</p><p><br></p><p>Die Förderung erfolgt ohne Rechtsanspruch im Rahmen zur Verfügung stehender</p><p>Haushaltsmittel.</p>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "003";
                                                                                                                                                                                                    xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
                                                                                                                                                                                                    xyz:listVersionID  "1";
                                                                                                                                                                                                    xyz:name           ""
                                                                                                                                                                                                  ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:laufzeitFinanzierung      [ xyz:dauer                 [ xyz:dauerFest  [ xyz:jahre  "1" ]
                                                                                                                                                                                                     ];
                                                                                                                                                                           xyz:laufzeitFinanzierung  [ xyz:code           "002";
                                                                                                                                                                                                       xyz:listURI        "urn:xoev-de:stmd:codeliste:laufzeit-finanzierung";
                                                                                                                                                                                                       xyz:listVersionID  "1";
                                                                                                                                                                                                       xyz:name           "Teilprojektlaufzeit"
                                                                                                                                                                                                     ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Im Rahmen der Kursreihe \"Leben in Bayern\" sind folgende projektbezogene Ausgaben zuwendungsfähig:</p><ul><li class=\"unordered-list-item--dash\">Projektleitung und Projektkoordination</li><li class=\"unordered-list-item--dash\">Vor- und Nachbereitung der Kurse und Module</li><li class=\"unordered-list-item--dash\">Ausgaben für die Kinderbetreuung</li><li class=\"unordered-list-item--dash\">ehrenamtlicher Einsatz von Kulturmittlern</li><li class=\"unordered-list-item--dash\">Ausgaben für eine Abschlussveranstaltung</li></ul>"
                                                                                                                                         ];
                                                                                                             xyz:foerderbereich          [ xyz:foerderbereich  [ xyz:code           "022";
                                                                                                                                                                 xyz:listURI        "urn:xoev-de:stmd:codeliste:foerderbereich";
                                                                                                                                                                 xyz:listVersionID  "1";
                                                                                                                                                                 xyz:name           ""
                                                                                                                                                               ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergebiet           [ xyz:laender  [ xyz:land  [ xyz:code           "BY";
                                                                                                                                                                      xyz:listURI        "urn:xoev-de:pks:codeliste:bundesland";
                                                                                                                                                                      xyz:listVersionID  "1";
                                                                                                                                                                      xyz:name           ""
                                                                                                                                                                    ]
                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergegenstand       [ xyz:beschreibung
                                                                                                                               "<p>Gefördert wird die Kursreihe \"Leben in Bayern\" bestehend aus den drei Modulen:</p><ul><li class=\"unordered-list-item--dash\">Miteinander leben in Bayern</li><li class=\"unordered-list-item--dash\">Erziehung und Bildung in Bayern</li><li class=\"unordered-list-item--dash\">Gesundheit in Bayern</li></ul><p>Der Inhalt der Module richtet sich nach den von der Bayerischen Landeszentrale für politische Bildungsarbeit erarbeiteten Unterrichtsmaterialien, bestehend aus dem Lehrkonzept für die Kursleiterinnen und Kursleiter sowie dem Arbeitsbuch für die Teilnehmerinnen und Teilnehmer. Jedes Modul wird von einer Unternehmung, die einen thematischen Bezug zu unseren Werten oder zu unserer Kultur hat, begleitet (zum Beispiel Besuch einer Schule oder einer Kindertagesstätte, Museumsbesuch, Stadtrundgänge).</p>" ];
                                                                                                             xyz:foerdernehmende         [ xyz:beschreibung     "Antragsberechtigt sind alle rechtsfähigen Träger, die über die erforderliche Zuverlässigkeit und Leistungsfähigkeit zur Durchführung des Projektes verfügen und deren bisherige Tätigkeit das Erreichen des Förderzwecks erwarten lässt.";
