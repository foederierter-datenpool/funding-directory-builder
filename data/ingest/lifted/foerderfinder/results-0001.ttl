                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>99defcba-e823-42e2-9582-58b780360c15</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2025-01-21T13:54:05</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>99defcba-e823-42e2-9582-58b780360c15</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>99defcba-e823-42e2-9582-58b780360c15</xflb:schluessel>\n         <xflb:versionFLB>3</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-08-31T08:53:01</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>99defcba-e823-42e2-9582-58b780360c15</xflb:foerderschluessel>\n                  <xflb:flbVersion>3</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400298017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Landesstiftung Hilfe für Mutter und Kind - Leistungen für Familien in Not</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Die Leistungen der Stiftung sollen Familien, die unverschuldet in eine Notlage (z. B. durch Krankheit, Tod eines Familienangehörigen, Arbeitslosigkeit usw.) geraten sind, spürbar entlasten, wenn öffentliche und private Hilfen fehlen oder nicht ausreichen. Mit der Hilfe der \"Landesstiftung Hilfe für Mutter und Kind\" soll Hilfe zur Selbsthilfe geleistet werden.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Familien, insbesondere kinderreiche Familien sowie allein erziehende Elternteile, die unverschuldet in eine Existenz bedrohende Notlage geraten sind, können als Hilfe zur Selbsthilfe Leistungen der \"Landesstiftung Hilfe für Mutter und Kind\" erhalten.</xflb:teaser>\n                  <xflb:schluesselwoerter>Familie, Mutter, Kinder, Schulmaterial, Schwangerschaft, Kleidung, Notlage, Alleinerziehende</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:alternativeFoerdermoeglichkeiten>\n                  <xflb:alternativeFoerdermoeglichkeit>\n                     <xflb:beschreibung>Wenn Ihnen der Verlust der Wohnung droht und Sie aus eigener Kraft trotz Suche keine neue Unterkunft in Aussicht haben oder Sie aufgrund eines plötzlichen Ereignisses obdachlos geworden sind, kann Ihnen die Gemeinde verschiedene Hilfestellungen geben.</xflb:beschreibung>\n                     <xflb:verweis>\n                        <xflb:bezeichnung>Obdachlosigkeit; Inanspruchnahme von Hilfestellungen zur Vermeidung</xflb:bezeichnung>\n                        <xflb:link>https://www.bayernportal.de/dokumente/leistung/45442143496</xflb:link>\n                     </xflb:verweis>\n                  </xflb:alternativeFoerdermoeglichkeit>\n                  <xflb:alternativeFoerdermoeglichkeit>\n                     <xflb:beschreibung>Sie können unter anderem von der Gemeinde und dem Landratsamt Auskünfte in sozialen Angelegenheiten erhalten.</xflb:beschreibung>\n                     <xflb:verweis>\n                        <xflb:bezeichnung>Soziale Angelegenheiten; Auskunft</xflb:bezeichnung>\n                        <xflb:link>https://www.bayernportal.de/dokumente/leistung/688090311448</xflb:link>\n                     </xflb:verweis>\n                  </xflb:alternativeFoerdermoeglichkeit>\n               </xflb:alternativeFoerdermoeglichkeiten>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Familienland Bayern - Mehrkindfamilien</xflb:bezeichnung>\n                     <xflb:link>https://www.familienland.bayern.de/themen/mehrkindfamilien/index.php</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Landesstiftung Hilfe für Mutter und Kind - Stiftungszweck \"Familien in Not\"</xflb:bezeichnung>\n                     <xflb:link>https://www.zbfs.bayern.de/foerderungen/stiftungen/landesstiftung_mutter_kind_familien/#accordion-0-5-0-5</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Zentrum Bayern Familie und Soziales</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>2</xflb:hausnummerPostfach>\n                     <xflb:strasse>Hegelstraße</xflb:strasse>\n                     <xflb:postleitzahl>95447</xflb:postleitzahl>\n                     <xflb:ort>Bayreuth</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>landesstiftung@zbfs.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Zur Website der Landesstiftung Hilfe für Mutter und Kind</xflb:bezeichnung>\n                     <xflb:link>https://www.zbfs.bayern.de/foerderungen/stiftungen/landesstiftung_mutter_kind_familien/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>0921 605-1</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Zentrum Bayern Familie und Soziales</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>2</xflb:hausnummerPostfach>\n                           <xflb:strasse>Hegelstraße</xflb:strasse>\n                           <xflb:postleitzahl>95447</xflb:postleitzahl>\n                           <xflb:ort>Bayreuth</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>landesstiftung@zbfs.bayern.de</xflb:email>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Zur Website der Landesstiftung Hilfe für Mutter und Kind</xflb:bezeichnung>\n                           <xflb:link>https://www.zbfs.bayern.de/foerderungen/stiftungen/landesstiftung_mutter_kind_familien/</xflb:link>\n                        </xflb:verweis>\n                        <xflb:telefonnummer>0921 605-1</xflb:telefonnummer>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>19e22fd8-43f9-41b2-9728-bdd38d130941</xflb:id>\n                     <xflb:bezeichnung>Allgemeiner Antrag - Leistungen an Familien in Not</xflb:bezeichnung>\n                     <xflb:link>https://www.zbfs.bayern.de/imperia/md/content/stmas/zbfs_2022/stiftungen/fin_hilfegesuch.pdf</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Zuwendungsempfänger sind vorrangig:\n\n- Familien nach Mehrlingsgeburt ab Drillingen,\n- Familien nach der Geburt des sechsten oder eines weiteren Kindes,\n- Familien mit drei oder mehr Kindern in Not,\n- alleinerziehende Elternteile in Not mit mindestens einem Kind.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Förderung erfolgt als auflösend bedingte zweckgebundene Zuwendungen oder in begründeten Ausnahmefällen als zinsloses Darlehen. Der Umfang der Leistung richtet sich nach dem notwendigen Bedarf und den besonderen Umständen des Einzelfalls. In der Regel können bis zu 4.000 Euro bewilligt werden. In besonderen Ausnahmefällen können bis zu 10.500 Euro, in Fällen der Wohnraumbeschaffung bis zu 15.500 Euro gewährt werden.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Die Leistungsempfänger haben gegenüber der Stiftungsverwaltung die zweckentsprechende Verwendung nachzuweisen. Hierfür sind geeignete Unterlagen vorzulegen.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Familie, Arbeit und Soziales</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Vergabegrundsätze für die Gewährung von Leistungen der Landesstiftung \"Hilfe für Mutter und Kind\" an Familien in Not</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2173_A_14786/true</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat IV 3</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Landesstiftung Hilfe für Mutter und Kind \"Familien in Not\"</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2028-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2025-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2028-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gegenstand der Förderung sind Finanzierung notwendiger Anschaffungen (Möbel, Bekleidung, Schulmaterial), Vermeidung von Obdachlosigkeit (Mietkaution, Maklergebühr, erste Monatsmiete), Minderung von Schuldenverpflichtungen (unter besonderen Voraussetzungen) sowie Deckung sonstigen Bedarfs nach Absprache.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Vorrangig sollen unterstützt werden:&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Familien nach Mehrlingsgeburt ab Drillingen,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Familien nach der Geburt des sechsten oder eines weiteren Kindes,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Familien mit drei oder mehr Kindern in Not,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;alleinerziehende Elternteile in Not mit mindestens einem Kind.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Darüber hinaus kann ausnahmsweise zur Abhilfe einer offensichtlich schweren Notlage Hilfe geleistet werden.&lt;/p&gt;&lt;p&gt;Antragsstellende müssen folgende Voraussetzung erfüllen:&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;unverschuldete Notlage&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Mitwirkungsbereitschaft zur Problemlösung&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;dauerhafte Konsolidierung der wirtschaftlichen und sozialen Lage zu erwarten&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;gesetzliche Leistungen und sonstige Hilfen nicht vorgesehen oder nicht ausreichend&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Befürwortung durch geeignete Institution&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;mindestens sechs Monate ständigen Aufenthalt in Bayern&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;mindestens ein Familienmitglied hat die deutsche Staatsangehörigkeit&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Unterstützung hält sich in den Grenzen des § 53 Abgabenordnung&lt;/li&gt;&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.zbfs.bayern.de/imperia/md/content/stmas/zbfs_2022/stiftungen/fin_hilfegesuch.pdf</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Hilfesuchende können sich direkt an die \"Landesstiftung Hilfe für Mutter und Kind\" (Stiftungsverwaltung) wenden, bei Aussicht auf Erfolg wird ein Antrag zugesandt.&amp;nbsp;Auch die örtlich zuständige Gemeinde, die Sozialhilfeverwaltungen, die Jugendämter, die Landratsämter/Gesundheitsverwaltungen, die staatlich anerkannten Beratungsstellen für Schwangerschaftsfragen oder andere öffentliche Institutionen, die sich für die Behebung bzw. Linderung der Notlage engagieren, nehmen als Übermittlungsboten die ausgefüllten Vordrucke entgegen und leiten sie an die Stiftung weiter.&amp;nbsp;Die Hilfesuchenden haben geeignete Nachweise vorzulegen. Die Leistungen sollen in geeigneten Fällen in Teilzahlungen ausgezahlt werden.&lt;/p&gt;</xflb:bewilligung>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:tage>7</xflb:tage>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>3</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Einkommens- und Vermögensnachweis</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Nachweis über finanzielle Belastungen</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Es besteht kein Rechtsanspruch auf diese Leistung, daher ist die Möglichkeit eines Rechtsbehelfs nicht gegeben.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_69   [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/rmf_15-036_zz_auszahlungsantrag_bm/index?caller=bpgjrdozrwhbstiyjvhfqtaobtmwpa7l7kbmah7fttz24zkz7ua6nko7g7bwgc4g7sepsq45pv3veqfbqshn7lqwb4gbenfznfmuuift7grbzumxy74g32c5l3j6sryhyy55psftox6m5senwvxgdo2bb7xukyn4vxer7nbtz7dfrpizm6i7n34m265prs4fvnjq4h63ix2d3ap3j5ygwtxyjcekc3obvzciujjbnzxtm4kook4mnmher5ecfwfudr";
                                xyz:begriffeImKontext    [ rdf:_1  "Integrationsprozess";
                                                           rdf:_2  "Integrationsprojekte"
                                                         ];
                                xyz:beschreibung         "<p>Ziel der Förderung ist die Unterstützung von Projekten, die auf die Stärkung des Integrationsprozesses von Menschen mit Migrationsgeschichte und von Asylbewerberinnen und Asylbewerbern mit guter Bleibeperspektive ausgerichtet sind.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Integration" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Kommunen" ];
                                xyz:foerderprogramm      "Richtlinie für die Förderung der sozialen Beratung, Betreuung und Integration von Menschen mit Migrationsgeschichte (Beratungs- und Integrationsrichtlinie - BIR)";
                                xyz:foerderzeitraum.bis  "2026-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2024-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "298c967c-a5a4-413d-bd43-a077c40e2ede";
                                xyz:teaser               "Die gelingende Integration von Menschen mit Migrationsgeschichte bzw. guter Bleibeperspektive wird  vom Freistaat Bayern durch spezielle Integrationsprojekte (sog. \"besondere Maßnahmen\") unterstützt.";
                                xyz:titel                "Förderung besonderer Maßnahmen zur Stärkung des Integrationsprozesses";
                                xyz:titel.tokens         [ rdf:_1  "Förderung besonderer Maßnahmen zur Stärkung des Integrationsprozesses" ];
                                xyz:voraussetzung        "<p>Die Projekte können insbesondere aus den Bereichen kulturelle Integration, Stärkung von Familien und Müttern als Schlüsselrolle im Integrationsprozess sowie Jugend und Ehrenamt kommen.&nbsp;Auf die gesetzlichen Regelungen zum Kinder- und Jugendschutz bezüglich der Vorlage eines (erweiterten) Führungszeugnisses wird hingewiesen.</p>"
                              ];
