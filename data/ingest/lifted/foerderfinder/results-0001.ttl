                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Zuwendungsfähige Kosten sind eine Pauschale der Ausbildungsvergütung für die betriebliche Ausbildung in Teilzeit nach den Vorschriften von Berufsbildungsgesetz (BBiG) oder Handwerksordnung (HwO) in Bayern.</p>"
                                                                                                                                         ];
