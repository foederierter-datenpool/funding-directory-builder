                                            xyz:nachrichtenkopf    [ xyz:empfaenger            "Förderfinder Suche (Bayern)";
                                                                     xyz:erstellungszeitpunkt  "2025-04-25T10:43:36";
                                                                     xyz:nachrichtennummer     "1a391e8d-9719-4fd5-9938-9bfdbed101ac";
                                                                     xyz:sender                "XFLB-Connect (Bayern)"
                                                                   ];
                                            xyz:produkt            "Förderfinder";
                                            xyz:produkthersteller  "StMD Bayern";
                                            xyz:schemaLocation     "http://xoev.de/schemata/xflb/2_0_0";
                                            xyz:standard           "XFLB";
                                            xyz:version            "2.0.0"
                                          ];
                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>1a391e8d-9719-4fd5-9938-9bfdbed101ac</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2025-04-25T10:43:36</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>1a391e8d-9719-4fd5-9938-9bfdbed101ac</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>1a391e8d-9719-4fd5-9938-9bfdbed101ac</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2025-04-25T10:43:36</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>1a391e8d-9719-4fd5-9938-9bfdbed101ac</xflb:foerderschluessel>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Berufsorientierungsmaßnahmen an Mittelschulen; Beantragung einer Förderung</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Zum Ende ihrer Schulzeit müssen Jugendliche eine bedeutsame Orientierungs- und Entscheidungsleistung erbringen. In unserem dynamischen Bildungs- und Beschäftigungssystem entstehen fast täglich neue Ausbildungsgänge, Studienangebote und Berufsfelder. Der Zuwachs an Entscheidungsmöglichkeiten einerseits stellt deswegen auch erhöhte Anforderungen an die Orientierungs- und Entscheidungskompetenz junger Menschen andererseits. Aus diesem Grund bedürfen Schülerinnen und Schüler heute einer intensiveren Unterstützung beim Übergang von der Schule in den Beruf als noch vor wenigen Jahren.&lt;/p&gt;\n&lt;p&gt;Durch die Berufsorientierungsmaßnahmen sollen die jungen Menschen einen vertieften Einblick in die Berufs- und Arbeitswelt erhalten und damit besser auf die Berufs- und Studienwahl vorbereitet werden. Der Anteil unversorgter Bewerberinnen und Bewerber kann dadurch verringert und Ausbildungs- sowie Studienabbrüche aufgrund unzureichender Berufsvorstellungen können vermieden werden.&lt;/p&gt;\n&lt;p&gt;Im Rahmen der erweiterten vertieften Berufsorientierung an Mittelschulen durchgeführte Maßnahme können auf Antrag gefördert werden.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Schüler an Mittelschulen werden ab der 7. Jahrgangsstufe im Rahmen der erweiterten vertieften Berufsorientierung mit Berufsorientierungsmaßnahmen (BOM) intensiv auf den Übergang von der Schule in den Beruf vorbereitet werden. Diese Maßnahmen werden gefördert.</xflb:teaser>\n                  <xflb:schluesselwoerter>staatliche Mittelschulen; BO; Berufsorientierung; Förderung; Bildung</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Leitfaden zum Qualitätsmanagement in der Beruflichen Orientierung</xflb:bezeichnung>\n                     <xflb:link>https://www.schulentwicklung.isb.bayern.de/fileadmin/user_upload/Schulentwicklung/QmbS/Downloadcenter/Leitfaden_fuer_das_Qualitaetsmanagement_in_der_Beruflichen_Orientierung.pdf</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Kontaktliste der sieben Bezirksregierungen</xflb:bezeichnung>\n                     <xflb:link>https://www.bayernportal.de/dokumente/behoerde/66776027377</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Kontaktliste der staatlichen Schulämter</xflb:bezeichnung>\n                     <xflb:link>https://www.bayernportal.de/dokumente/behoerde/51554728178</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Staatsministerium für Unterricht und Kultus</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>2</xflb:hausnummerPostfach>\n                     <xflb:strasse>Salvatorstraße</xflb:strasse>\n                     <xflb:postleitzahl>80327</xflb:postleitzahl>\n                     <xflb:ort>München</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Regierungen und Schulämter</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>05aad303-3138-4779-aaa4-d6453b766ff4</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Förderung der Ausgaben für Berufsorientierungsmaßnahmen nach § 48 SGB III an Mittelschulen (Öffentliche Mittelschulen)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rvs/b4/40.1/rvs_40.1-211/index</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>008</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Die Förderung richtet sich an Maßnahmeträger, die Berufsorientierungsmaßnahmen für Schülerinnen und Schüler allgemeinbildender Schulen durchführen.\nSchulen oder Lehrgänge des zweiten Bildungswegs sowie berufsbildende Schulen gelten dabei nicht als allgemeinbildende Schulen im Sinne des § 48 Absatz 1 SGB III.\n\nAls fördernde Dritte (Kofinanzierer) kommen außerdem in Betracht:\n- Kammern\n- Schulen oder Fördervereine von Schulen\n- Betriebe\n- ausnahmsweise Maßnahmeträger oder Trägerverbünde, wenn eine ESF-Kofinanzierung von mindestens 25 % der Gesamtkosten vorliegt</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Förderung erfolgt als Kofinanzierung aus dem Haushalt des Bayerischen Staatsministeriums für Unterricht und Kultus. Die Förderung erfolgt als Kofinanzierung. Die Höhe des Zuschusses beträgt bis zu 50 Prozent der zuwendungsfähigen Ausgaben.&lt;/p&gt;\n&lt;p&gt;Eine Kofinanzierung mit ESF-Mitteln ist zulässig.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Förderfähig sind i. d. R. Kosten, die unmittelbar mit der Durchführung der Berufsorientierungsmaßnahme verbunden sind (§ 48 SGB III). Dazu gehören laut den fachlichen Weisungen der Agentur für Arbeit vor allem die Durchführung und Betreuung der Maßnahme selbst und die unmittelbare organisatorische Abwicklung.&lt;/p&gt;\n&lt;p&gt;Kosten für Koordinierungs- und Organisationsaufgaben können nur dann anteilig gefördert werden, wenn sie \"unabdingbar\" für die Durchführung des Gesamtprojektes sind. Solche Kosten dürfen dabei in der Summe nicht mehr als etwa 10 % der Gesamtmaßnahmekosten ausmachen. Liegt der Anteil bei mehr als 30 %, gilt das i. d. R. als nicht mehr angemessen. Beispiele dafür sind unter anderem:&lt;/p&gt;\n&lt;ul&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Vergabe der Maßnahme&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Abwicklung und Abrechnung&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Qualitätssicherung&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Ergebnisberichte und Datenauswertung&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Schulung/Einweisung des Personals&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Öffentlichkeitsarbeit im Rahmen der Maßnahme&lt;/li&gt;\n&lt;/ul&gt;\n&lt;p&gt;Nicht übernommen werden grundsätzlich:&lt;/p&gt;\n&lt;ul&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Kosten für Verpflegung der Schülerinnen und Schüler während der Maßnahme.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Fahrtkosten der Teilnehmenden, soweit sie im Zusammenhang mit der Maßnahme anfallen.&lt;/li&gt;\n&lt;/ul&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Unterricht und Kultus</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderung der Ausgaben für Berufsorientierungsmaßnahmen nach § 48 SGB III an Mittelschulen</xflb:bezeichnung>\n                     <xflb:link>https://www.bayernportal.de/dokumente/leistung/386069325901?localize=false</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>IV.2</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Berufsorientierungsmaßnahmen an Mittelschulen; Beantragung einer Förderung</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2032-04-30</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2025-04-30</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2030-11-30</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:verlaengerungsoption>ja</xflb:verlaengerungsoption>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gegenstand der Förderung sind Maßnahmen zur Berufsorientierung an öffentlichen und staatlich anerkannten Mittelschulen. Dazu gehören insbesondere praktische Projekte, Workshops, Betriebs- und Praxiskontakte sowie begleitende Unterstützungsangebote, die ergänzend zum Unterricht durchgeführt werden.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>002</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Zwingende Voraussetungen:&lt;/p&gt;\n&lt;ul&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Die Maßnahme dient der Berufsorientierung oder Berufswahlvorbereitung.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Sie richtet sich an Schülerinnen und Schüler allgemeinbildender Mittelschulen.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Agentur für Arbeit und ein externer Träger beteiligen sich gemeinsam an der Finanzierung.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Der jeweilige Partner übernimmt mindestens 50 % der Kosten (Agentur für Arbeit höchstens 50 %).&lt;/li&gt;\n&lt;/ul&gt;\n&lt;p&gt;Folgende Voraussetzungen werden dringend empfohlen:&lt;/p&gt;\n&lt;ul&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Führen Sie vorab eine Bedarfsanalyse durch, die die Zielgruppe, die regionale Angebotslage und bestehende Programme berücksichtigt.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Binden Sie die Maßnahme in das Berufsorientierungskonzept der Schule ein und stimmen Sie sie mit der Schule sowie der Berufsberatung ab.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Stellen Sie ein schlüssiges Konzept sicher, das Ziele, Ablauf, Methoden und eine Kostenplanung umfasst.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Lassen Sie die Maßnahme von einem geeigneten Träger mit qualifiziertem Personal durchführen.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Berücksichtigen Sie bei der Umsetzung die besonderen Bedürfnisse von Schülerinnen und Schülern mit sonderpädagogischem Förderbedarf oder Schwerbehinderung.&lt;/li&gt;\n&lt;/ul&gt;\n&lt;p&gt;Mehr Infos finden Sie unter 'Weiterführende Informationen'.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Eine Förderung ist ausgeschlossen, wenn&amp;nbsp;&lt;/p&gt;\n&lt;ul&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;es vor Ort bereits vergleichbare, dauerhaft eingerichtete und kommunal finanzierte Angebote zur Berufsorientierung gibt&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;der Maßnahmeträger und der Kofinanzierer identisch sind&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;eine Kofinanzierung aus Mitteln des SGB II erfolgen soll&lt;/li&gt;\n&lt;/ul&gt;\n&lt;p&gt;Folgende Förderangebote können keine eigenständigen Berufsorientierungsmaßnahmen &amp;nbsp;nach § 48 SGB III sein, jedoch unter Umständen ein Element einer Berufsorientierungsmaßnahme darstellen: &amp;nbsp;&lt;/p&gt;\n&lt;ul&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Bewerbungstraining&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;individuelle Begleitung der Teilnehmenden (Coaching)&amp;nbsp;&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Allgemeinbildung und muttersprachlicher Unterricht&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Koordinierung von Berufsorientierungsangeboten&lt;/li&gt;\n&lt;/ul&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rvs/b4/40.1/rvs_40.1-211/index</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Der Antrag auf Förderung ist über das Schulamt bei der Regierung einzureichen.&lt;a href=\"http://einzureichen.Im\"&gt; &lt;/a&gt;Im Antrag bestätigt die Schulleitung die ordnungsgemäße Durchführung der Maßnahme mit Angaben zu Organisation, Konzept, Personal und Ablauf. Das Staatliche Schulamt prüft die Rechnung des Maßnahmenträgers sowie ggf. den Bescheid der Agentur für Arbeit und bestätigt die Angaben als sachlich und rechnerisch richtig. Die zuständige Regierung prüft den Antrag abschließend und ordnet die Auszahlung der Fördermittel an.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:tage>1</xflb:tage>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>1</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristSpanne>\n                        <xflb:min>\n                           <xflb:wochen>1</xflb:wochen>\n                        </xflb:min>\n                        <xflb:max>\n                           <xflb:monate>1</xflb:monate>\n                        </xflb:max>\n                     </xflb:fristSpanne>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Fristen und Termine erhalten Sie bei den bayerischen Regierungen</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Die jeweils für Sie zuständige Regierungen gibt Auskunft über beizufügenden Unterlagen.</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Gegen den Zuwendungsbescheid können Sie innerhalb von einem Monat Widerspruch einlegen. Die Stelle, bei der Sie den Widerspruch einreichen können, wird Ihnen im Bescheid mitgeteilt.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_10   [ xyz:attributes  [ xyz:antragsstellung      "https://www.tfz.bayern.de/foerderung/345761/index.php";
                                xyz:begriffeImKontext    [ rdf:_1  "Biogasaufbereitung";
                                                           rdf:_2  "Biogasaufbereitungsanlagen";
                                                           rdf:_3  "Biogasleitungen";
                                                           rdf:_4  "Biomethanleitungen";
                                                           rdf:_5  "Biomethan";
                                                           rdf:_6  "Netzeinspeisung";
                                                           rdf:_7  "BioMeth"
                                                         ];
                                xyz:beschreibung         "<p>Durch die Errichtung neuer, umweltfreundlicher Biogasaufbereitungsanlagen und Biogas- bzw. Biomethanleitungen wird die Direktnutzung von Biogas vor Ort und die Nutzung von Biomethan zur Erzeugung von Strom, Wärme und Kraftstoff gefördert. Mit den geförderten Projekten soll jährlich bis zu 9.000 Tonnen CO2 eingespart werden.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Energieeffizienz und Erneuerbare Energien" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
