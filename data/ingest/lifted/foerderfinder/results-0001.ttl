                                                                                                                                           xyz:beschreibung       [ xyz:schluesselwoerter  "Pflege, Pflegeplatz, Pflegeplätze, Pflegeeinrichtungen, Quartier, Kurzzeitpflege, Verhinderungspflege, palliative Pflege, Tagespflege, Nachtpflege, ambulant betreute Wohngemeinschaft, Dauerpflege, Pflegeheim, Altenheim, Seniorenheim, Begegnungsstätte";
                                                                                                                                                                    xyz:teaser             "Der Freistaat Bayern fördert den flächendeckenden und bedarfsgerechten Ausbau der pflegerischen Versorgungsstruktur für vollstationäre Dauerpflegeeinrichtungen (ohne Öffnung in den sozialen Nahraum).";
                                                                                                                                                                    xyz:zuwendungszweck    "<p>Zweck der Förderung ist der demenzsensible Umbau, die Modernisierung und die Schaffung von vollstationären Dauerpflegeplätzen.</p>"
                                                                                                                                                                  ];
