                                                                                                                       xyz:programmtitel             "Kurse zur Vorbereitung auf das erfolgreiche Nachholen des Mittelschulabschlusses und des Mittleren Schulabschlusses";
                                                                                                                       xyz:verantwortlichesMinisterium
                                                                                                                               "Staatsministerium für Unterricht und Kultus"
                                                                                                                     ];
                                                                                                             xyz:foerdervoraussetzungen  [ xyz:ausschlusskriterien  "<p>Förderanträge können ausschließlich von den durch das Staatsministerium für Unterricht und Kultus als antragsberechtigt bestimmten Trägern gestellt werden.</p>";
                                                                                                                                           xyz:buergerfreundlicheBeschreibung
                                                                                                                                                   "<ul>\n  <li class=\"unordered-list-item--dash\">Die Kurse müssen teilnehmeroffen sein; d. h. es können sowohl Peronen mit Schulabschluss als auch Personen ohne Schulabschluss teilnehmen.</li>\n  <li class=\"unordered-list-item--dash\">An einem Kurs müssen mindestens 5 Personen teilnehmen.</li>\n  <li class=\"unordered-list-item--dash\">Um die Personen sinnvoll auf den Mittleren Schulabschluss vorzubereiten, sind mindestens 700 Unterrichtseinheiten erforderlich.</li>\n  <li class=\"unordered-list-item--dash\">Der Projektträger ist verpflichtet, qualifiziertes Personal für den Unterricht einzusetzen und eine qualifizierte sozialpädagogische Betreuung sicherzustellen.</li>\n  <li class=\"unordered-list-item--dash\">Der Maßnahmenzeitraum muss mindestens 7 Monate betragen.</li>\n</ul>"
                                                                                                                                         ];
