                                                         ];
                                xyz:beschreibung         "<p>Mit der Zuwendung soll psychisch Kranken eine Teilnahme an den Abläufen des normalen Lebens erleichtert und Vorurteile abgebaut werden.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Gesundheit und Soziales" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Verbände" ];
                                xyz:foerderprogramm      "Fortbildung und Laienhelfer";
                                xyz:foerderzeitraum.bis  "2028-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2021-01-07T00:00:00.000+00:00";
                                xyz:schluessel           "9f3920f8-c4ef-4134-9551-8ca6345b030d";
                                xyz:teaser               "Der Freistaat Bayern gewährt Zuwendungen für die Betreuung von psychisch Kranken durch Laienhelfer in Bayern.";
                                xyz:titel                "Betreuung von psychisch Kranken (Laienhelfer)";
                                xyz:titel.tokens         [ rdf:_1  "Betreuung von psychisch Kranken (Laienhelfer)" ];
                                xyz:voraussetzung        "<p>Wesentliche Förderungsvoraussetzungen</p><ul><li class=\"unordered-list-item--dash\">Laienhelfer sollen einer Gruppe von mindestens vier Helfern angehören und ehrenamtlich, regelmäßig und über das ganze Jahr hinweg in der Laienarbeit tätig sein.&nbsp;</li><li class=\"unordered-list-item--dash\">Die fachliche Begleitung der Laienhelfer soll gewährleistet sein.&nbsp;</li><li class=\"unordered-list-item--dash\">Für die erstmalige staatliche Förderung sollten die Fördervoraussetzungen seit etwa einem Jahr vor dem Bewilligungszeitraum erfüllt sein.</li></ul>"
                              ];
              xyz:id          "9f3920f8-c4ef-4134-9551-8ca6345b030d";
