                                                                                                                     ];
                                                                                                             xyz:foerdervoraussetzungen  [ xyz:ausschlusskriterien     "<p>Freiberufler (Freelancer) sind nicht teilnahme-/antragsberechtigt; das Förderprogramm richtet sich ausschließlich an die gewerbliche Wirtschaft.</p>";
                                                                                                                                           xyz:buergerfreundlicheBeschreibung
                                                                                                                                                   "Die Möglichkeit zur Förderantragstellung setzt zwingend eine erfolgreiche Teilnahme am vorherigen Wettbewerb voraus, d.h., wenn die Bewerbung von der externen Jury zur Förderung ausgewählt wurde.";
                                                                                                                                           xyz:rechtlicheBeschreibung  "Zur Teilnahme am Wettbewerb und zur Beantragung der Zuwendung darf die gewerbliche Unternehmensneugründung zum Stichtag des Bewerbungsfristendes nicht älter als zwei Jahre sein bzw. die gewerbliche Unternehmensneugründung hat bis zum Stichtag des Bewerbungsfristendes vollzogen zu sein."
                                                                                                                                         ];
