                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<p>Das Verfahren ist zweistufig:</p><ol><li class=\"ordered-list-item--numbered\">Der Antrag ist bei der Bayerischen Landesbodenkreditanstalt mittels der dafür vorgesehenen Formulare und Unterlagen einzureichen. Die Bewilligung erfolgt durch die Kreisverwaltungsbehörde.</li><li class=\"ordered-list-item--numbered\">Die Darlehenszusage und Zustellung des Bewilligungsbescheids erfolgt durch die Bayerische Landesbodenkreditanstalt. Die Auszahlung erfolgt nach Baufortschritt und ist bei der Kreisverwaltungsbehörde zu beantragen. Für die Beratung sind die Landratsämter oder kreisfreien Städte zuständig.</li></ol>";
                                                                                                                                                                          xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "002";
                                                                                                                                                                                                            xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
                                                                                                                                                                                                            xyz:listVersionID  "1"
                                                                                                                                                                                                          ]
                                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:finanzierungsartUndHoehe  "<p>Im Zinsverbilligungsprogramm erfolgt die Förderung mit einem zinsverbilligten Darlehen mit bis zu einem Drittel der Gesamtkosten. Zudem kann in Verbindung mit dem Darlehen ein Kinderzuschuss in Höhe von 5.000 Euro je Kind gewährt werden.&nbsp;</p>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ rdf:_1  [ xyz:code           "001";
                                                                                                                                                                                                              xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
                                                                                                                                                                                                              xyz:listVersionID  "1";
                                                                                                                                                                                                              xyz:name           ""
                                                                                                                                                                                                            ];
                                                                                                                                                                                                    rdf:_2  [ xyz:code           "002";
                                                                                                                                                                                                              xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
                                                                                                                                                                                                              xyz:listVersionID  "1";
                                                                                                                                                                                                              xyz:name           ""
                                                                                                                                                                                                            ]
                                                                                                                                                                                                  ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Beim Bau von Wohnraum sind die Gesamtkosten im Sinn der §§ 5 bis 8 Verordnung über wohnungswirtschaftliche Berechnungen nach dem Zweiten Wohnungsbaugesetz (Zweite Berechnungsverordnung - II. BV) (= Grundstücks- Bau- und Baunebenkosten) förderfähig.</p><p>Beim Erwerb von Wohnraum sind der Kaufpreis sowie die Erwerbskosten; bei einem Zweiterwerb (= gebrauchter Wohnraum) sind darüber hinaus die Kosten von erforderlichen Modernisierungs- und Instandsetzungsmaßnahmen förderfähig.</p>"
                                                                                                                                         ];
                                                                                                             xyz:foerderbereich          [ xyz:foerderbereich  [ xyz:code           "021";
                                                                                                                                                                 xyz:listURI        "urn:xoev-de:stmd:codeliste:foerderbereich";
                                                                                                                                                                 xyz:listVersionID  "1";
                                                                                                                                                                 xyz:name           ""
                                                                                                                                                               ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergebiet           [ xyz:laender  [ xyz:land  [ xyz:code           "BY";
                                                                                                                                                                      xyz:listURI        "urn:xoev-de:pks:codeliste:bundesland";
                                                                                                                                                                      xyz:listVersionID  "1";
                                                                                                                                                                      xyz:name           ""
                                                                                                                                                                    ]
                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergegenstand       [ xyz:beschreibung
                                                                                                                               "<p>Der Staat fördert im Rahmen des Bayerischen Zinsverbilligungsprogramms zur Förderung von Eigenwohnraum&nbsp;das Schaffen oder den Erwerb von Eigenwohnraum.</p>" ];
                                                                                                             xyz:foerdernehmende         [ xyz:beschreibung     "Zuwendungsempfänger sind Privatpersonen.";
