              xyz:payload     [ xyz:json  [ xyz:anfrage            [ xyz:anfragenummer  "966d35cb-4e30-47e1-bee3-abdf2d5ce80b";
                                                                     xyz:flb            [ xyz:konkreteFLB  [ xyz:allgemeineAngaben       [ xyz:allgemeineFragen   [ xyz:email                 "kulturfonds@stmwk.bayerrn.de";
