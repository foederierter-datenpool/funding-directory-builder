                                                                                                                                                                                          rdf:_4  [ xyz:bezeichnung  "Ausgaben- und Finanzierungsplan mit Übersicht über die Personalausgaben" ];
                                                                                                                                                                                          rdf:_5  [ xyz:bezeichnung   "Kostenzusagen aller kommunalen Gebietskörperschaften im Einzugsbereich.";
                                                                                                                                                                                                    xyz:erlaeuterung  "Sollte die Kostenzusagen aller kommunalen Gebietskörperschaften zum Zeitpunkt des Antrags noch nicht möglich sein, ist eine Erklärung mindestens einer kommunalen Gebietskörperschaft im Einzugsbereich ausreichend, mit der sie die Absicht bekundet, sich mit mindestens zehn % an den Gesamtausgaben zu beteiligen."
                                                                                                                                                                                                  ];
