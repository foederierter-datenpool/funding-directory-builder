                                                                                                             xyz:foerdergegenstand       [ xyz:beschreibung
                                                                                                                               "<p>Gefördert werden Wochenendangebote der Eltern- und Familienbildung, die Eltern, Alleinerziehenden, Pflegeeltern und werdenden Eltern durch Seminare, Vorträge oder vergleichbare Veranstaltungen praxisnahe Informationen, Beratung und Unterstützung vermitteln. Für Angebote der Eltern- und Familienbildung am Wochenende,&nbsp;die als Wochenendseminare (Freitag, Samstag, Sonntag) durchgeführt werden, kann unter bestimmten Voraussetzungen eine staatliche Zuwendung gewährt werden.&nbsp;</p>" ];
                                                                                                             xyz:foerdernehmende         [ xyz:beschreibung     "Antragsberechtigt sind Privatpersonen:\n- Mütter, Väter, Alleinerziehende, oder werdende Eltern\n- Pflegeeltern\n- Großeltern (in Ausnahmefällen, z. B. bei Krankheit der Eltern)";
                                                                                                                                           xyz:foerdernehmende  [ xyz:code           "001";
                                                                                                                                                                  xyz:listURI        "urn:xoev-de:stmd:codeliste:foerdernehmende";
                                                                                                                                                                  xyz:listVersionID  "1";
                                                                                                                                                                  xyz:name           ""
                                                                                                                                                                ]
                                                                                                                                         ];
