                                                                                                                                           xyz:rechtsbehelf             "Verwaltungsgerichtliche Klage";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung
                                                                                                                                                             "<p>Für den Vollzug des Projekts sowie das Bewilligungs-, Verwendungsnachweis- und Rückforderungsverfahren ist die Regierung von Niederbayern sachlich zuständig.</p>\n<p>Der Antrag auf Zuwendung ist bei der Regierung von Niederbayern über das zur Verfügung stehende Online-Verfahren einzureichen. Für die beizufügenden Anlagen sind die bereitgestellten Formulare zu verwenden.</p>\n<p>Der Gesamtverwendungsnachweis ist bis zur entsprechenden Ergänzung der Online-Antragstrecke zunächst noch auf herkömmliche Weise einzureichen. Es sind die bereitgestellten Formulare zu verwenden.</p>" ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:finanzierungsartUndHoehe  "<p>Die Zuwendung wird als Projektförderung in der Form einer pauschalierten Anteilfinanzierung gewährt. Die Zuwendung des Freistaates Bayern kann höchstens 90 % der förderfähigen pauschalen Gesamtausgaben betragen. Der Eigenmittelanteil muss mindestens 10 % betragen.&nbsp;</p>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "003";
                                                                                                                                                                                                    xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
                                                                                                                                                                                                    xyz:listVersionID  "1";
                                                                                                                                                                                                    xyz:name           ""
                                                                                                                                                                                                  ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<ul>\n  <li class=\"unordered-list-item--dash\">Kostenposition 1.1: Je nachgewiesener Unterrichtseinheit (= 45 Minuten) für die Durchführung der \"Kurse zur Alphabetisierung für Asylsuchende - Alpha+\" können pauschal Ausgaben in Höhe von 42,23 Euro angesetzt werden (darin enthalten sind auch die die Stunden der Lernstandserhebung bzw. Leistungsfeststellung).</li>\n  <li class=\"unordered-list-item--dash\">Kostenposition 1.2: Je nachgewiesener Unterrichtseinheit (= 45 Minuten) für die sozialpädagogische Betreuung oder allgemeine Hilfestellung für die Teilnehmenden können pauschal Ausgaben in Höhe von 42,23 Euro angesetzt werden.</li>\n  <li class=\"unordered-list-item--dash\">Kostenposition 2: Je nachgewiesener Projektleiterstunden (= 60 Minuten) max. 50 Euro (Pauschale):\n    <ul>\n      <li class=\"unordered-list-item--dash\">für Lehrgänge bis zu 100 UE zusätzlich bis zu 10 Projektleiterstunden,</li>\n      <li class=\"unordered-list-item--dash\">für Lehrgänge bis zu 150 UE zusätzlich bis zu 15 Projektleiterstunden,</li>\n      <li class=\"unordered-list-item--dash\">für Lehrgänge bis zu 200 UE zusätzlich bis zu 20 Projektleiterstunden.</li>\n    </ul>\n  </li>\n  <li class=\"unordered-list-item--dash\">Kostenposition 3: In den Fällen, in denen während des Unterrichts bzw. während der sozialpädagogischen Betreuung oder allgemeinen Hilfestellung eine Kinderbetreuung durchgeführt wird, können pauschal Ausgaben in Höhe von 25 Euro je Unterrichtseinheit (= 45 Minuten) der nachgewiesenen Kinderbetreuung angesetzt werden. Bei nachgewiesener Erforderlichkeit einer zweiten Kinderbetreuungskraft kann die Pauschale verdoppelt werden.</li>\n  <li class=\"unordered-list-item--dash\">Kostenposition 4: Für Ausstattungsgegenstände sowie Lehr- und Lernmaterial können pauschal Ausgaben in Höhe von 5 Euro je nachgewiesener Unterrichtseinheit angesetzt werden.</li>\n  <li class=\"unordered-list-item--dash\">Kostenposition 5: &nbsp;Für die gesamten indirekten Kosten können pauschal 12 Prozent der direkten Kosten (Ausgabenpositionen 1.1, 1.2, 2, 3 und 4) angesetzt werden.</li>\n</ul>"
                                                                                                                                         ];
