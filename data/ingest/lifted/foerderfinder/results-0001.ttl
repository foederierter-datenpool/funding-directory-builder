                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>980da20b-e8db-472f-a408-5682329c1ad7</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-12-17T12:35:28</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>980da20b-e8db-472f-a408-5682329c1ad7</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>980da20b-e8db-472f-a408-5682329c1ad7</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-12-17T12:35:28</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>980da20b-e8db-472f-a408-5682329c1ad7</xflb:foerderschluessel>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400184017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Sonderzuschuss für die Beförderung von Schülerinnen und Schülern mit Schwerbehinderung</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Durch die staatlichen Zuschüsse sollen private Träger unterstützt werden. Finanzhilfen für die Beförderung von schwerbehinderten Schülerinnen und Schülern privater Grund- und Mittelschulen.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Schulaufsichtlich genehmigte private Grundschulen und Mittelschulen können Sonderzuschüsse für die Beförderung von Schülerinnen und Schüler mit nachgewiesener Schwerbehinderung erhalten.</xflb:teaser>\n                  <xflb:schluesselwoerter>Grund- und Mittelschulen, Beförderung, Schwerbehinderung</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Staatsministerium für Unterricht und Kultus</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>2</xflb:hausnummerPostfach>\n                     <xflb:strasse>Salvatorstraße</xflb:strasse>\n                     <xflb:postleitzahl>31333</xflb:postleitzahl>\n                     <xflb:ort>München</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Finanzhilfen für die Beförderung von schwerbehinderten Schülerinnen und Schülern privater Grund- und Mittelschulen</xflb:bezeichnung>\n                     <xflb:link>https://www.bayernportal.de/dokumente/leistung/702737275873?localize=false</xflb:link>\n                  </xflb:verweis>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Zuständig ist die entsprechend dem Sitz der privaten Grund- oder Mittelschule örtlich zuständige Regierung</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:onlinedienste>\n                  <xflb:onlinedienst>\n                     <xflb:id>f849e5e4-69e2-404c-bfc4-f43983283f11</xflb:id>\n                     <xflb:bezeichnung>Sonderzuschuss für die Beförderung von Schülerinnen und Schülern mit Schwerbehinderung beantragen</xflb:bezeichnung>\n                     <xflb:link>https://foerderung.bayern.de/landingpage/bdd87fd4-4991-4e8e-9edb-fc35102f3766</xflb:link>\n                     <xflb:beschreibung>Sie können die Förderung über die Fördermanagementplattform Bayern (FMP) digital beantragen.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n               </xflb:onlinedienste>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>003</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Antragsberechtigt sind Schulträger privater Grund- und Mittelschulen.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>003</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Förderung erfolgt in Form eines direkten &lt;strong&gt;Zuschusses&lt;/strong&gt; des Freistaats Bayern an die Schulträger.&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Finanzierungshöhe:&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Schulträger können bei einer &lt;strong&gt;nachgewiesenen Schwerbehinderung&lt;/strong&gt; (Merkzeichen \"G\", \"aG\", \"H\", \"Bl\") und einem speziellen Beförderungsbedarf Zuschüsse für die Schülerbeförderung beantragen, sofern diese Kosten niedriger ausfallen als alternative Beförderungsoptionen.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Die Laufzeit der Zuwendung bezieht sich auf die Zeit des Schulbesuchs.&amp;nbsp;&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerFest>\n                        <xflb:jahre>1</xflb:jahre>\n                     </xflb:dauerFest>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Unterricht und Kultus</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 32 Abs. 1 Satz 5 Bayerisches Schulfinanzierungsgesetz (BaySchFG)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BaySchFG-32</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>IV.4</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Beförderung von Schülerinnen und Schüler mit Schwerbehinderung</xflb:programmtitel>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2024-11-30</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2030-11-30</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:verlaengerungsoption>ja</xflb:verlaengerungsoption>\n               </xflb:programmlaufzeit>\n               <xflb:kummulierbareFoerderungen>\n                  <xflb:beschreibungAusschluss>&lt;p&gt;Schulen mit weniger als &lt;strong&gt;14 Schülerinnen und Schülern&lt;/strong&gt; erhalten keinen Zuschuss.&lt;/p&gt;</xflb:beschreibungAusschluss>\n                  <xflb:voraussetzungen>&lt;p&gt;Wird im Einzelfall durch die örtlich zuständige Regierung im Rahmen der Antragsbearbeitung geprüft.&lt;/p&gt;</xflb:voraussetzungen>\n               </xflb:kummulierbareFoerderungen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Privaten Grundschulen und Mittelschulen, die von einer juristischen Person des öffentlichen oder privaten Rechts betrieben werden und auf gemeinnütziger Grundlage wirken, werden Sonderzuschüsse für die Beförderung von Schülerinnen und Schülern mit schwerwiegenden Beeinträchtigungen gewährt.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Dem Träger einer privaten Grund- oder Mittelschule im Freistaat Bayern kann auf Grundlage des Art. 32 Abs. 1 Satz 5 Bayerisches Schulfinanzierungsgesetz (BaySchFG) nach Maßgabe des Staatshaushalts ausnahmsweise ein Zuschuss für die Beförderung einer Schülerin oder eines Schülers gewährt werden, wenn&lt;/p&gt;&lt;ol&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;auf Grund einer durch einen Schwerbehindertenausweis mit dem Merkzeichen \"G\", \"aG\", \"H\" oder \"Bl\" nachgewiesenen Schwerbehinderung die Beförderung mit einem speziellen Kraftfahrzeug auf dem Schulweg zwingend erforderlich ist und&lt;/li&gt;&lt;li class=\"ordered-list-item--numbered\"&gt;die damit verbundenen Kosten für den Staat niedriger als bei einer notwendigen Schülerbeförderung zu einer anderen geeigneten Schule sind.&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;Es gilt eine zweijährige Karenzzeit.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>002</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>022</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Voraussetzungen sind unter anderem:&amp;nbsp;&lt;/p&gt;\n&lt;ul&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Beförderung einer Schülerin oder eines Schülers, wenn auf Grund einer durch einen Schwerbehindertenausweis mit dem Merkzeichen \"G\", \"aG\", \"H\" oder \"Bl\" nachgewiesenen Schwerbehinderung die Beförderung mit einem speziellen Kraftfahrzeug auf dem Schulweg zwischend erforderlich ist&amp;nbsp;&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Nachweis der Gemeinnützigkeit des Schulträgers (Art. 29 Abs. 2 BaySchFG)&amp;nbsp;&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Vorliegen einer schulaufsichtlichen Genehmigung der Schule nach Art. 92 ff. BayEUG&amp;nbsp;&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Leistungen werden erst gewährt, wenn die Schule mindestens zwei Jahre ohne wesentliche schulaufsichtliche Beanstandungen bestanden hat.&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Schulen mit weniger als 14 Schülerinnen und Schüler erhalten keinen Zuschuss.&lt;/li&gt;\n&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:rechtlicheBeschreibung>&lt;p&gt;Finanzhilfen für die Beförderung von schwerbehinderten Schülerinnen und Schülern privater Grund- und Mittelschulen für die Dauer des Schulbesuchs.&lt;/p&gt;</xflb:rechtlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Schulen mit weniger als 14 Schülerinnen und Schülern erhalten keinen Zuschuss.&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://foerderung.bayern.de/landingpage/bdd87fd4-4991-4e8e-9edb-fc35102f3766</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Der Sonderzuschuss für die Beförderung von Schülerinnen und Schüler mit schwerwiegenden Beeinträchtigungen kann formlos bei der zuständigen Regierung beantragt werden. Maßgeblich für die örtliche Zuständigkeit ist der jeweilige Sitz der Schule. Der Antrag ist mit sämtlichen benötigten Unterlagen schriftlich bei der entsprechend dem Sitz der privaten Grund- oder Mittelschule örtlich zuständigen Regierung einzureichen. Nach Prüfung entscheidet die Regierung über die Bewilligung des Zuschusses.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>001</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:monate>1</xflb:monate>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>6</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristFest>\n                        <xflb:jahre>1</xflb:jahre>\n                     </xflb:fristFest>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Laufzeit für die Dauer des Schulbesuchs</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Antragsformulare</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Erhältlich bei der zuständigen Regierung</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;gesetzlich&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_142  [ xyz:attributes  [ xyz:antragsstellung      "https://www.bayern-innovativ.de/de/seite/foerderprogramm-zum-aufbau-einer-wasserstofftankstelleninfrastruktur-in-bayern";
                                xyz:beschreibung         "Ziel der Förderung ist der Aufbau einer öffentlichen und betriebsinternen Infrastruktur zur Treibstoffversorgung mit Wasserstoff in allen Teilen Bayerns. Im Fokus der bayerischen Förderung steht die Infrastruktur für wasserstoffbetriebene Nutzfahrzeuge und Kraftomnibusse sowie Sonderfahrzeuge in der Logistik in Bayern, da hier die größten Potentiale gesehen werden. Damit wird im Einklang mit der Bayerischen Wasserstoffstrategie der Aufbau einer Basis-Wasserstoffbetankungsinfrastruktur in Bayern angestrebt. Dadurch soll insbesondere auch ein Anreiz für die Investition in die Tankstelleninfrastruktur durch Omnibus/Logistikunternehmen oder Stadtwerke und die Markteinführung von umweltfreundlichen und wettbewerbsfähigen wasserstoffbetriebenen Nutzfahrzeugen und Bussen geschaffen werden. Zugleich wird mit der Förderung ein Beitrag zur Reduktion der energiebedingten CO2-Emissionen und zum Klimaschutz im Energie- und Verkehrssektor geleistet sowie neue Arbeitsplätze in Bayern geschaffen.";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Energieeffizienz und Erneuerbare Energien" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Großunternehmen";
                                                           rdf:_2  "Kleine und mittlere Unternehmen";
                                                           rdf:_3  "Privatpersonen"
                                                         ];
                                xyz:foerderzeitraum.bis  "2024-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2020-10-01T00:00:00.000+00:00";
                                xyz:schluessel           "98444b21-50f6-471e-82d0-bf21842e8eb2";
                                xyz:teaser               "Förderung von öffentlichen Wasserstofftankstellen";
                                xyz:titel                "Öffentliche Wasserstofftankstellen";
                                xyz:titel.tokens         [ rdf:_1  "Öffentliche Wasserstofftankstellen" ];
                                xyz:voraussetzung        "Antragsberechtigt sind juristische Personen des öffentlichen und des Privatrechts sowie natürliche Personen, soweit sie wirtschaftlich tätig sind und zum Zeitpunkt der Auszahlung ihren Sitz, Niederlassung oder eine Betriebsstätte im Freistaat Bayern haben."
                              ];
