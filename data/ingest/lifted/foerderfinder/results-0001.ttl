                                                                     xyz:nachrichtennummer     "afcaadf5-1066-4102-a005-312da86c1e11";
                                                                     xyz:sender                "Förderfinder Suche (Bayern)"
                                                                   ];
                                            xyz:produkt            "Förderfinder";
                                            xyz:produkthersteller  "StMD Bayern";
                                            xyz:produktversion     "";
                                            xyz:schemaLocation     "http://xoev.de/schemata/xflb/2_0_0 xflb.xsd";
                                            xyz:standard           "XFLB";
