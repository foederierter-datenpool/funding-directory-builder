                                                                                                                                                                                          rdf:_5  [ xyz:bezeichnung  "Kostenzusagen aller kommunalen Gebietskörperschaften im Einzugsbereich (bei Erstantrag)" ];
                                                                                                                                                                                          rdf:_6  [ xyz:bezeichnung  "Bei Sachkostenförderung: ggf. Übersicht über d. Personalausgaben für d. Aufgabenbereiche Prävention, Geschäftsführung/Leitung u. Verwaltung; alt. Übersicht über d. Sachausgaben für Honorarkräfte u. externe Dienstleister" ];
                                                                                                                                                                                          rdf:_7  [ xyz:bezeichnung  "Kostenzusagen aller kommunalen Gebietskörperschaften im Einzugsbereich (bei Erstantrag). Falls zum Antragszeitpunkt noch nicht möglich, genügt eine Erklärung einer kommunalen Gebietskörperschaft im Einzugsbereich, mit Absichtsbekundung für die Beteiligung an den Gesamtausgaben. Spätestens zum Erlass des Bewilligungsbescheides müssen alle Kostenzusagen vorliegen." ]
                                                                                                                                                                                        ]
                                                                                                                                                                        ];
                                                                                                                                           xyz:linkZurAntragsstellung   "https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/rmf-zz/13/rmf_13-041-zz/index";
                                                                                                                                           xyz:rechtsbehelf             "<p>keine Angabe</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung
                                                                                                                                                             "Der schriftliche Antrag ist bei der Regierung von Mittelfranken einzureichen.\n\nDie erstmalige Aufnahme in die staatliche Förderung beantragt der Träger der\nFachberatungsstelle unter Vorlage der Stellungnahmen der mitfinanzierenden\nkommunalen Gebietskörperschaften zum Bedarf bei der Bewilligungsbehörde. Diese\nleitet die Antragsunterlagen dem Staatsministerium für Familie, Arbeit und\nSoziales zu. Dieses entscheidet über die grundsätzliche Aufnahme des Trägers\nin die staatliche Förderung.\n\nDer Antrag ist schriftlich unter Verwendung der bei der Regierung von\nMittelfranken (Bewilligungsbehörde) erhältlichen Vordrucke bis zum 1. Dezember\ndes Jahres vor Beginn des Bewilligungszeitraumes dort einzureichen." ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:finanzierungsartUndHoehe  "<p>Die staatliche Zuwendung wird im Rahmen einer Projektförderung als Festbetragsfinanzierung gewährt.&nbsp;</p><ul><li class=\"unordered-list-item--dash\">Die Höhe der Zuwendung setzt sich aus folgenden jährlichen Beträgen zusammen: Fachpersonal für Frauen, Kinder und Jugendliche: bis zu 34.120 € pro Vollzeitstelle&nbsp;</li><li class=\"unordered-list-item--dash\">Personal für Prävention, Leitung/Geschäftsführung und Verwaltung: bis zu 22.041 € pro Fachberatungsstelle pro Vollzeitstelle.&nbsp;</li></ul><p>Als Vollzeitstelle gilt eine Stelle mit der regelmäßigen Wochenarbeitszeit nach dem jeweils geltenden Tarifvertrag des Zuwendungsempfängers, sofern diese zwischen 38,5 und 40,1 Wochenstunden liegt. In allen anderen Fällen ist eine Wochenstundenzahl von 40,1 zugrunde zu legen. Bei einer nicht das ganze Jahr durchgehend beschäftigten oder einer teilzeitbeschäftigten Fachkraft wird der Personalausgabenzuschuss anteilig gewährt. Die Zuwendung beträgt bei der Sachkostenförderung maximal 2.542 Euro jährlich. Dabei sind im Rahmen von Fortbildungsmaßnahmen oder Supervision Honorarkosten von maximal 80 Euro je Stunde zuwendungsfähig. Für auswärtige Fortbildungsmaßnahmen sind bis zu 40 Euro pro Tag und Person für Verpflegung und Unterkunft zuwendungsfähig. Die Aufgabenbereiche Prävention, Geschäftsführung/Leitung und Verwaltung können in jedem Fall mit max. 22.041 € jährlich pro Fachberatungsstelle gefördert werden.</p>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "001";
