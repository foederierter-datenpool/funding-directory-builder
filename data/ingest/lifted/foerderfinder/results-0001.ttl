                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>3b54aae1-9ba1-4fe5-b603-f5ef77ed4055</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-09-27T07:34:56</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>3b54aae1-9ba1-4fe5-b603-f5ef77ed4055</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>3b54aae1-9ba1-4fe5-b603-f5ef77ed4055</xflb:schluessel>\n         <xflb:versionFLB>4</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-09-27T07:34:56</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>3b54aae1-9ba1-4fe5-b603-f5ef77ed4055</xflb:foerderschluessel>\n                  <xflb:flbVersion>4</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>09000000144426</xflb:leikaSchluessel>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Förderung von Pflegestützpunkte zur wohnortnahen Pflegeberatung und Koordination von möglichen Unterstützungsangeboten</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Durch Pflegestützpunkte sollen Menschen zu allen Fragen im Vor- und Umfeld der Pflege beraten und die für sie in Betracht kommenden Hilfs- und Unterstützungsangebote koordiniert werden, um eine wohnortnahe und möglichst abgestimmte Versorgung und Betreuung zu erhalten.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Um die Strukturen vor Ort zu stärken, unterstützt das Bayerische Staatsministerium für Gesundheit, Pflege und Prävention Kommunen (Landkreise, kreisfreie Städte, Bezirke) als Träger von Pflegestützpunkten mit einer Regelförderung für den Betrieb laufender Pflegestützpunkte.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Zweck der Förderung ist es, ein auf Dauer angelegtes und landesweites Beratungsangebot für Menschen mit Pflegebedarf sicherzustellen.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern gewährt Zuwendungen für Pflegestützpunkte</xflb:teaser>\n                  <xflb:schluesselwoerter>Pflegeberatung, Betreuung, Hilfsangebote für Pflege, Unterstützungsangebote für Pflege</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:alternativeFoerdermoeglichkeiten>\n                  <xflb:alternativeFoerdermoeglichkeit>\n                     <xflb:beschreibung>Fachstellen für pflegende Angehörige beraten und unterstützen vor allem psychosozial pflegende Angehörige von älteren pflegebedürftigen Menschen. Deren Träger können eine Zuwendung im Rahmen einer Projektförderung erhalten.</xflb:beschreibung>\n                     <xflb:verweis>\n                        <xflb:bezeichnung>Angehörigenarbeit; Beantragung einer Förderung</xflb:bezeichnung>\n                        <xflb:link>https://www.bayernportal.de/dokumente/leistung/251409201760</xflb:link>\n                     </xflb:verweis>\n                  </xflb:alternativeFoerdermoeglichkeit>\n               </xflb:alternativeFoerdermoeglichkeiten>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Pflegestützpunkte</xflb:bezeichnung>\n                     <xflb:link>https://www.stmgp.bayern.de/pflege/pflege-zu-hause/pflegestuetzpunkte/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderung von Pflegestützpunkten</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/foerderung-von-pflegestuetzpunkten/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Fachstelle für Demenz und Pflege Bayern</xflb:bezeichnung>\n                     <xflb:link>https://www.demenz-pflege-bayern.de/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Kontaktdaten der regionalen Fachstellen für Demenz und Pflege</xflb:bezeichnung>\n                     <xflb:link>https://www.demenz-pflege-bayern.de/ueber-uns/regionale-fachstellen/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Bayerisches Netzwerk Pflege\" - Förderung der Familienpflege, Angehörigenarbeit / Fachstellen für pflegende Angehörige und Pflegestützpunkte</xflb:bezeichnung>\n                     <xflb:link>https://www.stmgp.bayern.de/service/foerderprogramme/foerderprogramm-bayerisches-netzwerk-pflege-und-richtlinie-netzwerk-pflege-familienpflegefachstellen-pflegende-angehoerige/#Fachstellen-fuer-pflegende-Angehoerige</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Landesamt für Pflege</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>4</xflb:hausnummerPostfach>\n                     <xflb:strasse>Mildred-Scheel-Straße</xflb:strasse>\n                     <xflb:postleitzahl>92224</xflb:postleitzahl>\n                     <xflb:ort>Amberg</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>poststelle@lfp.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Webseite der zuständigen Stelle</xflb:bezeichnung>\n                     <xflb:link>www.lfp.bayern.de</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>+49 9621 9669-0</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Bayerisches Landesamt für Pflege</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>4</xflb:hausnummerPostfach>\n                           <xflb:strasse>Mildred-Scheel-Straße</xflb:strasse>\n                           <xflb:postleitzahl>92224</xflb:postleitzahl>\n                           <xflb:ort>Amberg</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>poststelle@lfp.bayern.de</xflb:email>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Webseite der zuständigen Stelle</xflb:bezeichnung>\n                           <xflb:link>www.lfp.bayern.de</xflb:link>\n                        </xflb:verweis>\n                        <xflb:telefonnummer>+49 9621 9669-0</xflb:telefonnummer>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>38bab6c7-0597-4de3-93d3-b73427e6e464</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Bewilligung einer staatlichen Zuwendung von Pflegestützpunkten nach der Richtlinie für die Förderung im Bayerischen Netzwerk Pflege</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/wp-content/uploads/2022/12/Antragsformblatt_Pflegestuetzpunkte_Regelfoerderung_BFP.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>ebd28f9b-613f-4b1c-adce-5aa49d919862</xflb:id>\n                     <xflb:bezeichnung>Kosten- und Finanzierungsplan</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/wp-content/uploads/2022/12/Anlage_KFP_Regelfoerderung.xlsx</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>8e249c78-c758-4322-8163-0dcc247793ae</xflb:id>\n                     <xflb:bezeichnung>Erklärung zum Antrag auf Gewährung einer Förderung als DAWI-De-minimis-Beihilfe nach der Verordnung 2023/2832</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/wp-content/uploads/2024/01/DAWI-De-minimis-Erklaerung.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>1dc286c5-260e-4e55-ba57-735e7c6f9594</xflb:id>\n                     <xflb:bezeichnung>Subventionserhebliche Tatsachen im Rahmen des Zuwendungsverfahrens zur Förderung von Pflegestützpunkten; Erklärung</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/wp-content/uploads/2023/03/240821_Erklaerung-Subventionserhebliche-Tatsachen.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>4acda3cc-2200-4590-b7f7-a715d896152f</xflb:id>\n                     <xflb:bezeichnung>Konzeption und Bescheinigung über die Anbindung an einen Pflegestützpunkt nach Nr. 2.5.2 Satz 2 bzw. an eine Fachstelle für pflegende Angehörige nach 3.5.2 Satz 2 der Richtlinie für die Förderung im Bayerischen Netzwerk Pflege sowie nach Nr. 1.5.1.5 Satz 1 der Grundsätze zur Förderung von Pflegestützpunkten</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/wp-content/uploads/2022/12/Bescheinigung_Konzeption-raeumliche-Anbindung_PSP-FfpA.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>ebe14cf9-8dce-454f-b169-aebaf55eb9ea</xflb:id>\n                     <xflb:bezeichnung>Verwendungsnachweis für Pflegestützpunkte nach der Richtlinie für die Förderung im Bayerischen Netzwerk Pflege</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/wp-content/uploads/2023/03/230302_Verwendungsnachweis_Stand-13.03.2023_.pdf</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Antragsberechtigt sind Kommunen, die sich an der Trägerschaft eines Pflegestützpunktes beteiligen.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Förderpauschale beträgt für eine vollzeitbeschäftigte Fachkraft jährlich bis zu 20.000 EUR. Berücksichtigungsfähig ist nur der kommunale Anteil, maximal im Umfang einer Vollzeitstelle.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bei einer räumlichen Anbindung an eine Fachstelle für pflegende Angehörige, die durch eine Bescheinigung der Fachstelle für pflegende Angehörige nachzuweisen ist, erhöht sich die Förderpauschale für insgesamt maximal drei Jahre um jährlich bis zu 3.000 EUR.&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Die Zuwendung wird als Festbetragsfinanzierung im Rahmen einer Projektförderung gewährt.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Zuwendungsfähig sind Personalausgaben, die der Kommune aufgrund der Beteiligung an der Trägerschaft des Pflegestützpunktes entstehen.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:euBeihilferelevanz>Die Prüfung der Freistellung der Fördermaßnahme von der Anmeldepflicht bei der EU-Kommission erfolgt im Rahmen der Antragsbearbeitung durch die Bewilligungsbehörde.</xflb:euBeihilferelevanz>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Gesundheit, Pflege und Prävention</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinie für die Förderung im Bayerischen Netzwerk Pflege</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVwV294809-NN3</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>-§ 7c Sozialgesetzbuch (SGB) - Elftes Buch (XI)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-im-internet.de/sgb_11/__7c.html</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat 42</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Pflegestützpunkte; Beantragung einer Zuwendung</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2028-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2025-07-31</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2028-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert werden Pflegestützpunkte. Aufgabe der Pflegestützpunkte ist es, Information und Beratung zu allen Fragen im Vor- und Umfeld der Pflege sowie deren Vernetzung unter einem Dach zu bündeln. Dies beinhaltet insbesondere:&lt;/p&gt;&lt;p&gt;Örtliche Anlaufstelle für Rat- und Hilfesuchende&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Informationen zu möglichen Sozialleistungen und weiteren Hilfsangeboten&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Kostenlose und neutrale Beratung in sämtlichen pflegerischen Belangen&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Vernetzung und Koordination&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Regionale Vernetzung mit allen relevanten Akteuren&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Koordination von wohnortnahen Hilfs- und Unterstützungsangeboten&lt;/li&gt;&lt;/ul&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>004</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Voraussetzung für die Förderung eines Pflegestützpunkts ist, dass&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;eine von der Kommune (anteilig) finanzierte Fachkraft mit mindestens 50 v. H. der tarifvertraglichen Arbeitszeit einer Vollzeitkraft des Trägers im Pflegestützpunkt tätig ist und&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;eine Zusammenarbeit vor allem mit den Trägern in der Betreuung, Unterstützung und Pflege von Menschen mit Pflegebedarf sowie den Beratungsstellen (insbesondere den Fachstellen für pflegende Angehörige) sowie mit den in Betracht kommenden Behörden und Stellen in der jeweiligen Region erfolgt.&lt;/li&gt;&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.lfp.bayern.de/wp-content/uploads/2022/12/Antragsformblatt_Pflegestuetzpunkte_Regelfoerderung_BFP.pdf</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Der Antrag auf Förderung ist schriftlich oder elektronisch beim Bayerischen Landesamt für Pflege zu stellen. Die bereitgestellten Vordrucke sind zu verwenden.&lt;/p&gt;</xflb:bewilligung>\n               </xflb:verfahrensablauf>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristJaehrlich>31.12.</xflb:fristJaehrlich>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Die Antragstellung muss bis zum 31.12. des dem Förderjahr vorangehenden Jahres erfolgt sein.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Antrag über die Errichtung eines Pflegestützpunktes gem. Anlage 1 des Rahmenvertrags zur Arbeit und zur Finanzierung der Pflegestützpunkte nach § 7c Abs. 6 Sozialgesetzbuch (SGB) - Elftes Buch (XI) in Bayern</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Vertrag über die Errichtung eines Pflegestützpunktes (Stützpunktvertrag) gem. Anlage 2 des Rahmenvertrags</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Konzept mit ausführlicher Beschreibung der Maßnahme für den Förderzeitraum</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Weitere Informationen für eine Antragstellung finden Sie auf der Homepage des Bayerischen Landesamtes für Pflege</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Gegen den Zuwendungsbescheid können Sie innerhalb eines Monats nach seiner Bekanntgabe Klage erheben. Das zuständige Gericht, bei dem Sie Klage einreichen können, wird Ihnen im Bescheid mitgeteilt.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
