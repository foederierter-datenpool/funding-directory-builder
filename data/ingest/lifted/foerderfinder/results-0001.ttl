                                                                                                                                                      ];
                                                                                                                       xyz:programmtitel              "Kulturfonds Bayern - Kunst";
                                                                                                                       xyz:verantwortlichesFachreferat
                                                                                                                               "Referat K.6";
                                                                                                                       xyz:verantwortlichesMinisterium
                                                                                                                               "Staatsministerium für Wissenschaft und Kunst"
                                                                                                                     ];
                                                                                                             xyz:foerdervoraussetzungen  [ xyz:ausschlusskriterien  "<p>Vorhaben, mit denen bereits begonnen worden ist. Vorhaben mit (zuwendungsfähigen) Gesamtkosten unter 10.000 €.<br> Vorhaben, die bereits aus anderen Mitteln des Freistaats Bayern gefördert werden (Verbot der Doppelförderung). Multifunktionale Räumlichkeiten bzw. Räumlichkeiten von Musikschulen oder Musikinstituten oder für Kirchenchöre.</p>";
                                                                                                                                           xyz:buergerfreundlicheBeschreibung
                                                                                                                                                   "<p>Aus dem Kulturfonds, **Bereich Kunst** , können Investitionen beim Bau, Um- und Ausbau von Proberäumen für Laienmusikvereine gefördert werden, aber keine laufenden Betriebskosten. Maßnahmen mit zuwendungsfähigen Gesamtkosten von weniger als 10.000 € können nicht gefördert werden. Das Fördergebiet umfasst ganz Bayern; grundsätzlich ausgeschlossen sind allerdings Vorhaben in München und Nürnberg. Eine gleichzeitige Förderung aus anderen staatlichen Förderansätzen (Mehrfachförderung) ist grundsätzlich ausgeschlossen. Die Förderung erfolgt nach Maßgabe der zur Verfügung stehenden Haushaltsmittel. Die Förderung ist grundsätzlich auf maximal 20 bis 25 v. H. der zuwendungsfähigen Kosten bzw. höchstens 50.000 € begrenzt. Zuwendungen dürfen nur bewilligt werden, wenn mit dem Projekt noch nicht begonnen wurde.</p>"
                                                                                                                                         ];
