                                                                                                                                           xyz:beschreibung       [ xyz:schluesselwoerter  "Studentenwohnheime, Studentenbude, Studentenwohnraumförderung, Wohnheime für Studierende, Studierende, Wohnraumförderung, Studenten";
                                                                                                                                                                    xyz:teaser             "Der Staat fördert die Schaffung und Erhaltung von Wohnraum für Studierende mit Mitteln aus öffentlichen Haushalten.";
                                                                                                                                                                    xyz:zuwendungszweck    "<p>Zweck der Zuwendung ist die Schaffung und die Erhaltung von Wohnraum für Studierende an staatlichen und staatlich anerkannten Hochschulen.</p>"
                                                                                                                                                                  ];
