                                                                                                             xyz:antragsinformationen    [ xyz:beantragungskosten      [ xyz:kostenlos
                                                                                                                                                             "ja" ];
                                                                                                                                           xyz:linkZurAntragsstellung  "https://www.stmb.bayern.de/assets/stmi/buw/bauthemen/gebaeude_energie/auszahlungsantrag_zu_bayfholz.pdf";
                                                                                                                                           xyz:rechtsbehelf            "<p>Verwaltungsgerichtliche Klage</p>";
                                                                                                                                           xyz:verfahrensablauf        [ xyz:bewilligung
                                                                                                                                                             "<p>Eine Antragstellung für neue Vorhaben ist nicht mehr möglich.&nbsp;</p><p>Die zweckentsprechende Verwendung der Mittel ist durch einen einfachen Verwendungsnachweis innerhalb von drei Monaten nach Abschluss der Maßnahme vorzulegen.</p><p>Dem Verwendungsnachweis ist eine Aufstellung über alle verbauten Produkte aus Holz beziehungsweise aus nachwachsenden Rohstoffen vorzulegen. Diesem sind insbesondere das \"CO2-Tool\" über die Art und Menge der tatsächlich verbauten Hölzer, Holzwerkstoffe und nachwachsenden Rohstoffe beizufügen.</p>" ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:euBeihilferelevanz        "De-minimis Beihilfe";
                                                                                                                                           xyz:finanzierungsartUndHoehe  "<p>Die Zuwendung erfolgt als Zuschuss ohne Rechtsanspruch und im Rahmen der verfügbaren Haushaltsmittel. Die Zuwendungshöhe beträgt 500 Euro je Tonne gespeichertem CO2.</p>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "001";
                                                                                                                                                                                                    xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
                                                                                                                                                                                                    xyz:listVersionID  "1";
                                                                                                                                                                                                    xyz:name           ""
                                                                                                                                                                                                  ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Die Zuwendung wird als Zuschuss gewährt und erfolgt im Rahmen der Festbetragsfinanzierung als Pauschale in Abhängigkeit der in den Holzbauelementen und Dämmstoffen gebundenen Kohlenstoffmenge. Die Zuwendungshöhe beträgt 500 Euro je Tonne (t) gespeichertem CO<sub>2</sub>. </p><p>Beträge unter 25 000 Euro pro Baumaßnahme werden nicht gefördert (Bagatellgrenze). Die maximale Gesamtzuwendung beläuft sich auf 200 000 Euro je Baumaßnahme (Förderhöchstgrenze).</p>"
                                                                                                                                         ];
                                                                                                             xyz:foerderbereich          [ xyz:foerderbereich  [ xyz:code           "021";
                                                                                                                                                                 xyz:listURI        "urn:xoev-de:stmd:codeliste:foerderbereich";
                                                                                                                                                                 xyz:listVersionID  "1";
                                                                                                                                                                 xyz:name           ""
                                                                                                                                                               ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergebiet           [ xyz:laender  [ xyz:land  [ xyz:code           "BY";
                                                                                                                                                                      xyz:listURI        "urn:xoev-de:pks:codeliste:bundesland";
                                                                                                                                                                      xyz:listVersionID  "1";
                                                                                                                                                                      xyz:name           ""
                                                                                                                                                                    ]
                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergegenstand       [ xyz:beschreibung
                                                                                                                               "<p>Förderfähig ist die gespeicherte Kohlenstoffmenge im Rahmen folgender Baumaßnahmen im Freistaat Bayern:</p><ul><li class=\"unordered-list-item--dash\">Neubau, Erweiterung und Aufstockung von Gebäuden für Zwecke kommunaler Gebietskörperschaften in Holzbauweise (Gebäude für öffentliche Zwecke wie Verwaltungsgebäude, Gebäude für die soziale Infrastruktur wie z.B. Pflegeheime, Behindertenheime, Schulen und Kindertagesstätten)</li><li class=\"unordered-list-item--dash\">Neubau, Erweiterung und Aufstockung von mehrgeschossigen Wohngebäuden in Holzbauweise&nbsp;</li></ul><p>Der Neubau und die Erweiterung ist dabei mit einer Bruttogrundfläche von mindestens 300 m2 und die Aufstockung mit einer Bruttogrundfläche von mindestens 100 m2 zu planen.</p>" ];
                                                                                                             xyz:foerdernehmende         [ xyz:beschreibung     "Antragsberechtigt sind kommunale Gebietskörperschaften, auch in kommunaler Zusammenarbeit in Form von Zweckvereinbarungen und  Zweckverbänden sowie natürliche Personen und juristische Personen des  öffentlichen und privaten Rechts sowie Gesellschaften und andere  Personenvereinigungen des privaten Rechts für Maßnahmen nach Nr. 2.2 der Richtlinien sowie für Pflegeheime, Behindertenheime, Schulen und  Kindertagesstätten.";
