                                                         ];
                                xyz:foerderprogramm      "Bayerische Förderrichtlinie Holz - BayFHolz";
                                xyz:foerderzeitraum.bis  "2026-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2024-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "721b6acb-8ec6-4fc9-b3f8-8412bd0d5b9d";
                                xyz:teaser               "Mit der BayFHolz unterstützt der Freistaat Bauvorhaben in Holzbauweise zur Förderung von langfristig gebundenem Kohlenstoff in Gebäuden. Die Richtlinie läuft bis 31. Dezember 2026. Eine Antragstellung ist nicht mehr möglich.";
                                xyz:titel                "Holzbauförderprogramm";
                                xyz:titel.tokens         [ rdf:_1  "Holzbauförderprogramm" ];
                                xyz:voraussetzung        "<ul><li class=\"unordered-list-item--dash\">Holzbauweise im Sinn der Richtlinie ist die Verwendung von Holz in wesentlichen Konstruktionselementen von Gebäuden. Hierzu muss mindestens die Gebäudehülle (Außenwand) in Holzbauweise umgesetzt sein sowie zwei weitere wesentliche Bauteile in Holzbauweise umgesetzt sein, wie insbesondere: die hölzerne Dachkonstruktion, Deckenkonstruktionen aus Holz beziehungsweise Holz-Verbund-Strukturen, Innenwände in Holzbauweise, Treppen (Gesamtkonstruktion), Balkone (Gesamtkonstruktion).</li><li class=\"unordered-list-item--dash\">Für den Einsatz nachwachsender, kohlenstoffspeichernder Baustoffe muss ein Nachweis erbracht werden. Dieser erfolgt über das Berechnungstool CO2-Tool mit dem die verbaute Menge an nachwachsenden Rohstoffen und die damit verbundene Speichermenge an CO2 ermittelt wird.</li><li class=\"unordered-list-item--dash\">Die förderfähigen Baustoffe müssen dem aktuellen Stand der Technik entsprechen, Marktreife besitzen und für die jeweilige Baumaßnahme und die zur Anwendung kommende Bauweise geeignet sein. Zudem ist eine Verwendung von Rohstoffen aus nachhaltiger Produktion bzw. Bewirtschaftung Voraussetzung.</li></ul>"
                              ];
              xyz:id          "721b6acb-8ec6-4fc9-b3f8-8412bd0d5b9d";
              xyz:payload     [ xyz:json  [ xyz:anfrage            [ xyz:anfragenummer  "721b6acb-8ec6-4fc9-b3f8-8412bd0d5b9d";
                                                                     xyz:flb            [ xyz:konkreteFLB  [ xyz:allgemeineAngaben       [ xyz:beschreibung       [ xyz:schluesselwoerter  "BayFHolz, Holzbauförderprogramm, Klimaplus, Holzbau, Holzbauförderung, Holz, Holzbauzuschuss, Klimazuschuss";
                                                                                                                                                                    xyz:teaser             "Mit der BayFHolz unterstützt der Freistaat Bauvorhaben in Holzbauweise zur Förderung von langfristig gebundenem Kohlenstoff in Gebäuden. Die Richtlinie läuft bis 31. Dezember 2026. Eine Antragstellung ist nicht mehr möglich.";
                                                                                                                                                                    xyz:zuwendungszweck    "<p>Ziel der Förderung ist es, durch eine vermehrte Verwendung von Bauelementen aus Holz und anderen nachwachsenden Rohstoffen endliche Ressourcen zu schonen und mit der Speicherung von CO2 einen wesentlichen Beitrag zum Klimaschutz im Bausektor zu leisten.</p>"
                                                                                                                                                                  ];
