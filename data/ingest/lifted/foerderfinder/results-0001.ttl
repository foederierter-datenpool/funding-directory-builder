                                                                                                                                         ];
                                                                                                             xyz:foerdergegenstand       [ xyz:beschreibung
                                                                                                                               "<p>Gegenstand der Förderung sind Finanzierung notwendiger Anschaffungen (Möbel, Bekleidung, Schulmaterial), Vermeidung von Obdachlosigkeit (Mietkaution, Maklergebühr, erste Monatsmiete), Minderung von Schuldenverpflichtungen (unter besonderen Voraussetzungen) sowie Deckung sonstigen Bedarfs nach Absprache.</p>" ];
                                                                                                             xyz:foerdernehmende         [ xyz:beschreibung     "Zuwendungsempfänger sind vorrangig:\n\n- Familien nach Mehrlingsgeburt ab Drillingen,\n- Familien nach der Geburt des sechsten oder eines weiteren Kindes,\n- Familien mit drei oder mehr Kindern in Not,\n- alleinerziehende Elternteile in Not mit mindestens einem Kind.";
