                                xyz:beschreibung         "<p>Zweck der Zuwendung ist die Umsetzung kommunaler Maßnahmen zur <strong>systematischen Verringerung von Treibhausgasemissionen</strong>.<br>Gefördert werden ausschließlich der <strong>Austausch CO2-intensiver Anlageteile</strong> sowie<br>die <strong>LED-Sanierung von Innen- und Hallenbeleuchtungen</strong>.<br>Die Maßnahmen sollen zu <strong>nachweisbaren CO2-Einsparungen</strong> in den kommunalen Aufgabenbereichen beitragen und damit den Klimaschutz vor Ort wirksam unterstützen.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Anteilsfinanzierung/Kapitalbeteiligung" ];
                                xyz:foerderbereich       [ rdf:_1  "Umwelt- und Naturschutz" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Kommunen" ];
                                xyz:foerderprogramm      "Förderrichtlinien Kommunaler Klimaschutz - KommKlimaFöR 2026";
                                xyz:foerderzeitraum.bis  "2029-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2026-08-01T00:00:00.000+00:00";
                                xyz:schluessel           "ee2a3b90-ebbb-4b3c-aeb0-61815f459d2b";
                                xyz:teaser               "Bringen Sie die CO2-Bilanz Ihrer Kommune spürbar nach unten!\nMit unserer Förderung können Kommunen CO2-intensive Anlageteile ersetzen sowie Innen- und Hallenbeleuchtungen auf LED umstellen. Das schafft dauerhaft messbare CO2-Einsparungen.";
                                xyz:titel                "Umsetzung zur systematischen Verringerung von Treibhausgasen";
                                xyz:titel.tokens         [ rdf:_1  "Umsetzung zur systematischen Verringerung von Treibhausgasen" ];
                                xyz:voraussetzung        "<h4>Allgemeine Fördervoraussetzungen - kurz erklärt</h4><ol><li class=\"ordered-list-item--numbered\"><strong>Projektstart erst nach Bewilligung</strong><br>Beginnen Sie erst mit dem Projekt, wenn der Förderbescheid vorliegt. Vorarbeiten auf eigenes Risiko sind ausgeschlossen.</li><li class=\"ordered-list-item--numbered\"><strong>Keine Pflichtaufgaben</strong><br>Vorhaben, zu denen Ihre Kommune oder Dritte ohnehin gesetzlich verpflichtet sind, können nicht gefördert werden.</li><li class=\"ordered-list-item--numbered\"><strong>Finanzierung steht</strong><br>- Die Gesamtfinanzierung muss gesichert sein (z. B. Eigenanteil, weitere Zuschüsse).<br>- Laufende Betriebs- und Unterhaltskosten trägt die Kommune selbst.</li><li class=\"ordered-list-item--numbered\"><strong>Mindestgröße</strong><br>Die förderfähigen Ausgaben müssen mindestens <strong>10 000 €</strong> betragen.</li><li class=\"ordered-list-item--numbered\"><strong>Anschaffungen</strong><br>Gefördert werden Anschaffungen nur, wenn sie in das Eigentum der Kommune übergehen und nicht gewerblich betrieben werden.</li><li class=\"ordered-list-item--numbered\"><strong>Genehmigungen</strong><br>Holen Sie alle erforderlichen behördlichen Genehmigungen oder Zustimmungen (etwa von Grundstückseigentümer*innen) ein, bevor Sie mit der Umsetzung beginnen.</li><li class=\"ordered-list-item--numbered\"><strong>Zweckbindung</strong><br>Die geförderten Mittel und angeschafften Anlagen sind ausschließlich für das bewilligte Vorhaben zu nutzen. In der Regel gilt eine Zweckbindungsfrist von <strong>fünf Jahren</strong> ab Inbetriebnahme; eine kürzere Frist ist nur in gut begründeten Ausnahmefällen möglich.</li></ol>"
                              ];
              xyz:id          "ee2a3b90-ebbb-4b3c-aeb0-61815f459d2b";
              xyz:payload     [ xyz:json  [ xyz:anfrage            [ xyz:anfragenummer  "ee2a3b90-ebbb-4b3c-aeb0-61815f459d2b";
                                                                     xyz:flb            [ xyz:konkreteFLB  [ xyz:allgemeineAngaben       [ xyz:beschreibung       [ xyz:schluesselwoerter  "Förderung, Zuschuss, Kommune, Kommunen, Stadt, Gemeinde, Landkreis, Bezirk, Zweckverband, Zusammenschluss, kommunales Unternehmen, Stadtwerke, Klimaschutz, Klimaneutralität, CO2-Einsparung, Treibhausgasminderung, Klimaanpassung, Klimaschutzkonzept, Entwicklungskonzept Klimaneutrale Kommune, Kommunales Energiemanagement, KEM, LED-Sanierung, Klimaschutzlotse, Koordinierungsstelle, Begleitmaßnahmen, Öffentlichkeitsarbeit, Investive Maßnahmen, Strategische Maßnahmen, Fördersatz, Förderobergrenze, Mindestbetrag 10 000 €, Projektstart nach Bewilligung, Gesicherte Finanzierung, Eigenanteil, Marktübliche Preise, De-minimis-Regeln, DAWI-Regeln, EU-Beihilfe, Genehmigungen, Zustimmungen, Zweckbindung, Eigentumsübergang, Nicht gewerbliche Nutzung, Keine gesetzlichen Pflichtaufgaben, Laufende Betriebskosten, Energieeffizienz, Energiesparen, Software, Energiecontrolling, KI, Klimawälder, Dachbegrünung, Beschattung, Zisternen";
                                                                                                                                                                    xyz:teaser             "Bringen Sie die CO2-Bilanz Ihrer Kommune spürbar nach unten!\nMit unserer Förderung können Kommunen CO2-intensive Anlageteile ersetzen sowie Innen- und Hallenbeleuchtungen auf LED umstellen. Das schafft dauerhaft messbare CO2-Einsparungen.";
                                                                                                                                                                    xyz:zuwendungszweck    "<p>Zweck der Zuwendung ist die Umsetzung kommunaler Maßnahmen zur <strong>systematischen Verringerung von Treibhausgasemissionen</strong>.<br>Gefördert werden ausschließlich der <strong>Austausch CO2-intensiver Anlageteile</strong> sowie<br>die <strong>LED-Sanierung von Innen- und Hallenbeleuchtungen</strong>.<br>Die Maßnahmen sollen zu <strong>nachweisbaren CO2-Einsparungen</strong> in den kommunalen Aufgabenbereichen beitragen und damit den Klimaschutz vor Ort wirksam unterstützen.</p>"
                                                                                                                                                                  ];
