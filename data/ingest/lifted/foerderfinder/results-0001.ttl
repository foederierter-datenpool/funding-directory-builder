[ rdf:type  fx:root;
  rdf:_1    [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rvs/b4/40.1/rvs_40.1-211/index";
                                xyz:begriffeImKontext    [ rdf:_1  "staatliche Mittelschulen";
                                                           rdf:_2  "BO";
                                                           rdf:_3  "Berufsorientierung";
                                                           rdf:_4  "Förderung";
                                                           rdf:_5  "Bildung"
                                                         ];
                                xyz:beschreibung         "<p>Zum Ende ihrer Schulzeit müssen Jugendliche eine bedeutsame Orientierungs- und Entscheidungsleistung erbringen. In unserem dynamischen Bildungs- und Beschäftigungssystem entstehen fast täglich neue Ausbildungsgänge, Studienangebote und Berufsfelder. Der Zuwachs an Entscheidungsmöglichkeiten einerseits stellt deswegen auch erhöhte Anforderungen an die Orientierungs- und Entscheidungskompetenz junger Menschen andererseits. Aus diesem Grund bedürfen Schülerinnen und Schüler heute einer intensiveren Unterstützung beim Übergang von der Schule in den Beruf als noch vor wenigen Jahren.</p>\n<p>Durch die Berufsorientierungsmaßnahmen sollen die jungen Menschen einen vertieften Einblick in die Berufs- und Arbeitswelt erhalten und damit besser auf die Berufs- und Studienwahl vorbereitet werden. Der Anteil unversorgter Bewerberinnen und Bewerber kann dadurch verringert und Ausbildungs- sowie Studienabbrüche aufgrund unzureichender Berufsvorstellungen können vermieden werden.</p>\n<p>Im Rahmen der erweiterten vertieften Berufsorientierung an Mittelschulen durchgeführte Maßnahme können auf Antrag gefördert werden.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Aus und Weiterbildung" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Behörden";
                                                           rdf:_2  "Kommunen";
                                                           rdf:_3  "Vereine";
                                                           rdf:_4  "Stiftungen"
                                                         ];
                                xyz:foerderprogramm      "Berufsorientierungsmaßnahmen an Mittelschulen; Beantragung einer Förderung";
                                xyz:foerderzeitraum.bis  "2030-11-30T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2025-04-30T00:00:00.000+00:00";
                                xyz:schluessel           "1a391e8d-9719-4fd5-9938-9bfdbed101ac";
                                xyz:teaser               "Schüler an Mittelschulen werden ab der 7. Jahrgangsstufe im Rahmen der erweiterten vertieften Berufsorientierung mit Berufsorientierungsmaßnahmen (BOM) intensiv auf den Übergang von der Schule in den Beruf vorbereitet werden. Diese Maßnahmen werden gefördert.";
                                xyz:titel                "Berufsorientierungsmaßnahmen an Mittelschulen; Beantragung einer Förderung";
                                xyz:titel.tokens         [ rdf:_1  "Berufsorientierungsmaßnahmen an Mittelschulen";
                                                           rdf:_2  "Beantragung einer Förderung"
                                                         ];
                                xyz:voraussetzung        "<p>Zwingende Voraussetungen:</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">Die Maßnahme dient der Berufsorientierung oder Berufswahlvorbereitung.</li>\n  <li class=\"unordered-list-item--dash\">Sie richtet sich an Schülerinnen und Schüler allgemeinbildender Mittelschulen.</li>\n  <li class=\"unordered-list-item--dash\">Agentur für Arbeit und ein externer Träger beteiligen sich gemeinsam an der Finanzierung.</li>\n  <li class=\"unordered-list-item--dash\">Der jeweilige Partner übernimmt mindestens 50 % der Kosten (Agentur für Arbeit höchstens 50 %).</li>\n</ul>\n<p>Folgende Voraussetzungen werden dringend empfohlen:</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">Führen Sie vorab eine Bedarfsanalyse durch, die die Zielgruppe, die regionale Angebotslage und bestehende Programme berücksichtigt.</li>\n  <li class=\"unordered-list-item--dash\">Binden Sie die Maßnahme in das Berufsorientierungskonzept der Schule ein und stimmen Sie sie mit der Schule sowie der Berufsberatung ab.</li>\n  <li class=\"unordered-list-item--dash\">Stellen Sie ein schlüssiges Konzept sicher, das Ziele, Ablauf, Methoden und eine Kostenplanung umfasst.</li>\n  <li class=\"unordered-list-item--dash\">Lassen Sie die Maßnahme von einem geeigneten Träger mit qualifiziertem Personal durchführen.</li>\n  <li class=\"unordered-list-item--dash\">Berücksichtigen Sie bei der Umsetzung die besonderen Bedürfnisse von Schülerinnen und Schülern mit sonderpädagogischem Förderbedarf oder Schwerbehinderung.</li>\n</ul>\n<p>Mehr Infos finden Sie unter 'Weiterführende Informationen'.</p>"
                              ];
