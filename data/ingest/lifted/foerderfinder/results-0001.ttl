                                                                                                                                           xyz:beschreibung       [ xyz:schluesselwoerter  "Landeplatz, Verkehrslandeplatz, Schwerpunktlandeplatz, Flugplatz, Luftverkehr";
                                                                                                                                                                    xyz:teaser             "Als Flugplatzbetreiber können Sie unter Umständen eine Zuwendung erhalten, wenn Sie in die Infrastruktur und Ausrüstung Ihres Landeplatzes investieren.";
                                                                                                                                                                    xyz:zuwendungszweck    "<p>Die Zuwendung wird insbesondere zur Strukturverbesserung, zur Verbesserung der Verkehrsanbindung, zur Regionalentwicklung, zur Sicherheit im Luftverkehr sowie zur nachhaltigen Weiterentwicklung des Luftverkehrs gewährt.</p>"
                                                                                                                                                                  ];
