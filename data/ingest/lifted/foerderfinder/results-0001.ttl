                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>248722ab-a4ef-413a-90ea-b0a0152fff58</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-05-27T15:57:24</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>248722ab-a4ef-413a-90ea-b0a0152fff58</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>248722ab-a4ef-413a-90ea-b0a0152fff58</xflb:schluessel>\n         <xflb:versionFLB>7</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-09-07T10:09:55</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>248722ab-a4ef-413a-90ea-b0a0152fff58</xflb:foerderschluessel>\n                  <xflb:flbVersion>7</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400016017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Hauptamtliche Integrationslotsinnen und -lotsen</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Die hauptamtlichen Integrationslotsen sollen das im Bereich Asyl und Integration tätige Ehrenamt auf kommunaler Ebene praxisbezogen unterstützten. Ziel ist dabei die Schaffung verlässlicher Rahmenbedingungen für ehrenamtliche Tätigkeit, eine stärkere Vernetzung der regionalen Akteure und Fortbildung der Ehrenamtlichen sowie die Gewinnung und effiziente Vermittlung weiterer freiwilliger Helferinnen und Helfer.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern unterstützt mit der Förderung von hauptamtlichen Integrationslotsinnen und Integrationslotsen die Kommunen dabei, die Tätigkeit von Ehrenamtlichen im Bereich Asyl und Integration auf kommunaler Ebene praxisbezogen zu unterstützen.</xflb:teaser>\n                  <xflb:schluesselwoerter>Hauptamtliche Integrationslotsinnen und lotsen, Lotse, Intergration, Ehrenamt, Asylunterstützung, Asyl</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Regierung von Mittelfranken - Sachgebiet 15 - Integration und Förderung, Ausgleichsamt</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>21</xflb:hausnummerPostfach>\n                     <xflb:strasse>Marienstraße</xflb:strasse>\n                     <xflb:postleitzahl>90402</xflb:postleitzahl>\n                     <xflb:ort>Nürnberg</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>Sachgebiet-15.Integration@reg-mfr.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Übersicht der Regierung von Mittelfranken</xflb:bezeichnung>\n                     <xflb:link>https://www.regierung.mittelfranken.bayern.de/aufgaben/40027/57461/leistung/leistung_53004/index.html</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>+49 (0)911 2352-0</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Regierung von Mittelfranken - Sachgebiet 15 - Integration und Förderung, Ausgleichsamt</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>21</xflb:hausnummerPostfach>\n                           <xflb:strasse>Marienstraße</xflb:strasse>\n                           <xflb:postleitzahl>90402</xflb:postleitzahl>\n                           <xflb:ort>Nürnberg</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>Sachgebiet-15.Integration@reg-mfr.bayern.de</xflb:email>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Übersicht der Regierung von Mittelfranken</xflb:bezeichnung>\n                           <xflb:link>https://www.regierung.mittelfranken.bayern.de/aufgaben/40027/57461/leistung/leistung_53004/index.html</xflb:link>\n                        </xflb:verweis>\n                        <xflb:telefonnummer>+49 (0)911 2352-197</xflb:telefonnummer>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>a122c3c6-c555-4ffd-829d-46b0394884d5</xflb:id>\n                     <xflb:bezeichnung>Ausgaben- und Finanzierungsplan 2024- 2026</xflb:bezeichnung>\n                     <xflb:link>https://www.regierung.mittelfranken.bayern.de/mam/aufgaben/sg15/ausgaben_und_finanzierungsplan_integrationslotsen_2024-2026.xlsx</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n               <xflb:onlinedienste>\n                  <xflb:onlinedienst>\n                     <xflb:id>4b3633ea-5586-42b5-b67d-49cf56f74e56</xflb:id>\n                     <xflb:bezeichnung>Auszahlungsantrag nach der Beratungs- und Integrationsrichtlinie für hauptamtliche Integrationslotsinnen und Integrationslotsen</xflb:bezeichnung>\n                     <xflb:link>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/rmf_15-028_zz_auszahlungsantrag_integrationslotsen/index?caller=bpgmydsmtgmi4tendfha2wiztbmeaydzlocmjg7dcmdecbyjc6zuqexabn2owz2km2lbcsu6rdofm3utw3hr75hmxc7eb47k6for4xd3pv3a644nndvpx4by6e6alm4vjd5wtpy3lpufgztmre4iwtvft7j7v3bgp2h3zjgt3dorfnmea6bfn6f3gglwkk2uv7t2wluh3loo3slfxe3bptk5pmnpehvvl44wuloj3g3e2kxpn3draa2uuye6cnqwclaur7ty2rzum5y2pctl2gpdcozm888888</xflb:link>\n                     <xflb:beschreibung>Sie können die Auszahlung der Förderung nach der Beratungs- und Integrationsrichtlinie für hauptamtliche Integrationslotsinnen und Integrationslotsen online beantragen.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1102</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n                  <xflb:onlinedienst>\n                     <xflb:id>9eadfb77-5b95-4a1f-9853-795e01092d8c</xflb:id>\n                     <xflb:bezeichnung>Zuwendungsantrag nach der Beratungs- und Integrationsrichtlinie für hauptamtliche Integrationslotsinnen und Integrationslotsen</xflb:bezeichnung>\n                     <xflb:link>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/rmf_15-023_zz_zuwendungsantrag_integrationslotsen/index?caller=bpgvrtonbymy2dgyjxhazdmyjsglmcshwyf6foqxjsd5k3cwlyhkfidha3kbjephdfkfxhvneqo2wmu4fq2dt5vqrf64pwxce7sdgluhes47htosdrjdllvlfv6r6d7lhgk7uybsi74ehbc5pouh2hn352mejashpngqltbc6homillf6rg5h62qvi74fogacdhlfptzrvshkhdlr6gjv3wriv7dxfgbhijih6u7icbsefzrhp4e6vfzdycl4edooc</xflb:link>\n                     <xflb:beschreibung>Sie können eine Förderung nach der Beratungs- und Integrationsrichtlinie für hauptamtliche Integrationslotsinnen und Integrationslotsen online beantragen.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n                  <xflb:onlinedienst>\n                     <xflb:id>5ae81295-af07-4ee2-b6c6-8d289d6c599f</xflb:id>\n                     <xflb:bezeichnung>Verwendungsnachweis für eine Förderung nach der Beratungs- und Integrationsrichtlinie - Hauptamtliche Integrationslotsinnen und Integrationslotsen</xflb:bezeichnung>\n                     <xflb:link>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/rmf_15-039_zz_verwendungsnachweis_integrationslotsen/index?caller=bpga2tambqgeydszrtmrqwenrsmkgumd5dxwpo6zbsvggqi7lnbujrvyb572oyntf2oma2j4aiarf57jl5xt7bflk7luw3sroh5qba6kjzrlvncynncn3q42z67soddck4zo3nx36wpz6weieywirjzwy7tqq4xdzbzrdujkqt44nwwfoxhrf4adwxgtgzvwubsos3dqwk63aprnc35zbvj4pkq6nqm5zlbwyyuuj3nb6wgnqytd5rsmzb2ajywgeyktj32izl7bfhwl24dlj3a25fye888888</xflb:link>\n                     <xflb:beschreibung>Sie können den Verwendungsnachweis für eine Förderung nach der Beratungs- und Integrationsrichtlinie - Hauptamtliche Integrationslotsinnen und Integrationslotsen online übermitteln.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1101</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1102</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1103</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n               </xflb:onlinedienste>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Zuwendungsempfänger sind die Landkreise und kreisfreien Städte in Bayern. Die Kommune kann sich jedoch Dritter bedienen.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Der Fördergeber fördert für bis zu drei Jahre im Rahmen einer Anteilfinanzierung bis zu 80% der zuwendungsfähigen Ausgaben. Der Antragsteller muss einen angemessenen Eigenanteil in Höhe von mindestens 10% der zuwendungsfähigen Gesamtausgaben erbringen, der auch über Drittmittel erbracht werden kann.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Zuwendungsfähig sind projektbezogene Personalausgaben sowie Sachausgaben. Nr. 3.6.2 der BIR gilt entsprechend. Zuwendungsfähig sind auch die Aufwendungen für die Durchführung von Supervisionen sowie Organisation und Durchführung aufgabenmäßiger Veranstaltungen. Ferner sind die Beschaffungsausgaben für Schulungshefte im Rahmen der Mieterqualifikation von Menschen mit Migrationsgeschichte sowie die im Projekt erstatteten Fahrtkosten von Ehrenamtlichen zuwendungsfähig.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n               <xflb:euBeihilferelevanz>unzutreffend</xflb:euBeihilferelevanz>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium des Innern, für Sport und Integration</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinie für die Förderung der sozialen Beratung, Betreuung und Integration von Menschen mit Migrationsgeschichte (Beratungs- und Integrationsrichtlinie - BIR) vom 26. September 2023</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2176_I_14046</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Sachgebiet G3</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Richtlinie für die Förderung der sozialen Beratung, Betreuung und Integration von Menschen mit Migrationsgeschichte (Beratungs- und Integrationsrichtlinie - BIR)</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2026-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2024-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2026-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert werden unter Beachtung des Förderzwecks hauptamtliche Integrationslotsinnen und Integrationslotsen zur Unterstützung Ehrenamtlicher auf kommunaler Ebene (Landkreise und kreisfreie Städte).&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>022</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Die eingesetzten Personen sollen über eigene Erfahrungen im Bereich der ehrenamtlichen Tätigkeit verfügen. Zudem sind praktische Erfahrungen im Tätigkeitsfeld der Freiwilligenkoordination sowie in der Betreuung von Menschen mit Migrationsgeschichte hilfreich.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Der Fördergeber fördert für bis zu drei Jahre im Rahmen einer Anteilfinanzierung bis zu 80% der zuwendungsfähigen Ausgaben. Der Antragsteller muss einen angemessenen Eigenanteil in Höhe von mindestens 10% der zuwendungsfähigen Gesamtausgaben erbringen, der auch über Drittmittel erbracht werden kann.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/rmf_15-023_zz_zuwendungsantrag_integrationslotsen/index?caller=bpgvrtonbymy2dgyjxhazdmyjsglmcshwyf6foqxjsd5k3cwlyhkfidha3kbjephdfkfxhvneqo2wmu4fq2dt5vqrf64pwxce7sdgluhes47htosdrjdllvlfv6r6d7lhgk7uybsi74ehbc5pouh2hn352mejashpngqltbc6homillf6rg5h62qvi74fogacdhlfptzrvshkhdlr6gjv3wriv7dxfgbhijih6u7icbsefzrhp4e6vfzdycl4edooc</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Anträge auf Förderung sind bei der Regierung von Mittelfranken (Sachgebiet 15) einzureichen, die über diese entscheidet (Bewilligungsbehörde).&amp;nbsp;&lt;/p&gt;&lt;p&gt;Der Bewilligungszeitraum beträgt bis zu drei Jahren.&lt;/p&gt;&lt;p&gt;Die Anträge sind unter Verwendung der bei der Bewilligungsbehörde erhältlichen Vordrucke zu erstellen. Dem Staatsministerium des Innern, für Sport und Integration ist ein Abdruck (mit Anlagen) ausschließlich in digitaler Form zu übersenden.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Die weiteren Einzelheiten zum Antragstellungs- und Bewilligungsverfahren entnehmen Sie bitte der Richtlinie.&lt;br&gt;&lt;br&gt;&lt;strong&gt;Neuantragstellungen im Rahmen der BIR III sind nicht mehr möglich. Das digitale Antragsverfahren für Förderungen nach der BIR IV, welche zum 1.1.2027 in Kraft treten wird, wird rechtzeitig vorher wieder geöffnet sein.&lt;/strong&gt;&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:sonstige>ja</xflb:sonstige>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Anträge auf Zuwendung sind vor Beginn des Bewilligungszeitraums grundsätzlich bis spätestens 15. November des Vorjahres zu stellen. Etwaige Änderungen nach Antragstellung können der Bewilligungsbehörde noch bis spätestens 15. März des Bewilligungszeitraums mitgeteilt werden.\nFür 2026 ist diese Frist bereits abgelaufen.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Vordrucke der Bewillgungsbehörde</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Können auf der Übersichtsseite der Regierung von Mittelfranken bzw. im Onlineverfahren heruntergeladen werden.</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Gegen den Zuwendungsbescheid können Sie innerhalb eines Monats nach seiner Bekanntgabe Klage erheben. Das zuständige Gericht, bei dem Sie Klage einreichen können, wird Ihnen im Bescheid mitgeteilt.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_178  [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/vereinseigener_sportstaettenbau_bssb/index?caller=bpmyytimbyg43tiy3fgbsdomzrheb6d5cfe7fjywbgazm5t6wkppncqoxvqhxlsen7zfs2amutpphoqxcrx7prhlquza2rt7c4q3p4czm2sb3hnepgzftfgx7moxnqdiiusknmui3zrvkgbu57gnroiywllaz743w24lonvrvb2y5eyorpngr6gn2k334su7pwq5xzk4avnz4xoyw43rahopxn6xcmb4zvjhejdaksjeyvdqs3w4mvldmimhfn73wy";
                                xyz:begriffeImKontext    [ rdf:_1  "Schützenverein";
                                                           rdf:_2  "Sportstättenbau";
                                                           rdf:_3  "vereinseigener Schießsportstättenbau"
                                                         ];
                                xyz:beschreibung         "<p>Durch die Zuwendungen sollen Schützenvereine in die Lage versetzt werden, eigene Sportstätten zu errichten und zu erhalten, die sie für den unmittelbaren Sportbetrieb ihrer Mitglieder benötigen.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Kultur, Medien und Sport" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Vereine" ];
                                xyz:foerderprogramm      "Sportförderung";
                                xyz:foerderzeitraum.bis  "2028-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2023-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "7c89b2bd-980f-4697-b896-3b0fd4942660";
                                xyz:teaser               "Der Freistaat Bayern fördert die Errichtung und die Sanierung von Schießsportstätten, die Schützenvereine für den unmittelbaren Sportbetrieb ihrer Mitglieder benötigen.";
                                xyz:titel                "Schützenverein; Beantragung einer Förderung für den vereinseigenen Sportstättenbau";
                                xyz:titel.tokens         [ rdf:_1  "Schützenverein";
                                                           rdf:_2  "Beantragung einer Förderung für den vereinseigenen Sportstättenbau"
                                                         ];
                                xyz:voraussetzung        "<p>Eine Förderung ist nur im Rahmen des nachgewiesenen sportfachlichen Bedarfs zulässig. Der Bedarfsnachweis soll in der Regel durch eine Darstellung des geplanten Sportbetriebs, der erwarteten Teilnehmerzahlen, der dem Verein ansonsten zur Verfügung stehenden Einrichtungen sowie der geplanten Auslastung der Sportstätte durch den eigenen Vereinssport geführt werden.&nbsp;</p><p>Der antragstellende Verein muss der Träger aller beantragten Baumaßnahmen sein sowie grundsätzlich über ein Eigentums- bzw. Erbbaurecht an den Förderobjekten verfügen. In wenigen Fällen genügt anstelle des Eigentums- bzw. Erbbaurecht ein langfristiges Nutzungsrecht. Ab Fertigstellung der Anlage müssen dem Verein das Nutzungs- sowie das Hausrecht auf die Dauer von mindestens 25 Jahren uneingeschränkt, unkündbar und unabdingbar eingeräumt werden. Die allgemein gültigen zuwendungsrechtlichen Bestimmungen der Verwaltungsvorschriften zu den Artikeln 23 und 44 der bayerischen Haushaltsordnung (BayHO) finden Anwendung. Dem Verein kann eine Zuwendung nur gewährt werden, sofern die Bewilligung der Maßnahme vor dem Baubeginn erfolgt ist. Der Verein muss einen Eigenanteil erbringen, der nicht unter zehn Prozent der zuwendungsfähigen Ausgaben liegen darf.</p>"
                              ];
              xyz:id          "7c89b2bd-980f-4697-b896-3b0fd4942660";
              xyz:payload     [ xyz:json  [ xyz:anfrage            [ xyz:anfragenummer  "7c89b2bd-980f-4697-b896-3b0fd4942660";
