                                xyz:foerderprogramm      "Bayerischer Demenzfonds; Beantragung einer Förderung";
                                xyz:foerderzeitraum.bis  "2028-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2023-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "187090b3-9cdc-4e9c-ae36-d1986042e56f";
                                xyz:teaser               "Mit dem Bayerischen Demenzfonds fördert der Freistaat Bayern Angebote zur Teilhabe von Menschen mit Demenz und ihren An- und Zugehörigen sowie Programme zur Stärkung von demenzsensiblen Kommunen.";
                                xyz:titel                "Förderung zur besseren Teilhabe demenzkranker Menschen und der Aufbau demenzsensiblen Strukturen vor Ort - Bayerischer Demenzfonds";
                                xyz:titel.tokens         [ rdf:_1  "Förderung zur besseren Teilhabe demenzkranker Menschen und der Aufbau demenzsensiblen Strukturen vor Ort - Bayerischer Demenzfonds" ];
                                xyz:voraussetzung        "<p>Die Angebote und Programme müssen die jeweiligen Förderkriterien nach der Förderrichtlinie Demenz und Teilhabe (DEMTeil) sowie zur Vergabe des Bayerischen Demenzpreises erfüllen.&nbsp;</p><p>Die Förderung der Angebote und Programme (Maßnahmen) setzt voraus, dass diese&nbsp;</p><ol><li class=\"ordered-list-item--numbered\">einen Bezug zu Menschen mit Demenz und ihren An- und Zugehörigen im Freistaat Bayern aufweisen und&nbsp;</li><li class=\"ordered-list-item--numbered\">noch nicht begonnen wurden.</li></ol>"
                              ];
