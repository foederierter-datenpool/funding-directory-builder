                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>4a71927f-9f35-4b7a-95c4-b24918b75e2e</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-10-09T11:02:28</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>4a71927f-9f35-4b7a-95c4-b24918b75e2e</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>4a71927f-9f35-4b7a-95c4-b24918b75e2e</xflb:schluessel>\n         <xflb:versionFLB>3</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-10-09T11:02:28</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>4a71927f-9f35-4b7a-95c4-b24918b75e2e</xflb:foerderschluessel>\n                  <xflb:flbVersion>3</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400040017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Förderung von Bau- und Sanierungsvorhaben für Tierheime</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Zweck der Zuwendungen ist die Förderung von&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Investitionen für Bau- und Sanierungsvorhaben in und an Tierheimen,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Ausgaben für Ausrüstung und Ausstattung von Tierheimen mit Geräten und Materialien, die für den ordnungsgemäßen Betrieb erforderlich sind,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Ausgaben im Zusammenhang mit der Vermittlung von Heimtieren an Privathaushalte durch Tierheime und&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Vorhaben zur Eindämmung der Anzahl herrenloser Hauskatzen.&lt;/li&gt;&lt;/ul&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern fördert Bau- und Sanierungsvorhaben in und an Tierheimen, Ausgaben im Zusammenhang mit der Vermittlung von Heimtieren an Privathaushalte durch Tierheime und Vorhaben zur Eindämmung der Anzahl herrenloser Hauskatzen.</xflb:teaser>\n                  <xflb:schluesselwoerter>Tierheime</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Regierung von Oberfranken - Förderprogramm für Tierheime in Bayern</xflb:bezeichnung>\n                     <xflb:link>https://www.regierung.oberfranken.bayern.de/aufgaben/192188/192196/gebaeude/2168/index.html</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderantrag A: Ausfüllbeispiel mit Kommentaren: Antrag auf Gewährung einer Zuwendung nach der Förderrichtlinie Tierheime</xflb:bezeichnung>\n                     <xflb:link>https://www.regierung.oberfranken.bayern.de/mam/service/formulare_merkblaetter/umwelt_gesundheit_verbraucherschutz/rechtsfragen_gesundheit/formblatt_a_mit_kommentaren.pdf</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderantrag B: Ausfüllbeispiel mit Kommentaren: Antrag auf Gewährung einer Zuwendung nach der Förderrichtlinie Tierheime für Bauvorhaben</xflb:bezeichnung>\n                     <xflb:link>https://www.regierung.oberfranken.bayern.de/mam/service/formulare_merkblaetter/umwelt_gesundheit_verbraucherschutz/rechtsfragen_gesundheit/formblatt_b_mit_kommentaren.pdf</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Jürgen Bäte</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>20</xflb:hausnummerPostfach>\n                     <xflb:strasse>Ludwigstr.</xflb:strasse>\n                     <xflb:postleitzahl>95444</xflb:postleitzahl>\n                     <xflb:ort>Bayreuth</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>tierheime@reg-ofr.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Tierheim; Beantragung einer Förderung</xflb:bezeichnung>\n                     <xflb:link>https://www.regierung.oberfranken.bayern.de/aufgaben/192188/192196/leistung/leistung_64183/index.html</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>+49 (0)921 604-1941</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Regierung von Oberfranken</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>f6396ee3-91ed-45ce-b2d2-46d1ac3bfff6</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Gewährung einer Zuwendung nach der Förderrichtlinie Tierheime - FöR-TH nach Nr. 2.1 - Förderantrag A für Bauvorhaben</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rof/b5/55.2/rof_55.2-128-zz/index</xflb:link>\n                     <xflb:beschreibung>&lt;p&gt;Für Investitionen für Bau- und Sanierungsvorhaben in und an Tierheimen (Nr. 2.1 FöR-TH)&lt;/p&gt;</xflb:beschreibung>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>d1f97669-8e96-4839-9575-d7e49f9f2734</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Gewährung einer Zuwendung nach der Förderrichtlinie Tierheime - FöR-TH nach Nrn. 2.2, 2.3 und 2.4 - Förderantrag B</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rof/b5/55.2/rof_55.2-069-zz/index</xflb:link>\n                     <xflb:beschreibung>&lt;p&gt;Für Ausgaben für Ausrüstung und Ausstattung sowie im Zusammenhang mit der Vermittlung von Heimtieren und Vorhaben zur Eindämmung der Anzahl herrenloser Hauskatzen (Nrn. 2.2, 2.3 und 2.4)&lt;/p&gt;</xflb:beschreibung>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>2c1ada38-d817-4b3f-bc56-8b64f0317611</xflb:id>\n                     <xflb:bezeichnung>Verwendungsnachweis (Muster 4 zu Art. 44 BayHO) - Für Investitionen für Bau- und Sanierungsvorhaben in und an Tierheimen (Nr. 2.1 FöR-TH)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-019/index</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Zuwendungsempfänger sind gemeinnützige Träger von in Bayern gelegenen Tierheimen sowie bayerische Kommunen oder rechtsfähige kommunale Zusammenschlüsse als Träger eines Tierheims.\n\nZuwendungsempfänger bei Vorhaben nach Nr. 2.4 sind ferner auf Dauer angelegte gemeinnützige Tierschutzorganisationen mit Sitz in Bayern.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Art der Zuwendung ist abhängig vom Vorhaben:&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Für Bau- und Sanierungsmaßnahmen sowie für Ausgaben für Ausrüstung und Ausstattung von Tierheimen wird sie als Projektförderung im Wege der Anteilfinanzierung in nicht rückzahlbarer Form gewährt.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Zuwendung für die Vermittlung von Heimtieren an Privathaushalte sowie für die Kastration herrenloser Hauskatzen wird im Wege der Festbetragsfinanzierung als Pauschale gewährt.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Die Höhe ist abhängig vom Vorhaben:&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bei Bau- und Sanierungsmaßnahmen beträgt der Fördersatz 50 % der zuwendungsfähigen Ausgaben. Der Höchstbetrag der Zuwendung beträgt 300.000 EUR je Vorhaben (für die Kostengruppe 200 nach DIN 276 maximal 30.000 EUR), der Mindestbetrag 3.000 EUR je Vorhaben.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Für Ausrüstung und Ausstattung von Tierheimen beträgt der Fördersatz 50 % der zuwendungsfähigen Ausgaben. Der Höchstbetrag der Zuwendung beträgt 10.000 EUR pro Kalenderjahr, der Mindestbetrag 500 EUR je Vorhaben.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bei Vermittlungstätigkeiten wird für jede nachgewiesene Vermittlung an einen Privathaushalt eine Pauschale für die Personal- und Sachausgaben des Zuwendungsempfängers in Höhe von 80 EUR für Hunde und 30 EUR für die Vermittlung von Katzen und anderer Heimtiere (Kleintiere) gewährt. Bei Vermittlung mehrerer Kleintiere in einer Gruppe wird die Pauschale nur einmal gewährt. Der Höchstbetrag der Zuwendung beträgt 5.000 EUR pro Kalenderjahr.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Für jede nachgewiesene Kastration eines weiblichen Tieres wird eine Pauschale in Höhe von 70 Euro und für jede nachgewiesene Kastration eines männlichen Tieres eine Pauschale in Höhe von 45 Euro gewährt. Der Höchstbetrag der Zuwendung für Kastrationen beträgt 20.000 Euro pro Jahr.&lt;/li&gt;&lt;/ul&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Zuwendungsfähig sind Ausgaben, die zur Durchführung des zu fördernden Vorhabens erforderlich sind.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:tage>1</xflb:tage>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>12</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n               <xflb:euBeihilferelevanz>Nein</xflb:euBeihilferelevanz>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Umwelt und Verbraucherschutz</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinie zur Förderung von Bau- und Sanierungsvorhaben in und an Tierheimen, Vorhaben zur Verbesserung des Tierschutzes und zur Eindämmung der Anzahl herrenloser Hauskatzen (Förderrichtlinie Tierheime - FöR-TH)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2091_2_U_14105/True</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 23 und Art. 44 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO/true</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Allgemeine Nebenbestimmungen für Zuwendungen zur Projektförderung (ANBest-P)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/VVBayHO-NN121</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>45</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Förderung von Bau- und Sanierungsvorhaben für Tierheime</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2026-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2023-11-16</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2026-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Die Unterbringung in bayerischen Tierheimen soll gefördert werden durch:&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Neu-, An-, Aus- und Umbauten, Sanierungs- und Modernisierungsmaßnahmen,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;bauliche Maßnahmen zur Verbesserung der hygienischen und energetischen Funktionalität und&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;bauliche Maßnahmen zur Schaffung, zum Ausbau und zur Verbesserung von Quarantäneplätzen in Tierheimen.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Weiterhin werden Ausgaben für Ausrüstung und Ausstattung von Tierheimen mit Geräten und Materialien, die für den ordnungsgemäßen Betrieb erforderlich sind (außer Verbrauchsmaterialien und Tierarzneimittel), gefördert, außerdem laufende Ausgaben im Zusammenhang mit der Vermittlung von Heimtieren an Privathaushalte durch Tierheime in Bayern sowie Kastrationen von herrenlosen Hauskatzen.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Erhalt regelmäßiger kommunaler Unterstützung (gilt nicht für Vorhaben nach Nr. 2.4)&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Die Vorhaben müssen geeignet sein, die Unterbringung oder Pflege von Heimtieren zu verbessern; sie müssen den Vorgaben des § 2 TierSchG bzw., sofern es um die Haltung von Hunden geht, der Tierschutz-Hundeverordnung entsprechen&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Nachweis aller notwendigen bestandskräftigen öffentlich-rechtlichen Genehmigungen gegenüber der Bewilligungsbehörde; bei nicht im Eigentum stehenden Grundstücken Nachweis der Berechtigung zur Durchführung des Vorhabens&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Durchführung von tiermedizinischen Maßnahmen von bzw. unter Aufsicht einer approbierten Tierärztin oder eines approbierten Tierarztes&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Zuwendungsempfänger sind gemeinnützige Träger von in Bayern gelegenen Tierheimen sowie bayerische Kommunen oder rechtsfähige kommunale Zusammenschlüsse als Träger eines Tierheims.&lt;/p&gt;&lt;p&gt;Zuwendungsempfänger bei Vorhaben nach Nr. 2.4 sind ferner auf Dauer angelegte gemeinnützige Tierschutzorganisationen mit Sitz in Bayern.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rof/b5/55.2/rof_55.2-128-zz/index</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Der Antrag ist bei der Regierung von Oberfranken einzureichen.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Die Regierung von Oberfranken prüft die Fördervoraussetzungen unter besonderer Berücksichtigung der Belange des Tierschutzes, holt ggf. erforderliche Stellungnahmen von Fachbehörden, insbesondere der zuständigen Veterinärbehörde, ein und entscheidet über den Antrag mit Zuwendungsbescheid.&lt;/p&gt;&lt;p&gt;Anträge können im gesamten laufenden Kalenderjahr gestellt werden.&lt;/p&gt;&lt;p&gt;Falls die Haushaltsmittel für das laufende Kalenderjahr ausgeschöpft sind, müssen danach gestellte Anträge abgelehnt werden. Diese können im darauffolgenden Jahr neu gestellt werden.&lt;/p&gt;&lt;p&gt;Pro Antragsteller kann für Bau- und Sanierungsvorhaben sowie für Vermittlungstätigkeiten nur ein Förderantrag pro Kalenderjahr bewilligt werden.&lt;/p&gt;</xflb:bewilligung>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>1.) Bei Baumaßnahmen nach Punkt 2.1 Förderrichtlinie Tierheime sind dem Antrag folgende Unterlagen beizufügen:</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>1.1) Förderantrag A \"Antrag auf Gewährung einer Zuwendung\" nach Nr. 2.1, abrufbar über das Internet im Bayernportal oder auf der Homepage der Regierung von Oberfranken jeweils unter der Leistung \"Tierheim; Beantragung einer Förderung\",</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>1.2) ein Beschluss des zuständigen Organs des Antragstellers zur Umsetzung des Vorhabens sowie die Satzung des nichtöffentlichen Antragstellers,</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>1.3) eine Einnahme-Überschuss-Rechnung des Antragstellers für das vorangegangene Kalenderjahr,</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>1.4) Nachweis über die Anerkennung der Gemeinnützigkeit des Antragstellers durch das zuständige Finanzamt,</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>1.5) Angaben über eigene Mittel, die für das Vorhaben zur Verfügung stehen (Ausgabengliederung mit Kostenschätzungen für unentgeltliche Arbeitsleistungen und Mitteilung über zweckgebundene Geld- oder Sachspenden),</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>1.6) eine Eigenerklärung über den Bezug regelmäßiger kommunaler Leistungen (zum Beispiel Pauschalbetrag pro Einwohner) zur Deckung der laufenden Ausgaben des Tierheims (gilt nicht für kommunale Träger),</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>1.7) eine Darstellung der angestrebten Verbesserung für die unterzubringenden Heimtiere mit Planunterlagen (bei Hochbauten unter Verwendung der Muster 5 und 6 der VV zu Art. 44 BayHO),</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>1.8) ein Nachweis über das Nutzungsrecht am Vorhabenstandort (zum Beispiel durch eine Kopie des Miet- oder Pachtvertrags über die genutzten Flächen und Gebäude) oder der Nachweis über die dingliche Berechtigung am Grundstück in Form eines Auszugs aus dem Grundbuch und</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>1.9) Erlaubnis nach § 11 Abs. 1 Nr. 3 TierSchG zum Betreiben eines Tierheims oder einer tierheimähnlichen Einrichtung.</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>2.) Bei Anträgen zu Ausgaben und Ausstattung nach Punkt 2.2 Förderrichtlinie Tierheime und Vermittlungstätigkeit nach Punkt 2.3 Förderrichtlinie Tierheime sind folgende Unterlagen beizufügen:</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>2.1) Förderantrag B \"Antrag auf Gewährung einer Zuwendung\" nach Nrn. 2.2, 2.3 und 2.4, abrufbar über das Internet im Bayernportal oder auf der Homepage der Regierung von Oberfranken jeweils unter der Leistung \"Tierheim; Beantragung einer Förderung\",</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>2.2) ein Beschluss des zuständigen Organs des Antragstellers zur Umsetzung des Vorhabens sowie die Satzung des nichtöffentlichen Antragstellers,</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>2.3) Angaben über eigene Mittel, die für das Vorhaben zur Verfügung stehen (Ausgabengliederung mit Kostenschätzungen für unentgeltliche Arbeitsleistungen und Mitteilung über zweckgebundene Geld- oder Sachspenden),</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>2.4) Erlaubnis nach § 11 Abs. 1 Nr. 3 TierSchG zum Betreiben eines Tierheims oder einer tierheimähnlichen Einrichtung,</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>2.5) gegebenenfalls eine Einnahme-Überschuss-Rechnung des Antragstellers für das vorangegangene Kalenderjahr,</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>2.6) Nachweis über die Anerkennung der Gemeinnützigkeit des Antragstellers durch das zuständige Finanzamt,</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>2.7) eine Erklärung über den Bezug regelmäßiger kommunaler Leistungen (zum Beispiel Pauschalbetrag pro Einwohner) zur Deckung der laufenden Ausgaben des Tierheims (gilt nicht für kommunale Träger).</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>3.) Bei Anträgen auf Gewährung einer Zuwendung zur Eindämmung herrenloser Heimtiere nach Punkt 2.4 Förderrichtlinie Tierheime sind folgende Unterlagen beizufügen:</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>3.1) Förderantrag B \"Antrag auf Gewährung einer Zuwendung\" nach Nrn. 2.2, 2.3 und 2.4, abrufbar über das Internet im Bayernportal oder auf der Homepage der Regierung von Oberfranken jeweils unter der Leistung \"Tierheim; Beantragung einer Förderung\",</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>3.2) ein Beschluss des zuständigen Organs des Antragstellers zur Umsetzung des Vorhabens sowie die Satzung des nichtöffentlichen Antragstellers,</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>3.3) Angaben über eigene Mittel, die für das Vorhaben zur Verfügung stehen (Ausgabengliederung mit Kostenschätzungen für unentgeltliche Arbeitsleistungen und Mitteilung über zweckgebundene Geld- oder Sachspenden).</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>3.4) Im Einzelfall kann die Bewilligungsbehörde auf die Vorlage einzelner Unterlagen verzichten oder weitere Unterlagen anfordern.</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Verwaltungsgerichtliche Klage&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_180  [ xyz:attributes  [ xyz:antragsstellung      "https://www.lfp.bayern.de/wp-content/uploads/2026/02/Antragsformular_kleinere_Versorgungsformen.pdf";
                                xyz:begriffeImKontext    [ rdf:_1   "Pflege";
