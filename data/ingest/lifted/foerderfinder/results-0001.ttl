                                                                                                                       xyz:kummulierbareFoerderungen  [ xyz:voraussetzungen
                                                                                                                                         "<p>Ob diese Förderung mit anderen Förderprogrammen kombiniert werden kann, wird im Einzelfall durch das Bayerische Landesamt für Schule geprüft. Sie können im Antrag angeben, ob zusätzliche Fördermittel beantragt wurden.</p>" ];
                                                                                                                       xyz:programmlaufzeit           [ xyz:beginnLaufzeitFoerderprogramm
                                                                                                                                                                "2025-01-30";
                                                                                                                                                        xyz:endeLaufzeitFoerderprogramm
                                                                                                                                                                "2030-01-30"
                                                                                                                                                      ];
                                                                                                                       xyz:programmtitel              "Private Grund- und Mittelschulen; Beantragung eines Zuschusses für den Personalaufwand gem. Art. 31 BaySchFG";
                                                                                                                       xyz:verantwortlichesFachreferat
                                                                                                                               "IV.4";
                                                                                                                       xyz:verantwortlichesMinisterium
                                                                                                                               "Staatsministerium für Unterricht und Kultus"
                                                                                                                     ];
                                                                                                             xyz:foerdervoraussetzungen  [ xyz:ausschlusskriterien  "<p>Schulen mit weniger als 14 Schülerinnen und Schülern sind nicht förderfähig (§ 31 Abs. 7 Satz 4).</p>";
                                                                                                                                           xyz:buergerfreundlicheBeschreibung
                                                                                                                                                   "<p>Die Voraussetzungen sind nach Art 29. und Art. 31 BaySchFG sind unter anderem:&nbsp;</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">Nachweis der Gemeinnützigkeit des Schulträgers - wird vom zuständigen Finanzamt bescheinigt</li>\n  <li class=\"unordered-list-item--dash\">Vorliegen einer schulaufsichtlichen Genehmigung der Schule nach Art. 92 ff. BayEUG</li>\n  <li class=\"unordered-list-item--dash\">Sicherstellung der wirtschaftlichen und rechtlichen Stellung der Lehrkräfte nach Art. 97 Abs. 1 BayEUG&nbsp;</li>\n  <li class=\"unordered-list-item--dash\">Genehmigungsbescheid der örtlich zuständigen Regierung</li>\n  <li class=\"unordered-list-item--dash\">ggf. weitere Unterlagen nach Anforderung des Bayerischen Lehramts für Schule; die notwendigen Antragsformulare erhalten Sie beim Bayerischen Landesamt für Schule</li>\n  <li class=\"unordered-list-item--dash\">Die Schule muss staatlich anerkannt oder genehmigt sein.</li>\n  <li class=\"unordered-list-item--dash\">Leistungen werden erst gewährt, wenn die Schule mindestens zwei Jahre ohne wesentliche Beanstandungen durch die Schulaufsicht betrieben wurde .</li>\n  <li class=\"unordered-list-item--dash\">Die Schule muss mindestens 14 Schülerinnen und Schüler haben.</li>\n  <li class=\"unordered-list-item--dash\">Der Personalaufwand ist nur förderfähig, wenn ein ausreichender Anteil qualifizierter Lehrkräfte beschäftigt wird. Bei mehr als 25 % Lehrkräften der Besoldungsgruppe A 10 oder niedriger erfolgt eine Kürzung des Zuschusses.</li>\n</ul>"
                                                                                                                                         ];
