                                xyz:beschreibung         "<p>Die Zuwendung dient der Unterstützung des Ausbaus gigabitfähiger Breitbandnetze im Freistaat Bayern.</p><p>Sie ergänzt die Bundesförderung und soll dazu beitragen, eine leistungsfähige digitale Infrastruktur flächendeckend bereitzustellen.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Infrastruktur" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Kommunen" ];
                                xyz:foerderprogramm      "Bayerische Kofinanzierungs-Gigabitrichtlinie (KofGibitR)";
                                xyz:foerderzeitraum.bis  "2029-06-30T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2023-08-01T00:00:00.000+00:00";
                                xyz:schluessel           "99ae93c7-9229-4dea-b0e1-7186e01a41da";
                                xyz:teaser               "Der Freistaat Bayern fördert den Ausbau von gigabitfähigen Netzen.";
                                xyz:titel                "Bayerische Kofinanzierungs-Gigabitrichtlinie 2.0 - KofGibitR 2.0";
                                xyz:titel.tokens         [ rdf:_1  "Bayerische Kofinanzierungs-Gigabitrichtlinie 2.0 - KofGibitR 2.0" ];
                                xyz:voraussetzung        "<p>Eine Förderung wird nur gewährt, wenn:</p><ul><li class=\"unordered-list-item--dash\">die Maßnahme nach der Gigabit-Richtlinie des Bundes 2.0 gefördert wird und</li><li class=\"unordered-list-item--dash\">ein entsprechender Zuwendungsbescheid des Bundesministeriums für Digitales und Staatsmodernisiserung oder des beauftragten Projektträgers in endgültiger Höhe vorliegt.</li></ul><p>Bei Betreibermodellen, die mehrere Kommunen umfassen, kann mit Zustimmung des Bayerischen Staatsministeriums der Finanzen und für Heimat eine Förderung auch auf Grundlage eines vorläufigen Bundesbescheids bewilligt werden.</p>"
                              ];
