                                                                                                                       xyz:handlungsgrundlagen        [ xyz:verweis  [ rdf:_1  [ xyz:bezeichnung  "Art. 44 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)";
