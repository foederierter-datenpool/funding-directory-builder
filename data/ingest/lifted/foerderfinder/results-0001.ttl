                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Förderfähig sind ausschließlich die nachfolgend aufgeführten Ausgaben:</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">Vergütungen für direkt dem Projekt zurechenbares Eigen- und Fremdpersonal - Lehrkräfte (Kostenposition 1.1)</li>\n  <li class=\"unordered-list-item--dash\">Bildungs- und Betreuungspersonal (ohne Lehrkräfte) durch Dritte (Kostenposition 1.2)</li>\n  <li class=\"unordered-list-item--dash\">Bildungs- und Betreuungspersonal (ohne Lehrkräfte) durch Eigenmittel (Kostenposition 1.3)</li>\n  <li class=\"unordered-list-item--dash\">Restkosten (Kostenposition 5)</li>\n</ul>"
                                                                                                                                         ];
