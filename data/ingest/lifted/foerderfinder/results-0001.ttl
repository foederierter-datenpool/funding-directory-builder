                                                                                                                                                                                                            xyz:listVersionID  "1"
                                                                                                                                                                                                          ]
                                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:euBeihilferelevanz        "nein";
                                                                                                                                           xyz:finanzierungsartUndHoehe  "<p>Zuschuss in Höhe von 375 Euro je Ausbildungsmonat (Festbetrag) bis zu 16 Monate aus Mitteln des Europäischen Sozialfonds Plus (ESF+), insgesamt bis zu 6.000 Euro.</p>";
