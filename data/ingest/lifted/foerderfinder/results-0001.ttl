                                                                                                                                                                                                  ];
                                                                                                                                                                                          rdf:_3  [ xyz:bezeichnung   "Finanzierungsplan";
                                                                                                                                                                                                    xyz:erlaeuterung  "Der Finanzierungsplan muss neben der Antragssumme auch Projekteinnahmen, Zuwendungen Dritter (z.B. Kommune), sonstige Finanzierungsbeteiligungen (Spenden, Sponsoren) sowie die vom Antragsteller zu erbringende Eigenbeteiligung ausweisen."
                                                                                                                                                                                                  ]
