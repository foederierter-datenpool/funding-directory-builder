                                                           rdf:_15  "Feuerwehr Beantragung einer staatlichen Förderung für die Beschaffung von Feuerwehrfahrzeugen und geräten sowie den Bau von Feuerwehrhäusern";
                                                           rdf:_16  "sowie";
                                                           rdf:_2   "beantragung";
                                                           rdf:_3   "feuerwehrfahrzeugförderung";
                                                           rdf:_4   "geräte";
                                                           rdf:_5   "feuerwehren";
                                                           rdf:_6   "förderung";
