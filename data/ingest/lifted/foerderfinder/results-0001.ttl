                                                                                                             xyz:foerdergebiet           [ xyz:laender  [ xyz:land  [ xyz:code           "BY";
                                                                                                                                                                      xyz:listURI        "urn:xoev-de:pks:codeliste:bundesland";
                                                                                                                                                                      xyz:listVersionID  "1";
                                                                                                                                                                      xyz:name           ""
                                                                                                                                                                    ]
                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergegenstand       [ xyz:beschreibung
                                                                                                                               "<p>Jährlich können Preise für wissenschaftliche Arbeiten, wie Bachelor- oder Masterarbeiten sowie Dissertationen oder Habilitationen, vergeben werden. Dadurch sollen praxisrelevante Erkenntnisse zur Verbesserung der Lebenssituation Betroffener und ihrer An- und Zugehörigen generiert werden.&nbsp;</p><p>Die Preise bestehen jeweils aus einer Urkunde und einer Geldprämie in Höhe von 1.000 EUR. Vergeben werden bis zu drei Preise pro Jahr.&nbsp;</p><p>Weitere Informationen für eine Antragstellung bzw. Bewerbung finden Sie auf der Website des Bayerischen Demenzfonds.</p>" ];
                                                                                                             xyz:foerdernehmende         [ xyz:beschreibung     "Absolventinnen und Absolventen sowie Nachwuchswissenschaftlerinnen und Nachwuchswissenschaftler aus unterschiedlichen Fachrichtungen können sich für die Preisverleihung bewerben. Willkommen sind wissenschaftliche Arbeiten aus den Bereichen Pflegewissenschaft, Psychologie, Architektur, Gerontologie sowie anderen Fachrichtungen. Es können sich aber auch Verbände, Vereine, Kommunen, Schulen, Organisationen und Einrichtungen des Gesundheits- und Sozialwesens, Körperschaften des öffentlichen Rechts sowie Unternehmen für die Preisverleihung bewerben.";
                                                                                                                                           xyz:foerdernehmende  [ xyz:code           "001";
                                                                                                                                                                  xyz:listURI        "urn:xoev-de:stmd:codeliste:foerdernehmende";
                                                                                                                                                                  xyz:listVersionID  "1";
                                                                                                                                                                  xyz:name           ""
                                                                                                                                                                ]
                                                                                                                                         ];
