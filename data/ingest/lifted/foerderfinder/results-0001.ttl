                                                       ];
                                xyz:schluessel         "1cc7921d-78ad-4ad0-8551-c4fa7f034c62";
                                xyz:teaser             "Der Freistaat fördert Pilotprojekte und Demonstrationsvorhaben zur\nbeschleunigten Einführung neuer Verkehrstechnologien sowie innovative\nLogistikkonzepte und Einzelmaßnahmen zur Optimierung des\n(Schienen-)Güterverkehrs.";
                                xyz:titel              "Verkehrstechnologien und Logistikkonzepte; Beantragung einer Förderung";
                                xyz:titel.tokens       [ rdf:_1  "Verkehrstechnologien und Logistikkonzepte";
                                                         rdf:_2  "Beantragung einer Förderung"
                                                       ];
                                xyz:voraussetzung      "<p>Es darf kein vorzeitiger Maßnahmenbeginn vorliegen, d. h. es dürfen noch keine Verträge hinsichtlich der Maßnahmen geschlossen worden sein. Vor der Antragstellung sollte Kontakt mit dem Bayerischen Staatsministerium für Wohnen, Bau und Verkehr aufgenommen werden, um die spezifischen Anforderungen hinsichtlich des Antrages zu klären.</p>\n<p>Empfänger der Zuwendung können Privatpersonen, juristische Personen des &nbsp;privaten oder des öffentlichen Rechtes und auch öffentliche oder private &nbsp;Unternehmen sein.</p>"
                              ];
