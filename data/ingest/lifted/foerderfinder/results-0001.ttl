                                                                                                                                           xyz:rechtsbehelf             "<p>Verwaltungsgerichtliche Klage.</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<p>Der Förderantrag ist unterzeichnet und digital (einschließlich sämtlicher Anlagen) beim Bayerischen Landesamt für Pflege einzureichen. Lediglich Pläne sind im Original vorzulegen. Über alle innerhalb der Frist eingegangenen Anträge wird nach pflichtgemäßem Ermessen und im Rahmen der zu Verfügung stehenden Haushaltsmittel entschieden.</p>";
                                                                                                                                                                          xyz:erlaeuterungVorzeitigerMassnahmebeginn
                                                                                                                                                                                  "<p>Einen ggf. notwendigen vorzeitigen Maßnahmebeginn beantragen Sie bitte mit entsprechender Begründung beim Landesamt für Pflege.</p>";
                                                                                                                                                                          xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "002";
                                                                                                                                                                                                            xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
                                                                                                                                                                                                            xyz:listVersionID  "1"
                                                                                                                                                                                                          ]
                                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:finanzierungsartUndHoehe  "<p>Die Höhe der Zuwendung beträgt bis zu 60.000 Euro pro neu geschaffenem Platz bei Dauerpflegeplätzen und bis zu 70.000 Euro pro neu geschaffenem Platz bei Plätzen des Kurzzeitwohnens.</p><p>Bei neu geschaffenen Pflegeplätzen handelt es sich um eine Festbetragsfinanzierung.</p><p>Umbau- und Modernisierungsmaßnahmen werden durch eine Anteilsfinanzierung mit:</p><p>a) bis zu 40 Prozent der zuwendungsfähigen Ausgaben bei vollstationären Dauerpflegeplätzen, höchstens 60.000 Euro pro Dauerpflegeplatz</p><p>b) bis zu 60 Prozent der zuwendungsfähigen Ausgaben bei Plätzen des Kurzzeitwohnens, höchstens 70.000 Euro pro Kurzzeitwohnplatz.</p><p>Umbau- und Modernisierungsmaßnahmen können nur gefördert werden, wenn nachgewiesen wird, dass ansonsten der Pflegeplatz ersatzlos wegfallen würde.</p><p>Insgesamt können maximal bis zu 90 Prozent der zuwendungsfähigen Ausgaben aus Zuwendungen oder sonstigen</p><p>Drittmitteln finanziert werden. Der Zuwendungsempfänger muss einen Eigenanteil von mindestens 10 Prozent der zuwendungsfähigen Gesamtausgaben erbringen.</p>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "001";
                                                                                                                                                                                                    xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
                                                                                                                                                                                                    xyz:listVersionID  "1";
                                                                                                                                                                                                    xyz:name           ""
                                                                                                                                                                                                  ]
                                                                                                                                                                         ];
