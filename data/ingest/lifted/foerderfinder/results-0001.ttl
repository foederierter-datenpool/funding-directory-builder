                                xyz:beschreibung         "<p>Der Freistaat Bayern gewährt Zuwendungen zur Verbesserung des öffentlichen</p><p>Personennahverkehrs.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Anteilsfinanzierung/Kapitalbeteiligung" ];
                                xyz:foerderbereich       [ rdf:_1  "Energieeffizienz und Erneuerbare Energien";
