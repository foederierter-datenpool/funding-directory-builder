                                xyz:xml   "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           produkt=\"Förderfinder\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produktversion=\"\"\n                                           standard=\"XFLB\"\n                                           test=\"\"\n                                           version=\"2.0.0\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0 xflb.xsd\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>bc98a853-db5b-4ceb-84ca-992215769623</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-03-12T16:13:09</xflb:erstellungszeitpunkt>\n      <xflb:sender>Förderfinder Suche (Bayern)</xflb:sender>\n      <xflb:empfaenger>XFLB-Connect (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>bc98a853-db5b-4ceb-84ca-992215769623</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>bc98a853-db5b-4ceb-84ca-992215769623</xflb:schluessel>\n         <xflb:versionFLB>3</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Wirtschaft, Landesentwicklung und Energie</xflb:verantwortlichesMinisterium>\n               <xflb:ablaufdatumRichtlinie>2026-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmtitel>Bayerisches Förderprogramm zum Aufbau einer Elektrolyseur-Infrastruktur in Bayern</xflb:programmtitel>\n               <xflb:verantwortlichesFachreferat>Referat 85 \"Gasinfrastruktur, Wasserstoff, Versorgung mit Energieträgern\"</xflb:verantwortlichesFachreferat>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.verkuendung-bayern.de/baymbl/2023-358/</xflb:link>\n                     <xflb:bezeichnung>Bayerisches Förderprogramm zum Aufbau einer Elektrolyseur-Infrastruktur in Bayern</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:programmlaufzeit>\n                  <xflb:endeLaufzeitFoerderprogramm>2026-12-31</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:beginnLaufzeitFoerderprogramm>2023-07-27</xflb:beginnLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>bc98a853-db5b-4ceb-84ca-992215769623</xflb:foerderschluessel>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n                  <xflb:flbVersion>3</xflb:flbVersion>\n               </xflb:interneKennung>\n            </xflb:zuordnungen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name>Bayern</name>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Elektrolyseure zur Produktion von erneuerbarem Wasserstoff</xflb:titel>\n               <xflb:allgemeineFragen>\n                  <xflb:name>VDI Technologiezentrum GmbH</xflb:name>\n                  <xflb:telefonnummer>+49 211 6214 - 401</xflb:telefonnummer>\n                  <xflb:email>vditz@vdi.de</xflb:email>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n                  <xflb:verweis>\n                     <xflb:link>https://www.vditz.de/bayfeli</xflb:link>\n                     <xflb:bezeichnung>Link zur Internetseite des Projektträgers</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:adresse>\n                     <xflb:strasse>VDI-Platz 1</xflb:strasse>\n                     <xflb:hausnummerPostfach>Postfach 10 11 39, 40002 Düsseldorf</xflb:hausnummerPostfach>\n                     <xflb:postleitzahl>40468</xflb:postleitzahl>\n                     <xflb:ort>Düsseldorf</xflb:ort>\n                  </xflb:adresse>\n               </xflb:allgemeineFragen>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>Ziel der Förderung ist es, regionale Wasserstoffproduktionskapazitäten zur anteiligen Deckung des mittelfristig steigenden Wasserstoffbedarfs in Bayern aufzubauen. Die bayerische Wasserstoff-Roadmap zeigt für Bayern einen schnell wachsenden Bedarf an vorzugsweise grünem Wasserstoff auf. Der Aufbau heimischer Produktionskapazitäten für grünen Wasserstoff soll dabei vom Ausbau zusätzlicher Erneuerbaren-Energien-Anlagen in Bayern begleitet werden. Gleichzeitig wird mit der Förderung ein Anschub geleistet, um Technologiekompetenz zu demonstrieren, lokale Wertschöpfung zu ermöglichen, die Importabhängigkeit im Bereich grüner Wasserstoff so gering wie möglich zu halten und somit insbesondere Wettbewerbs- und Standortvorteile für die Bayerische Wirtschaft zu generieren, um Bayerns führende Rolle im Wettlauf um die künftige globale Wasserstoffwirtschaft auszubauen.</xflb:zuwendungszweck>\n                  <xflb:teaser>Förderung von Elektrolyseuren zur Erzeugung von erneuerbarem Wasserstoff</xflb:teaser>\n               </xflb:beschreibung>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Projektträger VDI TZ GmbH</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Im Rahmen dieses Programms werden Förderungen für Investitionen in die Neuerrichtung von Elektrolyseuren und unmittelbar damit verbundene Anlagenbestandteile zur bedarfsgerechten Erzeugung von ausschließlich erneuerbarem Wasserstoff gewährt.&lt;/p&gt;\n&lt;p&gt;Im Rahmen dieses Programms werden Förderungen für Investitionen in die Neuerrichtung von Elektrolyseuren und unmittelbar damit verbundene Anlagenbestandteile zur bedarfsgerechten Erzeugung von ausschließlich erneuerbarem Wasserstoff vor Ort i. S. v. Art. 2 Nr. 102c AGVO durch eine einmalige Zuwendung auf Basis des Art. 41 AGVO gewährt.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>002</code>\n                  <name>Kleine und mittlere Unternehmen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>003</code>\n                  <name>Einzelunternehmen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>005</code>\n                  <name>Großunternehmen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name>Vereine</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>004</code>\n                  <name>Unternehmen mit ausländischem Mehrheitsbesitz</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>006</code>\n                  <name>Forschungseinrichtungen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name>Verbände</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name>Privatpersonen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name>Stiftungen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name>Kommunen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>008</code>\n                  <name>Behörden</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>007</code>\n                  <name>Freiberufler</name>\n               </xflb:foerdernehmende>\n            </xflb:foerdernehmende>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>Das Vorhaben muss im Freistaat Bayern durchgeführt werden. \n\nDie Elektrolyseure müssen eine Mindestleistung von 1 MW haben und zu 100 Prozent mit Strom aus erneuerbaren Energiequellen nach Art. 2 Nr. 109 AGVO betrieben werden. Bei Vorhaben im Bereich des erneuerbaren Wasserstoffs, die einen Elektrolyseur und eine oder mehrere Einheiten zur Erzeugung erneuerbarer Energien nach einem einzigen Netzanschlusspunkt beinhalten, darf nach Art. 41 Abs. 3 Satz 2 AGVO die Kapazität des Elektrolyseurs die Gesamtkapazität der Einheiten zur Erzeugung erneuerbarer Energien nicht überschreiten.</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>Nicht gefördert werden Vorhaben, die bereits begonnen wurden, ohne dass eine Zustimmung zum vorzeitigen Vorhabenbeginn vorgelegen hat, oder die im Auftrag von nicht am Projekt beteiligten Dritten durchgeführt werden. Als Vorhabenbeginn ist grundsätzlich die Abgabe einer verbindlichen Willenserklärung zum Abschluss eines der Ausführung zuzurechnenden Lieferungs- und Leistungsvertrags zu werten. Planung und Genehmigungsverfahren gelten nicht als Beginn des Vorhabens.</xflb:ausschlusskriterien>\n               <xflb:rechtlicheBeschreibung>Antragsberechtigt sind juristische Personen des öffentlichen und des Privatrechts sowie natürliche Personen, soweit sie wirtschaftlich tätig sind und zum Zeitpunkt der Auszahlung ihren Sitz, Niederlassung oder eine Betriebsstätte im Freistaat Bayern haben. Die Definition der KMU richtet sich nach Anhang I AGVO. Unternehmen in Schwierigkeiten gemäß Art. 1 Abs. 4 Buchst. c) AGVO in Verbindung mit Art. 2 Nr. 18 AGVO werden nicht gefördert. Dies gilt insbesondere für Antragsteller, über deren Vermögen ein Insolvenzverfahren beantragt oder eröffnet worden ist. Dasselbe gilt für Antragsteller und, sofern der Antragsteller eine juristische Person ist, für dessen gesetzlichen Vertreter, die eine eidesstattliche Versicherung nach § 807 ZPO oder § 284 AO abgegeben haben oder zu deren Abgabe verpflichtet sind. Unternehmen, die einer Rückforderungsanordnung aufgrund einer früheren Kommissionsentscheidung zur Feststellung der Rechtswidrigkeit und Unvereinbarkeit einer Beihilfe mit dem Binnenmarkt nicht Folge geleistet haben, werden ebenfalls nicht gefördert, vgl. Art. 1 Abs. 4 Buchst. a) AGVO.</xflb:rechtlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:finanzierung>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>Die Zuwendungssumme soll fünf Millionen Euro nicht überschreiten. Die Zuwendung (Beihilfeintensität) für die im Rahmen des Vorhabens gemachten Ausgaben beträgt bis zu 45 % der zuwendungsfähigen Ausgaben gem. Art. 41 Abs. 7 Buchst. a) AGVO. Bei Beihilfen für mittlere Unternehmen kann die Intensität um bis zu 10 Prozentpunkte, bei Beihilfen für kleine Unternehmen um bis zu 20 Prozentpunkte erhöht werden (Art. 41 Abs. 8 AGVO). Die tatsächliche Erhöhung der Beihilfeintensität wird durch den Zuwendungsgeber unter Berücksichtigung der wirtschaftlichen Leistungsfähigkeit des Zuwendungsempfängers und der Lage des Investitionsortes im Zuwendungsbescheid festgelegt.</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>Zuwendungsfähig sind die gesamten Investitionskosten, die für die Neuerrichtung von Elektrolyseuren und unmittelbar damit verbundene Anlagenbestandteile zur bedarfsgerechten Erzeugung von erneuerbarem Wasserstoff erforderlich sind (Art. 41 Abs. 6 AGVO). Nicht zuwendungsfähig sind die Ausgaben der Infrastruktur für die Verteilung und Übertragung des Wasserstoffs, Batterie-Speicher, zugehörige Stromerzeugungsanlagen und Anlagen zur Rückverstromung sowie für den Erwerb von Grundstücken. Ausgaben für den Betrieb der Anlage sind ebenfalls nicht zuwendungsfähig. Soweit die Umsatzsteuer nach § 15 des Umsatzsteuergesetzes (UStG) als Vorsteuer abziehbar ist, gehört sie nicht zu den zuwendungsfähigen Ausgaben.</xflb:zuwendungsfaehigeKosten>\n               <xflb:euBeihilferelevanz>Verordnung (EU) Nr. 651 2014 (Allgemeine Gruppenfreistellungsverordnung  AGVO); \nInvestitionsbeihilfen zur Förderung von erneuerbaren Energien, von erneuerbarem Wasserstoff und von hocheffizienter\nKraft-Wärme-Kopplung (Art. 41)</xflb:euBeihilferelevanz>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:zuwendungsart>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.vditz.de/bayfeli</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>Das Verfahren ist zweistufig gestaltet. In der ersten Verfahrensstufe können bis zu dem im jeweiligen Förderaufruf genannten Stichtag Projektskizzen eingereicht werden. Projektskizzen, die nach dem angegebenen Zeitpunkt eingehen, können nicht mehr berücksichtigt werden. Die eingereichten Projektskizzen stehen untereinander im Wettbewerb. Ausschließlich die zur Weiterverfolgung ausgewählten Vorhaben werden in der zweiten Verfahrensstufe elektronisch zur Einreichung eines Vollantrags aufgefordert. Die angelegten Bewertungskriterien, die notwendigen Unterlagen sowie die Antragsfrist werden in den jeweiligen Förderaufrufen veröffentlicht.</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>004</code>\n                     <name/>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristSpanne>\n                        <xflb:min>\n                           <xflb:wochen>8</xflb:wochen>\n                        </xflb:min>\n                        <xflb:max>\n                           <xflb:wochen>12</xflb:wochen>\n                        </xflb:max>\n                     </xflb:fristSpanne>\n                  </xflb:zeitlicheEingrenzung>\n               </xflb:antragsfrist>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:monate>2</xflb:monate>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:monate>3</xflb:monate>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n            </xflb:antragsinformationen>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-03-12T16:13:09</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>007</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>\n"
                              ]
            ];
  rdf:_134  [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index";
                                xyz:begriffeImKontext    [ rdf:_1  "Wasserversorgungsanlagen";
                                                           rdf:_2  "Zuwendungen zu Abwasserentsorgungsanlagen";
                                                           rdf:_3  "Förderung von Abwasseranlagen";
                                                           rdf:_4  "Zuwendungen zu Abwasserbeseitigung";
