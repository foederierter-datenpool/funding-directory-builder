                                                                                                                                                                                                    xyz:listVersionID  "1";
                                                                                                                                                                                                    xyz:name           ""
                                                                                                                                                                                                  ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Förderfähig sind die Gesamtkosten im Sinn der §§ 5 bis 8 der Zweiten Berechnungsverordnung (II. BV).</p>"
                                                                                                                                         ];
