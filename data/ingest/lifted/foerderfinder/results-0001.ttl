                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<p>Der Antrag ist mit sämtlichen benötigten Unterlagen schriftlich bei der örtlich zuständigen Regierung einzureichen. Nach Prüfung entscheidet die Regierung über die Bewilligung einer freiwilligen staatlichen Zuwendung.</p>";
                                                                                                                                                                          xyz:erlaeuterungVorzeitigerMassnahmebeginn
                                                                                                                                                                                  "<p>Baumaßnahmen dürfen nicht ohne vorherige Zustimmung der Regierung begonnen werden. Ansonsten ist die Bewilligung von Zuwendungen nach Art. 43 BaySchFG nicht mehr möglich.</p>";
                                                                                                                                                                          xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "002";
                                                                                                                                                                                                            xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
                                                                                                                                                                                                            xyz:listVersionID  "1"
                                                                                                                                                                                                          ]
                                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:finanzierungsartUndHoehe  "<p>Die Höhe der Förderung beträgt bis zu 50 % der zuwendungsfähigen Kosten nach analoger Anwendung der Richtlinien über die Zuweisungen des Freistaates Bayern zu kommunalen Baumaßnahmen im kommunalen Finanzausgleich (FA-ZR).&nbsp;</p>";
