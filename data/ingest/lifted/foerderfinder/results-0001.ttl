                                          ];
                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>0303340e-ac22-4050-8a7f-d15c448443a3</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-12-03T16:47:34</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>0303340e-ac22-4050-8a7f-d15c448443a3</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>0303340e-ac22-4050-8a7f-d15c448443a3</xflb:schluessel>\n         <xflb:versionFLB>14</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-12-03T16:47:34</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>0303340e-ac22-4050-8a7f-d15c448443a3</xflb:foerderschluessel>\n                  <xflb:flbVersion>14</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>09999000000001</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4a</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Förderung von Weiterbildungsinitiatorinnen und -initiatoren sowie einer Koordinationsstelle</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Die Weiterbildungsinitiatorinnen und -initiatoren (WBI) bieten allen Beschäftigten und Unternehmen in ganz Bayern eine kostenfreie Beratung zum Thema berufliche Weiterbildung an. Dabei zeigen sie passgenaue Weiterbildungsangebote und Fördermöglichkeiten auf und unterstützen bei der Auswahl dieser. Die WBI erstellen auch individuelle Weiterbildungskonzepte und begleiten auf Wunsch auch die Umsetzung der Maßnahme. Die WBI werden von einer zentralen Koordinationsstelle (WBI-K) gesteuert. Das Ziel der Förderung ist eine Erhöhung der Weiterbildungsbereitschaft in Bayern, die aufgrund der sich wandelnden Arbeitswelt, des demografischen Wandels und des Fachkräftebedarfs notwendig ist. Darüber hinaus erhalten und erhöhen berufliche Weiterbildungen die Beschäftigungsfähigkeit der Beschäftigten und die Wettbewerbsfähigkeit der Wirtschaft.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Die Förderung unterstützt Beratungsleistungen für Beschäftigte und Unternehmen, um die Weiterqualifizierung zu fördern und damit den Arbeitsmarkt zu stärken.</xflb:teaser>\n                  <xflb:schluesselwoerter>Berufliche Weiterbildung, Weiterbildung, Fortbildung, Qualifizierung, Beratung, Weiterbildungsinitiatoren</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Weiterführende Informationen auf der Webseite des Bayerischen Staatsministeriums für Familie, Arbeit und Soziales</xflb:bezeichnung>\n                     <xflb:link>https://www.stmas.bayern.de/arbeit/qualifizierung/index.php#sec4</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Übersicht zum Förderprogramm sowie der bayernweit tätigen Weiterbildungsinitiatorinnen und -initiatoren</xflb:bezeichnung>\n                     <xflb:link>https://www.kommweiter.bayern.de/inspiration-information/beratung/</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Staatsministerium für Familie, Arbeit und Soziales</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>9</xflb:hausnummerPostfach>\n                     <xflb:strasse>Winzererstraße</xflb:strasse>\n                     <xflb:postleitzahl>80797</xflb:postleitzahl>\n                     <xflb:ort>München</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>Referat-I2@stmas.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Webseite des Bayerischen Staatsministeriums für Familie, Arbeit und Soziales - Förderung von Weiterbildungsinitiatorinnen und -initiatoren und einer Koordinationsstelle</xflb:bezeichnung>\n                     <xflb:link>https://www.stmas.bayern.de/arbeit/qualifizierung/index.php#sec4</xflb:link>\n                  </xflb:verweis>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Zentrum Bayern Familie und Soziales</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>2</xflb:hausnummerPostfach>\n                           <xflb:strasse>Hegelstraße</xflb:strasse>\n                           <xflb:postleitzahl>95447</xflb:postleitzahl>\n                           <xflb:ort>Bayreuth</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Förderung der Stellen für Weiterbildungsinitiatorinnen und -initiatoren (WBI) sowie einer Stelle für den Koordinator der WBI (WBI-K)</xflb:bezeichnung>\n                           <xflb:link>https://www.zbfs.bayern.de/foerderung/arbeitswelt-berufsbildung/weiterbildungsinitiatoren/index.php</xflb:link>\n                        </xflb:verweis>\n                        <xflb:telefonnummer>+49921 605-3637</xflb:telefonnummer>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>ca32eb17-17a2-4088-8f0d-904933c99f55</xflb:id>\n                     <xflb:bezeichnung>Antragsformular</xflb:bezeichnung>\n                     <xflb:link>https://www.zbfs.bayern.de/imperia/md/content/blvf/esf/landesmittel/forderantrag_wbi_u_wbi-k.pdf</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>4a6bf5b6-c49d-41be-9673-77031b0dd61b</xflb:id>\n                     <xflb:bezeichnung>Auszahlungsantrag</xflb:bezeichnung>\n                     <xflb:link>https://www.zbfs.bayern.de/imperia/md/content/blvf/esf/landesmittel/auszahlungsantrag_wbi_u_wbi-k_02-2024.pdf</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>002</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>003</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>005</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>006</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Zuwendungsempfänger sind alle rechtsfähigen Träger, die über die erforderliche Zuverlässigkeit und Leistungsfähigkeit zur Durchführung dieser Maßnahmen verfügen. Insbesondere müssen die Zuwendungsempfänger über Personal verfügen, welches entsprechend der Anforderungen gemäß Nr. 4 als WBI oder WBI-K eingesetzt werden kann.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Förderart:&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Projektförderung in Form einer Anteilfinanzierung als nicht zurückzahlbarer Zuschuss auf Basis der zuwendungsfähigen Ausgaben&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Förderhöhe:&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bis zu 90 % der zuwendungsfähigen Ausgaben&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Eigenmittel: mindestens 10 % der zuwendungsfähigen Ausgaben&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Zuwendungsfähige Ausgaben:&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;WBI:&amp;nbsp;Personalausgaben: Beschränkung auf den vom Bayerischen Staatsministerium der Finanzen und für Heimat veröffentlichten Personalausgabenhöchstsatz für die Entgeltgruppe E10. Ist das tatsächliche vom Zuwendungsempfänger gezahlte Bruttoentgelt einschließlich der Arbeitgeberanteile zur Sozialversicherung, der Umlage zur Zusatzversorgung, der Jahressonderzahlung und der vermögenswirksamen Leistungen niedriger als der Personalausgabenhöchstsatz, ist dieses heranzuziehen. Direkte Sachausgaben: höchstens 15 % der förderfähigen Personalausgaben&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;WBI-K:&amp;nbsp;Personalausgaben: Beschränkung auf den vom Bayerischen Staatsministerium der Finanzen und für Heimat veröffentlichten Personalausgabenhöchstsatz für die Entgeltgruppe E13. Ist das tatsächliche vom Zuwendungsempfänger gezahlte Bruttoentgelt einschließlich der Arbeitgeberanteile zur Sozialversicherung, der Umlage zur Zusatzversorgung, der Jahressonderzahlung und der vermögenswirksamen Leistungen niedriger als der Personalausgabenhöchstsatz, ist dieses heranzuziehen. Direkte Sachausgaben: höchstens 20 % der förderfähigen Personalausgaben&lt;/li&gt;&lt;/ul&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Es werden ausschließlich projektbezogene Personalausgaben und direkte Sachausgaben gefördert.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n               <xflb:euBeihilferelevanz>Eine EU-Beihilferelevanz ist nicht zu beachten.</xflb:euBeihilferelevanz>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Familie, Arbeit und Soziales</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinie zur Förderung von Weiterbildungsinitiatorinnen und -initiatoren zur Qualifizierungsberatung und einer Koordinationsstelle für den Förderzeitraum von 2025 bis 2027 (WBI-Förderrichtlinie)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_7075_A_14505/true</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>StMAS, Referat I2</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Richtlinie zur Förderung von Weiterbildungsinitiatorinnen und -initiatoren zur Qualifizierungsberatung und einer Koordinationsstelle für den Förderzeitraum von 2025 bis 2027 (WBI-Förderrichtlinie)</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2027-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2025-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2027-12-31</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:verlaengerungsoption>nicht vorhanden</xflb:verlaengerungsoption>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Förderung der Beratungstätigkeit der WBI sowie einer Koordinationsstelle (WBI-K).&amp;nbsp;&lt;/p&gt;&lt;p&gt;Die Beratungstätigkeit ist jeweils örtlich auf einen der sieben bayerischen Regierungsbezirke zu konzentrieren, wobei eine bayernweite Abdeckung angestrebt wird. Es können sich mehrere WBI die Zuständigkeit für einen Regierungsbezirk untereinander aufteilen.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>002</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>004</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Für die Tätigkeit der WBI bzw. der oder des WBI-K sind folgende Qualifikationen und Fähigkeiten erforderlich:&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;(Fach-)Hochschulabschluss oder gleichwertige berufliche Qualifikation mit mehrjähriger Berufserfahrung (WBI) beziehungsweise abgeschlossene wissenschaftliche Hochschulbildung (WBI-K) und nachgewiesene Kenntnisse im Bereich der beruflichen Fort- und Weiterbildung,&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Erfahrungen und Kenntnisse in der Weiterbildungsberatung, dem Arbeitsrecht, dem Arbeitsförderungsrecht, dem Förderwesen, sowie Kenntnisse der Verwaltungsstrukturen oder die Bereitschaft, sich in diese Themen zügig und intensiv einzuarbeiten,&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Kenntnisse über die Zusammenarbeit der regionalen Arbeitsmarktakteure (Sozialpartnerschaft) und&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;hohe Organisationsfähigkeit und Flexibilität, Weiterbildungsbereitschaft, hohe Motivation (insbesondere auch zur Netzwerkarbeit), Teamfähigkeit und Engagement.&lt;/li&gt;&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.zbfs.bayern.de/imperia/md/content/blvf/esf/landesmittel/forderantrag_wbi_u_wbi-k.pdf</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Schriftliche oder elektronische Antragstellung mit dem vorgegebenen Antragsformular beim Zentrum Bayern Familie und Soziales. Dem Antrag ist ein ausführliches Konzept (Projektbeschreibung) sowie alle im Antrag genannten Unterlagen beizufügen. Der oder die Antragstellende (Projektträger) erhält nach Bearbeitung ein Schreiben, mit dem er bzw. sie informiert wird, ob der Antrag angenommen wurde und zur weiteren Bearbeitung mit Feststellung der Höhe der Zuwendung geht oder abgelehnt wurde. Im Rahmen der Antragsbearbeitung kann ggf. eine weitere Sachermittlung nötig sein, um über die Förderung entscheiden zu können. Die Antragsbearbeitung wird - sofern sich der Antrag nicht anderweitig erledigt - mit einem Bewilligungs- oder Ablehnungsbescheid abgeschlossen.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:sonstige>ja</xflb:sonstige>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Der Antrag ist schriftlich oder elektronisch bis spätestens 1. Oktober des Vorjahres zu stellen (Anträge mit Projektbeginn 1. Januar 2027 müssen bis zum 1. Oktober 2026 bei der Bewilligungsbehörde eingehen).</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Antragsformular nebst dort genannter Unterlagen</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Konzept</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Dem Antragsformular ist ein ausführliches Konzept beizulegen, welches das Projekt beschreibt.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Vereinssatzung oder Gesellschaftsvertrag und Auszug aus dem Vereins- oder Handelsregister</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Sofern vorhanden, fügen Sie diesen bitte bei.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Freistellungsbescheid soweit steuerbegünstigte Zwecke verfolgt werden</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Wenn Ihr Verein steuerbegünstigte Zwecke verfolgt, ist dieser Bescheid beizufügen.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Anlage \"Erfüllung der Fördervoraussetzungen\"</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Dieses Dokument bestätigt, dass die Voraussetzungen für die Förderung erfüllt sind.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Anlage \"Tätigkeitsbeschreibung\"</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Eine genaue Beschreibung der vorgesehenen Tätigkeiten im Rahmen des Projekts.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Lebenslauf</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Der Lebenslauf der für das Projekt vorgesehenen Person(en).</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Zeugnisse</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Relevante Qualifikationsnachweise der beteiligten Person(en).</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>ggf. weitere Unterlagen</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Zulässiger Rechtsbehelf ist die Klage beim örtlich zuständigen Verwaltungsgericht&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
