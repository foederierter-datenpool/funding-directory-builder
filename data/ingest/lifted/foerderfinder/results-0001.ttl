                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>24bf6ee0-b8fa-4beb-ac37-0856883e9f67</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-07-16T15:27:44</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>24bf6ee0-b8fa-4beb-ac37-0856883e9f67</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>24bf6ee0-b8fa-4beb-ac37-0856883e9f67</xflb:schluessel>\n         <xflb:versionFLB>8</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-07-16T15:27:44</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>24bf6ee0-b8fa-4beb-ac37-0856883e9f67</xflb:foerderschluessel>\n                  <xflb:flbVersion>8</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400242017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Radikalisierungsprävention; Beantragung einer Förderung für Projekte</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Ziel ist die Entwicklung, Erprobung, Durchführung und Bewertung von Maßnahmen zur Prävention von Salafismus/Islamismus, Rechts- und Linksradikalismus sowie Antisemitismus mit Bedeutung für ganz Bayern.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Vereine, Kommunen, Initiativen oder Zusammenschlüsse, die mit Projekten auf die Thematik Salafismus/Islamismus, Rechtsradikalismus, Linksradikalismus oder Antisemitismus aufmerksam machen möchten, können durch den Freistaat Bayern gefördert werden.</xflb:teaser>\n                  <xflb:schluesselwoerter>Zivilgesellschaft, Linksextremismus, Linksradikalismusprävention, Extremismus, Salafismusprävention, Islamfeindlichkeit, Antisemitismus, Rechtsextremismus, Rechtsradikalismusprävention, Salafismus, Islamismus, Radikalisierung, Muslimfeindlichkeit, Prävention</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Bayerns Netzwerk zur Prävention und Deradikalisierung gegen Salafismus - Projekte in Bayern</xflb:bezeichnung>\n                     <xflb:link>http://www.antworten-auf-salafismus.de/unser-netzwerk/projekte-bayern/index.php</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Radikalisierungsprävention</xflb:bezeichnung>\n                     <xflb:link>http://www.stmas.bayern.de/radikalisierungspraevention/index.php</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Antworten auf Salafismus</xflb:bezeichnung>\n                     <xflb:link>https://www.antworten-auf-salafismus.de/</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Staatsministerium für Familie, Arbeit und Soziales - Referat Radikalisierungsprävention</xflb:name>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Informationen Radikalisierungsprävention</xflb:bezeichnung>\n                     <xflb:link>https://www.stmas.bayern.de/radikalisierungspraevention/index.php</xflb:link>\n                  </xflb:verweis>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Regierung von Mittelfranken - Sachgebiet 15 - Integration und Förderung, Ausgleichsamt; bayernweite Zuständigkeit (Kontakt für allgemeine Fragen zur Förderleistung: Bayerisches Staatsministerium für Familie, Arbeit und Soziales - Referat Radikalisierungsprävention)</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>21</xflb:hausnummerPostfach>\n                           <xflb:strasse>Marienstr.</xflb:strasse>\n                           <xflb:postleitzahl>90402</xflb:postleitzahl>\n                           <xflb:ort>Nürnberg</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>sachgebiet-15.integration@reg-mfr.bayern.de</xflb:email>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Radikalisierungsprävention; Beantragung einer Förderung für Projekte</xflb:bezeichnung>\n                           <xflb:link>https://www.regierung.mittelfranken.bayern.de/aufgaben/40027/57461/leistung/leistung_46360/index.html</xflb:link>\n                        </xflb:verweis>\n                        <xflb:telefonnummer>+49 (0)911 2352-0</xflb:telefonnummer>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>002</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>003</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>005</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>006</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>008</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Antragsberechtigt sind rechtsfähige Trägerinnen und Träger mit Bezug zur Radikalisierungsprävention, jedoch keine Einzelpersonen.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Zuwendung wird als Anteilfinanzierung im Rahmen einer Projektförderung gewährt. Ein angemessener Eigenmittelanteil in Höhe von zehn Prozent (10 %) der zuwendungsfähigen Gesamtausgaben wird vorausgesetzt.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Gefördert werden können Sach-, Personal- und Verwaltungskosten gemäß Radikalisierungspräventionsrichtlinie (RPR).&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n               <xflb:euBeihilferelevanz>Nein</xflb:euBeihilferelevanz>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Familie, Arbeit und Soziales</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 23 und 44 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO-G1</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinie für die Förderung von Maßnahmen zur Prävention von politischer und religiös begründeter Radikalisierung (Radikalisierungspräventionsrichtlinie - RPR)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2179_A_15551/true</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat VI2 - Radikalisierungsprävention</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Radikalisierungsprävention; Beantragung einer Förderung für Projekte</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2028-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2026-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2028-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Projekte zur Radikalisierungsprävention können durch den Freistaat Bayern gefördert werden. Beispielsweise können Projekte finanziert werden, die gegen radikale Positionen stark machen oder die verschiedenen Akteure vor Ort miteinander vernetzen oder sensibilisieren.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>004</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Es muss&lt;/p&gt;\n&lt;ul&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;ein digitaler Antrag mit den von der Bewilligungsbehörde zur Verfügung gestellten Mustern gestellt werden und&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;bei der Finanzierung ein Eigenanteil von zehn Prozent der zuwendungsfähigen Gesamtausgaben durch Eigenmittel gemäß Radikalisierungspräventionsrichtlinie - RPR erbracht werden.&lt;/li&gt;\n&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>http://www.stmas.bayern.de/radikalisierungspraevention/index.php</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Es kann Kontakt zum \"Referat VI2 - Radikalisierungsprävention\" im Bayerischen Staatsministerium für Familie, Arbeit und Soziales aufgenommen werden, um das Interesse und die Möglichkeiten einer etwaigen Förderung abzuklären.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Bei gegenseitigem Einvernehmen werden die Formulare (Antragsformulare) von der zuständigen Bewilligungsbehörde, der Regierung von Mittelfranken, zur Förderung zugesandt.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Der Antrag ist grundsätzlich schriftlich einzureichen, die Anlagen zum Antrag vollständig auszufüllen.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Für Rückfragen steht die Bewilligungsbehörde im Verfahren stets zur Verfügung.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>003</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:bearbeitungsdauer>\n                  <xflb:bewilligung>\n                     <xflb:dauerSpanne>\n                        <xflb:minDauer>\n                           <xflb:wochen>6</xflb:wochen>\n                        </xflb:minDauer>\n                        <xflb:maxDauer>\n                           <xflb:wochen>8</xflb:wochen>\n                        </xflb:maxDauer>\n                     </xflb:dauerSpanne>\n                  </xflb:bewilligung>\n               </xflb:bearbeitungsdauer>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristFest>\n                        <xflb:monate>2</xflb:monate>\n                     </xflb:fristFest>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Der Antrag muss jeweils am 31.08. eines Jahres für Förderanträge des Folgejahres eingereicht werden. Unter- und überjährige Förderungen sind nach Absprache möglich.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Antragsvordruck mit Ausgaben- und Finanzierungsplan (bei Bewilligungsbehörde anfordern)</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Projektkonzept ggf. erläuternde Unterlagen</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Verwaltungsrechtliche Klage&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_50   [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmwk/blfd/kulturfonds_kunst/index?caller=bpmvsdiobwgiytgytcmvtgindbgzqlaxkqvlgmhv2vtozyv4ar6vuoygjpsweeywtirp774me4sq34jqtm6o33h47iwknvj4kfyd7a5lzntit5enbekzpsmuch6yv2tq3w34fbcsmvglpjgisztwxvu4jq6x42yhw7vh6dz5rj5gie2zi4jdrhjy2vaqpckkb2e2j75g6eew4sh3abmbnvcwuvjixojuqalbj33xi8";
                                xyz:begriffeImKontext    [ rdf:_1  "kultureller Austausch";
                                                           rdf:_2  "Ausland"
                                                         ];
                                xyz:beschreibung         "<p>Förderung besonderer Vorhaben des kulturellen Austausches von professionellen Künstlerinnen und Künstlern. Das Fördergebiet umfasst ganz Bayern, ausgeschlossen sind Vorhaben in München und Nürnberg. Die kulturellen Vorhaben müssen überregionale, zumindest aber überörtliche Bedeutung haben. Zuständig für die Antragsbearbeitung ist die jeweilige Bezirksregierung, in deren Region das Vorhaben durchgeführt werden soll. Sofern das Vorhaben in mehreren Regierungsbezirken umgesetzt werden soll, ist die Bezirksregierung zuständig, in deren Region der Antragsteller seinen Sitz hat.&nbsp;</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Kultur, Medien und Sport" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Privatpersonen";
                                                           rdf:_2  "Kommunen";
                                                           rdf:_3  "Vereine";
                                                           rdf:_4  "Verbände";
                                                           rdf:_5  "Stiftungen"
                                                         ];
                                xyz:foerderprogramm      "Kulturfonds Bayern - Kunst";
                                xyz:foerderzeitraum.bis  "2028-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2025-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "bba9531d-3751-4ca3-bfa8-dfa95685f585";
                                xyz:teaser               "Der Freistaat Bayern fördert den kulturellen Austausch mit dem Ausland, die Präsentation bayerischer Kultur im Ausland und die Präsentation ausländischer Kultur in Bayern.";
                                xyz:titel                "G1-Förderung internationaler Begegnungen im Bereich Kunst und Kultur";
                                xyz:titel.tokens         [ rdf:_1  "G1-Förderung internationaler Begegnungen im Bereich Kunst und Kultur" ];
                                xyz:voraussetzung        "<p>Aus dem Kulturfonds, **Bereich Kunst** , können innovative kulturelle Projekte nichtstaatlicher Träger gefördert werden. Für regelmäßig wiederkehrende Veranstaltungen ist eine Anschubfinanzierung möglich. Die Vorhaben sollen grundsätzlich von überregionaler, zumindest aber von überörtlicher Bedeutung sein; Maßnahmen mit zuwendungsfähigen Gesamtkosten von weniger als 10.000 € können daher nicht gefördert werden. Das Fördergebiet umfasst ganz Bayern; grundsätzlich ausgeschlossen sind allerdings Vorhaben in München und Nürnberg. Eine gleichzeitige Förderung aus anderen staatlichen Förderansätzen (Mehrfachförderung) ist grundsätzlich ausgeschlossen. Die Förderung erfolgt nach Maßgabe der zur Verfügung stehenden Haushaltsmittel und ist grundsätzlich auf maximal 30 v. H. der zuwendungsfähigen Kosten begrenzt. Zuwendungen dürfen nur bewilligt werden, wenn mit dem Projekt noch nicht begonnen wurde. Gefördert werden die Präsentation ausländischer Kultur in Bayern, die Präsentation bayerischer Kultur im Ausland und kulturelle Gemeinschaftsprojekte bayerischer und ausländischer Künstlerinnen und Künstler.&nbsp;</p><p>Für Konzertreisen bayerischer Laienmusikensembles ins Ausland und den Besuch ausländischer Laienmusikensembles in Bayern steht ein gesondertes Förderprogramm der Bayerischen Musikrat gGmbH zur Verfügung.</p>"
                              ];
              xyz:id          "bba9531d-3751-4ca3-bfa8-dfa95685f585";
