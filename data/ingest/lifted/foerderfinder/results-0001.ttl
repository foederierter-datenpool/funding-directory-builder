                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>21fc0e2a-7409-4824-852f-b7c78779f295</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-01-24T09:12:10</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>21fc0e2a-7409-4824-852f-b7c78779f295</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>21fc0e2a-7409-4824-852f-b7c78779f295</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-01-24T09:12:10</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>21fc0e2a-7409-4824-852f-b7c78779f295</xflb:foerderschluessel>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Förderung literarischer Festivals und Veranstaltungen</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Förderung literarischer Festivals und Veranstaltungen&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern fördert die Durchführung professioneller literarischer Festivals und Veranstaltungen. Wenn Sie ein literarisches Festival oder eine Veranstaltung zur Literaturvermittlung planen, können Sie eine Förderung beantragen.</xflb:teaser>\n                  <xflb:schluesselwoerter>Literatur, Literaturförderung</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Förderung von literarischen Festivals und Veranstaltungen (Projektförderung)</xflb:bezeichnung>\n                     <xflb:link>https://www.stmwk.bayern.de/kunst-und-kultur/foerderung/literaturfoerderung.html</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Staatsministerium für Wissenschaft und Kunst</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>2</xflb:hausnummerPostfach>\n                     <xflb:strasse>Salvatorstraße</xflb:strasse>\n                     <xflb:postleitzahl>80333</xflb:postleitzahl>\n                     <xflb:ort>München</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>ReferatK.8@stmwk.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Grundsätze für die Förderung literarischer Festivals und Veranstaltungen</xflb:bezeichnung>\n                     <xflb:link>https://www.stmwk.bayern.de/kunst-und-kultur/foerderung/literaturfoerderung.html</xflb:link>\n                  </xflb:verweis>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Bayerisches Staatsministerium für Wissenschaft und Kunst</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>2</xflb:hausnummerPostfach>\n                           <xflb:strasse>Salvatorstraße</xflb:strasse>\n                           <xflb:postleitzahl>80333</xflb:postleitzahl>\n                           <xflb:ort>München</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>ReferatK.8@stmwk.bayern.de</xflb:email>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>007</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>008</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>006</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Natürliche und juristische Personen, die Träger eines förderfähigen Projekts sind</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Es werden Zuwendungen im Rahmen der Festbetragsfinanzierung bewilligt.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Zuwendungsfähig sind alle Ausgaben, die zur Durchführung eines förderfähigen Projekts notwendig sind.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Wissenschaft und Kunst</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Grundsätze für die Förderung literarischer Festivals und Veranstaltungen</xflb:bezeichnung>\n                     <xflb:link>https://www.stmwk.bayern.de/kunst-und-kultur/foerderung/literaturfoerderung.html</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>K.1</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Förderung und Pflege der Literatur</xflb:programmtitel>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2026-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2028-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert wird die Durchführung professioneller literarischer Festivals und Veranstaltungen, z. B. Veranstaltungen zur Literaturvermittlung, Veranstaltungen für kreatives Schreiben (unter Anleitung von Autorinnen/Autoren) und Lesungen, an denen mehrere Autorinnen/Autoren teilnehmen.&lt;/p&gt;&lt;p&gt;Die Förderung erfolgt als Projektförderung ohne Rechtsanspruch im Rahmen der verfügbaren Haushaltsmittel. Der Veranstaltung muss überörtliche Bedeutung zukommen. Eine Finanzierungsbeteiligung einer kommunalen Gebietskörperschaft ist grundsätzlich erforderlich. Zuwendungsfähig sind alle Kosten, die ausschließlich anlässlich der Durchführung des Projekts anfallen. Technische Reproduktionen (z. B. Druckkosten, CD) werden nicht gefördert. Die Zuwendung kann bis zu 50 % der zuwendungsfähigen Gesamtkosten betragen. Die Zuwendungshöhe richtet sich nach der Bedeutung des Projekts, nach der Leistungsfähigkeit des Zuwendungsempfängers, nach der Zahl der vorliegenden Anträge und nach den verfügbaren Haushaltsmitteln. Veranstaltungen, deren zuwendungsfähige Kosten den Betrag von 4.000 € nicht überschreiten, werden nicht gefördert (Bagatellgrenze).&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>013</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Der Projektträger/Zuwendungsempfänger muss seinen Sitz in Bayern haben.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:rechtlicheBeschreibung>&lt;p&gt;Mit der Maßnahme darf noch nicht begonnen worden sein, d. h., keine vertraglichen Verpflichtungen dürfen eingegangen sein. Erst ab Erteilung der Zustimmung zum vorzeitigen Vorhabenbeginn bzw. Bewilligung durch das Staatsministerium ist das möglich.&lt;/p&gt;</xflb:rechtlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Einzellesungen werden grundsätzlich nicht gefördert. Überwiegend vereinsinterne Veranstaltungen, Veranstaltungen mit kommerzieller Zielsetzung, Preisverleihungen, wissenschaftliche Veranstaltungen sowie die Vergabe von Druckkostenzuschüssen sind von einer Förderung ausgeschlossen.&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.stmwk.bayern.de/kunst-und-kultur/foerderung/literaturfoerderung.html</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Erst nach Bekanntgabe des Bayerischen Staatshaushalts kann über die Verteilung der im jeweiligen Haushaltsjahr verfügbaren Mittel entschieden werden und jeweils ein Zuwendungsbescheid erstellt werden.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>&lt;p&gt;Mit der Maßnahme darf noch nicht begonnen worden sein, d. h., dass zum Zeitpunkt der Antragstellung keine vertraglichen Verpflichtungen eingegangen sein dürfen.&lt;/p&gt;</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Antragsformular</xflb:bezeichnung>\n                     <xflb:erlaeuterung>https://www.stmwk.bayern.de/kunst-und-kultur/foerderung/literaturfoerderung.html</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Projektbeschreibung</xflb:bezeichnung>\n                     <xflb:erlaeuterung>detaillierte Projektbeschreibung mit Ort und Zeitpunkt der Veranstaltung, konzeptioneller Absicht und künstlerischen Mitteln ihrer Umsetzung</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Ausgaben- und Finanzierungsplan</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Ausgaben- und Finanzierungsplan mit den voraussichtlichen Einnahmen und Ausgaben einschließlich aller Zuschüsse</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Keine Angabe möglich&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
