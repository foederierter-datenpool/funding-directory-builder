                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>86433b44-7e53-4c58-9d02-119f0533b97b</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-01-26T13:30:35</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>86433b44-7e53-4c58-9d02-119f0533b97b</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>86433b44-7e53-4c58-9d02-119f0533b97b</xflb:schluessel>\n         <xflb:versionFLB>4</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-09-24T10:41:59</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>86433b44-7e53-4c58-9d02-119f0533b97b</xflb:foerderschluessel>\n                  <xflb:flbVersion>4</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>09999000000048</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4a</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Hebammenniederlassungsprämie für freiberufliche Hebammen</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Die Niederlassungsprämie in Höhe von einmalig bis zu 5.000 EUR soll der Anerken nung und Unterstützung von Hebammen dienen, die sich freiberuflich niederlassen wollen. Zusätzlich soll sie einen Anreiz schaffen, um freiberufliche Hebammen für eine Tätigkeit in der Hebammenhilfe zu gewinnen und die Attraktivität des Hebammenberufs zu stärken. Ziel der Zuwendung ist die Sicherung einer flächendeckenden, wohnortna hen Betreuung und Versorgung von werdenden Müttern und ihren Neugeborenen.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Wenn Sie sich als freiberufliche Hebammen in Bayern niederlassen wollen, können Sie u.U. die Hebammenniederlassungsprämie erhalten.</xflb:teaser>\n                  <xflb:schluesselwoerter>Niederlassungsprämie, Niederlassung, freiberufliche Hebammen, Gründung, Niederlassungsförderung, Prämie, Zuschuss, Hebamme, Hebammen in Bayern, Bayern</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Informationen zur Hebammenniederlassungsprämie</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/hebammenniederlassungspraemie/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Für Hebammen und Entbindungspfleger</xflb:bezeichnung>\n                     <xflb:link>https://www.stmgp.bayern.de/meine-themen/fuer-hebammen/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Bericht aus der Kabinettssitzung vom 03.12.2018 - Ministerrat bringt Gründerpaket auf den Weg</xflb:bezeichnung>\n                     <xflb:link>https://www.bayern.de/bericht-aus-der-kabinettssitzung-vom-3-dezember-2018/?seite=1617</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Berufsbild Hebamme/ Entbindungspfleger - Möglichkeiten der Aus- und Weiterbildung</xflb:bezeichnung>\n                     <xflb:link>https://www.stmgp.bayern.de/gesundheitsversorgung/gesundheitsberufe/hebammen/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>FAQ zur Hebammenniederlassungsprämie</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/wp-content/uploads/2024/01/240110_FAQ_HebNp.pdf</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Landesamt für Pflege - Hebammenniederlassungsprämie</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>4</xflb:hausnummerPostfach>\n                     <xflb:strasse>Mildred-Scheel-Straße</xflb:strasse>\n                     <xflb:postleitzahl>92224</xflb:postleitzahl>\n                     <xflb:ort>Amberg</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>niederlassungspraemie@lfp.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Landesamt für Pflege</xflb:bezeichnung>\n                     <xflb:link>http://www.lfp.bayern.de/</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>+49 (0) 9621 9669-2500</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Landesamt für Pflege</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>33420dba-8f5f-4e6d-92a6-e0c8b0225a87</xflb:id>\n                     <xflb:bezeichnung>Antragsformblatt für die Gewährung der Bayerischen Hebammenniederlassungsprämie</xflb:bezeichnung>\n                     <xflb:link>https://www.lfp.bayern.de/wp-content/uploads/2024/04/Antrag_Erklaerungen_HebNp_ab1.1.24.pdf</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>007</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Antragsberechtigt sind ausschließlich Hebammen mit einer Erlaubnis zum Führen der Berufsbezeichnung nach § 5 des Hebammengesetzes (HebG), die die in Nr. 4.2 normierten Voraussetzungen erfüllen.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Zuwendung wird im Wege der Festbetragsfinanzierung als Projektförderung in Höhe von bis zu einmalig 5 000 Euro gewährt.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Zuwendungsfähig sind die im Zusammenhang mit der Niederlassung im Freistaat stehenden Ausgaben. Anstelle der im Einzelfall tatsächlich anfallenden Ausgaben werden hierfür folgende Kostenpauschalen angesetzt:&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Mehrbedarf für Vorauszahlung der Berufshaftpflichtprämie&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Bei Niederlassung erstmalig zu entrichtende Versicherungsbeiträge&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Mehrbedarf für Büromanagement&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Mehrbedarf für Erstausstattung&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Mehrbedarf für Räumlichkeiten&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Mehrbedarf für Marketing&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Mehrbedarf für Beratungsleistungen, Steuerberatungs- und Rechtsanwaltskosten&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Mehrbedarf für Mobilität&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Mehrbedarf für Fortbildungsleistungen vor Wiedereinstieg.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Der Gesamtbetrag der pauschalierten zuwendungsfähigen Ausgaben beträgt insgesamt 5 600 Euro.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Gesundheit, Pflege und Prävention</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinie über die Förderung der Niederlassung freiberuflicher Hebammen</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2126_0_G_14220/true</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Referat 32</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Hebammenniederlassungsprämie</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2026-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2019-09-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2026-12-31</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:verlaengerungsoption>ja</xflb:verlaengerungsoption>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert wird die Niederlassung freiberuflicher Hebammen in Bayern.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>008</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>016</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Sie müssen:&lt;/p&gt;&lt;p&gt;- im Besitz einer Erlaubnis zur Führung der Berufsbezeichnung nach § 5 des Hebammengesetzes sein,&lt;/p&gt;&lt;p&gt;- Ihre Niederlassung in Bayern nach dem 31.12.2023 begründen,&lt;/p&gt;&lt;p&gt;- die Gründung der Niederlassung beim zuständigen Gesundheitsamt angezeigt haben.&lt;/p&gt;&lt;p&gt;- sich mit Antragstellung bereiterklären, mindestens drei Jahre freiberuflich als Hebamme in Bayern tätig zu sein.&lt;/p&gt;&lt;p&gt;Im Fall der Wiederaufnahme der freiberuflichen Tätigkeit muss der Zeitraum zwischen der Beendigung und der Wiederanmeldung der Tätigkeit nach Art. 10 Abs. 3 des Gesundheitsdienstgesetzes (GDG) mindestens ein Jahr betragen.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Eine Förderung nach dieser Richtlinie ist ausgeschlossen, wenn die Hebamme für denselben Zweck Zahlungen aus anderen Mitteln des Freistaates Bayern, eines anderen Landes, des Bundes, der EU oder anderer ausländischer Staaten erhält.&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.lfp.bayern.de/wp-content/uploads/2024/04/Antrag_Erklaerungen_HebNp_ab1.1.24.pdf</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Der Antrag ist beim Landesamt für Pflege einzureichen. Nach der Prüfung erfolgt die Verbescheidung.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>005</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>&lt;p&gt;Das Vorhaben darf vor Antragstellung begonnen werden.&lt;/p&gt;</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristFest>\n                        <xflb:monate>6</xflb:monate>\n                     </xflb:fristFest>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>Der Antrag ist innerhalb von sechs Monaten nach Gründung der Niederlassung zu stellen. Verspätet eingegangene Anträge werden abgelehnt.</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Identitätsnachweis</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Vorderseite- und Rückseite Ihres Personalausweises oder der Datenseite und Folgeseite 1 Ihres Reisepasses,\nHinweis: Der Personalausweis bzw. Reisepass darf nicht abgelaufen sein. Statt eines gültigen Ausweisdokuments kann eine aktuelle (einfache oder erweiterte) Meldebescheinigung (Kopie) eingereicht werden. Die Meldebescheinigung darf, vom Datum der Antragstellung gerechnet, nicht älter als sechs Monate sein.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Nachweis über die Erlaubnis nach § 5 Hebammengesetzes</xflb:bezeichnung>\n                     <xflb:erlaeuterung>In Kopie (Urkunde)</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Nachweis über eine freiberufliche Tätigkeit in Bayern</xflb:bezeichnung>\n                     <xflb:erlaeuterung>durch Nachweis der Anmeldung einer Niederlassung in eigener Praxis beim zuständigen Gesundheitsamt nach Art. 10 Abs. 3 Gesundheitsdienst- und Verbraucherschutzgesetz (GDG) in Kopie.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>De-minimis-Erklärung</xflb:bezeichnung>\n                     <xflb:erlaeuterung>ausgefüllt und unterschriebene De-minimis-Erklärung im Original.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Erklärung über subventionserhebliche Tatsachen im Rahmen der Gewährung der Niederlassungsprämie</xflb:bezeichnung>\n                     <xflb:erlaeuterung>im Original.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Nachweis über die Abmeldung der vorangegangenen freiberuflichen Tätigkeit beim zuständigen Gesundheitsamt nach Art. 10 Abs. 3 GDG mit Datum des Endes der vorangegangenen Tätigkeit.</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Im Falle einer Wiederanmeldung.</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Gegen den Zuwendungsbescheid können Sie innerhalb von 1 Monat Klage erheben. Das zuständige Gericht, bei dem Sie Klage einreichen können, wird Ihnen im Bescheid mitgeteilt.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_103  [ xyz:attributes  [ xyz:antragsstellung    "https://www.dsdz.bayern.de";
                                xyz:begriffeImKontext  [ rdf:_1  "Digitale Schule der Zukunft";
                                                         rdf:_2  "1:1-Ausstattung";
                                                         rdf:_3  "Lernen mit mobilen Endgeräten"
                                                       ];
                                xyz:beschreibung       "<p>Im Rahmen der Digitalen Schule der Zukunft wird die Beschaffung von privaten mobilen Endgeräten für das Lernen in der Schule und zu Hause durch einen staatlichen Zuschuss unterstützt.&nbsp;</p>";
                                xyz:finanzierungsform  [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich     [ rdf:_1  "Digitalisierung" ];
                                xyz:foerdergeber       [ rdf:_1  "Land" ];
                                xyz:foerdergebiet      [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer      [ rdf:_1  "Privatpersonen" ];
                                xyz:foerderprogramm    "Formularserver zur Förderantragstellung Digitale Schule der Zukunft - Förderung der 1:1-Ausstattung von Schülerinnen und Schülern mit mobilen Endgeräten";
                                xyz:schluessel         "eab704e5-7bce-4d22-9b34-8e2fd8431b73";
                                xyz:teaser             "Die Digitale Schule der Zukunft verfolgt das Ziel der Weiterentwicklung des Unterrichts auf Basis einer 1:1-Ausstattung mit mobilen Endgeräten.";
                                xyz:titel              "Digitale Schule der Zukunft - Lernen mit mobilen Endgeräten";
                                xyz:titel.tokens       [ rdf:_1  "Digitale Schule der Zukunft - Lernen mit mobilen Endgeräten" ];
                                xyz:voraussetzung      "<p>Voraussetzung um eine Förderung beantragen zu können ist, dass die Schulklasse Ihres Kindes als 1:1-Ausstattungsklasse an der Digitalen Schule der Zukunft teilnimmt. Zudem muss das beschaffte Gerät alle festgelegten technischen Kriterien erfüllen.</p>"
                              ];
              xyz:id          "eab704e5-7bce-4d22-9b34-8e2fd8431b73";
              xyz:payload     [ xyz:json  [ xyz:anfrage            [ xyz:anfragenummer  "eab704e5-7bce-4d22-9b34-8e2fd8431b73";
                                                                     xyz:flb            [ xyz:konkreteFLB  [ xyz:allgemeineAngaben       [ xyz:beschreibung       [ xyz:schluesselwoerter  "Digitale Schule der Zukunft; 1:1-Ausstattung; Lernen mit mobilen Endgeräten";
                                                                                                                                                                    xyz:teaser             "Die Digitale Schule der Zukunft verfolgt das Ziel der Weiterentwicklung des Unterrichts auf Basis einer 1:1-Ausstattung mit mobilen Endgeräten.";
                                                                                                                                                                    xyz:zuwendungszweck    "<p>Im Rahmen der Digitalen Schule der Zukunft wird die Beschaffung von privaten mobilen Endgeräten für das Lernen in der Schule und zu Hause durch einen staatlichen Zuschuss unterstützt.&nbsp;</p>"
