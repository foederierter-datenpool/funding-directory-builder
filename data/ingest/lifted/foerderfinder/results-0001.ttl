                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Zuwendungsfähig sind die laufenden Ausgaben entsprechend § 2 Nr. 1 bis 17 der Betriebskostenverordnung (BetrKV) in der jeweils gültigen Fassung, soweit durch die Besonderheiten der leistungssportlichen Verwendung der Einrichtung keine abweichende Beurteilung erforderlich ist.</p>"
                                                                                                                                         ];
