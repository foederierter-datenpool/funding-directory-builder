                                          ];
                                xyz:xml   "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           produkt=\"Förderfinder\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produktversion=\"\"\n                                           standard=\"XFLB\"\n                                           test=\"\"\n                                           version=\"2.0.0\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0 xflb.xsd\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>031fcdbf-d69d-420f-8e70-2ac0f52c4ed5</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-07-24T09:37:40</xflb:erstellungszeitpunkt>\n      <xflb:sender>Förderfinder Suche (Bayern)</xflb:sender>\n      <xflb:empfaenger>XFLB-Connect (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>031fcdbf-d69d-420f-8e70-2ac0f52c4ed5</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>031fcdbf-d69d-420f-8e70-2ac0f52c4ed5</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>031fcdbf-d69d-420f-8e70-2ac0f52c4ed5</xflb:foerderschluessel>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400131017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"1\">\n                        <code>4</code>\n                        <name>Regelungskompetenz auf Landesebene</name>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>DigitalPakt Schule 2019 bis 2024; Beantragung einer Förderung für die digitale Bildungsinfrastruktur an bayerischen Schulen</xflb:titel>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.km.bayern.de/gestalten/foerderprogramme/digitalisierung/digitalpakt-schule</xflb:link>\n                     <xflb:bezeichnung>DigitalPakt Schule - Förderrichtlinie dBIR</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>https://www.km.bayern.de/sonderbudget</xflb:link>\n                     <xflb:bezeichnung>DigitalPakt Schule - Förderrichtlinie zum \"Sonderbudget Leihgeräte\" (SoLe)</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>https://www.km.bayern.de/lehrerdienstgeraete</xflb:link>\n                     <xflb:bezeichnung>DigitalPakt Schule - Richtlinie zum \"Sonderbudget Lehrerdienstgeräte\" (SoLD)</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>https://www.km.bayern.de/administration</xflb:link>\n                     <xflb:bezeichnung>Bayerische IT-Administrationsförderung (BayARn)</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:beschreibung>\n                  <xflb:teaser>Kommunale Schulaufwandsträger sowie private Träger staatlich anerkannter und genehmigter Ersatzschulen  können eine Förderung für den Ausbau der digitalen\nBildungsinfrastruktur (dBIR) beantragen.</xflb:teaser>\n                  <xflb:zuwendungszweck>Zweck der Förderung ist es, trägerneutral lernförderliche und belastbare,\ninteroperable digitale technische Bildungsinfrastrukturen an den bayerischen\nSchulen zu etablieren sowie vorhandene Strukturen zu optimieren.</xflb:zuwendungszweck>\n               </xflb:beschreibung>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Ihre zuständige Bezirksregierung</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>Um Fördermittel schulische Investitionsmaßnahmen zu erhalten, ist ein\nschuleigenes Medienkonzept notwendig, welches alle Maßnahmen der Medienbildung\neiner Schule (fachlich-pädagogisches Einsatzkonzept, Fortbildungsplanung,\nAusstattungsplan) enthält. Außerdem aktualisieren die Schulen einmal je\nQuartal ihre Daten in der Umfrage zur IT-Ausstattung bayerischer Schulen der\nAkademie für Lehrerfortbildung und Personalführung Dillingen (ALP).</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name>Bayern</name>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Unterricht und Kultus</xflb:verantwortlichesMinisterium>\n               <xflb:ablaufdatumRichtlinie>2025-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:verantwortlichesFachreferat>I.7</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Richtlinie \"digitale Bildungsinfrastruktur an bayerischen Schulen\" (dBIR)</xflb:programmtitel>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>002</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.verkuendung-bayern.de/baymbl/2021-744/</xflb:link>\n                     <xflb:bezeichnung>Richtlinie für die Gewährung von Zuwendungen aus dem Förderprogramm des Bayerischen Staatsministeriums für Unterricht und Kultus - digitale Bildungsinfrastruktur an bayerischen Schulen (dBIR)</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2019-05-17</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2025-05-16</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:verlaengerungsoption>Nein.</xflb:verlaengerungsoption>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Für die Herstellung optimaler Bedingungen für das digitale Lernen und Lehren kann mit Hilfe der Fördermittel die digitale Schulhausvernetzung (einschl. WLAN-Infrastruktur) aufgebaut bzw. verbessert, die digitalen Lehr-Lern- Infrastrukturen (z. B. pädagogische Kommunikations- und Arbeitsplattformen) aufgebaut bzw. weiterentwickelt sowie Anzeige- und Interaktionsgeräte (z. B. Dokumentenkameras, Beamer), digitale Arbeitsgeräte (z. B. Arbeitsplatzrechner , Diagnose- und Messgeräte) und in gewissem Umfang schulgebundene mobile Endgeräte (Laptops, Notebooks, Tablets) beschafft werden.&lt;/p&gt;\n&lt;p&gt;Zuwendungsfähig sind diese Investitionen an öffentlichen Schulen und staatlich genehmigten oder anerkannten Ersatzschulen, einschließlich Planung, Beschaffung, Aufbau und Installation. Gefördert werden Maßnahmen zur digitalen Vernetzung in&amp;nbsp;Schulgebäuden und auf dem Schulgelände, einschließlich schulischer Serverlösungen, wenn diese für pädagogische Anwendungen oder zur Sicherstellung technischer Anforderungen notwendig sind.&lt;/p&gt;\n&lt;p&gt;Darüber hinaus können digitale Präsentations- und Interaktionsgeräte (z. B. interaktive Tafeln, Displays) sowie digitale Arbeitsgeräte für Unterricht und Ausbildung gefördert werden. Dazu zählen insbesondere fach- und berufsbezogene Ausstattungen wie programmierbare Steuerungen und Fertigungen, CNC-Maschinen, Diagnose- und Messgeräte, Versuchsanlagen, Laborgeräte oder Steuermodule (CNC, Labor, Diagnose etc.). Schulgebundene mobile Endgeräte können gefördert werden, wenn eine geeignete digitale Infrastruktur&amp;nbsp;vorhanden oder beantragt ist und der pädagogische Bedarf im Medienkonzept der Schule dargestellt wird. Alle geförderten Maßnahmen müssen schulischen und nicht verwaltungsbezogenen Zwecken dienen.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:finanzierung>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>Die Zuwendung erfolgt als nicht zurückzahlbarer Zuschuss (Projektförderung) im\nRahmen einer Anteilfinanzierung.\n\nDer Fördersatz beträgt höchstens 90 Prozent der zuwendungsfähigen Ausgaben.\nDer Höchstbetrag der staatlichen Zuwendungen für die gesamte Laufzeit des\nDigitalPakts Schule 2019 bis 2024 ist je Schulaufwandsträger festgelegt (=\nHöchstbetrag der staatlichen Förderung Anlage zur dBIR) (siehe unter\n\"Rechtsgrundlagen\").</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Zuwendungsfähig sind&amp;nbsp;&lt;/p&gt;\n&lt;ul&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Ausgaben für IT-Ausstattung,&amp;nbsp;&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;Miet-, Mietkauf- und Leasing-Ausgaben für IT-Ausstattung,&amp;nbsp;&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;bauliche Maßnahmen zur kabelgebundenen Netzanbindung der Unterrichtsräume sowie zum Aufbau und zur Inbetriebnahme beschaffter Ausstattungsgegenstände und&amp;nbsp;&lt;/li&gt;\n  &lt;li class=\"unordered-list-item--dash\"&gt;investive Begleitmaßnahmen, wenn ein unmittelbarer und notwendiger Zusammenhang mit den oben genannten Investitionsmaßnahmen besteht.&lt;/li&gt;\n&lt;/ul&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:zuwendungsart>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerFest>\n                        <xflb:jahre>5</xflb:jahre>\n                     </xflb:dauerFest>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.km.bayern.de/digitalpakt</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>Der bzw. die Förderanträge sind vom jeweiligen Schulaufwandsträger\nausschließlich elektronisch unter Verwendung der zentral bereitgestellten\nAntragsmappe unter [digitalpakt-schule@stmuk.bayern.de](mailto:digitalpakt-\nschule@stmuk.bayern.de) beim Staatsministerium für Unterricht und Kultus und\nzugleich bei der zuständigen Regierung einzureichen.\n\nDie zuständige Regierung bewilligt die Zuwendung durch Zuwendungsbescheid\nunter Festsetzung der vorläufigen Zuwendungshöhe.</xflb:bewilligung>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>Gemäß Richtlinie generell genehmigt.</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>005</code>\n                     <name/>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:antragsfrist>\n                  <xflb:bemerkung>Der Bewilligungszeitraum endete am 16.05.2024. Die Frist zur Einreichung des vollständigen Verwendungsnachweises endet am 16.05.2025.</xflb:bemerkung>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristdatum>2022-06-30</xflb:fristdatum>\n                  </xflb:zeitlicheEingrenzung>\n               </xflb:antragsfrist>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Elektronische Antragsmappe(n)</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n            </xflb:antragsinformationen>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name>Kommunen</name>\n               </xflb:foerdernehmende>\n            </xflb:foerdernehmende>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-07-24T09:37:40</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>006</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>\n"
                              ]
            ];
  rdf:_20   [ xyz:attributes  [ xyz:antragsstellung      "https://www.bne-lernen.bayern.de/foerderung/foerderung_umweltstationen/doc/umwst_antrag.docx";
                                xyz:begriffeImKontext    [ rdf:_1  "Grundförderung" ];
                                xyz:beschreibung         "<p>Zweck der Zuwendung ist die Förderung dieser Bildungsarbeit von staatlich anerkannten Umweltstationen, die ohne Zuwendung eine Bildungsarbeit BNE/UB nicht oder nicht in hinreichendem Umfang anbieten können. Ziel ist es, ein räumlich möglichst ausgewogenes, flächendeckendes Netz von Umweltstationen dauerhaft zu etablieren und damit nachhaltig eine wohnortnahe BNE/UB für die bayerische Bevölkerung zu ermöglichen.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Umwelt- und Naturschutz" ];
