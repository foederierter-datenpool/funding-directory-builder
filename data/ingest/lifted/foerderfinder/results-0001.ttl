                                                                                                                                           xyz:erforderlicheUnterlagen  [ xyz:dokument  [ rdf:_1   [ xyz:bezeichnung  "Bau- und Raumprogramm" ];
                                                                                                                                                                                          rdf:_10  [ xyz:bezeichnung  "Nachweise über die im Finanzierungsplan vorgesehenen Eigenmittel und die bewilligten, zugesagten und in Aussicht gestellten Fremdmittel" ];
                                                                                                                                                                                          rdf:_11  [ xyz:bezeichnung  "Übersicht über Vermögen und Schulden sowie voraussichtliche künftige Verpflichtungen, Bilanz und Gewinn- und Verlustrechnung des letzten Jahres, Haushaltsvoranschlag für das laufende Jahr, Wirtschaftlichkeitsberechnung, derzeitiger Tageskostensatz" ];
                                                                                                                                                                                          rdf:_12  [ xyz:bezeichnung  "Vereinssatzung mit Liste der Vorstandsmitglieder oder entsprechende Unterlagen, Nachweise über die Anerkennung der \"Gemeinnützigkeit\" des Trägers der Einrichtung, Registerauszug" ];
                                                                                                                                                                                          rdf:_13  [ xyz:bezeichnung  "Grundbuchauszug nach dem neuesten Stand (gegebenenfalls Kauf-, Pacht- oder Nutzungsvertrag)" ];
                                                                                                                                                                                          rdf:_14  [ xyz:bezeichnung  "Ergänzungen" ];
                                                                                                                                                                                          rdf:_2   [ xyz:bezeichnung  "Lageplan des Bauvorhabens und seiner Umgebung mit eingezeichneter Planung und Grenzen sowie Darstellung der Erschließung (Maßstab 1: 1.000, ein Übersichtsplan ist nicht notwendig)" ];
                                                                                                                                                                                          rdf:_3   [ xyz:bezeichnung  "Pläne, die Art und Umfang des Vorhabens prüfbar nachweisen (Maßstab 1: 100, ggf. mit eingezeichneter Möblierung)" ];
                                                                                                                                                                                          rdf:_4   [ xyz:bezeichnung  "Bauaufsichtliche oder sonstige Genehmigungen (bspw. Stellungnahme der Fachstelle für Pflege- und Behinderteneinrichtungen - Qualitätsentwicklung und Aufsicht (FQA); Vorbescheid oder Ähnliches genügen)" ];
                                                                                                                                                                                          rdf:_5   [ xyz:bezeichnung  "Grundstücksbogen" ];
                                                                                                                                                                                          rdf:_6   [ xyz:bezeichnung  "ggf. Erläuterungsbericht nach Muster 6 zu Art. 44 BayHO (insbesondere mit allgemeiner Bau- und Funktionsbeschreibung und Angaben über Lage und Beschaffenheit des Baugeländes sowie Bau- und Ausführungsart)" ];
                                                                                                                                                                                          rdf:_7   [ xyz:bezeichnung  "Flächenzusammenstellung" ];
                                                                                                                                                                                          rdf:_8   [ xyz:bezeichnung  "Berechnungen für den Bau nach DIN 276 (Ausgabe 1993), DIN 277 (Ausgabe 1986) und DIN 283" ];
                                                                                                                                                                                          rdf:_9   [ xyz:bezeichnung  "Prüfbare Kostenschätzung für die Ausstattung für Kosten der allgemeinen Inneneinrichtung, Küche und Gemeinschaftsräume (ohne 2) für Kosten der Arbeitsplatzausstattung" ]
                                                                                                                                                                                        ]
                                                                                                                                                                        ];
                                                                                                                                           xyz:linkZurAntragsstellung   "https://www.bayernportal.de/dokumente/leistung/874741671778?localize=false";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<p><strong>Antrags- und Bewilligungsverfahren</strong></p>\n<ul>\n  <li class=\"unordered-list-item--dash\"><strong>Bedarfsprüfung und Projektanzeige<br>\n</strong>Kontakt mit zuständiger Bezirksverwaltung zur Prüfung von Bedarf und Standort<br>\nFeststellung des Bedarfs durch Beschluss<br>\nAnzeige des geplanten Projekts bei der zuständigen Förderstelle</li>\n  <li class=\"unordered-list-item--dash\"><strong>Grundstück und Planung<br>\n</strong>Prüfung der Grundstückseignung bei Erwerb (Nutzung, Bauvorgaben, städtebauliche Einfügung, Gestaltung, Erschließung)<br>\nFrühzeitige Abstimmung mit der Bauleitplanung empfohlen<br>\nErstellung eines Konzepts mit Raum- und Funktionsprogramm durch Antragsteller<br>\nFachliche Beratung und Prüfung durch Förderstelle und Bezirk<br>\nFeststellung des Programms als Voraussetzung, noch keine Förderzusage</li>\n  <li class=\"unordered-list-item--dash\"><strong>Vorplanung und Kostenschätzung<br>\n</strong>Kosten-Flächenermittlung und Kostenschätzung nach DIN 276<br>\nBeratung zu technischem und wirtschaftlichem Konzept<br>\nKoordination der Gesamtfinanzierung durch die Bewilligungsstelle<br>\nMeldung des Vorhabens an StMAS oder ggf. Staatsministerium für Wohnen, Bau und Verkehr</li>\n  <li class=\"unordered-list-item--dash\"><strong>Priorisierung und Entscheidung<br>\n</strong>Erstellung einer Prioritätenliste bis 15.03. des Jahres<br>\nEntscheidung über Aufnahme ins Jahresförderprogramm (JFP) durch StMAS<br>\nProjekte ohne Mittelzuweisung können im Folgejahr erneut angemeldet werden</li>\n  <li class=\"unordered-list-item--dash\"><strong>Bewilligung und Auszahlung<br>\n</strong>Bewilligungsbescheid nach Vorlage aller Unterlagen, einschließlich Entwurfsplanung mit Kostenberechnung<br>\nEigener Bescheid für Bezirk (in der Regel 10 % der Kosten)<br>\nMittelverfügbarkeit: verbindliche Bewilligung, Auszahlung nach Baufortschritt und verfügbaren Haushaltsmitteln<br>\nBei Wohnraumförderung: Zustellung und Auszahlung über Bayerische Landesbodenkreditanstalt, inkl. dinglicher Sicherung</li>\n</ul>";
                                                                                                                                                                          xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "001";
                                                                                                                                                                                                            xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
                                                                                                                                                                                                            xyz:listVersionID  "1";
                                                                                                                                                                                                            xyz:name           ""
                                                                                                                                                                                                          ]
                                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:euBeihilferelevanz        "Nein";
                                                                                                                                           xyz:finanzierungsartUndHoehe  "<p>Die Zuwendung wird als Zuschuss gewährt. Die Förderquote beträgt bis zu 60 % der zuwendungsfähigen Ausgaben. Dieser Einsatz erfolgt im Rahmen einer Finanzierung, die von einer 30%igen Eigenbeteiligung des Trägers ausgeht. Als Eigenleistung gelten auch Mittel der Aktion Mensch und ähnliche zur Unterstützung der Eigenleistung gewährte Mittel. Die Förderung erfolgt als Projektförderung im Wege der Anteilfinanzierung VV Nr. 2.2.2 zu Art. 44 Bayerische Haushaltsordnung (BayHO). Die Zuwendung wird bei der Bewilligung auf einen Höchstbetrag begrenzt.</p>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "001";
                                                                                                                                                                                                    xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
                                                                                                                                                                                                    xyz:listVersionID  "1";
                                                                                                                                                                                                    xyz:name           ""
                                                                                                                                                                                                  ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:laufzeitFinanzierung      [ xyz:dauer                 [ xyz:dauerSpanne  [ xyz:maxDauer  [ xyz:jahre  "5" ];
                                                                                                                                                                                                                          xyz:minDauer  [ xyz:jahre  "2" ]
                                                                                                                                                                                                                        ]
                                                                                                                                                                                                     ];
                                                                                                                                                                           xyz:laufzeitFinanzierung  [ xyz:code           "002";
                                                                                                                                                                                                       xyz:listURI        "urn:xoev-de:stmd:codeliste:laufzeit-finanzierung";
                                                                                                                                                                                                       xyz:listVersionID  "1";
                                                                                                                                                                                                       xyz:name           "Teilprojektlaufzeit"
                                                                                                                                                                                                     ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1";
                                                                                                                                                                           xyz:name           ""
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Die zuwendungsfähigen Ausgaben richten sich analog zur jeweils gültigen Anlage der Förderrichtlinie Werkstätten für behinderte Menschen. In Ausnahmefällen können Ausgaben für Erwerb, Erschließung und Herrichten von Grundstücken (DIN 276, Kostengruppen 100, 200) gefördert werden, wenn sonst der Betrieb der Förderstätte oder T-ENE-Einrichtung gefährdet wäre. Für reine Baumaßnahmen (Kostengruppen 300, 400) gelten die Beträge der Wohnraumförderung zuzüglich bis zu 25 % je Quadratmeter Wohn- oder Geschäftsfläche. Die Ausgaben sind differenziert nach Behinderungsarten, Konzept und anerkannten Raum- und Funktionsprogrammen zu berücksichtigen. Die Obergrenze für bewegliche Inneneinrichtungen einschließlich Gemeinschaftsräumen beträgt je Platz bis zu 5.000 €.</p>"
                                                                                                                                         ];
                                                                                                             xyz:foerderbereich          [ xyz:foerderbereich  [ xyz:code           "011";
                                                                                                                                                                 xyz:listURI        "urn:xoev-de:stmd:codeliste:foerderbereich";
                                                                                                                                                                 xyz:listVersionID  "1";
                                                                                                                                                                 xyz:name           ""
                                                                                                                                                               ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergebiet           [ xyz:laender  [ xyz:land  [ xyz:code           "BY";
                                                                                                                                                                      xyz:listURI        "urn:xoev-de:pks:codeliste:bundesland";
                                                                                                                                                                      xyz:listVersionID  "1";
                                                                                                                                                                      xyz:name           "Bayern"
                                                                                                                                                                    ]
                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergegenstand       [ xyz:beschreibung
                                                                                                                               "<p>Gefördert werden die (Neu-)Errichtung von Förderstätten und T-ENE-Einrichtungen, die eigenständige Einrichtungen der Eingliederungshilfe sind. Förderstätten arbeiten mit anerkannten Werkstätten für behinderte Menschen (WfbM) zusammen und unterstützen Menschen mit Behinderung bei der Hinführung zum Berufsbildungsbereich, zur Milderung der Folgen der Behinderung, zur Teilhabe am Leben in der Gemeinschaft und zur Entlastung der Familie. T-ENE-Einrichtungen ermöglichen Menschen im Alter, entsprechend ihrer persönlichen Bedürfnisse zwischen verschiedenen Angeboten zu wählen und diesen Lebensabschnitt möglichst selbstbestimmt zu gestalten.</p>\n<p>Staatliche Zuwendungen werden gewährt für Förderstätten in räumlicher Anbindung an anerkannte WfbM oder an stationäre Wohnplätze. In Ausnahmefällen kann auch eine räumlich abgegrenzte Förderstätte gefördert werden, sofern eine Kooperation mit einer anerkannten Werkstatt besteht.</p>\n<p>Gefördert werden Neubau, Umbau, Erweiterung, grundlegende Modernisierung (nicht Sanierung) sowie die Ausstattung von Förderstätten und T-ENE-Einrichtungen. Ebenfalls förderfähig ist der Erwerb eines Gebäudes einschließlich Umbau oder Instandsetzung. Maßnahmen, deren zuwendungsfähige Ausgaben 100.000 Euro nicht überschreiten, sind nicht förderfähig.</p>" ];
