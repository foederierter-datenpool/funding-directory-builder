                                                                                                                                           xyz:linkZurAntragsstellung   "https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rvs/b4/40.1/rvs_40.1-211/index";
                                                                                                                                           xyz:rechtsbehelf             "<p>Gegen den Zuwendungsbescheid können Sie innerhalb von einem Monat Widerspruch einlegen. Die Stelle, bei der Sie den Widerspruch einreichen können, wird Ihnen im Bescheid mitgeteilt.</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<p>Der Antrag auf Förderung ist über das Schulamt bei der Regierung einzureichen.<a href=\"http://einzureichen.Im\"> </a>Im Antrag bestätigt die Schulleitung die ordnungsgemäße Durchführung der Maßnahme mit Angaben zu Organisation, Konzept, Personal und Ablauf. Das Staatliche Schulamt prüft die Rechnung des Maßnahmenträgers sowie ggf. den Bescheid der Agentur für Arbeit und bestätigt die Angaben als sachlich und rechnerisch richtig. Die zuständige Regierung prüft den Antrag abschließend und ordnet die Auszahlung der Fördermittel an.</p>";
                                                                                                                                                                          xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "002";
                                                                                                                                                                                                            xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
                                                                                                                                                                                                            xyz:listVersionID  "1"
                                                                                                                                                                                                          ]
                                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:finanzierungsartUndHoehe  "<p>Die Förderung erfolgt als Kofinanzierung aus dem Haushalt des Bayerischen Staatsministeriums für Unterricht und Kultus. Die Förderung erfolgt als Kofinanzierung. Die Höhe des Zuschusses beträgt bis zu 50 Prozent der zuwendungsfähigen Ausgaben.</p>\n<p>Eine Kofinanzierung mit ESF-Mitteln ist zulässig.</p>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "001";
                                                                                                                                                                                                    xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
                                                                                                                                                                                                    xyz:listVersionID  "1";
                                                                                                                                                                                                    xyz:name           ""
                                                                                                                                                                                                  ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:laufzeitFinanzierung      [ xyz:laufzeitFinanzierung  [ xyz:code           "001";
                                                                                                                                                                                                       xyz:listURI        "urn:xoev-de:stmd:codeliste:laufzeit-finanzierung";
                                                                                                                                                                                                       xyz:listVersionID  "1";
                                                                                                                                                                                                       xyz:name           "Gesamte Projektlaufzeit"
                                                                                                                                                                                                     ]
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsart             [ xyz:code           "001";
                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:zuwendungsart";
                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                         ];
                                                                                                                                           xyz:zuwendungsfaehigeKosten   "<p>Förderfähig sind i. d. R. Kosten, die unmittelbar mit der Durchführung der Berufsorientierungsmaßnahme verbunden sind (§ 48 SGB III). Dazu gehören laut den fachlichen Weisungen der Agentur für Arbeit vor allem die Durchführung und Betreuung der Maßnahme selbst und die unmittelbare organisatorische Abwicklung.</p>\n<p>Kosten für Koordinierungs- und Organisationsaufgaben können nur dann anteilig gefördert werden, wenn sie \"unabdingbar\" für die Durchführung des Gesamtprojektes sind. Solche Kosten dürfen dabei in der Summe nicht mehr als etwa 10 % der Gesamtmaßnahmekosten ausmachen. Liegt der Anteil bei mehr als 30 %, gilt das i. d. R. als nicht mehr angemessen. Beispiele dafür sind unter anderem:</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">Vergabe der Maßnahme</li>\n  <li class=\"unordered-list-item--dash\">Abwicklung und Abrechnung</li>\n  <li class=\"unordered-list-item--dash\">Qualitätssicherung</li>\n  <li class=\"unordered-list-item--dash\">Ergebnisberichte und Datenauswertung</li>\n  <li class=\"unordered-list-item--dash\">Schulung/Einweisung des Personals</li>\n  <li class=\"unordered-list-item--dash\">Öffentlichkeitsarbeit im Rahmen der Maßnahme</li>\n</ul>\n<p>Nicht übernommen werden grundsätzlich:</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">Kosten für Verpflegung der Schülerinnen und Schüler während der Maßnahme.</li>\n  <li class=\"unordered-list-item--dash\">Fahrtkosten der Teilnehmenden, soweit sie im Zusammenhang mit der Maßnahme anfallen.</li>\n</ul>"
                                                                                                                                         ];
