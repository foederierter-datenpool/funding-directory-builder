                                                                                                                                                                  ]
                                                                                                                                         ];
                                                                                                             xyz:antragsinformationen    [ xyz:antragsfrist             [ xyz:bemerkung             "Das Sonderförderprogramm Digitalfunk wurde mit IMS vom 10.12.2024 letztmalig verlängert und ist bis zum 31.12.2026 befristet. Der Nachweis der Verwendung für eine Förderung nach diesem Programm muss der Förderbehörde bis spätestens 31.12.2028 vorliegen.";
