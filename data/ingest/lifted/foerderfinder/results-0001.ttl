                                                                                                                                           xyz:erforderlicheUnterlagen  [ xyz:dokument  [ rdf:_1  [ xyz:bezeichnung  "Programmheft der Veranstaltung (z.B. Flyer des Veranstalters)" ];
                                                                                                                                                                                          rdf:_2  [ xyz:bezeichnung  "Kopie eines aktuellen Kontoauszuges (mit Namen des Kontoinhabers) oder einer Bezügemitteilung zum Nachweis des Kindergeldbezuges (immer erforderlich). Auf dem Kontoauszug müssen nur der Name des Kontoinhabers, der Buchungstag des Kindergeldes, der Kindergeldbetrag und als Verwendungszweck das Kindergeld ersichtlich sein. Alle weiteren Daten des Kontoauszugs dürfen geschwärzt werden." ];
                                                                                                                                                                                          rdf:_3  [ xyz:bezeichnung  "ggf. vollständiger Einkommensteuerbescheid des Vorjahres (eine Lohnsteuerbescheinigung allein genügt nicht)" ];
                                                                                                                                                                                          rdf:_4  [ xyz:bezeichnung  "wenn Sie nicht zur Einkommensteuer veranlagt werden oder ein entsprechender Einkommensteuerbescheid noch nicht erteilt wurde: ausgefüllter Einkommensfragebogen" ];
                                                                                                                                                                                          rdf:_5  [ xyz:bezeichnung  "wenn Sie Kinderzuschlag und/oder Wohngeld beziehen: aktueller Bescheid" ]
                                                                                                                                                                                        ]
