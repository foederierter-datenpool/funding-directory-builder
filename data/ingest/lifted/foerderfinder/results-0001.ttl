                                xyz:xml   "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           produkt=\"Förderfinder\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produktversion=\"\"\n                                           standard=\"XFLB\"\n                                           test=\"\"\n                                           version=\"2.0.0\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0 xflb.xsd\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>dbe56d8c-5c73-453e-b858-591b6a05a7c8</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-01-15T15:41:04</xflb:erstellungszeitpunkt>\n      <xflb:sender>Förderfinder Suche (Bayern)</xflb:sender>\n      <xflb:empfaenger>XFLB-Connect (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>dbe56d8c-5c73-453e-b858-591b6a05a7c8</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>dbe56d8c-5c73-453e-b858-591b6a05a7c8</xflb:schluessel>\n         <xflb:versionFLB>3</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>dbe56d8c-5c73-453e-b858-591b6a05a7c8</xflb:foerderschluessel>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n                  <xflb:flbVersion>3</xflb:flbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99148121017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"1\">\n                        <code>4</code>\n                        <name>Regelungskompetenz auf Landesebene</name>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Förderung von Unternehmensneugründungen im Bereich Digitalisierung; Start?Zuschuss!</xflb:titel>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gruenderland.bayern/finanzierung-foerderung/startzuschuss/</xflb:link>\n                     <xflb:bezeichnung>Gründerland Bayern - Start?Zuschuss!</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>https://www.foerderdatenbank.de/FDB/Content/DE/Foerderprogramm/Land/Bayern/neugruendungen-im-bereich-digitalisierung.html</xflb:link>\n                     <xflb:bezeichnung>Förderdatenbank - Förderung von Unternehmensneugründungen im Bereich Digitalisierung (Start?Zuschuss!)</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:beschreibung>\n                  <xflb:teaser>Der Freistaat Bayern fördert technologieorientierte Start-ups mit innovativem, zukunftsfähigem Geschäftsmodell im Bereich Digitalisierung, deren Gründung höchstens zwei Jahre zurückliegt (maßgeblich ist der Stichtag des Bewerbungsfristendes).</xflb:teaser>\n                  <xflb:schluesselwoerter>Start?Zuschuss!, Start-up, Startup, Bereich Digitalisierung, Existenzgründung</xflb:schluesselwoerter>\n                  <xflb:zuwendungszweck>Start?Zuschuss! hat das Ziel, Gründern in der Anfangsphase eine unkomplizierte Unterstützung zu geben um zur Etablierung junger, innovativer Unternehmen am Markt beizutragen.</xflb:zuwendungszweck>\n               </xflb:beschreibung>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Staatsministerium für Wirtschaft, Landesentwicklung und Energie</xflb:name>\n                  <xflb:telefonnummer>+49 89 2162 0</xflb:telefonnummer>\n                  <xflb:email>gruenderland.bayern@stmwi.bayern.de</xflb:email>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n                  <xflb:adresse>\n                     <xflb:strasse>Prinzregentenstraße</xflb:strasse>\n                     <xflb:hausnummerPostfach>28</xflb:hausnummerPostfach>\n                     <xflb:postleitzahl>80538</xflb:postleitzahl>\n                     <xflb:ort>München</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gruenderland.bayern</xflb:link>\n                     <xflb:bezeichnung>Webseite Gründerland Bayern - Gründen auf Bayerisch</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Das Bayerische Staatsministerium für Wirtschaft, Landesentwicklung und Energie richtet den bayernweiten Start?Zuschuss! Wettbewerb aus. Die sieben Regierungen sind für den Fördervollzug zuständig, d.h., für die Zuwendungsanträge, den Erlass der Zuwendungsbescheide, die Mittelauszahlungen und die Verwendungsnachweisprüfungen.</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:alternativeFoerdermoeglichkeiten>\n                  <xflb:alternativeFoerdermoeglichkeit>\n                     <xflb:beschreibung>Gründerlotse Bayern</xflb:beschreibung>\n                     <xflb:verweis>\n                        <xflb:link>https://www.bayern-innovativ.de/de/beratung/ptb/gruenderlotse-bayern</xflb:link>\n                        <xflb:bezeichnung>Webseite Bayern Innovativ - Gründerlotse Bayern</xflb:bezeichnung>\n                     </xflb:verweis>\n                  </xflb:alternativeFoerdermoeglichkeit>\n               </xflb:alternativeFoerdermoeglichkeiten>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>Die Möglichkeit zur Förderantragstellung setzt zwingend eine erfolgreiche Teilnahme am vorherigen Wettbewerb voraus, d.h., wenn die Bewerbung von der externen Jury zur Förderung ausgewählt wurde.</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Freiberufler (Freelancer) sind nicht teilnahme-/antragsberechtigt; das Förderprogramm richtet sich ausschließlich an die gewerbliche Wirtschaft.&lt;/p&gt;</xflb:ausschlusskriterien>\n               <xflb:rechtlicheBeschreibung>Zur Teilnahme am Wettbewerb und zur Beantragung der Zuwendung darf die gewerbliche Unternehmensneugründung zum Stichtag des Bewerbungsfristendes nicht älter als zwei Jahre sein bzw. die gewerbliche Unternehmensneugründung hat bis zum Stichtag des Bewerbungsfristendes vollzogen zu sein.</xflb:rechtlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name>Bayern</name>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Wirtschaft, Landesentwicklung und Energie</xflb:verantwortlichesMinisterium>\n               <xflb:verantwortlichesFachreferat>Referat 48 -  Gründerland Bayern</xflb:verantwortlichesFachreferat>\n               <xflb:euPublizitaetspflicht>https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32023R2831&amp;qid=1705038471365</xflb:euPublizitaetspflicht>\n               <xflb:ablaufdatumRichtlinie>2027-06-30</xflb:ablaufdatumRichtlinie>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_7071_W_14225</xflb:link>\n                     <xflb:bezeichnung>Richtlinien zur Förderung von Gründerzentren, Netzwerkaktivitäten, Aktivitäten zum Erhalt und zur Weiterentwicklung des Start-up-Ökosystems und Unternehmensneugründungen im Bereich Digitalisierung</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_7070_W_14078/true</xflb:link>\n                     <xflb:bezeichnung>Allgemeine Verwaltungsvorschriften für die Gewährung von Zuwendungen an die gewerbliche Wirtschaft (AVG)</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO</xflb:link>\n                     <xflb:bezeichnung>Art. 23 und 44 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:link>https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32023R2831&amp;qid=1705038471365</xflb:link>\n                     <xflb:bezeichnung>Verordnung (EU) Nr. 2023/2831 der Kommission über die Anwendung der Artikel 107 und 108 des Vertrags über die Arbeitsweise der Europäischen Union auf De-minimis-Beihilfen (De-minimis-Verordnung)</xflb:bezeichnung>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:kummulierbareFoerderungen>\n                  <xflb:voraussetzungen>Die Ausgaben gem. Kosten- und Finanzierungsplan, die mit der Start?Zuschuss!-Zuwendung bezuschusst werden, dürfen nicht durch etwaige weitere staatliche Mittel bezuschusst werden. Die Ausgaben gem. Kosten- und Finanzierungsplan etwaiger weiterer Zuwendungen dürfen nicht durch staatliche Mittel der Start?Zuschuss!-Zuwendung bezuschusst werden (Ausschluss einer Mehrfachförderung).</xflb:voraussetzungen>\n                  <xflb:verweise>\n                     <xflb:verweis>\n                        <xflb:link>https://www.gruenderland.bayern/finanzierung-foerderung/startzuschuss/</xflb:link>\n                        <xflb:bezeichnung>Webseite Gründerland Bayern - Finanzierung  Förderung - Start?Zuschuss!</xflb:bezeichnung>\n                     </xflb:verweis>\n                  </xflb:verweise>\n               </xflb:kummulierbareFoerderungen>\n               <xflb:programmlaufzeit>\n                  <xflb:endeLaufzeitFoerderprogramm>2027-06-30</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:beginnLaufzeitFoerderprogramm>2024-05-01</xflb:beginnLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.gruenderland.bayern/finanzierung-foerderung/startzuschuss/</xflb:linkZurAntragsstellung>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Gewerbeanmeldung oder HRB-Eintrag sowie etwaige De-minimis-Bescheinigung(en)</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Die Unterlagen sind erst mit der Förderantragstellung beizubringen, jedoch nicht im Wettbewerbsverfahren.</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Das Verfahren ist 2-stufig:&amp;nbsp;&lt;/p&gt;\n&lt;ol&gt;\n  &lt;li class=\"ordered-list-item--numbered\"&gt;Stufe: Wettbewerbsverfahren. Reichen Sie Ihre Online-Bewerbung im Wettbewerbszeitraum über das Portal https://www.gruenderland.bayern/finanzierung-foerderung/startzuschuss/ beim Bayerischen Wirtschaftsministerium ein. Die Bewerbungen werden von der externen Jury bewertet und die Start-ups zur Förderung ausgewählt.&amp;nbsp;&lt;/li&gt;\n  &lt;li class=\"ordered-list-item--numbered\"&gt;Stufe: Förderantragsverfahren. Die ausgewählten Bewerber werden benachrichtigt und stellen den Online-Förderantrag bei der zuständigen Regierung.&lt;/li&gt;\n&lt;/ol&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n            </xflb:antragsinformationen>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>002</code>\n                  <name>Kleine und mittlere Unternehmen</name>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>003</code>\n                  <name>Einzelunternehmen</name>\n               </xflb:foerdernehmende>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>Anteilsfinanzierung, 50 Prozent der zuwendungsfähigen Ausgaben, max. bis 36.000 EUR.</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>Ausgaben für Personal, Miete, Markteinführung des Produkts sowie Forschung &amp; Entwicklung.</xflb:zuwendungsfaehigeKosten>\n               <xflb:euBeihilferelevanz>Die Förderung erfolgt im Rahmen der De-minimis-Verordnung.</xflb:euBeihilferelevanz>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:zuwendungsart>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Teilprojektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n                  <xflb:dauer>\n                     <xflb:dauerFest>\n                        <xflb:monate>12</xflb:monate>\n                     </xflb:dauerFest>\n                  </xflb:dauer>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Der Freistaat Bayern unterstützt technologieorientierte Unternehmensneugründungen mit einem besonders zukunftsfähigen, innovativem Geschäftsmodell im Bereich Digitalisierung, deren Gründung maximal zwei Jahre zurückliegt (maßgeblich ist der jeweilige Stichtag des Bewerbungsfristendes).&lt;/p&gt;\n&lt;p&gt;1. Ziele des Programms - Unterstützung technologieorientierter Unternehmensneugründungen im Bereich Digitalisierung in der Startphase - Beitrag zur Etablierung junger, innovativer Unternehmen am Markt Start?Zuschuss! hat das Ziel, Gründern in der Anfangsphase eine unkomplizierte Unterstützung zu geben. Ein individuelles Feedback der Juroren zu den Geschäftsmodellen ist daher nicht vorgesehen. Für eine enge Begleitung der Entwicklung sowie regelmäßige Evaluierung deines Businessplans empfehlen wir, dich an den Bayerischen Businessplan Wettbewerben von BayStartUP zu beteiligen. 2. Wer wird gefördert? Technologieorientierte Unternehmensneugründungen - mit einem besonders zukunftsfähigen, innovativen Geschäftsmodell - im Bereich Digitalisierung - deren Gründung maximal 2 Jahre (maßgeblich ist der jeweilige Stichtag des Bewerbungsfristendes) zurückliegt 3. Was wird gefördert? Ausgaben insbesondere für - Personal - Miete - Markteinführung des Produkts - Forschung &amp;amp; Entwicklung 4. Wie wird gefördert? Einmalig für einen Zeitraum von einem Jahr - maximal 50 Prozent der förderfähigen Ausgaben - jedoch nicht mehr als 36.000 EUR Die Förderung erfolgt im Rahmen der De-minimis-Verordnung. 5. Wie wird eine Förderung ausgewählt? Die Bewerbung reichst du online ein. 1. Stufe: Wettbewerbsverfahren, Bewertung der Bewerbung durch externe Jury 2. Stufe: Ausgewählte Bewerber stellen Förderantrag bei der zuständigen Regierung&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-01-15T15:41:04</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>006</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>008</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>\n"
                              ]
            ];
  rdf:_14   [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmas/frauenhaus_vn/index";
                                xyz:beschreibung         "<p>Zweck ist es, durch staatliche Zuwendungen ein flächendeckendes Angebot zur Beratung und Hilfe für akut von häuslicher und /oder sexualisierter Gewalt im sozialen Nahraum betroffene oder bedrohte Frauen und ihre Kinder in Frauenhäusern zu unterstützen.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Gesundheit und Soziales" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Vereine";
                                                           rdf:_2  "Verbände"
                                                         ];
                                xyz:foerderprogramm      "Frauenhäuser; Beantragung einer Zuwendung";
                                xyz:foerderzeitraum.bis  "2026-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2025-12-31T00:00:00.000+00:00";
                                xyz:schluessel           "ae73e055-b15b-4b5f-bc25-b77ff9094d5d";
                                xyz:teaser               "Der Freistaat Bayern gewährt Zuschüsse zur Förderung von Frauenhäusern.";
                                xyz:titel                "Frauenhäuser; Beantragung einer Zuwendung";
                                xyz:titel.tokens         [ rdf:_1  "Frauenhäuser";
                                                           rdf:_2  "Beantragung einer Zuwendung"
                                                         ];
                                xyz:voraussetzung        "<p>Das Frauenhaus muss unter anderem</p>\n<ul>\n  <li class=\"unordered-list-item--dash\">mindestens fünf Plätze für Frauen und mindestens eine gleiche Anzahl Plätze für Kinder anbieten,</li>\n  <li class=\"unordered-list-item--dash\">so ausgestattet sein, dass es den Bedürfnissen und dem Schutz der Hilfe Suchenden gerecht werden kann,</li>\n  <li class=\"unordered-list-item--dash\">eine Konzeption haben, wonach aufgenommene Frauen sich und ihre Kinder eigenverantwortlich versorgen sowie die Erziehungsaufgabe gegenüber ihren Kindern mit Unterstützung geeigneten Fachpersonals wahrnehmen können; in der Konzeption soll auch dargestellt werden, inwieweit die Aufnahme von Frauen mit besonderen Bedarfen (zum Beispiel Frauen mit Behinderung oder mehreren Kindern) möglich ist</li>\n  <li class=\"unordered-list-item--dash\">eine bestimmte Anzahl von Fachkräften für die Beratung und Betreuung der Frauen und Kinder sowie für die Geschäftsführung und Leitung vorhalten (siehe Richtlinie),</li>\n  <li class=\"unordered-list-item--dash\">Personal für die Aufgabenbereiche Verwaltung (insbesondere zur Wahrung der Assistenz- und Organisationsaufgaben) und Gebäudemanagement vorhalten. Für die Aufgabenbereiche Verwaltung und Gebäudemanagement können alternativ auch Honorarkräfte beschäftigt oder die Leistung von externen Dienstleistern zugekauft werden.&nbsp;</li>\n</ul>\n<p>In vom Träger besonders zu begründenden Härtefällen kann von der Einhaltung der Voraussetzungen nach Spiegelstrich 4 und 5 abgesehen werden (siehe Richtlinie).&nbsp;</p>\n<p>Eine staatliche Förderung erfolgt nur, wenn sich mindestens ein Landkreis oder eine kreisfreie Stadt an den Kosten, die für den Betrieb des Frauenhauses erforderlich sind, beteiligt.&nbsp;</p>\n<p>Alle Zuwendungsvoraussetzungen finden Sie in der Personalkostenrichtlinie (siehe unter \"Rechtsgrundlagen\").</p>"
                              ];
