                                                                                                                                                                      xyz:name           ""
                                                                                                                                                                    ]
                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:foerdergegenstand       [ xyz:beschreibung
                                                                                                                               "<p>Interventionsstellen, die an ein staatlich gefördertes Frauenhaus oder an eine staatlich geförderte Fachberatungsstelle angegliedert sind und den pro-aktiven Beratungsansatz umsetzen, erhalten eine Förderung zur Wahrnehmung der unter Nr. 3.4.1 Richtlinie beschriebenen Tätigkeiten.</p>" ];
                                                                                                             xyz:foerdernehmende         [ xyz:beschreibung     "Zuwendungsempfänger sind die Träger von staatlich geförderten Frauenhäusern und Fachberatungsstellen, die Mitglieder eines Spitzenverbandes der Freien Wohlfahrtspflege Bayern sind.";
                                                                                                                                           xyz:foerdernehmende  [ xyz:code           "011";
