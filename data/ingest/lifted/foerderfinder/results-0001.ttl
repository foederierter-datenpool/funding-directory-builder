                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>8fc84e50-5c1f-4323-8486-a04bcc88536b</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2026-09-04T11:03:16</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>8fc84e50-5c1f-4323-8486-a04bcc88536b</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>8fc84e50-5c1f-4323-8486-a04bcc88536b</xflb:schluessel>\n         <xflb:versionFLB>3</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2026-09-07T11:55:53</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>8fc84e50-5c1f-4323-8486-a04bcc88536b</xflb:foerderschluessel>\n                  <xflb:flbVersion>3</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400009017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Außerschulische Hausaufgabenhilfe mit Schwerpunkt Deutschförderung</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Ziel der Förderung ist es, den Erwerb der Sprachkompetenz junger Menschen mit Migrationsgeschichte sowie junger Asylbewerberinnen und Asylbewerber mit guter Bleibeperspektive an bayerischen allgemeinbildenden Schulen zwischen der ersten und zehnten Jahrgangsstufe zu unterstützen und damit die alsbaldige Eingliederung zu ermöglichen.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern fördert mit der außerschulischen Hausaufgabenhilfe die sprachliche Integration von schulpflichtigen Kindern und Jugendlichen mit Migrationsgeschichte, die rechtmäßig und dauerhaft in Bayern leben bzw. eine gute Bleibeperspektive haben.</xflb:teaser>\n                  <xflb:schluesselwoerter>Zuwanderer, Spätaussiedler, Deutschförderung, Außerschulische Hausaufgabenhilfe mit Schwerpunkt Deutschförderung, Migranten, Hausaufgabehilfe, Spätaussiedlerprojekte, Deutschförderung, Sprachförderung, Nachhilfe</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Regierung von Mittelfranken - Sachgebiet 15 - Integration und Förderung, Ausgleichsamt</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>21</xflb:hausnummerPostfach>\n                     <xflb:strasse>Marienstraße</xflb:strasse>\n                     <xflb:postleitzahl>90402</xflb:postleitzahl>\n                     <xflb:ort>Nürnberg</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>Sachgebiet-15.Integration@reg-mfr.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Übersicht der Regierung von Mittelfranken</xflb:bezeichnung>\n                     <xflb:link>https://www.regierung.mittelfranken.bayern.de/aufgaben/40027/57461/leistung/leistung_53004/index.html</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>+49 (0)911 2352-0</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Regierung von Mittelfranken - Sachgebiet 15 - Integration und Förderung, Ausgleichsamt</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>21</xflb:hausnummerPostfach>\n                           <xflb:strasse>Marienstraße</xflb:strasse>\n                           <xflb:postleitzahl>90402</xflb:postleitzahl>\n                           <xflb:ort>Nürnberg</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>Sachgebiet-15.Integration@reg-mfr.bayern.de</xflb:email>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Übersicht der Regierung von Mittelfranken</xflb:bezeichnung>\n                           <xflb:link>https://www.regierung.mittelfranken.bayern.de/aufgaben/40027/57461/leistung/leistung_53004/index.html</xflb:link>\n                        </xflb:verweis>\n                        <xflb:telefonnummer>+49 (0)911 2352-0</xflb:telefonnummer>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>33316551-4405-49f1-a910-7844ad81a27b</xflb:id>\n                     <xflb:bezeichnung>Förderung außerschulische Hausaufgabenhilfe (BIR) - Einwilligung Erziehungsberechtigte</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/rmf-zz/15/rmf_15-025-zz/index?caller=762399674965</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>527c3390-2dbd-4e0e-b5f7-1f7ba70a3ae1</xflb:id>\n                     <xflb:bezeichnung>Förderung außerschulische Hausaufgabenhilfe (BIR III) - Auszahlungsantrag</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/rmf-zz/15/rmf_15-043-zz/index?caller=762399674965</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>f74a450e-e552-4f72-aecb-f947362940f7</xflb:id>\n                     <xflb:bezeichnung>Förderung außerschulische Hausaufgabenhilfe (BIR III) - Verwendungsnachweis</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/rmf-zz/15/rmf_15-042-zz/index?caller=762399674965</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>e5a34bb7-5352-48fa-aacd-796968f8547d</xflb:id>\n                     <xflb:bezeichnung>Förderung außerschulische Hausaufgabenhilfe (BIR) - Antrag</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rmf/rmf-zz/15/rmf_15-024-zz/index?caller=762399674965</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n               <xflb:onlinedienste>\n                  <xflb:onlinedienst>\n                     <xflb:id>f0e04605-eb95-4c9f-a4e5-00531206f1d8</xflb:id>\n                     <xflb:bezeichnung>Verwendungsbestätigung für eine Förderung nach der Beratungs- und Integrationsrichtlinie - Außerschulische Hausaufgabenhilfe</xflb:bezeichnung>\n                     <xflb:link>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/rmf_15-042-zz_verwendung/index?caller=bpme4tgylemi2geolbgu3gkzrtmqx7f54hbag3oshbfgxp5d4jokcyxqsq5qzqzf6nzm4jdaubg2zrjeninlrbwronqj73d2vrhfpqvrijfjplsmkfdz2zqfg2svoudepgpjplovylw6zrnalzwawf26mzhjk3snua7p74grujd435tjdh3bxvqvh3u2r3mi2io3vi2lmiwbbny888</xflb:link>\n                     <xflb:beschreibung>Sie können online die Verwendungsbestätigung für eine Förderung der außerschulischen Hausaufgabenhilfe abgeben.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n                  <xflb:onlinedienst>\n                     <xflb:id>cd2adc73-08c2-4df1-afec-67676851d607</xflb:id>\n                     <xflb:bezeichnung>Zuwendungsantrag für eine Förderung nach der Beratungs- und Integrationsrichtlinie - Außerschulische Hausaufgabenhilfe</xflb:bezeichnung>\n                     <xflb:link>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/rmf_15-024-zz_zuwendungsantrag/index?caller=bpmu2dqmjqmfrgeolegrsggolgmzjsccafh6ang7xd6dbbvgkqjdz5pdxszqsxkpj245avkunc2ntpbs2avc6polf2wojqlvdywvutmmx3l373gmexecds5fpr2ytvcarvhdnyg7n5t3nw4usg4msz3n44lgeb63quajz5hszyfnf2dmqha43z3v5csznkqdmtxzhbaqoknw2dpxa7nzdd5aajja6j2jlwwrzshnq8</xflb:link>\n                     <xflb:beschreibung>Sie können den Zuwendungsantrag für eine Förderung der außerschulischen Hausaufgabenhilfe online stellen.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n                  <xflb:onlinedienst>\n                     <xflb:id>6ae3aa52-3496-4ff5-9730-213dc81dcee4</xflb:id>\n                     <xflb:bezeichnung>Auszahlungsantrag für eine Förderung nach der Beratungs- und Integrationsrichtlinie - Außerschulische Hausaufgabenhilfe</xflb:bezeichnung>\n                     <xflb:link>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/rmf_15-043-zz/index?caller=bpmzswcmjxgfrwcmbxmfswczlbgedsu2f6zz24rsviykqjv5rmhwzf3bdfiftf6sgenb3aibccqww7pft4z7nm7j3y4maqt5wafcmjtqbyja6ytlq67fhaic3ejcl4jimhxzhy5omnpviwczur6g343v4nc6nghasvwf22knuzguf2kssqizxplyucgrmiul4d6futctobsh7uysoef4nxz64i7kgqmuhwaqbyw5y8</xflb:link>\n                     <xflb:beschreibung>Sie können die Auszahlung der Förderung der außerschulischen Hausaufgabenhilfe online beantragen.</xflb:beschreibung>\n                     <xflb:identifizierungsmittel>\n                        <xflb:identifizierungsmitteleintrag listURI=\"urn:xoev-de:fim:codeliste:xzufi.identifizierungsmittel\"\n                                                            listVersionID=\"\">\n                           <code>1000</code>\n                           <name/>\n                        </xflb:identifizierungsmitteleintrag>\n                     </xflb:identifizierungsmittel>\n                  </xflb:onlinedienst>\n               </xflb:onlinedienste>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Zuwendungsempfänger ist die unterrichtende\nLehrkraft.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Förderung wird als nicht rückzahlbarer Zuschuss als Festbetragsfinanzierung im Rahmen der Projektförderung in Form von Individualhilfen gewährt (Pro-Kopf-Pauschalen). Die Förderung der außerschulischen Hausaufgabenhilfe erfolgt ohne Rechtsanspruch im Rahmen der zur Verfügung stehenden Haushaltsmittel und subsidiär zu eventuellen anderen Leistungen.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Zuwendungsfähig ist die außerschulische Hausaufgabenhilfe mit Schwerpunkt Deutschförderung. Gefördert werden pro Schuljahr maximal 39 Wochen außerhalb der Ferienzeiten mit maximal bis zu vier Zeitstunden (zu 60 Minuten) wöchentlich pro Teilnehmenden. Die Förderung erfolgt je Teilnehmenden für maximal vier Jahre an bayerischen Schulen im Sinne der Nr. 4.4.2. Die Förderung beträgt je Gruppe 15 Euro je Zeitstunde und erhöht sich ab dem siebten Teilnehmenden um 1,50 Euro je Teilnehmenden und Stunde.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n               <xflb:euBeihilferelevanz>unzutreffend</xflb:euBeihilferelevanz>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium des Innern, für Sport und Integration</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinie für die Förderung der sozialen Beratung, Betreuung und Integration von Menschen mit Migrationsgeschichte (Beratungs- und Integrationsrichtlinie - BIR) vom 26. September 2023</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_2176_I_14046</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>Sachgebiet G3</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Richtlinie für die Förderung der sozialen Beratung, Betreuung und Integration von Menschen mit Migrationsgeschichte (Beratungs- und Integrationsrichtlinie - BIR)</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2026-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2024-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2026-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Ergänzend zu den bereits staatlich geförderten schulischen und außerschulischen Maßnahmen wird außerschulische Hausaufgabenhilfe mit Schwerpunkt Deutschförderung gewährt.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>022</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Der Schüler bzw. die Schülerin hat einen rechtmäßigen und dauerhaften Aufenthalt in Bayern oder ist eine Asylbewerberin bzw. ein Asylbewerber mit guter Bleibeperspektive.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Es wird eine an einer bayerischen allgemeinbildenden Schule zwischen der ersten und der zehnten Jahrgangsstufe eine Deutschförderklasse, ein Deutschförderkurs, eine Übergangsklasse (aktuell: eine Deutschklasse oder eine Maßnahme aus DeutschPLUS) besucht (bzw. die Voraussetzungen zum Besuch einer Deutschklasse oder einer Maßnahme aus DeutschPLUS werden erfüllt).&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Es besteht ein über die schulische Förderung hinausgehender Bedarf an Deutschförderung (Bestätigung durch die Schule erforderlich).&lt;/li&gt;&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/rmf_15-024-zz_zuwendungsantrag/index?caller=bpmu2dqmjqmfrgeolegrsggolgmzjsccafh6ang7xd6dbbvgkqjdz5pdxszqsxkpj245avkunc2ntpbs2avc6polf2wojqlvdywvutmmx3l373gmexecds5fpr2ytvcarvhdnyg7n5t3nw4usg4msz3n44lgeb63quajz5hszyfnf2dmqha43z3v5csznkqdmtxzhbaqoknw2dpxa7nzdd5aajja6j2jlwwrzshnq8</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;h4&gt;Antragstellung&lt;/h4&gt;&lt;p&gt;Anträge sind unter Verwendung der bei der Regierung von Mittelfranken erhältlichen Vordrucke zu stellen. Dieser ist rechtzeitig vor Beginn des geplanten Bewilligungszeitraums zu stellen.&lt;/p&gt;&lt;h4&gt;Bewilligung&lt;/h4&gt;&lt;p&gt;Zuständig für die Bewilligung ist die Regierung von Mittelfranken.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>002</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Bestätigung der Schule</xflb:bezeichnung>\n                     <xflb:erlaeuterung>(Bestätigung des über die schulische Förderung hinausgehenden Bedarfs an Deutschförderung)</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Kopie des Passes des Kindes und der Aufenthaltserlaubnis</xflb:bezeichnung>\n                     <xflb:erlaeuterung>(nur wenn das Kind eine ausländische Staatsangehörigkeit hat; bei EU-Bürgern nur Passkopie)</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Kopie von Pass/Personalausweis des nichtdeutschsprachigen Elternteils</xflb:bezeichnung>\n                     <xflb:erlaeuterung>(nur wenn das Kind die deutsche Staatsangehörigkeit besitzt, aber ein Elternteil nichtdeutscher Herkunft ist)</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Kopie des Vertriebenenausweises/Bescheinigung nach § 15 BVFG</xflb:bezeichnung>\n                     <xflb:erlaeuterung>(nur wenn das Kind Spätaussiedler oder Abkömmling eines Spätaussiedlers ist)</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Gegen den Zuwendungsbescheid können Sie innerhalb eines Monats nach seiner Bekanntgabe Klage erheben. Das zuständige Gericht, bei dem Sie Klage einreichen können, wird Ihnen im Bescheid mitgeteilt.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_177  [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/rmf_15-023_zz_zuwendungsantrag_integrationslotsen/index?caller=bpgvrtonbymy2dgyjxhazdmyjsglmcshwyf6foqxjsd5k3cwlyhkfidha3kbjephdfkfxhvneqo2wmu4fq2dt5vqrf64pwxce7sdgluhes47htosdrjdllvlfv6r6d7lhgk7uybsi74ehbc5pouh2hn352mejashpngqltbc6homillf6rg5h62qvi74fogacdhlfptzrvshkhdlr6gjv3wriv7dxfgbhijih6u7icbsefzrhp4e6vfzdycl4edooc";
                                xyz:begriffeImKontext    [ rdf:_1  "Hauptamtliche Integrationslotsinnen und lotsen";
                                                           rdf:_2  "Lotse";
                                                           rdf:_3  "Intergration";
                                                           rdf:_4  "Ehrenamt";
                                                           rdf:_5  "Asylunterstützung";
                                                           rdf:_6  "Asyl"
                                                         ];
                                xyz:beschreibung         "<p>Die hauptamtlichen Integrationslotsen sollen das im Bereich Asyl und Integration tätige Ehrenamt auf kommunaler Ebene praxisbezogen unterstützten. Ziel ist dabei die Schaffung verlässlicher Rahmenbedingungen für ehrenamtliche Tätigkeit, eine stärkere Vernetzung der regionalen Akteure und Fortbildung der Ehrenamtlichen sowie die Gewinnung und effiziente Vermittlung weiterer freiwilliger Helferinnen und Helfer.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Integration" ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Kommunen" ];
                                xyz:foerderprogramm      "Richtlinie für die Förderung der sozialen Beratung, Betreuung und Integration von Menschen mit Migrationsgeschichte (Beratungs- und Integrationsrichtlinie - BIR)";
                                xyz:foerderzeitraum.bis  "2026-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2024-01-01T00:00:00.000+00:00";
                                xyz:schluessel           "248722ab-a4ef-413a-90ea-b0a0152fff58";
                                xyz:teaser               "Der Freistaat Bayern unterstützt mit der Förderung von hauptamtlichen Integrationslotsinnen und Integrationslotsen die Kommunen dabei, die Tätigkeit von Ehrenamtlichen im Bereich Asyl und Integration auf kommunaler Ebene praxisbezogen zu unterstützen.";
                                xyz:titel                "Hauptamtliche Integrationslotsinnen und -lotsen";
                                xyz:titel.tokens         [ rdf:_1  "Hauptamtliche Integrationslotsinnen und -lotsen" ];
                                xyz:voraussetzung        "<p>Die eingesetzten Personen sollen über eigene Erfahrungen im Bereich der ehrenamtlichen Tätigkeit verfügen. Zudem sind praktische Erfahrungen im Tätigkeitsfeld der Freiwilligenkoordination sowie in der Betreuung von Menschen mit Migrationsgeschichte hilfreich.&nbsp;</p><p>Der Fördergeber fördert für bis zu drei Jahre im Rahmen einer Anteilfinanzierung bis zu 80% der zuwendungsfähigen Ausgaben. Der Antragsteller muss einen angemessenen Eigenanteil in Höhe von mindestens 10% der zuwendungsfähigen Gesamtausgaben erbringen, der auch über Drittmittel erbracht werden kann.</p>"
                              ];
