                                                                                                                                           xyz:beschreibung       [ xyz:schluesselwoerter  "Baumaßnahmen bei Bibliotheken, Fahrbücherei, RFID";
                                                                                                                                                                    xyz:teaser             "Der Freistaat Bayern fördert Investitionen bei nichtstaatlichen Bibliotheken";
                                                                                                                                                                    xyz:zuwendungszweck    "<p>Förderung von Investitionen bei nichtstaatlichen Bibliotheken. Das Fördergebiet umfasst ganz Bayern, ausgeschlossen sind Vorhaben in München und Nürnberg. Die kulturellen Vorhaben müssen überregionale Bedeutung haben. Zuständig für die Antragsbearbeitung ist die jeweilige Bezirksregierung, in deren Region das Vorhaben durchgeführt werden soll.</p>"
                                                                                                                                                                  ];
