                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>11a3ca68-c6dc-48f0-b64c-39280534c294</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2023-12-12T08:26:20</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>11a3ca68-c6dc-48f0-b64c-39280534c294</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>11a3ca68-c6dc-48f0-b64c-39280534c294</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2023-12-12T08:26:20</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>11a3ca68-c6dc-48f0-b64c-39280534c294</xflb:foerderschluessel>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n               <xflb:leika>\n                  <xflb:leikaSchluessel>99400108017000</xflb:leikaSchluessel>\n                  <xflb:typLeistung>\n                     <xflb:typisierungDerLeistung listURI=\"urn:de:fim:leika:typisierung\" listVersionID=\"20230116\">\n                        <code>4</code>\n                        <name/>\n                     </xflb:typisierungDerLeistung>\n                  </xflb:typLeistung>\n               </xflb:leika>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Ausstellungsförderung</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Zur Erhöhung der Zahl an Präsentationsmöglichkeiten in Bayern für in Bayern wirkende Künstlerinnen und Künstler kann für Sammelausstellungen eine Förderung beantragt werden.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern unterstützt beispielsweise Kunstvereine dabei, mehr Ausstellungen durchzuführen.</xflb:teaser>\n                  <xflb:schluesselwoerter>Bildende Kunst, Ausstellung, Kunstprojekt</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:alternativeFoerdermoeglichkeiten>\n                  <xflb:alternativeFoerdermoeglichkeit>\n                     <xflb:beschreibung>Für Künstlergruppen, Symposien</xflb:beschreibung>\n                     <xflb:verweis>\n                        <xflb:bezeichnung>Kulturfonds Bayern Kunst</xflb:bezeichnung>\n                        <xflb:link>https://www.stmwk.bayern.de/ministerium/kulturfonds/kunst-und-kultur.html</xflb:link>\n                     </xflb:verweis>\n                  </xflb:alternativeFoerdermoeglichkeit>\n                  <xflb:alternativeFoerdermoeglichkeit>\n                     <xflb:beschreibung>Für freie Künstler</xflb:beschreibung>\n                     <xflb:verweis>\n                        <xflb:bezeichnung>Ausschreibungen des BBK Landesverbandes</xflb:bezeichnung>\n                        <xflb:link>https://www.bbk-bayern.de</xflb:link>\n                     </xflb:verweis>\n                  </xflb:alternativeFoerdermoeglichkeit>\n               </xflb:alternativeFoerdermoeglichkeiten>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayerisches Staatsministerium für Wissenschaft und Kunst</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>2</xflb:hausnummerPostfach>\n                     <xflb:strasse>Salvatorstr.</xflb:strasse>\n                     <xflb:postleitzahl>80333</xflb:postleitzahl>\n                     <xflb:ort>München</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>ReferatK.8@stmwk.bayern.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Künstlerförderung Bayern</xflb:bezeichnung>\n                     <xflb:link>https://www.stmwk.bayern.de/kunst-und-kultur/foerderung/kuenstlerfoerderung.html</xflb:link>\n                  </xflb:verweis>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Bayerisches Staatsministerium für Wissenschaft und Kunst SG K</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>2</xflb:hausnummerPostfach>\n                           <xflb:strasse>Salvatorstr.</xflb:strasse>\n                           <xflb:postleitzahl>80333</xflb:postleitzahl>\n                           <xflb:ort>München</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>ReferatK.8@stmwk.bayern.de</xflb:email>\n                        <xflb:verweis>\n                           <xflb:bezeichnung>Künstlerförderung Bayern</xflb:bezeichnung>\n                           <xflb:link>https://www.stmwk.bayern.de/kunst-und-kultur/foerderung/kuenstlerfoerderung.html</xflb:link>\n                        </xflb:verweis>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>1d9dbe4c-a0d6-4e77-a783-7e40b43047c6</xflb:id>\n                     <xflb:bezeichnung>Muster 1a zu Art. 44 BayHO - Zuwendung - Antrag</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index</xflb:link>\n                     <xflb:beschreibung>&lt;p&gt;Sie können das Antragsformular online ausfüllen und herunterladen.&lt;/p&gt;</xflb:beschreibung>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Die Förderung kann beantragt werden durch juristische Personen des privaten oder öffentlichen Rechts mit Sitz in Bayern (zum Beispiel Vereine, Stiftungen oder öffentliche Einrichtungen), die nicht gewinnorientiert am Markt tätig sind und die eine mindestens dreijährige Ausstellungstätigkeit durchführen.\n\nDer Berufsverband Bildender Künstlerinnen und Künstler Landesverband Bayern (BBK) stellt einen Sammelantrag für die Projekte seiner Regionalverbände.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Festbetragsfinanzierung zwischen 5.000,00 € bis 80.000,00 €&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Als zuwendungsfähig gelten die Ausgaben, die mit der Durchführung des Projektes entstehen:&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Personal- und Sachausgaben, die in unmittelbarem Zusammenhang mit dem Projekt anfallen, (insbesondere Verbrauchsmaterial, Ausgaben für Aufbauarbeiten, Transportausgaben, nachgewiesene Reisekosten sowie Übernachtungs- und Verpflegungskosten der Künstlerinnen und Künstler für die Arbeit vor Ort in entsprechender Anwendung des BayRKG). Material für Kunstwerke selbst ist nicht zuwendungsfähig, auch wenn die Werke speziell für das Projekt vor Ort erschaffen werden.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Anteile an jährlichen Gesamtausgaben (z.B. Personal-, Raum und Betriebsausgaben) können anerkannt werden, sofern sie nachvollziehbar belegt und begründet werden können und ein eindeutiger Projektbezug vorliegt (bspw. Personalausgaben: Gehaltsnachweis, Beleg der für das Projekt eingebrachten Arbeitszeit, nachvollziehbare Berechnung des auf die Ausstellung fallenden Anteils an Gemeinkosten). Die Abrechnung von Pauschalen ist grundsätzlich unzulässig.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Ausgaben für Vernissage und Finissage (Verpflegung, Musikalische Umrahmung), soweit sie 10 v. H. der Gesamtausgaben des Projekts nicht übersteigen, sowie Ausgaben für ein Rahmenprogramm (Kunstvermittlung, Sonderveranstaltungen, Performances o.ä.), soweit sie ebenfalls 10 v. H. der Gesamtausgaben des Projekts nicht übersteigen. Für ein besonderes Vermittlungsprogramm oder für projektbezogene Vortrags- und Diskussionsveranstaltungen können höhere Ausgaben genehmigt werden.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Leihgebühren für das Zurverfügungstellen von Kunstwerken, sofern diese Ausgaben tatsächlich gezahlt werden. Es können dabei auch Leihgebühren für Werke gezahlt werden, die im Eigentum der Schöpferinnen und Schöpfer stehen. Der Ankauf oder die Erstellung von Kunstwerken ist nicht förderfähig.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Angemessene Aufwandsentschädigungen für Künstlerinnen und Künstler für Arbeiten vor Ort (z.B. Auf- und Abbau, Aufsicht, Vortrag, Moderation), sofern diese tatsächlich gezahlt werden, sie in einem angemessenen Verhältnis zum tatsächlichen Zeitaufwand stehen und nicht der Erstellung eines Kunstwerkes dienen.&amp;nbsp;&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Investitionsausgaben, Preise, Künstlergeschenke und kommunale Regiearbeiten sind nicht zuwendungsfähig. Ist aus wirtschaftlichen Gründen eine Anschaffung der Leihe eines Gegenstands vorzuziehen, sind die hierfür anfallenden Ausgaben maximal bis zur Höhe der für das Projekt vergleichsweise anfallenden Leihgebühr zuwendungsfähig.&lt;/li&gt;&lt;/ul&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n               <xflb:euBeihilferelevanz>Eine EU Beihilferelevanz ist nicht zu beachten.</xflb:euBeihilferelevanz>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Wissenschaft und Kunst</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 23 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO-23</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Art. 44 Haushaltsordnung des Freistaates Bayern (Bayerische Haushaltsordnung - BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayHO-44</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Künstlerförderung Bayern</xflb:bezeichnung>\n                     <xflb:link>https://www.stmwk.bayern.de/kunst-und-kultur/foerderung/kuenstlerfoerderung.html</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinie Ausstellungsförderung</xflb:bezeichnung>\n                     <xflb:link>https://www.gesetze-bayern.de/Content/Document/BayVV_220_WK_14232</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:programmtitel>Ausstellungen im Bereich der Bildenden Kunst</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2026-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2024-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2026-12-31</xflb:endeLaufzeitFoerderprogramm>\n                  <xflb:verlaengerungsoption>Eine Verlängerung des Programms ist möglich.</xflb:verlaengerungsoption>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Eine Förderung kommt für Sammelausstellungen in Betracht, an denen mindestens fünf professionelle lebende Künstlerinnen und Künstler beteiligt sind. Der überwiegende Teil der beteiligten Künstlerinnen und Künstler muss in Bayern wirken. Die Professionalität ist gegeben, wenn eine abgeschlossene künstlerische Ausbildung oder eine mindestens dreijährige Ausstellungstätigkeit nachgewiesen werden kann.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>013</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Die Förderung kann beantragt werden durch in verbindlichen Strukturen organisierte Aussteller (insbes. Vereine, Verbände, Kommunen), die eine mindestens dreijährige Ausstellungserfahrung haben und keine Gewinnabsicht. Der Berufsverband Bildender Künstlerinnen und Künstler Landesverband Bayern (BBK Landesverband) stellt einen Sammelantrag für die Projekte seiner Regionalverbände.&lt;/p&gt;&lt;p&gt;Das Projekt muss zudem folgende Voraussetzungen erfüllen:&lt;/p&gt;&lt;ul&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Das Projekt muss den Schwerpunkt im Bereich der bildenden Kunst haben.&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Das künstlerische Konzept muss klar im Vordergrund stehen, eine prinzipiell gegebene Erwerbsmöglichkeit von Kunstwerken stellt die Förderfähigkeit jedoch nicht in Frage&lt;/li&gt;&lt;li class=\"unordered-list-item--dash\"&gt;Das Projekt ist von überregionaler Bedeutung. Indiz für die Überregionalität des Projektes sind z.B. Zuschüsse des Landkreises und/oder des Bezirks.&lt;/li&gt;&lt;/ul&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:rechtlicheBeschreibung>&lt;p&gt;Die Förderung kann beantragt werden durch juristische Personen des privaten und des öffentlichen Rechts mit Sitz in Bayern, die nicht gewinnorientiert am Markt tätig sind und die eine mindestens dreijährige Ausstellungstätigkeit nachweisen können.&lt;/p&gt;</xflb:rechtlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Eine Antragstellung durch natürliche Personen sowie Personengesellschaften ist ausgeschlossen.&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Nach Ende der Antragsfrist werden alle Anträge geprüft. Die vorhandenen Mittel werden auf die fristgerecht gestellten Anträge verteilt. Der Zuwendungsbescheid ergeht sobald die Verteilung gebilligt ist und die notwendigen Mittel zur Verfügung stehen.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>003</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:antragsfrist>\n                  <xflb:zeitlicheEingrenzung>\n                     <xflb:fristdatum>2024-01-01</xflb:fristdatum>\n                  </xflb:zeitlicheEingrenzung>\n                  <xflb:bemerkung>bzw. der 01.01. des jeweiligen Veranstaltungsjahres</xflb:bemerkung>\n               </xflb:antragsfrist>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Antrag mit Erklärung, dass mit dem Projekt noch nicht begonnen wurde</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Formlos oder mit dem Muster 1a zu den VV zu Art. 44 BayHO.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Projektbeschreibung</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Dies gilt insbesondere für die Darstellung des Ausstellungskonzepts.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Liste der teilnehmenden Künstlerinnen und Künstler</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Bitte unter Angabe des jeweiligen Wirkungsorts und Bestätigung der Professionalität.</xflb:erlaeuterung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>detaillierter in Einnahmen und Ausgaben gegliederter, ausgeglichener Finanzplan</xflb:bezeichnung>\n                     <xflb:erlaeuterung>Bitte erläutern Sie die Höhe der Beträge (z.B. Fahrtkosten 500 € für 10 Fahrten innerhalb Bayerns).</xflb:erlaeuterung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Die Förderung erfolgt ohne Rechtsanspruch im Rahmen der verfügbaren Haushaltsmittel.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_57   [ xyz:attributes  [ xyz:antragsstellung      "https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmwk/blfd/kulturfonds_kunst/index?caller=bpmvsdiobwgiytgytcmvtgindbgzqlaxkqvlgmhv2vtozyv4ar6vuoygjpsweeywtirp774me4sq34jqtm6o33h47iwknvj4kfyd7a5lzntit5enbekzpsmuch6yv2tq3w34fbcsmvglpjgisztwxvu4jq6x42yhw7vh6dz5rj5gie2zi4jdrhjy2vaqpckkb2e2j75g6eew4sh3abmbnvcwuvjixojuqalbj33xi8";
