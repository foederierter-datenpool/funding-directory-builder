                                                                                                             xyz:antragsinformationen    [ xyz:antragsfrist             [ xyz:bemerkung             "Der Bewilligungszeitraum beträgt bis zu drei Jahre (Ende mit Außerkrafttreten der Richtlinie). Der Zuwendungsempfänger kann eine einjahres-, zweijahres- oder dreijahresbezogene Förderung beantragen. Der Antrag ist vor Beginn des Bewilligungszeitraums grundsätzlich bis spätestens 15. November des Vorjahres zu stellen. Etwaige Änderungen nach Antragstellung können der Bewilligungsbehörde noch bis spätestens 15. März des Bewilligungszeitraums mitgeteilt werden.";
                                                                                                                                                                          xyz:zeitlicheEingrenzung  [ xyz:fristdatum
                                                                                                                                                                                            "2026-12-31" ]
                                                                                                                                                                        ];
                                                                                                                                           xyz:beantragungskosten       [ xyz:kostenlos
                                                                                                                                                             "ja" ];
                                                                                                                                           xyz:erforderlicheUnterlagen  [ xyz:dokument  [ rdf:_1  [ xyz:bezeichnung  "Ausgaben- und Finanzierungsplan" ];
                                                                                                                                                                                          rdf:_2  [ xyz:bezeichnung  "Übersicht über das eingesetzte Personal und dessen Ausgaben sowie über die sonstigen Ausgaben" ];
                                                                                                                                                                                          rdf:_3  [ xyz:bezeichnung  "Projektkonzept (aussagekräftiges Konzept der geplanten Maßnahme)" ]
                                                                                                                                                                                        ]
                                                                                                                                                                        ];
                                                                                                                                           xyz:linkZurAntragsstellung   "https://formularserver-bp.bayern.de/intelliform/forms/bayernportal/bayernportal/Ministerien/stmi/rmf_15-036_zz_auszahlungsantrag_bm/index?caller=bpgjrdozrwhbstiyjvhfqtaobtmwpa7l7kbmah7fttz24zkz7ua6nko7g7bwgc4g7sepsq45pv3veqfbqshn7lqwb4gbenfznfmuuift7grbzumxy74g32c5l3j6sryhyy55psftox6m5senwvxgdo2bb7xukyn4vxer7nbtz7dfrpizm6i7n34m265prs4fvnjq4h63ix2d3ap3j5ygwtxyjcekc3obvzciujjbnzxtm4kook4mnmher5ecfwfudr";
                                                                                                                                           xyz:rechtsbehelf             "<p>Gegen den Zuwendungsbescheid können Sie innerhalb eines Monats nach seiner Bekanntgabe Klage erheben. Das zuständige Gericht, bei dem Sie Klage einreichen können, wird Ihnen im Bescheid mitgeteilt.</p>";
                                                                                                                                           xyz:verfahrensablauf         [ xyz:bewilligung                 "<h4>Antragstellung</h4><p>Anträge sind unter Verwendung der bei der Regierung von Mittelfranken erhältlichen Vordrucke zu erstellen und bei dieser einzureichen. Dem Staatsministerium des Innern, für Sport und Integration ist ein Abdruck (mit Anlagen) zu übersenden. Den Anträgen sind ein Ausgaben- und Finanzierungsplan, der auf die pauschalierten Personalausgaben abstellt, sowie eine Übersicht über das eingesetzte Personal beizufügen. Zusätzlich ist ein aussagekräftiges Projektkonzept einzureichen, in dem auf die Situation vor Ort, die im Projekt geplanten Maßnahmen und den gewünschten Erfolg (bzw. wie dieser erreicht wird) eingegangen wird.</p><h4>Bewilligung</h4><p>Zuständig für die Bewilligung ist die Regierung von Mittelfranken. Zuwendungen können grundsätzlich nur dann bewilligt werden, wenn mit dem jeweiligen Projekt noch nicht begonnen wurde. Der Bewilligungszeitraum beträgt bis zu drei Jahren.</p>";
                                                                                                                                                                          xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "002";
                                                                                                                                                                                                            xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
                                                                                                                                                                                                            xyz:listVersionID  "1"
                                                                                                                                                                                                          ]
                                                                                                                                                                        ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:euBeihilferelevanz        "unzutreffend";
                                                                                                                                           xyz:finanzierungsartUndHoehe  "<p>Die Zuwendung wird als Anteilfinanzierung im Rahmen einer Projektförderung gewährt; jedoch bis maximal 90% der zuwendungsfähigen Ausgaben.</p><p>Die staatliche Förderung setzt eine Beteiligung des Zuwendungsempfängers in Höhe von mindestens 10% der zuwendungsfähigen Projektausgaben voraus, die auch über Drittmittel erbracht werden kann.</p><p>Die Förderung erfolgt ohne Rechtsanspruch im Rahmen zur Verfügung stehender Haushaltsmittel.</p>";
                                                                                                                                           xyz:finanzierungsformen       [ xyz:finanzierungsform  [ xyz:code           "001";
                                                                                                                                                                                                    xyz:listURI        "urn:xoev-de:stmd:codeliste:finanzierungsform";
