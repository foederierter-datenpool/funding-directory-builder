                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:bn-beh=\"http://xoev.de/schemata/basisnachricht/behoerde/1_1\"\n                                           xmlns:bn-g2g=\"http://xoev.de/schemata/basisnachricht/g2g/1_1\"\n                                           xmlns:bn-kom=\"http://xoev.de/schemata/basisnachricht/kommunikation/1_1\"\n                                           xmlns:bn-uq-g2g=\"http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1\"\n                                           xmlns:din91379=\"urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08\"\n                                           xmlns:dinspec91379=\"urn:xoev-de:kosit:xoev:datentyp:din-spec-91379_2019-03\"\n                                           xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xoev-code=\"http://xoev.de/schemata/code/1_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>610a4263-c1b3-428a-bf15-73e74dfcfad5</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2024-01-24T09:39:07</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>610a4263-c1b3-428a-bf15-73e74dfcfad5</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>610a4263-c1b3-428a-bf15-73e74dfcfad5</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2024-01-24T09:39:07</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>610a4263-c1b3-428a-bf15-73e74dfcfad5</xflb:foerderschluessel>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Bezuschussung einer literarischen Veranstaltung durch Bayern liest e. V.</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Förderung von Lesungen von Autoren/Autorinnen&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Gefördert werden Lesungen vor Ort von Autoren/Autorinnen an öffentlichen Büchereien, gemeinnützigen Einrichtungen des öffentlichen Lebens, Buchhandlungen etc.</xflb:teaser>\n                  <xflb:schluesselwoerter>Literatur, Literaturförderung, Lesung, Autorenlesung</xflb:schluesselwoerter>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Zuschussantrag</xflb:bezeichnung>\n                     <xflb:link>https://www.bayern-liest.de/formulare/zuschussantrag</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:allgemeineFragen>\n                  <xflb:name>Bayern liest e. V.</xflb:name>\n                  <xflb:adresse>\n                     <xflb:hausnummerPostfach>160</xflb:hausnummerPostfach>\n                     <xflb:strasse>Schäftlarnstraße</xflb:strasse>\n                     <xflb:postleitzahl>81371</xflb:postleitzahl>\n                     <xflb:ort>München</xflb:ort>\n                  </xflb:adresse>\n                  <xflb:email>geschaeftsstelle@bayern-liest.de</xflb:email>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Zuschussrichtlinien</xflb:bezeichnung>\n                     <xflb:link>https://www.bayern-liest.de/formulare/zuschussrichtlinien</xflb:link>\n                  </xflb:verweis>\n                  <xflb:telefonnummer>0151 - 46 355 734</xflb:telefonnummer>\n                  <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                             listVersionID=\"1\">\n                     <code>002</code>\n                     <name>Zuständige Stelle</name>\n                  </xflb:organisationseinheit>\n               </xflb:allgemeineFragen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleKontaktdetails>\n                        <xflb:name>Bayern liest e. V.</xflb:name>\n                        <xflb:adresse>\n                           <xflb:hausnummerPostfach>160</xflb:hausnummerPostfach>\n                           <xflb:strasse>Schäftlarnstraße</xflb:strasse>\n                           <xflb:postleitzahl>81371</xflb:postleitzahl>\n                           <xflb:ort>München</xflb:ort>\n                        </xflb:adresse>\n                        <xflb:email>geschaeftsstelle@bayern-liest.de</xflb:email>\n                        <xflb:telefonnummer>0151 - 46 355 734</xflb:telefonnummer>\n                        <xflb:organisationseinheit listURI=\"urn:xoev-de:stmd:codeliste:organisationseinheit\"\n                                                   listVersionID=\"1\">\n                           <code>002</code>\n                           <name>Zuständige Stelle</name>\n                        </xflb:organisationseinheit>\n                     </xflb:zustaendigeStelleKontaktdetails>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>001</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>006</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>007</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>008</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>010</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>011</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>012</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Veranstalter von Lesungen</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:zuwendungsart listURI=\"urn:xoev-de:stmd:codeliste:zuwendungsart\" listVersionID=\"1\">\n                  <code>001</code>\n               </xflb:zuwendungsart>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>001</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Der Zuschuss im Rahmen der Festbetragsfinanzierung beträgt beim Honorar für die 1. Lesung max. € 220,-, ab der 2. Lesung max. € 110,-. Der Zuschuss beträgt bei den Fahrtkosten max. 50 %. Dabei finden Bahnfahrkarten 2. Klasse inkl. Zuschläge oder € 0,26 pro km bei Fahrten mit dem Auto bis zur Höhe der fiktiven Bahnkosten Berücksichtigung. Der Zuschuss beträgt für Übernachtungen max. € 20,-. Der Zuschuss beträgt für das Tagegeld max. € 10,-. Rahmenprogramme bzw. Mitveranstaltende wie Sprecher oder Musiker werden nicht bezuschusst.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Honorar, Fahrtkosten, Übernachtungskosten und Tagegeld im Rahmen von Lesungen&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n               <xflb:laufzeitFinanzierung>\n                  <xflb:laufzeitFinanzierung listURI=\"urn:xoev-de:stmd:codeliste:laufzeit-finanzierung\"\n                                             listVersionID=\"1\">\n                     <code>001</code>\n                     <name>Gesamte Projektlaufzeit</name>\n                  </xflb:laufzeitFinanzierung>\n               </xflb:laufzeitFinanzierung>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Wissenschaft und Kunst</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Grundsätze für die Förderung literarischer Festivals und Veranstaltungen</xflb:bezeichnung>\n                     <xflb:link>https://www.stmwk.bayern.de/kunst-und-kultur/foerderung/literaturfoerderung.html</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:verantwortlichesFachreferat>K.1</xflb:verantwortlichesFachreferat>\n               <xflb:programmtitel>Förderung und Pflege der Literatur</xflb:programmtitel>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2026-01-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2028-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n               <xflb:kummulierbareFoerderungen>\n                  <xflb:voraussetzungen>&lt;p&gt;Eine Kombination mit anderen Fördermitteln ist möglich.&lt;/p&gt;</xflb:voraussetzungen>\n               </xflb:kummulierbareFoerderungen>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert werden Lesungen vor Ort von Autoren/Autorinnen an öffentlichen Büchereien, gemeinnützigen Einrichtungen des öffentlichen Lebens, Buchhandlungen etc.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>013</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Autorenbegegnungen können nur in Bayern gefördert werden.&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n               <xflb:ausschlusskriterien>&lt;p&gt;Staatliche oder durch Staatsgelder zu diesem Zweck geförderte Institutionen (z. B. Friedrich-Bödecker-Kreis) dürfen an der Veranstaltung nicht beteiligt sein.&lt;/p&gt;</xflb:ausschlusskriterien>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://www.bayern-liest.de/formulare/zuschussantrag</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Nach der Veranstaltung ist innerhalb von vier Wochen das Honorarabrechnungsformular einzureichen. Danach verfällt der Anspruch auf einen Zuschuss. Die Auszahlung der Mittel an Bayern liest e. V. erfolgt durch das Bayerische Staatsministerium für Wissenschaft und Kunst nach Bekanntgabe des Bayerischen Staatshaushalts. Daraus ergibt sich, dass vorher noch keine Zuschüsse ausgezahlt werden können.&lt;/p&gt;</xflb:bewilligung>\n                  <xflb:vorzeitigerMassnahmebeginn listURI=\"urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn\"\n                                                   listVersionID=\"1\">\n                     <code>006</code>\n                  </xflb:vorzeitigerMassnahmebeginn>\n                  <xflb:erlaeuterungVorzeitigerMassnahmebeginn>&lt;p&gt;nicht erforderlich&lt;/p&gt;</xflb:erlaeuterungVorzeitigerMassnahmebeginn>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:rechtsbehelf>&lt;p&gt;Der Verein Bayern liest e. V. entscheidet über die Gewährung der Fördermittel.&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
  rdf:_171  [ xyz:attributes  [ xyz:antragsstellung      "https://www.polizei.bayern.de/wir-ueber-uns/004129/index.html";
                                xyz:begriffeImKontext    [ rdf:_1  "BayernPortal";
                                                           rdf:_2  "Beantragung";
                                                           rdf:_3  "Digitalfunkförderung";
                                                           rdf:_4  "digitale Endgeräte";
                                                           rdf:_5  "staatliche Förderung";
                                                           rdf:_6  "Digitalfunk"
                                                         ];
                                xyz:beschreibung         "<p>Zuwendungen werden für die Erstbeschaffung von digitalen TETRA-Endgeräten zur Teilnahme am Betrieb des digitalen Sprech- und Datenfunksystems der Behörden und Organisationen mit Sicherheitsaufgaben (BOS) in Bayern in den Bereichen Feuerwehr, Rettungsdienst und Katastrophenschutz gewährt. Sie sollen den Zuwendungsempfängern die für den Umstieg vom Analogfunk zur Teilnahme am digitalen BOS-Funk notwendigen Beschaffungen ermöglichen.</p><p>Mittlerweile ist der erste Teil der Endgeräteförderung, die Ausstattung von Fahrzeugen und Funktionen mit Fahrzeugfunkgeräten MRT, Handfunkgeräten HRT und Festfunkstellen FRT weitestgehend abgeschlossen. Der Fokus liegt damit auf dem zweiten Teil, der Förderung von Alarmmeldeempfängern (Pagern) und Sirenensteuergeräten für den Umstieg von der analogen zur digitalen Alarmierung.</p>";
                                xyz:finanzierungsform    [ rdf:_1  "Zuschuss" ];
                                xyz:foerderbereich       [ rdf:_1  "Digitalisierung";
                                                           rdf:_2  "Infrastruktur"
                                                         ];
                                xyz:foerdergeber         [ rdf:_1  "Land" ];
                                xyz:foerdergebiet        [ rdf:_1  "Bayern" ];
                                xyz:foerdernehmer        [ rdf:_1  "Kommunen";
                                                           rdf:_2  "Verbände"
                                                         ];
                                xyz:foerderprogramm      "Sonderförderprogramm Digitalfunk";
                                xyz:foerderzeitraum.bis  "2026-12-31T00:00:00.000+00:00";
                                xyz:foerderzeitraum.von  "2021-09-13T00:00:00.000+00:00";
                                xyz:schluessel           "3f7b5e19-28c1-497c-9474-d7b9843c8173";
                                xyz:teaser               "Der Freistaat Bayern unterstützt Kommunen, die Durchführenden des Land- und Luftrettungsdienstes, die Kassenärztliche Vereinigung Bayerns und die freiwilligen Hilfsorganisationen des Katastrophenschutzes bei der Erstbeschaffung der Endgeräte für den digitalen BOS-Funk.";
                                xyz:titel                "Förderung von zertifizierten BOS-TETRA-Pagern (APRT) und von Komponenten zur Ertüchtigung von Sirenenanlagen für die TETRA-Alarmierung - Digitalfunk";
                                xyz:titel.tokens         [ rdf:_1  "Förderung von zertifizierten BOS-TETRA-Pagern (APRT) und von Komponenten zur Ertüchtigung von Sirenenanlagen für die TETRA-Alarmierung - Digitalfunk" ];
                                xyz:voraussetzung        "<p>Gefördert werden die Beschaffungen insbesondere nur dann, wenn sie im Rahmen des Umstiegs vom Analogfunk zur Teilnahme am digitalen BOS-Funk in den Bereichen Feuerwehr, Rettungsdienst und Katastrophenschutz erfolgen. Die zur Förderung beantragten Endgeräte müssen ferner fachlich notwendig sowie für die Teilnahme am BOS-Funk zertifiziert sein und die weiteren Anforderungen der Autorisierten Stelle Bayern erfüllen.&nbsp;</p><p>Es können nur Vorhaben gefördert werden, mit denen noch nicht begonnen worden ist. Bei Beschaffungen ist als Vorhabenbeginn grundsätzlich der Abschluss eines Lieferungs- oder Leistungsvertrages zu werten.&nbsp;</p><p>Gefördert wird zudem nur der Kauf von Endgeräten, eine Förderung von Leasing oder Mietkauf ist ausgeschlossen.&nbsp;</p><p>Weitere Fördervoraussetzungen für die Beschaffung digitaler Endgeräte sind im einschlägigen Sonderförderprogramm und den allgemeinen haushaltsrechtlichen Bestimmungen, insbesondere den Verwaltungsvorschriften zu Art. 44 Bayerische Haushaltsordnung (BayHO), enthalten.</p>"
                              ];
              xyz:id          "3f7b5e19-28c1-497c-9474-d7b9843c8173";
              xyz:payload     [ xyz:json  [ xyz:anfrage            [ xyz:anfragenummer  "3f7b5e19-28c1-497c-9474-d7b9843c8173";
