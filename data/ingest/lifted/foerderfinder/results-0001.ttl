                                                                                                             xyz:antragsinformationen    [ xyz:beantragungskosten      [ xyz:kostenlos
                                                                                                                                                             "ja" ];
                                                                                                                                           xyz:linkZurAntragsstellung  "https://www.fbkbayern.de/autorenbegegnungen/antrag-auf-zuschuss/";
                                                                                                                                           xyz:rechtsbehelf            "<p>Der Friedrich-Bödecker-Kreis in Bayern e. V. entscheidet über die Gewährung der Fördermittel.</p>";
                                                                                                                                           xyz:verfahrensablauf        [ xyz:bewilligung                 "<p>Mit der Bewilligung des Antrags erhält der Veranstalter die Abrechnungsunterlagen (Honorar- und Reisekostenabrechnung, Lesungsprotokoll), die nach der Veranstaltung ausgefüllt an den Friedrich-Bödecker-Kreis in Bayern e. V. zurückgeschickt werden müssen.&nbsp;</p><p>Der Veranstalter zahlt an die Autorin oder den Autor Honorar und Nebenkosten nach Vereinbarung aus. Der Veranstalter sendet das FBK-Abrechnungsformular und das Lesungsprotokoll nach der Lesung möglichst umgehend ausgefüllt an die Geschäftsstelle zurück.</p>";
                                                                                                                                                                         xyz:erlaeuterungVorzeitigerMassnahmebeginn
                                                                                                                                                                                 "<p>nicht erforderlich</p>";
                                                                                                                                                                         xyz:vorzeitigerMassnahmebeginn  [ xyz:code           "006";
                                                                                                                                                                                                           xyz:listURI        "urn:xoev-de:stmd:codeliste:vorzeitiger-massnahmebeginn";
                                                                                                                                                                                                           xyz:listVersionID  "1"
                                                                                                                                                                                                         ]
                                                                                                                                                                       ]
                                                                                                                                         ];
                                                                                                             xyz:finanzierung            [ xyz:finanzierungsartUndHoehe  "<p>Der Zuschussbetrag im Rahmen der Festbetragsfinanzierung beträgt höchstens 50 % der zuschussfähigen Kosten. Der Zuschuss beträgt:&nbsp;</p><ol><li class=\"ordered-list-item--numbered\">Honorar: für die 1. Lesung max. 110,00 €, für Mitglieder als Veranstalter max. 130,00 €, für weitere Lesungen am gleichen Tag und Ort jeweils max. 65,00 €, für Mitglieder als Veranstalter max. 75,00 €&nbsp;</li><li class=\"ordered-list-item--numbered\">Fahrtkosten: max. 50 % der DB-Fahrtkosten in der 2. Klasse oder 0,13 € pro km bei Anfahrt im PKW (bis zur Höhe der fiktiven Bahnkosten)&nbsp;</li><li class=\"ordered-list-item--numbered\">Tagegeld: max. 10,00 € (nur bei zeitlicher Aufwendung von mehr als 6 Stunden)&nbsp;</li><li class=\"ordered-list-item--numbered\">Übernachtungsgeld: max. 20,00 €</li></ol><p>Rahmenprogramme bzw. Mitveranstaltende wie Sprecher, Schauspieler oder Musiker werden nicht bezuschusst.</p>";
