                                xyz:xml   "<xflb:veroeffentlichung.anfrage.flb.001001 xmlns:xflb=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n                                           xsi:schemaLocation=\"http://xoev.de/schemata/xflb/2_0_0\"\n                                           standard=\"XFLB\"\n                                           produkthersteller=\"StMD Bayern\"\n                                           produkt=\"Förderfinder\"\n                                           version=\"2.0.0\">\n   <xflb:nachrichtenkopf>\n      <xflb:nachrichtennummer>104d59cc-ec8e-4688-b7bc-860da8d743eb</xflb:nachrichtennummer>\n      <xflb:erstellungszeitpunkt>2025-11-14T11:27:57</xflb:erstellungszeitpunkt>\n      <xflb:sender>XFLB-Connect (Bayern)</xflb:sender>\n      <xflb:empfaenger>Förderfinder Suche (Bayern)</xflb:empfaenger>\n   </xflb:nachrichtenkopf>\n   <xflb:anfrage>\n      <xflb:anfragenummer>104d59cc-ec8e-4688-b7bc-860da8d743eb</xflb:anfragenummer>\n      <xflb:operation listURI=\"urn:xoev-de:stmd:codeliste:operation\" listVersionID=\"1\">\n         <code>001</code>\n         <name>Veröffentlichung</name>\n      </xflb:operation>\n      <xflb:flb>\n         <xflb:schluessel>104d59cc-ec8e-4688-b7bc-860da8d743eb</xflb:schluessel>\n         <xflb:versionFLB>2</xflb:versionFLB>\n         <xflb:versionXFLB>2.0.0</xflb:versionXFLB>\n         <xflb:konkreteFLB>\n            <xflb:metainformationen>\n               <xflb:letzteAktualisierung>2025-11-14T11:27:57</xflb:letzteAktualisierung>\n            </xflb:metainformationen>\n            <xflb:zuordnungen>\n               <xflb:interneKennung>\n                  <xflb:foerderschluessel>104d59cc-ec8e-4688-b7bc-860da8d743eb</xflb:foerderschluessel>\n                  <xflb:flbVersion>2</xflb:flbVersion>\n                  <xflb:xflbVersion>2.0.0</xflb:xflbVersion>\n               </xflb:interneKennung>\n            </xflb:zuordnungen>\n            <xflb:allgemeineAngaben>\n               <xflb:titel>Grün- und Erholungsanlagen aus Anlass von Gartenschauen</xflb:titel>\n               <xflb:beschreibung>\n                  <xflb:zuwendungszweck>&lt;p&gt;Zweck der Förderung ist die Verbesserung der Naherholungsmöglichkeiten in Siedlungsräumen und die Verbesserung der städteökologischen und -klimatischen Verhältnisse zur Unterstützung einer integrierten, nachhaltigen Stadt-Umland-Entwicklung durch Schaffung einer urbanen Grün- und Erholungsanlage aus Anlass von Bayerischen Landesgartenschauen.&lt;/p&gt;</xflb:zuwendungszweck>\n                  <xflb:teaser>Der Freistaat Bayern fördert die investiven Ausgaben von Städten, Märkten oder Gemeinden für dauerhafte Grün- und Erholungsanlagen aus Anlass von Bayerischen Landesgartenschauen.</xflb:teaser>\n               </xflb:beschreibung>\n               <xflb:weiterfuehrendeInformationen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Recht auf Naturgenuss und auf Erholung in der freien Natur</xflb:bezeichnung>\n                     <xflb:link>https://www.stmuv.bayern.de/themen/naturschutz/naturschutzfoerderung/foerderung_wanderwege/index.htm</xflb:link>\n                  </xflb:verweis>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Bayerische Landesgartenschau GmbH - Bewerbung</xflb:bezeichnung>\n                     <xflb:link>https://www.lgs.de/bewerbung/</xflb:link>\n                  </xflb:verweis>\n               </xflb:weiterfuehrendeInformationen>\n               <xflb:zustaendigeStelle>\n                  <xflb:zustaendigeStelleDetails>\n                     <xflb:zustaendigeStelleInformationen>Ihre zuständige Regierung.</xflb:zustaendigeStelleInformationen>\n                  </xflb:zustaendigeStelleDetails>\n               </xflb:zustaendigeStelle>\n               <xflb:formulare>\n                  <xflb:formular>\n                     <xflb:id>a0ae6978-5089-46a0-9313-83c667265b02</xflb:id>\n                     <xflb:bezeichnung>Antrag auf Gewährung einer Zuwendung (Muster 1a zu Art. 44 BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>de1ebdb0-9e49-41f4-aa8e-da4104136cd2</xflb:id>\n                     <xflb:bezeichnung>Angaben zu den finanziellen Verhältnissen (Muster 2b zu Art. 44 BayHO - Doppik)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-028/index</xflb:link>\n                  </xflb:formular>\n                  <xflb:formular>\n                     <xflb:id>b89ed767-00b6-48cf-9724-b6269c43052a</xflb:id>\n                     <xflb:bezeichnung>Auszahlungsantrag (Muster 3 zu Art. 44 BayHO)</xflb:bezeichnung>\n                     <xflb:link>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-006/index</xflb:link>\n                  </xflb:formular>\n               </xflb:formulare>\n            </xflb:allgemeineAngaben>\n            <xflb:foerdernehmende>\n               <xflb:foerdernehmende listURI=\"urn:xoev-de:stmd:codeliste:foerdernehmende\" listVersionID=\"1\">\n                  <code>009</code>\n                  <name/>\n               </xflb:foerdernehmende>\n               <xflb:beschreibung>Zuwendungsempfänger ist jeweils die Kommune, auf deren Grundeigentum oder ihr kraft Vertrags langfristig (mindestens 25 Jahre) zur Verfügung stehenden Flächen die dauerhaften Grün- und Erholungsanlagen anlässlich einer Gartenschau hergestellt werden und die Ausgaben trägt.</xflb:beschreibung>\n            </xflb:foerdernehmende>\n            <xflb:finanzierung>\n               <xflb:finanzierungsformen>\n                  <xflb:finanzierungsform listURI=\"urn:xoev-de:stmd:codeliste:finanzierungsform\"\n                                          listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:finanzierungsform>\n               </xflb:finanzierungsformen>\n               <xflb:finanzierungsartUndHoehe>&lt;p&gt;Die Zuwendung wird als Projektförderung im Wege der Anteilsfinanzierung als Zuschuss zu den zuwendungsfähigen Gesamtausgaben gewährt. Für dauerhafte Investitionen in Grün- und Erholungsanlagen im Zuge von Gartenschauen beträgt der Fördersatz maximal 50 % der zuwendungsfähigen Gesamtausgaben. Die Zuwendung pro Gartenschau kann dabei maximal sieben Millionen Euro betragen.&lt;/p&gt;\n&lt;p&gt;Seit 2025 werden zudem die im Durchführungshaushalt einer Gartenschau abgebildeten Ausgaben gefördert, die die Kommune für die Ausrichtung (Vorbereitung und Durchführung) einer Gartenschau zu tragen hat, mit einem Betrag in Höhe von 1 Mio. Euro&lt;strong&gt; &lt;/strong&gt;gefördert.&lt;/p&gt;</xflb:finanzierungsartUndHoehe>\n               <xflb:zuwendungsfaehigeKosten>&lt;p&gt;Im Rahmen der jeweiligen Landesgartenschau werden ferner gemeinnützigen Vereinen und Verbänden die Ausgaben für sog. längere Beiträge (insbesondere im Bereich der Umweltbildung, Naturerfahrung und Naturvermittlung) mit 70 % der zuwendungsfähigen Gesamtausgaben für den Einzelbeitrag gefördert. Die Zuwendung beträgt höchstens 50 000 Euro je Beitrag. Die Bagatellgrenze der zuwendungsfähigen Ausgaben beträgt 5 000 Euro je Beitrag.&lt;/p&gt;</xflb:zuwendungsfaehigeKosten>\n            </xflb:finanzierung>\n            <xflb:foerderrichtlinieUndFoerderprogramm>\n               <xflb:verantwortlichesMinisterium>Staatsministerium für Umwelt und Verbraucherschutz</xflb:verantwortlichesMinisterium>\n               <xflb:handlungsgrundlagen>\n                  <xflb:verweis>\n                     <xflb:bezeichnung>Richtlinien zur Förderung von Grün- und Erholungsanlagen aus Anlass von Gartenschauen, Durchführung von Gartenschauen sowie von Wanderwegen und Unterkunftshäusern</xflb:bezeichnung>\n                     <xflb:link>https://www.verkuendung-bayern.de/baymbl/2025-42/</xflb:link>\n                  </xflb:verweis>\n               </xflb:handlungsgrundlagen>\n               <xflb:geldgebendeInstitutionen>\n                  <xflb:geldgebendeInstitution listURI=\"urn:xoev-de:stmd:codeliste:geldgebende-institution\"\n                                               listVersionID=\"1\">\n                     <code>003</code>\n                     <name/>\n                  </xflb:geldgebendeInstitution>\n               </xflb:geldgebendeInstitutionen>\n               <xflb:programmtitel>Förderung von Bayerischen Landesgartenschauen</xflb:programmtitel>\n               <xflb:ablaufdatumRichtlinie>2028-12-31</xflb:ablaufdatumRichtlinie>\n               <xflb:programmlaufzeit>\n                  <xflb:beginnLaufzeitFoerderprogramm>2025-02-01</xflb:beginnLaufzeitFoerderprogramm>\n                  <xflb:endeLaufzeitFoerderprogramm>2028-12-31</xflb:endeLaufzeitFoerderprogramm>\n               </xflb:programmlaufzeit>\n            </xflb:foerderrichtlinieUndFoerderprogramm>\n            <xflb:foerdergegenstand>\n               <xflb:beschreibung>&lt;p&gt;Gefördert werden Investitionen in vorbildliche, dauerhafte Grün- und Erholungsanlagen ausschließlich aus Anlass der Durchführung einer Gartenschau, für die ein Zuschlag gemäß Nr.&amp;nbsp;3 erteilt wurde.&lt;/p&gt;</xflb:beschreibung>\n            </xflb:foerdergegenstand>\n            <xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>013</code>\n                  <name/>\n               </xflb:foerderbereich>\n               <xflb:foerderbereich listURI=\"urn:xoev-de:stmd:codeliste:foerderbereich\" listVersionID=\"1\">\n                  <code>015</code>\n                  <name/>\n               </xflb:foerderbereich>\n            </xflb:foerderbereich>\n            <xflb:foerdervoraussetzungen>\n               <xflb:buergerfreundlicheBeschreibung>&lt;p&gt;Voraussetzung ist eine erfolgreiche Bewerbung bei der Bayerischen Landesgartenschau GmbH und die damit verbundene Zuschlagserteilung durch das Bayerische Staatsministerium für Umwelt und Verbraucherschutz (StMUV) im Benehmen mit dem Bayerischen Staatsministerium für Ernährung, Landwirtschaft und Forsten (StMELF).&lt;/p&gt;</xflb:buergerfreundlicheBeschreibung>\n            </xflb:foerdervoraussetzungen>\n            <xflb:antragsinformationen>\n               <xflb:linkZurAntragsstellung>https://formularserver.bayern.de/intelliform/forms/stmi+regierungen/rob/z/z/rob_z1-023/index</xflb:linkZurAntragsstellung>\n               <xflb:verfahrensablauf>\n                  <xflb:bewilligung>&lt;p&gt;Als Antrag auf Zuwendungsgewährung ist bei Kommunen das Formblatt nach Muster 1a zu Art. 44 Bayerische Haushaltsordnung zu verwenden. Der Antrag ist bei der zuständigen Regierung einzureichen.&lt;/p&gt;</xflb:bewilligung>\n               </xflb:verfahrensablauf>\n               <xflb:beantragungskosten>\n                  <xflb:kostenlos>ja</xflb:kostenlos>\n               </xflb:beantragungskosten>\n               <xflb:erforderlicheUnterlagen>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Beschreibung des Vorhabens samt Planunterlagen.</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Erklärung, ob und wie die dauerhafte Zurverfügungstellung der geförderten Anlagen bzw. Einrichtungen für die Öffentlichkeit sichergestellt wird.</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Erläuterung, inwieweit das Bewerbungskonzept umgesetzt wird.</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Pflege- und Nachnutzungskonzept für die überplante Fläche, das der langfristigen ökologischen Zielsetzung Rechnung trägt.</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Beschluss des zuständigen Organs des Vorhabenträgers über die Durchführung der Maßnahme.</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Finanzierungsplan zur Sicherung der Gesamtfinanzierung des Vorhabens.</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Stellungnahme zu den Fragen, ob die einschlägigen öffentlich-rechtlichen Vorschriften beachtet sind und den Belangen des Umwelt- und Naturschutzes sowie der Wasserwirtschaft Rechnung getragen wird.</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Bei Baumaßnahmen: die Unterlagen nach Nr. 3.2.2 Verwaltungsvorschriften für Zuwendungen des Freistaates Bayern an kommunale Körperschaften (VVK).</xflb:bezeichnung>\n                  </xflb:dokument>\n                  <xflb:dokument>\n                     <xflb:bezeichnung>Bei Hochbauten: eine Ausgabengliederung nach DIN 276 oder nach Muster 5 zu Art. 44 Bayerische Haushaltsordnung (BayHO).</xflb:bezeichnung>\n                  </xflb:dokument>\n               </xflb:erforderlicheUnterlagen>\n               <xflb:rechtsbehelf>&lt;p&gt;Verwaltungsrechtliche Klage&lt;/p&gt;</xflb:rechtsbehelf>\n            </xflb:antragsinformationen>\n            <xflb:foerdergebiet>\n               <xflb:laender>\n                  <xflb:land listURI=\"urn:xoev-de:pks:codeliste:bundesland\" listVersionID=\"1\">\n                     <code>BY</code>\n                     <name/>\n                  </xflb:land>\n               </xflb:laender>\n            </xflb:foerdergebiet>\n         </xflb:konkreteFLB>\n      </xflb:flb>\n   </xflb:anfrage>\n</xflb:veroeffentlichung.anfrage.flb.001001>"
                              ]
            ];
