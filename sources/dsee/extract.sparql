# DSEE Förderdatenbank publishes one HTML detail page per programme. The fetcher
# chunks them — emit(mode: "documents", chunk: N) wraps N pages per file, each in a
# <div class="cdp-record" data-name="<slug>"> — so this runs once per *chunk* and
# must scope every pattern to the record it belongs to. Facade-x (html lift) shape:
# elements are xhtml: typed, class is xhtml:class, text is html:innerText.
#
# Two things follow from chunking, and both are easy to get wrong.
#
# Scope. Every pattern here used to match free-floating, because one file held one
# page and there was nothing else to hit. At 200 records per file they cross-join:
# 200 canonical links x 200 h1s is 40,000 bogus title/slug pairs, silently. So the
# record root is bound first and everything hangs off ?node, its descendants.
#
# One traversal, not one per field. `?rec (!rdf:type)* ?node` costs ~90 ms per
# record, measured linear from chunk 20 to 200. Written the obvious way — a fresh
# path inside each UNION branch — that is ~90 ms x 6 fields x 1300 records, which
# is slower than not chunking at all. Binding ?node once above the UNION and
# letting the branches filter it pays the traversal a single time.
#
# Identity comes from data-name, which emit writes from the fetcher's document
# name. The <link rel="canonical"> is still in the markup and still parseable, but
# it is one indirection further from the thing we mean.
#
# innerText is already plain text here, so extract emits the final values directly
# and the map step only renames them onto the target schema.
#
# The facts box is a uniform pattern — <div><div class="font-bold">Label:</div>
# <div>value</div></div> — so one shape reaches Regionen, Engagementbereiche and
# Bewerbungsfrist by matching on the bold label. Regionen and Engagementbereiche
# wrap *multiple* values in <li> items but render a single value as bare text,
# so both branches accept either shape; matching only the list form silently
# drops every "Bundesweit" programme. Bewerbungsfrist is always bare text.
#
# Engagementbereiche are DSEE's own axis, not the XÖV Förderbereich the other
# sources use (Bauten und Denkmalschutz, Kinder und Jugendliche, …). They are
# emitted as fundingArea slugs anyway; whether the two axes should be separated
# is a later decision, not a blocker.
#
# Only "Fortlaufende Förderung" is read out of Bewerbungsfrist, as
# deadline_model = rolling. The dated values are not parsed: they are German
# prose, several carry two dates in one string ("31. Oktober 2026 30. April
# 2027"), and one mixes both ("30. Juni 2027 Antragstellung fortlaufend
# möglich"). Guessing which is the application deadline is exactly the
# information-extraction problem this pipeline is not the place for.

PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xhtml: <http://www.w3.org/1999/xhtml#>
PREFIX html:  <https://html.spec.whatwg.org/#>
PREFIX xyz:   <http://sparql.xyz/facade-x/data/>
PREFIX cdp:   <https://civic-data.de/pipeline#>

CONSTRUCT {
    ?prog cdp:fromSource cdp:dseeSource ;
          xyz:title         ?title ;
          xyz:description   ?desc ;
          xyz:url           ?url ;
          xyz:fundingArea   ?area ;
          xyz:location      ?nuts ;
          xyz:deadlineModel ?deadlineModel .
} WHERE {
    ?rec xhtml:class "cdp-record" ; xhtml:data-name ?slug .
    BIND(IRI(CONCAT(STR(cdp:), "dsee-", ?slug)) AS ?prog)
    BIND(CONCAT("https://foerderdatenbank.d-s-e-e.de/foerderprogramme/", ?slug) AS ?url)

    # Bound once; every branch below filters this set rather than re-walking the tree.
    ?rec (!rdf:type)* ?node .

    {
        ?node a xhtml:h1 ; xhtml:class ?h1Class ; html:innerText ?title .
        FILTER(CONTAINS(?h1Class, "col-span-2"))
    } UNION {
        ?node a xhtml:div ; xhtml:class ?proseClass ; rdf:_1 ?lead .
        FILTER(CONTAINS(?proseClass, "prose") && CONTAINS(?proseClass, "mb-8"))
        ?lead html:innerText ?desc .
    } UNION {
        # Engagementbereiche → fundingArea slugs.
        ?node rdf:_1 ?lbl ; rdf:_2 ?val .
        ?lbl xhtml:class "font-bold" ; html:innerText "Engagementbereiche:" .
        {
            ?val rdf:_1 ?ul . ?ul a xhtml:ul ; ?li ?item .
            FILTER(STRSTARTS(STR(?li), CONCAT(STR(rdf:), "_")))
            ?item html:innerText ?raw .
        } UNION {
            ?val rdf:_1 ?bare . FILTER(isLiteral(?bare))
            ?val html:innerText ?raw .
        }
        BIND(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(LCASE(?raw), "&", " und "), "ä", "ae"), "ö", "oe"), "ü", "ue"), "ß", "ss"), "[^a-z0-9]+", "_") AS ?pad)
        BIND(REPLACE(REPLACE(?pad, "^_+", ""), "_+$", "") AS ?area)
    } UNION {
        # Regionen → NUTS, same closed table as the other sources.
        ?node rdf:_1 ?lbl ; rdf:_2 ?val .
        ?lbl xhtml:class "font-bold" ; html:innerText "Regionen:" .
        {
            ?val rdf:_1 ?ul . ?ul a xhtml:ul ; ?li ?item .
            FILTER(STRSTARTS(STR(?li), CONCAT(STR(rdf:), "_")))
            ?item html:innerText ?region .
        } UNION {
            # A single region is rendered as bare text, with no <ul> to walk — which
            # is how every "Bundesweit" programme is shaped. The two shapes are told
            # apart by rdf:_1: a literal for bare text, a node for the <ul>. (FILTER
            # NOT EXISTS would read more directly but crashes Comunica when it closes
            # over an outer variable.)
            ?val rdf:_1 ?bare . FILTER(isLiteral(?bare))
            ?val html:innerText ?region .
        }
        VALUES (?region ?nuts) {
            ("Bundesweit"             "DE")
            ("Baden-Württemberg"      "DE1")
            ("Bayern"                 "DE2")
            ("Berlin"                 "DE3")
            ("Brandenburg"            "DE4")
            ("Bremen"                 "DE5")
            ("Hamburg"                "DE6")
            ("Hessen"                 "DE7")
            ("Mecklenburg-Vorpommern" "DE8")
            ("Niedersachsen"          "DE9")
            ("Nordrhein-Westfalen"    "DEA")
            ("Rheinland-Pfalz"        "DEB")
            ("Saarland"               "DEC")
            ("Sachsen"                "DED")
            ("Sachsen-Anhalt"         "DEE")
            ("Schleswig-Holstein"     "DEF")
            ("Thüringen"              "DEG")
        }
    } UNION {
        ?node rdf:_1 ?lbl ; rdf:_2 ?val .
        ?lbl xhtml:class "font-bold" ; html:innerText "Bewerbungsfrist:" .
        ?val html:innerText ?frist .
        FILTER(STRSTARTS(?frist, "Fortlaufende Förderung"))
        BIND("rolling" AS ?deadlineModel)
    }
}
