@prefix :       <https://civic-data.de/pipeline#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix p-plan: <http://purl.org/net/p-plan#> .

# Execution order is derived from p-plan:isPrecededBy via topological sort

:pipeline a p-plan:Plan ;
    rdfs:label "Funding Directory Federation Pipeline" ;
    :ingestLog "data/ingest/ingest-log.ttl" .

# ---- Fetch -------------------------------------------------------------

:fetchFdbBund a :Fetch, p-plan:Step ;
    :fromSource   :fdbBundSource ;
    :format       "xml" ;
    :staticSource "static-sources/fdb_bund/" ;
    :script       "src/fetchers/fdb_bund.js" ;
    :limit        50 ;
    :outputDir    "data/ingest/raw/fdb_bund/" .

:fetchDsee a :Fetch, p-plan:Step ;
    :fromSource :dseeSource ;
    :fetchUrl   "https://foerderdatenbank.d-s-e-e.de" ;
    :format     "html" ;
    :script     "src/fetchers/dsee.js" ;
    :limit      50 ;
    :outputDir  "data/ingest/raw/dsee/" .

:fetchEuportal a :Fetch, p-plan:Step ;
    :fromSource :euportalSource ;
    :fetchUrl   "https://api.tech.ec.europa.eu/search-api/prod/rest/search" ;
    :format     "json" ;
    :script     "src/fetchers/euportal.js" ;
    :limit      50 ;
    :outputDir  "data/ingest/raw/euportal/" .

:fetchFoerderfinder a :Fetch, p-plan:Step ;
    :fromSource :foerderfinderSource ;
    :fetchUrl   "https://foerderfinder.digital/bayern/suche/apicall" ;
    :format     "json" ;
    :script     "src/fetchers/foerderfinder.js" ;
    :limit      50 ;
    :outputDir  "data/ingest/raw/foerderfinder/" .

# ---- Lift --------------------------------------------------------------

:liftFdbBund a :Lift, p-plan:Step ;
    p-plan:isPrecededBy :fetchFdbBund ;
    :liftQuery "src/lift/xml.sparql" ;
    :inputDir  "data/ingest/raw/fdb_bund/" ;
    :outputDir "data/ingest/lifted/fdb_bund/" .

:liftDsee a :Lift, p-plan:Step ;
    p-plan:isPrecededBy :fetchDsee ;
    :liftQuery "src/lift/html.sparql" ;
    :param     [ :name "selector" ; :value "html" ] ;
    :inputDir  "data/ingest/raw/dsee/" ;
    :outputDir "data/ingest/lifted/dsee/" .

:liftEuportal a :Lift, p-plan:Step ;
    p-plan:isPrecededBy :fetchEuportal ;
    :liftQuery "src/lift/json.sparql" ;
    :inputDir  "data/ingest/raw/euportal/" ;
    :outputDir "data/ingest/lifted/euportal/" .

:liftFoerderfinder a :Lift, p-plan:Step ;
    p-plan:isPrecededBy :fetchFoerderfinder ;
    :liftQuery "src/lift/json.sparql" ;
    :inputDir  "data/ingest/raw/foerderfinder/" ;
    :outputDir "data/ingest/lifted/foerderfinder/" .

# ---- Clean -------------------------------------------------------------

:cleanFdbBund a :Clean, p-plan:Step ;
    p-plan:isPrecededBy :liftFdbBund ;
    :cleanQuery "src/clean/fdb_bund.sparql" ;
    :inputDir   "data/ingest/lifted/fdb_bund/" ;
    :output     "data/pipeline/cleaned/fdbBund.ttl" .

:cleanDsee a :Clean, p-plan:Step ;
    p-plan:isPrecededBy :liftDsee ;
    :cleanQuery "src/clean/dsee.sparql" ;
    :inputDir   "data/ingest/lifted/dsee/" ;
    :output     "data/pipeline/cleaned/dsee.ttl" .

:cleanEuportal a :Clean, p-plan:Step ;
    p-plan:isPrecededBy :liftEuportal ;
    :cleanQuery "src/clean/euportal.sparql" ;
    :inputDir   "data/ingest/lifted/euportal/" ;
    :output     "data/pipeline/cleaned/euportal.ttl" .

:cleanFoerderfinder a :Clean, p-plan:Step ;
    p-plan:isPrecededBy :liftFoerderfinder ;
    :cleanQuery "src/clean/foerderfinder.sparql" ;
    :inputDir   "data/ingest/lifted/foerderfinder/" ;
    :output     "data/pipeline/cleaned/foerderfinder.ttl" .

# ---- Load --------------------------------------------------------------

:loadFdbBund a :Load, p-plan:Step ;
    p-plan:isPrecededBy :cleanFdbBund ;
    :input "data/pipeline/cleaned/fdbBund.ttl" ;
    :graph "urn:source:fdbBund" .

:loadDsee a :Load, p-plan:Step ;
    p-plan:isPrecededBy :cleanDsee ;
    :input "data/pipeline/cleaned/dsee.ttl" ;
    :graph "urn:source:dsee" .

:loadEuportal a :Load, p-plan:Step ;
    p-plan:isPrecededBy :cleanEuportal ;
    :input "data/pipeline/cleaned/euportal.ttl" ;
    :graph "urn:source:euportal" .

:loadFoerderfinder a :Load, p-plan:Step ;
    p-plan:isPrecededBy :cleanFoerderfinder ;
    :input "data/pipeline/cleaned/foerderfinder.ttl" ;
    :graph "urn:source:foerderfinder" .

# ---- Map ---------------------------------------------------------------

:mapStep a :Map, p-plan:Step ;
    p-plan:isPrecededBy :loadFdbBund, :loadDsee, :loadEuportal, :loadFoerderfinder ;
    :output               "data/pipeline/mapped.ttl" ;
    :directMappingQueries "data/pipeline/direct-mapping-queries/" .

# ---- Match -------------------------------------------------------------

:matchStep a :Match, p-plan:Step ;
    p-plan:isPrecededBy :mapStep ;
    :output "data/pipeline/matches.ttl" .

# ---- Merge -------------------------------------------------------------

:mergeStep a :Merge, p-plan:Step ;
    p-plan:isPrecededBy :matchStep ;
    :output     "data/pipeline/merged.ttl" ;
    :provOutput "data/pipeline/provenance.ttl" .

# ---- Resolve -----------------------------------------------------------

:resolveStep a :Resolve, p-plan:Step ;
    p-plan:isPrecededBy :mergeStep ;
    :output "data/pipeline/final.ttl" .
