@prefix :       <https://civic-data.de/pipeline#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix ft:     <http://publications.europa.eu/resource/authority/file-type/> .

# ---- Federation ---------------------------------------------------------

:federation a :Federation ;
    rdfs:label       "Federated directory of funding programmes in Germany & the EU" ;
    :hasSource       :fdbBundSource, :dseeSource, :euportalSource, :foerderfinderSource ;
    :hasTargetSchema :fundingOpportunitySchema ;
    :harvestingModeActive false ;
    :hasRunParam     [ :name "limit" ; :value "50" ] ;
    :baseUrl         "https://foederierter-datenpool.github.io/funding-directory-builder/" ;
    :repository      "https://github.com/foederierter-datenpool/funding-directory-builder" .

# ---- Target schema ------------------------------------------------------

# A funding opportunity (Förderprogramm / call / topic). First version is deliberately minimal — title and
# description only; eligibility / money / deadlines come later.
:fundingOpportunitySchema a :TargetSchema ;
    :targetClass schema:FundingScheme ;
    :hasTargetField :t-name, :t-description .

:t-name        a :TargetField ; :targetPredicate schema:name .
:t-description a :TargetField ; :targetPredicate schema:description .
# Förderbereich, drafted in TargetSchemaNotes.md but not yet wired: no source
# field maps to it, so it stays out of :hasTargetField above. schema:areas is
# not a schema.org term, so the predicate is still open.
:t-areas       a :TargetField ; :targetPredicate schema:areas .


# ---- Sources ------------------------------------------------------------

:fdbBundSource a :Source ;
    rdfs:label    "Förderdatenbank Bund" ;
    skos:notation "fdb" ;
    :enabled      true ;
    :fetchUrl     "https://www.foerderdatenbank.de/FDB/WS/export" ;
    :retrieval    "API" ;
    :format       ft:XML ;
    :hasField     :fdb-title, :fdb-description .
:fdb-title       a :SourceField ; :fieldPath "title" .
:fdb-description a :SourceField ; :fieldPath "description" .

:dseeSource a :Source ;
    rdfs:label    "Förderdatenbank DSEE" ;
    skos:notation "dsee" ;
    :enabled      true ;
    :fetchUrl     "https://foerderdatenbank.d-s-e-e.de" ;
    :retrieval    "Scrape" ;
    :format       ft:HTML ;
    :hasLiftParam [ :name "selector" ; :value "html" ] ;
    :hasField     :dsee-title, :dsee-description .
:dsee-title       a :SourceField ; :fieldPath "title" .
:dsee-description a :SourceField ; :fieldPath "description" .

:euportalSource a :Source ;
    rdfs:label    "EU Funding & Tenders Portal" ;
    skos:notation "eu" ;
    :enabled      true ;
    :fetchUrl     "https://api.tech.ec.europa.eu/search-api/prod/rest/search" ;
    :retrieval    "API" ;
    :format       ft:JSON ;
    :hasField     :eu-title, :eu-description .
:eu-title       a :SourceField ; :fieldPath "title" .
:eu-description a :SourceField ; :fieldPath "description" .

:foerderfinderSource a :Source ;
    rdfs:label    "Förderfinder Bayern" ;
    skos:notation "ff" ;
    :enabled      true ;
    :fetchUrl     "https://foerderfinder.digital/bayern/suche/apicall" ;
    :retrieval    "API" ;
    :format       ft:JSON ;
    :hasField     :ff-title, :ff-description .
:ff-title       a :SourceField ; :fieldPath "title" .
:ff-description a :SourceField ; :fieldPath "description" .

# ---- Mappings -----------------------------------------------------------

# Bund: the extract step flattens both CDATA-wrapped HTML fields, so the values
# arrive here as plain text → direct mapping.
:fdb-mapping a :Mapping ;
    :fromSource  :fdbBundSource ;
    :toTarget    :fundingOpportunitySchema ;
    :hasFieldMapping
        [ :from :fdb-title       ; :to :t-name        ] ,
        [ :from :fdb-description ; :to :t-description ] .

# DSEE: html:innerText is already plain text → direct mapping.
:dsee-mapping a :Mapping ;
    :fromSource  :dseeSource ;
    :toTarget    :fundingOpportunitySchema ;
    :hasFieldMapping
        [ :from :dsee-title       ; :to :t-name        ] ,
        [ :from :dsee-description ; :to :t-description ] .

# EU: descriptionByte is HTML, flattened at extract → direct mapping.
:eu-mapping a :Mapping ;
    :fromSource  :euportalSource ;
    :toTarget    :fundingOpportunitySchema ;
    :hasFieldMapping
        [ :from :eu-title       ; :to :t-name        ] ,
        [ :from :eu-description ; :to :t-description ] .

# Förderfinder Bayern: titel + teaser are both plain text → direct mapping.
:foerderfinder-mapping a :Mapping ;
    :fromSource  :foerderfinderSource ;
    :toTarget    :fundingOpportunitySchema ;
    :hasFieldMapping
        [ :from :ff-title       ; :to :t-name        ] ,
        [ :from :ff-description ; :to :t-description ] .

# ---- Match --------------------------------------------------------------

# No criteria yet: every record stays its own cluster (no cross-source merge in
# this first version). Cross-source matching of the same programme comes later.
:fundingMatch a :MatchRule ;
    :forTarget           :fundingOpportunitySchema ;
    :targetNamespace     "https://civic-data.de/federated-directory#" ;
    :mintedSubjectPrefix "funding-" .

# ---- Resolve ------------------------------------------------------------

:resolve a :ResolveRule ;
    :defaultStrategy :alphabeticFirst .
