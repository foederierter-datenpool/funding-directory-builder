# telefon carries labels like "Tel.: ", "Fax.: ", "Mobil: " that are stripped.

PREFIX xyz:    <http://sparql.xyz/facade-x/data/>
PREFIX schema: <http://schema.org/>
PREFIX cdp:    <https://civic-data.de/pipeline#>

INSERT {
    GRAPH <urn:mapped> {
        ?org
            cdp:fromSource   cdp:dhsSource ;
            schema:telephone ?phone        ;
            schema:email     ?email        .
    }
} WHERE {
    GRAPH <urn:source:dhs> {
        ?org cdp:fromSource cdp:dhsSource .
        OPTIONAL {
            ?org xyz:telefon ?telRaw .
            BIND(REPLACE(?telRaw, "^(Tel|Fax|Mobil)\\.?:\\s*", "") AS ?phone)
        }
        OPTIONAL {
            ?org xyz:email ?emailRaw .
            BIND(REPLACE(?emailRaw, "\\(at\\)", "@") AS ?email)
        }
    }
}
