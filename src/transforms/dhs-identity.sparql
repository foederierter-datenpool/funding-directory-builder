# Source subjects are already federation IRIs (cdp:dhs-<id>) post-clean, so
# the entry id is just the suffix after "dhs-".

PREFIX dhs:    <https://civic-data.de/dhs#>
PREFIX schema: <http://schema.org/>
PREFIX cdp:    <https://civic-data.de/pipeline#>

INSERT {
    GRAPH <urn:mapped> {
        ?org
            cdp:fromSource    cdp:dhsSource ;
            schema:identifier ?entryId      ;
            schema:name       ?name         ;
            schema:url        ?detailLink   .
    }
} WHERE {
    GRAPH <urn:source:dhs> {
        ?org
            cdp:fromSource cdp:dhsSource ;
            dhs:name       ?name         ;
            dhs:detailLink ?detailLink   .
    }
    BIND(STRAFTER(STR(?org), CONCAT(STR(cdp:), "dhs-")) AS ?entryId)
}
