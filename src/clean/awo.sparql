# The fetcher merges AWO's source files into one document; org records carry
# xyz:type + xyz:id, so skolemizing each to cdp:awo-<id> unifies them. Copies the
# org's scalar literals (whitespace collapsed; isLiteral skips nested arrays and
# the facade-x null IRI), joins the org's address from the locations_filtered
# table on organisation_id, and resolves parent_id to the parent's name via a
# self-join. Each element of the org's services[] also becomes its own entity
# (cdp:awo-service-<id>) linked back via cdp:providedBy. Clean stays in xyz:/cdp:
# vocabulary — no schema: yet; each subject instead carries cdp:targetSchema so
# the map routes it to the organisation or service schema (where the schema: type
# is assigned). The org still folds in the first service's BAGFW category for now
# — that moves onto the service when the service mapping is wired.

PREFIX xyz: <http://sparql.xyz/facade-x/data/>
PREFIX cdp: <https://civic-data.de/pipeline#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

CONSTRUCT {
    ?org cdp:fromSource   cdp:awoSource ;
         cdp:targetSchema cdp:organizationSchema ;
         ?p               ?scalar ;
         xyz:adresse      ?adresse ;
         xyz:plz          ?plz ;
         xyz:ort          ?ort ;
         xyz:ortsteil     ?ortsteil ;
         xyz:category     ?category ;
         xyz:parent_name  ?parentName .

    ?svc cdp:fromSource   cdp:awoSource ;
         cdp:targetSchema cdp:serviceSchema ;
         cdp:providedBy   ?org ;
         xyz:id           ?svcId ;
         xyz:name         ?svcName ;
         xyz:category     ?svcCategory ;
         xyz:area_served  ?svcArea .
}
WHERE {
    ?node xyz:type ?type ; xyz:id ?id .
    BIND(IRI(CONCAT(STR(cdp:), "awo-", STR(?id))) AS ?org)

    # The org's own scalar literals (id, name, name_zusatz, webseite, …), with
    # whitespace collapsed. isLiteral skips nested arrays and the xyz:null IRI.
    ?node ?p ?raw .
    FILTER(isLiteral(?raw))
    BIND(STRDT(REPLACE(STR(?raw), "[\u00A0\\s]+", " "), datatype(?raw)) AS ?scalar)

    # Address from the locations_filtered table, joined on organisation_id —
    # not from the org's services. Orgs absent from that table (the services-
    # file-only ones) get no address; their service will carry the location
    # instead. plz+ort are always present on a location node and absent on
    # service nodes, so requiring them pins the join to a real location.
    OPTIONAL {
        ?locNode xyz:organisation_id ?id ;
                 xyz:plz              ?plz ;
                 xyz:ort              ?ort .
        OPTIONAL { ?locNode xyz:adresse  ?adresse }
        OPTIONAL { ?locNode xyz:ortsteil ?ortsteil }
    }

    OPTIONAL {
        ?node xyz:services/rdf:_1/xyz:bagfw_category ?cat .
        ?cat xyz:nummer ?cnum ; xyz:name ?cname .
        BIND(CONCAT(STR(?cnum), " ", STR(?cname)) AS ?category)
    }

    # One service entity per services[] element (rdf:_N container members): its
    # own id, the BAGFW category as name + category, and the location resolved
    # via location_id against the locations table (its ort as area served).
    OPTIONAL {
        ?node xyz:services ?svcArr .
        ?svcArr ?svcMember ?svcNode .
        FILTER(STRSTARTS(STR(?svcMember), "http://www.w3.org/1999/02/22-rdf-syntax-ns#_"))
        ?svcNode xyz:id ?svcId .
        BIND(IRI(CONCAT(STR(cdp:), "awo-service-", STR(?svcId))) AS ?svc)
        OPTIONAL {
            ?svcNode xyz:bagfw_category ?svcBc .
            ?svcBc xyz:name ?svcName ; xyz:nummer ?svcNum .
            BIND(CONCAT(STR(?svcNum), " ", STR(?svcName)) AS ?svcCategory)
        }
        # ort lives only on the full locations table row, not the skinny
        # location embedded in the service, so it pins to the right node.
        OPTIONAL {
            ?svcNode xyz:location_id ?svcLocId .
            ?svcLoc xyz:id ?svcLocId ; xyz:ort ?svcArea .
        }
    }

    OPTIONAL {
        ?node xyz:parent_id ?pid .
        ?parent xyz:type ?ptype ; xyz:id ?pid ; xyz:name ?parentName .
    }
}
