# Skolemize each sozialplattform entry from its xyz:offer_id into a stable
# cdp:sp-<offer_id> IRI carrying all of its xyz:* properties; the office_address
# sub-blank-node is preserved by virtue of matching every triple in the source
# except the facade-x root scaffolding. Tag each entry with cdp:fromSource so
# downstream consumers can identify entries and bucket them by source without
# prefix-matching IRIs. Also collapses runs of NBSP / regular whitespace to a
# single space — the source has stray U+00A0 characters inside string literals
# (e.g. "Straße  18").

PREFIX xyz: <http://sparql.xyz/facade-x/data/>
PREFIX cdp: <https://civic-data.de/pipeline#>
PREFIX fx:  <http://sparql.xyz/facade-x/ns/>

CONSTRUCT {
    ?subj  ?p ?cleaned .
    ?org cdp:fromSource cdp:sozialplattformSource .
}
WHERE {
    ?orig ?p ?o .
    FILTER NOT EXISTS { ?orig a fx:root }
    OPTIONAL {
        ?orig xyz:offer_id ?id .
        BIND(IRI(CONCAT(STR(cdp:), "sp-", ?id)) AS ?org)
    }
    BIND(COALESCE(?org, ?orig) AS ?subj)
    BIND(IF(isLiteral(?o),
            STRDT(REPLACE(STR(?o), "[\u00A0\\s]+", " "), datatype(?o)),
            ?o) AS ?cleaned)
}
