# DHS publishes one HTML detail page per entry. The canonical <link> in <head>
# carries the entry ID; the org content lives inside <div class="entrylong">.
# This query runs once per lifted detail page, so there's exactly one of each.

PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xhtml: <http://www.w3.org/1999/xhtml#>
PREFIX html:  <https://html.spec.whatwg.org/#>
PREFIX xyz:   <http://sparql.xyz/facade-x/data/>
PREFIX cdp:   <https://civic-data.de/pipeline#>

CONSTRUCT {
    ?org cdp:fromSource cdp:dhsSource ;
         xyz:entryId    ?entryId ;
         xyz:detailLink ?detailHref ;
         xyz:name       ?name ;
         xyz:department ?department ;
         ?predicate     ?value .
} WHERE {
    ?link a xhtml:link ; xhtml:rel "canonical" ; xhtml:href ?detailHref .
    FILTER(CONTAINS(STR(?detailHref), "%5Bentry%5D="))
    BIND(STRBEFORE(STRAFTER(STR(?detailHref), "%5Bentry%5D="), "&") AS ?entryId)
    BIND(IRI(CONCAT(STR(cdp:), "dhs-", ?entryId)) AS ?org)

    ?entry a xhtml:div ; xhtml:class "entrylong" .

    OPTIONAL {
        ?entry (!<urn:_>)+ ?h3 .
        ?h3 a xhtml:h3 ; html:innerText ?name .
    }
    OPTIONAL {
        ?entry (!<urn:_>)+ ?dep .
        ?dep a xhtml:p ; xhtml:class "titelext" ; html:innerText ?department .
    }
    {
        ?entry (!<urn:_>)+ ?span .
        ?span a xhtml:span ; xhtml:class ?className ; html:innerText ?value .
        FILTER(?className IN ("strasse", "plzort", "telefon", "email", "website"))
        BIND(IRI(CONCAT(STR(xyz:), ?className)) AS ?predicate)
    }
    UNION
    {
        # Labelled <p class="…"><strong>Label</strong><br>value…</p> blocks.
        # innerText concatenates label and value with a space; strip the label.
        ?entry (!<urn:_>)+ ?p .
        ?p a xhtml:p ; xhtml:class ?className ; html:innerText ?fullText .
        FILTER(?className IN ("art", "barrierefrei", "angebote", "zielgruppe", "zeiten", "traeger", "arbeit"))
        ?p rdf:_1 ?strong .
        ?strong a xhtml:strong ; html:innerText ?label .
        BIND(STRAFTER(?fullText, CONCAT(?label, " ")) AS ?value)
        FILTER(STRLEN(?value) > 0)
        BIND(IRI(CONCAT(STR(xyz:), ?className)) AS ?predicate)
    }
}
